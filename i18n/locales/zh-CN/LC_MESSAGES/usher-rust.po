msgctxt "tag.loading_remote_context"
msgid "Loading the latest remote Tag for the Tag Workflow."
msgstr "正在为 Tag Workflow 加载最新远端 Tag。"

msgctxt "tag.load_remote_git_failed"
msgid "Git failed while querying remote Tags (exit {status}): {detail}"
msgstr "Git 查询远端 Tag 失败（退出状态 {status}）：{detail}"

msgctxt "tag.load_remote_git_failed_without_detail"
msgid "Git failed while querying remote Tags with exit status {status}, but returned no diagnostic output."
msgstr "Git 查询远端 Tag 失败，退出状态为 {status}，但未返回诊断输出。"

msgctxt "tag.load_git_permission_denied"
msgid "Git could not access the repository or remote because permission was denied. Check Git, repository and remote access permissions."
msgstr "Git 因权限不足无法访问仓库或远端。请检查 Git、仓库和远端访问权限。"

msgctxt "tag.remote_tag_not_ready"
msgid "Refresh the remote Tags successfully before creating a Tag."
msgstr "请成功刷新远端 Tag 后再创建 Tag。"

msgctxt "tag.step.pull_main"
msgid "Pull main"
msgstr "拉取 main"

msgctxt "tag.step.pull_main_detail"
msgid "Pull the latest main Branch changes."
msgstr "拉取 main Branch 的最新变更。"

msgctxt "ai_agent.identity"
msgid "{name} · {model}"
msgstr "{name} · {model}"

msgctxt "settings.feedback.ai_agent_activated"
msgid "AI Agent activated."
msgstr "已启用 AI Agent。"

msgctxt "settings.feedback.ai_agent_activation_failed"
msgid "Could not activate AI Agent. Please try again."
msgstr "无法启用 AI Agent，请重试。"

msgctxt "hooks.conclusion.success"
msgid "Succeeded"
msgstr "执行成功"
msgctxt "hooks.conclusion.failure"
msgid "Failed"
msgstr "执行失败"
msgctxt "hooks.conclusion.timed_out"
msgid "Timed out"
msgstr "执行超时"
msgctxt "hooks.conclusion.start_failed"
msgid "Could not start"
msgstr "无法启动"
msgctxt "hooks.conclusion.interrupted"
msgid "Interrupted"
msgstr "执行中断"
msgctxt "hooks.conclusion.skipped"
msgid "Skipped"
msgstr "已跳过"
msgctxt "hooks.error.journal"
msgid "Could not save the execution log. Check available storage and permissions."
msgstr "无法保存执行日志，请检查可用存储空间和权限。"
msgctxt "hooks.error.preparation"
msgid "Could not prepare the Hook working files. Check storage and permissions."
msgstr "无法准备 Hook 工作文件，请检查存储空间和权限。"
msgctxt "hooks.error.working_directory"
msgid "The working directory is unavailable. Check that it exists and is accessible."
msgstr "工作目录不可用，请检查目录是否存在并具有访问权限。"
msgctxt "hooks.error.interpreter_start"
msgid "Could not start the interpreter. Check its executable path and permissions."
msgstr "无法启动解释器，请检查可执行文件路径和权限。"
msgctxt "hooks.error.process_tree"
msgid "Could not establish process cancellation. Execution was stopped."
msgstr "无法建立进程取消机制，执行已停止。"
msgctxt "hooks.error.wait"
msgid "Could not read the interpreter exit status. See the execution log."
msgstr "无法读取解释器退出状态，请查看执行日志。"
msgctxt "hooks.error.output_drain"
msgid "Output collection timed out. A child process may still hold an output pipe."
msgstr "收集输出超时，子进程可能仍占用输出管道。"
msgctxt "hooks.error.invalid_definition"
msgid "The Hook configuration is invalid. Review its fields before retrying."
msgstr "Hook 配置无效，请检查各项配置后重试。"
msgctxt "hooks.error.execution"
msgid "Hook execution failed. See the execution log."
msgstr "Hook 执行失败，请查看执行日志。"
msgctxt "hooks.error.exit_code"
msgid "Interpreter exited with code {code}. See the execution log."
msgstr "解释器退出码为 {code}，请查看执行日志。"
msgctxt "hooks.error.signal"
msgid "Interpreter stopped by signal {signal}. See the execution log."
msgstr "解释器被信号 {signal} 终止，请查看执行日志。"
msgctxt "hooks.error.configuration"
msgid "Could not load Hook configuration. The saved file has been preserved."
msgstr "无法加载 Hook 配置，原配置文件已保留。"
msgctxt "hooks.error.command"
msgid "The Hook operation could not be completed. See diagnostics for details."
msgstr "无法完成 Hook 操作，请查看诊断日志。"
msgctxt "hooks.error.expired"
msgid "Hook run was not found or has expired."
msgstr "Hook 执行记录不存在或已过期。"
msgctxt "hooks.validation.invalid_id"
msgid "Invalid Hook ID."
msgstr "Hook ID 无效。"
msgctxt "hooks.validation.name_required"
msgid "Hook name is required."
msgstr "请填写 Hook 名称。"
msgctxt "hooks.validation.script_empty"
msgid "Hook script is empty."
msgstr "Hook 脚本不能为空。"
msgctxt "hooks.validation.script_too_large"
msgid "Hook script exceeds 64 KiB."
msgstr "Hook 脚本超过 64 KiB。"
msgctxt "hooks.validation.timeout_range"
msgid "Timeout must be between 1 and 3600 seconds."
msgstr "超时时间必须为 1 到 3600 秒。"
msgctxt "hooks.validation.field_too_long"
msgid "Hook configuration field is too long."
msgstr "Hook 配置字段过长。"
msgctxt "hooks.validation.interpreter_path"
msgid "Interpreter must be one executable path."
msgstr "解释器必须为单个可执行文件路径。"
msgctxt "hooks.validation.timeout_integer"
msgid "Timeout must be a whole number of seconds."
msgstr "超时时间必须为整数秒。"
msgctxt "hooks.notification_body"
msgid "{event} · {status}"
msgstr "{event} · {status}"

msgctxt "workflow.show_in_finder"
msgid "Show in Finder"
msgstr "在Finder中打开"

msgctxt "workflow.show_in_explorer"
msgid "Show in Explorer"
msgstr "在资源管理器中打开"

msgctxt "conflicts.copy_failed"
msgid "Failed to copy file contents. Try again."
msgstr "复制文件内容失败，请重试。"

msgctxt "settings.feedback.http_request_timeout_saved"
msgid "Request timeout saved."
msgstr "请求超时时间已保存。"

msgctxt "settings.feedback.http_request_timeout_save_failed"
msgid "Request timeout could not be saved."
msgstr "无法保存请求超时时间。"

msgctxt "settings.feedback.default_pr_merge_method_saved"
msgid "Default PR merge method saved."
msgstr "默认 PR 合并方式已保存。"

msgctxt "settings.feedback.default_pr_merge_method_save_failed"
msgid "Default PR merge method could not be saved."
msgstr "无法保存默认 PR 合并方式。"

msgctxt "tray.quit"
msgid "Quit"
msgstr "退出"

msgctxt "tag.initialization_timeout"
msgid "Tag initialization timed out. Try again."
msgstr "Tag 初始化超时，请重试。"

msgctxt "workflow.command_rejected"
msgid "Workflow is busy or closing. Try again."
msgstr "Workflow 正忙或正在关闭，请重试。"

msgctxt "settings.feedback.ai_agent_deleted"
msgid "AI Agent deleted."
msgstr "已删除 AI Agent。"

msgctxt "settings.feedback.ai_agent_delete_failed"
msgid "Could not delete AI Agent. Please try again."
msgstr "无法删除 AI Agent，请重试。"

msgctxt "settings.feedback.ai_agent_invalid_editor"
msgid "Enter an Agent name, Base URL and model."
msgstr "请填写 Agent 名称、Base URL 和模型。"

msgctxt "settings.feedback.ai_agent_invalid_headers"
msgid "Invalid headers. Check the names and values of enabled rows."
msgstr "Header 无效，请检查启用行的名称和值。"

msgctxt "settings.ai_agent.delete_confirmation"
msgid "Are you sure you want to delete the AI Agent named [{name}]?"
msgstr "你确定要删除名为 [{name}] 的 AI Agent吗？"

msgctxt "settings.feedback.ai_agent_test_failed"
msgid "Connection failed. Check the address, authentication and Headers."
msgstr "连接失败，请检查地址、认证和 Headers。"

msgctxt "settings.feedback.ai_agent_invalid_header_object"
msgid "Invalid Header object. Use a flat object with string values or string arrays, up to 32 Headers and 64 KiB."
msgstr "Header 对象无效。请使用值为字符串或字符串数组的平面对象，最多 32 条 Header、64 KiB。"
