import { WorkflowPrDiffFile, WorkflowPrDiffLine, WorkflowPrDiffRowMetric, WorkflowPrDiffVirtualWindow, WorkflowPrDiffSelectionHit, WorkflowPrDiffSelectionRange, WorkflowPrDiffTextSlice, WorkflowPrDiffGlyphRange, WorkflowPrDiffGlyphRect, WorkflowPrDiffFindMatch, WorkflowPrTreeItem, WorkflowPrFileExtensionFilter, WorkflowPrConversationItem, WorkflowPrCommit } from "../../components/pr_review/shell.slint";

// Public protocol shared by the complete page and the development shell. Keep
// route-specific state outside this component so multiple entry points can host
// the same PR Review package.
export component PullRequestReviewPageContract inherits FocusScope {
    in property <length> application-width: root.width;
    in property <length> application-height: root.height;
    in property <length> shell-leading-inset: 0px;
    in property <length> shell-content-width: max(0px, root.width - root.shell-leading-inset);
    in property <bool> live-resizing: false;
    in property <string> project-name;
    in property <string> provider;
    in property <string> pull-request-number;
    in property <string> pull-request-title;
    in property <string> author;
    in property <string> source-branch;
    in property <string> target-branch;
    in property <string> updated-at;
    in property <string> updated-at-tooltip;
    in property <int> added-lines: 0;
    in property <int> removed-lines: 0;
    in property <int> commit-count: 0;
    in property <int> conversation-count: 0;
    in property <string> base-sha;
    in property <string> head-sha;
    in property <bool> too-many-commits: false;
    in-out property <int> selected-tab: 2;
    in property <[WorkflowPrConversationItem]> conversation-items: [];
    in property <int> conversation-content-height: 0;
    in property <[WorkflowPrCommit]> commits: [];
    in property <bool> conversation-loading: false;
    in property <bool> commits-loading: false;
    in property <string> conversation-error: "";
    in property <string> commits-error: "";
    in property <int> commit-range-start: -1;
    in property <int> commit-range-end: -1;
    in property <string> commit-range-label: "All commits";
    in property <[WorkflowPrDiffFile]> files: [];
    in property <[WorkflowPrTreeItem]> tree-items: [];
    in property <[WorkflowPrFileExtensionFilter]> extension-filters: [];
    in property <bool> only-manifest-files: false;
    in property <bool> show-viewed-files: true;
    in property <bool> file-filters-active: false;
    in property <[WorkflowPrDiffLine]> lines: [];
    in property <[WorkflowPrDiffRowMetric]> line-metrics: [];
    in property <int> max-code-columns: 0;
    in property <string> longest-code-line;
    in property <int> line-content-revision: 0;
    in property <int> line-model-revision: 0;
    in property <bool> scroll-diagnostics-enabled: false;
    in property <int> hunk-scroll-anchor-source-index: -1;
    in property <int> hunk-scroll-restore-revision: 0;
    in property <int> selected-file-index: -1;
    in property <string> selected-file-path;
    in property <int> selected-file-added-lines: 0;
    in property <int> selected-file-removed-lines: 0;
    in property <bool> has-expandable-hunks: false;
    in property <bool> context-expanded: false;
    in property <bool> viewing-file: false;
    in property <bool> loading: false;
    in property <bool> code-loading: false;
    in property <bool> large-diff-deferred: false;
    in property <bool> large-diff-loading: false;
    in property <string> error-text;
    in property <bool> ignore-whitespace-supported: false;
    in-out property <bool> ignore-whitespace: false;
    in-out property <string> diff-view: "unified";
    in-out property <string> file-filter: "";
    in-out property <bool> review-dialog-open: false;
    in-out property <bool> dismiss-review-dialog-open: false;
    in-out property <bool> merge-dialog-open: false;
    in-out property <bool> revert-dialog-open: false;
    in-out property <bool> commit-range-dialog-open: false;
    in property <bool> action-loading: false;
    in property <bool> can-comment: false;
    in property <bool> can-approve: false;
    in property <bool> can-request-changes: false;
    in property <string> remote-review-state: "";
    in property <bool> can-merge: false;
    in property <bool> can-revert: false;
    in property <string> merge-readiness-kind: "";
    in property <string> merge-readiness-label: "";
    in property <string> merge-readiness-detail: "";
    in property <string> merge-block-reason: "";
    in property <string> revert-block-reason: "";
    in property <string> revert-action-label: "Revert changes";
    in property <string> revert-confirmation: "";
    in property <bool> merge-method-merge: false;
    in property <bool> merge-method-squash: false;
    in property <bool> merge-method-rebase: false;
    in property <bool> merge-method-fast-forward: false;
    in property <string> ai-review-status: "";
    in property <int> ai-review-finding-count: 0;
    in property <bool> ai-review-panel-visible: false;
    in-out property <length> file-list-preferred-width: 286px;
    in property <string> tree-font-family: ".SF NS";
    in property <string> code-font-family: "Menlo";
    in property <length> code-font-size: 13px;
    in property <int> expanded-commit-body-height: 0;

    callback select-tab(int);
    callback ensure-commits();
    callback apply-commit-range(int, int);
    callback open-commit(string);
    callback select-file(int);
    callback select-relative-file(int);
    callback reload(bool);
    callback apply-diff-settings(string, bool);
    callback load-large-diff();
    callback submit-review(string, string);
    callback dismiss-review(string, string);
    callback merge(string, bool);
    callback revert();
    callback filter-files(string);
    callback toggle-extension-filter(string);
    callback toggle-manifest-filter();
    callback toggle-viewed-files();
    callback toggle-folder(string);
    callback expand-hunk(int, string);
    callback expand-all-hunks();
    callback collapse-non-diff-lines();
    callback copy-file-path(string) -> bool;
    callback copy-commit-sha(string) -> bool;
    callback copy-source-branch(string) -> bool;
    callback copy-diff-selection(int, int, int, int, string);
    callback resolve-diff-selection(int, float, float, float, float, float, float, string, float, string) -> WorkflowPrDiffSelectionHit;
    pure callback resolve-diff-token-hit(string, float, float, string, float, bool, bool) -> int;
    pure callback resolve-diff-token-range(string, int, int, float, string, float, bool, bool) -> WorkflowPrDiffGlyphRange;
    pure callback resolve-diff-wrapped-range(string, int, int, float, float, string, float) -> [WorkflowPrDiffGlyphRect];
    pure callback resolve-diff-selection-slice(int, string, int, int) -> WorkflowPrDiffTextSlice;
    pure callback resolve-diff-wrap-line-start(int, string, int, int) -> int;
    callback resolve-diff-click-range(int, int, string, int) -> WorkflowPrDiffSelectionRange;
    callback find-diff-matches(string, bool) -> [WorkflowPrDiffFindMatch];
    pure callback find-diff-row-matches(int, string, string) -> [WorkflowPrDiffFindMatch];
    pure callback step-diff-find-index(int, int, bool) -> int;
    callback resolve-diff-find-viewport-y(int, int, float, float, string, float, float, float) -> float;
    callback layout-diff-virtual-window(int, [WorkflowPrDiffRowMetric], float, float, float, float, float, float) -> WorkflowPrDiffVirtualWindow;
    callback diagnose-diff-scroll(string, float, float, float, float, bool, bool, bool, int, int, int);
    callback view-file();
    callback toggle-commit-message(string);
    callback toggle-ai-review();
}
