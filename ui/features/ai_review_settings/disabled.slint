export struct AiReviewRuleItem {
    id: string,
    name: string,
    path: string,
    is-default: bool,
}

export component GitHubAiReviewSettingsSection inherits Rectangle {
    in property <[AiReviewRuleItem]> rules: [];
    in property <int> max-concurrent-tasks: 3;
    in-out property <bool> rule-add-pending: false;
    in-out property <string> rule-name-error: "";
    in-out property <string> rule-path-error: "";
    callback set-max-concurrent-tasks(int);
    callback add-rule(string, string);
    callback delete-rule(string);
    callback set-default-rule(string);
    width: 100%;
    height: 64px;
    Text { text: "AI Code Review is not included in this build."; color: #57606a; }
}
