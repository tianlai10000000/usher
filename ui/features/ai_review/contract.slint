import { AgentResponseBlock } from "../../components/agent_response/github_agent_response.slint";

export { AgentResponseBlockKind, AgentResponseBlock } from "../../components/agent_response/github_agent_response.slint";

export struct AiReviewTaskItem {
    id: string,
    project-key: string,
    pull-request-number: string,
    pull-request-title: string,
    rule-name: string,
    model-name: string,
    status: string,
    progress-percent: int,
    completed-chunks: int,
    total-chunks: int,
    finding-count: int,
    error: string,
}

export struct AiReviewRuleChoice {
    id: string,
    name: string,
    selected: bool,
    inherited: bool,
}

export struct AiReviewFindingItem {
    id: string,
    severity: string,
    file: string,
    line: int,
    side: string,
    head-sha: string,
    title: string,
    explanation: string,
    suggestion: string,
}

export struct AiReviewConversationItem {
    id: string,
    role: string,
    content: string,
    elapsed: string,
    formatted: bool,
    blocks: [AgentResponseBlock],
    preview-title: string,
    preview-available: bool,
    truncated: bool,
    projected-bytes: int,
    repository-action-count: int,
}

// Flattened projection for Slint's single-repeater response list. Nested
// models and strings remain shared with the source conversation and findings.
export struct AiReviewResponseVisualRow {
    kind: string,
    finding: AiReviewFindingItem,
    message: AiReviewConversationItem,
}

// Stable protocol shared by the complete and feature-disabled packages.
export component AiReviewPanelContract inherits Rectangle {
    in property <string> application-font-family: "sans-serif";
    in property <string> code-font-family: "Menlo";
    in property <string> task-id: "";
    in property <string> project-name: "";
    in property <string> pull-request-number: "";
    in property <string> pull-request-title: "";
    in property <string> rule-names: "";
    in property <string> model-name: "";
    in property <string> status: "queued";
    in property <int> progress-percent: 0;
    in property <int> completed-chunks: 0;
    in property <int> total-chunks: 0;
    in-out property <int> elapsed-seconds: 0;
    in property <string> summary: "";
    in property <string> error-text: "";
    in property <[AiReviewFindingItem]> findings: [];
    in property <string> selected-finding-id: "";
    in property <string> finding-navigation-message: "";
    in property <bool> finding-navigation-can-view-file: false;
    in property <[AiReviewConversationItem]> conversation: [];
    in property <[AiReviewResponseVisualRow]> response-rows: [];
    in property <bool> response-virtualized: false;
    in-out property <int> retained-created-message-rows: 0;
    in-out property <int> retained-created-blocks: 0;
    in-out property <int> virtual-created-rows: 0;
    in-out property <int> virtual-created-message-rows: 0;
    in-out property <int> virtual-created-blocks: 0;
    in-out property <string> message-input: "";
    in-out property <string> extra-requirements: "";
    in property <bool> chat-sending: false;
    in property <string> chat-status: "";
    in-out property <int> chat-elapsed-seconds: 0;
    in property <bool> layout-resizing: false;
    in property <bool> content-active: true;
    in-out property <length> response-scroll-y: 0px;
    callback close();
    callback cancel(string);
    callback cancel-message(string);
    callback re-review(string);
    callback send-message(string);
    callback select-finding(string, string, int, string, string);
    callback view-finding-file(string, string);
    callback open-response-artifact(string, string, string);
    callback open-response-link(string);
    callback response-wheel-consumed(length);
    callback interaction-started();
}
