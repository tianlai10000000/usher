import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { ListView } from "@material";
import { GitHubScrollView, GitHubVirtualListScrollbar } from "../../components/github_scroll_view.slint";
import { GitHubIconButton } from "../../components/button/github_icon_button.slint";
import { GitHubCenteredLoadingState, GitHubSpinner } from "../../components/github_spinner.slint";
import { GitHubAiReviewFindingRow, GitHubAiReviewUserMessage } from "../../components/ai_review/github_ai_review_components.slint";
import { GitHubSegmentedControl, GitHubSegmentedControlDivider, GitHubSegmentedControlItem } from "../../components/github_segmented_control.slint";
import { AgentResponseBlock, GitHubAgentResponse } from "../../components/agent_response/github_agent_response.slint";
import { AiReviewPanelContract, AiReviewFindingItem, AiReviewConversationItem, AiReviewResponseVisualRow } from "./contract.slint";
import { I18n } from "@i18n";

export { AgentResponseBlockKind, AgentResponseBlock, AiReviewTaskItem, AiReviewRuleChoice, AiReviewFindingItem, AiReviewConversationItem, AiReviewResponseVisualRow } from "./contract.slint";

component GitHubAiReviewVirtualResponseRow inherits Rectangle {
    in property <AiReviewResponseVisualRow> visual-row;
    in property <bool> first-row: false;
    in property <length> response-message-width: 0px;
    in property <string> status: "";
    in property <bool> running: false;
    in property <string> elapsed-label: "";
    in property <string> review-progress-label: "";
    in property <string> summary: "";
    in property <string> error-text: "";
    in property <int> finding-count: 0;
    in property <bool> chat-sending: false;
    in property <string> chat-status: "";
    in property <string> chat-elapsed-label: "";
    in property <string> model-name: "";
    in property <string> application-font-family: "sans-serif";
    in property <string> code-font-family: "Menlo";
    in property <string> selected-finding-id: "";
    in property <string> finding-navigation-message: "";
    in property <bool> finding-navigation-can-view-file: false;
    callback select-finding(string, string, int, string, string);
    callback view-finding-file(string, string);
    callback open-response-artifact(string, string, string);
    callback open-response-link(string);
    callback interaction-started();
    callback created(bool, int);

    private property <length> leading-padding: root.first-row ? 24px : 0px;
    private property <length> trailing-padding:
        root.visual-row.kind == "chat-status" ? 28px : 16px;
    private property <length> row-content-height:
        root.visual-row.kind == "review-state" ? review-state-layout.preferred-height
            : root.visual-row.kind == "finding" ? finding-layout.preferred-height
            : root.visual-row.kind == "separator" ? GitHubMetrics.border-thin
            : root.visual-row.kind == "message" ? message-layout.preferred-height
            : root.visual-row.kind == "chat-status" && root.chat-sending
                ? chat-status-layout.preferred-height
            : 0px;

    height: root.leading-padding + root.row-content-height + root.trailing-padding;
    background: transparent;

    init => {
        root.created(
            root.visual-row.kind == "message",
            root.visual-row.kind == "message" ? root.visual-row.message.blocks.length : 0
        );
    }

    row-blank-touch := TouchArea {
        y: root.leading-padding;
        width: parent.width;
        height: root.row-content-height;
        clicked => { root.interaction-started(); }
    }

    review-state-layout := VerticalLayout {
        x: (parent.width - root.response-message-width) / 2;
        y: root.leading-padding;
        width: root.response-message-width;
        spacing: 0px;

        if root.visual-row.kind == "review-state" && root.running: GitHubCenteredLoadingState {
            width: parent.width;
            height: 112px;
            label: root.review-progress-label;
        }

        if root.visual-row.kind == "review-state"
                && (root.status == "failed" || root.status == "cancelled"): Rectangle {
            width: parent.width;
            height: max(100px, virtual-error-message.preferred-height + 58px);
            border-radius: GitHubMetrics.radius-medium;
            border-width: GitHubMetrics.border-thin;
            border-color: root.status == "failed"
                ? GitHubTheme.danger-emphasis
                : GitHubTheme.border-default;
            background: GitHubTheme.canvas-subtle;
            virtual-error-message := Text {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: self.preferred-height;
                text: root.status == "cancelled" ? I18n.ai-review-cancelled : root.error-text;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                wrap: word-wrap;
            }
            Text {
                x: 16px;
                y: virtual-error-message.y + virtual-error-message.height + 8px;
                width: parent.width - 32px;
                height: 16px;
                text: I18n.ai-review-elapsed + " " + root.elapsed-label;
                font-size: 11px;
                color: GitHubTheme.fg-muted;
            }
        }

        if root.visual-row.kind == "review-state" && root.status == "completed": VerticalLayout {
            width: parent.width;
            spacing: 12px;
            HorizontalLayout {
                width: parent.width;
                height: 24px;
                spacing: 8px;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: GitHubTheme.canvas-subtle;
                    Image {
                        x: 4px;
                        y: 4px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                        colorize: GitHubTheme.fg-default;
                    }
                }
                Text {
                    text: I18n.ai-review-copilot-review;
                    font-size: 13px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }
            }
            Text {
                width: parent.width;
                height: self.preferred-height;
                text: root.finding-count == 0
                    ? I18n.ai-review-no-actionable-findings + " · " + root.elapsed-label
                    : I18n.ai-review-completed + " · " + root.elapsed-label + " · "
                        + root.finding-count + " "
                        + (root.finding-count == 1 ? I18n.ai-review-finding : I18n.ai-review-findings);
                font-size: 14px;
                font-weight: 600;
                color: root.finding-count == 0
                    ? GitHubTheme.success-fg
                    : GitHubTheme.fg-default;
                wrap: word-wrap;
            }
            if root.summary != "": Text {
                width: parent.width;
                height: self.preferred-height;
                text: root.summary;
                font-size: 13px;
                color: GitHubTheme.fg-muted;
                wrap: word-wrap;
            }
        }
    }

    finding-layout := VerticalLayout {
        x: (parent.width - root.response-message-width) / 2;
        y: root.leading-padding;
        width: root.response-message-width;

        if root.visual-row.kind == "finding": GitHubAiReviewFindingRow {
            width: parent.width;
            severity: root.visual-row.finding.severity;
            file: root.visual-row.finding.file;
            line: root.visual-row.finding.line;
            title: root.visual-row.finding.title;
            explanation: root.visual-row.finding.explanation;
            suggestion: root.visual-row.finding.suggestion;
            selected: root.selected-finding-id == root.visual-row.finding.id;
            navigation-message: self.selected ? root.finding-navigation-message : "";
            navigation-can-view-file: self.selected && root.finding-navigation-can-view-file;
            activated => {
                root.select-finding(
                    root.visual-row.finding.id,
                    root.visual-row.finding.file,
                    root.visual-row.finding.line,
                    root.visual-row.finding.side,
                    root.visual-row.finding.head-sha
                );
            }
            view-file => {
                root.view-finding-file(
                    root.visual-row.finding.file,
                    root.visual-row.finding.side
                );
            }
        }
    }

    if root.visual-row.kind == "separator": Rectangle {
        x: (parent.width - root.response-message-width) / 2;
        y: root.leading-padding;
        width: root.response-message-width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-muted;
    }

    message-layout := VerticalLayout {
        visible: root.visual-row.kind == "message";
        x: (parent.width - root.response-message-width) / 2;
        y: root.leading-padding;
        width: root.response-message-width;
        spacing: root.visual-row.message.role == "user" ? 0px : GitHubMetrics.size-8;

        if root.visual-row.kind == "message" && root.visual-row.message.role == "user": GitHubAiReviewUserMessage {
            width: parent.width;
            content: root.visual-row.message.content;
        }

        if root.visual-row.kind == "message" && root.visual-row.message.role != "user"
                && (!root.visual-row.message.formatted
                    || (root.visual-row.message.blocks.length == 0
                        && !root.visual-row.message.preview-available)): VerticalLayout {
            width: parent.width;
            spacing: GitHubMetrics.size-6;
            Text {
                width: parent.width;
                height: self.preferred-height;
                text: root.visual-row.message.content;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                wrap: word-wrap;
            }
            if root.visual-row.message.preview-available: GitHubAgentResponse {
                width: parent.width;
                blocks: [];
                preview-title: root.visual-row.message.preview-title;
                preview-available: true;
                truncated: root.visual-row.message.truncated;
                body-font-family: root.application-font-family;
                code-font-family: root.code-font-family;
                open-full-response => {
                    root.open-response-artifact(
                        root.visual-row.message.id,
                        root.visual-row.message.preview-title,
                        root.visual-row.message.content
                    );
                }
            }
        }

        if root.visual-row.kind == "message" && root.visual-row.message.role != "user"
                && root.visual-row.message.formatted
                && (root.visual-row.message.blocks.length > 0
                    || root.visual-row.message.preview-available): GitHubAgentResponse {
            width: parent.width;
            blocks: root.visual-row.message.blocks;
            preview-title: root.visual-row.message.preview-title;
            preview-available: root.visual-row.message.preview-available;
            truncated: root.visual-row.message.truncated;
            body-font-family: root.application-font-family;
            code-font-family: root.code-font-family;
            open-link(url) => { root.open-response-link(url); }
            open-full-response => {
                root.open-response-artifact(
                    root.visual-row.message.id,
                    root.visual-row.message.preview-title,
                    root.visual-row.message.content
                );
            }
        }

        if root.visual-row.kind == "message" && root.visual-row.message.role != "user"
                && root.visual-row.message.elapsed != "": Text {
            width: parent.width;
            height: GitHubMetrics.size-20;
            text: I18n.ai-review-worked-for + " " + root.visual-row.message.elapsed;
            font-size: GitHubMetrics.text-small;
            color: GitHubTheme.fg-muted;
            vertical-alignment: center;
        }
    }

    chat-status-layout := VerticalLayout {
        visible: root.visual-row.kind == "chat-status" && root.chat-sending;
        x: (parent.width - root.response-message-width) / 2;
        y: root.leading-padding;
        width: root.response-message-width;
        spacing: 8px;
        accessible-role: progress-indicator;
        accessible-label: root.chat-status == "" ? I18n.common-thinking : root.chat-status;
        if root.visual-row.kind == "chat-status" && root.chat-sending: HorizontalLayout {
            width: parent.width;
            height: 24px;
            spacing: 8px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: GitHubTheme.canvas-subtle;
                Image {
                    x: 4px;
                    y: 4px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                    colorize: GitHubTheme.fg-default;
                }
            }
            Text {
                text: root.model-name == "" ? "AI Agent" : root.model-name;
                font-size: 13px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
                vertical-alignment: center;
            }
        }
        if root.visual-row.kind == "chat-status" && root.chat-sending: HorizontalLayout {
            width: parent.width;
            height: 22px;
            spacing: 8px;
            cross-axis-alignment: center;
            Rectangle {
                width: 16px;
                height: 22px;
                background: transparent;
                GitHubSpinner {
                    y: 2px;
                    spinner-size: 16px;
                    foreground: GitHubTheme.fg-muted;
                }
            }
            Text {
                text: (root.chat-status == "" ? I18n.common-thinking : root.chat-status)
                    + " · " + root.chat-elapsed-label;
                font-size: 13px;
                color: GitHubTheme.fg-muted;
                vertical-alignment: center;
            }
        }
    }
}

// Route-independent review surface. The application keeps the light panel
// shell mounted while it owns PR-side state, but may unmount the response
// delegates while a Docked contextual Preview occupies the same surface.
export component GitHubAiReviewPanel inherits AiReviewPanelContract {

    private property <bool> running: root.status == "queued" || root.status == "running";
    private property <bool> review-again-mode: false;
    private property <bool> composer-stopping:
        (root.review-again-mode && root.running)
            || (!root.review-again-mode && root.chat-sending);
    private property <bool> response-scroll-restoring: false;
    private property <bool> response-scroll-to-bottom-on-mount: false;
    private property <length> retained-response-viewport-y: 0px;
    private property <length> retained-response-visible-height: 0px;
    private property <length> retained-response-content-height: 0px;
    private property <length> retained-response-visible-width: 0px;
    private property <length> virtual-response-viewport-y: 0px;
    private property <length> virtual-response-visible-height: 0px;
    private property <length> virtual-response-content-height: 0px;
    private property <length> virtual-response-visible-width: 0px;
    private property <[AiReviewResponseVisualRow]> active-response-rows:
        root.content-active && root.response-virtualized ? root.response-rows : [];
    private property <length> active-response-viewport-y:
        root.response-virtualized
            ? root.virtual-response-viewport-y
            : root.retained-response-viewport-y;
    private property <length> active-response-visible-height:
        root.response-virtualized
            ? root.virtual-response-visible-height
            : root.retained-response-visible-height;
    private property <length> active-response-content-height:
        root.response-virtualized
            ? root.virtual-response-content-height
            : root.retained-response-content-height;
    private property <length> active-response-visible-width:
        root.response-virtualized
            ? root.virtual-response-visible-width
            : root.retained-response-visible-width;
    private property <length> observed-response-scroll-y: root.active-response-viewport-y;
    private property <length> header-height: 64px;
    private property <length> composer-height: 136px;
    private property <length> stable-response-content-width: root.active-response-visible-width;
    private property <length> response-content-width:
        root.layout-resizing
            ? root.stable-response-content-width
            : root.active-response-visible-width;
    private property <length> response-horizontal-padding:
        root.width < 460px ? 20px : 32px;
    private property <length> response-message-width:
        max(0px, root.response-content-width - root.response-horizontal-padding * 2);
    private property <int> elapsed-minutes: root.elapsed-seconds / 60;
    private property <int> elapsed-hours: root.elapsed-minutes / 60;
    private property <int> elapsed-minute-part: Math.mod(root.elapsed-minutes, 60);
    private property <int> elapsed-second-part: Math.mod(root.elapsed-seconds, 60);
    private property <int> current-chunk:
        root.total-chunks > 0
            ? (root.completed-chunks < root.total-chunks
                ? root.completed-chunks + 1
                : root.total-chunks)
            : 0;
    private property <string> review-progress-label:
        root.status == "queued"
            ? I18n.pr-list-ai-review-queued + " · " + root.elapsed-label
            : root.total-chunks > 0
                ? I18n.ai-review-processing-chunk + " " + root.current-chunk + "/" + root.total-chunks
                    + " · " + root.elapsed-label + " · " + root.progress-percent + "%"
                : I18n.ai-review-reviewing-changes + " · " + root.elapsed-label + " · "
                    + root.progress-percent + "%";
    private property <string> elapsed-label:
        root.elapsed-hours > 0
            ? root.elapsed-hours + "h "
                + (root.elapsed-minute-part < 10 ? "0" : "")
                + root.elapsed-minute-part + "m "
                + (root.elapsed-second-part < 10 ? "0" : "")
                + root.elapsed-second-part + "s"
            : root.elapsed-minutes > 0
                ? root.elapsed-minutes + "m "
                    + (root.elapsed-second-part < 10 ? "0" : "")
                    + root.elapsed-second-part + "s"
                : root.elapsed-seconds + "s";
    private property <int> chat-elapsed-minutes: root.chat-elapsed-seconds / 60;
    private property <int> chat-elapsed-hours: root.chat-elapsed-minutes / 60;
    private property <int> chat-elapsed-minute-part: Math.mod(root.chat-elapsed-minutes, 60);
    private property <int> chat-elapsed-second-part: Math.mod(root.chat-elapsed-seconds, 60);
    private property <string> chat-elapsed-label:
        root.chat-elapsed-hours > 0
            ? root.chat-elapsed-hours + "h "
                + (root.chat-elapsed-minute-part < 10 ? "0" : "")
                + root.chat-elapsed-minute-part + "m "
                + (root.chat-elapsed-second-part < 10 ? "0" : "")
                + root.chat-elapsed-second-part + "s"
            : root.chat-elapsed-minutes > 0
                ? root.chat-elapsed-minutes + "m "
                    + (root.chat-elapsed-second-part < 10 ? "0" : "")
                    + root.chat-elapsed-second-part + "s"
                : root.chat-elapsed-seconds + "s";

    function set-response-viewport-y(value: length) {
        if root.response-virtualized {
            root.virtual-response-viewport-y = value;
        } else {
            root.retained-response-viewport-y = value;
        }
        root.response-scroll-y = value;
    }

    function response-bottom-y() -> length {
        return min(
            0px,
            root.active-response-visible-height - root.active-response-content-height
        );
    }

    function request-response-bottom() {
        root.response-scroll-to-bottom-on-mount = true;
        root.response-scroll-restoring = true;
        response-scroll-restore.restart();
    }
    background: GitHubTheme.canvas-default;
    border-width: 0px;
    clip: true;

    // Non-interactive header/composer space dismisses a popover owned by the
    // adjacent PR workspace. Interactive descendants remain above this target.
    panel-blank-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.interaction-started(); }
    }

    changed width => {
        if !root.layout-resizing {
            root.stable-response-content-width = root.active-response-visible-width;
        }
    }
    changed layout-resizing => {
        // Freeze the block column during continuous divider/native resize and
        // commit the final wrapping width once the interaction settles.
        root.stable-response-content-width = root.active-response-visible-width;
    }

    header := Rectangle {
        z: 10;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.header-height;
        background: GitHubTheme.canvas-default;
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: GitHubTheme.border-default;
        }
        Image {
            x: 16px;
            y: 14px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
            colorize: GitHubTheme.fg-default;
        }
        Text {
            x: 42px;
            y: 7px;
            width: max(80px, parent.width - 146px);
            height: 24px;
            text: I18n.ai-review-title;
            font-size: 14px;
            font-weight: 600;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
        Text {
            x: 42px;
            y: 31px;
            width: max(80px, parent.width - 146px);
            height: 20px;
            text: (root.rule-names == "" ? I18n.common-no-preset : root.rule-names)
                + (root.model-name == "" ? "" : "  ·  " + root.model-name);
            font-size: 12px;
            color: GitHubTheme.fg-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        GitHubIconButton {
            x: parent.width - (root.running ? 74px : 82px);
            y: root.running ? 20px : 16px;
            control-size: root.running
                ? GitHubMetrics.control-xsmall-size
                : GitHubMetrics.control-medium-size;
            visual-size: root.running
                ? GitHubMetrics.size-20
                : GitHubMetrics.control-medium-size;
            icon: root.running
                ? @image-url("../../assets/icons/github-stop-square-fill-16.svg")
                : @image-url("../../assets/icons/octicon-sync-16.svg");
            tooltip-text: root.running ? I18n.pr-list-cancel-review : I18n.ai-review-review-current-again;
            inverse: root.running;
            circular: root.running;
            button-enabled: root.task-id != "";
            clicked => {
                if root.running {
                    root.cancel(root.task-id);
                } else {
                    root.re-review(root.extra-requirements);
                }
            }
        }
        GitHubIconButton {
            x: parent.width - 42px;
            y: 16px;
            control-size: GitHubMetrics.size-32;
            icon: @image-url("../../assets/icons/octicon-x-16.svg");
            tooltip-text: I18n.ai-review-close;
            clicked => { root.close(); }
        }
    }

    if !root.response-virtualized: message-scroll := GitHubScrollView {
        x: 0px;
        y: root.header-height;
        width: parent.width;
        height: max(0px, parent.height - root.header-height - root.composer-height);
        background: GitHubTheme.canvas-default;
        show-scrollbar: !root.layout-resizing;
        report-pointer-interactions: true;
        viewport_y <=> root.retained-response-viewport-y;
        changed visible_width => { root.retained-response-visible-width = self.visible_width; }
        changed visible_height => { root.retained-response-visible-height = self.visible_height; }
        changed content_height => { root.retained-response-content-height = self.content_height; }
        init => {
            root.retained-response-visible-width = self.visible_width;
            root.retained-response-visible-height = self.visible_height;
            root.retained-response-content-height = self.content_height;
        }
        pointer-interaction-started => { root.interaction-started(); }
        user-wheel-direction(movement) => {
            root.response-wheel-consumed(movement);
        }
        if root.content-active: message-content := Rectangle {
            width: root.response-content-width;
            height: message-layout.preferred-height;
            background: transparent;

            // The Flickable owns gestures in this region, so give its complete
            // content a local blank-area target as well as the panel backdrop.
            message-blank-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.interaction-started(); }
            }

            message-layout := VerticalLayout {
                width: parent.width;
                padding-top: 24px;
                padding-left: root.response-horizontal-padding;
                padding-right: root.response-horizontal-padding;
                padding-bottom: 28px;
                spacing: 16px;
                alignment: start;

            if root.running: GitHubCenteredLoadingState {
                width: root.response-message-width;
                height: 112px;
                label: root.status == "queued"
                    ? I18n.pr-list-ai-review-queued + " · " + root.elapsed-label
                    : root.total-chunks > 0
                        ? I18n.ai-review-processing-chunk + " " + root.current-chunk + "/" + root.total-chunks
                            + " · " + root.elapsed-label + " · " + root.progress-percent + "%"
                        : I18n.ai-review-reviewing-changes + " · " + root.elapsed-label
                            + " · " + root.progress-percent + "%";
            }

            if root.status == "failed" || root.status == "cancelled": Rectangle {
                width: root.response-message-width;
                height: max(100px, error-message.preferred-height + 58px);
                border-radius: GitHubMetrics.radius-medium;
                border-width: GitHubMetrics.border-thin;
                border-color: root.status == "failed"
                    ? GitHubTheme.danger-emphasis
                    : GitHubTheme.border-default;
                background: GitHubTheme.canvas-subtle;
                error-message := Text {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: self.preferred-height;
                    text: root.status == "cancelled" ? I18n.ai-review-cancelled : root.error-text;
                    font-size: 13px;
                    color: GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
                Text {
                    x: 16px;
                    y: error-message.y + error-message.height + 8px;
                    width: parent.width - 32px;
                    height: 16px;
                    text: I18n.ai-review-elapsed + " " + root.elapsed-label;
                    font-size: 11px;
                    color: GitHubTheme.fg-muted;
                }
            }

            if root.status == "completed": VerticalLayout {
                width: root.response-message-width;
                spacing: 12px;
                HorizontalLayout {
                    width: parent.width;
                    height: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: GitHubTheme.canvas-subtle;
                        Image {
                            x: 4px;
                            y: 4px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                            colorize: GitHubTheme.fg-default;
                        }
                    }
                    Text {
                        text: I18n.ai-review-copilot-review;
                        font-size: 13px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                }
                Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: root.findings.length == 0
                        ? I18n.ai-review-no-actionable-findings + " · " + root.elapsed-label
                        : I18n.ai-review-completed + " · " + root.elapsed-label + " · "
                            + root.findings.length + " "
                            + (root.findings.length == 1 ? I18n.ai-review-finding : I18n.ai-review-findings);
                    font-size: 14px;
                    font-weight: 600;
                    color: root.findings.length == 0
                        ? GitHubTheme.success-fg
                        : GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
                if root.summary != "": Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: root.summary;
                    font-size: 13px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
            }

            for finding[index] in root.findings: GitHubAiReviewFindingRow {
                width: root.response-message-width;
                severity: finding.severity;
                file: finding.file;
                line: finding.line;
                title: finding.title;
                explanation: finding.explanation;
                suggestion: finding.suggestion;
                selected: root.selected-finding-id == finding.id;
                navigation-message: self.selected ? root.finding-navigation-message : "";
                navigation-can-view-file: self.selected && root.finding-navigation-can-view-file;
                activated => {
                    root.select-finding(
                        finding.id,
                        finding.file,
                        finding.line,
                        finding.side,
                        finding.head-sha
                    );
                }
                view-file => { root.view-finding-file(finding.file, finding.side); }
            }

            if root.conversation.length > 0: Rectangle {
                width: root.response-message-width;
                height: GitHubMetrics.border-thin;
                background: GitHubTheme.border-muted;
            }

            for message in root.conversation: VerticalLayout {
                width: root.response-message-width;
                spacing: message.role == "user" ? 0px : GitHubMetrics.size-8;
                init => {
                    root.retained-created-message-rows += 1;
                    root.retained-created-blocks += message.blocks.length;
                }

                if message.role == "user": GitHubAiReviewUserMessage {
                    width: parent.width;
                    content: message.content;
                }

                if message.role != "user" && (!message.formatted
                        || (message.blocks.length == 0 && !message.preview-available)): VerticalLayout {
                    width: parent.width;
                    spacing: GitHubMetrics.size-6;

                    Text {
                        width: parent.width;
                        height: self.preferred-height;
                        text: message.content;
                        font-size: 13px;
                        color: GitHubTheme.fg-default;
                        wrap: word-wrap;
                    }

                    if message.role != "user" && message.preview-available: GitHubAgentResponse {
                        width: parent.width;
                        blocks: [];
                        preview-title: message.preview-title;
                        preview-available: true;
                        truncated: message.truncated;
                        body-font-family: root.application-font-family;
                        code-font-family: root.code-font-family;
                        open-full-response => {
                            root.open-response-artifact(
                                message.id,
                                message.preview-title,
                                message.content
                            );
                        }
                    }
                }
                if message.role != "user" && message.formatted
                        && (message.blocks.length > 0 || message.preview-available): GitHubAgentResponse {
                    width: parent.width;
                    blocks: message.blocks;
                    preview-title: message.preview-title;
                    preview-available: message.preview-available;
                    truncated: message.truncated;
                    body-font-family: root.application-font-family;
                    code-font-family: root.code-font-family;
                    open-link(url) => { root.open-response-link(url); }
                    open-full-response => {
                        root.open-response-artifact(
                            message.id,
                            message.preview-title,
                            message.content
                        );
                    }
                }
                if message.role != "user" && message.elapsed != "": Text {
                    width: parent.width;
                    height: GitHubMetrics.size-20;
                    text: I18n.ai-review-worked-for + " " + message.elapsed;
                    font-size: GitHubMetrics.text-small;
                    color: GitHubTheme.fg-muted;
                    vertical-alignment: center;
                }
            }

                if root.chat-sending: VerticalLayout {
                width: root.response-message-width;
                spacing: 8px;
                accessible-role: progress-indicator;
                accessible-label: root.chat-status == "" ? I18n.common-thinking : root.chat-status;

                HorizontalLayout {
                    width: parent.width;
                    height: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: GitHubTheme.canvas-subtle;
                        Image {
                            x: 4px;
                            y: 4px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                            colorize: GitHubTheme.fg-default;
                        }
                    }
                    Text {
                        text: root.model-name == "" ? "AI Agent" : root.model-name;
                        font-size: 13px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 22px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 22px;
                        background: transparent;
                        GitHubSpinner {
                            y: 2px;
                            spinner-size: 16px;
                            foreground: GitHubTheme.fg-muted;
                        }
                    }
                    Text {
                        text: (root.chat-status == "" ? I18n.common-thinking : root.chat-status)
                            + " · " + root.chat-elapsed-label;
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                    }
                }
                }
            }
        }
    }

    if root.response-virtualized: virtual-response-host := Rectangle {
        x: 0px;
        y: root.header-height;
        width: parent.width;
        height: max(0px, parent.height - root.header-height - root.composer-height);
        background: GitHubTheme.canvas-default;

        virtual-response-list := ListView {
            width: parent.width;
            height: parent.height;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            viewport-y <=> root.virtual-response-viewport-y;
            changed visible-width => { root.virtual-response-visible-width = self.visible-width; }
            changed visible-height => { root.virtual-response-visible-height = self.visible-height; }
            changed viewport-height => { root.virtual-response-content-height = self.viewport-height; }
            init => {
                root.virtual-response-visible-width = self.visible-width;
                root.virtual-response-visible-height = self.visible-height;
                root.virtual-response-content-height = self.viewport-height;
            }
            scrolled => { root.interaction-started(); }

            for row[index] in root.active-response-rows: GitHubAiReviewVirtualResponseRow {
                width: virtual-response-list.visible-width;
                visual-row: row;
                first-row: index == 0;
                response-message-width: root.response-message-width;
                status: root.status;
                running: root.running;
                elapsed-label: root.elapsed-label;
                review-progress-label: root.review-progress-label;
                summary: root.summary;
                error-text: root.error-text;
                finding-count: root.findings.length;
                chat-sending: root.chat-sending;
                chat-status: root.chat-status;
                chat-elapsed-label: root.chat-elapsed-label;
                model-name: root.model-name;
                application-font-family: root.application-font-family;
                code-font-family: root.code-font-family;
                selected-finding-id: root.selected-finding-id;
                finding-navigation-message: root.finding-navigation-message;
                finding-navigation-can-view-file: root.finding-navigation-can-view-file;
                select-finding(id, file, line, side, head-sha) => {
                    root.select-finding(id, file, line, side, head-sha);
                }
                view-finding-file(file, side) => { root.view-finding-file(file, side); }
                open-response-artifact(id, title, markdown) => {
                    root.open-response-artifact(id, title, markdown);
                }
                open-response-link(url) => { root.open-response-link(url); }
                interaction-started => { root.interaction-started(); }
                created(message-row, blocks) => {
                    root.virtual-created-rows += 1;
                    if message-row {
                        root.virtual-created-message-rows += 1;
                        root.virtual-created-blocks += blocks;
                    }
                }
            }
        }

        GitHubVirtualListScrollbar {
            x: parent.width - self.width;
            width: GitHubMetrics.size-8;
            height: parent.height;
            viewport-y <=> virtual-response-list.viewport-y;
            visible-height: virtual-response-list.visible-height;
            content-height: virtual-response-list.viewport-height;
            enabled: !root.layout-resizing;
            z: 20;
        }
    }

    changed observed-response-scroll-y => {
        if root.content-active && !root.response-scroll-restoring {
            let movement = root.observed-response-scroll-y - root.response-scroll-y;
            if root.response-virtualized && Math.abs(movement / 1px) > 0.25 {
                root.response-wheel-consumed(movement);
            }
            root.response-scroll-y = root.observed-response-scroll-y;
        }
    }

    changed content-active => {
        if root.content-active {
            root.response-scroll-restoring = true;
            response-scroll-restore.restart();
        } else {
            root.response-scroll-restoring = true;
        }
    }

    response-scroll-restore := Timer {
        interval: 0ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.content-active {
                return;
            }
            let bottom = root.response-bottom-y();
            let target = root.response-scroll-to-bottom-on-mount
                ? bottom
                : max(bottom, min(0px, root.response-scroll-y));
            root.set-response-viewport-y(target);
            root.response-scroll-to-bottom-on-mount = false;
            root.response-scroll-restoring = false;
        }
    }

    changed conversation => {
        if root.content-active {
            if !root.response-virtualized {
                root.set-response-viewport-y(root.response-bottom-y());
            }
        } else {
            root.response-scroll-to-bottom-on-mount = true;
        }
    }
    changed response-rows => {
        if root.response-virtualized && root.content-active {
            root.request-response-bottom();
        }
    }
    changed chat-sending => {
        if root.content-active {
            root.request-response-bottom();
        } else {
            root.response-scroll-to-bottom-on-mount = true;
        }
    }
    changed chat-status => {
        if root.content-active {
            root.request-response-bottom();
        } else {
            root.response-scroll-to-bottom-on-mount = true;
        }
    }

    review-elapsed-timer := Timer {
        interval: 1s;
        running: root.running;
        triggered => {
            root.elapsed-seconds += 1;
        }
    }

    chat-elapsed-timer := Timer {
        interval: 1s;
        running: root.chat-sending;
        triggered => {
            root.chat-elapsed-seconds += 1;
        }
    }

    composer := Rectangle {
        x: 0px;
        y: parent.height - root.composer-height;
        width: parent.width;
        height: root.composer-height;
        background: GitHubTheme.canvas-default;

        GitHubSegmentedControl {
            x: 16px;
            y: 10px;
            group-label: I18n.ai-review-composer-mode;
            GitHubSegmentedControlItem {
                label: I18n.ai-review-ask;
                selected: !root.review-again-mode;
                clicked => { root.review-again-mode = false; }
            }
            GitHubSegmentedControlDivider {}
            GitHubSegmentedControlItem {
                label: I18n.ai-review-review-again;
                selected: root.review-again-mode;
                clicked => { root.review-again-mode = true; }
            }
        }

        composer-box := Rectangle {
            x: 16px;
            y: 44px;
                width: root.response-message-width;
            height: 80px;
            border-radius: GitHubMetrics.radius-medium;
            border-width: GitHubMetrics.border-thin;
            border-color: ask-input.has-focus || review-input.has-focus
                ? GitHubTheme.focus-outline
                : GitHubTheme.border-default;
            background: GitHubTheme.control-input-bg;

            ask-input := TextInput {
                visible: !root.review-again-mode;
                x: 12px;
                y: 8px;
                width: parent.width - 52px;
                height: parent.height - 16px;
                text <=> root.message-input;
                enabled: !root.chat-sending && root.task-id != "";
                accessible-label: I18n.ai-review-ask-about-pr;
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                accepted => {
                    if root.message-input != "" && !root.chat-sending {
                        root.send-message(root.message-input);
                    }
                }
            }

            review-input := TextInput {
                visible: root.review-again-mode;
                x: 12px;
                y: 8px;
                width: parent.width - 52px;
                height: parent.height - 16px;
                text <=> root.extra-requirements;
                enabled: !root.running && root.task-id != "";
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                accepted => {
                    if !root.running && root.task-id != "" {
                        root.re-review(root.extra-requirements);
                    }
                }
            }

            if !root.review-again-mode && root.message-input == "" && !ask-input.has-focus: Text {
                x: 12px;
                y: 9px;
                width: parent.width - 60px;
                text: I18n.ai-review-ask-about-pr;
                font-size: 13px;
                color: GitHubTheme.fg-muted;
            }
            if root.review-again-mode && root.extra-requirements == "" && !review-input.has-focus: Text {
                x: 12px;
                y: 9px;
                width: parent.width - 60px;
                text: I18n.ai-review-add-instructions;
                font-size: 13px;
                color: GitHubTheme.fg-muted;
            }

            GitHubIconButton {
                x: parent.width - (root.composer-stopping ? 32px : 40px);
                y: parent.height - (root.composer-stopping ? 32px : 40px);
                control-size: root.composer-stopping
                    ? GitHubMetrics.control-xsmall-size
                    : GitHubMetrics.control-medium-size;
                visual-size: root.composer-stopping
                    ? GitHubMetrics.size-20
                    : GitHubMetrics.control-medium-size;
                icon: root.composer-stopping
                    ? @image-url("../../assets/icons/github-stop-square-fill-16.svg")
                    : (root.review-again-mode
                        ? @image-url("../../assets/icons/octicon-sync-16.svg")
                        : @image-url("../../assets/icons/octicon-arrow-up-16.svg"));
                tooltip-text: root.review-again-mode
                    ? (root.running ? I18n.pr-list-cancel-review : I18n.ai-review-review-again)
                    : (root.chat-sending ? I18n.common-cancel-response : I18n.common-send);
                primary: !root.composer-stopping;
                inverse: root.composer-stopping;
                circular: root.composer-stopping;
                loading: false;
                button-enabled: root.review-again-mode
                    ? root.task-id != ""
                    : (root.task-id != "" && (root.chat-sending || root.message-input != ""));
                clicked => {
                    if root.review-again-mode {
                        if root.running {
                            root.cancel(root.task-id);
                        } else {
                            root.re-review(root.extra-requirements);
                        }
                    } else {
                        if root.chat-sending {
                            root.cancel-message(root.task-id);
                        } else {
                            root.send-message(root.message-input);
                        }
                    }
                }
            }
        }
    }
}
