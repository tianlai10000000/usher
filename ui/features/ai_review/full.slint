import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubScrollView } from "../../components/github_scroll_view.slint";
import { GitHubIconButton } from "../../components/button/github_icon_button.slint";
import { GitHubCenteredLoadingState } from "../../components/github_spinner.slint";
import { GitHubAiReviewFindingRow } from "../../components/ai_review/github_ai_review_components.slint";
import { GitHubSegmentedControl, GitHubSegmentedControlDivider, GitHubSegmentedControlItem } from "../../components/github_segmented_control.slint";

export struct AiReviewTaskItem {
    id: string,
    project-key: string,
    pull-request-number: string,
    pull-request-title: string,
    rule-name: string,
    model-name: string,
    status: string,
    progress-percent: int,
    finding-count: int,
    error: string,
}

export struct AiReviewRuleChoice {
    id: string,
    name: string,
    selected: bool,
    inherited: bool,
}

export struct AiReviewFindingItem {
    severity: string,
    file: string,
    line: int,
    title: string,
    explanation: string,
    suggestion: string,
}

export struct AiReviewConversationItem {
    role: string,
    content: string,
}

// Route-independent review surface. The application mounts it only while the
// PR-side panel is open, so closing the panel destroys the visual tree and its
// projected finding/conversation rows.
export component GitHubAiReviewPanel inherits Rectangle {
    in property <string> task-id: "";
    in property <string> project-name: "";
    in property <string> pull-request-number: "";
    in property <string> pull-request-title: "";
    in property <string> rule-names: "";
    in property <string> model-name: "";
    in property <string> status: "queued";
    in property <int> progress-percent: 0;
    in property <string> summary: "";
    in property <string> error-text: "";
    in property <[AiReviewFindingItem]> findings: [];
    in property <[AiReviewConversationItem]> conversation: [];
    in-out property <string> message-input: "";
    in-out property <string> extra-requirements: "";
    in property <bool> chat-sending: false;
    callback close();
    callback cancel(string);
    callback re-review(string);
    callback send-message(string);
    callback select-finding(string, int);

    private property <bool> running: root.status == "queued" || root.status == "running";
    private property <bool> review-again-mode: false;
    private property <length> header-height: 64px;
    private property <length> composer-height: 136px;
    background: GitHubTheme.canvas-default;
    border-width: 0px;
    clip: true;

    header := Rectangle {
        z: 10;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.header-height;
        background: GitHubTheme.canvas-default;
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: GitHubTheme.border-default;
        }
        Image {
            x: 16px;
            y: 14px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
            colorize: GitHubTheme.fg-default;
        }
        Text {
            x: 42px;
            y: 7px;
            width: max(80px, parent.width - 146px);
            height: 24px;
            text: "AI code review";
            font-size: 14px;
            font-weight: 600;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
        Text {
            x: 42px;
            y: 31px;
            width: max(80px, parent.width - 146px);
            height: 20px;
            text: (root.rule-names == "" ? "No preset" : root.rule-names)
                + (root.model-name == "" ? "" : "  ·  " + root.model-name);
            font-size: 12px;
            color: GitHubTheme.fg-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        GitHubIconButton {
            x: parent.width - 82px;
            y: 16px;
            control-size: GitHubMetrics.size-32;
            icon: root.running
                ? @image-url("../../assets/icons/octicon-stop-16.svg")
                : @image-url("../../assets/icons/octicon-sync-16.svg");
            tooltip-text: root.running ? "Cancel review" : "Review current commit again";
            button-enabled: root.task-id != "";
            clicked => {
                if root.running {
                    root.cancel(root.task-id);
                } else {
                    root.re-review(root.extra-requirements);
                }
            }
        }
        GitHubIconButton {
            x: parent.width - 42px;
            y: 16px;
            control-size: GitHubMetrics.size-32;
            icon: @image-url("../../assets/icons/octicon-x-16.svg");
            tooltip-text: "Close AI review";
            clicked => { root.close(); }
        }
    }

    message-scroll := GitHubScrollView {
        x: 0px;
        y: root.header-height;
        width: parent.width;
        height: max(0px, parent.height - root.header-height - root.composer-height);
        background: GitHubTheme.canvas-default;
        VerticalLayout {
            width: message-scroll.visible_width;
            padding-top: 20px;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            if root.running: GitHubCenteredLoadingState {
                width: parent.width - 32px;
                height: 112px;
                label: root.status == "queued"
                    ? "AI review queued"
                    : "Reviewing current changes  " + root.progress-percent + "%";
            }

            if root.status == "failed" || root.status == "cancelled": Rectangle {
                width: parent.width - 32px;
                height: max(80px, error-message.preferred-height + 32px);
                border-radius: GitHubMetrics.radius-medium;
                border-width: GitHubMetrics.border-thin;
                border-color: root.status == "failed"
                    ? GitHubTheme.danger-emphasis
                    : GitHubTheme.border-default;
                background: GitHubTheme.canvas-subtle;
                error-message := Text {
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: self.preferred-height;
                    text: root.status == "cancelled" ? "Review cancelled." : root.error-text;
                    font-size: 13px;
                    color: GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
            }

            if root.status == "completed": VerticalLayout {
                width: parent.width - 32px;
                spacing: 12px;
                HorizontalLayout {
                    width: parent.width;
                    height: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: GitHubTheme.canvas-subtle;
                        Image {
                            x: 4px;
                            y: 4px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                            colorize: GitHubTheme.fg-default;
                        }
                    }
                    Text {
                        text: "Copilot review";
                        font-size: 13px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                }
                Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: root.findings.length == 0
                        ? "No actionable findings"
                        : "Review completed · " + root.findings.length + " finding"
                            + (root.findings.length == 1 ? "" : "s");
                    font-size: 14px;
                    font-weight: 600;
                    color: root.findings.length == 0
                        ? GitHubTheme.success-fg
                        : GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
                if root.summary != "": Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: root.summary;
                    font-size: 13px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
            }

            for finding[index] in root.findings: GitHubAiReviewFindingRow {
                width: parent.width - 32px;
                severity: finding.severity;
                file: finding.file;
                line: finding.line;
                title: finding.title;
                explanation: finding.explanation;
                suggestion: finding.suggestion;
                activated => { root.select-finding(finding.file, finding.line); }
            }

            if root.conversation.length > 0: Rectangle {
                width: parent.width - 32px;
                height: GitHubMetrics.border-thin;
                background: GitHubTheme.border-muted;
            }

            for message in root.conversation: VerticalLayout {
                width: parent.width - 32px;
                spacing: 8px;
                HorizontalLayout {
                    width: parent.width;
                    height: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: GitHubTheme.canvas-subtle;
                        if message.role == "user": Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Y";
                            font-size: 11px;
                            font-weight: 600;
                            color: GitHubTheme.fg-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if message.role != "user": Image {
                            x: 4px;
                            y: 4px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                            colorize: GitHubTheme.fg-default;
                        }
                    }
                    Text {
                        text: message.role == "user" ? "You" : "Copilot";
                        font-size: 13px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                }
                Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: message.content;
                    font-size: 13px;
                    color: GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
            }
        }
    }

    composer := Rectangle {
        x: 0px;
        y: parent.height - root.composer-height;
        width: parent.width;
        height: root.composer-height;
        background: GitHubTheme.canvas-default;

        GitHubSegmentedControl {
            x: 16px;
            y: 10px;
            group-label: "AI review composer mode";
            GitHubSegmentedControlItem {
                label: "Ask";
                selected: !root.review-again-mode;
                clicked => { root.review-again-mode = false; }
            }
            GitHubSegmentedControlDivider {}
            GitHubSegmentedControlItem {
                label: "Review again";
                selected: root.review-again-mode;
                clicked => { root.review-again-mode = true; }
            }
        }

        composer-box := Rectangle {
            x: 16px;
            y: 44px;
            width: parent.width - 32px;
            height: 80px;
            border-radius: GitHubMetrics.radius-medium;
            border-width: GitHubMetrics.border-thin;
            border-color: ask-input.has-focus || review-input.has-focus
                ? GitHubTheme.focus-outline
                : GitHubTheme.border-default;
            background: GitHubTheme.control-input-bg;

            ask-input := TextInput {
                visible: !root.review-again-mode;
                x: 12px;
                y: 8px;
                width: parent.width - 52px;
                height: parent.height - 16px;
                text <=> root.message-input;
                enabled: !root.chat-sending && root.status == "completed";
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                accepted => {
                    if root.message-input != "" && !root.chat-sending {
                        root.send-message(root.message-input);
                    }
                }
            }

            review-input := TextInput {
                visible: root.review-again-mode;
                x: 12px;
                y: 8px;
                width: parent.width - 52px;
                height: parent.height - 16px;
                text <=> root.extra-requirements;
                enabled: !root.running && root.task-id != "";
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: GitHubTheme.fg-default;
                accepted => {
                    if !root.running && root.task-id != "" {
                        root.re-review(root.extra-requirements);
                    }
                }
            }

            if !root.review-again-mode && root.message-input == "" && !ask-input.has-focus: Text {
                x: 12px;
                y: 9px;
                width: parent.width - 60px;
                text: "Ask about this review";
                font-size: 13px;
                color: GitHubTheme.fg-muted;
            }
            if root.review-again-mode && root.extra-requirements == "" && !review-input.has-focus: Text {
                x: 12px;
                y: 9px;
                width: parent.width - 60px;
                text: "Add review instructions";
                font-size: 13px;
                color: GitHubTheme.fg-muted;
            }

            GitHubIconButton {
                x: parent.width - 40px;
                y: parent.height - 40px;
                control-size: GitHubMetrics.size-32;
                icon: root.review-again-mode
                    ? @image-url("../../assets/icons/octicon-sync-16.svg")
                    : @image-url("../../assets/icons/octicon-arrow-up-16.svg");
                tooltip-text: root.review-again-mode
                    ? (root.running ? "Reviewing" : "Review again")
                    : (root.chat-sending ? "Sending" : "Send");
                primary: true;
                loading: root.review-again-mode ? root.running : root.chat-sending;
                button-enabled: root.review-again-mode
                    ? (!root.running && root.task-id != "")
                    : (root.status == "completed" && root.message-input != "");
                clicked => {
                    if root.review-again-mode {
                        root.re-review(root.extra-requirements);
                    } else {
                        root.send-message(root.message-input);
                    }
                }
            }
        }
    }
}
