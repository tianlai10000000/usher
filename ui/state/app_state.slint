import { Palette } from "std-widgets.slint";
import { I18n } from "@i18n";

export struct LanguageOption {
    id: string,
    label: string,
}

export global AppState {
    /**
     * properties
    */

    // theme
    in-out property <int> theme-mode: 0; // 0=light, 1=dark, 2=auto
    // effective-dark-mode is the actual dark mode state after resolving Auto
    // This is set by Rust code when theme-mode is 2 (Auto)
    in-out property <bool> effective-dark-mode: false;

    // Language preference is `auto` or a locale id from the generated
    // manifest. Keeping the model in shared state lets independently compiled
    // Settings pages consume the same registry without hard-coded branches.
    in property <LanguageOption> language-selection: {
        id: "auto",
        label: "",
    };
    in property <[LanguageOption]> language-options: [];
    // Forces every independently compiled UI root to retain the complete
    // generated I18n global, keeping Slint's process-global bundle indices
    // identical across component-factory boundaries.
    out property <string> i18n-catalog-sentinel: I18n.language-title;

    // auth
    in-out property <bool> is-logged-in: false;

    // user
    in-out property <string> username: "";
    in-out property <image> user-avatar;

    // app info
    in-out property <string> version: "";
    
    // network
    in-out property <bool> network-online: true;

    // auto-update
    in-out property <bool> auto-update: true; // default enabled
    in-out property <string> update-channel: "stable";
    
    // logging outputs and diagnostics
    in-out property <bool> application-console-logging: true;
    in-out property <bool> application-file-logging: false;
    in-out property <bool> tracing-logger-active: true; // default enabled
    in-out property <bool> terminal-verbose-logging: false;
    in-out property <bool> memory-diagnostics-logging: false;

    // UI click sound effects (system sound; currently breadcrumb Back only)
    in-out property <bool> ui-sound-effects: false;

    // Application-level artifact preview policy. 0=docked, 1=detached.
    in-out property <int> artifact-preview-presentation-mode: 0;
    in-out property <bool> artifact-preview-markdown-enabled: true;
    in-out property <bool> artifact-preview-image-enabled: true;
    in-out property <bool> artifact-preview-plain-text-enabled: true;

    // git platform tokens
    in-out property <string> git-github-token: "";
    in-out property <string> git-gitlab-token: "";
    in-out property <string> git-gitee-token: "";
    in-out property <string> git-gitee-enterprise-token: "";

    // Enterprise/self-hosted code-hosting API roots and identifiers.
    in-out property <string> git-github-api-base-url: "";
    in-out property <string> git-github-enterprise: "";
    in-out property <string> git-gitlab-api-base-url: "";
    in-out property <string> git-gitlab-enterprise: "";
    in-out property <string> git-gitee-api-base-url: "";
    in-out property <string> git-gitee-enterprise: "";

    // OpenAI-compatible AI Agent connection
    in-out property <string> ai-agent-base-url: "";
    in-out property <string> ai-agent-api-key: "";
    in-out property <string> ai-agent-model: "";
    // Persisted provider preset selection.
    in-out property <string> ai-agent-provider: "custom";

    /**
     * methods
    */

    // theme
    callback toggle-theme(mode: int);
    callback set-language(language: string);
    
    // auto-update
    callback toggle-auto-update(enabled: bool);
    callback set-update-channel(channel: string);
    
    // logging outputs and diagnostics
    callback toggle-application-console-logging(enabled: bool);
    callback toggle-application-file-logging(enabled: bool);
    callback toggle-tracing-logger-active(enabled: bool);
    callback toggle-terminal-verbose-logging(enabled: bool);
    callback toggle-memory-diagnostics-logging(enabled: bool);

    // UI click sound effects
    callback toggle-ui-sound-effects(enabled: bool);

    callback set-artifact-preview-presentation-mode(mode: int);
    callback set-artifact-preview-provider-enabled(provider-id: string, enabled: bool);

    // git token settings
    callback save-git-tokens(github-token: string, gitlab-token: string, gitee-token: string, gitee-enterprise-token: string);
    callback save-git-hosting-config(
        github-api-base-url: string,
        github-enterprise: string,
        gitlab-api-base-url: string,
        gitlab-enterprise: string,
        gitee-api-base-url: string,
        gitee-enterprise: string
    );

    // AI Agent settings and connection test
    callback save-ai-agent-settings(provider: string, base-url: string, api-key: string, model: string);
    callback test-ai-agent-connection(base-url: string, api-key: string, model: string);
    
    // Update Palette.color-scheme when theme-mode changes
    changed theme-mode => {
        if (root.theme-mode == 1) {
            Palette.color-scheme = ColorScheme.dark;
            root.effective-dark-mode = true;
        } else if (root.theme-mode == 0) {
            Palette.color-scheme = ColorScheme.light;
            root.effective-dark-mode = false;
        }
        // mode == 2 (auto): effective-dark-mode is set by Rust code
        // and we update Palette based on that
    }
    
    // When effective-dark-mode changes (set by Rust for Auto mode), update Palette
    changed effective-dark-mode => {
        if (root.theme-mode == 2) {
            // Only apply when in Auto mode
            if (root.effective-dark-mode) {
                Palette.color-scheme = ColorScheme.dark;
            } else {
                Palette.color-scheme = ColorScheme.light;
            }
        }
    }

    // auth
    callback login(username: string, password: string);
    callback logout();

    // user
    callback set-user-avatar(avatar: image);
    callback set-username(username: string);
}
