import { Palette } from "std-widgets.slint";
import { I18n } from "@i18n";

export struct LanguageOption {
    id: string,
    label: string,
}

export struct AiAgentListItem { id: string, name: string, model: string, provider: string, active: bool }
export struct AiAgentHeaderItem { enabled: bool, name: string, value: string }

export global AppState {
    in-out property <int> benchmark-preview-created-lines: -1;
    in-out property <float> benchmark-preview-offset: -1;
    in-out property <float> benchmark-preview-extent: 0;
    in-out property <bool> benchmark-preview-tail: false;
    // Disabled in production; cumulative mounts in the opt-in Job fixture.
    in-out property <int> benchmark-job-log-created-rows: -1;
    /**
     * properties
    */

    // theme
    in-out property <int> theme-mode: 0; // 0=light, 1=dark, 2=auto
    // effective-dark-mode is the actual dark mode state after resolving Auto
    // This is set by Rust code when theme-mode is 2 (Auto)
    in-out property <bool> effective-dark-mode: false;

    // Language preference is `auto` or a locale id from the generated
    // manifest. Keeping the model in shared state lets independently compiled
    // Settings pages consume the same registry without hard-coded branches.
    in property <LanguageOption> language-selection: {
        id: "auto",
        label: "",
    };
    // AI response language is persisted independently from the UI locale.
    // `auto` follows the active UI locale at request time.
    in-out property <LanguageOption> ai-agent-reply-language-selection: {
        id: "auto",
        label: "",
    };
    // Forces every independently compiled UI root to retain the complete
    // generated I18n global, keeping Slint's process-global bundle indices
    // identical across component-factory boundaries.
    out property <string> i18n-catalog-sentinel: I18n.language-title;

    // auth
    in-out property <bool> is-logged-in: false;

    // user
    in-out property <string> username: "";
    in-out property <image> user-avatar;

    // app info
    in-out property <string> version: "";
    
    // network
    in-out property <bool> network-online: true;
    // Committed request timeout in milliseconds; zero disables the default deadline.
    in-out property <string> http-request-timeout-ms: "30000";

    // auto-update
    in-out property <bool> auto-update: true; // default enabled
    in-out property <string> update-channel: "stable";
    
    // logging outputs and diagnostics
    in-out property <bool> application-console-logging: true;
    in-out property <bool> application-file-logging: false;
    in-out property <bool> tracing-logger-active: true; // default enabled
    in-out property <bool> terminal-verbose-logging: false;
    in-out property <bool> memory-diagnostics-logging: false;

    // UI click sound effects (system sound; currently breadcrumb Back only)
    in-out property <bool> ui-sound-effects: false;

    // Application-level preview policy. 0=split, 1=detached, 2=floating.
    in-out property <int> artifact-preview-presentation-mode: 0;
    in-out property <bool> artifact-preview-markdown-enabled: true;
    in-out property <bool> artifact-preview-image-enabled: true;
    in-out property <bool> artifact-preview-plain-text-enabled: true;

    // git platform tokens
    in-out property <string> git-github-token: "";
    in-out property <string> git-gitlab-token: "";
    in-out property <string> git-gitee-token: "";
    in-out property <string> git-gitee-enterprise-token: "";

    // Enterprise/self-hosted code-hosting API roots and identifiers.
    in-out property <string> git-github-api-base-url: "";
    in-out property <string> git-github-enterprise: "";
    in-out property <string> git-gitlab-api-base-url: "";
    in-out property <string> git-gitlab-enterprise: "";
    in-out property <string> git-gitee-api-base-url: "";
    in-out property <string> git-gitee-enterprise: "";
    in-out property <string> default-pr-merge-method: "merge";

    // OpenAI-compatible AI Agent connection
    in-out property <string> ai-agent-base-url: "";
    in-out property <string> ai-agent-api-key: "";
    in-out property <string> ai-agent-model: "";
    in-out property <string> ai-agent-name: "";
    // Editing selection and committed active profile are independent.
    in-out property <string> ai-agent-provider: "custom";
    in-out property <string> ai-agent-active-provider: "custom";
    in-out property <string> ai-agent-custom-name: "";
    in-out property <string> ai-agent-deepseek-name: "";
    in-out property <string> ai-agent-openai-name: "";
    in-out property <string> ai-agent-custom-model: "";
    in-out property <string> ai-agent-deepseek-model: "";
    in-out property <string> ai-agent-openai-model: "";
    // Settings list and one dialog-local editor; committed active identity is
    // projected separately and never inferred from the row being edited.
    in-out property <[AiAgentListItem]> ai-agent-list: [];
    in-out property <string> ai-agent-list-testing-id: "";
    in-out property <string> ai-agent-list-feedback-key: "";
    in-out property <string> ai-agent-list-feedback: "";
    in-out property <bool> ai-agent-list-feedback-success: true;
    in-out property <bool> ai-agent-list-feedback-open: false;
    in-out property <string> ai-agent-query: "";
    in-out property <int> ai-agent-page: 1;
    in-out property <int> ai-agent-total-pages: 1;
    in-out property <int> ai-agent-total-count: 0;
    in-out property <[int]> ai-agent-pages: [];
    in-out property <bool> ai-agent-editor-open: false;
    in-out property <bool> ai-agent-editor-new: true;
    in-out property <int> ai-agent-editor-revision: 0;
    in-out property <string> ai-agent-editor-id: "";
    in-out property <string> ai-agent-editor-name: "";
    in-out property <string> ai-agent-editor-provider: "custom";
    in-out property <string> ai-agent-editor-base-url: "";
    in-out property <string> ai-agent-editor-api-key: "";
    in-out property <string> ai-agent-editor-model: "";
    in-out property <string> ai-agent-editor-reply-language: "auto";
    in-out property <[AiAgentHeaderItem]> ai-agent-editor-headers: [];
    in-out property <bool> ai-agent-editor-headers-object-mode: false;
    in-out property <string> ai-agent-editor-headers-object-text: "";
    in-out property <int> ai-agent-editor-headers-input-revision: 0;
    in-out property <bool> ai-agent-editor-feedback-open: false;
    in-out property <bool> ai-agent-editor-busy: false;
    in-out property <bool> ai-agent-editor-testing: false;
    in-out property <string> ai-agent-editor-error: "";
    in-out property <string> ai-agent-editor-error-key: "";
    in-out property <string> ai-agent-editor-test-result: "";
    in-out property <string> ai-agent-editor-test-result-key: "";
    in-out property <bool> ai-agent-editor-test-success: true;
    in-out property <string> ai-agent-delete-id: "";
    in-out property <string> ai-agent-delete-name: "";
    in-out property <string> ai-agent-delete-message: "";
    in-out property <bool> ai-agent-delete-confirm-open: false;

    /**
     * methods
    */

    // theme
    callback toggle-theme(mode: int);
    callback set-language(language: string);
    callback select-ai-agent-provider(provider: string);
    callback activate-ai-agent(provider: string);
    callback open-new-ai-agent();
    callback edit-ai-agent(id: string);
    callback delete-ai-agent(id: string);
    callback confirm-delete-ai-agent();
    callback cancel-delete-ai-agent();
    callback query-ai-agents(query: string);
    callback select-ai-agents-page(page: int);
    callback save-ai-agent-editor();
    callback test-ai-agent-editor();
    callback test-ai-agent(id: string);
    callback cancel-ai-agent-list-test();
    callback cancel-ai-agent-test();
    callback cancel-ai-agent-editor();
    callback select-ai-agent-header-mode(object-mode: bool);
    callback edit-ai-agent-header-object(source: string);
    callback add-ai-agent-header();
    callback remove-ai-agent-header(index: int);
    callback set-ai-agent-header-enabled(index: int, enabled: bool);
    callback set-ai-agent-header-name(index: int, name: string);
    callback set-ai-agent-header-value(index: int, value: string);
    callback set-ai-agent-base-url(base-url: string);
    callback set-ai-agent-api-key(api-key: string);
    callback set-ai-agent-model(model: string);
    callback select-ai-agent-reply-language(language: string);
    
    // auto-update
    callback toggle-auto-update(enabled: bool);
    callback set-update-channel(channel: string);
    
    // logging outputs and diagnostics
    callback toggle-application-console-logging(enabled: bool);
    callback toggle-application-file-logging(enabled: bool);
    callback toggle-tracing-logger-active(enabled: bool);
    callback toggle-terminal-verbose-logging(enabled: bool);
    callback toggle-memory-diagnostics-logging(enabled: bool);

    // UI click sound effects
    callback toggle-ui-sound-effects(enabled: bool);

    callback set-artifact-preview-presentation-mode(mode: int);
    callback set-artifact-preview-provider-enabled(provider-id: string, enabled: bool);

    callback validate-http-request-timeout(milliseconds: string) -> bool;
    callback save-http-request-timeout(milliseconds: string) -> bool;
    callback save-default-pr-merge-method(method: string);

    // git token settings
    callback save-git-tokens(github-token: string, gitlab-token: string, gitee-token: string, gitee-enterprise-token: string);
    callback save-git-hosting-config(
        github-api-base-url: string,
        github-enterprise: string,
        gitlab-api-base-url: string,
        gitlab-enterprise: string,
        gitee-api-base-url: string,
        gitee-enterprise: string
    );

    // AI Agent settings and connection test
    callback save-ai-agent-settings(
        provider: string,
        base-url: string,
        api-key: string,
        model: string,
        reply-language: string,
        name: string
    );
    callback test-ai-agent-connection(base-url: string, api-key: string, model: string);
    
    // Update Palette.color-scheme when theme-mode changes
    changed theme-mode => {
        if (root.theme-mode == 1) {
            Palette.color-scheme = ColorScheme.dark;
            root.effective-dark-mode = true;
        } else if (root.theme-mode == 0) {
            Palette.color-scheme = ColorScheme.light;
            root.effective-dark-mode = false;
        }
        // mode == 2 (auto): effective-dark-mode is set by Rust code
        // and we update Palette based on that
    }
    
    // When effective-dark-mode changes (set by Rust for Auto mode), update Palette
    changed effective-dark-mode => {
        if (root.theme-mode == 2) {
            // Only apply when in Auto mode
            if (root.effective-dark-mode) {
                Palette.color-scheme = ColorScheme.dark;
            } else {
                Palette.color-scheme = ColorScheme.light;
            }
        }
    }

    // auth
    callback login(username: string, password: string);
    callback logout();

    // user
    callback set-user-avatar(avatar: image);
    callback set-username(username: string);
}
