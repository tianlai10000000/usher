// Shared dismissal bridge for transient UI surfaces.
//
// Two channels stay separate on purpose:
// 1. dismiss-all / dismiss-revision — native title-bar, docked-shell, and host
//    blank-area clicks. Dialog/Toast/ActionMenu/Diff-settings all listen.
// 2. claim-exclusive / exclusive-generation — peer popover mutual exclusivity.
//    Only ActionMenu and Diff-settings claim/listen, so opening one closes the
//    others on the same click without each page wiring dismiss-all, and without
//    tearing down Dialogs or Toasts.
//
// closed-open-menu latches when dismiss-revision actually closes an open
// ActionMenu/Diff-settings surface so a same-gesture trigger click cannot
// toggle it back open (native title-bar dismiss + trigger race).
export global TransientOverlayState {
    out property <int> dismiss-revision: 0;
    out property <int> exclusive-generation: 0;
    out property <bool> closed-open-menu: false;
    callback dismiss-all();
    callback claim-exclusive();
    callback note-closed-open-menu();
    callback consume-closed-open-menu();

    dismiss-all => {
        root.dismiss-revision += 1;
    }

    claim-exclusive => {
        root.exclusive-generation += 1;
    }

    note-closed-open-menu => {
        root.closed-open-menu = true;
    }

    consume-closed-open-menu => {
        root.closed-open-menu = false;
    }
}
