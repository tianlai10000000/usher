// Logical placement requested by a tooltip anchor. The root host may flip to a
// better side when the preferred side would overflow the visible viewport.
export enum GitHubTooltipPlacement {
    Top,
    Bottom,
    Left,
    Right,
}

export enum GitHubTooltipAlignment {
    Start,
    Center,
    End,
}

// Window-root bridge for GitHubTooltip. Locators publish reference geometry;
// the root host owns every floating-surface positioning decision.
export global TooltipOverlayState {
    in-out property <bool> open: false;
    in-out property <string> text: "";
    in-out property <length> anchor-x: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <length> anchor-width: 0px;
    in-out property <length> anchor-height: 0px;
    in-out property <GitHubTooltipPlacement> preferred-placement:
        GitHubTooltipPlacement.Top;
    in-out property <GitHubTooltipAlignment> alignment:
        GitHubTooltipAlignment.Center;
    // Monotonic claim id so a stale hide/renew cannot clear a newer tip.
    in-out property <int> token: 0;
    // Heartbeat from the active locator. This is a lifecycle fallback for a
    // reference destroyed by a list/model update before it can publish hide.
    in-out property <int> lease: 0;

    callback show(
        string,
        string,
        length,
        length,
        length,
        length,
        GitHubTooltipPlacement,
        GitHubTooltipAlignment,
    );
    callback renew(
        int,
        string,
        length,
        length,
        length,
        length,
        GitHubTooltipPlacement,
        GitHubTooltipAlignment,
    );
    callback hide(int);
    callback dismiss-all();

    show(node, text, anchor-x, anchor-y, anchor-width, anchor-height, placement, alignment) => {
        root.token += 1;
        root.text = text;
        root.anchor-x = anchor-x;
        root.anchor-y = anchor-y;
        root.anchor-width = anchor-width;
        root.anchor-height = anchor-height;
        root.preferred-placement = placement;
        root.alignment = alignment;
        root.open = true;
        root.lease += 1;
    }

    renew(token, text, anchor-x, anchor-y, anchor-width, anchor-height, placement, alignment) => {
        if token == root.token {
            root.text = text;
            root.anchor-x = anchor-x;
            root.anchor-y = anchor-y;
            root.anchor-width = anchor-width;
            root.anchor-height = anchor-height;
            root.preferred-placement = placement;
            root.alignment = alignment;
            root.open = true;
            root.lease += 1;
        }
    }

    hide(token) => {
        if token == root.token {
            root.open = false;
        }
    }

    dismiss-all() => {
        root.token += 1;
        root.open = false;
        root.text = "";
    }
}
