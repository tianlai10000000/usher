// Global layout constants, for reuse throughout the application
export global LayoutConstants {
    // Status bar height
    in-out property <length> status-bar-height: 32px;

    // Default Page viewport height
    in-out property <length> default-page-viewport-height: 600px;

    // Floating action buttons
    in-out property <length> page-fab-right-offset: 12px;
    in-out property <length> page-fab-bottom-offset: 16px;
    in-out property <length> page-fab-stack-spacing: 60px;
    in-out property <length> to-top-show-threshold: 220px;
}
