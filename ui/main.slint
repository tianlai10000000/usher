    init => {
        // TODO: delete
        // update-dialog.show();
    }

    page-memory-diag-timer := Timer {
        interval: 120ms;
        running: root.page-memory-diag-pending;
        triggered => {
            root.page-memory-diag-pending = false;
            root.page-memory-diag(root.current-route, root.width / 1px, root.height / 1px, root.shell-drawer-visible);
        }
    }

    page-scroll-reset-timer := Timer {
        interval: 24ms;
        running: root.page-scroll-reset-pending;
        triggered => {
            if root.current-route == Route.Settings {
                page-scroll-view.viewport_x = 0px;
            }
            page-scroll-view.viewport_y = 0px;
            root.page-scroll-reset-pending = false;
        }
    }

    sidebar-preview-dismiss-timer := Timer {
        interval: 180ms;
        running: root.sidebar-preview-dismiss-pending;
        triggered => {
            root.sidebar-preview-dismiss-pending = false;
            root.sidebar-preview-visible = false;
        }
    }

    sidebar-motion-timer := Timer {
        // Drive one layout update per display frame. An 8 ms timer can queue a
        // second full-tree layout before FemtoVG presents the first frame.
        interval: 16ms;
        running: root.sidebar-motion-running;
        triggered => {
            let target = root.show-navigation-drawer && root.navigation-drawer-expanded ? 1.0 : 0.0;
            let displacement = target - root.sidebar-motion-progress;
            let acceleration = displacement * 300.0 - root.sidebar-motion-velocity * 31.0;
            root.sidebar-motion-velocity = root.sidebar-motion-velocity + acceleration * 0.016;
            root.sidebar-motion-progress = root.sidebar-motion-progress + root.sidebar-motion-velocity * 0.016;

            if Math.abs(target - root.sidebar-motion-progress) < 0.0005
                    && Math.abs(root.sidebar-motion-velocity) < 0.001 {
                root.sidebar-motion-progress = target;
                root.sidebar-motion-velocity = 0.0;
                root.sidebar-motion-running = false;
                root.sidebar-content-wide = target < 0.5;
                root.navigation-drawer-motion-settled(target >= 0.5);
            }
        }
    }

    changed width => {
        root.page-memory-diag-pending = true;
    }

    changed height => {
        root.page-memory-diag-pending = true;
    }

    changed window-live-resizing => {
        if root.window-live-resizing {
            let target = root.show-navigation-drawer && root.navigation-drawer-expanded ? 1.0 : 0.0;
            root.sidebar-motion-progress = target;
            root.sidebar-motion-velocity = 0.0;
            root.sidebar-motion-running = false;
            root.sidebar-content-wide = target < 0.5;
        }
    }

    changed current-route => {
        root.page-memory-diag-pending = true;
        root.sidebar-preview-visible = false;
        root.sidebar-preview-dismiss-pending = false;
        root.workflow-pr-readiness-popup-open = false;
        if root.current-route == Route.Settings {
            page-scroll-view.viewport_x = 0px;
        }
        if root.current-route == Route.Messages {
            root.messages-page-ever-opened = true;
        }
        page-scroll-view.viewport_y = 0px;
        root.page-scroll-reset-pending = true;
    }

    changed workflow-pr-review-number => {
        root.workflow-pr-readiness-popup-open = false;
    }

    changed navigation-drawer-expanded => {
        root.sidebar-preview-visible = false;
        root.sidebar-preview-dismiss-pending = false;
        if !root.navigation-drawer-expanded {
            root.sidebar-content-wide = true;
        }
        root.sidebar-motion-running = true;
    }

    changed show-navigation-drawer => {
        root.sidebar-motion-running = true;
    }

    changed workflow-selected-flow => {
        if root.current-route == Route.Workflow {
            page-scroll-view.viewport_y = 0px;
            root.page-scroll-reset-pending = true;
        }
    }

    changed shell-drawer-visible => {
        root.page-memory-diag-pending = true;
    }

    changed modal-overlay-visible => {
        root.modal-overlay-visibility-changed(root.modal-overlay-visible);
    }

    dismiss-transient-overlays => {
        TransientOverlayState.dismiss-all();
    }

    restore-navigation-drawer-state(expanded) => {
        root.navigation-drawer-expanded = expanded;
        root.sidebar-motion-progress = expanded ? 1.0 : 0.0;
        root.sidebar-motion-velocity = 0.0;
        root.sidebar-motion-running = false;
        root.sidebar-content-wide = !expanded;
    }
    
    show-update-dialog(latest-version, current-version) => {
        debug("MainWindow: show-update-dialog 回调被调用, latest-version={}, current-version={}", latest-version, current-version);

        DialogManager.show({
            id: "update-dialog",
            title: "Update Available",
            content: "A new version (" + latest-version + ") is available. Current version: " + current-version + ". Please update to the latest version.",
            actions: ["Cancel"],
            default-action: "Update",
            overlay: true,
            modal: true,
            width: "480px",
            height: "296px",
        });

    }

    // Every interactive route and overlay lives under this one FocusScope so
    // application shortcuts are captured before the currently focused child.
    app-shortcut-scope := FocusScope {
        width: root.width;
        height: root.height;

        capture-key-pressed(event) => {
            if root.app-shortcut-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                return accept;
            }
            return reject;
        }

        // Page content participates in the sidebar's live layout geometry. The
        // sidebar itself is mounted later at the window root so it always paints
        // above route content during resize and spring transitions.
        Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        // Keep the main canvas painted through the whole transition. Slint can
        // commit the translated x before a dependent width binding, so a
        // full-width underlay prevents the native window material from flashing
        // at the trailing edge while the content pane is being re-laid out.
        main-surface-underlay := Rectangle {
            x: GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
            y: 0px;
            width: root.width;
            height: root.height;
            background: root.window-surface-color;
            z: 0;
        }

        main-content-host := Rectangle  {
            x: GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
            y: 0px;
            width: root.sidebar-content-width;
            height: parent.height - LayoutConstants.status-bar-height;
            background: root.window-surface-color;
            z: 1;

            // macOS hosts these actions in the native title bar. Other desktop
            // platforms keep an equivalent compact control strip in content.
            if !root.platform-is-macos && root.show-navigation-drawer
                    && !root.navigation-drawer-expanded: Rectangle {
                x: GitHubMetrics.size-8;
                y: GitHubMetrics.size-8;
                width: 112px;
                height: GitHubMetrics.size-40;
                border-radius: GitHubMetrics.radius-large;
                background: GitHubTheme.canvas-overlay;
                drop-shadow-blur: GitHubMetrics.size-12;
                drop-shadow-color: GitHubTheme.shadow-floating-small;
                z: 30;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: GitHubMetrics.size-4;
                    padding-right: GitHubMetrics.size-4;
                    spacing: GitHubMetrics.size-4;
                    alignment: center;

                    GitHubIconButton {
                        icon: @image-url("./assets/icons/octicon-sidebar-expand-16.svg");
                        tooltip-text: "Show sidebar (" + root.shortcut-toggle-sidebar-label + ")";
                        tooltip-above: false;
                        clicked => { root.toggle-navigation-drawer(); }
                    }
                    GitHubIconButton {
                        icon: @image-url("./assets/icons/octicon-arrow-left-16.svg");
                        tooltip-text: "Back (" + root.shortcut-navigate-back-label + ")";
                        tooltip-above: false;
                        button-enabled: root.navigation-can-go-back;
                        clicked => { root.navigate-back(); }
                    }
                    GitHubIconButton {
                        icon: @image-url("./assets/icons/octicon-chevron-right-16.svg");
                        tooltip-text: "Forward (" + root.shortcut-navigate-forward-label + ")";
                        tooltip-above: false;
                        button-enabled: root.navigation-can-go-forward;
                        clicked => { root.navigate-forward(); }
                    }
                }
            }

            // On macOS the breadcrumb occupies the title-bar inset instead of
            // consuming a second row above the page, matching the Codex shell.
            // When the sidebar is hidden, leave room for traffic lights and the
            // native sidebar/history accessory before starting the breadcrumb.
            if root.platform-is-macos
                    && (root.show-breadcrumb || root.current-route == Route.PrReview): Rectangle {
                x: max(0px, 184px - main-content-host.x);
                y: 0px;
                width: max(0px, parent.width - self.x);
                height: root.native-titlebar-inset;
                background: transparent;
                clip: false;
                z: 30;

                if root.show-breadcrumb: GitHubBreadcrumb {
                    width: parent.width;
                    height: parent.height;
                    titlebar-mode: true;
                    trailing-reserved-width: root.current-route == Route.PrReview
                        ? 520px
                        : GitHubMetrics.size-48;
                    show-bottom-divider: false;
                    current-route: root.current-route;
                    previous-route: root.previous-route;
                    navigation-can-go-back: root.navigation-can-go-back;
                    show-back-button: false;
                    navigate(route) => { root.navigate(route); }
                    back => { root.navigate-back(); }
                }

            }

            content := VerticalLayout {
                y: root.native-titlebar-inset;
                width: parent.width;
                height: parent.height - root.native-titlebar-inset;
                padding: 0px;
                
                // Page region: scroll fills the stack; breadcrumb overlays so a
                // translucent bar can reveal scrolled content underneath.
                page-stack := Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height - terminal-dock-host.height - 4px;
                    background: transparent;
                    clip: false;

                    // Page Views
                    page-scroll-view := GitHubScrollView {
                        visible: root.show-page-scroll-view
                            && root.current-route != Route.Settings
                            && root.current-route != Route.Messages
                            && !(root.shell-drawer-docked-route
                                && root.shell-drawer-visible
                                && root.shell-drawer-fullscreen);
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        VerticalLayout {
                            width: page-scroll-view.visible_width;
                            spacing: 0px;
                            alignment: start;
                            padding-left: GitHubMetrics.size-4;
                            padding-right: GitHubMetrics.size-4;
                            // Non-macOS keeps the 40px overlay plus a 16px gap.
                            // macOS only needs the gap because the breadcrumb is
                            // mounted in the native title-bar inset above.
                            padding-top: root.page-content-top-padding;
                            padding-bottom: 1px;

                        if root.current-route == Route.Home: HomePage {
                            viewport-height: page-scroll-view.visible-height
                                - root.page-content-height-offset;
                            navigate(route) => { root.navigate(route); }
                        }
                        if root.current-route == Route.Search: SearchPage {
                            viewport-height: page-scroll-view.visible-height
                                - root.page-content-height-offset;
                            navigate(route) => { root.navigate(route); }
                        }
                        if root.current-route == Route.UiComponents: UiComponentsPage {
                            viewport-height: page-scroll-view.visible-height
                                - root.page-content-height-offset;
                            navigate(route) => { root.navigate(route); }
                        }
                        if root.current-route == Route.About: AboutPage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                            navigate(route) => {
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.JobRun: JobRunPage {
                            viewport-height: page-scroll-view.visible-height
                                - root.page-content-height-offset;
                            run-title: root.job-run-title;
                            workflow-name: root.job-run-workflow-name;
                            context-name: root.job-run-context-name;
                            job-name: root.job-run-job-name;
                            trigger-detail: root.job-run-trigger-detail;
                            summary: root.job-run-summary;
                            execution-status: root.job-run-status;
                            conclusion: root.job-run-conclusion;
                            total-duration: root.job-run-total-duration;
                            steps: root.job-run-steps;
                            running: root.job-run-running;
                            animations-enabled: root.job-run-animations-enabled;
                            stop => { root.job-run-stop(); }
                            load-step-log(index) => {
                                root.job-run-load-step-log(index);
                            }
                        }
                        // The review workspace owns the whole window. Keep workflow
                        // state on MainWindow, but destroy its component tree while
                        // the opaque review surface is mounted so hidden delegates do
                        // not participate in live-resize layout and rendering.
                        if root.current-route == Route.Workflow && !root.workflow-pr-review-visible: WorkflowPage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                            selected-flow <=> root.workflow-selected-flow;
                            navigate(route) => {
                                root.navigate(route);
                            }
                            branch-result: root.workflow-branch-result;
                            tag-result: root.workflow-tag-result;
                            tag-selected-tab <=> root.workflow-tag-selected-tab;
                            tag-mode <=> root.workflow-tag-mode;
                            tag-version-mode <=> root.workflow-tag-version-mode;
                            tag-current-version: root.workflow-tag-current-version;
                            tag-next-version <=> root.workflow-tag-next-version;
                            tag-remove-target <=> root.workflow-tag-remove-target;
                            tag-add-initializing: root.workflow-tag-add-initializing;
                            tag-remove-initializing: root.workflow-tag-remove-initializing;
                            tag-running: root.workflow-tag-running;
                            tag-has-run: root.job-run-active
                                && root.job-run-source == "tag";
                            project-id: root.workflow-project-id;
                            project-name: root.workflow-project-name;
                            project-alias: root.workflow-project-alias;
                            project-local-repo: root.workflow-project-local-repo;
                            project-remote-repo: root.workflow-project-remote-repo;
                            open-local-folder-tooltip: root.workflow-open-local-folder-tooltip;
                            project-logo: root.workflow-project-logo;
                            project-logo-image: root.workflow-project-logo-image;
                            pr-repo-project-id: root.workflow-pr-repo-project-id;
                            pr-repo-type: root.workflow-pr-repo-type;
                            pr-list-items: root.workflow-pr-list-items;
                            pr-list-total: root.workflow-pr-list-total;
                            pr-list-total-exact: root.workflow-pr-list-total-exact;
                            pr-list-open-total: root.workflow-pr-list-open-total;
                            pr-list-closed-total: root.workflow-pr-list-closed-total;
                            pr-list-page: root.workflow-pr-list-page;
                            pr-list-page-count: root.workflow-pr-list-page-count;
                            pr-list-state: root.workflow-pr-list-state;
                            pr-list-review-filter: root.workflow-pr-list-review-filter;
                            pr-list-assignee-filter: root.workflow-pr-list-assignee-filter;
                            pr-list-sort-filter: root.workflow-pr-list-sort-filter;
                            pr-list-loading: root.workflow-pr-list-loading;
                            pr-list-error: root.workflow-pr-list-error;
                            pr-count-auto-update: root.workflow-pr-count-auto-update;
                            pr-count-loading: root.workflow-pr-count-loading;
                            pr-count-failed: root.workflow-pr-count-failed;
                            pr-fat-count: root.workflow-pr-fat-count;
                            pr-uat-count: root.workflow-pr-uat-count;
                            pr-prod-count: root.workflow-pr-prod-count;
                            cd-running: root.workflow-cd-running;
                            cd-summary: root.workflow-cd-summary;
                            cd-build-status: root.workflow-cd-build-status;
                            cd-build-detail: root.workflow-cd-build-detail;
                            cd-test-status: root.workflow-cd-test-status;
                            cd-test-detail: root.workflow-cd-test-detail;
                            cd-deploy-status: root.workflow-cd-deploy-status;
                            cd-deploy-detail: root.workflow-cd-deploy-detail;
                            cd-verify-status: root.workflow-cd-verify-status;
                            cd-verify-detail: root.workflow-cd-verify-detail;
                            branch-submit(source, target, recreate-remote) => {
                                root.workflow-branch-submit(source, target, recreate-remote);
                            }
                            tag-change-mode(mode) => {
                                root.workflow-tag-change-mode(mode);
                            }
                            tag-select-version-mode(mode) => {
                                root.workflow-tag-select-version-mode(mode);
                            }
                            tag-run(version, description) => {
                                root.workflow-tag-run(version, description);
                            }
                            tag-remove(tag) => {
                                root.workflow-tag-remove(tag);
                            }
                            tag-open-add => {
                                root.workflow-tag-open-add();
                            }
                            tag-open-remove => {
                                root.workflow-tag-open-remove();
                            }
                            pr-list-state-change(state) => {
                                root.workflow-pr-list-state-change(state);
                            }
                            pr-list-page-change(page) => {
                                root.workflow-pr-list-page-change(page);
                            }
                            pr-list-review-filter-change(value) => {
                                root.workflow-pr-list-review-filter-change(value);
                            }
                            pr-list-assignee-filter-change(value) => {
                                root.workflow-pr-list-assignee-filter-change(value);
                            }
                            pr-list-sort-filter-change(value) => {
                                root.workflow-pr-list-sort-filter-change(value);
                            }
                            copy-remote-repo(url) => {
                                root.workflow-copy-remote-repo(url)
                            }
                            open-local-repo(path) => {
                                root.workflow-open-local-repo(path);
                            }
                            pr-open-detail(number, title, author, source-branch, target-branch, updated-at) => {
                                root.workflow-pr-review-open(number, title, author, source-branch, target-branch, updated-at);
                            }
                            cd-start(environment-name, release-name, commit-hash) => {
                                root.workflow-cd-start(environment-name, release-name, commit-hash);
                            }
                            cd-rollback(commit-hash) => {
                                root.workflow-cd-rollback(commit-hash);
                            }
                        }
                        if root.current-route == Route.Project: ProjectPage {
                            viewport-height: page-scroll-view.visible-height;
                            viewport-width: page-scroll-view.visible-width;
                            navigate(route) => {
                                root.navigate(route);
                            }
                            projects: root.project-items;
                            search-query <=> root.project-search-query;
                            view-mode <=> root.project-view-mode;
                            loading: root.project-list-loading;
                            load-error: root.project-list-error;
                            show-add-modal <=> root.project-show-add-modal;
                            new-project-name <=> root.project-new-name;
                            new-project-alias <=> root.project-new-alias;
                            new-project-local-repo <=> root.project-new-local-repo;
                            new-project-remote-repo <=> root.project-new-remote-repo;
                            new-project-logo <=> root.project-new-logo;
                            new-project-tags <=> root.project-new-tags;
                            logo-preview-image: root.project-logo-preview-image;
                            logo-preview-status: root.project-logo-preview-status;
                            add-error <=> root.project-add-error;
                            modal-mode <=> root.project-modal-mode;
                            modal-original-alias <=> root.project-modal-original-alias;
                            open-project(project-name, project-alias, local-repo, remote-repo, logo, logo-image, is-pr-auto-update) => {
                                root.workflow-open-project(project-name, project-alias, local-repo, remote-repo, logo, logo-image, is-pr-auto-update);
                            }
                            add-project(project-name, project-alias, local-repo, remote-repo, logo, project-tags, is-pr-auto-update) => {
                                root.project-add-project(project-name, project-alias, local-repo, remote-repo, logo, project-tags, is-pr-auto-update);
                            }
                            preview-logo(logo) => {
                                root.project-preview-logo(logo);
                            }
                            search-projects(query) => {
                                root.project-search-projects(query);
                            }
                            reload-projects() => {
                                root.project-reload-projects();
                            }
                            open-terminal(project-name, project-alias, local-repo) => {
                                root.project-open-terminal(project-name, project-alias, local-repo);
                            }
                        }
                    }
                    }

                    // Settings owns its own scroll viewport in an independently
                    // generated crate. Mount it beside (not inside) the shell
                    // Flickable so wheel events cannot bubble into a nested
                    // outer scroller and move the whole page container.
                    if root.current-route == Route.Settings && root.show-page-scroll-view: ComponentContainer {
                        x: 0px;
                        y: 0px;
                        width: root.settings-page-viewport-width;
                        height: root.settings-page-viewport-height;
                        component-factory: root.settings-page-factory;
                    }

                    // Lazily create one stable cross-crate factory shell. The
                    // page releases its message model while hidden, so only
                    // the small static page/factory shell survives;
                    // reopening rehydrates it from the current Rust snapshot.
                    if root.messages-page-ever-opened: messages-page-host := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: root.messages-page-viewport-width;
                        height: root.messages-page-viewport-height;
                        visible: root.messages-page-active;
                        background: transparent;
                        clip: true;

                        ComponentContainer {
                            width: parent.width;
                            height: parent.height;
                            component-factory: root.messages-page-factory;
                        }
                    }

                    breadcrumb-host := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: root.page-breadcrumb-height;
                        background: transparent;
                        clip: false;
                        z: 10;

                        if root.show-breadcrumb && !root.platform-is-macos: GitHubBreadcrumb {
                            width: parent.width;
                            height: parent.height;
                            current-route: root.current-route;
                            previous-route: root.previous-route;
                            navigation-can-go-back: root.navigation-can-go-back;
                            show-back-button: !root.platform-is-macos;
                            navigate(route) => {
                                root.navigate(route);
                            }
                            back => { root.navigate-back(); }
                        }
                    }
                }

                terminal-dock-host := Rectangle {
                    horizontal-stretch: 1;
                    height: root.workflow-terminal-docked-height;
                    background: transparent;

                    if root.shell-drawer-docked-route && root.shell-drawer-visible: GitHubTerminalDrawer {
                        x: GitHubMetrics.size-4;
                        width: max(320px, parent.width - GitHubMetrics.size-4 * 2);
                        height: parent.height;
                        docked: true;
                        drawer-open: true;
                        input-text <=> root.shell-drawer-input-text;
                        title: root.shell-drawer-title;
                        cwd: root.shell-drawer-cwd;
                        output: root.shell-drawer-output;
                        output-line-count: root.shell-drawer-output-line-count;
                        lines: root.shell-drawer-lines;
                        scrollback-offset: root.shell-drawer-scrollback-offset;
                        max-scrollback: root.shell-drawer-max-scrollback;
                        cursor-row: root.shell-drawer-cursor-row;
                        cursor-col: root.shell-drawer-cursor-col;
                        cursor-visible: root.shell-drawer-cursor-visible;
                        running: root.shell-drawer-running;
                        connected: root.shell-drawer-connected;
                        initial-height: 280px;
                        available-height: root.shell-drawer-fullscreen
                            ? root.workflow-terminal-fullscreen-height
                            : root.workflow-terminal-max-height;
                        drawer-height <=> root.shell-drawer-height;
                        fullscreen <=> root.shell-drawer-fullscreen;
                        min-drawer-height: 180px;
                        top-safe-margin: 0px;
                        side-margin: 0px;
                        bottom-margin: 0px;
                        close-requested => {
                            root.shell-drawer-close();
                            root.shell-drawer-visible = false;
                            root.shell-drawer-fullscreen = false;
                        }
                        submit-command(command) => {
                            root.shell-drawer-submit(command);
                            root.shell-drawer-input-text = "";
                        }
                        key-pressed(text, ctrl, alt, shift, meta) => {
                            root.shell-drawer-key-pressed(text, ctrl, alt, shift, meta);
                        }
                        viewport-resized(cols, rows) => {
                            root.shell-drawer-resize(cols, rows);
                        }
                        scrollback-requested(delta) => {
                            root.shell-drawer-scrollback-requested(delta);
                        }
                        paste-requested => {
                            root.shell-drawer-paste();
                        }
                        selection-mode-changed(enabled) => {
                            root.shell-drawer-selection-mode-changed(enabled);
                        }
                    }
                }

            }

            // Chat owns a heavy text tree. Mount it only on the Chat route so hidden
            // pages do not participate in window-resize layout or retain delegates.
            if root.show-chat-page: ChatPage {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                messages: root.chat-messages;
                input-text <=> root.chat-input-text;
                is-sending: root.chat-is-sending;
                can-load-more-history: root.chat-can-load-more-history;
                loading-history: root.chat-loading-history;
                virtual-top-spacer: root.chat-virtual-top-spacer;
                virtual-bottom-spacer: root.chat-virtual-bottom-spacer;
                scroll-position <=> root.chat-scroll-position;
                loading-phase <=> root.chat-loading-phase;
                navigate(route) => {
                    root.navigate(route);
                }
                send-message(text) => {
                    root.chat-send-message(text);
                }
                load-more-history() => {
                    root.chat-load-more-history();
                }
                copy-to-clipboard(index, text) => {
                    root.chat-copy-to-clipboard(index, text)
                }
                open-link(url) => {
                    root.chat-open-link(url);
                }
            }

        }
    }

    navigation-sidebar-host := Rectangle {
        x: -GitHubMetrics.application-sidebar-width
            * (1.0 - root.sidebar-layout-progress);
        y: 0px;
        width: GitHubMetrics.application-sidebar-width;
        height: root.height;
        background: transparent;
        clip: false;
        // Route-owned full-window overlays (PR review uses z:800) must be able
        // to paint dialog surfaces across the docked sidebar. The temporary
        // sidebar preview remains a separate z:880 root overlay.
        z: 700;

        GitHubNavigationSidebar {
            width: GitHubMetrics.application-sidebar-width;
            height: parent.height;
            current-index: root.navigation-current-index;
            current-route: root.current-route;
            can-go-back: root.navigation-can-go-back;
            can-go-forward: root.navigation-can-go-forward;
            show-sidebar-control: !root.platform-is-macos;
            show-history-controls: !root.platform-is-macos;
            native-vibrancy: root.platform-is-macos;
            // The inactive native surface is opaque and doubles as the startup
            // fallback until Rust has attached the native effect hierarchy.
            native-window-active: root.native-window-active
                && root.native-sidebar-vibrancy-ready;
            titlebar-inset: root.native-titlebar-inset;
            header-chevron-icon: root.navigation-chevron-icon;
            search-icon: root.navigation-search-icon;
            notification-icon: root.navigation-notification-icon;
            settings-icon: root.navigation-settings-icon;
            about-icon: root.navigation-about-icon;
            toggle-shortcut-label: root.shortcut-toggle-sidebar-label;
            back-shortcut-label: root.shortcut-navigate-back-label;
            forward-shortcut-label: root.shortcut-navigate-forward-label;
            item-count: UiComponentsFeature.enabled ? 4 : 3;
            items: [
                { icon: root.navigation-home-icon, text: "Home" },
                { icon: root.navigation-chat-icon, text: "Chat" },
                { icon: root.navigation-project-icon, text: "Projects" },
                { icon: root.navigation-components-icon, text: "UI Components" },
            ];
            selected(item-index) => {
                if item-index >= 0 {
                    root.navigate-from-nav-index(item-index);
                }
            }
            interaction-started => { root.dismiss-transient-overlays(); }
            navigate(route) => { root.navigate(route); }
            toggle-docked => { root.toggle-navigation-drawer(); }
            back => { root.navigate-back(); }
            forward => { root.navigate-forward(); }
        }

        GitHubSidebarRightEdge {
            // Keep the 1 px stroke inside the sidebar's final pixel instead of
            // extending it into route content. PR Review paints its ordinary
            // surface above this host below the title bar, so an outside stroke
            // would otherwise appear one logical pixel farther right only in
            // the uncovered native-title-bar segment.
            x: parent.width - self.width;
            // The docked sidebar boundary is one continuous window-height
            // edge, including the native title-bar segment in PR Review.
            y: 0px;
            height: parent.height;
            visible: root.sidebar-layout-progress > 0.001;
            z: 1;
        }
    }

    // Keep the trailing title-bar action at the window root. If it remains
    // inside main-content-host (z:1), its tooltip cannot rise above the root
    // title-bar divider even when the button itself uses a large local z.
    if root.platform-is-macos
            && root.show-breadcrumb
            && root.current-route != Route.PrReview: Rectangle {
        x: root.width - GitHubMetrics.size-48;
        y: 0px;
        width: GitHubMetrics.size-48;
        height: root.native-titlebar-inset;
        background: transparent;
        clip: false;
        z: 70;

        GitHubIconButton {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            control-size: 28px;
            glyph-size: 14px;
            icon: @image-url("./assets/icons/lucide-sidebar-settings.svg");
            tooltip-text: "Settings (" + root.shortcut-open-settings-label + ")";
            tooltip-above: false;
            tooltip-align-right: true;
            foreground: GitHubTheme.fg-subtle;
            hover-foreground: GitHubTheme.titlebar-control-hover-fg;
            selected-foreground: GitHubTheme.titlebar-control-selected-fg;
            selected-hover-foreground: GitHubTheme.titlebar-control-selected-fg;
            hover-background: GitHubTheme.titlebar-control-hover-bg;
            selected-background: GitHubTheme.titlebar-control-selected-bg;
            selected-hover-background: GitHubTheme.titlebar-control-selected-hover-bg;
            selected: root.current-route == Route.Settings;
            clicked => { root.navigate(Route.Settings); }
        }
    }

    // The native left title bar, breadcrumb, and trailing action slot share one
    // continuous boundary. Component-local rules would leave seams between
    // these independently owned regions.
    if root.platform-is-macos
            && (root.show-breadcrumb || root.current-route == Route.PrReview): Rectangle {
        // Codex keeps the native sidebar material visually continuous with its
        // header. Start the title/content boundary at the live content edge
        // instead of drawing it through the docked sidebar.
        x: GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
        y: root.native-titlebar-inset - 1px;
        width: root.width - self.x;
        height: 1px;
        background: GitHubTheme.shell-divider;
        z: 50;
    }

    edge-hover-target := TouchArea {
        x: 0px;
        y: 0px;
        width: root.show-navigation-drawer
                && !root.navigation-drawer-expanded
                && !root.docked-sidebar-column-visible
            ? GitHubMetrics.size-8
            : 0px;
        height: root.height;
        enabled: root.show-navigation-drawer
            && !root.navigation-drawer-expanded
            && !root.docked-sidebar-column-visible;
        z: 878;
        changed has-hover => {
            if self.has-hover {
                root.sidebar-preview-dismiss-pending = false;
                root.sidebar-preview-visible = true;
            } else {
                root.sidebar-preview-dismiss-pending = true;
            }
        }
    }

    sidebar-preview := Rectangle {
        x: root.show-navigation-drawer
                && !root.navigation-drawer-expanded
                && !root.docked-sidebar-column-visible
                && root.sidebar-preview-visible
            ? 0px
            : -GitHubMetrics.application-sidebar-width;
        y: 0px;
        width: GitHubMetrics.application-sidebar-width;
        height: root.height;
        // Codex renders the temporary sheet as opaque white, not the
        // blue-gray translucent fallback used by docked sidebar material.
        background: GitHubTheme.sidebar-preview-canvas;
        border-radius: 10px;
        opacity: root.show-navigation-drawer
                && !root.navigation-drawer-expanded
                && !root.docked-sidebar-column-visible
                && root.sidebar-preview-visible
            ? 1
            : 0;
        z: 880;
        animate x { duration: 300ms; easing: cubic-bezier(0.19, 1, 0.22, 1); }
        animate opacity { duration: 150ms; easing: ease-in-out; }

        preview-hover-region := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.show-navigation-drawer
                && !root.navigation-drawer-expanded
                && !root.docked-sidebar-column-visible
                && root.sidebar-preview-visible;
            changed has-hover => {
                if self.has-hover {
                    root.sidebar-preview-dismiss-pending = false;
                } else {
                    root.sidebar-preview-dismiss-pending = true;
                }
            }

            GitHubNavigationSidebar {
                width: parent.width;
                height: parent.height;
                current-index: root.navigation-current-index;
                current-route: root.current-route;
                can-go-back: root.navigation-can-go-back;
                can-go-forward: root.navigation-can-go-forward;
                show-sidebar-control: !root.platform-is-macos;
                show-history-controls: !root.platform-is-macos;
                native-vibrancy: root.platform-is-macos;
                native-window-active: root.native-window-active
                    && root.native-sidebar-vibrancy-ready;
                paint-native-surface: false;
                titlebar-inset: root.native-titlebar-inset;
                header-chevron-icon: root.navigation-chevron-icon;
                search-icon: root.navigation-search-icon;
                notification-icon: root.navigation-notification-icon;
                settings-icon: root.navigation-settings-icon;
                about-icon: root.navigation-about-icon;
                toggle-shortcut-label: root.shortcut-toggle-sidebar-label;
                back-shortcut-label: root.shortcut-navigate-back-label;
                forward-shortcut-label: root.shortcut-navigate-forward-label;
                item-count: UiComponentsFeature.enabled ? 4 : 3;
                items: [
                    { icon: root.navigation-home-icon, text: "Home" },
                    { icon: root.navigation-chat-icon, text: "Chat" },
                    { icon: root.navigation-project-icon, text: "Projects" },
                    { icon: root.navigation-components-icon, text: "UI Components" },
                ];
                selected(item-index) => {
                    root.sidebar-preview-visible = false;
                    root.navigate-from-nav-index(item-index);
                }
                interaction-started => { root.dismiss-transient-overlays(); }
                navigate(route) => {
                    root.sidebar-preview-visible = false;
                    root.navigate(route);
                }
                toggle-docked => {
                    root.sidebar-preview-visible = false;
                    root.toggle-navigation-drawer();
                }
                back => { root.navigate-back(); }
                forward => { root.navigate-forward(); }
            }

            // Codex's temporary sidebar is a bordered sheet: no right-edge
            // shadow, with the top-right and bottom-right corners rounded.
            Rectangle {
                x: -10px;
                y: 0px;
                width: parent.width + 10px;
                height: parent.height;
                background: transparent;
                border-width: GitHubMetrics.border-thin;
                border-color: GitHubTheme.sidebar-preview-border;
                border-radius: 10px;
                z: 1;
            }
        }
    }

    // Compact Primer utility status bar fixed to the bottom edge.
    // z must sit above GitHubPageScrollActions (500) so version/network popovers and
    // click-outside dismiss paint over the terminal / back-to-top IconButtons.
    // Keep below full-page overlays (PrReview 800), Notify (900), and Toast (1000).
    GitHubStatusBar {
        x: 0px;
        y: root.height - LayoutConstants.status-bar-height;
        width: root.width;
        height: LayoutConstants.status-bar-height;
        content-leading-inset:
            GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
        shortcut-initialization-visible: root.shortcut-initialization-visible;
        shortcut-initialization-failed: root.shortcut-initialization-failed;
        shortcut-initialization-progress: root.shortcut-initialization-progress;
        shortcut-initialization-status: root.shortcut-initialization-status;
        shortcut-initialization-detail: root.shortcut-initialization-detail;
        unread-message-count: root.message-unread-count;
        messages-route-active: root.current-route == Route.Messages;
        open-messages => { root.navigate(Route.Messages); }
        z: 600;
    }

    if (root.current-route == Route.Workflow || root.current-route == Route.Project) && root.show-page-scroll-view: Rectangle {
        x: main-content-host.x + page-scroll-view.x;
        y: main-content-host.y + page-scroll-view.y;
        width: page-scroll-view.width;
        height: page-scroll-view.height;
        background: transparent;
        z: 500;
        visible: !root.shell-drawer-fullscreen;

        GitHubPageScrollActions {
            container-width: parent.width;
            container-height: parent.height;
            right-offset: LayoutConstants.page-fab-right-offset;
            enable-terminal: root.current-route == Route.Workflow;
            terminal-bottom-offset: root.workflow-fab-bottom-offset;
            terminal-active: root.shell-drawer-visible;
            terminal-tooltip-text: "Open terminal (" + root.shortcut-toggle-terminal-label + ")";
            terminal-active-tooltip-text: "Close terminal (" + root.shortcut-toggle-terminal-label + ")";
            enable-to-top: true;
            to-top-bottom-offset: root.current-route == Route.Workflow
                ? root.workflow-fab-bottom-offset + LayoutConstants.page-fab-stack-spacing
                : LayoutConstants.page-fab-bottom-offset;
            scroll-offset: root.page-scroll-offset;
            show-threshold: LayoutConstants.to-top-show-threshold;
            request-open-terminal => {
                root.shell-drawer-toggle();
            }
            request-scroll-to-top => {
                page-scroll-view.viewport_y = 0px;
            }
        }
    }

    GitHubProjectDialog {
        x: 0;
        y: 0;
        width: root.width;
        z: 1200;
        // Modal backdrops cover the complete application window, including
        // the persistent bottom status bar.
        height: root.height;
        modal-visible: root.project-show-add-modal;
        mode: root.project-modal-mode;
        original-alias: root.project-modal-original-alias;
        name <=> root.project-new-name;
        alias <=> root.project-new-alias;
        local-repo <=> root.project-new-local-repo;
        remote-repo <=> root.project-new-remote-repo;
        logo <=> root.project-new-logo;
        project-tags <=> root.project-new-tags;
        is-pr-auto-update <=> root.project-new-pr-auto-update;
        logo-preview-image: root.project-logo-preview-image;
        logo-preview-status: root.project-logo-preview-status;
        error-text <=> root.project-add-error;
        preview-logo(logo) => {
            root.project-preview-logo(logo);
        }
        submit(name, alias, local-repo, remote-repo, logo, project-tags, is-pr-auto-update) => {
            if root.project-modal-mode == "edit" {
                root.project-update-project(root.project-modal-original-alias, name, alias, local-repo, remote-repo, logo, project-tags, is-pr-auto-update);
            } else {
                root.project-add-project(name, alias, local-repo, remote-repo, logo, project-tags, is-pr-auto-update);
            }
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
        confirm-delete(alias) => {
            root.project-delete-project(alias);
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
        cancel => {
            root.project-new-name = "";
            root.project-new-alias = "";
            root.project-new-local-repo = "";
            root.project-new-remote-repo = "";
            root.project-new-logo = "";
            root.project-new-tags = "";
            root.project-new-pr-auto-update = false;
            root.project-preview-logo("");
            root.project-add-error = "";
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
    }

    if root.current-route == Route.PrReview: GitHubPullRequestReviewPage {
        // Keep the large PR render tree fixed at the window origin. Moving the
        // complete frozen diff tree during native live resize can retain a
        // stale compositor transform; ordinary content applies the discrete
        // sidebar inset inside the component instead.
        x: 0px;
        y: root.native-titlebar-inset;
        width: root.width;
        height: root.height - root.native-titlebar-inset;
        z: 800;
        application-width: root.width;
        application-height: root.height;
        shell-leading-inset: root.pr-content-x;
        shell-content-width: root.pr-content-width;
        live-resizing: root.window-live-resizing;
        project-name: root.workflow-project-name;
        provider: root.workflow-pr-repo-type;
        pull-request-number: root.workflow-pr-review-number;
        pull-request-title: root.workflow-pr-review-title;
        author: root.workflow-pr-review-author;
        source-branch: root.workflow-pr-review-source-branch;
        target-branch: root.workflow-pr-review-target-branch;
        updated-at: root.workflow-pr-review-updated-at;
        updated-at-tooltip: root.workflow-pr-review-updated-at-tooltip;
        added-lines: root.workflow-pr-review-added-lines;
        removed-lines: root.workflow-pr-review-removed-lines;
        commit-count: root.workflow-pr-review-commit-count;
        conversation-count: root.workflow-pr-review-conversation-count;
        base-sha: root.workflow-pr-review-base-sha;
        head-sha: root.workflow-pr-review-head-sha;
        too-many-commits: root.workflow-pr-review-too-many-commits;
        selected-tab <=> root.workflow-pr-review-tab;
        conversation-items: root.workflow-pr-review-conversation-items;
        conversation-content-height: root.workflow-pr-review-conversation-content-height;
        expanded-commit-body-height: root.workflow-pr-review-expanded-commit-body-height;
        commits: root.workflow-pr-review-commits;
        conversation-loading: root.workflow-pr-review-conversation-loading;
        commits-loading: root.workflow-pr-review-commits-loading;
        conversation-error: root.workflow-pr-review-conversation-error;
        commits-error: root.workflow-pr-review-commits-error;
        commit-range-start: root.workflow-pr-review-commit-range-start;
        commit-range-end: root.workflow-pr-review-commit-range-end;
        commit-range-label: root.workflow-pr-review-commit-range-label;
        files: root.workflow-pr-review-files;
        tree-items: root.workflow-pr-review-tree-items;
        extension-filters: root.workflow-pr-review-extension-filters;
        only-manifest-files: root.workflow-pr-review-only-manifest-files;
        show-viewed-files: root.workflow-pr-review-show-viewed-files;
        file-filters-active: root.workflow-pr-review-file-filters-active;
        lines: root.workflow-pr-review-lines;
        line-metrics: root.workflow-pr-review-line-metrics;
        max-code-columns: root.workflow-pr-review-max-code-columns;
        longest-code-line: root.workflow-pr-review-longest-code-line;
        line-content-revision: root.workflow-pr-review-line-content-revision;
        line-model-revision: root.workflow-pr-review-line-model-revision;
        scroll-diagnostics-enabled: root.workflow-pr-review-scroll-diagnostics-enabled;
        hunk-scroll-anchor-source-index: root.workflow-pr-review-hunk-scroll-anchor-source-index;
        hunk-scroll-restore-revision: root.workflow-pr-review-hunk-scroll-restore-revision;
        code-font-family: root.workflow-pr-review-code-font-family;
        tree-font-family: root.workflow-pr-review-tree-font-family;
        file-list-preferred-width <=> root.workflow-pr-review-file-list-width;
        selected-file-index: root.workflow-pr-review-selected-file-index;
        selected-file-path: root.workflow-pr-review-selected-file-path;
        selected-file-added-lines: root.workflow-pr-review-selected-file-added-lines;
        selected-file-removed-lines: root.workflow-pr-review-selected-file-removed-lines;
        has-expandable-hunks: root.workflow-pr-review-has-expandable-hunks;
        context-expanded: root.workflow-pr-review-context-expanded;
        viewing-file: root.workflow-pr-review-viewing-file;
        loading: root.workflow-pr-review-loading;
        code-loading: root.workflow-pr-review-code-loading;
        large-diff-deferred: root.workflow-pr-review-large-diff-deferred;
        large-diff-loading: root.workflow-pr-review-large-diff-loading;
        error-text: root.workflow-pr-review-error;
        ignore-whitespace-supported: root.workflow-pr-review-ignore-whitespace-supported;
        ignore-whitespace <=> root.workflow-pr-review-ignore-whitespace;
        diff-view <=> root.workflow-pr-review-diff-view;
        file-filter <=> root.workflow-pr-review-file-filter;
        review-dialog-open <=> root.workflow-pr-review-dialog-open;
        merge-dialog-open <=> root.workflow-pr-merge-dialog-open;
        revert-dialog-open <=> root.workflow-pr-revert-dialog-open;
        commit-range-dialog-open <=> root.workflow-pr-commit-range-dialog-open;
        action-loading: root.workflow-pr-action-loading;
        can-comment: root.workflow-pr-can-comment;
        can-approve: root.workflow-pr-can-approve;
        can-request-changes: root.workflow-pr-can-request-changes;
        remote-review-state: root.workflow-pr-remote-review-state;
        can-merge: root.workflow-pr-can-merge;
        can-revert: root.workflow-pr-can-revert;
        merge-readiness-kind: root.workflow-pr-merge-readiness-kind;
        merge-readiness-label: root.workflow-pr-merge-readiness-label;
        merge-readiness-detail: root.workflow-pr-merge-readiness-detail;
        merge-block-reason: root.workflow-pr-merge-block-reason;
        revert-block-reason: root.workflow-pr-revert-block-reason;
        revert-action-label: root.workflow-pr-revert-action-label;
        revert-confirmation: root.workflow-pr-revert-confirmation;
        merge-method-merge: root.workflow-pr-merge-method-merge;
        merge-method-squash: root.workflow-pr-merge-method-squash;
        merge-method-rebase: root.workflow-pr-merge-method-rebase;
        merge-method-fast-forward: root.workflow-pr-merge-method-fast-forward;
        select-tab(tab) => { root.workflow-pr-review-select-tab(tab); }
        ensure-commits => { root.workflow-pr-review-ensure-commits(); }
        apply-commit-range(start, end) => { root.workflow-pr-review-apply-commit-range(start, end); }
        open-commit(sha) => { root.workflow-pr-review-open-commit(sha); }
        select-file(index) => { root.workflow-pr-review-select-file(index); }
        select-relative-file(offset) => { root.workflow-pr-review-select-relative-file(offset); }
        reload(ignore-whitespace) => { root.workflow-pr-review-reload(ignore-whitespace); }
        apply-diff-settings(diff-view, ignore-whitespace) => {
            root.workflow-pr-review-apply-diff-settings(diff-view, ignore-whitespace);
        }
        load-large-diff => { root.workflow-pr-review-load-large-diff(); }
        filter-files(query) => { root.workflow-pr-review-filter-files(query); }
        toggle-extension-filter(extension) => { root.workflow-pr-review-toggle-extension-filter(extension); }
        toggle-manifest-filter => { root.workflow-pr-review-toggle-manifest-filter(); }
        toggle-viewed-files => { root.workflow-pr-review-toggle-viewed-files(); }
        toggle-folder(path) => { root.workflow-pr-review-toggle-folder(path); }
        expand-hunk(line-index, direction) => {
            root.workflow-pr-review-expand-hunk(line-index, direction);
        }
        expand-all-hunks => { root.workflow-pr-review-expand-all-hunks(); }
        collapse-non-diff-lines => { root.workflow-pr-review-collapse-non-diff-lines(); }
        copy-file-path(path) => { root.workflow-pr-review-copy-file-path(path) }
        copy-commit-sha(sha) => { root.workflow-pr-review-copy-commit-sha(sha) }
        copy-source-branch(branch) => { root.workflow-pr-review-copy-source-branch(branch) }
        copy-diff-selection(start-line, start-col, end-line, end-col, side) => {
            root.workflow-pr-review-copy-diff-selection(start-line, start-col, end-line, end-col, side);
        }
        resolve-diff-selection(line, x, y, row-height, code-width, cell-width, content-width, line-pitch, side) => {
            root.workflow-pr-review-resolve-diff-selection(line, x, y, row-height, code-width, cell-width, content-width, line-pitch, side)
        }
        resolve-diff-selection-slice(line, side, start-col, end-col) => {
            root.workflow-pr-review-resolve-diff-selection-slice(line, side, start-col, end-col)
        }
        resolve-diff-wrap-line-start(line, side, caret, max-cols) => {
            root.workflow-pr-review-resolve-diff-wrap-line-start(line, side, caret, max-cols)
        }
        resolve-diff-click-range(line, column, side, mode) => {
            root.workflow-pr-review-resolve-diff-click-range(line, column, side, mode)
        }
        find-diff-matches(query, split) => {
            root.workflow-pr-review-find-diff-matches(query, split)
        }
        find-diff-row-matches(line, side, query) => {
            root.workflow-pr-review-find-diff-row-matches(line, side, query)
        }
        step-diff-find-index(current, count, backward) => {
            root.workflow-pr-review-step-diff-find-index(current, count, backward)
        }
        resolve-diff-find-viewport-y(line, start-char, code-width, cell-width, side, current-viewport-y, visible-height, content-height) => {
            root.workflow-pr-review-resolve-diff-find-viewport-y(
                line,
                start-char,
                code-width,
                cell-width,
                side,
                current-viewport-y,
                visible-height,
                content-height
            )
        }
        layout-diff-virtual-window(revision, metrics, scroll-offset, visible-height, code-width, cell-width, code-line-height, hunk-line-height) => {
            root.workflow-pr-review-layout-diff-virtual-window(
                revision,
                metrics,
                scroll-offset,
                visible-height,
                code-width,
                cell-width,
                code-line-height,
                hunk-line-height
            )
        }
        diagnose-diff-scroll(kind, viewport-y, requested-y, visible-height, viewport-height, find-open, find-focused, hunk-pending, find-revision, line-revision, hunk-attempts) => {
            root.workflow-pr-review-diagnose-diff-scroll(
                kind,
                viewport-y,
                requested-y,
                visible-height,
                viewport-height,
                find-open,
                find-focused,
                hunk-pending,
                find-revision,
                line-revision,
                hunk-attempts
            )
        }
        view-file => { root.workflow-pr-review-view-file(); }
        toggle-commit-message(sha) => { root.workflow-pr-review-toggle-commit-message(sha); }
        submit-review(action, body) => { root.workflow-pr-submit-review(action, body); }
        merge(method, remove-source-branch) => { root.workflow-pr-merge(method, remove-source-branch); }
        revert => { root.workflow-pr-revert(); }
    }

    // PR actions live above the PR surface so the readiness ActionMenu can
    // expand below the title bar without being covered by the page layer.
    if root.platform-is-macos && root.current-route == Route.PrReview: Rectangle {
        x: max(0px, root.width - 520px);
        y: 0px;
        width: min(520px, root.width);
        height: root.native-titlebar-inset;
        background: transparent;
        clip: false;
        z: 850;

        pr-titlebar-actions := GitHubHeaderActionStrip {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: max(0px, parent.width - 16px);
            height: 28px;
            titlebar-mode: true;
            show-readiness: true;
            readiness-kind: root.workflow-pr-merge-readiness-kind;
            readiness-label: root.workflow-pr-merge-readiness-label;
            readiness-detail: root.workflow-pr-merge-readiness-detail;
            remote-review-state: root.workflow-pr-remote-review-state;
            action-loading: root.workflow-pr-action-loading;
            actions-enabled: !root.workflow-pr-review-dialog-open
                && !root.workflow-pr-merge-dialog-open
                && !root.workflow-pr-revert-dialog-open;
            readiness-popup-open: root.workflow-pr-readiness-popup-open;
            render-readiness-popup: false;
            viewport-global-x: 0px;
            viewport-global-y: 0px;
            viewport-width: root.width;
            viewport-height: root.height;
            can-comment: root.workflow-pr-can-comment;
            can-approve: root.workflow-pr-can-approve;
            can-request-changes: root.workflow-pr-can-request-changes;
            can-merge: root.workflow-pr-can-merge;
            can-revert: root.workflow-pr-can-revert;
            revert-action-label: root.workflow-pr-revert-action-label;
            merge-block-reason: root.workflow-pr-merge-block-reason;
            background-color: GitHubTheme.canvas-default;
            outline-color: GitHubTheme.border-default;
            foreground-color: GitHubTheme.fg-default;
            muted-color: GitHubTheme.fg-muted;
            success-color: GitHubTheme.success-fg;
            attention-color: GitHubTheme.attention-fg;
            danger-color: GitHubTheme.danger-fg-strong;
            done-color: GitHubTheme.done-fg-strong;
            review => {
                root.workflow-pr-readiness-popup-open = false;
                root.workflow-pr-review-dialog-open = true;
            }
            merge => {
                root.workflow-pr-readiness-popup-open = false;
                root.workflow-pr-merge-dialog-open = true;
            }
            revert => {
                root.workflow-pr-readiness-popup-open = false;
                root.workflow-pr-revert-dialog-open = true;
            }
            toggle-readiness-popup => {
                // Peer Diff/file menus close via ActionMenu exclusive-claim when
                // this root-mounted menu opens; no page-local dismiss-all here.
                root.workflow-pr-readiness-popup-open = !root.workflow-pr-readiness-popup-open;
            }
            readiness-anchor-changed(x, y, width, height) => {
                root.pr-readiness-anchor-x = x;
                root.pr-readiness-anchor-y = y;
                root.pr-readiness-anchor-width = width;
                root.pr-readiness-anchor-height = height;
            }
        }
    }

    // A title-bar ActionMenu must live at the window root. Rendering it as a
    // descendant of the 46px action strip makes the menu depend on overflow
    // across the PR page's stacking layer and can leave it invisible or
    // non-interactive on macOS. Page outside-click and mutual-exclusive first
    // clicks are owned by the PR workspace (under its chrome) plus
    // TransientOverlayState for title-bar/shell chrome — not a root scrim above
    // the page, which would consume the switching click on Diff/file menus.
    pr-readiness-overlay := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;
        visible: root.platform-is-macos && root.current-route == Route.PrReview;
        z: 860;

        private property <color> state-color:
            root.workflow-pr-merge-readiness-kind == "ready"
                ? GitHubTheme.success-fg
                : (root.workflow-pr-merge-readiness-kind == "merged"
                    ? GitHubTheme.done-fg-strong
                    : ((root.workflow-pr-merge-readiness-kind == "conflicts"
                            || root.workflow-pr-merge-readiness-kind == "changes_requested"
                            || root.workflow-pr-merge-readiness-kind == "checks_failed"
                            || root.workflow-pr-merge-readiness-kind == "closed")
                        ? GitHubTheme.danger-fg-strong
                        : ((root.workflow-pr-merge-readiness-kind == "review_required"
                                || root.workflow-pr-merge-readiness-kind == "checks_pending"
                                || root.workflow-pr-merge-readiness-kind == "branch_out_of_date"
                                || root.workflow-pr-merge-readiness-kind == "discussions_unresolved"
                                || root.workflow-pr-merge-readiness-kind == "blocked")
                            ? GitHubTheme.attention-fg
                            : GitHubTheme.fg-muted)));
        private property <image> state-icon:
            root.workflow-pr-merge-readiness-kind == "ready"
                    || root.workflow-pr-merge-readiness-kind == "merged"
                ? @image-url("./assets/icons/octicon-check-16.svg")
                : ((root.workflow-pr-merge-readiness-kind == "conflicts"
                        || root.workflow-pr-merge-readiness-kind == "changes_requested"
                        || root.workflow-pr-merge-readiness-kind == "checks_failed"
                        || root.workflow-pr-merge-readiness-kind == "closed")
                    ? @image-url("./assets/icons/octicon-x-16.svg")
                    : ((root.workflow-pr-merge-readiness-kind == "checking"
                            || root.workflow-pr-merge-readiness-kind == "unavailable")
                        ? @image-url("./assets/icons/octicon-sync-16.svg")
                        : @image-url("./assets/icons/octicon-alert-16.svg")));

        popup-title-measure := Text {
            width: 0px;
            height: 0px;
            opacity: 0;
            text: root.workflow-pr-merge-readiness-label;
            font-size: 14px;
            font-weight: 600;
        }
        popup-detail-measure := Text {
            width: 0px;
            height: 0px;
            opacity: 0;
            text: root.workflow-pr-merge-readiness-detail;
            font-size: 12px;
        }
        private property <length> popup-width: min(
            320px,
            max(
                popup-title-measure.preferred-width + 52px,
                popup-detail-measure.preferred-width + 32px
            )
        );
        popup-detail-wrapped-measure := Text {
            width: pr-readiness-overlay.popup-width - 32px;
            height: self.preferred-height;
            opacity: 0;
            text: root.workflow-pr-merge-readiness-detail;
            wrap: word-wrap;
            font-size: 12px;
        }
        private property <length> popup-height:
            16px + 28px + 8px + max(20px, popup-detail-wrapped-measure.preferred-height) + 16px;

        GitHubActionMenu {
            open: pr-readiness-overlay.visible && root.workflow-pr-readiness-popup-open;
            viewport-x: 0px;
            viewport-y: 0px;
            viewport-width: root.width;
            viewport-height: root.height;
            anchor-x: root.pr-readiness-anchor-x;
            anchor-y: root.pr-readiness-anchor-y;
            anchor-width: root.pr-readiness-anchor-width;
            anchor-height: root.pr-readiness-anchor-height;
            menu-width: pr-readiness-overlay.popup-width;
            content-height: pr-readiness-overlay.popup-height;
            align: "end";
            dismiss-requested => { root.workflow-pr-readiness-popup-open = false; }

            Rectangle {
                width: parent.width;
                height: pr-readiness-overlay.popup-height;
                Rectangle {
                    x: 16px;
                    y: 18px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: pr-readiness-overlay.state-color;
                    Image {
                        x: 2px;
                        y: 2px;
                        width: 14px;
                        height: 14px;
                        source: pr-readiness-overlay.state-icon;
                        image-fit: contain;
                        colorize: GitHubTheme.fg-on-emphasis;
                    }
                }
                Text {
                    x: 44px;
                    y: 12px;
                    width: parent.width - 60px;
                    height: 28px;
                    text: root.workflow-pr-merge-readiness-label;
                    vertical-alignment: center;
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    x: 16px;
                    y: 48px;
                    width: parent.width - 32px;
                    height: parent.height - 64px;
                    text: root.workflow-pr-merge-readiness-detail;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: GitHubTheme.fg-muted;
                }
            }
        }
    }

    // PR review starts below the native macOS title-bar inset, so its local
    // Dialog backdrop cannot paint that final strip. Continue the same backdrop
    // at the window root. AppKit's standard traffic-light buttons remain above
    // the Slint content view and therefore stay visible and clickable.
    if root.platform-is-macos
            && root.current-route == Route.PrReview
            && (root.workflow-pr-review-dialog-open
                || root.workflow-pr-merge-dialog-open
                || root.workflow-pr-revert-dialog-open
                || root.workflow-pr-commit-range-dialog-open): Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.native-titlebar-inset;
        background: GitHubTheme.backdrop;
        z: 2999;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }
    }

    // PR Dialog backdrops now paint the complete window from the shared
    // component. Keep only a root input shield over the sidebar because hit
    // testing outside a route component's own bounds is not guaranteed.
    if root.current-route == Route.PrReview
            && (root.workflow-pr-review-dialog-open
                || root.workflow-pr-merge-dialog-open
                || root.workflow-pr-revert-dialog-open
                || root.workflow-pr-commit-range-dialog-open): Rectangle {
        x: 0px;
        y: root.native-titlebar-inset;
        width: max(0px, main-content-host.x);
        height: root.height - root.native-titlebar-inset;
        background: transparent;
        z: 2999;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }
    }
    
    // Keep one transient Banner visible at a time. The manager retains a
    // newest-first capped queue; dismissing the head reveals the next older
    // item. The footer uses the durable unread count to disclose items beyond
    // that cap and opens the Inbox through View all. Dismiss all affects only
    // the Banner stack.
    // Suppress on Messages to avoid duplicating the durable Inbox row.
    if NotificationManager.queue.length > 0 && root.current-route != Route.Messages: Rectangle {
        x: root.width - self.width - GitHubMetrics.size-16;
        y: GitHubMetrics.size-16;
        width: min(400px, root.width - GitHubMetrics.size-32);
        height: notification-overlay-item.height;
        z: 900;
        background: transparent;

        notification-overlay-item := GitHubNotificationItem {
            width: parent.width;
            notification: NotificationManager.queue[0];
            index: 0;
            queue-count: NotificationManager.queue.length;
            total-count: max(root.message-unread-count, NotificationManager.queue.length);
            overlay-viewport-width: root.width;
            overlay-viewport-height: root.height;
            dismissed(id) => {
                NotificationManager.dismiss-by-id(id);
            }
            hovered(id, is-hovered) => {
                NotificationManager.set-hovered(id, is-hovered);
            }
            action-clicked(notification-id, action-index) => {
                NotificationManager.action-clicked(
                    notification-id,
                    action-index
                );
            }
            view-all => {
                root.navigate(Route.Messages);
            }
            dismiss-all => {
                NotificationManager.remove-all();
            }
        }
    }

    // Toast 显示区域 - 统一使用组件版 Toast，由组件内部处理 overlay 与非 overlay 场景
    if ToastManager.visible: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        z: 1000;

        GitHubToast {
            width: parent.width;
            height: parent.height;
            message: ToastManager.message;
            type: ToastManager.type == ToastType.Success ? "success" :
                  ToastManager.type == ToastType.Error ? "error" :
                  ToastManager.type == ToastType.Loading ? "loading" : "text";
            position: ToastManager.position;
            overlay: ToastManager.overlay;
            close-on-click: ToastManager.close-on-click;
            toast-visible: ToastManager.visible;
            toast-width-value: ToastManager.width-value;
            toast-width-percent: ToastManager.width-percent;
            toast-width-is-auto: ToastManager.width-is-auto;
            dismiss() => {
                ToastManager.dismiss();
            }
        }
    }

    // Dialog 组件（从 dialog_enhance.slint 导入）
    GitHubDialogEnhance {
        width: 100%;
        height: 100%;
        z: 1200;
        on-default-action-clicked(id) => {
            DialogManager.default-action-clicked(id);
        }
        on-action-clicked(id, index) => {
            DialogManager.action-clicked(id, index);
        }
    }
    
    // 下载进度模态框
        GitHubDownloadProgressDialog {
            width: 100%;
            height: 100%;
            z: 1200;
            cancel-clicked => {
                root.cancel-download();
            }
        }
    }

    // Shared tooltip portal: locators inside clipped page/scroll hosts publish
    // here so tips are never truncated by ancestor clip (z alone cannot escape).
    // Host stays zero-sized; only the tip child paints (no full-window hit target).
    GitHubTooltipOverlayHost {
        x: 0px;
        y: 0px;
        z: 1500;
    }
}
