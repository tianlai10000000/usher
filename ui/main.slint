import { NotificationManager, Notification, NotificationType, NotificationDelivery } from "./components/notify/notification.slint";
import { NotificationIcons } from "./components/notify/icons.slint";
import { GitHubNotificationItem } from "./components/notify/notification_item.slint";
import { GitHubToast } from "./components/toast/toast.slint";
import { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
import { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
import { GitHubDialogEnhance } from "./components/dialog/dialog_enhance.slint";
import { UpdateLogic, GitHubDownloadProgressDialog } from "./components/update/update.slint";
import { GitHubStatusBar } from "./components/status_bar.slint";
import { LayoutConstants } from "./layout_constants.slint";
import { GitHubPageScrollActions } from "./components/fab/page_scroll_actions.slint";
import { GitHubTerminalDrawer, TerminalLine } from "./components/drawer/terminal_drawer.slint";
import { GitHubScrollView } from "./components/github_scroll_view.slint";
import { GitHubActionMenu } from "./components/github_action_menu.slint";
import { GitHubCompactElevation } from "./components/github_elevation.slint";
import { GitHubIconButton } from "./components/button/github_icon_button.slint";
import { GitHubTheme, GitHubMetrics } from "./theme/github_theme.slint";
import { ArtifactPreviewKind, ArtifactPreviewBlockKind, ArtifactPreviewInlineKind, ArtifactPreviewInlineSpan, ArtifactPreviewCodeToken, ArtifactPreviewCodeLine, ArtifactPreviewBlock, ArtifactPreviewVirtualRow, ArtifactPreviewVirtualWindow, GitHubArtifactPreviewPanel, GitHubArtifactPreviewResizeHandle, ArtifactPreviewWindow } from "./components/artifact_preview/github_artifact_preview.slint";

export { MaterialWindowAdapter } from "@material";
export { AppState } from "./state/app_state.slint";
export { LanguageOption } from "./state/app_state.slint";
export { DebugLogger } from "./state/debug_logger.slint";
export { TransientOverlayState } from "./state/transient_overlay_state.slint";
export { TooltipOverlayState } from "./state/tooltip_overlay_state.slint";
export { NotificationManager, Notification, NotificationType, NotificationDelivery } from "./components/notify/notification.slint";
export { NotificationIcons } from "./components/notify/icons.slint";
export { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
export { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
export { UpdateLogic } from "./components/update/update.slint";
export { ChatMessage, ChatSelectionRect, MessageRole, MessageStatus } from "./views/chat.slint";
export { JobLogLayout, JobLogLineItem, JobStepItem } from "./components/jobs/job.slint";
export { WorkflowPullRequestItem } from "./components/workflow/github_pr_flow.slint";
export { AiReviewTaskItem, AiReviewRuleChoice, AiReviewFindingItem, AiReviewConversationItem, AiReviewResponseVisualRow, AgentResponseBlockKind, AgentResponseBlock } from "@ai-review";
export { WorkflowPrDiffFile, WorkflowPrDiffLine, WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrDiffSelectionRange, WorkflowPrDiffTextSlice, WorkflowPrDiffFindMatch, WorkflowPrTreeItem, WorkflowPrConversationItem, WorkflowPrCommit } from "./components/pr_review/shell.slint";
export { ArtifactPreviewKind, ArtifactPreviewBlockKind, ArtifactPreviewInlineKind, ArtifactPreviewInlineSpan, ArtifactPreviewCodeToken, ArtifactPreviewCodeLine, ArtifactPreviewBlock, ArtifactPreviewVirtualRow, ArtifactPreviewVirtualWindow, ArtifactPreviewWindow } from "./components/artifact_preview/github_artifact_preview.slint";

export struct SidebarMotionStep {
    progress: float,
    velocity: float,
}

export component MainWindow inherits Window {
    // Keep the application wide enough for the primary navigation and workspace
    // while preserving the shared application-level layout constraint.
    min-width: GitHubMetrics.application-min-width;
    min-height: 600px;
    title: "Usher";
    // Use one shared surface color for the native title bar and the main content area.
    private property <color> window-surface-color: GitHubTheme.canvas-default;
    private property <length> native-titlebar-inset: root.platform-is-macos ? 46px : 0px;
    private property <length> pr-titlebar-action-width: 544px;
    private property <length> page-breadcrumb-height:
        root.show-breadcrumb && !root.platform-is-macos ? 40px : 0px;
    private property <length> page-content-top-padding:
        root.show-breadcrumb ? (root.platform-is-macos ? 16px : 56px) : 0px;
    private property <length> page-content-height-offset: root.page-content-top-padding + 2px;
    // Until AppKit confirms that Menu vibrancy is mounted, keep the complete
    // first frame opaque. Otherwise the transparent root and translucent
    // sidebar can reveal another window before the native effect is ready.
    background: root.platform-is-macos && !root.native-sidebar-vibrancy-ready
        ? root.window-surface-color
        : transparent;
    in-out property <bool> window-live-resizing: false;
    in-out property <bool> native-window-active: true;
    // AppKit owns system full-screen transitions. Platform notifications keep
    // this presentation-only state current on the Slint event loop.
    in-out property <bool> native-window-fullscreen: false;
    callback message-window-activity-changed(bool);
    changed native-window-active => {
        root.message-window-activity-changed(root.native-window-active);
    }
    in-out property <bool> native-sidebar-vibrancy-ready: false;
    in property <image> native-titlebar-modal-image;
    in property <length> native-titlebar-modal-x;
    in property <length> native-titlebar-modal-y;
    in property <length> native-titlebar-modal-width;
    in property <length> native-titlebar-modal-height;
    // Display-only labels come from the Rust shortcut registry so tooltips and
    // executable bindings cannot drift apart.
    in property <string> shortcut-toggle-sidebar-label: "";
    in property <string> shortcut-toggle-terminal-label: "";
    in property <string> shortcut-navigate-back-label: "";
    in property <string> shortcut-navigate-forward-label: "";
    in property <string> shortcut-open-settings-label: "";
    in-out property <bool> shortcut-initialization-visible: false;
    in-out property <bool> shortcut-initialization-failed: false;
    in-out property <float> shortcut-initialization-progress: 0;
    in-out property <string> shortcut-initialization-status: "";
    in-out property <string> shortcut-initialization-detail: "";
    out property <length> chat-layout-window-width: self.width;
    out property <length> chat-layout-window-height: self.height;
    // Rust selects a clear CJK-capable family for each desktop platform.
    // Codex desktop applies weight 445 at its document root; StyledText inherits
    // that Window value because Slint 1.17 has no per-item default weight.
    // Terminal content plus PR diff code/file-tree content keep their own fonts.
    in property <string> application-font-family: ".AppleSystemUIFont";
    default-font-family: root.application-font-family;
    default-font-weight: 445;

    // 路由状态 - 对外暴露
    in-out property <Route> current-route: Route.Home;
    // Breadcrumb 显示控制（由路由策略统一计算）
    in-out property <bool> show-breadcrumb: true;
    // 导航抽屉显示控制（由路由策略统一计算）
    in-out property <bool> show-navigation-drawer: true;
    // 导航抽屉当前选中项（由路由策略统一计算）
    in-out property <int> navigation-current-index: 0;
    // 页面可见性控制（由路由策略统一计算）
    in-out property <bool> show-page-scroll-view: true;
    in-out property <bool> show-chat-page: false;
    
    // Router history is authoritative. UI controls only invoke Back/Forward.
    in-out property <Route> previous-route: Route.Home;
    in-out property <bool> navigation-can-go-back: false;
    in-out property <bool> navigation-can-go-forward: false;
    private property <bool> shell-drawer-docked-route: root.current-route == Route.Workflow || root.current-route == Route.Project;
    private property <length> page-scroll-offset: (root.current-route == Route.Workflow || root.current-route == Route.Project)
        ? max(0px, -page-scroll-view.viewport_y)
        : 0px;
    private property <length> workflow-terminal-max-height: max(
        180px,
        main-content-host.height - root.native-titlebar-inset - root.page-breadcrumb-height - 32px
    );
    private property <length> workflow-terminal-fullscreen-height: max(
        180px,
        main-content-host.height - root.native-titlebar-inset - root.page-breadcrumb-height
    );
    private property <length> workflow-fab-bottom-offset: root.shell-drawer-visible ? 24px : 16px;
    private property <length> workflow-terminal-docked-height: root.shell-drawer-docked-route && root.shell-drawer-visible
        ? (root.shell-drawer-fullscreen
            ? root.workflow-terminal-fullscreen-height
            : min(root.shell-drawer-height > 0px ? root.shell-drawer-height : 280px, root.workflow-terminal-max-height))
        : 0px;
    private property <bool> page-memory-diag-pending: false;
    private property <bool> page-scroll-reset-pending: false;
    // Slint 1.17.1 can corrupt cross-crate factory controls when the product is
    // destroyed and remounted. Keep the small Settings tree stable after its
    // first visit; Rust restores committed values before each re-entry paints.
    private property <bool> settings-page-ever-opened: false;
    // Latch after the first Inbox visit. The cross-crate factory shell is
    // created lazily and never remounted; its potentially large row model is
    // released separately while the route is hidden.
    private property <bool> messages-page-ever-opened: false;
    private property <bool> sidebar-preview-visible: false;
    private property <bool> sidebar-preview-dismiss-pending: false;
    // Codex drives the docked sidebar from one interruptible Motion value. Keep
    // the equivalent scalar and velocity here so repeated toggles retarget the
    // in-flight spring instead of starting competing x/width animations.
    private property <float> sidebar-motion-progress: 0.0;
    private property <float> sidebar-motion-velocity: 0.0;
    private property <bool> sidebar-motion-running: false;
    // Production follows the display's animation clock. The legacy fixed timer
    // remains selectable only so the same release binary can run a controlled
    // A/B comparison.
    in property <bool> sidebar-motion-display-linked: true;
    out property <bool> sidebar-motion-active: root.sidebar-motion-running;
    out property <float> sidebar-motion-observed-progress: root.sidebar-motion-progress;
    out property <bool> sidebar-motion-target-expanded:
        root.show-navigation-drawer && root.navigation-drawer-expanded;
    private property <duration> sidebar-motion-frame-clock:
        root.sidebar-motion-running && root.sidebar-motion-display-linked
            ? animation-tick()
            : 0ms;
    private property <duration> sidebar-motion-last-frame-clock: 0ms;
    // AppKit can deliver several width commits inside one native live-resize
    // frame. Do not let independently evaluated x/width bindings observe an
    // in-flight sidebar position in that window: snap all shell geometry to
    // the persisted docked target until live resize finishes.
    private property <float> sidebar-layout-progress: root.window-live-resizing
        ? (root.show-navigation-drawer && root.navigation-drawer-expanded ? 1.0 : 0.0)
        : min(1.0, max(0.0, root.sidebar-motion-progress));
    // Keep the expensive page tree at a fixed width while the shell moves.
    // Opening clips a wide page until the spring settles; closing expands it
    // once before movement starts. Rapid retargets do not reflow the page.
    private property <bool> sidebar-content-wide: true;
    private property <length> sidebar-content-width: root.width
        - (root.sidebar-content-wide ? 0px : GitHubMetrics.application-sidebar-width);
    out property <bool> artifact-preview-pr-side-docked-visible:
        root.artifact-preview-visible
            && root.artifact-preview-pr-side-context
            && AppState.artifact-preview-presentation-mode != 1
            && root.current-route == Route.PrReview
            && root.ai-review-panel-visible;
    private property <bool> artifact-preview-docked-visible:
        root.artifact-preview-visible
            && AppState.artifact-preview-presentation-mode != 1
            && !root.artifact-preview-pr-side-docked-visible;
    private property <length> artifact-preview-available-width:
        max(0px, root.width - GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress);
    private property <bool> artifact-preview-panel-overlays:
        AppState.artifact-preview-presentation-mode == 2;
    private property <length> artifact-preview-panel-min-width:
        root.artifact-preview-panel-overlays ? 320px
            : min(320px, root.artifact-preview-available-width * 0.45);
    private property <length> artifact-preview-main-min-width:
        min(520px, root.artifact-preview-available-width * 0.45);
    private property <length> artifact-preview-panel-max-width: max(
        root.artifact-preview-panel-min-width,
        min(
            760px,
            root.artifact-preview-available-width
                - (root.artifact-preview-panel-overlays
                    ? 96px
                    : root.artifact-preview-main-min-width)
        )
    );
    // Zero selects the responsive default. Once dragged, preserve the session
    // preference and clamp only the rendered width as the window changes.
    private property <length> artifact-preview-panel-preferred-width: 0px;
    private property <bool> artifact-preview-panel-resizing: false;
    out property <bool> artifact-preview-panel-transitioning: false;
    out property <bool> artifact-preview-divider-resizing:
        root.artifact-preview-panel-resizing;
    out property <length> artifact-preview-divider-x:
        root.width - root.artifact-preview-visible-width;
    private property <length> artifact-preview-panel-drag-start-width: 0px;
    private property <length> artifact-preview-panel-auto-width: min(
        root.artifact-preview-panel-max-width,
        max(360px, root.artifact-preview-available-width * 0.46)
    );
    private property <length> artifact-preview-panel-width:
        root.artifact-preview-panel-preferred-width > 0px
            ? max(
                root.artifact-preview-panel-min-width,
                min(
                    root.artifact-preview-panel-max-width,
                    root.artifact-preview-panel-preferred-width
                )
            )
            : root.artifact-preview-panel-auto-width;
    // Keep one scalar as the source of truth for both panes. The preview clips
    // toward the right edge while the route reclaims exactly the same width.
    private property <float> artifact-preview-panel-progress:
        root.artifact-preview-docked-visible ? 1.0 : 0.0;
    animate artifact-preview-panel-progress {
        duration: 260ms;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    private property <length> artifact-preview-visible-width:
        root.artifact-preview-panel-width * root.artifact-preview-panel-progress;
    private property <length> artifact-preview-reserved-width:
        !root.artifact-preview-panel-overlays
            ? root.artifact-preview-visible-width
            : 0px;

    changed artifact-preview-docked-visible => {
        root.artifact-preview-panel-transitioning = true;
        artifact-preview-transition-timer.restart();
    }

    artifact-preview-transition-timer := Timer {
        interval: 280ms;
        running: root.artifact-preview-panel-transitioning;
        triggered => {
            root.artifact-preview-panel-transitioning = false;
        }
    }
    // Keep the large PR Review tree mounted at the window origin, but translate
    // its ordinary content with the same shell motion as the sidebar and title
    // bar. Its layout width follows the shell's one-shot width policy so the
    // diff tree does not reflow on every animation frame.
    private property <length> pr-content-x:
        GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
    private property <length> pr-content-width: root.sidebar-content-width;
    private property <bool> docked-sidebar-column-visible:
        root.sidebar-layout-progress > 0.001 || root.sidebar-motion-running;
    private property <length> pr-readiness-anchor-x: 0px;
    private property <length> pr-readiness-anchor-y: 0px;
    private property <length> pr-readiness-anchor-width: 0px;
    private property <length> pr-readiness-anchor-height: 0px;
    private property <bool> pr-review-dialog-visible:
        root.current-route == Route.PrReview
            && (root.workflow-pr-review-dialog-open
                || root.workflow-pr-dismiss-review-dialog-open
                || root.workflow-pr-merge-dialog-open
                || root.workflow-pr-revert-dialog-open
                || root.workflow-pr-commit-range-dialog-open);
    out property <bool> modal-overlay-visible:
        ProjectBridge.show-add-modal
            || (root.current-route == Route.Settings && root.settings-hook-dialog-open)
            || root.pr-review-dialog-visible
            || (DialogManager.visible && DialogManager.overlay)
            || UpdateLogic.is-downloading
            || (ToastManager.visible && ToastManager.overlay);

    // 导航信号（方便 Rust 端调用）
    callback navigate(Route);
    callback navigate-back();
    // Feature controllers call this after consuming any page-local Back state.
    callback router-back();
    callback navigate-forward();
    callback navigate-from-nav-index(int);
    // Startup restores the persisted state before the first frame without
    // treating it as an interactive toggle.
    callback restore-navigation-drawer-state(bool);
    callback toggle-navigation-drawer();
    callback navigation-drawer-motion-settled(bool);
    pure callback advance-sidebar-motion(float, float, float, float) -> SidebarMotionStep;
    callback modal-overlay-visibility-changed(bool);
    callback dismiss-transient-overlays();
    callback dismiss-transient-popovers();
    // Backend bridges report a post-target window click without knowing which
    // reusable surface is mounted. The composition root owns region routing.
    callback post-dispatch-pointer-pressed(length, length);
    callback post-dispatch-pointer-released(length, length);
    // One root-window key boundary. Rust owns normalization, scope, conflict
    // detection, command lookup, and dispatch for application shortcuts.
    callback app-shortcut-key-pressed(string, bool, bool, bool, bool) -> bool;
    callback settings-hook-dialog-key-pressed(string, bool, bool, bool, bool) -> bool;

    // 更新相关回调
    callback install();
    callback show-error();
    callback check-update();
    callback cancel-download();
    
    // Docked state is persisted. A collapsed sidebar can still open as a
    // temporary overlay from the left-edge hover target.
    in-out property <bool> navigation-drawer-expanded: false;

    // Update Checker
    callback show-update-dialog(latest-version: string, current-version: string);
    
    // Debug: simulate crash
    callback simulate-crash();
    callback open-log-directory();
    callback export-diagnostics();

    // Chat 相关属性和回调
    in property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-input-text: "";
    in-out property <bool> chat-ai-mode: true;
    in property <string> chat-ai-model-name: "";
    in property <bool> chat-is-sending: false;
    in-out property <int> chat-request-elapsed-seconds: 0;
    // Same-binary A/B switch. Production defaults to the optimized path; Rust
    // selects the legacy baseline only for controlled performance runs.
    in property <bool> chat-performance-optimized: true;
    // Production keeps prepared Preview content at one layout width during a
    // divider/native resize. The legacy path is benchmark-only.
    in property <bool> artifact-preview-performance-optimized: true;
    in property <bool> chat-can-load-more-history: false;
    in property <bool> chat-loading-history: false;
    in property <bool> chat-history-load-failed: false;
    // Route-scoped message delegates are rebuilt after Chat becomes visible.
    // Keep this distinct from loading an older pagination page.
    in property <bool> chat-history-restoring: false;
    in-out property <length> chat-bottom-distance: 0px;
    in-out property <length> chat-message-viewport-height: 0px;
    in property <length> chat-virtual-top-spacer: 0px;
    in property <length> chat-virtual-bottom-spacer: 0px;
    in property <length> chat-virtual-document-height: 0px;
    in-out property <length> chat-scroll-position: 0px;
    in-out property <bool> chat-scrollbar-dragging: false;
    in-out property <length> chat-scrollbar-drag-pointer-y: 0px;
    in-out property <length> chat-scrollbar-drag-thumb-y: 0px;
    in-out property <int> chat-scrollbar-drag-release-revision: 0;
    in-out property <length> chat-scrollbar-drag-release-position: 0px;
    in-out property <int> chat-wheel-input-revision: 0;
    in-out property <length> chat-wheel-input-delta: 0px;
    in-out property <int> chat-scroll-to-bottom-revision: 0;
    in-out property <int> chat-loading-phase: 0;
    callback chat-send-message(string);
    callback chat-switch-mode(bool);
    callback chat-load-more-history();
    callback chat-user-scroll-started();
    callback chat-open-artifact(string, string, string);
    callback chat-scroll-position-changed(length);
    callback chat-scrollbar-dragging-changed(bool);
    // Development playground fixtures use the same application Preview facade
    // as production callers; default builds mount no trigger for this callback.
    callback open-artifact-preview-fixture(string);
    callback chat-message-geometry(int, length, length, bool);
    callback chat-layout-metrics-changed(length, length);
    pure callback chat-resolve-text-hit(string, float, float, float, float, string, float) -> int;
    pure callback chat-resolve-selection-rects(string, int, int, float, float, string, float) -> [ChatSelectionRect];
    callback chat-copy-selection(string, int, int) -> bool;
    callback chat-route-visible-changed(bool);

    // Optional AI Code Review. The task engine owns durable/background state;
    // these values are only the route-scoped presentation projection.
    in property <[AiReviewTaskItem]> ai-review-tasks: [];
    in-out property <string> ai-review-current-task-id: "";
    in property <string> ai-review-project-name: "";
    in property <string> ai-review-pull-request-number: "";
    in property <string> ai-review-pull-request-title: "";
    in property <string> ai-review-rule-names: "";
    in property <string> ai-review-model-name: "";
    in property <string> ai-review-status: "";
    in property <int> ai-review-progress-percent: 0;
    in property <int> ai-review-completed-chunks: 0;
    in property <int> ai-review-total-chunks: 0;
    in-out property <int> ai-review-elapsed-seconds: 0;
    in property <string> ai-review-summary: "";
    in property <string> ai-review-error: "";
    in property <[AiReviewFindingItem]> ai-review-findings: [];
    in-out property <string> ai-review-selected-finding-id: "";
    in-out property <string> ai-review-finding-navigation-message: "";
    in-out property <bool> ai-review-finding-navigation-can-view-file: false;
    in property <[AiReviewConversationItem]> ai-review-conversation: [];
    in property <[AiReviewResponseVisualRow]> ai-review-response-rows: [];
    // Step-3 same-binary A/B candidate. Keep false until the Release memory and
    // interaction gates accept the virtualized response list.
    in property <bool> ai-review-response-virtualized: false;
    in-out property <int> ai-review-retained-created-message-rows: 0;
    in-out property <int> ai-review-retained-created-blocks: 0;
    in-out property <int> ai-review-virtual-created-rows: 0;
    in-out property <int> ai-review-virtual-created-message-rows: 0;
    in-out property <int> ai-review-virtual-created-blocks: 0;
    in-out property <string> ai-review-message-input: "";
    in-out property <string> ai-review-extra-requirements: "";
    in-out property <bool> ai-review-chat-sending: false;
    in-out property <string> ai-review-chat-status: "";
    in-out property <int> ai-review-chat-elapsed-seconds: 0;
    in-out property <bool> ai-review-panel-visible: false;
    // Benchmark-only lifecycle candidate. Production keeps the prior retained
    // response tree because unmount/remount did not pass the RSS acceptance gate.
    in property <bool> ai-review-docked-content-unmount: false;
    in-out property <length> ai-review-response-scroll-y: 0px;
    private property <length> ai-review-panel-min-width: 360px;
    private property <length> ai-review-main-min-width: GitHubMetrics.overlay-width-medium;
    private property <length> ai-review-panel-max-width: max(
        root.ai-review-panel-min-width,
        min(
            GitHubMetrics.overlay-width-xlarge,
            root.pr-content-width - root.ai-review-main-min-width
        )
    );
    // Zero selects the responsive default. A drag stores only a session
    // preference; window changes clamp the rendered value without destroying it.
    private property <length> ai-review-panel-preferred-width: 0px;
    private property <bool> ai-review-panel-resizing: false;
    private property <length> ai-review-panel-drag-start-width: 0px;
    private property <length> ai-review-panel-auto-width: min(
        root.ai-review-panel-max-width,
        max(root.ai-review-panel-min-width, root.width * 0.34)
    );
    private property <length> ai-review-panel-width:
        root.ai-review-panel-preferred-width > 0px
            ? max(
                root.ai-review-panel-min-width,
                min(
                    root.ai-review-panel-max-width,
                    root.ai-review-panel-preferred-width
                )
            )
            : root.ai-review-panel-auto-width;
    // The PR workspace and its contextual trailing surfaces share these
    // width/visibility contracts. Keeping them observable makes resize and
    // host-switch behavior verifiable without exposing internal components.
    out property <bool> ai-review-content-visible:
        root.current-route == Route.PrReview
            && root.ai-review-panel-visible
            && !root.artifact-preview-pr-side-docked-visible;
    out property <bool> ai-review-response-delegates-mounted:
        root.current-route == Route.PrReview
            && root.ai-review-panel-visible
            && (root.ai-review-content-visible || !root.ai-review-docked-content-unmount);
    out property <length> pr-review-trailing-surface-width:
        root.current-route == Route.PrReview && root.ai-review-panel-visible
            ? root.ai-review-panel-width
            : 0px;
    out property <length> pr-review-main-content-width: max(
        0px,
        root.pr-content-width - root.pr-review-trailing-surface-width
    );
    out property <length> ai-review-content-x:
        root.width - root.pr-review-trailing-surface-width;
    out property <length> ai-review-content-y: root.native-titlebar-inset;
    out property <length> ai-review-content-width: root.pr-review-trailing-surface-width;
    private property <length> pr-review-content-height: max(
        0px,
        root.height - root.native-titlebar-inset - LayoutConstants.status-bar-height
    );
    out property <length> ai-review-content-height: root.pr-review-content-height;
    in property <[AiReviewRuleChoice]> ai-review-rule-options: [];
    in property <string> ai-review-project-rule-id: "";
    in property <string> ai-review-project-rule-name: "";
