import { 
    FilledCard, AppBar, NavigationDrawer, Horizontal, Vertical, MaterialText, IconButton, 
    MaterialPalette, MaterialStyleMetrics, CircularProgressIndicator, Modal, TextButton, 
    FilledButton, HorizontalDivider } from "@material";
import { ScrollView } from "../material-1.0-fixed/ui/components/scroll_view.slint";
import { Login as LoginPage } from "./views/login.slint";
import { Home as HomePage } from "./views/home.slint";
import { Search as SearchPage } from "./views/search.slint";
import { Settings as SettingsPage } from "./views/settings.slint";
import { About as AboutPage } from "./views/about.slint";
import { List as ListPage } from "./views/list.slint";
import { Detail as DetailPage } from "./views/detail.slint";
import { Notification as NotificationPage } from "./views/notification.slint";
import { Toast as ToastPage } from "./views/toast.slint";
import { Dialog as DialogPage } from "./views/dialog.slint";
import { Route } from "./route/routeMap.slint";
import { AppState } from "./state/app_state.slint";
import { Breadcrumb } from "views/breadcrumb.slint";
import { NotificationManager, Notification, NotificationType } from "./components/notify/notification.slint";
import { NotificationIcons } from "./components/notify/icons.slint";
import { NotificationItem } from "./components/notify/notification_item.slint";
import { Toast } from "./components/toast/toast.slint";
import { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
import { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
import { DialogEnhance } from "./components/dialog/dialog_enhance.slint";
import { UpdateDialog, UpdateLogic, DownloadProgressModal } from "./components/update/update.slint";
import { StatusBar } from "./components/status_bar.slint";
import { LayoutConstants } from "./layout_constants.slint";

export { MaterialWindowAdapter } from "@material";
export { AppState } from "./state/app_state.slint";
export { NotificationManager, Notification, NotificationType } from "./components/notify/notification.slint";
export { NotificationIcons } from "./components/notify/icons.slint";
export { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
export { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
export { UpdateLogic } from "./components/update/update.slint";

// import "./assets/fonts/Noto_Sans_SC/static/NotoSansSC-Regular.ttf";

export component MainWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    title: "Usher";
    // default-font-family: "Noto Sans SC";

    // 路由状态 - 对外暴露
    in-out property <Route> current-route: Route.Home;
    
    // 上一个路由，用于返回功能
    private property <Route> previous-route: Route.Home;

    // 导航信号（方便 Rust 端调用）
    callback navigate(Route);
    
    // 更新相关回调
    callback install();
    callback show-error();
    callback check-update();
    callback cancel-download();
    
    // 导航抽屉展开/收起状态
    in-out property <bool> drawer-expanded: true;

    // Update Checker
    callback show-update-dialog(latest-version: string, current-version: string);

    init => {
        // TODO: delete
        // update-dialog.show();
    }
    
    show-update-dialog(latest-version, current-version) => {
        debug("MainWindow: show-update-dialog 回调被调用, latest-version={}, current-version={}", latest-version, current-version);

        DialogManager.show({
            id: "update-dialog",
            title: "Update Available",
            content: "A new version (" + latest-version + ") is available. Current version: " + current-version + ". Please update to the latest version.",
            actions: ["Cancel"],
            default-action: "Update",
            overlay: true,
            modal: true,
            width: "40%",
            height: "50%",
        });

    }

    // 主内容区域（菜单栏 + 右侧内容）- 占据窗口高度减去状态栏
    Horizontal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - LayoutConstants.status-bar-height;
        padding: 0px;
        // background: #00ff00;
        
        Vertical {
            width: root.drawer-expanded ? 150px : 56px;
            height: parent.height;
            padding: 0px;
            
            // 容器：包含 navigation_drawer 和 toggle_button，背景色与 NavigationDrawer 一致
            drawer_container := Rectangle {
                width: parent.width;
                height: parent.height;
                    background: MaterialPalette.surface_container_low;
                    border_radius: MaterialStyleMetrics.border_radius_16;
                    
                    Vertical {
                        width: parent.width;
                        vertical-stretch: 1;
                        padding: 0px;
                        
                        // 滚动视图，用于支持上下滚动
                        scroll_view := ScrollView {
                            width: parent.width;
                            vertical-stretch: 1;
                            horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                            vertical_scrollbar_policy: ScrollBarPolicy.as_needed;
                            
                            // 包装容器，用于减少 NavigationDrawer 的 padding
                            drawer_wrapper := Rectangle {
                                width: scroll_view.visible_width;
                                height: navigation_drawer.height;
                                background: transparent;
                                
                                navigation_drawer := NavigationDrawer {
                                    // 通过负的 x 和 y 偏移来减少视觉上的 padding
                                    x: -MaterialStyleMetrics.padding_12;
                                    y: -MaterialStyleMetrics.padding_12;
                                    width: parent.width + MaterialStyleMetrics.padding_12 * 2;
                                    // height 会根据内容自动调整

                                    groups: [
                                        {
                                            title: root.drawer-expanded ? "Menu" : "",
                                            items: [
                                                { icon: @image-url("./assets/icons/home.svg"), text: root.drawer-expanded ? "Home" : "" },
                                                { icon: @image-url("./assets/icons/search.svg"), text: root.drawer-expanded ? "Search" : "" },
                                                { icon: @image-url("./assets/icons/settings.svg"), text: root.drawer-expanded ? "Settings" : "" },
                                                { icon: @image-url("./assets/icons/settings.svg"), text: root.drawer-expanded ? "Notify" : "" },
                                                { icon: @image-url("./assets/icons/settings.svg"), text: root.drawer-expanded ? "Toast" : "" },
                                                { icon: @image-url("./assets/icons/settings.svg"), text: root.drawer-expanded ? "Dialog" : "" },
                                                { icon: @image-url("./assets/icons/about.svg"), text: root.drawer-expanded ? "About" : "" },
                                                { icon: @image-url("./assets/icons/list.svg"), text: root.drawer-expanded ? "List" : "" },
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail2" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail3" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail4" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail5" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail6" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail7" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail8" : ""},
                                                { icon: @image-url("./assets/icons/detail.svg"), text: root.drawer-expanded ? "Detail9" : ""}
                                            ]
                                        }
                                    ];

                                    selected(group_index, item_index) => {
                                        if group_index == 0 {
                                            // 路由映射数组：将菜单项索引映射到对应的路由
                                            let routes: [Route] = [
                                                Route.Home,
                                                Route.Search,
                                                Route.Settings,
                                                Route.Notification,
                                                Route.Toast,
                                                Route.Dialog,
                                                Route.About,
                                                Route.List,
                                                Route.Detail
                                            ];
                                            
                                            if item_index >= 0 && item_index < routes.length {
                                                let route = routes[item_index];
                                                root.previous-route = root.current-route;
                                                root.current-route = route;
                                                root.navigate(route);
                                            }
                                        }
                                    }
                                }
                            }
                            
                            // 设置 viewport_height 为内容的实际高度
                            viewport_height: drawer_wrapper.height;
                        }
                        
                        // 切换按钮 - 放在底部
                        toggle_button := IconButton {
                            width: parent.width;
                            // height: 40px;
                            icon: root.drawer-expanded ? @image-url("./assets/icons/arrow_left.svg") : @image-url("./assets/icons/arrow_right.svg");
                            // tooltip: root.drawer-expanded ? "Collapse" : "Expand";
                            
                            clicked => {
                                root.drawer-expanded = !root.drawer-expanded;
                            }
                        }
                    }
                }
            }

        Rectangle  {
            horizontal-stretch: 1;
            height: parent.height;

            Vertical {
                width: parent.width;
                height: parent.height;
                padding: 0px;
                
                // Breadcrumb
                Breadcrumb {
                    horizontal-stretch: 1;
                    current-route: root.current-route;
                }

                // Page Views
                page-scroll-view := ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    horizontal_scrollbar_policy: ScrollBarPolicy.as_needed;
                    vertical_scrollbar_policy: ScrollBarPolicy.as_needed;

                    Vertical {
                        width: page-scroll-view.visible_width;
                        spacing: 0px;

                        if root.current-route == Route.Login: LoginPage {
                            previous-route: root.previous-route;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.Home: HomePage {}
                        if root.current-route == Route.Search: SearchPage {}
                        if root.current-route == Route.Settings: SettingsPage {
                            check-update => {
                                root.check-update();
                            }
                        }
                        if root.current-route == Route.Notification: NotificationPage {}
                        if root.current-route == Route.Toast: ToastPage {
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        dialog-page := DialogPage {
                            visible: root.current-route == Route.Dialog;
                        }
                        if root.current-route == Route.About: AboutPage {
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.List: ListPage {}
                        if root.current-route == Route.Detail: DetailPage {}
                    }
                }
            }
        }
    }
    
    // 底部状态栏 - 固定在窗口底部，高度 40px
    StatusBar {
        x: 0;
        y: root.height - LayoutConstants.status-bar-height;
        width: root.width;
        height: LayoutConstants.status-bar-height;
    }
    
    // 通知显示区域 - 固定在右上角，距离右边界 16px
    // 只在有通知时才创建，避免空队列时占用空间和阻挡点击
    if NotificationManager.queue.length > 0: Rectangle {
        x: root.width - 256px;  // 240px (宽度) + 16px (右边距)
        y: 20px;
        width: 240px;
        // 最大可用高度
        private property <length> max-available-height: root.height - 40px;
        // 内容高度（通过隐藏的内容计算器获取）
        private property <length> content-total-height: content-height-calculator.preferred-height;
        // 高度自适应：取内容高度和最大可用高度的较小值
        height: min(content-total-height, max-available-height);
        background: transparent;
        clip: true;  // 裁剪超出部分
        
        // hover 状态跟踪（从消息项的 hover 状态获取）
        private property <bool> any-item-hovered: false;
        // 是否需要滚动（内容超过可视区域）
        private property <bool> needs-scroll: content-total-height > max-available-height;
        
        // 滚动条预留宽度（与 Material ScrollView 内部一致：scroll_bar_size=8px）
        private property <length> scrollbar-width: 8px;
        // 内容固定宽度（始终固定，不受滚动条影响）
        private property <length> content-fixed-width: 240px - scrollbar-width;
        
        // 隐藏的内容高度计算器（不可见，仅用于计算高度）
        content-height-calculator := VerticalLayout {
            x: -10000px;  // 移出可视区域
            width: content-fixed-width;  // 使用相同的固定宽度计算高度
            spacing: 0px;
            
            for notification[index] in NotificationManager.queue : NotificationItem {
                notification: notification;
                index: index;
            }
        }
        
        // 内容区域容器：固定宽度，支持滚动
        Rectangle {
            width: content-fixed-width;
            height: parent.height;
            clip: true;
            background: transparent;
            
            // 使用 Flickable 直接实现滚动，完全控制布局
            notification-flickable := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: true;
                
                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;  // 间距已包含在 NotificationItem 内部
                    
                    for notification[index] in NotificationManager.queue : NotificationItem {
                        notification: notification;
                        index: index;
                        dismissed(id) => {
                            NotificationManager.dismiss-by-id(id);
                        }
                        hovered(id, is-hovered) => {
                            NotificationManager.set-hovered(id, is-hovered);
                            // 当消息项 hover 时，设置容器的 hover 状态
                            any-item-hovered = is-hovered;
                        }
                        action-clicked(notification-id, action-index) => {
                            // 将 action-clicked 事件转发给 NotificationManager
                            NotificationManager.action-clicked(notification-id, action-index);
                        }
                    }
                }
            }
        }
        
        // 自定义滚动条：显示在预留空间内，不影响内容布局（仅视觉指示）
        if needs-scroll: Rectangle {
            x: content-fixed-width + 1px;  // 在内容右侧，padding 1px
            y: 0;
            width: scrollbar-width - 2px;
            height: parent.height;
            background: transparent;
            z: 1;
            
            // 滚动条轨道
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000020;
                opacity: any-item-hovered ? 1 : 0;
                animate opacity { duration: 150ms; }
                border-radius: 4px;
                
                // 滚动条滑块（仅显示当前位置，交互通过 Flickable 处理）
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: max(0px, abs(notification-flickable.viewport-y) * (parent.height - self.height) / max(1px, notification-flickable.viewport-height - notification-flickable.height));
                    width: 4px;
                    height: max(32px, parent.height * notification-flickable.height / max(1px, notification-flickable.viewport-height));
                    background: #00000080;
                    border-radius: 2px;
                    opacity: any-item-hovered ? 1 : 0.5;
                    animate opacity { duration: 150ms; }
                }
            }
        }
    }

    // Toast 显示区域 - 只在有 overlay 时才覆盖整个窗口
    if ToastManager.visible && ToastManager.overlay: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        z: 1000;
        
        Toast {
            message: ToastManager.message;
            type: ToastManager.type == ToastType.Success ? "success" :
                  ToastManager.type == ToastType.Error ? "error" :
                  ToastManager.type == ToastType.Loading ? "loading" : "text";
            position: ToastManager.position;
            icon: ToastManager.icon;
            overlay: ToastManager.overlay;
            close-on-click: ToastManager.close-on-click;
            toast-visible: ToastManager.visible;
            toast-width-str: ToastManager.width;
            toast-width-value: ToastManager.width-value;
            toast-width-percent: ToastManager.width-percent;
            toast-width-is-auto: ToastManager.width-is-auto;
            dismiss() => {
                ToastManager.dismiss();
            }
        }
    }
    
    // 当没有 overlay 时，Toast 内容区域直接定位，不覆盖整个窗口
    if ToastManager.visible && !ToastManager.overlay: Rectangle {
        width: ToastManager.width-is-auto ? 
            max(200px, min(root.width * 0.8, 400px)) : // auto模式：使用内容宽度，但限制在200px-80%之间
            (ToastManager.width-value > 0px ? ToastManager.width-value : 
             (ToastManager.width-percent > 0 ? root.width * ToastManager.width-percent / 100 : root.width * 0.2));
        height: content-container-height.preferred-height;
        x: root.width / 2 - self.width / 2;
        y: ToastManager.position == "top" ? 32px :
           ToastManager.position == "bottom" ? root.height - self.height - 32px :
           root.height / 2 - self.height / 2;
        z: 1000;
        background: ToastManager.type == ToastType.Success ? #4CAF50 :
                    ToastManager.type == ToastType.Error ? #F44336 :
                    ToastManager.type == ToastType.Loading ? MaterialPalette.primary_container :
                    MaterialPalette.surface_container_highest;
        border-radius: 12px;
        
        content-container-height := Horizontal {
            spacing: 16px;
            padding: 16px;
            width: 100%;
            min-height: 64px;
            
            if ToastManager.type == ToastType.Loading: CircularProgressIndicator {
                width: 24px;
                height: 24px;
                indeterminate: true;
                progress: 0;
            }
            
            MaterialText {
                text: ToastManager.message;
                color: ToastManager.type == ToastType.Success ? #ffffff :
                       ToastManager.type == ToastType.Error ? #ffffff :
                       MaterialPalette.on_surface;
                vertical-alignment: center;
                wrap: word-wrap;
                width: parent.width - (ToastManager.type == ToastType.Loading ? 40px : 0px) - 32px; // 减去loading图标宽度和padding
            }
        }
        
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { if ToastManager.close-on-click { ToastManager.dismiss(); } }
        }
    }

    // Dialog 组件（从 dialog_enhance.slint 导入）
    DialogEnhance {
        width: 100%;
        height: 100%;
        on-default-action-clicked(id) => {
            debug("DialogEnhance: on-default-action-clicked, id={}", id);
            // 所有的 default-action 处理都交给 Rust 端通过 DialogManager 回调处理
            dialog-page.default-action-clicked(id);
        }
        on-action-clicked(id, index) => {
            debug("DialogEnhance: on-action-clicked, id={}, index={}", id, index);
            // 所有的 action 处理都交给 Rust 端通过 DialogManager 回调处理
            dialog-page.action-clicked(id, index);
        }
    }
    
    // 下载进度模态框
    DownloadProgressModal {
        width: 100%;
        height: 100%;
        cancel-clicked => {
            root.cancel-download();
        }
    }
    
}
