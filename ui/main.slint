import { 
    FilledCard, AppBar, Horizontal, Vertical, MaterialText, IconButton, 
    MaterialPalette, MaterialStyleMetrics, CircularProgressIndicator, Modal, TextButton, 
    FilledButton, HorizontalDivider } from "@material";
import { CustomNavDrawer, NavItem } from "./components/navigation/custom_nav_drawer.slint";
import { ScrollView } from "../material-1.0-fixed/ui/components/scroll_view.slint";
import { Login as LoginPage } from "./views/login.slint";
import { Home as HomePage } from "./views/home.slint";
import { Search as SearchPage } from "./views/search.slint";
import { Settings as SettingsPage } from "./views/settings.slint";
import { About as AboutPage } from "./views/about.slint";
import { Workflow as WorkflowPage } from "./views/workflow/workflow.slint";
import { StepItem } from "./components/workflow/steps.slint";

import { List as ListPage } from "./views/list.slint";
import { Detail as DetailPage } from "./views/detail.slint";
import { Project as ProjectPage, ProjectItem, ProjectAddModal } from "./views/project.slint";
import { Tools as ToolsPage } from "./views/tools.slint";
import { Chat as ChatPage, ChatMessage, MessageRole } from "./views/chat.slint";
import { Notification as NotificationPage } from "./views/notification.slint";
import { Toast as ToastPage } from "./views/toast.slint";
import { Dialog as DialogPage } from "./views/dialog.slint";
import { Route } from "./route/routeMap.slint";
import { AppState } from "./state/app_state.slint";
import { DebugLogger } from "./state/debug_logger.slint";
import { Breadcrumb } from "views/breadcrumb.slint";
import { NotificationManager, Notification, NotificationType } from "./components/notify/notification.slint";
import { NotificationIcons } from "./components/notify/icons.slint";
import { NotificationItem } from "./components/notify/notification_item.slint";
import { Toast } from "./components/toast/toast.slint";
import { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
import { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
import { DialogEnhance } from "./components/dialog/dialog_enhance.slint";
import { UpdateDialog, UpdateLogic, DownloadProgressModal } from "./components/update/update.slint";
import { StatusBar } from "./components/status_bar.slint";
import { LayoutConstants } from "./layout_constants.slint";

export { MaterialWindowAdapter } from "@material";
export { AppState } from "./state/app_state.slint";
export { DebugLogger } from "./state/debug_logger.slint";
export { NotificationManager, Notification, NotificationType } from "./components/notify/notification.slint";
export { NotificationIcons } from "./components/notify/icons.slint";
export { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
export { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
export { UpdateLogic } from "./components/update/update.slint";
export { ChatMessage, MessageRole } from "./views/chat.slint";
export { StepItem } from "./components/workflow/steps.slint";

// import "./assets/fonts/Noto_Sans_SC/static/NotoSansSC-Regular.ttf";

export component MainWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    title: "Usher";
    out property <length> chat-layout-window-width: self.width;
    out property <length> chat-layout-window-height: self.height;
    // default-font-family: "Noto Sans SC";

    // 路由状态 - 对外暴露
    in-out property <Route> current-route: Route.Home;
    // Breadcrumb 显示控制（由路由策略统一计算）
    in-out property <bool> show-breadcrumb: true;
    // 导航抽屉显示控制（由路由策略统一计算）
    in-out property <bool> show-navigation-drawer: true;
    // 导航抽屉当前选中项（由路由策略统一计算）
    in-out property <int> navigation-current-index: 0;
    // 页面可见性控制（由路由策略统一计算）
    in-out property <bool> show-page-scroll-view: true;
    in-out property <bool> show-chat-page: false;
    in-out property <bool> show-dialog-page: false;
    
    // 上一个路由，用于返回功能
    private property <Route> previous-route: Route.Home;

    // 导航信号（方便 Rust 端调用）
    callback navigate(Route);
    callback navigate-from-nav-index(int);

    // 更新相关回调
    callback install();
    callback show-error();
    callback check-update();
    callback cancel-download();
    
    // 导航抽屉展开/收起状态
    in-out property <bool> navigation-drawer-expanded: true;
    
    // 抽屉展开/收起状态变化回调（用于保存设置）
    callback toggle-navigation-drawer-expanded(bool);

    // Update Checker
    callback show-update-dialog(latest-version: string, current-version: string);
    
    // Debug: simulate crash
    callback simulate-crash();

    // Chat 相关属性和回调
    in property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-input-text: "";
    in property <bool> chat-is-sending: false;
    in property <bool> chat-can-load-more-history: false;
    in property <bool> chat-loading-history: false;
    in property <length> chat-virtual-top-spacer: 0px;
    in property <length> chat-virtual-bottom-spacer: 0px;
    in-out property <length> chat-scroll-position: 0px;
    in-out property <int> chat-copied-message-index: -1;
    in-out property <int> chat-loading-phase: 0;
    callback chat-send-message(string);
    callback chat-load-more-history();
    callback chat-copy-to-clipboard(int, string);
    callback chat-open-link(string);
    callback chat-route-visible-changed(bool);

    // Workflow state and callbacks
    in property <string> workflow-branch-result: "Ready to recreate branches.";
    in property <string> workflow-tag-result: "Ready to add or remove a tag.";
    in-out property <string> workflow-tag-mode: "local";
    in-out property <string> workflow-tag-version-mode: "patch";
    in property <string> workflow-tag-current-version: "v0.0.0";
    in-out property <string> workflow-tag-next-version: "v0.0.1";
    in-out property <string> workflow-tag-remove-target: "";
    in property <bool> workflow-tag-add-initializing: false;
    in property <bool> workflow-tag-remove-initializing: false;
    in property <bool> workflow-tag-running: false;
    in property <bool> workflow-tag-loading-animated: true;
    in property <[StepItem]> workflow-tag-steps: [];
    in property <string> workflow-project-id: "default";
    in property <string> workflow-project-name: "Default Project";
    in property <string> workflow-project-alias: "";
    in property <string> workflow-project-local-repo: "";
    in property <string> workflow-project-remote-repo: "";
    in property <string> workflow-project-logo: "";
    in property <image> workflow-project-logo-image: @image-url("../logo.png");
    in property <[ProjectItem]> project-items: [];
    in-out property <bool> project-show-add-modal: false;
    in-out property <string> project-new-name: "";
    in-out property <string> project-new-alias: "";
    in-out property <string> project-new-local-repo: "";
    in-out property <string> project-new-remote-repo: "";
    in-out property <string> project-new-logo: "";
    in-out property <string> project-new-tags: "";
    in property <image> project-logo-preview-image: @image-url("../logo.png");
    in property <string> project-logo-preview-status: "Using app default logo";
    in-out property <string> project-add-error: "";
    in-out property <string> project-modal-mode: "add";
    in-out property <string> project-modal-original-alias: "";
    in-out property <string> project-search-query: "";
    in property <bool> platform-is-macos: false;
    in property <string> workflow-pr-ai-decision: "Awaiting analysis";
    in property <string> workflow-pr-ai-summary: "Run AI analysis to get a recommendation.";
    in property <string> workflow-pr-manual-status: "Waiting for human confirmation.";
    in property <bool> workflow-cd-running: false;
    in property <string> workflow-cd-summary: "No deployment started.";
    in property <string> workflow-cd-build-status: "pending";
    in property <string> workflow-cd-build-detail: "Waiting to start.";
    in property <string> workflow-cd-test-status: "pending";
    in property <string> workflow-cd-test-detail: "Waiting to start.";
    in property <string> workflow-cd-deploy-status: "pending";
    in property <string> workflow-cd-deploy-detail: "Waiting to start.";
    in property <string> workflow-cd-verify-status: "pending";
    in property <string> workflow-cd-verify-detail: "Waiting to start.";
    callback workflow-branch-submit(string, string, bool);
    callback workflow-tag-change-mode(string);
    callback workflow-tag-select-version-mode(string);
    callback workflow-tag-run(string, string);
    callback workflow-tag-remove(string);
    callback workflow-tag-open-add();
    callback workflow-tag-open-remove();
    callback workflow-tag-stop();
    callback workflow-pr-analyze(string, string, string, bool, bool);
    callback workflow-pr-confirm(bool);
    callback workflow-cd-start(string, string, string);
    callback workflow-cd-rollback(string);
    callback workflow-open-project(string, string, string, string, string, image);
    callback project-add-project(string, string, string, string, string, string);
    callback project-preview-logo(string);
    callback project-update-project(string, string, string, string, string, string, string);
    callback project-delete-project(string);
    callback project-search-projects(string);
    callback project-reload-projects();

    init => {
        // TODO: delete
        // update-dialog.show();
    }
    
    show-update-dialog(latest-version, current-version) => {
        debug("MainWindow: show-update-dialog 回调被调用, latest-version={}, current-version={}", latest-version, current-version);

        DialogManager.show({
            id: "update-dialog",
            title: "Update Available",
            content: "A new version (" + latest-version + ") is available. Current version: " + current-version + ". Please update to the latest version.",
            actions: ["Cancel"],
            default-action: "Update",
            overlay: true,
            modal: true,
            width: "40%",
            height: "50%",
        });

    }

    // 主内容区域（菜单栏 + 右侧内容）- 使用原生标题栏，只减去状态栏高度
    Horizontal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height - LayoutConstants.status-bar-height;
        padding: 0px;
        
        if root.show-navigation-drawer: Vertical {
            width: root.navigation-drawer-expanded ? 120px : 56px;
            height: parent.height;
            padding: 0px;
            
            // 容器：包含 navigation_drawer 和 toggle_button，背景色与 NavigationDrawer 一致
            drawer_container := Rectangle {
                width: parent.width;
                height: parent.height;
                background: MaterialPalette.background;
                    
                    Vertical {
                        width: parent.width;
                        vertical-stretch: 1;
                        padding: 0px;
                        
                        // 滚动视图，用于支持上下滚动
                        scroll_view := ScrollView {
                            width: parent.width;
                            vertical-stretch: 1;
                            horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                            vertical_scrollbar_policy: ScrollBarPolicy.as_needed;
                            
                            // 使用自定义导航组件（无标题，较小的菜单项高度）
                            custom_nav := CustomNavDrawer {
                                width: scroll_view.visible_width;
                                
                                // 当前菜单选中索引由路由策略统一计算
                                current_index: root.navigation-current-index;
                                
                                items: [
                                    //  { icon: @image-url("./assets/icons/home.svg"), text: root.navigation-drawer-expanded ? "Home" : "" },
                                    // { icon: @image-url("./assets/icons/search.svg"), text: root.navigation-drawer-expanded ? "Search" : "" },
                                    //  { icon: @image-url("./assets/icons/settings.svg"), text: root.navigation-drawer-expanded ? "Notify" : "" },
                                    //  { icon: @image-url("./assets/icons/settings.svg"), text: root.navigation-drawer-expanded ? "Toast" : "" },
                                    //  { icon: @image-url("./assets/icons/settings.svg"), text: root.navigation-drawer-expanded ? "Dialog" : "" },
                                    //  { icon: @image-url("./assets/icons/tools.svg"), text: root.navigation-drawer-expanded ? "Tools" : ""},
                                    { icon: @image-url("./assets/icons/chat.svg"), text: root.navigation-drawer-expanded ? "Chat" : ""},
                                    { icon: @image-url("./assets/icons/project.svg"), text: root.navigation-drawer-expanded ? "Project" : ""},
                                    // { icon: @image-url("./assets/icons/commit.svg"), text: root.navigation-drawer-expanded ? "Workflow" : ""},
                                    // { icon: @image-url("./assets/icons/list.svg"), text: root.navigation-drawer-expanded ? "List" : "" },
                                    // { icon: @image-url("./assets/icons/detail.svg"), text: root.navigation-drawer-expanded ? "Detail" : ""},
//                                    { icon: @image-url("./assets/icons/settings.svg"), text: root.navigation-drawer-expanded ? "Settings" : ""},
//                                    { icon: @image-url("./assets/icons/about.svg"), text: root.navigation-drawer-expanded ? "About" : ""},
                                ];

                                selected(item_index) => {
                                    if item_index >= 0 {
                                        root.previous-route = root.current-route;
                                        root.navigate-from-nav-index(item_index);
                                    }
                                }
                            }
                            
                            // 设置 viewport_height 为内容的实际高度
                            viewport_height: custom_nav.height;
                        }
                        
                        // 切换按钮 - 放在底部
                        toggle_button := IconButton {
                            width: parent.width;
                            // height: 40px;
                            icon: root.navigation-drawer-expanded ? @image-url("./assets/icons/arrow_left.svg") : @image-url("./assets/icons/arrow_right.svg");
                            // tooltip: root.navigation-drawer-expanded ? "Collapse" : "Expand";
                            
                            clicked => {
                                root.navigation-drawer-expanded = !root.navigation-drawer-expanded;
                                root.toggle-navigation-drawer-expanded(root.navigation-drawer-expanded);
                            }
                        }
                    }
                }
            }

        Rectangle  {
            horizontal-stretch: 1;
            height: parent.height;

            content := Vertical {
                width: parent.width;
                height: parent.height;
                padding: 0px;
                
                // Breadcrumb (hidden for configured routes)
                if root.show-breadcrumb: Breadcrumb {
                    horizontal-stretch: 1;
                    current-route: root.current-route;
                    navigate(route) => {
                        root.previous-route = root.current-route;
                        root.navigate(route);
                    }
                }

                // Page Views
                page-scroll-view := ScrollView {
                    visible: root.show-page-scroll-view;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    horizontal_scrollbar_policy: ScrollBarPolicy.as_needed;
                    vertical_scrollbar_policy: ScrollBarPolicy.as_needed;

                    Vertical {
                        width: page-scroll-view.visible_width;
                        spacing: 0px;
                        alignment: start;
                        padding-left: MaterialStyleMetrics.padding_4;
                        padding-right: MaterialStyleMetrics.padding_4;
                        padding-top: 0;
                        padding-bottom: 1px;

                        if root.current-route == Route.Login: LoginPage {
                            previous-route: root.previous-route;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.Home: HomePage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                        }
                        if root.current-route == Route.Search: SearchPage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                        }
                        if root.current-route == Route.Settings: SettingsPage {
                            check-update => {
                                root.check-update();
                            }
                            simulate-crash => {
                                root.simulate-crash();
                            }
                        }
                        if root.current-route == Route.Notification: NotificationPage {}
                        if root.current-route == Route.Toast: ToastPage {
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.About: AboutPage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                        if root.current-route == Route.Workflow: WorkflowPage {
                            viewport-height: page-scroll-view.visible-height - 2px;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                            branch-result: root.workflow-branch-result;
                            tag-result: root.workflow-tag-result;
                            tag-mode <=> root.workflow-tag-mode;
                            tag-version-mode <=> root.workflow-tag-version-mode;
                            tag-current-version: root.workflow-tag-current-version;
                            tag-next-version <=> root.workflow-tag-next-version;
                            tag-remove-target <=> root.workflow-tag-remove-target;
                            tag-add-initializing: root.workflow-tag-add-initializing;
                            tag-remove-initializing: root.workflow-tag-remove-initializing;
                            tag-running: root.workflow-tag-running;
                            tag-loading-animated: root.workflow-tag-loading-animated;
                            tag-steps: root.workflow-tag-steps;
                            project-id: root.workflow-project-id;
                            project-name: root.workflow-project-name;
                            project-alias: root.workflow-project-alias;
                            project-local-repo: root.workflow-project-local-repo;
                            project-remote-repo: root.workflow-project-remote-repo;
                            project-logo: root.workflow-project-logo;
                            project-logo-image: root.workflow-project-logo-image;
                            pr-ai-decision: root.workflow-pr-ai-decision;
                            pr-ai-summary: root.workflow-pr-ai-summary;
                            pr-manual-status: root.workflow-pr-manual-status;
                            cd-running: root.workflow-cd-running;
                            cd-summary: root.workflow-cd-summary;
                            cd-build-status: root.workflow-cd-build-status;
                            cd-build-detail: root.workflow-cd-build-detail;
                            cd-test-status: root.workflow-cd-test-status;
                            cd-test-detail: root.workflow-cd-test-detail;
                            cd-deploy-status: root.workflow-cd-deploy-status;
                            cd-deploy-detail: root.workflow-cd-deploy-detail;
                            cd-verify-status: root.workflow-cd-verify-status;
                            cd-verify-detail: root.workflow-cd-verify-detail;
                            branch-submit(source, target, recreate-remote) => {
                                root.workflow-branch-submit(source, target, recreate-remote);
                            }
                            tag-change-mode(mode) => {
                                root.workflow-tag-change-mode(mode);
                            }
                            tag-select-version-mode(mode) => {
                                root.workflow-tag-select-version-mode(mode);
                            }
                            tag-run(version, description) => {
                                root.workflow-tag-run(version, description);
                            }
                            tag-remove(tag) => {
                                root.workflow-tag-remove(tag);
                            }
                            tag-open-add => {
                                root.workflow-tag-open-add();
                            }
                            tag-open-remove => {
                                root.workflow-tag-open-remove();
                            }
                            tag-stop => {
                                root.workflow-tag-stop();
                            }
                            pr-analyze(pr-number, pr-title, pr-summary, ci-green, reviewers-ready) => {
                                root.workflow-pr-analyze(pr-number, pr-title, pr-summary, ci-green, reviewers-ready);
                            }
                            pr-confirm(approved) => {
                                root.workflow-pr-confirm(approved);
                            }
                            cd-start(environment-name, release-name, commit-hash) => {
                                root.workflow-cd-start(environment-name, release-name, commit-hash);
                            }
                            cd-rollback(commit-hash) => {
                                root.workflow-cd-rollback(commit-hash);
                            }
                        }
                        if root.current-route == Route.List: ListPage {}
                        if root.current-route == Route.Detail: DetailPage {}
                        if root.current-route == Route.Project: ProjectPage {
                            viewport-height: page-scroll-view.visible-height;
                            viewport-width: page-scroll-view.visible-width;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                            projects: root.project-items;
                            search-query <=> root.project-search-query;
                            show-add-modal <=> root.project-show-add-modal;
                            new-project-name <=> root.project-new-name;
                            new-project-alias <=> root.project-new-alias;
                            new-project-local-repo <=> root.project-new-local-repo;
                            new-project-remote-repo <=> root.project-new-remote-repo;
                            new-project-logo <=> root.project-new-logo;
                            new-project-tags <=> root.project-new-tags;
                            logo-preview-image: root.project-logo-preview-image;
                            logo-preview-status: root.project-logo-preview-status;
                            add-error <=> root.project-add-error;
                            modal-mode <=> root.project-modal-mode;
                            modal-original-alias <=> root.project-modal-original-alias;
                            open-project(project-name, project-alias, local-repo, remote-repo, logo, logo-image) => {
                                root.workflow-open-project(project-name, project-alias, local-repo, remote-repo, logo, logo-image);
                            }
                            add-project(project-name, project-alias, local-repo, remote-repo, logo, project-tags) => {
                                root.project-add-project(project-name, project-alias, local-repo, remote-repo, logo, project-tags);
                            }
                            preview-logo(logo) => {
                                root.project-preview-logo(logo);
                            }
                            search-projects(query) => {
                                root.project-search-projects(query);
                            }
                            reload-projects() => {
                                root.project-reload-projects();
                            }
                        }
                        if root.current-route == Route.Tools: ToolsPage {
                            viewport-height: page-scroll-view.visible-height;
                            navigate(route) => {
                                root.previous-route = root.current-route;
                                root.navigate(route);
                            }
                        }
                    }
                }

            }

            // Chat 页面 - 放在 ScrollView 外面，因为它有自己的滚动和固定底部输入框
            chat-page := ChatPage {
                visible: root.show-chat-page;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                messages: root.chat-messages;
                input-text <=> root.chat-input-text;
                is-sending: root.chat-is-sending;
                can-load-more-history: root.chat-can-load-more-history;
                loading-history: root.chat-loading-history;
                virtual-top-spacer: root.chat-virtual-top-spacer;
                virtual-bottom-spacer: root.chat-virtual-bottom-spacer;
                scroll-position <=> root.chat-scroll-position;
                copied-message-index <=> root.chat-copied-message-index;
                loading-phase <=> root.chat-loading-phase;
                navigate(route) => {
                    root.previous-route = root.current-route;
                    root.navigate(route);
                }
                send-message(text) => {
                    root.chat-send-message(text);
                }
                load-more-history() => {
                    root.chat-load-more-history();
                }
                copy-to-clipboard(index, text) => {
                    root.chat-copy-to-clipboard(index, text);
                }
                open-link(url) => {
                    root.chat-open-link(url);
                }
            }

            dialog-page := DialogPage {
                visible: root.show-dialog-page;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                navigate(route) => {
                    root.previous-route = root.current-route;
                    root.navigate(route);
                }
            }
        }
    }

    // 底部状态栏 - 固定在窗口底部，高度 40px
    StatusBar {
        x: 0;
        y: root.height - LayoutConstants.status-bar-height;
        width: root.width;
        height: LayoutConstants.status-bar-height;
    }

    ProjectAddModal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        modal-visible: root.project-show-add-modal;
        mode: root.project-modal-mode;
        original-alias: root.project-modal-original-alias;
        name <=> root.project-new-name;
        alias <=> root.project-new-alias;
        local-repo <=> root.project-new-local-repo;
        remote-repo <=> root.project-new-remote-repo;
        logo <=> root.project-new-logo;
        project-tags <=> root.project-new-tags;
        logo-preview-image: root.project-logo-preview-image;
        logo-preview-status: root.project-logo-preview-status;
        error-text <=> root.project-add-error;
        preview-logo(logo) => {
            root.project-preview-logo(logo);
        }
        submit(name, alias, local-repo, remote-repo, logo, project-tags) => {
            if root.project-modal-mode == "edit" {
                root.project-update-project(root.project-modal-original-alias, name, alias, local-repo, remote-repo, logo, project-tags);
            } else {
                root.project-add-project(name, alias, local-repo, remote-repo, logo, project-tags);
            }
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
        confirm-delete(alias) => {
            root.project-delete-project(alias);
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
        cancel => {
            root.project-new-name = "";
            root.project-new-alias = "";
            root.project-new-local-repo = "";
            root.project-new-remote-repo = "";
            root.project-new-logo = "";
            root.project-new-tags = "";
            root.project-preview-logo("");
            root.project-add-error = "";
            root.project-show-add-modal = false;
            root.project-modal-mode = "add";
            root.project-modal-original-alias = "";
        }
    }
    
    // 通知显示区域 - 固定在右上角，距离右边界 16px
    // 只在有通知时才创建，避免空队列时占用空间和阻挡点击
    if NotificationManager.queue.length > 0: Rectangle {
        x: root.width - 256px;  // 240px (宽度) + 16px (右边距)
        y: 20px;
        width: 240px;
        // 最大可用高度
        private property <length> max-available-height: root.height - 40px;
        // 内容高度（通过隐藏的内容计算器获取）
        private property <length> content-total-height: content-height-calculator.preferred-height;
        // 高度自适应：取内容高度和最大可用高度的较小值
        height: min(content-total-height, max-available-height);
        background: transparent;
        clip: true;  // 裁剪超出部分
        
        // hover 状态跟踪（从消息项的 hover 状态获取）
        private property <bool> any-item-hovered: false;
        // 是否需要滚动（内容超过可视区域）
        private property <bool> needs-scroll: content-total-height > max-available-height;
        
        // 滚动条预留宽度（与 Material ScrollView 内部一致：scroll_bar_size=8px）
        private property <length> scrollbar-width: 8px;
        // 内容固定宽度（始终固定，不受滚动条影响）
        private property <length> content-fixed-width: 240px - scrollbar-width;
        
        // 隐藏的内容高度计算器（不可见，仅用于计算高度）
        content-height-calculator := VerticalLayout {
            x: -10000px;  // 移出可视区域
            width: content-fixed-width;  // 使用相同的固定宽度计算高度
            spacing: 0px;
            
            for notification[index] in NotificationManager.queue : NotificationItem {
                notification: notification;
                index: index;
            }
        }
        
        // 内容区域容器：固定宽度，支持滚动
        Rectangle {
            width: content-fixed-width;
            height: parent.height;
            clip: true;
            background: transparent;
            
            // 使用 Flickable 直接实现滚动，完全控制布局
            notification-flickable := Flickable {
                width: parent.width;
                height: parent.height;
                interactive: true;
                
                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;  // 间距已包含在 NotificationItem 内部
                    
                    for notification[index] in NotificationManager.queue : NotificationItem {
                        notification: notification;
                        index: index;
                        dismissed(id) => {
                            NotificationManager.dismiss-by-id(id);
                        }
                        hovered(id, is-hovered) => {
                            NotificationManager.set-hovered(id, is-hovered);
                            // 当消息项 hover 时，设置容器的 hover 状态
                            any-item-hovered = is-hovered;
                        }
                        action-clicked(notification-id, action-index) => {
                            // 将 action-clicked 事件转发给 NotificationManager
                            NotificationManager.action-clicked(notification-id, action-index);
                        }
                    }
                }
            }
        }
        
        // 自定义滚动条：显示在预留空间内，不影响内容布局（仅视觉指示）
        if needs-scroll: Rectangle {
            x: content-fixed-width + 1px;  // 在内容右侧，padding 1px
            y: 0;
            width: scrollbar-width - 2px;
            height: parent.height;
            background: transparent;
            z: 1;
            
            // 滚动条轨道
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000020;
                opacity: any-item-hovered ? 1 : 0;
                animate opacity { duration: 150ms; }
                border-radius: 4px;
                
                // 滚动条滑块（仅显示当前位置，交互通过 Flickable 处理）
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: max(0px, abs(notification-flickable.viewport-y) * (parent.height - self.height) / max(1px, notification-flickable.viewport-height - notification-flickable.height));
                    width: 4px;
                    height: max(32px, parent.height * notification-flickable.height / max(1px, notification-flickable.viewport-height));
                    background: #00000080;
                    border-radius: 2px;
                    opacity: any-item-hovered ? 1 : 0.5;
                    animate opacity { duration: 150ms; }
                }
            }
        }
    }

    // Toast 显示区域 - 统一使用组件版 Toast，由组件内部处理 overlay 与非 overlay 场景
    if ToastManager.visible: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        z: 1000;

        Toast {
            message: ToastManager.message;
            type: ToastManager.type == ToastType.Success ? "success" :
                  ToastManager.type == ToastType.Error ? "error" :
                  ToastManager.type == ToastType.Loading ? "loading" : "text";
            position: ToastManager.position;
            overlay: ToastManager.overlay;
            close-on-click: ToastManager.close-on-click;
            toast-visible: ToastManager.visible;
            toast-width-value: ToastManager.width-value;
            toast-width-percent: ToastManager.width-percent;
            toast-width-is-auto: ToastManager.width-is-auto;
            dismiss() => {
                ToastManager.dismiss();
            }
        }
    }

    // Dialog 组件（从 dialog_enhance.slint 导入）
    DialogEnhance {
        width: 100%;
        height: 100%;
        on-default-action-clicked(id) => {
            debug("DialogEnhance: on-default-action-clicked, id={}", id);
            // 所有的 default-action 处理都交给 Rust 端通过 DialogManager 回调处理
            dialog-page.default-action-clicked(id);
        }
        on-action-clicked(id, index) => {
            debug("DialogEnhance: on-action-clicked, id={}, index={}", id, index);
            // 所有的 action 处理都交给 Rust 端通过 DialogManager 回调处理
            dialog-page.action-clicked(id, index);
        }
    }
    
    // 下载进度模态框
    DownloadProgressModal {
        width: 100%;
        height: 100%;
        cancel-clicked => {
            root.cancel-download();
        }
    }
    
}
