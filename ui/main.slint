import { GitHubNavigationSidebar, GitHubSidebarRightEdge, NavItem } from "./components/navigation/custom_nav_drawer.slint";
import { GitHubHomePage as HomePage } from "./views/home.slint";
import { GitHubSearchPage as SearchPage } from "./views/search.slint";
import { GitHubAboutPage as AboutPage } from "./views/about.slint";
import { UiComponentsFeature, UiComponentsPage } from "@ui-components";
import { GitHubWorkflowPage as WorkflowPage } from "./views/workflow/workflow.slint";
import { GitHubJobRunPage as JobRunPage } from "./views/job_run.slint";
import { WorkflowPullRequestItem } from "./components/workflow/github_pr_flow.slint";
import { GitHubPullRequestReviewPage } from "./views/workflow/pr_review_workspace.slint";
import { WorkflowPrDiffFile, WorkflowPrDiffLine, WorkflowPrDiffRowMetric, WorkflowPrDiffVirtualWindow, WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrDiffSelectionRange, WorkflowPrDiffTextSlice, WorkflowPrDiffFindMatch, WorkflowPrTreeItem, WorkflowPrFileExtensionFilter, WorkflowPrConversationItem, WorkflowPrCommit, GitHubHeaderActionStrip } from "./components/pr_review/shell.slint";
import { JobLogLineItem, JobStepItem } from "./components/jobs/job.slint";

import { GitHubProjectPage as ProjectPage, ProjectItem } from "./views/project.slint";
import { GitHubProjectDialog } from "./components/project/github_project_dialog.slint";
import { GitHubChatPage as ChatPage, ChatMessage, MessageRole, MessageStatus } from "./views/chat.slint";
import { Route } from "./route/routeMap.slint";
import { AppState } from "./state/app_state.slint";
import { DebugLogger } from "./state/debug_logger.slint";
import { TransientOverlayState } from "./state/transient_overlay_state.slint";
import { TooltipOverlayState } from "./state/tooltip_overlay_state.slint";
import { GitHubTooltipOverlayHost } from "./components/github_tooltip_overlay.slint";
import { GitHubBreadcrumb } from "./components/navigation/github_breadcrumb.slint";
import { NotificationManager, Notification, NotificationType, NotificationDelivery } from "./components/notify/notification.slint";
import { NotificationIcons } from "./components/notify/icons.slint";
import { GitHubNotificationItem } from "./components/notify/notification_item.slint";
import { GitHubToast } from "./components/toast/toast.slint";
import { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
import { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
import { GitHubDialogEnhance } from "./components/dialog/dialog_enhance.slint";
import { UpdateLogic, GitHubDownloadProgressDialog } from "./components/update/update.slint";
import { GitHubStatusBar } from "./components/status_bar.slint";
import { LayoutConstants } from "./layout_constants.slint";
import { GitHubPageScrollActions } from "./components/fab/page_scroll_actions.slint";
import { GitHubTerminalDrawer, TerminalLine } from "./components/drawer/terminal_drawer.slint";
import { GitHubScrollView } from "./components/github_scroll_view.slint";
import { GitHubActionMenu } from "./components/github_action_menu.slint";
import { GitHubIconButton } from "./components/button/github_icon_button.slint";
import { GitHubTheme, GitHubMetrics } from "./theme/github_theme.slint";

export { MaterialWindowAdapter } from "@material";
export { AppState } from "./state/app_state.slint";
export { DebugLogger } from "./state/debug_logger.slint";
export { TransientOverlayState } from "./state/transient_overlay_state.slint";
export { TooltipOverlayState } from "./state/tooltip_overlay_state.slint";
export { NotificationManager, Notification, NotificationType, NotificationDelivery } from "./components/notify/notification.slint";
export { NotificationIcons } from "./components/notify/icons.slint";
export { ToastManager, ToastType, ToastOptions } from "./components/toast/toast_manager.slint";
export { DialogManager, DialogOptions } from "./components/dialog/dialog_manager.slint";
export { UpdateLogic } from "./components/update/update.slint";
export { ChatMessage, MessageRole, MessageStatus } from "./views/chat.slint";
export { JobLogLineItem, JobStepItem } from "./components/jobs/job.slint";
export { WorkflowPullRequestItem } from "./components/workflow/github_pr_flow.slint";
export { WorkflowPrDiffFile, WorkflowPrDiffLine, WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrDiffSelectionRange, WorkflowPrDiffTextSlice, WorkflowPrDiffFindMatch, WorkflowPrTreeItem, WorkflowPrConversationItem, WorkflowPrCommit } from "./components/pr_review/shell.slint";

export component MainWindow inherits Window {
    // Keep the application wide enough for the primary navigation and workspace
    // while preserving the shared application-level layout constraint.
    min-width: GitHubMetrics.application-min-width;
    min-height: 600px;
    title: "Usher";
    // Use one shared surface color for the native title bar and the main content area.
    private property <color> window-surface-color: GitHubTheme.canvas-default;
    private property <length> native-titlebar-inset: root.platform-is-macos ? 46px : 0px;
    private property <length> page-breadcrumb-height:
        root.show-breadcrumb && !root.platform-is-macos ? 40px : 0px;
    private property <length> page-content-top-padding:
        root.show-breadcrumb ? (root.platform-is-macos ? 16px : 56px) : 0px;
    private property <length> page-content-height-offset: root.page-content-top-padding + 2px;
    // Until AppKit confirms that Menu vibrancy is mounted, keep the complete
    // first frame opaque. Otherwise the transparent root and translucent
    // sidebar can reveal another window before the native effect is ready.
    background: root.platform-is-macos && !root.native-sidebar-vibrancy-ready
        ? root.window-surface-color
        : transparent;
    in-out property <bool> window-live-resizing: false;
    in-out property <bool> native-window-active: true;
    callback message-window-activity-changed(bool);
    changed native-window-active => {
        root.message-window-activity-changed(root.native-window-active);
    }
    in-out property <bool> native-sidebar-vibrancy-ready: false;
    // Display-only labels come from the Rust shortcut registry so tooltips and
    // executable bindings cannot drift apart.
    in property <string> shortcut-toggle-sidebar-label: "";
    in property <string> shortcut-toggle-terminal-label: "";
    in property <string> shortcut-navigate-back-label: "";
    in property <string> shortcut-navigate-forward-label: "";
    in property <string> shortcut-open-settings-label: "";
    in-out property <bool> shortcut-initialization-visible: false;
    in-out property <bool> shortcut-initialization-failed: false;
    in-out property <float> shortcut-initialization-progress: 0;
    in-out property <string> shortcut-initialization-status: "";
    in-out property <string> shortcut-initialization-detail: "";
    out property <length> chat-layout-window-width: self.width;
    out property <length> chat-layout-window-height: self.height;
    // Rust selects a clear CJK-capable family for each desktop platform.
    // Terminal content plus PR diff code/file-tree content keep their own fonts.
    in property <string> application-font-family: ".AppleSystemUIFont";
    default-font-family: root.application-font-family;

    // 路由状态 - 对外暴露
    in-out property <Route> current-route: Route.Home;
    // Breadcrumb 显示控制（由路由策略统一计算）
    in-out property <bool> show-breadcrumb: true;
    // 导航抽屉显示控制（由路由策略统一计算）
    in-out property <bool> show-navigation-drawer: true;
    // 导航抽屉当前选中项（由路由策略统一计算）
    in-out property <int> navigation-current-index: 0;
    // 页面可见性控制（由路由策略统一计算）
    in-out property <bool> show-page-scroll-view: true;
    in-out property <bool> show-chat-page: false;
    
    // Router history is authoritative. UI controls only invoke Back/Forward.
    in-out property <Route> previous-route: Route.Home;
    in-out property <bool> navigation-can-go-back: false;
    in-out property <bool> navigation-can-go-forward: false;
    private property <bool> shell-drawer-docked-route: root.current-route == Route.Workflow || root.current-route == Route.Project;
    private property <length> page-scroll-offset: (root.current-route == Route.Workflow || root.current-route == Route.Project)
        ? max(0px, -page-scroll-view.viewport_y)
        : 0px;
    private property <length> workflow-terminal-max-height: max(
        180px,
        main-content-host.height - root.native-titlebar-inset - root.page-breadcrumb-height - 32px
    );
    private property <length> workflow-terminal-fullscreen-height: max(
        180px,
        main-content-host.height - root.native-titlebar-inset - root.page-breadcrumb-height
    );
    private property <length> workflow-fab-bottom-offset: root.shell-drawer-visible ? 24px : 16px;
    private property <length> workflow-terminal-docked-height: root.shell-drawer-docked-route && root.shell-drawer-visible
        ? (root.shell-drawer-fullscreen
            ? root.workflow-terminal-fullscreen-height
            : min(root.shell-drawer-height > 0px ? root.shell-drawer-height : 280px, root.workflow-terminal-max-height))
        : 0px;
    private property <bool> page-memory-diag-pending: false;
    private property <bool> page-scroll-reset-pending: false;
    // Latch after the first Inbox visit. The cross-crate factory shell is
    // created lazily and never remounted; its potentially large row model is
    // released separately while the route is hidden.
    private property <bool> messages-page-ever-opened: false;
    private property <bool> sidebar-preview-visible: false;
    private property <bool> sidebar-preview-dismiss-pending: false;
    // Codex drives the docked sidebar from one interruptible Motion value. Keep
    // the equivalent scalar and velocity here so repeated toggles retarget the
    // in-flight spring instead of starting competing x/width animations.
    private property <float> sidebar-motion-progress: 0.0;
    private property <float> sidebar-motion-velocity: 0.0;
    private property <bool> sidebar-motion-running: false;
    // AppKit can deliver several width commits inside one native live-resize
    // frame. Do not let independently evaluated x/width bindings observe an
    // in-flight sidebar position in that window: snap all shell geometry to
    // the persisted docked target until live resize finishes.
    private property <float> sidebar-layout-progress: root.window-live-resizing
        ? (root.show-navigation-drawer && root.navigation-drawer-expanded ? 1.0 : 0.0)
        : min(1.0, max(0.0, root.sidebar-motion-progress));
    // Keep the expensive page tree at a fixed width while the shell moves.
    // Opening clips a wide page until the spring settles; closing expands it
    // once before movement starts. Rapid retargets do not reflow the page.
    private property <bool> sidebar-content-wide: true;
    private property <length> sidebar-content-width: root.width
        - (root.sidebar-content-wide ? 0px : GitHubMetrics.application-sidebar-width);
    // Keep the large PR Review tree mounted at the window origin, but translate
    // its ordinary content with the same shell motion as the sidebar and title
    // bar. Its layout width follows the shell's one-shot width policy so the
    // diff tree does not reflow on every animation frame.
    private property <length> pr-content-x:
        GitHubMetrics.application-sidebar-width * root.sidebar-layout-progress;
    private property <length> pr-content-width: root.sidebar-content-width;
    private property <bool> docked-sidebar-column-visible:
        root.sidebar-layout-progress > 0.001 || root.sidebar-motion-running;
    private property <length> pr-readiness-anchor-x: 0px;
    private property <length> pr-readiness-anchor-y: 0px;
    private property <length> pr-readiness-anchor-width: 0px;
    private property <length> pr-readiness-anchor-height: 0px;
    out property <bool> modal-overlay-visible:
        root.project-show-add-modal
            || (root.current-route == Route.PrReview
                && (root.workflow-pr-review-dialog-open
                    || root.workflow-pr-merge-dialog-open
                    || root.workflow-pr-revert-dialog-open
                    || root.workflow-pr-commit-range-dialog-open))
            || (DialogManager.visible && DialogManager.overlay)
            || UpdateLogic.is-downloading
            || (ToastManager.visible && ToastManager.overlay);

    // 导航信号（方便 Rust 端调用）
    callback navigate(Route);
    callback navigate-back();
    // Feature controllers call this after consuming any page-local Back state.
    callback router-back();
    callback navigate-forward();
    callback navigate-from-nav-index(int);
    // Startup restores the persisted state before the first frame without
    // treating it as an interactive toggle.
    callback restore-navigation-drawer-state(bool);
    callback toggle-navigation-drawer();
    callback navigation-drawer-motion-settled(bool);
    callback modal-overlay-visibility-changed(bool);
    callback dismiss-transient-overlays();
    // One root-window key boundary. Rust owns normalization, scope, conflict
    // detection, command lookup, and dispatch for application shortcuts.
    callback app-shortcut-key-pressed(string, bool, bool, bool, bool) -> bool;

    // 更新相关回调
    callback install();
    callback show-error();
    callback check-update();
    callback cancel-download();
    
    // Docked state is persisted. A collapsed sidebar can still open as a
    // temporary overlay from the left-edge hover target.
    in-out property <bool> navigation-drawer-expanded: false;

    // Update Checker
    callback show-update-dialog(latest-version: string, current-version: string);
    
    // Debug: simulate crash
    callback simulate-crash();

    // Chat 相关属性和回调
    in property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-input-text: "";
    in property <bool> chat-is-sending: false;
    in property <bool> chat-can-load-more-history: false;
    in property <bool> chat-loading-history: false;
    in property <length> chat-virtual-top-spacer: 0px;
    in property <length> chat-virtual-bottom-spacer: 0px;
    in-out property <length> chat-scroll-position: 0px;
    in-out property <int> chat-loading-phase: 0;
    callback chat-send-message(string);
    callback chat-load-more-history();
    callback chat-copy-to-clipboard(int, string) -> bool;
    callback chat-open-link(string);
    callback chat-route-visible-changed(bool);

    // Workflow state and callbacks
    in property <string> workflow-branch-result: "Ready to recreate branches.";
    in property <string> workflow-tag-result: "Ready to add or remove a tag.";
    in-out property <int> workflow-tag-selected-tab: 0;
    in-out property <int> workflow-selected-flow: 2;
    in-out property <string> workflow-tag-mode: "local";
    in-out property <string> workflow-tag-version-mode: "patch";
    in property <string> workflow-tag-current-version: "v0.0.0";
    in-out property <string> workflow-tag-next-version: "v0.0.1";
    in-out property <string> workflow-tag-remove-target: "";
    in property <bool> workflow-tag-add-initializing: false;
    in property <bool> workflow-tag-remove-initializing: false;
    in property <bool> workflow-tag-running: false;
    in property <bool> job-run-animations-enabled: true;
    // Application-level Job Run presentation. Feature modules publish a source
    // descriptor and snapshot without owning or embedding the route page.
    in property <bool> job-run-active: false;
    in property <string> job-run-source: "";
    in property <string> job-run-title: "Workflow run";
    in property <string> job-run-workflow-name: "Workflow";
    in property <string> job-run-context-name: "Usher";
    in property <string> job-run-job-name: "job";
    in property <string> job-run-trigger-detail: "Started manually";
    in property <string> job-run-summary: "";
    in property <string> job-run-status: "queued";
    in property <string> job-run-conclusion: "";
    in property <string> job-run-total-duration: "";
    in property <[JobStepItem]> job-run-steps: [];
    in property <bool> job-run-running: false;
    in property <string> workflow-project-id: "default";
    in property <string> workflow-project-name: "Default Project";
    in property <string> workflow-project-alias: "";
    in property <string> workflow-project-local-repo: "";
    in property <string> workflow-project-remote-repo: "";
    in property <string> workflow-open-local-folder-tooltip: "Show in file manager";
    in property <string> workflow-project-logo: "";
    in property <image> workflow-project-logo-image: @image-url("../logo.png");
    in property <[ProjectItem]> project-items: [];
    in-out property <bool> project-show-add-modal: false;
    in-out property <string> project-new-name: "";
    in-out property <string> project-new-alias: "";
    in-out property <string> project-new-local-repo: "";
    in-out property <string> project-new-remote-repo: "";
    in-out property <string> project-new-logo: "";
    in-out property <string> project-new-tags: "";
    in-out property <bool> project-new-pr-auto-update: false;
    in property <image> project-logo-preview-image: @image-url("../logo.png");
    in property <string> project-logo-preview-status: "Using app default logo";
    in-out property <string> project-add-error: "";
    in-out property <string> project-modal-mode: "add";
    in-out property <string> project-modal-original-alias: "";
    in-out property <string> project-search-query: "";
    in-out property <string> project-view-mode: "grid";
    in-out property <bool> project-list-loading: false;
    in-out property <string> project-list-error: "";
    in-out property <bool> settings-git-tokens-saved: false;
    in-out property <bool> settings-git-hosting-config-saved: false;
    in-out property <bool> settings-ai-agent-saved: false;
    in-out property <bool> settings-ai-agent-testing: false;
    in-out property <int> settings-ai-agent-provider-index: -1;
    in property <component-factory> settings-page-factory;
    out property <length> settings-page-viewport-width:
        page-stack.width;
    out property <length> settings-page-viewport-height:
        // page-stack reserves 4px below ordinary shell-scrolled pages. The
        // isolated Settings viewport owns its edge and should meet the fixed
        // status bar without exposing that spacer.
        page-stack.height + 4px;
    callback settings-page-viewport-changed(length, length);
    changed settings-page-viewport-width => {
        root.settings-page-viewport-changed(
            root.settings-page-viewport-width,
            root.settings-page-viewport-height
        );
    }
    changed settings-page-viewport-height => {
        root.settings-page-viewport-changed(
            root.settings-page-viewport-width,
            root.settings-page-viewport-height
        );
    }
    out property <bool> settings-update-checking <=> UpdateLogic.checking-update;
    callback settings-update-checking-changed(bool);
    changed settings-update-checking => {
        root.settings-update-checking-changed(root.settings-update-checking);
    }
    in property <component-factory> messages-page-factory;
    in-out property <int> message-unread-count: 0;
    out property <bool> messages-page-active:
        root.current-route == Route.Messages && root.show-page-scroll-view;
    out property <length> messages-page-viewport-width: page-stack.width;
    out property <length> messages-page-viewport-height: page-stack.height + 4px;
    callback messages-page-viewport-changed(length, length);
    callback messages-page-active-changed(bool);
    changed messages-page-active => {
        root.messages-page-active-changed(root.messages-page-active);
    }
    changed messages-page-viewport-width => {
        root.messages-page-viewport-changed(
            root.messages-page-viewport-width,
            root.messages-page-viewport-height
        );
    }
    changed messages-page-viewport-height => {
        root.messages-page-viewport-changed(
            root.messages-page-viewport-width,
            root.messages-page-viewport-height
        );
    }
    in property <bool> platform-is-macos: false;
    in property <image> navigation-home-icon: @image-url("./assets/icons/lucide-sidebar-home.svg");
    in property <image> navigation-chat-icon: @image-url("./assets/icons/lucide-sidebar-chat.svg");
    in property <image> navigation-project-icon: @image-url("./assets/icons/lucide-sidebar-projects.svg");
    in property <image> navigation-components-icon: @image-url("./assets/icons/lucide-sidebar-components.svg");
    in property <image> navigation-settings-icon: @image-url("./assets/icons/lucide-sidebar-settings.svg");
    in property <image> navigation-about-icon: @image-url("./assets/icons/lucide-sidebar-help.svg");
    in property <image> navigation-chevron-icon: @image-url("./assets/icons/lucide-sidebar-chevron-down.svg");
    in property <image> navigation-search-icon: @image-url("./assets/icons/lucide-sidebar-search.svg");
    in property <image> navigation-notification-icon: @image-url("./assets/icons/lucide-sidebar-bell.svg");
    in property <string> workflow-pr-repo-project-id: "";
    in property <string> workflow-pr-repo-type: "";
    in property <[WorkflowPullRequestItem]> workflow-pr-list-items: [];
    in property <int> workflow-pr-list-total: 0;
    in property <bool> workflow-pr-list-total-exact: false;
    in property <int> workflow-pr-list-open-total: -1;
    in property <int> workflow-pr-list-closed-total: -1;
    in property <int> workflow-pr-list-page: 1;
    in property <int> workflow-pr-list-page-count: 1;
    in property <string> workflow-pr-list-state: "open";
    in property <string> workflow-pr-list-review-filter: "all";
    in property <string> workflow-pr-list-assignee-filter: "any";
    in property <string> workflow-pr-list-sort-filter: "newest";
    in property <bool> workflow-pr-list-loading: false;
    in property <string> workflow-pr-list-error: "";
    in-out property <bool> workflow-pr-review-visible: false;
    in property <bool> workflow-pr-review-loading: false;
    in property <bool> workflow-pr-review-code-loading: false;
    in property <bool> workflow-pr-review-large-diff-deferred: false;
    in property <bool> workflow-pr-review-large-diff-loading: false;
    in property <string> workflow-pr-review-error: "";
    in property <string> workflow-pr-review-number: "";
    in property <string> workflow-pr-review-title: "";
    in property <string> workflow-pr-review-author: "";
    in property <string> workflow-pr-review-source-branch: "";
    in property <string> workflow-pr-review-target-branch: "";
    in property <string> workflow-pr-review-updated-at: "";
    in property <string> workflow-pr-review-updated-at-tooltip: "";
    in property <int> workflow-pr-review-added-lines: 0;
    in property <int> workflow-pr-review-removed-lines: 0;
    in property <int> workflow-pr-review-commit-count: 0;
    in property <int> workflow-pr-review-conversation-count: 0;
    in property <string> workflow-pr-review-base-sha: "";
    in property <string> workflow-pr-review-head-sha: "";
    in property <bool> workflow-pr-review-too-many-commits: false;
    in-out property <int> workflow-pr-review-tab: 2;
    in property <[WorkflowPrConversationItem]> workflow-pr-review-conversation-items: [];
    in property <int> workflow-pr-review-conversation-content-height: 0;
    in property <int> workflow-pr-review-expanded-commit-body-height: 0;
    in property <[WorkflowPrCommit]> workflow-pr-review-commits: [];
    in property <bool> workflow-pr-review-conversation-loading: false;
    in property <bool> workflow-pr-review-commits-loading: false;
    in property <string> workflow-pr-review-conversation-error: "";
    in property <string> workflow-pr-review-commits-error: "";
    in-out property <int> workflow-pr-review-commit-range-start: -1;
    in-out property <int> workflow-pr-review-commit-range-end: -1;
    in property <string> workflow-pr-review-commit-range-label: "All commits";
    in property <[WorkflowPrDiffFile]> workflow-pr-review-files: [];
    in property <[WorkflowPrTreeItem]> workflow-pr-review-tree-items: [];
    in property <[WorkflowPrFileExtensionFilter]> workflow-pr-review-extension-filters: [];
    in property <bool> workflow-pr-review-only-manifest-files: false;
    in property <bool> workflow-pr-review-show-viewed-files: true;
    in property <bool> workflow-pr-review-file-filters-active: false;
    in property <[WorkflowPrDiffLine]> workflow-pr-review-lines: [];
    in property <[WorkflowPrDiffRowMetric]> workflow-pr-review-line-metrics: [];
    in property <int> workflow-pr-review-max-code-columns: 0;
    in property <string> workflow-pr-review-longest-code-line;
    in property <int> workflow-pr-review-line-content-revision: 0;
    in property <int> workflow-pr-review-line-model-revision: 0;
    in property <bool> workflow-pr-review-scroll-diagnostics-enabled: false;
    in property <int> workflow-pr-review-hunk-scroll-anchor-source-index: -1;
    in property <int> workflow-pr-review-hunk-scroll-restore-revision: 0;
    in property <bool> workflow-pr-review-hunk-scroll-restore-pending: false;
    in property <string> workflow-pr-review-code-font-family: "Menlo";
    in property <string> workflow-pr-review-tree-font-family: ".SF NS";
    in-out property <length> workflow-pr-review-file-list-width: 286px;
    in property <int> workflow-pr-review-selected-file-index: -1;
    in property <string> workflow-pr-review-selected-file-path: "";
    in property <int> workflow-pr-review-selected-file-added-lines: 0;
    in property <int> workflow-pr-review-selected-file-removed-lines: 0;
    in property <bool> workflow-pr-review-has-expandable-hunks: false;
    in property <bool> workflow-pr-review-context-expanded: false;
    in property <bool> workflow-pr-review-viewing-file: false;
    in property <bool> workflow-pr-review-ignore-whitespace-supported: false;
    in-out property <bool> workflow-pr-review-ignore-whitespace: false;
    in-out property <string> workflow-pr-review-diff-view: "unified";
    in-out property <string> workflow-pr-review-file-filter: "";
    in-out property <bool> workflow-pr-review-dialog-open: false;
    in-out property <bool> workflow-pr-merge-dialog-open: false;
    in-out property <bool> workflow-pr-revert-dialog-open: false;
    in-out property <bool> workflow-pr-readiness-popup-open: false;
    private property <bool> workflow-pr-commit-range-dialog-open: false;
    in property <bool> workflow-pr-action-loading: false;
    in property <bool> workflow-pr-can-comment: false;
    in property <bool> workflow-pr-can-approve: false;
    in property <bool> workflow-pr-can-request-changes: false;
    in property <string> workflow-pr-remote-review-state: "";
    in property <bool> workflow-pr-can-merge: false;
    in property <bool> workflow-pr-can-revert: false;
    in property <string> workflow-pr-merge-readiness-kind: "";
    in property <string> workflow-pr-merge-readiness-label: "";
    in property <string> workflow-pr-merge-readiness-detail: "";
    in property <string> workflow-pr-merge-block-reason: "";
