    in property <bool> workflow-pr-review-hunk-scroll-restore-pending: false;
    in property <string> workflow-pr-review-code-font-family: "Menlo";
    in property <string> workflow-pr-review-tree-font-family: ".SF NS";
    in-out property <length> workflow-pr-review-file-list-width: 286px;
    in property <int> workflow-pr-review-selected-file-index: -1;
    in property <string> workflow-pr-review-selected-file-path: "";
    in property <int> workflow-pr-review-selected-file-added-lines: 0;
    in property <int> workflow-pr-review-selected-file-removed-lines: 0;
    in property <bool> workflow-pr-review-has-expandable-hunks: false;
    in property <bool> workflow-pr-review-context-expanded: false;
    in property <bool> workflow-pr-review-viewing-file: false;
    in property <bool> workflow-pr-review-ignore-whitespace-supported: false;
    in-out property <bool> workflow-pr-review-ignore-whitespace: false;
    in-out property <string> workflow-pr-review-diff-view: "unified";
    in-out property <string> workflow-pr-review-file-filter: "";
