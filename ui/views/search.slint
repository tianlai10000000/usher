import { Route } from "../route/routeMap.slint";
import { GitHubBlankslate } from "../components/github_blankslate.slint";
import { GitHubPageView } from "../components/page/page_view.slint";

export component GitHubSearchPage inherits GitHubPageView {
    page-title: "Search";
    page-description: "Find a registered repository by project name or alias.";
    page-icon: @image-url("../assets/icons/octicon-search-16.svg");

    GitHubBlankslate {
        bordered: true;
        narrow: true;
        icon: @image-url("../assets/icons/octicon-repo-16.svg");
        heading: "Project search has moved";
        description: "Use the search field on the Projects page to filter the complete repository list.";
        primary-label: "Search projects";
        primary-clicked => { root.navigate(Route.Project); }
    }
}
