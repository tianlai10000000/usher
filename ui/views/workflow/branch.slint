import { FilledButton, MaterialPalette, MaterialText, Switch } from "@material";
import { CompactTextField } from "../../components/input/compact_text_field.slint";

component BranchField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    private property <length> label-height: 16px;
    private property <length> input-height: 42px;

    background: transparent;
    height: root.label-height + 6px + root.input-height;

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 6px;

        MaterialText {
            text: root.label;
            height: root.label-height;
            vertical_alignment: center;
            font_size: 12px;
            color: MaterialPalette.on_surface_variant;
        }

        CompactTextField {
            width: root.width;
            text <=> root.value;
            placeholder: root.placeholder;
            field-height: root.input-height;
            border-radius-size: 10px;
            input-font-size: 14px;
            input-font-family: "Hiragino Sans GB";
            field-background: MaterialPalette.surface_container_highest;
        }
    }
}

export component BranchFlow {
    in property <string> result;
    callback submit(string, string, bool);

    private property <string> source-branch: "main";
    private property <string> target-branch: "release/candidate";
    private property <bool> recreate-remote: true;
    private property <bool> stacked-fields: root.width < 720px;
    private property <length> split-field-width: max(0px, (root.width - 12px) / 2);

    VerticalLayout {
        width: root.width;
        spacing: 14px;
        alignment: start;

        MaterialText {
            text: "Recreate branches from a clean source branch. This only prepares the workflow plan and validation.";
            font_size: 14px;
            color: MaterialPalette.on_surface_variant;
        }

        if !root.stacked-fields: HorizontalLayout {
            width: parent.width;
            spacing: 12px;

            BranchField {
                width: root.split-field-width;
                label: "Source branch";
                value <=> root.source-branch;
                placeholder: "main";
            }

            BranchField {
                width: root.split-field-width;
                label: "Target branch";
                value <=> root.target-branch;
                placeholder: "release/x.y";
            }
        }

        if root.stacked-fields: VerticalLayout {
            width: parent.width;
            spacing: 12px;
            alignment: start;

            BranchField {
                width: parent.width;
                label: "Source branch";
                value <=> root.source-branch;
                placeholder: "main";
            }

            BranchField {
                width: parent.width;
                label: "Target branch";
                value <=> root.target-branch;
                placeholder: "release/x.y";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            MaterialText {
                text: "Recreate remote tracking";
                font_size: 14px;
                color: MaterialPalette.on_surface;
                vertical_alignment: center;
            }

            Switch {
                checked <=> root.recreate-remote;
                width: 48px;
                height: 28px;
            }
        }

        FilledButton {
            text: "Recreate branch plan";
            clicked => {
                root.submit(root.source-branch, root.target-branch, root.recreate-remote);
            }
        }

        Rectangle {
            width: 100%;
            min-height: 108px;
            border-radius: 14px;
            background: MaterialPalette.surface_container_high;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                MaterialText {
                    text: "Execution plan";
                    font_size: 13px;
                    color: MaterialPalette.on_surface_variant;
                }

                Text {
                    text: root.result;
                    wrap: word-wrap;
                    color: MaterialPalette.on_surface;
                    font-size: 14px;
                }
            }
        }
    }
}
