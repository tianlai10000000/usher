import { Job, JobStepItem } from "../../components/jobs/job.slint";
import { TagField, TagReadonlyField } from "../../components/workflow/fields.slint";
import { AppState } from "../../state/app_state.slint";
import {
    TagActionButton,
    TagSegmentedControl,
    TagSegmentItem,
    TagSegmentDivider,
} from "../../components/workflow/tag_controls.slint";

export component TagAddPanel {
    in property <string> version-mode: "patch";
    in property <string> scope-mode: "local";
    in property <string> current-version: "v0.0.0";
    in-out property <string> next-version: "v0.0.1";
    in property <bool> initializing: false;
    in property <bool> running: false;
    in property <string> job-status: "queued";
    in property <string> job-conclusion: "";
    in property <string> job-total-duration: "";
    in property <bool> loading-animated: true;
    in property <string> result: "Ready to create a tag.";
    in property <[JobStepItem]> steps: [];
    callback select-version-mode(string);
    callback run(string, string);
    callback stop();

    private property <string> description: "";
    private property <int> expanded-step-overrides: 0;
    private property <bool> stacked-fields: root.width < 1020px;
    width: 100%;
    height: panel-content.preferred-height;
    vertical-stretch: 0;

    // Local/Remote keeps this panel mounted; drop disclosure overrides when the
    // scope plan is replaced underneath.
    changed scope-mode => {
        root.expanded-step-overrides = 0;
    }

    panel-content := VerticalLayout {
        width: 100%;
        spacing: 16px;
        alignment: start;
        padding: 8px;

        // Primer SegmentedControl for bump size (replaces separate chips).
        HorizontalLayout {
            width: parent.width;
            height: 28px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            Text {
                height: 28px;
                text: "Bump";
                font-size: 12px;
                font-weight: 600;
                color: AppState.effective-dark-mode ? #9198a1 : #59636e;
                vertical-alignment: center;
                vertical-stretch: 0;
            }

            TagSegmentedControl {
                TagSegmentItem {
                    label: "Patch";
                    selected: root.version-mode == "patch";
                    enabled: !root.running && !root.initializing;
                    clicked => {
                        root.expanded-step-overrides = 0;
                        root.select-version-mode("patch");
                    }
                }
                TagSegmentDivider { }
                TagSegmentItem {
                    label: "Minor";
                    selected: root.version-mode == "minor";
                    enabled: !root.running && !root.initializing;
                    clicked => {
                        root.expanded-step-overrides = 0;
                        root.select-version-mode("minor");
                    }
                }
                TagSegmentDivider { }
                TagSegmentItem {
                    label: "Major";
                    selected: root.version-mode == "major";
                    enabled: !root.running && !root.initializing;
                    clicked => {
                        root.expanded-step-overrides = 0;
                        root.select-version-mode("major");
                    }
                }
            }
        }

        if !root.stacked-fields: HorizontalLayout {
            width: parent.width - 16px - 12px;
            spacing: 12px;

            TagReadonlyField {
                width: parent.width / 2;
                label: "Current tag version";
                value: root.current-version;
            }

            TagField {
                width: parent.width / 2;
                label: "New tag version";
                value <=> root.next-version;
                placeholder: "v1.2.3";
                enabled: !root.running && !root.initializing;
                min-field-width: 160px;
            }
        }

        if root.stacked-fields: VerticalLayout {
            width: parent.width - 16px;
            spacing: 12px;

            TagReadonlyField {
                width: parent.width;
                label: "Current tag version";
                value: root.current-version;
            }

            TagField {
                width: parent.width;
                label: "New tag version";
                value <=> root.next-version;
                placeholder: "v1.2.3";
                enabled: !root.running && !root.initializing;
                min-field-width: 160px;
            }
        }

        TagField {
            width: 100%;
            label: "Tag description";
            value <=> root.description;
            placeholder: "";
            enabled: !root.running && !root.initializing;
        }

        // alignment=start keeps Create on the left; Stop sits beside it while
        // the run is latched so it does not jump to the trailing edge.
        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            alignment: start;
            cross-axis-alignment: center;
            height: 32px;

            TagActionButton {
                enabled: !root.running && !root.initializing;
                loading: root.running || root.initializing;
                label: root.initializing ? "Loading…" : (root.running ? "Creating…" : "Create tag");
                clicked => {
                    root.expanded-step-overrides = 0;
                    root.run(root.next-version, root.description);
                }
            }

            if root.running: TagActionButton {
                label: "Stop workflow";
                danger: true;
                clicked => {
                    root.stop();
                }
            }
        }

        Job {
            width: 100%;
            vertical-stretch: 0;
            title: "Tag workflow";
            summary: root.initializing ? "Loading repository tags…" : root.result;
            execution-status: root.job-status;
            conclusion: root.job-conclusion;
            total-duration: root.job-total-duration;
            steps: root.steps;
            expanded-step-overrides <=> root.expanded-step-overrides;
            animations-enabled: root.loading-animated;
        }
    }
}
