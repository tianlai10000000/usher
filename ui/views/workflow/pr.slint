import { FilledButton, MaterialPalette, MaterialText, Switch } from "@material";
import { CompactTextField } from "../../components/input/compact_text_field.slint";

component PrField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 280px;
    private property <length> label-height: 16px;
    private property <length> input-height: 42px;

    background: transparent;
    width: root.field-width;
    height: root.label-height + 6px + root.input-height;

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 6px;

        MaterialText {
            text: root.label;
            height: root.label-height;
            vertical_alignment: center;
            font_size: 12px;
            color: MaterialPalette.on_surface_variant;
        }

        CompactTextField {
            width: root.field-width;
            text <=> root.value;
            placeholder: root.placeholder;
            field-height: root.input-height;
            border-radius-size: 10px;
            input-font-size: 14px;
            input-font-family: "Hiragino Sans GB";
            field-background: MaterialPalette.surface_container_highest;
        }
    }
}

export component PrFlow {
    in property <string> ai-decision;
    in property <string> ai-summary;
    in property <string> manual-status;
    callback analyze(string, string, string, bool, bool);
    callback confirm(bool);

    private property <string> pr-number: "1024";
    private property <string> pr-title: "";
    private property <string> pr-summary: "";
    private property <bool> ci-green: true;
    private property <bool> reviewers-ready: false;
    private property <bool> stacked-fields: root.width < 720px;
    private property <bool> stacked-switches: root.width < 560px;
    private property <bool> stacked-actions: root.width < 620px;
    private property <length> dual-field-width: max(0px, (root.width - 12px) / 2);

    VerticalLayout {
        width: root.width;
        spacing: 14px;
        alignment: start;

        MaterialText {
            text: "AI gives a recommendation, but the final approve or reject decision must still be made by a person.";
            font_size: 14px;
            color: MaterialPalette.on_surface_variant;
        }

        if !root.stacked-fields: HorizontalLayout {
            width: parent.width;
            spacing: 12px;

            PrField {
                label: "PR number";
                value <=> root.pr-number;
                placeholder: "1024";
                field-width: root.dual-field-width;
            }

            PrField {
                label: "PR title";
                value <=> root.pr-title;
                placeholder: "Refactor workflow status panel";
                field-width: root.dual-field-width;
            }
        }

        if root.stacked-fields: VerticalLayout {
            width: parent.width;
            spacing: 12px;
            alignment: start;

            PrField {
                width: parent.width;
                label: "PR number";
                value <=> root.pr-number;
                placeholder: "1024";
                field-width: parent.width;
            }

            PrField {
                width: parent.width;
                label: "PR title";
                value <=> root.pr-title;
                placeholder: "Refactor workflow status panel";
                field-width: parent.width;
            }
        }

        VerticalLayout {
            spacing: 6px;

            MaterialText {
                text: "PR summary";
                font_size: 12px;
                color: MaterialPalette.on_surface_variant;
            }

            Rectangle {
                width: 100%;
                height: 108px;
                border-radius: 10px;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;
                background: MaterialPalette.surface_container_highest;
                clip: true;

                pr-summary-input := TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text <=> root.pr-summary;
                    color: MaterialPalette.on_surface;
                    font-size: 14px;
                    single-line: false;
                    wrap: word-wrap;
                }

                if root.pr-summary == "": MaterialText {
                    x: 12px;
                    y: 12px;
                    text: "Describe changes, affected modules, rollout notes, and known risks.";
                    font_size: 14px;
                    color: MaterialPalette.on_surface_variant;
                }
            }
        }

        if !root.stacked-switches: HorizontalLayout {
            width: parent.width;
            spacing: 18px;

            HorizontalLayout {
                spacing: 10px;
                MaterialText {
                    text: "CI green";
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }
                Switch {
                    checked <=> root.ci-green;
                    width: 48px;
                    height: 28px;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                MaterialText {
                    text: "Reviewers ready";
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }
                Switch {
                    checked <=> root.reviewers-ready;
                    width: 48px;
                    height: 28px;
                }
            }
        }

        if root.stacked-switches: VerticalLayout {
            width: parent.width;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                spacing: 10px;
                MaterialText {
                    text: "CI green";
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }
                Switch {
                    checked <=> root.ci-green;
                    width: 48px;
                    height: 28px;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                MaterialText {
                    text: "Reviewers ready";
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                    vertical_alignment: center;
                }
                Switch {
                    checked <=> root.reviewers-ready;
                    width: 48px;
                    height: 28px;
                }
            }
        }

        if !root.stacked-actions: HorizontalLayout {
            width: parent.width;
            spacing: 12px;

            FilledButton {
                text: "Analyze PR";
                clicked => {
                    root.analyze(
                        root.pr-number,
                        root.pr-title,
                        root.pr-summary,
                        root.ci-green,
                        root.reviewers-ready,
                    );
                }
            }

            FilledButton {
                text: "Approve";
                clicked => {
                    root.confirm(true);
                }
            }

            FilledButton {
                text: "Reject";
                clicked => {
                    root.confirm(false);
                }
            }
        }

        if root.stacked-actions: VerticalLayout {
            width: parent.width;
            spacing: 12px;
            alignment: start;

            FilledButton {
                text: "Analyze PR";
                clicked => {
                    root.analyze(
                        root.pr-number,
                        root.pr-title,
                        root.pr-summary,
                        root.ci-green,
                        root.reviewers-ready,
                    );
                }
            }

            FilledButton {
                text: "Approve";
                clicked => {
                    root.confirm(true);
                }
            }

            FilledButton {
                text: "Reject";
                clicked => {
                    root.confirm(false);
                }
            }
        }

        Rectangle {
            width: 100%;
            min-height: 146px;
            border-radius: 14px;
            background: MaterialPalette.surface_container_high;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                MaterialText {
                    text: "AI recommendation";
                    font_size: 13px;
                    color: MaterialPalette.on_surface_variant;
                }

                MaterialText {
                    text: root.ai-decision;
                    font_size: 18px;
                    font_weight: 600;
                    color: MaterialPalette.primary;
                }

                Text {
                    text: root.ai-summary;
                    wrap: word-wrap;
                    color: MaterialPalette.on_surface;
                    font-size: 14px;
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                Text {
                    text: "Manual confirmation: " + root.manual-status;
                    wrap: word-wrap;
                    color: MaterialPalette.on_surface_variant;
                    font-size: 13px;
                }
            }
        }
    }
}
