import { FilledButton, MaterialPalette, MaterialText, Switch } from "@material";
import { CompactTextField } from "../../components/input/compact_text_field.slint";

export struct WorkflowPullRequestItem {
    number: string,
    title: string,
    author: string,
    source-branch: string,
    target-branch: string,
    updated-at: string,
    web-url: string,
}

component StatusFilter inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> selected-value;
    callback selected(string);

    width: root.label == "All" ? 54px : 76px;
    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.selected-value == root.value ? MaterialPalette.primary : MaterialPalette.outline_variant;
    background: root.selected-value == root.value ? MaterialPalette.secondary_container : MaterialPalette.surface_container_lowest;

    MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-family: "Hiragino Sans GB";
        horizontal_alignment: center;
        vertical_alignment: center;
        font_size: 12px;
        font_weight: root.selected-value == root.value ? 600 : 400;
        color: root.selected-value == root.value ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
    }

    TouchArea { clicked => { root.selected(root.value); } }
}

component PageButton inherits Rectangle {
    in property <string> label;
    in property <bool> button-enabled: true;
    callback clicked();

    width: 76px;
    height: 32px;
    border-radius: 10px;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    background: MaterialPalette.surface_container_lowest;
    opacity: root.button-enabled ? 1 : 0.45;

    MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-family: "Hiragino Sans GB";
        horizontal_alignment: center;
        vertical_alignment: center;
        font_size: 12px;
        color: MaterialPalette.on_surface;
    }
    TouchArea { enabled: root.button-enabled; clicked => { root.clicked(); } }
}

// Keep empty and error feedback in the same Vuetify-style visual hierarchy.
// Both illustrations are bundled resources, so state changes perform no I/O.
component PrListStatePanel inherits Rectangle {
    in property <bool> error-state: false;
    in property <string> title;
    in property <string> description;
    in property <bool> show-action: false;
    callback action();

    height: 500px;
    background: transparent;

    VerticalLayout {
        x: 32px;
        y: 28px;
        width: parent.width - 64px;
        height: parent.height - 56px;
        spacing: 12px;
        alignment: center;

        HorizontalLayout {
            width: parent.width;
            height: 220px;
            spacing: 0px;

            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: min(320px, parent.width);
                height: parent.height;
                background: transparent;

                if root.error-state: Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("../../assets/illustrations/vuetify-empty-state-connection.svg");
                    image-fit: contain;
                }
                if !root.error-state: Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("../../assets/illustrations/vuetify-empty-state-teamwork.png");
                    image-fit: contain;
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        MaterialText {
            width: parent.width;
            height: 36px;
            text: root.title;
            horizontal_alignment: center;
            vertical_alignment: center;
            font_size: 22px;
            font_weight: 600;
            color: MaterialPalette.on_surface;
        }
        HorizontalLayout {
            width: parent.width;
            height: 58px;
            spacing: 0px;

            Rectangle { horizontal-stretch: 1; }
            Text {
                width: min(620px, parent.width);
                height: parent.height;
                text: root.description;
                wrap: word-wrap;
                horizontal_alignment: center;
                vertical_alignment: center;
                font-size: 14px;
                color: MaterialPalette.on_surface_variant;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.show-action: HorizontalLayout {
            width: parent.width;
            height: 42px;
            spacing: 0px;

            Rectangle { horizontal-stretch: 1; }
            FilledButton {
                width: 148px;
                height: parent.height;
                text: "Retry Request";
                clicked => { root.action(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component PrField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 280px;
    width: root.field-width;
    height: 64px;
    background: transparent;

    VerticalLayout {
        spacing: 6px;
        MaterialText { text: root.label; height: 16px; font_size: 12px; color: MaterialPalette.on_surface_variant; }
        CompactTextField {
            width: root.field-width;
            text <=> root.value;
            placeholder: root.placeholder;
            field-height: 42px;
            border-radius-size: 10px;
            input-font-size: 14px;
            field-background: MaterialPalette.surface_container_highest;
        }
    }
}

export component PrFlow {
    in property <string> repo-project-id;
    in property <string> repo-type;
    in property <[WorkflowPullRequestItem]> pr-items: [];
    in property <int> pr-total: 0;
    in property <bool> pr-total-exact: false;
    in property <int> pr-page: 1;
    in property <int> pr-page-count: 1;
    in property <string> pr-state: "open";
    in property <bool> pr-loading: false;
    in property <string> pr-error: "";
    in property <string> ai-decision;
    in property <string> ai-summary;
    in property <string> manual-status;
    callback change-state(string);
    callback change-page(int);
    callback open-detail(string, string, string, string, string, string);
    callback analyze(string, string, string, bool, bool);
    callback confirm(bool);

    private property <string> pr-number: "";
    private property <string> pr-title: "";
    private property <string> pr-summary: "";
    private property <bool> ci-green: true;
    private property <bool> reviewers-ready: false;
    private property <bool> compact-table: root.width < 820px;
    private property <string> empty-title: root.pr-state == "open"
        ? "There aren’t any open pull requests."
        : (root.pr-state == "closed"
            ? "There aren’t any closed pull requests."
            : (root.pr-state == "merged"
                ? "There aren’t any merged pull requests."
                : "There aren’t any pull requests."));
    private property <string> empty-description: root.pr-state == "all"
        ? "New pull requests will appear here when they’re created."
        : "Try another status filter.";
    // Keep the header and row cells on the same branch-column boundary.
    private property <length> branch-column-width: min(320px, max(240px, root.width * 0.2));
    private property <length> dual-field-width: max(0px, (root.width - 12px) / 2);

    VerticalLayout {
        width: root.width;
        spacing: 16px;
        alignment: start;
        Rectangle {
            width: parent.width;
            height: 48px;
            border-radius: 12px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            background: MaterialPalette.surface_container_low;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;
                MaterialText { text: "Pull requests"; font-family: "Hiragino Sans GB"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                MaterialText { text: root.pr-state == "all" ? "All states" : root.pr-state; font-family: "Hiragino Sans GB"; font_size: 12px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
            }
        }

        HorizontalLayout {
            width: parent.width;
            height: 32px;
            spacing: 8px;
            StatusFilter { label: "Open"; value: "open"; selected-value: root.pr-state; selected(value) => { root.change-state(value); } }
            StatusFilter { label: "Closed"; value: "closed"; selected-value: root.pr-state; selected(value) => { root.change-state(value); } }
            StatusFilter { label: "Merged"; value: "merged"; selected-value: root.pr-state; selected(value) => { root.change-state(value); } }
            StatusFilter { label: "All"; value: "all"; selected-value: root.pr-state; selected(value) => { root.change-state(value); } }
            Rectangle { horizontal-stretch: 1; }
            MaterialText {
                text: root.pr-loading
                    ? "Loading…"
                    : (root.pr-error != ""
                        ? "Total unavailable"
                        : root.pr-total + (root.pr-total-exact ? " total" : "+ total"));
                font_size: 12px;
                font-family: "Hiragino Sans GB";
                color: MaterialPalette.on_surface_variant;
                vertical_alignment: center;
            }
        }

        Rectangle {
            width: parent.width;
            // One page always reserves space for its header plus ten 58px rows.
            // The enclosing Workflow page scrolls instead of shrinking this table.
            min-height: 618px;
            border-radius: 12px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            background: MaterialPalette.surface_container_lowest;
            clip: true;

            VerticalLayout {
                width: parent.width;
                spacing: 0px;

                Rectangle {
                    height: 38px;
                    background: MaterialPalette.surface_container_low;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                        MaterialText { width: 62px; text: "PR"; font-family: "Hiragino Sans GB"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                        MaterialText { horizontal-stretch: 3; text: "Title"; font-family: "Hiragino Sans GB"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                        if !root.compact-table: MaterialText { width: root.branch-column-width; text: "Branch"; font-family: "Hiragino Sans GB"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                        if !root.compact-table: MaterialText { width: 110px; text: "Author"; font-family: "Hiragino Sans GB"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                        MaterialText { width: 142px; text: "Updated"; font-family: "Hiragino Sans GB"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                    }
                }

                if root.pr-loading: Rectangle {
                    height: 112px;
                    MaterialText { width: parent.width; height: parent.height; text: "Loading pull requests…"; horizontal_alignment: center; vertical_alignment: center; font_size: 13px; color: MaterialPalette.on_surface_variant; }
                }

                if !root.pr-loading && root.pr-error != "": PrListStatePanel {
                    error-state: true;
                    title: "Unable to load pull requests";
                    description: "Check your code hosting configuration or connection, then try again.";
                    show-action: true;
                    action => { root.change-page(root.pr-page); }
                }

                if !root.pr-loading && root.pr-error == "" && root.pr-items.length == 0: PrListStatePanel {
                    title: root.empty-title;
                    description: root.empty-description;
                }

                if !root.pr-loading && root.pr-error == "": VerticalLayout {
                    spacing: 0px;
                    for item[index] in root.pr-items: Rectangle {
                        height: 58px;
                        background: row-hover.has-hover
                            ? MaterialPalette.surface_container_high
                            : (Math.mod(index, 2) == 0 ? MaterialPalette.surface_container_lowest : MaterialPalette.surface_container_low);
                        border-width: 0px;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 12px;
                            MaterialText { width: 62px; text: "#" + item.number; font-family: "Hiragino Sans GB"; font_size: 12px; font_weight: 600; color: MaterialPalette.primary; vertical_alignment: center; overflow: elide; }
                            MaterialText { horizontal-stretch: 3; text: item.title; font-family: "Hiragino Sans GB"; font_size: 13px; color: MaterialPalette.on_surface; vertical_alignment: center; overflow: elide; }
                            if !root.compact-table: MaterialText { width: root.branch-column-width; text: item.source-branch + " → " + item.target-branch; font-family: "Hiragino Sans GB"; font_size: 11px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; overflow: elide; }
                            if !root.compact-table: MaterialText { width: 110px; text: item.author; font-family: "Hiragino Sans GB"; font-size: 11px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; overflow: elide; }
                            MaterialText { width: 142px; text: item.updated-at; font-family: "Hiragino Sans GB"; font-size: 11px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; overflow: elide; }
                        }
                        // Keep the hover target mounted so row feedback remains stable.
                        row-hover := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-detail(
                                    item.number,
                                    item.title,
                                    item.author,
                                    item.source-branch,
                                    item.target-branch,
                                    item.updated-at,
                                );
                            }
                        }
                    }
                }
            }
        }

        if !root.pr-loading && root.pr-error == "" && root.pr-items.length > 0: HorizontalLayout {
            width: parent.width;
            height: 32px;
            alignment: center;
            spacing: 12px;
            Rectangle { horizontal-stretch: 1; }
            PageButton { label: "Previous"; button-enabled: root.pr-page > 1 && !root.pr-loading; clicked => { root.change-page(root.pr-page - 1); } }
            MaterialText { width: 92px; text: "Page " + root.pr-page + " / " + root.pr-page-count; font-family: "Hiragino Sans GB"; horizontal_alignment: center; vertical_alignment: center; font_size: 12px; color: MaterialPalette.on_surface_variant; }
            PageButton { label: "Next"; button-enabled: root.pr-page < root.pr-page-count && !root.pr-loading; clicked => { root.change-page(root.pr-page + 1); } }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle { width: parent.width; height: 1px; background: MaterialPalette.outline_variant; }
        MaterialText { text: "AI review"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; }
        MaterialText { text: "Select a pull request above, or enter its details for an AI-assisted review. Human confirmation remains required."; font_size: 13px; color: MaterialPalette.on_surface_variant; }

        HorizontalLayout {
            width: parent.width; spacing: 12px;
            PrField { label: "PR number"; value <=> root.pr-number; placeholder: "1024"; field-width: root.dual-field-width; }
            PrField { label: "PR title"; value <=> root.pr-title; placeholder: "Pull request title"; field-width: root.dual-field-width; }
        }

        Rectangle {
            width: parent.width; height: 96px; border-radius: 10px; border-width: 1px;
            border-color: MaterialPalette.outline_variant; background: MaterialPalette.surface_container_highest;
            TextInput { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text <=> root.pr-summary; color: MaterialPalette.on_surface; font-size: 14px; single-line: false; wrap: word-wrap; }
        }

        HorizontalLayout {
            width: parent.width; spacing: 16px;
            MaterialText { text: "CI green"; font-size: 13px; vertical_alignment: center; }
            Switch { checked <=> root.ci-green; width: 48px; height: 28px; }
            MaterialText { text: "Reviewers ready"; font-size: 13px; vertical_alignment: center; }
            Switch { checked <=> root.reviewers-ready; width: 48px; height: 28px; }
            Rectangle { horizontal-stretch: 1; }
            FilledButton { text: "Analyze PR"; clicked => { root.analyze(root.pr-number, root.pr-title, root.pr-summary, root.ci-green, root.reviewers-ready); } }
            FilledButton { text: "Approve"; clicked => { root.confirm(true); } }
            FilledButton { text: "Reject"; clicked => { root.confirm(false); } }
        }

        Rectangle {
            width: parent.width; min-height: 118px; border-radius: 12px; background: MaterialPalette.surface_container_high;
            VerticalLayout {
                padding: 14px; spacing: 7px;
                MaterialText { text: "AI recommendation"; font_size: 12px; color: MaterialPalette.on_surface_variant; }
                MaterialText { text: root.ai-decision; font_size: 17px; font_weight: 600; color: MaterialPalette.primary; }
                Text { text: root.ai-summary; wrap: word-wrap; color: MaterialPalette.on_surface; font-size: 13px; }
                Text { text: "Manual confirmation: " + root.manual-status; wrap: word-wrap; color: MaterialPalette.on_surface_variant; font-size: 12px; }
            }
        }
    }
}
