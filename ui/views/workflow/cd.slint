import { FilledButton, MaterialPalette, MaterialText } from "@material";

component CdField {
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <length> field-width: 220px;

    VerticalLayout {
        spacing: 6px;

        MaterialText {
            text: root.label;
            font_size: 12px;
            color: MaterialPalette.on_surface_variant;
        }

        Rectangle {
            width: root.field-width;
            height: 42px;
            border-radius: 10px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            background: MaterialPalette.surface_container_highest;
            clip: true;

            TextInput {
                x: 12px;
                y: (parent.height - self.preferred-height) / 2;
                width: parent.width - 24px;
                text <=> root.value;
                color: MaterialPalette.on_surface;
                font-size: 14px;
                single-line: true;
            }

            if root.value == "": MaterialText {
                x: 12px;
                y: (parent.height - self.preferred-height) / 2;
                text: root.placeholder;
                font_size: 14px;
                color: MaterialPalette.on_surface_variant;
            }
        }
    }
}

component CdStageRow {
    in property <string> label;
    in property <string> status;
    in property <string> detail;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        MaterialText {
            text: root.label;
            font_size: 14px;
            color: MaterialPalette.on_surface;
            min_width: 70px;
        }

        Rectangle {
            min-width: 92px;
            height: 28px;
            border-radius: 14px;
            background: root.status == "success" ? #D7F7DF :
                        root.status == "running" ? #DDEAFE :
                        root.status == "rolled_back" ? #FFE8CC :
                        root.status == "failed" ? #FFD8D8 :
                        MaterialPalette.surface_container_highest;

            MaterialText {
                x: 10px;
                y: (parent.height - self.preferred-height) / 2;
                text: root.status;
                font_size: 12px;
                color: root.status == "success" ? #146C2E :
                       root.status == "running" ? #1D4ED8 :
                       root.status == "rolled_back" ? #B45309 :
                       root.status == "failed" ? #B42318 :
                       MaterialPalette.on_surface_variant;
            }
        }

        Text {
            text: root.detail;
            wrap: word-wrap;
            color: MaterialPalette.on_surface_variant;
            font-size: 13px;
        }
    }
}

export component CdFlow {
    in property <bool> running;
    in property <string> summary;
    in property <string> build-status;
    in property <string> build-detail;
    in property <string> test-status;
    in property <string> test-detail;
    in property <string> deploy-status;
    in property <string> deploy-detail;
    in property <string> verify-status;
    in property <string> verify-detail;
    callback start-deploy(string, string, string);
    callback request-rollback(string);

    private property <string> environment-name: "production";
    private property <string> release-name: "2026.03.09";
    private property <string> commit-hash: "HEAD";
    private property <string> rollback-commit: "";

    VerticalLayout {
        spacing: 14px;
        alignment: start;

        MaterialText {
            text: "Interactive CD flow. Start a staged deployment and allow rollback by a commit hash selected by the user.";
            font_size: 14px;
            color: MaterialPalette.on_surface_variant;
        }

        HorizontalLayout {
            spacing: 12px;

            CdField {
                label: "Environment";
                value <=> root.environment-name;
                placeholder: "production";
                field-width: 180px;
            }

            CdField {
                label: "Release";
                value <=> root.release-name;
                placeholder: "2026.03.09";
                field-width: 220px;
            }

            CdField {
                label: "Commit";
                value <=> root.commit-hash;
                placeholder: "abcdef1";
                field-width: 220px;
            }
        }

        HorizontalLayout {
            spacing: 12px;

            FilledButton {
                text: root.running ? "Running..." : "Start deployment";
                clicked => {
                    root.start-deploy(root.environment-name, root.release-name, root.commit-hash);
                }
            }

            CdField {
                label: "Rollback commit";
                value <=> root.rollback-commit;
                placeholder: "previous stable hash";
                field-width: 220px;
            }

            FilledButton {
                text: "Rollback";
                clicked => {
                    root.request-rollback(root.rollback-commit);
                }
            }
        }

        Rectangle {
            width: 100%;
            min-height: 188px;
            border-radius: 14px;
            background: MaterialPalette.surface_container_high;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                MaterialText {
                    text: root.summary;
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }

                CdStageRow {
                    label: "Build";
                    status: root.build-status;
                    detail: root.build-detail;
                }

                CdStageRow {
                    label: "Test";
                    status: root.test-status;
                    detail: root.test-detail;
                }

                CdStageRow {
                    label: "Deploy";
                    status: root.deploy-status;
                    detail: root.deploy-detail;
                }

                CdStageRow {
                    label: "Verify";
                    status: root.verify-status;
                    detail: root.verify-detail;
                }
            }
        }
    }
}
