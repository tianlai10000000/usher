import { FilledButton, MaterialPalette, MaterialText } from "@material";
import { StepItem, Steps } from "../../components/workflow/steps.slint";
import { TagField } from "../../components/workflow/fields.slint";

export component CdFlow {
    in property <bool> running;
    in property <string> summary;
    in property <string> build-status;
    in property <string> build-detail;
    in property <string> test-status;
    in property <string> test-detail;
    in property <string> deploy-status;
    in property <string> deploy-detail;
    in property <string> verify-status;
    in property <string> verify-detail;
    callback start-deploy(string, string, string);
    callback request-rollback(string);

    private property <string> environment-name: "production";
    private property <string> release-name: "2026.03.09";
    private property <string> commit-hash: "HEAD";
    private property <string> rollback-commit: "";
    private property <int> expanded-step-index: -1;
    private property <string> build-step-status:
        root.build-status == "failed" ? "error" :
        root.build-status == "rolled_back" ? "paused" :
        root.build-status;
    private property <string> test-step-status:
        root.test-status == "failed" ? "error" :
        root.test-status == "rolled_back" ? "paused" :
        root.test-status;
    private property <string> deploy-step-status:
        root.deploy-status == "failed" ? "error" :
        root.deploy-status == "rolled_back" ? "paused" :
        root.deploy-status;
    private property <string> verify-step-status:
        root.verify-status == "failed" ? "error" :
        root.verify-status == "rolled_back" ? "paused" :
        root.verify-status;
    private property <int> current-step-index:
        root.build-status == "running" ? 0 :
        root.test-status == "running" ? 1 :
        root.deploy-status == "running" ? 2 :
        root.verify-status == "running" ? 3 :
        (root.build-status == "success" && root.test-status == "pending") ? 1 :
        (root.test-status == "success" && root.deploy-status == "pending") ? 2 :
        (root.deploy-status == "success" && root.verify-status == "pending") ? 3 :
        -1;
    private property <[StepItem]> cd-steps: [
        {
            name: "Build",
            status: root.build-step-status,
            detail: root.build-detail,
            log: "Stage: Build\\nStatus: " + root.build-status + "\\n\\n" + root.build-detail,
        },
        {
            name: "Test",
            status: root.test-step-status,
            detail: root.test-detail,
            log: "Stage: Test\\nStatus: " + root.test-status + "\\n\\n" + root.test-detail,
        },
        {
            name: "Deploy",
            status: root.deploy-step-status,
            detail: root.deploy-detail,
            log: "Stage: Deploy\\nStatus: " + root.deploy-status + "\\n\\n" + root.deploy-detail,
        },
        {
            name: "Verify",
            status: root.verify-step-status,
            detail: root.verify-detail,
            log: "Stage: Verify\\nStatus: " + root.verify-status + "\\n\\n" + root.verify-detail,
        }
    ];

    VerticalLayout {
        spacing: 14px;
        alignment: start;

        MaterialText {
            text: "Interactive CD flow. Start a staged deployment and allow rollback by a commit hash selected by the user.";
            font_size: 14px;
            color: MaterialPalette.on_surface_variant;
        }

        HorizontalLayout {
            spacing: 12px;

            TagField {
                width: 180px;
                label: "Environment";
                value <=> root.environment-name;
                placeholder: "production";
            }

            TagField {
                width: 220px;
                label: "Release";
                value <=> root.release-name;
                placeholder: "2026.03.09";
            }

            TagField {
                width: 220px;
                label: "Commit";
                value <=> root.commit-hash;
                placeholder: "abcdef1";
            }
        }

        HorizontalLayout {
            spacing: 12px;

            FilledButton {
                text: root.running ? "Running..." : "Start deployment";
                clicked => {
                    root.start-deploy(root.environment-name, root.release-name, root.commit-hash);
                }
            }

            TagField {
                width: 220px;
                label: "Rollback commit";
                value <=> root.rollback-commit;
                placeholder: "previous stable hash";
            }

            FilledButton {
                text: "Rollback";
                clicked => {
                    root.request-rollback(root.rollback-commit);
                }
            }
        }

        Rectangle {
            width: 100%;
            height: max(72px, summary-column.preferred-height + 28px);
            border-radius: 14px;
            background: MaterialPalette.surface_container_high;

            summary-column := VerticalLayout {
                padding: 14px;
                spacing: 10px;

                MaterialText {
                    text: root.summary;
                    font_size: 14px;
                    color: MaterialPalette.on_surface;
                }

                Rectangle {
                    height: 1px;
                    background: MaterialPalette.outline_variant;
                }
            }
        }

        Steps {
            width: 100%;
            title: "CD workflow steps";
            steps: root.cd-steps;
            current-step-index: root.current-step-index;
            expanded-step-index <=> root.expanded-step-index;
            animations-enabled: root.running;
        }
    }
}
