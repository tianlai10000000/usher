/// Workflow main entrance page and sub-flow workspace.
import { GitHubActionMenu } from "../../components/github_action_menu.slint";
import { GitHubPageView } from "../../components/page/page_view.slint";
import { GitHubCopyButton } from "../../components/button/github_copy_button.slint";
import { GitHubUnderlineNavItem } from "../../components/navigation/github_underline_nav.slint";
import { Route } from "../../route/routeMap.slint";
import { GitHubPullRequestFlow, WorkflowPullRequestItem } from "../../components/workflow/github_pr_flow.slint";
import { GitHubBranchFlow } from "../../components/workflow/github_branch_flow.slint";
import { GitHubCdFlow } from "../../components/workflow/github_cd_flow.slint";
import { GitHubTagFlow } from "../../components/workflow/github_tag_flow.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import { GitHubWorkflowProjectDetails } from "../../components/workflow/github_workflow_components.slint";


export component GitHubWorkflowPage inherits GitHubPageView {
    callback branch-submit(string, string, bool);
    callback tag-change-mode(string);
    callback tag-select-version-mode(string);
    callback tag-run(string, string);
    callback tag-remove(string);
    callback tag-open-add();
    callback tag-open-remove();
    callback pr-list-state-change(string);
    callback pr-list-page-change(int);
    callback pr-list-review-filter-change(string);
    callback pr-list-assignee-filter-change(string);
    callback pr-list-sort-filter-change(string);
    callback pr-open-detail(string, string, string, string, string, string);
    callback copy-remote-repo(string) -> bool;
    callback open-local-repo(string);
    callback cd-start(string, string, string);
    callback cd-rollback(string);

    in property <string> branch-result: "Ready to recreate branches.";
    in property <string> tag-result: "Ready to add or remove a tag.";
    in-out property <int> tag-selected-tab: 0;
    in-out property <string> tag-mode: "local";
    in-out property <string> tag-version-mode: "patch";
    in property <string> tag-current-version: "v0.0.0";
    in-out property <string> tag-next-version: "v0.0.1";
    in-out property <string> tag-remove-target: "";
    in property <bool> tag-add-initializing: false;
    in property <bool> tag-remove-initializing: false;
    in property <bool> tag-running: false;
    in property <bool> tag-has-run: false;
    in property <string> project-id: "default";
    in property <string> project-name: "Default Project";
    in property <string> project-alias: "";
    in property <string> project-local-repo: "";
    in property <string> project-remote-repo: "";
    in property <string> open-local-folder-tooltip: "Show in file manager";
    in property <string> project-logo: "";
    in property <image> project-logo-image: @image-url("../../../logo.png");
    in property <string> pr-repo-project-id: "";
    in property <string> pr-repo-type: "";
    in property <[WorkflowPullRequestItem]> pr-list-items: [];
    in property <int> pr-list-total: 0;
    in property <bool> pr-list-total-exact: false;
    in property <int> pr-list-open-total: -1;
    in property <int> pr-list-closed-total: -1;
    in property <int> pr-list-page: 1;
    in property <int> pr-list-page-count: 1;
    in property <string> pr-list-state: "open";
    in property <string> pr-list-review-filter: "all";
    in property <string> pr-list-assignee-filter: "any";
    in property <string> pr-list-sort-filter: "newest";
    in property <bool> pr-list-loading: false;
    in property <string> pr-list-error: "";
    in property <bool> pr-count-auto-update: false;
    in property <bool> pr-count-loading: false;
    in property <bool> pr-count-failed: false;
    in property <string> pr-fat-count: "-";
    in property <string> pr-uat-count: "-";
    in property <string> pr-prod-count: "-";
    in property <bool> cd-running: false;
    in property <string> cd-summary: "No deployment started.";
    in property <string> cd-build-status: "pending";
    in property <string> cd-build-detail: "Waiting to start.";
    in property <string> cd-test-status: "pending";
    in property <string> cd-test-detail: "Waiting to start.";
    in property <string> cd-deploy-status: "pending";
    in property <string> cd-deploy-detail: "Waiting to start.";
    in property <string> cd-verify-status: "pending";
    in property <string> cd-verify-detail: "Waiting to start.";

    // MainWindow retains this navigation state while the full-window PR review
    // workspace temporarily unmounts the Workflow component tree.
    in-out property <int> selected-flow: 2;
    // Compact repository ActionMenu open state (owned here so the overlay can
    // mount above the Workflow tab row).
    in-out property <bool> repository-details-open: false;
    private property <length> workflow-content-width: root.width - 32px;
    private property <bool> compact-workflow-layout: root.workflow-content-width < 860px;
    private property <color> canvas-default: GitHubTheme.canvas-default;
    private property <color> canvas-subtle: GitHubTheme.canvas-subtle;
    private property <color> border-default: GitHubTheme.border-default;
    private property <color> fg-default: GitHubTheme.fg-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    private property <bool> has-remote: root.project-remote-repo != "";
    private property <bool> has-local: root.project-local-repo != "";
    private property <string> display-remote: root.has-remote
        ? root.project-remote-repo
        : "No remote URL";
    private property <string> display-local: root.has-local
        ? root.project-local-repo
        : "No local path";
    // GitHub-style full-width repo header stays mounted on both breakpoints.
    // Compact mode moves paths into the overflow menu.
    private property <length> project-header-height: project-details.height;
    private property <length> workflow-nav-height: 48px;
    private property <length> pr-flow-width: root.workflow-content-width
        - (root.compact-workflow-layout ? 32px : 48px);
    private property <length> pr-list-header-height: 48px;
    private property <length> pr-list-content-height: root.pr-list-loading || root.pr-list-error != "" || root.pr-list-items.length == 0
        ? root.pr-list-header-height + 320px
        : root.pr-list-header-height + root.pr-list-items.length * 72px;
    private property <length> pr-flow-content-height: root.pr-list-content-height
        + ((!root.pr-list-loading
            && root.pr-list-error == ""
            && root.pr-list-items.length > 0
            && root.pr-list-page-count > 1)
            ? 56px
            : 0px);
    private property <length> selected-panel-height:
        root.selected-flow == 0
            ? max(620px, 16px + branch-flow.height + 24px)
        : root.selected-flow == 1
            ? max(620px, 16px + cd-flow.height + 24px)
        : root.selected-flow == 2
            ? max(620px, 16px + root.pr-flow-content-height)
        : max(620px, 16px + tag-flow.height + 24px);
    private property <length> body-top: root.project-header-height + root.workflow-nav-height;

    workflow-shell := Rectangle {
        width: root.workflow-content-width;
        height: max(
            (root.viewport-height > 0px ? root.viewport-height : 720px) - 32px,
            root.body-top + root.selected-panel-height,
        );
        background: root.canvas-default;
        // Compact repository ActionMenu extends below the header; do not clip it.
        clip: false;

        // Full-width identity header (GitHub repo page pattern).
        project-details := GitHubWorkflowProjectDetails {
            y: 0px;
            width: parent.width;
            project-name: root.project-name;
            project-alias: root.project-alias;
            project-local-repo: root.project-local-repo;
            project-remote-repo: root.project-remote-repo;
            open-local-folder-tooltip: root.open-local-folder-tooltip;
            repo-type: root.pr-repo-type;
            repo-project-id: root.pr-repo-project-id;
            project-logo-image: root.project-logo-image;
            repository-details-open <=> root.repository-details-open;
            copy-remote(url) => {
                root.copy-remote-repo(url)
            }
            open-local(path) => {
                root.open-local-repo(path);
            }
        }

        Rectangle {
            y: root.project-header-height;
            width: parent.width;
            height: root.workflow-nav-height;
            background: root.canvas-default;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.border-default;
            }

            HorizontalLayout {
                x: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 4px;
                alignment: start;

                GitHubUnderlineNavItem {
                    label: "Pull requests";
                    icon: @image-url("../../assets/icons/octicon-git-pull-request-16.svg");
                    selected: root.selected-flow == 2;
                    clicked => { root.selected-flow = 2; }
                }
                GitHubUnderlineNavItem {
                    label: "Tags";
                    icon: @image-url("../../assets/icons/octicon-stack-16.svg");
                    selected: root.selected-flow == 3;
                    clicked => { root.selected-flow = 3; }
                }
                GitHubUnderlineNavItem {
                    label: "Branch";
                    icon: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                    selected: root.selected-flow == 0;
                    clicked => { root.selected-flow = 0; }
                }
                GitHubUnderlineNavItem {
                    label: "CD";
                    icon: @image-url("../../assets/icons/octicon-repo-push-16.svg");
                    selected: root.selected-flow == 1;
                    clicked => { root.selected-flow = 1; }
                }
            }
        }

        main-panel := Rectangle {
            x: 0px;
            y: root.body-top;
            width: parent.width;
            height: root.selected-panel-height;
            background: root.canvas-default;

            branch-flow := GitHubBranchFlow {
                visible: root.selected-flow == 0;
                x: root.compact-workflow-layout ? 16px : 24px;
                y: 16px;
                width: parent.width - (root.compact-workflow-layout ? 32px : 48px);
                result: root.branch-result;
                submit(source, target, recreate-remote) => {
                    root.branch-submit(source, target, recreate-remote);
                }
            }

            cd-flow := GitHubCdFlow {
                visible: root.selected-flow == 1;
                x: root.compact-workflow-layout ? 16px : 24px;
                y: 16px;
                width: parent.width - (root.compact-workflow-layout ? 32px : 48px);
                running: root.cd-running;
                summary: root.cd-summary;
                build-status: root.cd-build-status;
                build-detail: root.cd-build-detail;
                test-status: root.cd-test-status;
                test-detail: root.cd-test-detail;
                deploy-status: root.cd-deploy-status;
                deploy-detail: root.cd-deploy-detail;
                verify-status: root.cd-verify-status;
                verify-detail: root.cd-verify-detail;
                start-deploy(environment-name, release-name, commit-hash) => {
                    root.cd-start(environment-name, release-name, commit-hash);
                }
                request-rollback(commit-hash) => {
                    root.cd-rollback(commit-hash);
                }
            }

            if root.selected-flow == 2: GitHubPullRequestFlow {
                x: root.compact-workflow-layout ? 16px : 24px;
                y: 16px;
                width: parent.width - (root.compact-workflow-layout ? 32px : 48px);
                // Pin to content height so max(620px, …) panel spare space cannot
                // stretch the list card over the pagination footer.
                height: root.pr-flow-content-height;
                vertical-stretch: 0;
                viewport-global-x: root.absolute-position.x;
                viewport-global-y: root.absolute-position.y;
                viewport-width: root.width;
                viewport-height: root.height;
                repo-project-id: root.pr-repo-project-id;
                repo-type: root.pr-repo-type;
                pr-items: root.pr-list-items;
                pr-total: root.pr-list-total;
                pr-total-exact: root.pr-list-total-exact;
                pr-open-total: root.pr-list-open-total;
                pr-closed-total: root.pr-list-closed-total;
                pr-page: root.pr-list-page;
                pr-page-count: root.pr-list-page-count;
                pr-state: root.pr-list-state;
                pr-review-filter: root.pr-list-review-filter;
                pr-assignee-filter: root.pr-list-assignee-filter;
                pr-sort-filter: root.pr-list-sort-filter;
                pr-loading: root.pr-list-loading;
                pr-error: root.pr-list-error;
                change-state(state) => { root.pr-list-state-change(state); }
                change-page(page) => { root.pr-list-page-change(page); }
                change-review-filter(value) => { root.pr-list-review-filter-change(value); }
                change-assignee-filter(value) => { root.pr-list-assignee-filter-change(value); }
                change-sort-filter(value) => { root.pr-list-sort-filter-change(value); }
                open-detail(number, title, author, source-branch, target-branch, updated-at) => {
                    root.pr-open-detail(number, title, author, source-branch, target-branch, updated-at);
                }
            }

            tag-flow := GitHubTagFlow {
                visible: root.selected-flow == 3;
                x: root.compact-workflow-layout ? 16px : 24px;
                y: 16px;
                width: parent.width - (root.compact-workflow-layout ? 32px : 48px);
                active: root.selected-flow == 3;
                selected-tab <=> root.tag-selected-tab;
                mode: root.tag-mode;
                version-mode: root.tag-version-mode;
                current-version: root.tag-current-version;
                next-version <=> root.tag-next-version;
                remove-target <=> root.tag-remove-target;
                add-initializing: root.tag-add-initializing;
                remove-initializing: root.tag-remove-initializing;
                running: root.tag-running;
                has-run: root.tag-has-run;
                result: root.tag-result;
                change-mode(mode) => { root.tag-change-mode(mode); }
                select-version-mode(mode) => { root.tag-select-version-mode(mode); }
                run(version, description) => { root.tag-run(version, description); }
                remove-tag(tag) => { root.tag-remove(tag); }
                open-add-tab => { root.tag-open-add(); }
                open-remove-tab => { root.tag-open-remove(); }
                view-run => { root.navigate(Route.JobRun); }
            }
        }

        // Mount the compact repository ActionMenu on the shell (after tabs /
        // panels) so it paints above them. Header-local popups were covered.
        if root.repository-details-open: Rectangle {
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: 9999px;
            height: 9999px;
            z: 300;
            background: transparent;

            TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: default;
                clicked => { root.repository-details-open = false; }
            }
        }

        if root.repository-details-open: GitHubActionMenu {
            z: 302;
            open: root.repository-details-open;
            viewport-x: 0px;
            viewport-y: 0px;
            viewport-width: root.width;
            viewport-height: root.height;
            // Match the compact repository header's 16px trailing gutter.
            anchor-x: root.width - 48px;
            anchor-y: 8px;
            anchor-width: 32px;
            anchor-height: 32px;
            menu-width: 320px;
            content-height: 140px;
            align: "end";
            dismiss-requested => { root.repository-details-open = false; }

            Rectangle {
                width: parent.width;
                height: 140px;

                Text {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: 20px;
                text: "Remote";
                font-size: 12px;
                font-weight: 600;
                color: root.fg-muted;
                vertical-alignment: center;
            }

                Text {
                x: 12px;
                y: 28px;
                width: parent.width - 56px;
                height: 32px;
                text: root.display-remote;
                font-size: 12px;
                color: root.has-remote ? root.fg-default : root.fg-muted;
                vertical-alignment: center;
                overflow: elide;
            }

                GitHubCopyButton {
                x: parent.width - 44px;
                y: 28px;
                button-enabled: root.has-remote;
                tooltip-text: "Copy remote URL";
                tooltip-align-right: true;
                copy-requested => {
                    root.copy-remote-repo(root.project-remote-repo)
                }
            }

                Rectangle {
                y: 68px;
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-muted;
            }

                Text {
                x: 12px;
                y: 77px;
                width: parent.width - 24px;
                height: 20px;
                text: "Local";
                font-size: 12px;
                font-weight: 600;
                color: root.fg-muted;
                vertical-alignment: center;
            }

                Text {
                x: 12px;
                y: 97px;
                width: parent.width - 56px;
                height: 32px;
                text: root.display-local;
                font-size: 12px;
                color: root.has-local ? root.fg-default : root.fg-muted;
                vertical-alignment: center;
                overflow: elide;
            }

                Rectangle {
                x: parent.width - 40px;
                y: 99px;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: shell-open-touch.has-hover
                    ? (GitHubTheme.control-muted-hover)
                    : transparent;
                Image {
                    x: 6px;
                    y: 6px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-file-directory-16.svg");
                    colorize: root.fg-muted;
                }
                shell-open-touch := TouchArea {
                    enabled: root.has-local;
                    mouse-cursor: pointer;
                    clicked => { root.open-local-repo(root.project-local-repo); }
                }
                }
            }
        }
    }
}
