import { StepItem, Steps } from "../../components/workflow/steps.slint";
import { TagField } from "../../components/workflow/fields.slint";
import { TagActionButton, TagStatusBanner, TagStepsPlaceholder } from "../../components/workflow/tag_controls.slint";

export component TagRemovePanel {
    in property <bool> running: false;
    in property <bool> initializing: false;
    in property <bool> loading-animated: true;
    in property <string> result: "Ready to remove a tag.";
    in property <[StepItem]> steps: [];
    in-out property <string> tag-to-remove: "";
    callback remove-tag(string);
    callback stop();

    private property <int> expanded-step-index: -1;
    private property <bool> show-steps:
        root.running || (root.steps.length > 0 && root.steps[0].status != "pending");
    width: 100%;

    VerticalLayout {
        width: 100%;
        spacing: 16px;
        alignment: start;
        padding: 8px;
        padding-top: 16px;

        TagField {
            width: 100%;
            label: "Tag to remove";
            value <=> root.tag-to-remove;
            placeholder: "v1.2.3";
            enabled: !root.running && !root.initializing;
        }

        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            alignment: start;
            cross-axis-alignment: center;
            height: 32px;

            TagActionButton {
                enabled: !root.running && !root.initializing;
                loading: root.running || root.initializing;
                label: root.initializing ? "Loading…" : (root.running ? "Removing…" : "Remove tag");
                danger: true;
                clicked => {
                    root.remove-tag(root.tag-to-remove);
                }
            }

            Rectangle {
                height: 1px;
                background: transparent;
                horizontal-stretch: 1;
            }

            if root.running: TagActionButton {
                label: "Stop workflow";
                danger: true;
                clicked => {
                    root.stop();
                }
            }
        }

        TagStatusBanner {
            width: 100%;
            message: root.result;
            initializing: root.initializing;
        }

        if root.show-steps: Steps {
            width: 100%;
            title: "Tag remove workflow steps";
            steps: root.steps;
            expanded-step-index <=> root.expanded-step-index;
            animations-enabled: root.loading-animated;
        }

        if !root.show-steps: TagStepsPlaceholder {
            width: 100%;
            message: "Workflow steps will appear after the remove process starts.";
        }
    }
}
