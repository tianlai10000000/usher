import { MaterialText } from "@material";
import { AppState } from "../../state/app_state.slint";
import { TagAddPanel } from "./tag_add.slint";
import { TagRemovePanel } from "./tag_remove.slint";
import { JobStepItem } from "../../components/jobs/job.slint";
import {
    TagSegmentedControl,
    TagSegmentItem,
    TagSegmentDivider,
} from "../../components/workflow/tag_controls.slint";

// GitHub Primer UnderlineNav item. Durable contract:
// docs/specs/ui-design.md “UnderlineNav tabs”.
component TagTabChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    width: max(48px, label-measure.preferred-width + 16px);
    height: 32px;
    border-radius: 6px;
    // Primer `--bgColor-neutral-muted` hover wash on the rounded control.
    background: tab-touch.has-hover
        ? (AppState.effective-dark-mode ? #656c7633 : #eaedf0)
        : transparent;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        wrap: no-wrap;
    }

    MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font_size: 14px;
        font_weight: root.selected ? 600 : 400;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        horizontal_alignment: center;
        vertical_alignment: center;
    }

    // Sit on the shared 1px nav border (8px gap under the 32px control in a
    // 48px row → underline at control.bottom + 6px).
    if root.selected: Rectangle {
        x: 0px;
        y: parent.height + 6px;
        width: parent.width;
        height: 2px;
        border-radius: 1px;
        background: AppState.effective-dark-mode ? #f78166 : #fd8c73;
    }

    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TagFlow {
    in property <bool> active: false;
    in property <string> mode: "local";
    in property <string> version-mode: "patch";
    in property <string> current-version: "v0.0.0";
    in-out property <string> next-version: "v0.0.1";
    in-out property <string> remove-target: "";
    in property <bool> add-initializing: false;
    in property <bool> remove-initializing: false;
    in property <bool> running: false;
    in property <string> job-status: "queued";
    in property <string> job-conclusion: "";
    in property <string> job-total-duration: "";
    in property <bool> loading-animated: true;
    in property <string> result: "Ready to create a tag.";
    in property <[JobStepItem]> steps: [];
    callback change-mode(string);
    callback select-version-mode(string);
    callback run(string, string);
    callback remove-tag(string);
    callback open-add-tab();
    callback open-remove-tab();
    callback stop();

    in-out property <int> selected-tab: 0; // 0: Add, 1: Remove
    private property <color> canvas-default: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    private property <color> border-default: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    private property <color> fg-muted: AppState.effective-dark-mode ? #9198a1 : #59636e;
    width: 100%;
    content := VerticalLayout {
        width: root.width;
        spacing: 0px;
        alignment: start;

        // Scope is repository context, not an Add/Remove tab. Keep it on its
        // own compact toolbar above the UnderlineNav, aligned to the left.
        scope-row := Rectangle {
            width: parent.width;
            height: 36px;
            background: root.canvas-default;

            scope-group := HorizontalLayout {
                x: 0px;
                y: 4px;
                height: 28px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Text {
                    height: 28px;
                    text: "Scope";
                    font-size: 12px;
                    font-weight: 600;
                    color: root.fg-muted;
                    vertical-alignment: center;
                }

                TagSegmentedControl {
                    TagSegmentItem {
                        label: "Local";
                        selected: root.mode != "remote";
                        enabled: !root.running;
                        clicked => { root.change-mode("local"); }
                    }
                    TagSegmentDivider { }
                    TagSegmentItem {
                        label: "Remote";
                        selected: root.mode == "remote";
                        enabled: !root.running;
                        clicked => { root.change-mode("remote"); }
                    }
                }
            }
        }

        // GitHub UnderlineNav for the actual tag operations.
        tabs-row := Rectangle {
            width: parent.width;
            height: 48px;
            background: root.canvas-default;
            clip: false;

            // Shared nav border; selected coral underline covers it.
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.border-default;
            }

            // Primer: 8px top inset + 32px items + 8px gap above the baseline,
            // condensed gap between items.
            HorizontalLayout {
                x: 0px;
                y: 8px;
                width: parent.width;
                height: 32px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                TagTabChip {
                    label: "Add Tag";
                    selected: root.selected-tab == 0;
                    clicked => {
                        root.selected-tab = 0;
                        root.open-add-tab();
                    }
                }

                TagTabChip {
                    label: "Remove Tag";
                    selected: root.selected-tab == 1;
                    clicked => {
                        root.selected-tab = 1;
                        root.open-remove-tab();
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle { width: parent.width; height: 12px; background: transparent; }

        if root.selected-tab == 0: Rectangle {
            border-width: 1px;
            border-color: root.border-default;
            border-radius: 6px;
            background: root.canvas-default;

            TagAddPanel {
                width: parent.width;
                initializing: root.add-initializing;
                scope-mode: root.mode;
                version-mode: root.version-mode;
                current-version: root.current-version;
                next-version <=> root.next-version;
                running: root.running;
                job-status: root.job-status;
                job-conclusion: root.job-conclusion;
                job-total-duration: root.job-total-duration;
                loading-animated: root.loading-animated;
                result: root.result;
                steps: root.steps;
                select-version-mode(mode) => {
                    root.select-version-mode(mode);
                }
                run(version, description) => {
                    root.run(version, description);
                }
                stop => {
                    root.stop();
                }
            }
        }

        if root.selected-tab == 1: Rectangle {
            border-width: 1px;
            border-color: root.border-default;
            border-radius: 6px;
            background: root.canvas-default;

            TagRemovePanel {
                width: parent.width;
                tag-to-remove <=> root.remove-target;
                initializing: root.remove-initializing;
                running: root.running;
                job-status: root.job-status;
                job-conclusion: root.job-conclusion;
                job-total-duration: root.job-total-duration;
                loading-animated: root.loading-animated;
                result: root.result;
                steps: root.steps;
                remove-tag(tag) => {
                    root.remove-tag(tag);
                }
                stop => {
                    root.stop();
                }
            }
        }
    }

    height: content.preferred-height;
}
