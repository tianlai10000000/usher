import { MaterialPalette, MaterialText, ToolTip } from "@material";
import { ListView } from "../../../material-1.7.1-fixed/ui/components/list_view.slint";
import { ScrollView } from "../../../material-1.7.1-fixed/ui/components/scroll_view.slint";
import { AppState } from "../../state/app_state.slint";

export struct WorkflowPrDiffFile {
    path: string,
    old-path: string,
    change-type: string,
    added-lines: int,
    removed-lines: int,
    viewed: bool,
    line-count: int,
}

export struct WorkflowPrDiffToken {
    text: string,
    color: color,
    dark-color: color,
    bold: bool,
    italic: bool,
}

export struct WorkflowPrDiffLine {
    old-line: int,
    new-line: int,
    kind: string,
    content: string,
    tokens: [WorkflowPrDiffToken],
    expandable: bool,
}

export struct WorkflowPrTreeItem {
    kind: string,
    name: string,
    path: string,
    depth: int,
    file-index: int,
    expanded: bool,
    added-lines: int,
    removed-lines: int,
    change-type: string,
    file-count: int,
}

export struct WorkflowPrFileExtensionFilter {
    extension: string,
    count: int,
    selected: bool,
}

export struct WorkflowPrConversationItem {
    id: string,
    kind: string,
    author: string,
    avatar: image,
    avatar-label: string,
    author-association: string,
    body: string,
    // Commit rows only: body lines after the title for ellipsis expansion.
    message-body: string,
    message-body-height: int,
    // Independent of other rows; multiple commits may stay expanded.
    message-expanded: bool,
    created-at: string,
    created-at-tooltip: string,
    state: string,
    connect-before: bool,
    connect-after: bool,
    // Precomputed ListView row height from Rust so cards can hug short bodies
    // without relying on Slint string length APIs.
    row-height: int,
}

component ConversationAvatar inherits Rectangle {
    in property <image> avatar;
    in property <string> fallback-label;
    in property <length> avatar-size: 40px;
    in property <length> label-size: 13px;

    width: root.avatar-size;
    height: root.avatar-size;
    border-radius: root.avatar-size / 2;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: root.avatar.width > 0
        ? transparent
        : (AppState.effective-dark-mode ? #21262d : #f6f8fa);
    clip: true;

    if root.avatar.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.avatar;
        image-fit: cover;
    }

    if root.avatar.width <= 0: MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.fallback-label;
        font-family: "Hiragino Sans GB";
        font-size: root.label-size;
        font-weight: 600;
        color: MaterialPalette.on_surface_variant;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export struct WorkflowPrCommit {
    sha: string,
    short-sha: string,
    title: string,
    message: string,
    message-body: string,
    message-body-height: int,
    // Independent of other rows; multiple commits may stay expanded.
    message-expanded: bool,
    // Sum of expand layout extras for this UTC+08:00 date group (group-start only).
    group-expand-extra: int,
    author: string,
    avatar: image,
    avatar-label: string,
    authored-at: string,
    date-label: string,
    short-date-label: string,
    group-start: bool,
    group-end: bool,
    group-size: int,
    verified: bool,
}

component ReviewActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> success: false;
    in property <bool> danger: false;
    in property <bool> button-enabled: true;
    in property <bool> show-chevron: false;
    // When true, width follows Primer Button medium inline padding (12px×2)
    // plus the label, matching GitHub's content-sized secondary actions.
    in property <bool> hug-content: false;
    // Parents that paint later siblings over this control (PR title under the
    // compact header actions) host the tip themselves. Nested tips still lose.
    in property <bool> embed-tooltip: true;
    // Compact leading-edge headers left-align tips so a long tip cannot flush
    // past the window's left gutter. Trailing-edge strips keep end alignment.
    in property <bool> tooltip-align-start: false;
    in property <string> tooltip-text: "";
    out property <bool> has-hover: action-touch.has-hover;
    callback clicked();

    // Primer default Button tokens (not Material surfaces) so header actions
    // like "Create revert PR" match GitHub's secondary btn.
    private property <color> default-fg: AppState.effective-dark-mode ? #f0f6fc : #25292e;
    private property <color> default-border: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    private property <color> default-bg: AppState.effective-dark-mode ? #21262d : #f6f8fa;
    private property <color> default-bg-hover: AppState.effective-dark-mode ? #292e36 : #eff2f5;

    width: root.hug-content
        ? (label-text.preferred-width + (root.show-chevron ? 40px : 24px))
        : 96px;
    height: 36px;
    background: transparent;

    // Dim only the button surface when disabled. Tooltips stay full-opacity
    // children of this root so they do not inherit the disabled fade.
    button-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.danger
            ? (AppState.effective-dark-mode ? #da3633 : #cf222e)
            : (root.success
                ? (AppState.effective-dark-mode ? #238636 : #1f883d)
                : (root.primary ? MaterialPalette.primary : root.default-border));
        background: root.success
            ? (action-touch.has-hover && root.button-enabled ? (AppState.effective-dark-mode ? #2ea043 : #1a7f37) : (AppState.effective-dark-mode ? #238636 : #1f883d))
            : root.danger
            ? (action-touch.has-hover && root.button-enabled
                ? (AppState.effective-dark-mode ? #f85149 : #a40e26)
                : (AppState.effective-dark-mode ? #da3633 : #cf222e))
            : root.primary
            ? (action-touch.has-hover ? MaterialPalette.primary.darker(8%) : MaterialPalette.primary)
            : (action-touch.has-hover && root.button-enabled ? root.default-bg-hover : root.default-bg);
        opacity: root.button-enabled ? 1 : 0.5;

        label-text := MaterialText {
            // Keep an unconstrained preferred-width when hugging so the root
            // width binding cannot circularly clamp the measured label.
            x: root.hug-content ? (parent.width - self.preferred-width) / 2 : 0px;
            width: root.hug-content ? self.preferred-width : parent.width;
            height: parent.height;
            text: root.text;
            horizontal_alignment: center;
            vertical_alignment: center;
            font_size: 12px;
            font_weight: 600;
            color: root.primary || root.success || root.danger ? #ffffff : root.default-fg;
        }

        if root.show-chevron: Image {
            x: parent.width - 25px;
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
            image-fit: contain;
            colorize: #ffffff;
        }
    }

    action-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => { if (root.button-enabled) { root.clicked(); } }
    }
    if root.embed-tooltip && action-touch.has-hover && root.tooltip-text != "": ToolTip {
        x: root.tooltip-align-start ? 0px : root.width - self.width;
        y: root.height + 4px;
        text: root.tooltip-text;
    }
}

// Primer-like primary green button used by the Conversation comment composer.
component GithubCommentButton inherits Rectangle {
    in property <string> text: "Comment";
    in property <bool> button-enabled: true;
    in property <string> tooltip-text: "";
    callback clicked();

    width: 96px;
    height: 32px;
    background: transparent;

    button-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        border-width: 1px;
        border-color: AppState.effective-dark-mode ? #238636 : #1f883d;
        background: root.button-enabled
            ? (action-touch.has-hover
                ? (AppState.effective-dark-mode ? #2ea043 : #1a7f37)
                : (AppState.effective-dark-mode ? #238636 : #1f883d))
            : (AppState.effective-dark-mode ? #23863666 : #94d3a2);
        label := MaterialText {
            width: parent.width;
            height: parent.height;
            text: root.text;
            font-family: "Hiragino Sans GB";
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    action-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => { if (root.button-enabled) { root.clicked(); } }
    }
    if action-touch.has-hover && root.tooltip-text != "": ToolTip {
        // Composer card clips descendants; keep the tip above the footer button.
        x: root.width - self.width;
        y: -self.height - 4px;
        text: root.tooltip-text;
    }
}

component PullRequestStateBadge inherits Rectangle {
    in property <string> kind;
    in property <color> success-color;
    in property <color> danger-color;
    in property <color> done-color;
    private property <string> state-label: root.kind == "merged"
        ? "Merged"
        : (root.kind == "closed" ? "Closed" : "Open");
    private property <color> state-color: root.kind == "merged"
        ? root.done-color
        : (root.kind == "closed" ? root.danger-color : root.success-color);

    width: state-label-text.preferred-width + 40px;
    height: 28px;
    border-radius: 14px;
    background: root.state-color;

    Image {
        x: 10px;
        y: 7px;
        width: 14px;
        height: 14px;
        source: @image-url("../../assets/icons/octicon-git-pull-request-16.svg");
        image-fit: contain;
        colorize: #ffffff;
    }
    state-label-text := MaterialText {
        x: 30px;
        width: self.preferred-width;
        height: parent.height;
        text: root.state-label;
        font-family: "Hiragino Sans GB";
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: #ffffff;
    }
}

component BranchLabel inherits Rectangle {
    in property <string> text;
    in property <color> background-color;
    in property <color> foreground-color;

    // GitHub keeps the full branch name visible; never elide into "...".
    width: branch-label-text.preferred-width + 16px;
    height: 26px;
    border-radius: 6px;
    background: root.background-color;

    branch-label-text := MaterialText {
        x: 8px;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        font-family: "Hiragino Sans GB";
        vertical-alignment: center;
        font-size: 13px;
        color: root.foreground-color;
    }
}

// GitHub-style relative timestamp: muted label with absolute datetime tooltip.
// Prefer Material ToolTip (no mouse grab). Avoid PopupWindow on hover — it
// steals input and flickers as has-hover toggles.
component RelativeTimestamp inherits Rectangle {
    in property <string> text;
    in property <string> tooltip-text;
    in property <color> foreground-color;
    in property <length> label-font-size: 13px;
    // Match the surrounding author/meta row; 26px is for header chips.
    in property <length> label-height: 26px;
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    // Place the tip to the left of the label (stays inside clipped headers).
    in property <bool> tooltip-beside: false;
    // Place the tip to the right of the label (into trailing free space).
    in property <bool> tooltip-after: false;
    out property <bool> has-hover: time-touch.has-hover;

    width: max(1px, time-label.preferred-width);
    height: root.label-height;
    background: transparent;
    clip: false;

    time-label := MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: "Hiragino Sans GB";
        font-size: root.label-font-size;
        color: root.foreground-color;
        vertical-alignment: center;
        overflow: elide;
    }
    time-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: default;
    }
    if time-touch.has-hover && root.tooltip-text != "" && (root.tooltip-after || root.tooltip-beside): Rectangle {
        z: 10000;
        x: root.tooltip-after ? root.width + 4px : -self.width - 4px;
        y: (root.height - self.height) / 2;
        width: tip-label.preferred-width + 16px;
        height: tip-label.preferred-height + 8px;
        border-radius: 4px;
        background: MaterialPalette.inverse_surface;
        tip-label := MaterialText {
            x: 8px;
            y: 4px;
            width: self.preferred-width;
            height: self.preferred-height;
            text: root.tooltip-text;
            font-family: "Hiragino Sans GB";
            font-size: 12px;
            color: MaterialPalette.inverse_on_surface;
            wrap: no-wrap;
        }
    }
    if time-touch.has-hover && root.tooltip-text != "" && !root.tooltip-after && !root.tooltip-beside: ToolTip {
        // above/below: pin trailing edge when tooltip-align-right.
        x: root.tooltip-align-right ? root.width - self.width : 0px;
        y: root.tooltip-above ? -self.height - 4px : root.height + 4px;
        text: root.tooltip-text;
    }
}

component PullRequestSummaryMetrics inherits Rectangle {
    in property <string> state-kind;
    in property <string> author;
    in property <int> commit-count: 0;
    in property <string> target-branch;
    in property <string> source-branch;
    in property <string> updated-at;
    private property <string> state-label: root.state-kind == "merged"
        ? "Merged"
        : (root.state-kind == "closed" ? "Closed" : "Open");
    out property <length> inline-width:
        state-measure.preferred-width + 40px
        + min(120px, author-measure.preferred-width)
        + summary-measure.preferred-width
        + target-measure.preferred-width + 16px
        + from-measure.preferred-width
        + source-measure.preferred-width + 16px
        + 28px
        + max(0px, updated-measure.preferred-width)
        + 48px;

    visible: false;
    width: 0px;
    height: 0px;

    state-measure := Text {
        text: root.state-label;
        font-family: "Hiragino Sans GB";
        font-size: 12px;
        font-weight: 600;
    }
    author-measure := Text {
        text: root.author;
        font-family: "Hiragino Sans GB";
        font-size: 13px;
        font-weight: 600;
    }
    summary-measure := Text {
        text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
        font-family: "Hiragino Sans GB";
        font-size: 13px;
    }
    target-measure := Text {
        text: root.target-branch;
        font-family: "Hiragino Sans GB";
        font-size: 13px;
    }
    from-measure := Text {
        text: "from";
        font-family: "Hiragino Sans GB";
        font-size: 13px;
    }
    source-measure := Text {
        text: root.source-branch;
        font-family: "Hiragino Sans GB";
        font-size: 13px;
    }
    updated-measure := Text {
        text: root.updated-at;
        font-family: "Hiragino Sans GB";
        font-size: 13px;
    }
}

component PullRequestSummaryRow inherits Rectangle {
    in property <string> state-kind;
    in property <string> author;
    in property <int> commit-count: 0;
    in property <string> target-branch;
    in property <string> source-branch;
    in property <string> updated-at;
    in property <string> updated-at-tooltip;
    in property <bool> compact: false;
    in property <color> success-color;
    in property <color> danger-color;
    in property <color> done-color;
    in property <color> muted-color;
    in property <color> muted-background;
    in property <color> branch-background;
    in property <color> branch-foreground;
    // Keep branch names fully visible like GitHub: one row when they fit,
    // otherwise move the branch segment to a second row (never elide).
    out property <bool> wraps: root.width < metrics.inline-width;
    callback copy-source-branch(string);

    height: root.wraps ? 64px : 32px;
    // Tooltips must escape this one-line layout; clipping turns the hovered
    // timestamp tooltip into a dark underline.
    clip: false;

    metrics := PullRequestSummaryMetrics {
        state-kind: root.state-kind;
        author: root.author;
        commit-count: root.commit-count;
        target-branch: root.target-branch;
        source-branch: root.source-branch;
        updated-at: root.updated-at;
    }

    if !root.wraps: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        PullRequestStateBadge {
            kind: root.state-kind;
            success-color: root.success-color;
            danger-color: root.danger-color;
            done-color: root.done-color;
        }
        Rectangle {
            width: min(root.compact ? 120px : 150px, author-label.preferred-width);
            height: 24px;
            author-label := MaterialText {
                width: parent.width;
                height: parent.height;
                text: root.author;
                font-family: "Hiragino Sans GB";
                font-size: 13px;
                font-weight: 600;
                color: root.muted-color;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                width: parent.width;
                height: 1px;
                background: root.muted-color;
            }
        }
        merge-summary-label := MaterialText {
            width: self.preferred-width;
            height: 26px;
            text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
            font-family: "Hiragino Sans GB";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        BranchLabel {
            text: root.target-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        from-label := MaterialText {
            width: self.preferred-width;
            height: 26px;
            text: "from";
            font-family: "Hiragino Sans GB";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        BranchLabel {
            text: root.source-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: copy-touch.has-hover ? root.muted-background : transparent;
            Image {
                x: 6px;
                y: 6px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-copy-16.svg");
                image-fit: contain;
                colorize: root.muted-color;
            }
            copy-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-source-branch(root.source-branch); }
            }
            if copy-touch.has-hover: ToolTip {
                x: root.width - self.width;
                y: root.height + 4px;
                text: "Copy source branch";
            }
        }
        if root.updated-at != "": RelativeTimestamp {
            text: root.updated-at;
            tooltip-text: root.updated-at-tooltip;
            tooltip-align-right: true;
            foreground-color: root.muted-color;
            label-font-size: 13px;
        }
    }

    if root.wraps: HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        PullRequestStateBadge {
            kind: root.state-kind;
            success-color: root.success-color;
            danger-color: root.danger-color;
            done-color: root.done-color;
        }
        Rectangle {
            width: min(root.compact ? 120px : 150px, compact-author-label.preferred-width);
            height: 24px;
            compact-author-label := MaterialText {
                width: parent.width;
                height: parent.height;
                text: root.author;
                font-family: "Hiragino Sans GB";
                font-size: 13px;
                font-weight: 600;
                color: root.muted-color;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                width: parent.width;
                height: 1px;
                background: root.muted-color;
            }
        }
        compact-summary-label := MaterialText {
            width: self.preferred-width;
            height: 26px;
            text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
            font-family: "Hiragino Sans GB";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
    }

    if root.wraps: HorizontalLayout {
        x: 0px;
        y: 34px;
        width: parent.width;
        height: 28px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        BranchLabel {
            text: root.target-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        compact-from-label := MaterialText {
            width: self.preferred-width;
            height: 26px;
            text: "from";
            font-family: "Hiragino Sans GB";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        BranchLabel {
            text: root.source-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: compact-copy-touch.has-hover ? root.muted-background : transparent;
            Image {
                x: 6px;
                y: 6px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-copy-16.svg");
                image-fit: contain;
                colorize: root.muted-color;
            }
            compact-copy-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-source-branch(root.source-branch); }
            }
            if compact-copy-touch.has-hover: ToolTip {
                x: root.width - self.width;
                y: root.height + 4px;
                text: "Copy source branch";
            }
        }
        if root.updated-at != "": RelativeTimestamp {
            text: root.updated-at;
            tooltip-text: root.updated-at-tooltip;
            tooltip-align-right: true;
            foreground-color: root.muted-color;
            label-font-size: 13px;
        }
    }
}

component CenteredErrorState inherits Rectangle {
    in property <string> title: "Uh oh!";
    in property <string> detail: "There was an error while loading. Please reload this page.";
    in property <color> background-color;
    in property <color> outline-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    callback retry();

    private property <length> content-top: max(16px, (root.height - 142px) / 2);

    background: root.background-color;

    Image {
        x: (parent.width - self.width) / 2;
        y: root.content-top;
        width: 28px;
        height: 28px;
        source: @image-url("../../assets/icons/octicon-alert-16.svg");
        image-fit: contain;
        colorize: root.muted-color;
    }
    MaterialText {
        x: 24px;
        y: root.content-top + 36px;
        width: parent.width - 48px;
        height: 24px;
        text: root.title;
        font-family: "Hiragino Sans GB";
        font-size: 16px;
        font-weight: 600;
        color: root.foreground-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 24px;
        y: root.content-top + 66px;
        width: parent.width - 48px;
        height: 34px;
        text: root.detail;
        font-family: "Hiragino Sans GB";
        font-size: 12px;
        color: root.muted-color;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.content-top + 108px;
        width: 92px;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.outline-color;
        background: retry-touch.has-hover
            ? (AppState.effective-dark-mode ? #21262d : #f3f4f6)
            : (AppState.effective-dark-mode ? #21262d : #f6f8fa);
        MaterialText {
            width: parent.width;
            height: parent.height;
            text: "Try again";
            font-family: "Hiragino Sans GB";
            font-size: 12px;
            font-weight: 600;
            color: root.foreground-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        retry-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.retry(); }
        }
    }
}

component PrTabButton inherits Rectangle {
    in property <string> label;
    in property <int> count: 0;
    in property <image> icon;
    in property <bool> selected: false;
    in property <length> tab-width: 160px;
    callback clicked();

    width: root.tab-width;
    height: 48px;
    background: tab-touch.has-hover ? (AppState.effective-dark-mode ? #21262d : #f6f8fa) : transparent;
    border-width: 0px;

    // Keep Usher's underline selection treatment, but use GitHub's 16 px
    // Octicons and inline icon/label/count geometry. Center the content group
    // inside the fixed tab width so left/right padding stays balanced.
    private property <length> count-badge-width: max(22px, count-label.preferred-width + 12px);
    private property <length> content-width: 16px + 10px + tab-label.preferred-width + 10px + root.count-badge-width;
    private property <length> content-x: max(0px, (root.width - root.content-width) / 2);

    Image {
        x: root.content-x;
        y: 16px;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    }
    tab-label := MaterialText {
        x: root.content-x + 26px;
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        text: root.label;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        vertical-alignment: center;
    }
    Rectangle {
        x: tab-label.x + tab-label.width + 10px;
        y: 14px;
        width: root.count-badge-width;
        height: 20px;
        border-radius: 10px;
        background: AppState.effective-dark-mode ? #6e768166 : #afb8c133;
        count-label := MaterialText {
            width: parent.width;
            height: parent.height;
            text: root.count;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 11px;
            font-weight: 600;
            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        }
    }
    Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.selected ? #fd8c73 : transparent;
    }
    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CommitRangeButton inherits Rectangle {
    in property <string> text: "All commits";
    callback clicked();

    width: max(132px, range-label.preferred-width + 66px);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: range-touch.has-hover
        ? (AppState.effective-dark-mode ? #21262d : #f3f4f6)
        : (AppState.effective-dark-mode ? #151b23 : #f6f8fa);

    Image {
        x: 12px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-stack-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }
    range-label := MaterialText {
        x: 36px;
        y: 0px;
        width: min(self.preferred-width, parent.width - 62px);
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: 500;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 24px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }
    range-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component MergeReadinessBadge inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <string> detail;
    // Trailing-edge badges open with ActionMenu `align: end`. Leading-edge
    // compact headers use `align: start` so a wide overlay does not flush the
    // window's left margin.
    in property <bool> popup-align-end: true;
    // Workspace modals disable the badge and close any open detail so the
    // in-window popover cannot outlive the scrim.
    in property <bool> interactions-enabled: true;
    in property <bool> popup-open: false;
    in property <color> background-color;
    in property <color> badge-border-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    in property <color> success-color;
    in property <color> attention-color;
    in property <color> danger-color;
    in property <color> done-color;
    private property <color> state-color: root.kind == "ready"
        ? root.success-color
        : (root.kind == "merged"
            ? root.done-color
            : ((root.kind == "conflicts" || root.kind == "changes_requested" || root.kind == "checks_failed" || root.kind == "closed")
                ? root.danger-color
                : ((root.kind == "review_required" || root.kind == "checks_pending" || root.kind == "branch_out_of_date" || root.kind == "discussions_unresolved" || root.kind == "blocked")
                    ? root.attention-color
                    : root.muted-color)));
    private property <string> state-symbol: root.kind == "ready" || root.kind == "merged"
        ? "✓"
        : ((root.kind == "conflicts" || root.kind == "changes_requested" || root.kind == "checks_failed" || root.kind == "closed")
            ? "×"
            : ((root.kind == "checking" || root.kind == "unavailable") ? "…" : "!"));

    // Primer Button medium + leadingVisual geometry: 12px inline padding, 16px
    // icon, 8px gap. Do not floor the width — GitHub hugs the label ("Merged").
    width: min(320px, label-text.preferred-width + 48px);
    height: 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.badge-border-color;
    background: badge-touch.has-hover ? (AppState.effective-dark-mode ? #656c7633 : #818b981f) : root.background-color;

    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.state-color;
        MaterialText {
            width: parent.width;
            height: parent.height;
            text: root.state-symbol;
            horizontal_alignment: center;
            vertical_alignment: center;
            font_size: 12px;
            font_weight: 700;
            color: #ffffff;
        }
    }
    // SF/Segoe's rendered glyph box sits slightly above its nominal line box.
    // Apply this once here so every readiness label (ready, conflicts, merged,
    // checks, and review states) shares the same visual centerline.
    label-text := Text {
        x: 36px;
        y: (parent.height - self.height) / 2 + 1px;
        width: min(self.preferred-width, parent.width - self.x - 12px);
        height: 20px;
        text: root.label;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: 600;
        color: root.foreground-color;
        overflow: elide;
    }
    badge-touch := TouchArea {
        enabled: root.interactions-enabled;
        mouse-cursor: root.interactions-enabled ? pointer : default;
        clicked => { root.toggle-popup(); }
    }
    callback toggle-popup();

    // Primer Overlay/ActionMenu metrics: spacer-3 (16px) padding, large radius
    // (12px), max width ~320px.
    popup-measure-title := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.label;
        font-size: 14px;
        font-weight: 600;
    }
    popup-measure-detail := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.detail;
        font-size: 12px;
    }
    private property <length> popup-width: min(
        320px,
        max(
            popup-measure-title.preferred-width + 52px,
            popup-measure-detail.preferred-width + 32px
        )
    );
    popup-measure-detail-wrapped := Text {
        x: 0px;
        y: 0px;
        width: root.popup-width - 32px;
        height: self.preferred-height;
        opacity: 0;
        text: root.detail;
        wrap: word-wrap;
        font-size: 12px;
    }
    private property <length> popup-height: 16px + 28px + 8px + max(20px, popup-measure-detail-wrapped.preferred-height) + 16px;

    readiness-popup := Rectangle {
        // Compact headers sit near the left edge: open start-aligned so the
        // overlay grows rightward with the usual page gutter. Wide headers pin
        // the badge to the trailing edge: open end-aligned like Primer ActionMenu.
        x: root.popup-align-end ? root.width - root.popup-width : 0px;
        y: root.height + 4px;
        width: root.popup-width;
        height: root.popup-height;
        visible: root.popup-open && root.interactions-enabled;
        z: 10000;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.badge-border-color;
            background: root.background-color;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 6px;

            Rectangle {
                x: 16px;
                y: 18px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.state-color;
                MaterialText {
                    width: parent.width;
                    height: parent.height;
                    text: root.state-symbol;
                    horizontal_alignment: center;
                    vertical_alignment: center;
                    font_size: 13px;
                    font_weight: 700;
                    color: #ffffff;
                }
            }
            MaterialText {
                x: 44px;
                y: 12px;
                width: parent.width - 60px;
                height: 28px;
                text: root.label;
                vertical_alignment: center;
                font_size: 14px;
                font_weight: 600;
                color: root.foreground-color;
            }
            MaterialText {
                x: 16px;
                y: 48px;
                width: parent.width - 32px;
                height: parent.height - 64px;
                text: root.detail;
                vertical_alignment: top;
                wrap: word-wrap;
                font_size: 12px;
                color: root.muted-color;
            }
        }
    }
}

component PrReviewBackButton inherits Rectangle {
    // Parents host the tip as a later, high-z sibling. A nested tip still loses
    // to following header chrome (summary Open badge, readiness strip) even when
    // this root has a higher z—overflow is not elevated with the button box.
    in property <bool> embed-tooltip: true;
    in property <string> tooltip-text: "Back to pull requests";
    out property <bool> has-hover: back-touch.has-hover;
    callback clicked();

    z: 2;
    width: 36px;
    height: 36px;
    background: transparent;
    clip: false;

    button-surface := Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: back-touch.has-hover
            ? MaterialPalette.surface_container_high
            : transparent;

        Image {
            x: 10px;
            y: 10px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/octicon-arrow-left-16.svg");
            colorize: MaterialPalette.on_surface;
        }
    }

    back-touch := TouchArea {
        width: button-surface.width;
        height: button-surface.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Optional embedded tip for callers that already elevate their own host.
    if root.embed-tooltip && back-touch.has-hover: ToolTip {
        x: 0px;
        y: root.height + 4px;
        text: root.tooltip-text;
    }
}

component HeaderActionStrip inherits Rectangle {
    in property <string> readiness-kind;
    in property <string> readiness-label;
    in property <string> readiness-detail;
    in property <string> remote-review-state;
    in property <bool> show-readiness: true;
    // Wide headers pin actions to the trailing edge; narrow headers keep them
    // left-aligned beside the back link like GitHub's compact PR header.
    in property <bool> align-start: false;
    in property <bool> action-loading: false;
    in property <bool> can-comment: false;
    in property <bool> can-approve: false;
    in property <bool> can-request-changes: false;
    in property <bool> can-merge: false;
    in property <bool> can-revert: false;
    // When a workspace modal is open, freeze header actions so popovers and
    // hover tips cannot outlive the scrim.
    in property <bool> actions-enabled: true;
    in property <bool> readiness-popup-open: false;
    in property <string> revert-action-label: "Revert pull request";
    in property <string> merge-block-reason;
    in property <color> background-color;
    in property <color> outline-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    in property <color> success-color;
    in property <color> attention-color;
    in property <color> danger-color;
    in property <color> done-color;
    callback review();
    callback merge();
    callback revert();
    callback toggle-readiness-popup();

    private property <bool> terminal-state:
        root.readiness-kind == "merged" || root.readiness-kind == "closed";

    height: 36px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 12px;
        // Wide strips need stretch so the leading spacer pushes all actions
        // against the trailing edge. Compact strips intentionally retain
        // start alignment beside the back link.
        alignment: root.align-start ? start : stretch;
        if !root.align-start: Rectangle { horizontal-stretch: 1; }
        if root.show-readiness && root.readiness-label != "": Rectangle {
            width: readiness-badge.width;
            height: parent.height;
            readiness-badge := MergeReadinessBadge {
                y: (parent.height - self.height) / 2;
                kind: root.readiness-kind;
                label: root.readiness-label;
                detail: root.readiness-detail;
                // Compact (align-start) headers keep the badge near the left
                // gutter; open the overlay start-aligned so it cannot flush the
                // window edge. Wide strips keep ActionMenu end alignment.
                popup-align-end: !root.align-start;
                interactions-enabled: root.actions-enabled;
                popup-open: root.readiness-popup-open;
                background-color: root.background-color;
                badge-border-color: root.outline-color;
                foreground-color: root.foreground-color;
                muted-color: root.muted-color;
                success-color: root.success-color;
                attention-color: root.attention-color;
                danger-color: root.danger-color;
                done-color: root.done-color;
                toggle-popup => { root.toggle-readiness-popup(); }
            }
        }
        if !root.terminal-state && (root.remote-review-state == "review_approved" || root.remote-review-state == "approved"): Rectangle {
            width: 88px;
            height: parent.height;
            MaterialText {
                width: parent.width;
                height: parent.height;
                text: "✓  Approved";
                font-family: "Hiragino Sans GB";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: 600;
                color: root.success-color;
            }
        }
        if !root.terminal-state: Rectangle {
            width: 120px;
            height: parent.height;
            ReviewActionButton {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: "Review changes";
                tooltip-align-start: root.align-start;
                button-enabled: root.actions-enabled && !root.action-loading && (root.can-comment || root.can-approve || root.can-request-changes);
                tooltip-text: root.can-comment || root.can-approve || root.can-request-changes
                    ? "Comment, approve, or request changes"
                    : "Configure provider credentials to submit a review";
                clicked => { root.review(); }
            }
        }
        if !root.terminal-state: Rectangle {
            width: 172px;
            height: parent.height;
            ReviewActionButton {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text: root.action-loading ? "Working…" : "Merge pull request";
                success: true;
                show-chevron: true;
                tooltip-align-start: root.align-start;
                button-enabled: root.actions-enabled && !root.action-loading && root.can-merge;
                tooltip-text: root.can-merge ? "Choose a merge method" : root.merge-block-reason;
                clicked => { root.merge(); }
            }
        }
        if root.readiness-kind == "merged" && root.can-revert: Rectangle {
            // Prefer a visible Primer-style secondary button on the same row as
            // the readiness control over GitHub's kebab ActionMenu, so the full
            // provider label stays readable without a truncated overflow item.
            width: revert-action.width;
            height: parent.height;
            revert-action := ReviewActionButton {
                y: (parent.height - self.height) / 2;
                hug-content: true;
                tooltip-align-start: root.align-start;
                text: root.action-loading ? "Working…" : root.revert-action-label;
                button-enabled: root.actions-enabled && !root.action-loading;
                tooltip-text: "Reverse the changes from this merged pull request";
                clicked => { root.revert(); }
            }
        }
    }
}

component ReviewChoice inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected: false;
    in property <bool> choice-enabled: true;
    callback chosen();

    height: 58px;
    border-radius: 6px;
    background: choice-touch.has-hover && root.choice-enabled
        ? (AppState.effective-dark-mode ? #21262d : #f6f8fa)
        : transparent;
    opacity: root.choice-enabled ? 1 : 0.48;

    Rectangle {
        x: 12px;
        y: 14px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.selected ? #0969da : (AppState.effective-dark-mode ? #6e7681 : #8c959f);
        background: root.selected ? #0969da : transparent;
        if root.selected: Rectangle {
            x: 5px;
            y: 5px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffffff;
        }
    }
    MaterialText {
        x: 40px;
        y: 8px;
        width: parent.width - 52px;
        height: 22px;
        text: root.title;
        font_size: 13px;
        font_weight: 600;
        color: MaterialPalette.on_surface;
        vertical_alignment: center;
    }
    MaterialText {
        x: 40px;
        y: 30px;
        width: parent.width - 52px;
        height: 20px;
        text: root.description;
        font_size: 11px;
        color: MaterialPalette.on_surface_variant;
        vertical_alignment: center;
        overflow: elide;
    }
    choice-touch := TouchArea {
        enabled: root.choice-enabled;
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

component TreeIndentGuides inherits Rectangle {
    in property <int> depth: 0;
    background: transparent;
    border-width: 0px;
    if root.depth > 0: Rectangle { x: 15px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 1: Rectangle { x: 33px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 2: Rectangle { x: 51px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 3: Rectangle { x: 69px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 4: Rectangle { x: 87px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 5: Rectangle { x: 105px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
}

// GitHub Commits kebab: bordered muted pill; accent fill + icon when expanded.
// Clicks must only toggle the message body — never open commit detail.
component CommitMessageToggleButton inherits Rectangle {
    in property <bool> expanded: false;
    out property <bool> has-hover: toggle-touch.has-hover;
    callback clicked();

    private property <color> accent-fg: AppState.effective-dark-mode ? #58a6ff : #0969da;
    private property <color> accent-bg: AppState.effective-dark-mode ? #388bfd1a : #ddf4ff;
    private property <color> accent-bg-hover: AppState.effective-dark-mode ? #388bfd33 : #b6e3ff;
    private property <color> accent-border: AppState.effective-dark-mode ? #388bfd66 : #54aeff66;
    private property <color> idle-fg: AppState.effective-dark-mode ? #9198a1 : #59636e;
    private property <color> idle-border: AppState.effective-dark-mode ? #3d444d : #d0d7de;
    private property <color> idle-bg: AppState.effective-dark-mode ? #21262d : #f6f8fa;
    private property <color> idle-bg-hover: AppState.effective-dark-mode ? #656c7633 : #eaeef2;

    // Above sibling title/row hit targets in the commit row.
    z: 2;
    width: 28px;
    height: 20px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.expanded ? root.accent-border : root.idle-border;
    // Expanded = Primer accent-muted selected chip (GitHub commits list).
    background: root.expanded
        ? (toggle-touch.has-hover ? root.accent-bg-hover : root.accent-bg)
        : (toggle-touch.has-hover ? root.idle-bg-hover : root.idle-bg);

    Image {
        // 12px Octicon in the 20px chip matches GitHub's compact control.
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        image-fit: contain;
        colorize: root.expanded ? root.accent-fg : root.idle-fg;
    }
    toggle-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if toggle-touch.has-hover: ToolTip {
        y: -self.height - 4px;
        text: root.expanded ? "Hide commit description" : "Show commit description";
    }
}

component FileToolbarButton inherits Rectangle {
    in property <image> icon-source;
    in property <bool> button-enabled: true;
    in property <bool> selected: false;
    in property <string> tooltip-text;
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    out property <bool> has-hover: button-touch.has-hover;
    callback clicked();

    width: 30px;
    height: 46px;
    background: transparent;

    button-surface := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 28px;
        border-radius: 6px;
        border-width: 0px;
        border-color: MaterialPalette.outline_variant;
        background: root.selected
            ? (button-touch.has-hover
                ? (AppState.effective-dark-mode ? #656c7626 : #eff2f5)
                : (AppState.effective-dark-mode ? #656c7633 : #e6eaef))
            : (button-touch.has-hover && root.button-enabled ? MaterialPalette.surface_container_high : transparent);
        opacity: root.button-enabled ? 1 : 0.38;

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon-source;
            image-fit: contain;
        }
    }
    button-touch := TouchArea {
        y: button-surface.y;
        height: button-surface.height;
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if root.button-enabled { root.clicked(); }
        }
    }
    if button-touch.has-hover && root.tooltip-text != "": ToolTip {
        x: root.tooltip-align-right ? root.width - self.width : 0px;
        // List delegates paint in order. A downward tooltip from a commit-row
        // copy action would therefore be covered by the following row, even
        // though ToolTip itself has a high local z-order.
        y: root.tooltip-above ? -self.height - 4px : root.height + 4px;
        text: root.tooltip-text;
    }
}

component CommitSummaryNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> icon-after: false;
    in property <bool> button-enabled: true;
    in property <bool> draw-divider: false;
    callback clicked();

    height: 28px;
    background: nav-touch.has-hover && root.button-enabled
        ? (AppState.effective-dark-mode ? #656c7626 : #f3f4f6)
        : transparent;
    opacity: root.button-enabled ? 1 : 0.5;

    if root.draw-divider: Rectangle {
        x: 0px;
        width: 1px;
        height: parent.height;
        background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 4px;
        alignment: center;
        cross-axis-alignment: center;

        if !root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
        MaterialText {
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            vertical-alignment: center;
        }
        if root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if root.button-enabled {
                root.clicked();
            }
        }
    }
}

// Shared by the Files changed tree and the selected-file toolbar so both
// surfaces use the same Primer status Octicon for a given change type.
component FileChangeTypeIcon inherits Image {
    in property <string> change-type: "edit_file";
    in property <color> muted-fg;
    in property <color> success-fg;
    in property <color> danger-fg;
    in property <color> attention-fg;

    width: 14px;
    height: 14px;
    source: root.change-type == "new_file"
        ? @image-url("../../assets/icons/octicon-file-added-16.svg")
        : (root.change-type == "deleted_file"
            ? @image-url("../../assets/icons/octicon-file-removed-16.svg")
            : (root.change-type == "renamed_file"
                ? @image-url("../../assets/icons/octicon-file-moved-16.svg")
                : @image-url("../../assets/icons/octicon-file-diff-16.svg")));
    image-fit: contain;
    colorize: root.change-type == "new_file"
        ? root.success-fg
        : (root.change-type == "deleted_file"
            ? root.danger-fg
            : (root.change-type == "renamed_file"
                ? root.attention-fg
                : root.muted-fg));
}

// Primer ToggleSwitch `size="small"` (48×24). Medium is 64×32; the Files
// changed toolbar is dense, so small matches GitHub's PR chrome.
component GitHubToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 48px;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.checked
        ? transparent
        : (AppState.effective-dark-mode ? #3d444d : #d1d9e0);
    background: root.checked
        ? (toggle-touch.has-hover
            ? (AppState.effective-dark-mode ? #1f6feb : #0860ca)
            : (AppState.effective-dark-mode ? #1f6feb : #0969da))
        : (toggle-touch.has-hover
            ? (AppState.effective-dark-mode ? #262c36 : #dde3ea)
            : (AppState.effective-dark-mode ? #21262d : #eaeef2));
    clip: true;

    // Knob is half the track, inset 1px — Primer `.ToggleKnob`.
    Rectangle {
        x: root.checked ? parent.width - self.width - 1px : 1px;
        y: 1px;
        width: (parent.width - 2px) / 2;
        height: parent.height - 2px;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.checked
            ? (AppState.effective-dark-mode ? #1f6feb : #0969da)
            : (AppState.effective-dark-mode ? #3d444d : #858f99);
        background: AppState.effective-dark-mode ? #f0f6fc : #ffffff;
    }

    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component FileTreeToggleButton inherits Rectangle {
    in property <bool> file-tree-visible: true;
    callback clicked();

    width: 32px;
    height: 46px;
    background: transparent;

    button-surface := Rectangle {
        y: 7px;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: root.file-tree-visible
            ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
            : (toggle-touch.has-hover
                ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                : transparent);
        Image {
            x: 8px;
            y: 8px;
            width: 16px;
            height: 16px;
            source: root.file-tree-visible
                ? @image-url("../../assets/icons/octicon-sidebar-collapse-16.svg")
                : @image-url("../../assets/icons/octicon-sidebar-expand-16.svg");
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }

    toggle-touch := TouchArea {
        y: button-surface.y;
        width: button-surface.width;
        height: button-surface.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if toggle-touch.has-hover: ToolTip {
        x: 0px;
        y: root.height + 4px;
        text: root.file-tree-visible ? "Hide file tree" : "Show file tree";
    }
}

component FileMenuButton inherits Rectangle {
    in property <bool> button-enabled: true;
    in property <bool> viewing-file: false;
    in property <bool> open: false;
    callback action();
    callback toggle-menu();

    width: 30px;
    height: 46px;

    FileToolbarButton {
        width: parent.width;
        height: parent.height;
        icon-source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        button-enabled: root.button-enabled;
        selected: root.open;
        tooltip-text: "More file actions";
        tooltip-align-right: true;
        clicked => { root.toggle-menu(); }
    }

    menu-popup := Rectangle {
        x: root.width - self.width;
        y: root.height - 4px;
        width: 192px;
        height: 52px;
        visible: root.open;
        z: 10000;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            background: AppState.effective-dark-mode ? #151b23 : #ffffff;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 6px;

            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 36px;
                border-radius: 8px;
                background: view-file-touch.has-hover
                    ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-eye-16.svg");
                    image-fit: contain;
                    colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                }
                MaterialText {
                    x: 48px;
                    width: parent.width - 64px;
                    height: parent.height;
                    text: root.viewing-file ? "View diff" : "View file";
                    vertical_alignment: center;
                    font-size: 14px;
                    font-weight: 400;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }
                view-file-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action();
                    }
                }
            }

        }
    }
}

component DiffStatSegment inherits Rectangle {
    in property <string> kind: "neutral";
    width: 8px;
    height: 8px;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.kind == "added"
            ? (AppState.effective-dark-mode
                ? @image-url("../../assets/icons/github-diffstat-added-dark-8.svg")
                : @image-url("../../assets/icons/github-diffstat-added-8.svg"))
            : (root.kind == "deleted"
                ? (AppState.effective-dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-deleted-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-deleted-8.svg"))
                : (AppState.effective-dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-neutral-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-neutral-8.svg")));
    }
}

component DiffStatBar inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    private property <int> total: root.additions + root.deletions;
    // GitHub assigns whole fifths independently. Any fractional remainder is
    // intentionally rendered as a neutral block rather than rounded up.
    private property <int> added-blocks: root.total == 0 ? 0 : Math.floor(root.additions * 5 / root.total);
    private property <int> deleted-blocks: root.total == 0 ? 0 : Math.floor(root.deletions * 5 / root.total);
    width: 44px;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 8px;
        spacing: 1px;
        DiffStatSegment { kind: root.added-blocks > 0 ? "added" : (root.deleted-blocks > 0 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 1 ? "added" : (root.added-blocks + root.deleted-blocks > 1 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 2 ? "added" : (root.added-blocks + root.deleted-blocks > 2 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 3 ? "added" : (root.added-blocks + root.deleted-blocks > 3 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 4 ? "added" : (root.added-blocks + root.deleted-blocks > 4 ? "deleted" : "neutral"); }
    }
}

component FileDiffStat inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    in property <bool> has-selection: true;
    in property <string> font-family: ".SF NS";

    width: diffstat-bar.x + diffstat-bar.width;
    height: 46px;
    horizontal-stretch: 0;
    background: transparent;
    accessible-role: none;

    added-stat := Text {
        x: 0px;
        // Align the rendered glyph bounds with the centered 8px diff-stat blocks.
        y: (parent.height - self.height) / 2 - 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "+" + root.additions : "";
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 12px;
        font-weight: 600;
        color: AppState.effective-dark-mode ? #3fb950 : #1f883d;
    }

    removed-stat := Text {
        x: added-stat.x + added-stat.width + 4px;
        y: (parent.height - self.height) / 2 - 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "−" + root.deletions : "";
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 12px;
        font-weight: 600;
        color: AppState.effective-dark-mode ? #f85149 : #cf222e;
    }

    diffstat-bar := DiffStatBar {
        x: removed-stat.x + removed-stat.width + 4px;
        y: (parent.height - self.height) / 2;
        additions: root.additions;
        deletions: root.deletions;
    }
}

component CodeRenderingIndicator inherits Rectangle {
    width: 166px;
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: AppState.effective-dark-mode ? #151b23 : #ffffff;
    drop-shadow-blur: 14px;
    drop-shadow-color: AppState.effective-dark-mode ? #00000066 : #1f232826;
    drop-shadow-offset-y: 4px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 13px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            width: 16px;
            height: parent.height;
            background: transparent;

            private property <float> rotation-progress: mod(animation-tick(), 900ms) / 900ms;

            Image {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 16px;
                source: @image-url("../../assets/icons/loading.svg");
                image-fit: contain;
                colorize: MaterialPalette.primary;
                transform-rotation: parent.rotation-progress * 360deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
        }

        MaterialText {
            text: "Rendering code";
            vertical-alignment: center;
            font-family: "Hiragino Sans GB";
            font-size: 12px;
            font-weight: 600;
            color: MaterialPalette.on_surface;
        }
    }
}

component GitHubFileFilterField inherits Rectangle {
    in-out property <string> text;
    in property <string> font-family: ".SF NS";

    height: 32px;
    border-radius: 6px;
    border-width: filter-input.has-focus ? 2px : 1px;
    border-color: filter-input.has-focus
        ? (AppState.effective-dark-mode ? #4493f8 : #0969da)
        : (AppState.effective-dark-mode ? #3d444d : #d1d9e0);
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    clip: true;

    Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-search-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }

    filter-input := TextInput {
        x: 32px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text <=> root.text;
        single-line: true;
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        selection-background-color: AppState.effective-dark-mode ? #388bfd66 : #0969da55;
        selection-foreground-color: self.color;
    }

    if root.text == "": Text {
        x: 32px;
        width: parent.width - 40px;
        height: parent.height;
        text: "Filter files…";
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }
}

component GitHubFilterMenu inherits Rectangle {
    in property <[WorkflowPrFileExtensionFilter]> extension-filters: [];
    in property <bool> only-manifest-files: false;
    in property <bool> show-viewed-files: true;
    in property <string> font-family: ".SF NS";
    in property <bool> open: false;
    callback toggle-extension(string);
    callback toggle-manifest();
    callback toggle-viewed();

    width: 34px;
    height: 34px;
    background: transparent;

    filter-popup := Rectangle {
        x: 0px;
        y: root.height + 6px;
        width: 224px;
        height: 53px + min(root.extension-filters.length * 36px, 252px) + 1px + 72px;
        visible: root.open;
        z: 10000;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            background: AppState.effective-dark-mode ? #151b23 : #ffffff;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 6px;
            clip: true;

            Text {
                x: 16px;
                y: 0px;
                width: parent.width - 32px;
                height: 53px;
                text: "File extensions";
                vertical-alignment: center;
                font-family: root.font-family;
                font-size: 14px;
                font-weight: 600;
                color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            }

            extension-list := ListView {
                x: 0px;
                y: 53px;
                width: parent.width;
                height: min(root.extension-filters.length * 36px, 252px);
                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                vertical_scrollbar_policy: root.extension-filters.length > 7 ? ScrollBarPolicy.as_needed : ScrollBarPolicy.always_off;
                for extension in root.extension-filters: Rectangle {
                    width: extension-list.visible_width;
                    height: 36px;
                    background: extension-touch.has-hover
                        ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                        : transparent;
                    Image {
                        x: 16px;
                        y: 10px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-check-16.svg");
                        image-fit: contain;
                        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                        opacity: extension.selected ? 1 : 0;
                    }
                    Text {
                        x: 48px;
                        width: parent.width - 96px;
                        height: parent.height;
                        text: extension.extension;
                        vertical-alignment: center;
                        font-family: root.font-family;
                        font-size: 14px;
                        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 48px;
                        y: 8px;
                        width: 32px;
                        height: 20px;
                        border-radius: 10px;
                        background: AppState.effective-dark-mode ? #656c7633 : #818b981f;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: extension.count;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-family: root.font-family;
                            font-size: 12px;
                            font-weight: 600;
                            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                        }
                    }
                    extension-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-extension(extension.extension); }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: 53px + extension-list.height;
                width: parent.width;
                height: 1px;
                background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            }

            for option[index] in ["Only manifest files", "Viewed files"]: Rectangle {
                x: 0px;
                y: 54px + extension-list.height + index * 36px;
                width: parent.width;
                height: 36px;
                background: option-touch.has-hover
                    ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-16.svg");
                    image-fit: contain;
                    colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                    opacity: (index == 0 ? root.only-manifest-files : root.show-viewed-files) ? 1 : 0;
                }
                Text {
                    x: 48px;
                    width: parent.width - 64px;
                    height: parent.height;
                    text: option;
                    vertical-alignment: center;
                    font-family: root.font-family;
                    font-size: 14px;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }
                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if index == 0 { root.toggle-manifest(); }
                        else { root.toggle-viewed(); }
                    }
                }
            }
        }
    }
}

export component PrReviewWorkspace inherits Rectangle {
    in property <bool> live-resizing: false;
    in property <string> project-name;
    in property <string> provider;
    in property <string> pull-request-number;
    in property <string> pull-request-title;
    in property <string> author;
    in property <string> source-branch;
    in property <string> target-branch;
    in property <string> updated-at;
    in property <string> updated-at-tooltip;
    in property <int> added-lines: 0;
    in property <int> removed-lines: 0;
    in property <int> commit-count: 0;
    in property <int> conversation-count: 0;
    in property <string> base-sha;
    in property <string> head-sha;
    in property <bool> too-many-commits: false;
    in-out property <int> selected-tab: 2;
    in property <string> back-label: "Back to pull requests";
    in property <[WorkflowPrConversationItem]> conversation-items: [];
    in property <int> conversation-content-height: 0;
    in property <[WorkflowPrCommit]> commits: [];
    in property <bool> conversation-loading: false;
    in property <bool> commits-loading: false;
    in property <string> conversation-error: "";
    in property <string> commits-error: "";
    in property <int> commit-range-start: -1;
    in property <int> commit-range-end: -1;
    in property <string> commit-range-label: "All commits";
    in property <[WorkflowPrDiffFile]> files: [];
    in property <[WorkflowPrTreeItem]> tree-items: [];
    in property <[WorkflowPrFileExtensionFilter]> extension-filters: [];
    in property <bool> only-manifest-files: false;
    in property <bool> show-viewed-files: true;
    in property <bool> file-filters-active: false;
    in property <[WorkflowPrDiffLine]> lines: [];
    in property <int> max-code-columns: 0;
    in property <string> longest-code-line;
    in property <int> line-model-revision: 0;
    in property <int> selected-file-index: -1;
    in property <string> selected-file-path;
    in property <int> selected-file-added-lines: 0;
    in property <int> selected-file-removed-lines: 0;
    private property <string> selected-file-change-type:
        root.selected-file-index >= 0 && root.selected-file-index < root.files.length
            ? root.files[root.selected-file-index].change-type
            : "edit_file";
    in property <bool> has-expandable-hunks: false;
    in property <bool> context-expanded: false;
    in property <bool> viewing-file: false;
    in property <bool> loading: false;
    in property <bool> code-loading: false;
    in property <string> error-text;
    in property <bool> ignore-whitespace-supported: false;
    in-out property <bool> ignore-whitespace: false;
    in-out property <string> file-filter: "";
    in-out property <bool> review-dialog-open: false;
    in-out property <bool> merge-dialog-open: false;
    in-out property <bool> revert-dialog-open: false;
    in-out property <bool> commit-range-dialog-open: false;
    in property <bool> action-loading: false;
    in property <bool> can-comment: false;
    in property <bool> can-approve: false;
    in property <bool> can-request-changes: false;
    in property <string> remote-review-state: "";
    in property <bool> can-merge: false;
    in property <bool> can-revert: false;
    in property <string> merge-readiness-kind: "";
    in property <string> merge-readiness-label: "";
    in property <string> merge-readiness-detail: "";
    in property <string> merge-block-reason: "";
    in property <string> revert-block-reason: "";
    in property <string> revert-action-label: "Revert changes";
    in property <string> revert-confirmation: "";
    in property <bool> merge-method-merge: false;
    in property <bool> merge-method-squash: false;
    in property <bool> merge-method-rebase: false;
    in property <bool> merge-method-fast-forward: false;
    in-out property <length> file-list-preferred-width: 286px;
    in property <string> tree-font-family: ".SF NS";
    private property <length> file-list-min-width: 220px;
    private property <length> file-list-max-width: max(root.file-list-min-width, min(520px, root.width * 0.45));
    // Preserve the session preference while clamping the rendered width when
    // the window becomes narrower.
    private property <length> file-list-width: max(root.file-list-min-width, min(root.file-list-max-width, root.file-list-preferred-width));
    private property <bool> file-list-resizing: false;
    private property <length> file-list-drag-start-width: root.file-list-width;
    // Session preference while the window is wide enough for the tree.
    private property <bool> file-list-user-visible: true;
    private property <bool> show-single-commit-summary:
        root.commit-range-start >= 0
            && root.commit-range-start == root.commit-range-end
            && root.commit-range-start < root.commits.length;
    // Rust registers GitHub's preferred macOS monospace face (SFMono-Regular)
    // at startup. Menlo remains the explicit fallback when that system font is
    // unavailable; Slint 1.17 accepts one family name rather than a CSS stack.
    in property <string> code-font-family: "Menlo";
    private property <length> code-font-size: 13px;
    private property <length> code-line-height: 22px;
    private property <length> hunk-line-height: 26px;
    // GitHub Commits tab: one shared card per UTC+08:00 date group.
    // Match Primer Box-row density (~16px vertical padding) and the gap
    // under "Commits on …" before the bordered card.
    private property <length> commit-tab-row-height: 72px;
    private property <length> commit-tab-group-header-height: 44px;
    private property <length> commit-tab-content-x: 16px;
    private property <length> commit-tab-content-y: 12px;
    private property <length> commit-tab-card-radius: 6px;
    // Expanded: title band + body + author footer (avatar). Collapsed is 72px.
    private property <length> commit-tab-title-band: 36px;
    private property <length> commit-tab-author-band: 28px;
    private property <length> commit-tab-body-footer-gap: 8px;
    // Sum of expanded Conversation commit body heights (multi-expand).
    in property <int> expanded-commit-body-height: 0;
    private property <length> code-character-width: 7.8px;
    private property <length> measured-code-width:
        max(root.max-code-columns * root.code-character-width, longest-code-line-measure.preferred-width);
    // GitHub Primer functional tokens (primer/primitives:
    // src/tokens/functional/color/fgColor.json5) and DiffBlob tokens.
    private property <color> github-bg-default: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    private property <color> github-bg-muted: AppState.effective-dark-mode ? #151b23 : #f6f8fa;
    private property <color> github-border-default: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    private property <color> github-fg-default: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    private property <color> github-fg-muted: AppState.effective-dark-mode ? #9198a1 : #59636e;
    private property <color> github-success-fg: AppState.effective-dark-mode ? #3fb950 : #1a7f37;
    private property <color> github-danger-fg: AppState.effective-dark-mode ? #f85149 : #d1242f;
    private property <color> github-attention-fg: AppState.effective-dark-mode ? #d29922 : #9a6700;
    private property <color> github-done-fg: AppState.effective-dark-mode ? #ab7df8 : #8250df;
    private property <color> github-accent-fg: AppState.effective-dark-mode ? #58a6ff : #0969da;
    private property <color> github-accent-muted: AppState.effective-dark-mode ? #388bfd1a : #ddf4ff;
    private property <color> diff-addition-background: AppState.effective-dark-mode ? #2ea04326 : #dafbe1;
    private property <color> diff-addition-gutter-background: AppState.effective-dark-mode ? #3fb9504d : #aceebb;
    private property <color> diff-deletion-background: AppState.effective-dark-mode ? #f851491a : #ffebe9;
    private property <color> diff-deletion-gutter-background: AppState.effective-dark-mode ? #f851494d : #ffcecb;
    private property <color> hunk-background: root.github-accent-muted;
    private property <color> hunk-gutter-background: AppState.effective-dark-mode ? #0c2d6b : #b6e3ff;
    private property <color> hunk-foreground: root.github-fg-muted;
    private property <string> selected-review-action: "comment";
    private property <string> review-body: "";
    private property <string> conversation-comment-body: "";
    private property <string> pending-conversation-comment: "";
    private property <string> selected-merge-method: "merge";
    private property <bool> remove-source-branch: false;
    private property <int> draft-range-start: -1;
    private property <int> draft-range-end: -1;
    // Back tip is hosted on the header layer (not nested in the button) so the
    // summary Open badge and readiness strip cannot cover it.
    private property <bool> back-button-hovered: false;
    private property <length> back-button-size: 36px;
    private property <bool> modal-open:
        root.review-dialog-open
            || root.merge-dialog-open
            || root.revert-dialog-open
            || root.commit-range-dialog-open;
    // Lightweight menus share one in-window popover state. Native PopupWindow
    // grabs the pointer on macOS, suppressing underlay hover and consuming the
    // first click that should switch directly to another menu.
    private property <string> active-popover: "";
    private property <length> stable-layout-width: root.width;
    private property <length> stable-layout-height: root.height;
    // Primer `$width-md` (768px). GitHub's PR Files changed Layout uses
    // `Layout--flowRow-until-md` + `sidebarPosition-flowRow-none`, which sets
    // `.Layout-sidebar { display: none }` under `max-width: 767.98px`.
    private property <length> file-tree-collapse-breakpoint: 768px;
    private property <bool> file-list-below-breakpoint:
        root.stable-layout-width < root.file-tree-collapse-breakpoint;
    private property <bool> file-list-visible:
        !root.file-list-below-breakpoint && root.file-list-user-visible;
    private property <bool> compact-title-wraps:
        root.stable-layout-width - 48px < compact-title-measure.preferred-width;
    private property <bool> compact-summary-wraps:
        root.stable-layout-width - 48px < compact-summary-metrics.inline-width;
    // Wide header column: Primer back icon(36) + actions(640) +
    // padding(48) + two 16px gaps.
    private property <bool> wide-title-wraps:
        root.stable-layout-width - 756px < compact-title-measure.preferred-width;
    private property <bool> wide-summary-wraps:
        root.stable-layout-width - 756px < compact-summary-metrics.inline-width;
    // Estimate wrapped line count from the single-line preferred width. Do not
    // use Text.preferred-height for the visible title: it can stay on the
    // single-line metric and let the summary row cover later title lines.
    private property <length> compact-title-avail-width: max(1px, root.stable-layout-width - 48px);
    private property <int> compact-title-line-count: !root.compact-title-wraps ? 1
        : (compact-title-measure.preferred-width <= root.compact-title-avail-width * 2 ? 2 : 3);
    private property <length> wide-title-avail-width: max(1px, root.stable-layout-width - 756px);
    private property <int> wide-title-line-count: !root.wide-title-wraps ? 1
        : (compact-title-measure.preferred-width <= root.wide-title-avail-width * 2 ? 2 : 3);
    // ~30px per line for 22px Hiragino; 52px was short enough to clip "#N".
    private property <length> compact-title-block-height: root.compact-title-line-count == 1 ? 32px
        : (root.compact-title-line-count == 2 ? 60px : 88px);
    private property <length> wide-title-block-height: root.wide-title-line-count == 1 ? 30px
        : (root.wide-title-line-count == 2 ? 60px : 88px);
    private property <length> compact-title-height-extra: root.compact-title-line-count == 1 ? 0px
        : (root.compact-title-line-count == 2 ? 36px : 64px);
    private property <length> wide-title-height-extra: root.wide-title-line-count == 1 ? 0px
        : (root.wide-title-line-count == 2 ? 36px : 64px);

    callback back();
    callback select-tab(int);
    callback ensure-commits();
    callback apply-commit-range(int, int);
    callback open-commit(string);
    callback select-file(int);
    callback select-relative-file(int);
    callback reload(bool);
    callback submit-review(string, string);
    callback merge(string, bool);
    callback revert();
    callback filter-files(string);
    callback toggle-extension-filter(string);
    callback toggle-manifest-filter();
    callback toggle-viewed-files();
    callback toggle-folder(string);
    callback expand-hunk(int);
    callback expand-all-hunks();
    callback collapse-non-diff-lines();
    callback copy-file-path(string);
    callback copy-commit-sha(string);
    callback copy-source-branch(string);
    callback view-file();
    // Toggle one commit message body; expansions are independent (not exclusive).
    callback toggle-commit-message(string);

    function toggle-draft-commit(index: int) {
        if root.draft-range-start < 0 || root.draft-range-end < 0 {
            root.draft-range-start = index;
            root.draft-range-end = index;
            return;
        }

        let range-start = min(root.draft-range-start, root.draft-range-end);
        let range-end = max(root.draft-range-start, root.draft-range-end);
        if index < range-start {
            root.draft-range-start = index;
            root.draft-range-end = range-end;
        } else if index > range-end {
            root.draft-range-start = range-start;
            root.draft-range-end = index;
        } else if range-start == range-end {
            root.draft-range-start = -1;
            root.draft-range-end = -1;
        } else if index == range-start {
            root.draft-range-start = range-start + 1;
            root.draft-range-end = range-end;
        } else if index == range-end {
            root.draft-range-start = range-start;
            root.draft-range-end = range-end - 1;
        }
        // A commit inside a multi-commit range cannot be removed without
        // creating a gap, so keep the contiguous GitHub-style range intact.
    }

    changed file-filter => { root.filter-files(root.file-filter); }
    changed review-dialog-open => {
        if (root.review-dialog-open) {
            root.active-popover = "";
            root.selected-review-action = root.can-comment ? "comment" : (root.can-approve ? "approve" : "request_changes");
        }
    }
    changed remote-review-state => {
        // Clear the Conversation composer after a successful Comment submit.
        if root.remote-review-state == "commented" && root.pending-conversation-comment != "" {
            root.conversation-comment-body = "";
            root.pending-conversation-comment = "";
        }
    }
    changed merge-dialog-open => {
        if (root.merge-dialog-open) {
            root.active-popover = "";
            root.selected-merge-method = root.merge-method-merge ? "merge" : (root.merge-method-squash ? "squash" : (root.merge-method-rebase ? "rebase" : "fast_forward"));
        }
    }
    changed revert-dialog-open => {
        if root.revert-dialog-open {
            root.active-popover = "";
        }
    }
    changed commit-range-dialog-open => {
        if root.commit-range-dialog-open {
            root.active-popover = "";
            root.draft-range-start = root.commit-range-start;
            root.draft-range-end = root.commit-range-end;
        }
    }
    changed live-resizing => {
        // Snapshot the final pre-resize geometry before AppKit begins sending
        // continuous size updates. When resizing ends, adopt the final size once.
        root.stable-layout-width = root.width;
        root.stable-layout-height = root.height;
    }
    changed width => {
        if !root.live-resizing {
            root.stable-layout-width = root.width;
        }
    }
    changed height => {
        if !root.live-resizing {
            root.stable-layout-height = root.height;
        }
    }

    background: root.github-bg-default;
    border-width: 0px;
    clip: true;

    compact-title-measure := Text {
        visible: false;
        text: root.pull-request-title + " #" + root.pull-request-number;
        font-family: "Hiragino Sans GB";
        font-size: 22px;
        font-weight: 600;
    }
    compact-summary-metrics := PullRequestSummaryMetrics {
        state-kind: root.merge-readiness-kind;
        author: root.author;
        commit-count: root.commit-count;
        target-branch: root.target-branch;
        source-branch: root.source-branch;
        updated-at: root.updated-at;
    }

    // One off-screen font measurement keeps the horizontal scroll extent and
    // every row background on the same pixel width. Column-count estimates are
    // retained only as a fallback while the measured line is unavailable.
    longest-code-line-measure := Text {
        visible: false;
        text: root.longest-code-line;
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        overflow: clip;
    }

    // Consume clicks on non-interactive workspace areas so they cannot reach
    // the pull-request list retained underneath this full-window overlay.
    TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.active-popover = ""; }
    }

    VerticalLayout {
        width: root.stable-layout-width;
        height: root.stable-layout-height;
        spacing: 0px;

        Rectangle {
            width: parent.width;
            height: root.stable-layout-width < 1500px
                ? 124px
                    + root.compact-title-height-extra
                    + (root.compact-summary-wraps ? 32px : 0px)
                : (104px
                    + root.wide-title-height-extra
                    + (root.wide-summary-wraps ? 32px : 0px));
            // Keep action-button tooltips above the following files toolbar and
            // above the title/summary that are painted later in this band.
            z: 1;
            clip: false;
            background: root.github-bg-default;
            border-width: 0px;

            if root.stable-layout-width >= 1500px: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 24px;
                padding-right: 24px;
                // Pin actions to the title's first line (GitHub wide header).
                padding-top: 16px;
                spacing: 16px;
                // Keep default main-axis stretch so the title column expands;
                // alignment:start would collapse preferred-width:0 siblings and
                // leave Merged/Review/Merge stuck beside the back link.
                cross-axis-alignment: start;
                PrReviewBackButton {
                    // Tip is painted on the header layer below so Open/summary
                    // chrome cannot cover it; keep position under the icon.
                    embed-tooltip: false;
                    tooltip-text: root.back-label;
                    changed has-hover => {
                        root.back-button-hovered = self.has-hover;
                    }
                    clicked => { root.back(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    // Leave open so wrapped title and relative-time tooltips can
                    // escape like GitHub; title never uses ellipsis.
                    clip: false;
                    z: 0;
                    wide-title := Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: root.wide-title-block-height;
                        text: root.pull-request-title + " #" + root.pull-request-number;
                        font-family: "Hiragino Sans GB";
                        font-size: 22px;
                        font-weight: 600;
                        color: MaterialPalette.on_surface;
                        wrap: word-wrap;
                        overflow: clip;
                        vertical-alignment: top;
                    }
                    PullRequestSummaryRow {
                        x: 0px;
                        y: root.wide-title-block-height + 6px;
                        width: parent.width;
                        state-kind: root.merge-readiness-kind;
                        author: root.author;
                        commit-count: root.commit-count;
                        target-branch: root.target-branch;
                        source-branch: root.source-branch;
                        updated-at: root.updated-at;
                        updated-at-tooltip: root.updated-at-tooltip;
                        compact: false;
                        success-color: root.github-success-fg;
                        danger-color: root.github-danger-fg;
                        done-color: root.github-done-fg;
                        muted-color: root.github-fg-muted;
                        muted-background: root.github-bg-muted;
                        branch-background: root.github-accent-muted;
                        branch-foreground: AppState.effective-dark-mode ? #58a6ff : #0969da;
                        copy-source-branch(branch) => { root.copy-source-branch(branch); }
                    }
                }

                HeaderActionStrip {
                    // Trailing-edge strip: internal leading spacer pins controls
                    // to the window right on the title's first line. z above the
                    // title column so downward action tips are not covered.
                    z: 2;
                    width: 640px;
                    height: 36px;
                    readiness-kind: root.merge-readiness-kind;
                    readiness-label: root.merge-readiness-label;
                    readiness-detail: root.merge-readiness-detail;
                    remote-review-state: root.remote-review-state;
                    action-loading: root.action-loading;
                    actions-enabled: !root.modal-open;
                    readiness-popup-open: root.active-popover == "readiness";
                    can-comment: root.can-comment;
                    can-approve: root.can-approve;
                    can-request-changes: root.can-request-changes;
                    can-merge: root.can-merge;
                    can-revert: root.can-revert;
                    revert-action-label: root.revert-action-label;
                    merge-block-reason: root.merge-block-reason;
                    background-color: root.github-bg-default;
                    outline-color: root.github-border-default;
                    foreground-color: root.github-fg-default;
                    muted-color: root.github-fg-muted;
                    success-color: root.github-success-fg;
                    attention-color: root.github-attention-fg;
                    danger-color: root.github-danger-fg;
                    done-color: root.github-done-fg;
                    review => { root.review-dialog-open = true; }
                    merge => { root.merge-dialog-open = true; }
                    revert => { root.revert-dialog-open = true; }
                    toggle-readiness-popup => {
                        root.active-popover = root.active-popover == "readiness" ? "" : "readiness";
                    }
                }
            }

            if root.stable-layout-width < 1500px: Rectangle {
                width: parent.width;
                height: parent.height;
                clip: false;

                // One shared action row so the back control and readiness /
                // review / merge / revert buttons share the same vertical
                // centerline (the previous absolute y:-8 / y:2 offsets drifted).
                // z above title/summary so nested action ToolTips stay complete.
                HorizontalLayout {
                    z: 2;
                    x: 24px;
                    y: 8px;
                    width: parent.width - 48px;
                    height: 36px;
                    spacing: 12px;
                    cross-axis-alignment: center;

                    PrReviewBackButton {
                        // Tip is painted on the header layer below so Open/summary
                        // chrome cannot cover it; keep position under the icon.
                        embed-tooltip: false;
                        tooltip-text: root.back-label;
                        changed has-hover => {
                            root.back-button-hovered = self.has-hover;
                        }
                        clicked => { root.back(); }
                    }
                    HeaderActionStrip {
                        height: 36px;
                        horizontal-stretch: 1;
                        align-start: true;
                        show-readiness: true;
                        readiness-kind: root.merge-readiness-kind;
                        readiness-label: root.merge-readiness-label;
                        readiness-detail: root.merge-readiness-detail;
                        remote-review-state: root.remote-review-state;
                        action-loading: root.action-loading;
                        actions-enabled: !root.modal-open;
                        readiness-popup-open: root.active-popover == "readiness";
                        can-comment: root.can-comment;
                        can-approve: root.can-approve;
                        can-request-changes: root.can-request-changes;
                        can-merge: root.can-merge;
                        can-revert: root.can-revert;
                        revert-action-label: root.revert-action-label;
                        merge-block-reason: root.merge-block-reason;
                        background-color: root.github-bg-default;
                        outline-color: root.github-border-default;
                        foreground-color: root.github-fg-default;
                        muted-color: root.github-fg-muted;
                        success-color: root.github-success-fg;
                        attention-color: root.github-attention-fg;
                        danger-color: root.github-danger-fg;
                        done-color: root.github-done-fg;
                        review => { root.review-dialog-open = true; }
                        merge => { root.merge-dialog-open = true; }
                        revert => { root.revert-dialog-open = true; }
                        toggle-readiness-popup => {
                            root.active-popover = root.active-popover == "readiness" ? "" : "readiness";
                        }
                    }
                }
                compact-title := Text {
                    z: 0;
                    x: 24px;
                    y: 50px;
                    width: parent.width - 48px;
                    height: root.compact-title-block-height;
                    text: root.pull-request-title + " #" + root.pull-request-number;
                    font-family: "Hiragino Sans GB";
                    font-size: 22px;
                    font-weight: 600;
                    color: MaterialPalette.on_surface;
                    wrap: word-wrap;
                    overflow: clip;
                    vertical-alignment: top;
                }
                compact-summary-row := PullRequestSummaryRow {
                    z: 0;
                    x: 24px;
                    y: 50px + root.compact-title-block-height + 6px;
                    width: parent.width - 48px;
                    state-kind: root.merge-readiness-kind;
                    author: root.author;
                    commit-count: root.commit-count;
                    target-branch: root.target-branch;
                    source-branch: root.source-branch;
                    updated-at: root.updated-at;
                    updated-at-tooltip: root.updated-at-tooltip;
                    compact: true;
                    success-color: root.github-success-fg;
                    danger-color: root.github-danger-fg;
                    done-color: root.github-done-fg;
                    muted-color: root.github-fg-muted;
                    muted-background: root.github-bg-muted;
                    branch-background: root.github-accent-muted;
                    branch-foreground: AppState.effective-dark-mode ? #58a6ff : #0969da;
                    copy-source-branch(branch) => { root.copy-source-branch(branch); }
                }
            }

            // Header-layer tip: same below-icon placement, but declared last with
            // a high z so summary/readiness siblings cannot occlude it. Do not
            // change Material ToolTip or other feature tips.
            if root.back-button-hovered: ToolTip {
                z: 200;
                x: 24px;
                y: root.stable-layout-width >= 1500px
                    ? 16px + root.back-button-size + 4px
                    : 8px + root.back-button-size + 4px;
                text: root.back-label;
            }
        }

        Rectangle { width: parent.width; height: 1px; background: root.github-border-default; }

        Rectangle {
            width: parent.width;
            height: 48px;
            background: root.github-bg-default;
            HorizontalLayout {
                padding-left: 0px;
                spacing: 0px;
                PrTabButton {
                    label: "Conversation";
                    tab-width: 200px;
                    // Badge summaries load with the PR detail. Keep them independent
                    // from the lazily mounted Conversation payload.
                    count: root.conversation-count;
                    icon: @image-url("../../assets/icons/octicon-comment-discussion-16.svg");
                    selected: root.selected-tab == 0;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 0;
                        root.select-tab(0);
                    }
                }
                PrTabButton {
                    label: "Commits";
                    tab-width: 170px;
                    // Loading this tab must not be what makes its badge appear.
                    count: root.commit-count;
                    icon: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                    selected: root.selected-tab == 1;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 1;
                        root.select-tab(1);
                    }
                }
                PrTabButton {
                    label: "Files changed";
                    tab-width: 210px;
                    count: root.files.length;
                    icon: @image-url("../../assets/icons/octicon-file-diff-16.svg");
                    selected: root.selected-tab == 2;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 2;
                        root.select-tab(2);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                FileDiffStat {
                    height: parent.height;
                    additions: root.added-lines;
                    deletions: root.removed-lines;
                    has-selection: true;
                    font-family: root.tree-font-family;
                }
                Rectangle { width: 24px; }
            }
        }

        Rectangle { width: parent.width; height: 1px; background: root.github-border-default; }

        if root.selected-tab == 2: Rectangle {
            width: parent.width;
            height: 46px;
            // The SHA tooltip opens below this row. Keep the row above the
            // following file toolbar so the GitHub-style bubble is not covered.
            z: 80;
            background: root.github-bg-muted;

            HorizontalLayout {
                padding-right: 24px;
                spacing: 0px;

                Rectangle {
                    // Keep the commit summary origin attached to the live file-tree
                    // divider while the user drags it; never snapshot this width.
                    width: root.file-list-visible ? root.file-list-width + 1px : 320px;
                    height: parent.height;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        FileTreeToggleButton {
                            file-tree-visible: root.file-list-visible;
                            clicked => {
                                root.file-list-resizing = false;
                                // Below Primer md GitHub keeps the tree hidden;
                                // only flip the wide-window preference there.
                                if !root.file-list-below-breakpoint {
                                    root.file-list-user-visible = !root.file-list-user-visible;
                                }
                            }
                        }
                        CommitRangeButton {
                            y: (parent.height - self.height) / 2;
                            text: root.commit-range-label;
                            clicked => {
                                root.commit-range-dialog-open = true;
                                root.ensure-commits();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if !root.show-single-commit-summary: Rectangle { horizontal-stretch: 1; }

                if root.show-single-commit-summary: HorizontalLayout {
                    horizontal-stretch: 1;
                    height: parent.height;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    single-commit-title := MaterialText {
                        horizontal-stretch: 1;
                        height: parent.height;
                        text: root.commits[root.commit-range-start].title;
                        font-family: root.tree-font-family;
                        font-size: 14px;
                        font-weight: 600;
                        color: root.github-fg-default;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 112px;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-default;
                        clip: true;

                        CommitSummaryNavButton {
                            x: 0px;
                            width: 56px;
                            text: "Prev";
                            icon-source: @image-url("../../assets/icons/octicon-chevron-left-16.svg");
                            button-enabled: root.commit-range-start + 1 < root.commits.length;
                            clicked => {
                                root.apply-commit-range(
                                    root.commit-range-start + 1,
                                    root.commit-range-start + 1
                                );
                            }
                        }
                        CommitSummaryNavButton {
                            x: 56px;
                            width: 56px;
                            text: "Next";
                            icon-source: @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                            icon-after: true;
                            draw-divider: true;
                            button-enabled: root.commit-range-start > 0;
                            clicked => {
                                root.apply-commit-range(
                                    root.commit-range-start - 1,
                                    root.commit-range-start - 1
                                );
                            }
                        }
                    }

                    if root.width >= 1100px: ConversationAvatar {
                        avatar-size: 22px;
                        label-size: 9px;
                        avatar: root.commits[root.commit-range-start].avatar;
                        fallback-label: root.commits[root.commit-range-start].avatar-label;
                    }
                    if root.width >= 1100px: single-commit-author := MaterialText {
                        width: min(190px, self.preferred-width);
                        height: parent.height;
                        text: root.commits[root.commit-range-start].author
                            + " committed "
                            + root.commits[root.commit-range-start].short-date-label;
                        font-family: root.tree-font-family;
                        font-size: 11px;
                        color: root.github-fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    MaterialText {
                        width: 96px;
                        height: parent.height;
                        text: "Commit " + root.commits[root.commit-range-start].short-sha;
                        font-family: root.code-font-family;
                        font-size: 11px;
                        color: root.github-fg-muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    FileToolbarButton {
                        width: 30px;
                        height: parent.height;
                        icon-source: @image-url("../../assets/icons/octicon-copy-16.svg");
                        tooltip-text: "Copy full SHA for "
                            + root.commits[root.commit-range-start].short-sha;
                        tooltip-align-right: true;
                        clicked => {
                            root.copy-commit-sha(root.commits[root.commit-range-start].sha);
                        }
                    }
                }

                if root.ignore-whitespace-supported: HorizontalLayout {
                    height: parent.height;
                    spacing: 4px;
                    horizontal-stretch: 0;
                    cross-axis-alignment: center;

                    MaterialText {
                        // Preferred width only — stretching this label was what
                        // shoved the switch to the far right of the toolbar.
                        width: self.preferred-width;
                        height: parent.height;
                        text: "Ignore whitespace";
                        font-family: root.tree-font-family;
                        font-size: 13px;
                        font-weight: 500;
                        color: root.github-fg-muted;
                        vertical-alignment: center;
                    }
                    GitHubToggleSwitch {
                        checked: root.ignore-whitespace;
                        toggled(checked) => {
                            root.ignore-whitespace = checked;
                            root.reload(checked);
                        }
                    }
                }
            }
        }

        if root.selected-tab == 2 && root.too-many-commits: Rectangle {
            width: parent.width;
            height: 32px;
            background: MaterialPalette.tertiary_container;
            MaterialText {
                x: 18px;
                width: parent.width - 36px;
                height: parent.height;
                text: "This pull request exceeds the server commit limit; the displayed diff may be partial.";
                vertical_alignment: center;
                font-size: 11px;
                color: MaterialPalette.on_tertiary_container;
            }
        }

        if root.selected-tab == 0: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.github-bg-default;

            if root.conversation-loading: MaterialText {
                width: parent.width;
                height: parent.height;
                text: "Loading conversation…";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: "Hiragino Sans GB";
                color: root.github-fg-muted;
            }
            if !root.conversation-loading && root.conversation-error != "": CenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                retry => { root.select-tab(0); }
            }
            if !root.conversation-loading && root.conversation-error == "": conversation-scroll := ScrollView {
                // GitHub Conversation is one document: timeline + composer share
                // a single scroll, so the Write box sits after the last event
                // instead of staying pinned to the viewport bottom.
                x: max(24px, (parent.width - min(920px, parent.width - 48px)) / 2);
                y: 20px;
                width: min(920px, parent.width - 48px);
                height: parent.height - 40px;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-width: self.visible-width;
                viewport-height: conversation-flow.preferred-height;

                conversation-flow := VerticalLayout {
                    width: conversation-scroll.visible-width;
                    spacing: 16px;
                    alignment: start;
                    padding-bottom: 24px;

                if root.conversation-items.length == 0: Rectangle {
                    width: parent.width;
                    height: 120px;
                    MaterialText {
                        width: parent.width;
                        height: parent.height;
                        text: "No conversation activity was returned by this provider.";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: root.github-fg-muted;
                    }
                }
                if root.conversation-items.length > 0: ListView {
                    width: parent.width;
                    height: root.conversation-content-height * 1px
                        + root.expanded-commit-body-height * 1px;
                    vertical-stretch: 0;
                    horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                    vertical_scrollbar_policy: ScrollBarPolicy.always_off;
                    for item[index] in root.conversation-items: Rectangle {
                        private property <bool> is-card:
                            item.kind == "description" || item.kind == "comment" || item.kind == "review";
                        private property <bool> commit-expanded:
                            item.kind == "commit" && item.message-expanded;
                        // GitHub's timeline rail is not the avatar axis. It sits
                        // 16 px inside the card edge (x=52) and activity content
                        // begins another 28 px to its right.
                        private property <length> rail-x: 68px;
                        private property <length> activity-anchor-y:
                            item.kind == "commit" ? item.row-height * 1px / 2 : self.height / 2;
                        private property <length> rail-before-end-y:
                            self.is-card ? 6px : self.activity-anchor-y;
                        private property <length> rail-after-start-y:
                            self.is-card ? self.height - 6px : self.activity-anchor-y;
                        // Hug the wrapped body; keep a small gap before the next
                        // timeline row (Rust message-body-height over-estimates).
                        private property <length> commit-body-extra:
                            self.commit-expanded && item.message-body != ""
                                ? conv-commit-body-measure.preferred-height + 8px
                                : 0px;
                        height: item.row-height * 1px + self.commit-body-extra;
                        background: transparent;

                        // Same wrap metrics as the visible expanded body.
                        conv-commit-body-measure := Text {
                            visible: false;
                            width: parent.width - 168px;
                            text: item.message-body;
                            font-family: root.code-font-family;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        if item.connect-before: Rectangle {
                            x: parent.rail-x - 1px;
                            y: 0px;
                            width: 2px;
                            height: parent.rail-before-end-y;
                            background: root.github-border-default;
                        }
                        if item.connect-after: Rectangle {
                            x: parent.rail-x - 1px;
                            y: parent.rail-after-start-y;
                            width: 2px;
                            height: parent.height - parent.rail-after-start-y;
                            background: root.github-border-default;
                        }

                        if item.kind == "commits": Rectangle {
                            x: 56px;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.github-bg-default;
                            Image {
                                x: 4px;
                                y: 4px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-repo-push-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "commits": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            MaterialText {
                                width: self.preferred-width;
                                text: item.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: item.body;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if item.created-at != "": RelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                // Trailing free space after the label; avoids ListView clip.
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if item.kind == "commit": Rectangle {
                            // 12px badge centered on the rail and the collapsed
                            // title band, not the expanded message body.
                            x: 62px;
                            y: (item.row-height * 1px - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            background: root.github-bg-default;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "commit": Rectangle {
                            x: 96px;
                            y: 0px;
                            width: parent.width - 96px;
                            height: item.row-height * 1px;
                            background: transparent;
                            private property <length> title-max-width:
                                self.width - 28px - 6px - 18px - 8px - 72px;
                            private property <length> title-width:
                                min(conv-commit-title-measure.preferred-width, self.title-max-width);

                            ConversationAvatar {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: item.avatar;
                                fallback-label: item.avatar-label;
                            }
                            Text {
                                x: 28px;
                                y: (parent.height - 22px) / 2;
                                width: parent.title-width;
                                height: 22px;
                                text: item.body;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: conv-commit-title-touch.has-hover ? root.github-accent-fg : root.github-fg-default;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if conv-commit-title-touch.has-hover: Rectangle {
                                x: 28px;
                                y: (parent.height - 22px) / 2 + 20px;
                                width: parent.title-width;
                                height: 1px;
                                background: root.github-accent-fg;
                            }
                            conv-commit-title-measure := Text {
                                visible: false;
                                text: item.body;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                            }
                            conv-commit-title-touch := TouchArea {
                                x: 28px;
                                y: (parent.height - 22px) / 2;
                                width: parent.title-width;
                                height: 22px;
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(item.id); }
                            }
                            if item.message-body != "": CommitMessageToggleButton {
                                x: 28px + parent.title-width + 6px;
                                y: (parent.height - self.height) / 2;
                                expanded: item.message-expanded;
                                clicked => { root.toggle-commit-message(item.id); }
                            }
                            MaterialText {
                                x: parent.width - 72px;
                                width: 72px;
                                height: parent.height;
                                text: item.state;
                                font-family: "Menlo";
                                font-size: 12px;
                                color: conv-commit-sha-touch.has-hover ? root.github-accent-fg : root.github-fg-muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            conv-commit-sha-touch := TouchArea {
                                x: parent.width - 72px;
                                width: 72px;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(item.id); }
                            }
                        }
                        if item.kind == "commit" && item.message-expanded && item.message-body != "": Text {
                            // GitHub's expanded message is a preformatted block
                            // aligned 28 px after the timeline rail; the title
                            // stays indented by its compact author avatar.
                            x: 96px;
                            y: item.row-height * 1px;
                            width: parent.width - 168px;
                            height: self.preferred-height;
                            text: item.message-body;
                            font-family: root.code-font-family;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }

                        if item.kind == "merged": Rectangle {
                            x: 54px;
                            y: (parent.height - 28px) / 2;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.github-done-fg;
                            Image {
                                x: 6px;
                                y: 6px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-git-merge-16.svg");
                                colorize: #ffffff;
                            }
                        }

                        if item.kind == "merged": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            ConversationAvatar {
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: item.avatar;
                                fallback-label: item.avatar-label;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: item.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: "merged commit";
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: item.body;
                                font-family: "Menlo";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: "into";
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            BranchLabel {
                                text: item.state;
                                background-color: root.github-accent-muted;
                                foreground-color: AppState.effective-dark-mode ? #58a6ff : #0969da;
                            }
                            if item.created-at != "": RelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                        }

                        if item.kind == "review_summary": ConversationAvatar {
                            x: 0px;
                            y: 4px;
                            avatar: item.avatar;
                            fallback-label: item.avatar-label;
                        }

                        if item.kind == "review_summary": Rectangle {
                            x: 56px;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.github-bg-default;
                            Image {
                                x: 4px;
                                y: 4px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-eye-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "review_summary": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 7px;
                            cross-axis-alignment: center;
                            MaterialText {
                                width: self.preferred-width;
                                text: item.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: item.body;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: root.github-fg-muted;
                            }
                            if item.created-at != "": RelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                // Below tip is clipped by the following review card.
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if item.kind == "event": Rectangle {
                            x: 54px;
                            y: (parent.height - 28px) / 2;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: root.github-bg-muted;
                            border-width: 1px;
                            border-color: root.github-border-default;
                            MaterialText {
                                width: parent.width;
                                height: parent.height;
                                text: "●";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: root.github-fg-muted;
                                font-size: 10px;
                            }
                        }

                        if item.kind == "event": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            MaterialText {
                                width: self.preferred-width;
                                text: item.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                horizontal-stretch: 1;
                                text: item.body;
                                font-family: "Hiragino Sans GB";
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if item.created-at != "": RelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                tooltip-align-right: true;
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                        }

                        if self.is-card && item.kind != "review": ConversationAvatar {
                            x: 0px;
                            y: 6px;
                            avatar: item.avatar;
                            fallback-label: item.avatar-label;
                        }

                        if self.is-card: Rectangle {
                            x: 52px;
                            y: 6px;
                            width: parent.width - 52px;
                            height: parent.height - 12px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.github-border-default;
                            background: root.github-bg-default;
                            clip: true;

                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 0px;

                                Rectangle {
                                    width: parent.width;
                                    height: 36px;
                                    background: item.kind == "description" || item.kind == "review"
                                        ? root.github-accent-muted
                                        : root.github-bg-muted;
                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        MaterialText {
                                            width: self.preferred-width;
                                            text: item.author;
                                            font-family: "Hiragino Sans GB";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: root.github-fg-default;
                                            vertical-alignment: center;
                                        }
                                        MaterialText {
                                            width: self.preferred-width;
                                            text: item.kind == "review" && item.state != ""
                                                ? (item.state == "approved"
                                                    ? "approved these changes"
                                                    : (item.state == "changes_requested" || item.state == "rejected"
                                                        ? "requested changes"
                                                        : "left a comment"))
                                                : "commented";
                                            font-family: "Hiragino Sans GB";
                                            font-size: 12px;
                                            color: root.github-fg-muted;
                                            vertical-alignment: center;
                                        }
                                        if item.kind != "review" && item.created-at != "": RelativeTimestamp {
                                            text: item.created-at;
                                            tooltip-text: item.created-at-tooltip;
                                            // Trailing free space in the card header.
                                            tooltip-after: true;
                                            foreground-color: root.github-fg-muted;
                                            label-font-size: 11px;
                                        }
                                        if item.kind == "review" && item.author-association == "AUTHOR": Rectangle {
                                            width: 46px;
                                            height: 22px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: root.github-border-default;
                                            background: transparent;
                                            MaterialText {
                                                width: parent.width;
                                                height: parent.height;
                                                text: "Author";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-size: 10px;
                                                color: root.github-fg-muted;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }

                                if item.body == "": Rectangle {
                                    width: parent.width;
                                    height: 40px;
                                    background: root.github-bg-default;
                                    Text {
                                        x: 14px;
                                        y: 10px;
                                        width: parent.width - 28px;
                                        height: 20px;
                                        text: "No description provided.";
                                        wrap: word-wrap;
                                        overflow: clip;
                                        font-family: "Hiragino Sans GB";
                                        font-size: 13px;
                                        color: root.github-fg-default;
                                        font-italic: true;
                                        vertical-alignment: center;
                                    }
                                }
                                if item.body != "": Rectangle {
                                    width: parent.width;
                                    vertical-stretch: 1;
                                    background: root.github-bg-default;
                                    Text {
                                        x: 14px;
                                        y: 12px;
                                        width: parent.width - 28px;
                                        height: parent.height - 24px;
                                        text: item.body;
                                        wrap: word-wrap;
                                        overflow: clip;
                                        font-family: "Hiragino Sans GB";
                                        font-size: 13px;
                                        color: root.github-fg-default;
                                    }
                                }
                            }
                        }
                    }
                }

                // GitHub Conversation comment composer (plain text only; no Preview).
                Rectangle {
                    width: parent.width;
                    height: 228px;
                    vertical-stretch: 0;
                    background: transparent;

                    ConversationAvatar {
                        x: 0px;
                        y: 0px;
                        avatar: AppState.user-avatar;
                        fallback-label: "Y";
                    }

                    Rectangle {
                        x: 52px;
                        y: 0px;
                        width: parent.width - 52px;
                        height: parent.height;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-default;
                        clip: true;

                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 0px;

                            // Tab header: selected Write tab sits on the muted bar.
                            Rectangle {
                                width: parent.width;
                                height: 40px;
                                background: root.github-bg-muted;
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: parent.width;
                                    height: 1px;
                                    background: root.github-border-default;
                                }
                                Rectangle {
                                    x: 8px;
                                    y: 8px;
                                    width: 64px;
                                    height: 33px;
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.github-border-default;
                                    background: root.github-bg-default;
                                    Rectangle {
                                        x: 1px;
                                        y: parent.height - 1px;
                                        width: parent.width - 2px;
                                        height: 2px;
                                        background: root.github-bg-default;
                                    }
                                    MaterialText {
                                        width: parent.width;
                                        height: parent.height - 1px;
                                        text: "Write";
                                        font-family: "Hiragino Sans GB";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.github-fg-default;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                vertical-stretch: 1;
                                min-height: 120px;
                                background: root.github-bg-default;
                                Rectangle {
                                    x: 12px;
                                    y: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height - 16px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: conversation-comment-editor.has-focus
                                        ? #0969da
                                        : root.github-border-default;
                                    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
                                    if root.conversation-comment-body == "" && !conversation-comment-editor.has-focus: MaterialText {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: "Leave a comment";
                                        font-family: "Hiragino Sans GB";
                                        font-size: 14px;
                                        color: root.github-fg-muted;
                                    }
                                    conversation-comment-editor := TextInput {
                                        x: 12px;
                                        y: 8px;
                                        width: parent.width - 24px;
                                        height: parent.height - 16px;
                                        text <=> root.conversation-comment-body;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: root.github-fg-default;
                                        font-size: 14px;
                                        font-family: "Hiragino Sans GB";
                                        enabled: root.can-comment && !root.action-loading;
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                height: 52px;
                                background: root.github-bg-default;
                                Rectangle {
                                    y: 0px;
                                    width: parent.width;
                                    height: 1px;
                                    background: root.github-border-default;
                                }
                                MaterialText {
                                    x: 12px;
                                    y: 1px;
                                    width: parent.width - 140px;
                                    height: parent.height - 1px;
                                    text: root.can-comment
                                        ? "Plain text comments are supported."
                                        : "Configure provider credentials to comment.";
                                    font-family: "Hiragino Sans GB";
                                    font-size: 12px;
                                    color: root.github-fg-muted;
                                    vertical-alignment: center;
                                }
                                GithubCommentButton {
                                    x: parent.width - 108px;
                                    y: 10px;
                                    width: 96px;
                                    height: 32px;
                                    text: root.action-loading ? "Commenting…" : "Comment";
                                    button-enabled: root.can-comment && !root.action-loading && root.conversation-comment-body != "";
                                    tooltip-text: root.can-comment
                                        ? (root.conversation-comment-body == ""
                                            ? "Write a comment before submitting"
                                            : "Add a comment on this pull request")
                                        : "Configure provider credentials to comment";
                                    clicked => {
                                        root.pending-conversation-comment = root.conversation-comment-body;
                                        root.submit-review("comment", root.conversation-comment-body);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        if root.selected-tab == 1: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.github-bg-default;
            if root.commits-loading: MaterialText {
                width: parent.width;
                height: parent.height;
                text: "Loading commits…";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: "Hiragino Sans GB";
                color: root.github-fg-muted;
            }
            if !root.commits-loading && root.commits-error != "": CenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                retry => { root.select-tab(1); }
            }
            if !root.commits-loading && root.commits-error == "": ListView {
                x: max(24px, (parent.width - min(980px, parent.width - 48px)) / 2);
                y: 20px;
                width: min(980px, parent.width - 48px);
                height: parent.height - 40px;
                    for commit in root.commits: commit-item := Rectangle {
                    private property <bool> commit-expanded: commit.message-expanded;
                    // Prefer measured wrap height so expanded rows hug body text
                    // (no blank band above the author footer). Multiple rows may
                    // stay expanded independently.
                    private property <length> title-max-width: commit.message-body != ""
                        ? (parent.width - 66px) - 220px - 36px
                        : (parent.width - 66px) - 220px;
                    private property <length> title-block-height:
                        max(20px, commit-item-title-measure.preferred-height);
                    private property <length> title-extra:
                        max(0px, self.title-block-height - 20px);
                    private property <length> measured-body-height:
                        !self.commit-expanded || commit.message-body == ""
                            ? 0px
                            : commit-tab-body-measure.preferred-height;
                    // Title wrap grows collapsed and expanded rows; body height
                    // only applies while expanded.
                    private property <length> expand-extra: self.title-extra
                        + (self.commit-expanded
                            ? self.measured-body-height
                                + root.commit-tab-title-band
                                + root.commit-tab-body-footer-gap
                                + root.commit-tab-author-band
                                - root.commit-tab-row-height
                            : 0px);
                    height: (commit.group-start
                        ? root.commit-tab-group-header-height + root.commit-tab-row-height
                        : root.commit-tab-row-height) + self.expand-extra;
                    background: transparent;
                    commit-item-title-measure := Text {
                        visible: false;
                        width: commit-item.title-max-width;
                        text: commit.title;
                        font-family: "Hiragino Sans GB";
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        x: 20px;
                        y: commit.group-start ? root.commit-tab-group-header-height : 0px;
                        width: 2px;
                        height: parent.height - (commit.group-start ? root.commit-tab-group-header-height : 0px);
                        background: root.github-border-default;
                    }
                    if commit.group-start: Rectangle {
                        x: 12px;
                        // Center the timeline badge in the inter-card header gap.
                        y: (root.commit-tab-group-header-height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        background: root.github-bg-default;
                        Image {
                            x: 1px;
                            y: 1px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                            image-fit: contain;
                            colorize: root.github-fg-muted;
                        }
                    }
                    if commit.group-start: MaterialText {
                        x: 48px;
                        // Same vertical center as the badge so the date label
                        // sits in the middle of the gap between cards.
                        y: (root.commit-tab-group-header-height - self.height) / 2;
                        width: parent.width - 66px;
                        height: 24px;
                        text: "Commits on " + commit.date-label;
                        vertical-alignment: center;
                        font-size: 14px;
                        font-weight: 600;
                        color: root.github-fg-muted;
                    }
                    // Per-row card chrome so multi-expand preferred-heights stay
                    // bordered without a precomputed group-expand-extra sum.
                    // Use the Rectangle border + radii (Primer medium 6px) so
                    // corners are not squared off by full-height edge strokes.
                    // Non-start rows overlap the previous bottom border by 1px
                    // to keep a single separator between commits.
                    Rectangle {
                        x: 48px;
                        y: commit.group-start
                            ? root.commit-tab-group-header-height
                            : -1px;
                        width: parent.width - 66px;
                        height: root.commit-tab-row-height + commit-item.expand-extra
                            + (commit.group-start ? 0px : 1px);
                        background: root.github-bg-default;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        border-top-left-radius: commit.group-start ? root.commit-tab-card-radius : 0px;
                        border-top-right-radius: commit.group-start ? root.commit-tab-card-radius : 0px;
                        border-bottom-left-radius: commit.group-end ? root.commit-tab-card-radius : 0px;
                        border-bottom-right-radius: commit.group-end ? root.commit-tab-card-radius : 0px;
                    }
                    commit-row := Rectangle {
                        x: 48px;
                        y: commit.group-start ? root.commit-tab-group-header-height : 0px;
                        width: parent.width - 66px;
                        height: root.commit-tab-row-height + commit-item.expand-extra;
                        background: transparent;
                        // Natural single-line width pins the kebab beside short titles.
                        private property <length> title-hit-width:
                            min(commit-item.title-max-width, tab-commit-title-natural.preferred-width);
                        // TextInput reports the exact caret origin at the end of
                        // wrapped text. These fallbacks cover the first frame
                        // before its layout callback runs.
                        private property <length> title-end-x: self.title-hit-width;
                        private property <length> title-end-y:
                            max(0px, commit-item.title-block-height - 20px);
                        // Child TouchAreas steal hover from the full-row area;
                        // OR them so chrome fill stays while title/SHA/copy/time
                        // (and kebab) are hovered. Title underline + SHA chip
                        // still key off their own has-hover only.
                        private property <bool> time-hovered: false;
                        private property <bool> sha-hovered: false;
                        private property <bool> row-hovered:
                            tab-commit-row-touch.has-hover
                            || tab-commit-title-touch.has-hover
                            || self.sha-hovered
                            || copy-sha-button.has-hover
                            || (commit.message-body != "" && commit-kebab.has-hover)
                            || (commit.short-date-label != "" && self.time-hovered);
                        private property <length> content-trail-width: 188px;
                        private property <color> sha-hover-fill: AppState.effective-dark-mode
                            ? #656c7633
                            : #eaeef2;

                        // Hidden measure keeps expand-extra and the author footer
                        // aligned to the wrapped body without blank gaps.
                        commit-tab-body-measure := Text {
                            visible: false;
                            width: parent.width - commit-row.content-trail-width;
                            text: commit.message-body;
                            font-family: root.code-font-family;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        // Hover fill covers the full expanded row (title + body +
                        // author), staying inside the group border / separators.
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            background: commit-row.row-hovered ? root.github-bg-muted : transparent;
                            border-top-left-radius: commit.group-start ? root.commit-tab-card-radius - 1px : 0px;
                            border-top-right-radius: commit.group-start ? root.commit-tab-card-radius - 1px : 0px;
                            border-bottom-left-radius: commit.group-end ? root.commit-tab-card-radius - 1px : 0px;
                            border-bottom-right-radius: commit.group-end ? root.commit-tab-card-radius - 1px : 0px;
                        }

                        // Row chrome: muted fill on hover only. Navigation is
                        // title + short-SHA only; kebab only expands the body.
                        tab-commit-row-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }

                        tab-commit-title-natural := Text {
                            visible: false;
                            text: commit.title;
                            font-family: "Hiragino Sans GB";
                            font-size: 14px;
                            font-weight: 600;
                        }
                        // Layout probe for the exact end of the final wrapped
                        // title line. It stays mounted and transparent so a
                        // width change recomputes the kebab position without
                        // rebuilding the commit model.
                        title-end-probe := TextInput {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            opacity: 0;
                            enabled: false;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            text: commit.title;
                            font-family: "Hiragino Sans GB";
                            font-size: 14px;
                            font-weight: 600;
                            text-cursor-width: 0px;
                            init => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            changed width => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            changed text => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            cursor-position-changed(position) => {
                                commit-row.title-end-x = position.x;
                                commit-row.title-end-y = position.y;
                            }
                        }
                        if !tab-commit-title-touch.has-hover: Text {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            text: commit.title;
                            font-family: "Hiragino Sans GB";
                            font-size: 14px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                        // StyledText draws an underline per glyph run, including
                        // each wrapped line, matching GitHub's inline link. The
                        // old Rectangle produced one unrelated blue rule.
                        if tab-commit-title-touch.has-hover: StyledText {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            text: @markdown("<u>**\{commit.title}**</u>");
                            default-font-family: "Hiragino Sans GB";
                            default-font-size: 14px;
                            default-color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }
                        tab-commit-title-touch := TouchArea {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: parent.title-hit-width;
                            height: commit-item.title-block-height;
                            mouse-cursor: pointer;
                            clicked => { root.open-commit(commit.sha); }
                        }

                        // Collapsed: author under title. Expanded: body then author footer.
                        if !commit-item.commit-expanded: HorizontalLayout {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y + commit-item.title-block-height + 4px;
                            width: parent.width - commit-row.content-trail-width;
                            height: 22px;
                            spacing: 4px;
                            cross-axis-alignment: center;
                            MaterialText {
                                width: self.preferred-width;
                                text: commit.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 12px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: "committed";
                                font-family: "Hiragino Sans GB";
                                font-size: 12px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if commit.short-date-label != "": RelativeTimestamp {
                                text: commit.short-date-label;
                                tooltip-text: commit.authored-at;
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                                label-height: 22px;
                                changed has-hover => {
                                    commit-row.time-hovered = self.has-hover;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if commit-item.commit-expanded && commit.message-body != "": Text {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-title-band + commit-item.title-extra;
                            width: parent.width - commit-row.content-trail-width;
                            height: commit-tab-body-measure.preferred-height;
                            text: commit.message-body;
                            font-family: root.code-font-family;
                            font-size: 12px;
                            color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }

                        if commit-item.commit-expanded: HorizontalLayout {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-title-band
                                + commit-item.title-extra
                                + (commit.message-body != ""
                                    ? commit-tab-body-measure.preferred-height
                                    : 0px)
                                + root.commit-tab-body-footer-gap;
                            width: parent.width - commit-row.content-trail-width;
                            height: root.commit-tab-author-band;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            ConversationAvatar {
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: commit.avatar;
                                fallback-label: commit.avatar-label;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: commit.author;
                                font-family: "Hiragino Sans GB";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            MaterialText {
                                width: self.preferred-width;
                                text: "committed";
                                font-family: "Hiragino Sans GB";
                                font-size: 12px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if commit.short-date-label != "": RelativeTimestamp {
                                text: commit.short-date-label;
                                tooltip-text: commit.authored-at;
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                                label-height: root.commit-tab-author-band;
                                changed has-hover => {
                                    commit-row.time-hovered = self.has-hover;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if commit.verified: MaterialText {
                            x: parent.width - 226px;
                            y: 0px;
                            width: 64px;
                            height: root.commit-tab-row-height;
                            text: "Verified";
                            font-size: 11px;
                            font-weight: 600;
                            color: root.github-success-fg;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        tab-commit-sha-natural := Text {
                            visible: false;
                            text: commit.short-sha;
                            font-family: root.code-font-family;
                            font-size: 12px;
                        }
                        // GitHub short SHA is plain text at rest. Its rounded
                        // control-hover pill appears only while the SHA itself
                        // is hovered—never from row chrome alone. Use Primer
                        // control hover (`#eaeef2` / translucent dark), not
                        // page `bg-muted`, so the pill stays visible on both
                        // white and row-muted fills.
                        commit-sha-chip := Rectangle {
                            z: 1;
                            x: parent.width - 58px - self.width;
                            y: (parent.height - self.height) / 2;
                            width: tab-commit-sha-natural.preferred-width + 16px;
                            height: 28px;
                            border-radius: 6px;
                            border-width: 0px;
                            background: commit-row.sha-hovered
                                ? commit-row.sha-hover-fill
                                : transparent;
                            MaterialText {
                                width: parent.width;
                                height: parent.height;
                                text: commit.short-sha;
                                font-family: root.code-font-family;
                                font-size: 12px;
                                color: root.github-fg-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            tab-commit-sha-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(commit.sha); }
                                changed has-hover => {
                                    commit-row.sha-hovered = self.has-hover;
                                }
                            }
                            if commit-row.sha-hovered: ToolTip {
                                x: parent.width - self.width;
                                y: -self.height - 4px;
                                text: "View commit details";
                            }
                        }
                        copy-sha-button := FileToolbarButton {
                            x: parent.width - 44px;
                            y: (parent.height - self.height) / 2;
                            icon-source: @image-url("../../assets/icons/octicon-copy-16.svg");
                            tooltip-text: "Copy full SHA";
                            tooltip-align-right: true;
                            tooltip-above: true;
                            clicked => { root.copy-commit-sha(commit.sha); }
                        }
                        // Always mounted so row-hovered can read has-hover; hide
                        // when there is no message body to expand. Declared last
                        // so the kebab wins hit-testing over the title touch.
                        commit-kebab := CommitMessageToggleButton {
                            visible: commit.message-body != "";
                            x: min(
                                root.commit-tab-content-x + parent.title-end-x + 8px,
                                root.commit-tab-content-x + commit-item.title-max-width + 8px
                            );
                            y: root.commit-tab-content-y + parent.title-end-y;
                            expanded: commit-item.commit-expanded;
                            clicked => { root.toggle-commit-message(commit.sha); }
                        }
                    }
                }
            }
            if !root.commits-loading && root.commits-error == "" && root.commits.length == 0: MaterialText {
                width: parent.width;
                height: parent.height;
                text: "No commits were returned by this provider.";
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.github-fg-muted;
            }
        }

        if root.selected-tab == 2: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.github-bg-default;

            if root.loading: MaterialText {
                width: parent.width;
                height: parent.height;
                text: "Loading changed files…";
                horizontal_alignment: center;
                vertical_alignment: center;
                font-family: "Hiragino Sans GB";
                font_size: 14px;
                color: MaterialPalette.on_surface_variant;
            }

            if !root.loading && root.error-text != "": CenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                retry => { root.reload(root.ignore-whitespace); }
            }

            if !root.loading && root.error-text == "": Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                private property <int> observed-line-model-revision: root.line-model-revision;

                changed observed-line-model-revision => {
                    diff-scroll.viewport-x = 0px;
                    diff-scroll.viewport-y = 0px;
                }

                if root.file-list-visible: Rectangle {
                    x: 0px;
                    width: root.file-list-width;
                    height: parent.height;
                    background: root.github-bg-default;
                    border-width: 0px;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;
                        Rectangle {
                            width: parent.width;
                            height: 52px;
                            z: 20;
                            background: root.github-bg-default;
                            GitHubFileFilterField {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 66px;
                                text <=> root.file-filter;
                                font-family: root.tree-font-family;
                            }
                            Rectangle {
                                x: parent.width - 46px;
                                y: 9px;
                                width: 34px;
                                height: 34px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.file-filters-active
                                    ? (AppState.effective-dark-mode ? #4493f8 : #0969da)
                                    : root.github-border-default;
                                background: filter-button-touch.has-hover
                                    ? (root.active-popover == "file-filter"
                                        ? (AppState.effective-dark-mode ? #656c7626 : #eff2f5)
                                        : root.github-bg-muted)
                                    : (root.active-popover == "file-filter"
                                        ? (AppState.effective-dark-mode ? #656c7633 : #e6eaef)
                                        : root.github-bg-default);
                                Image {
                                    x: 9px;
                                    y: 9px;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../../assets/icons/octicon-filter-16.svg");
                                    image-fit: contain;
                                    colorize: root.file-filters-active
                                        ? (AppState.effective-dark-mode ? #4493f8 : #0969da)
                                        : root.github-fg-muted;
                                }
                                filter-button-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.active-popover = root.active-popover == "file-filter" ? "" : "file-filter";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            vertical-stretch: 1;

                            file-scroll := ListView {
                                width: parent.width;
                                height: parent.height;
                                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                                vertical_scrollbar_policy: ScrollBarPolicy.as_needed;
                                for item in root.tree-items: Rectangle {
                                    width: file-scroll.visible_width;
                                    height: 28px;
                                    background: item.kind == "file" && root.selected-file-index == item.file-index
                                        ? root.github-accent-muted
                                        : (tree-touch.has-hover ? root.github-bg-muted : transparent);
                                    border-width: 0px;
                                    TreeIndentGuides { width: parent.width; height: parent.height; depth: item.depth; }
                                    HorizontalLayout {
                                        padding-left: 10px + item.depth * 18px;
                                        padding-right: 10px;
                                        spacing: 7px;
                                        Rectangle {
                                            width: 32px;
                                            height: parent.height;
                                            if item.kind == "folder": Image {
                                                x: 0px;
                                                y: (parent.height - self.height) / 2;
                                                width: 12px;
                                                height: 12px;
                                                source: item.expanded
                                                    ? @image-url("../../assets/icons/octicon-chevron-down-16.svg")
                                                    : @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                                                image-fit: contain;
                                            }
                                            if item.kind == "folder": Image {
                                                x: 18px;
                                                y: (parent.height - self.height) / 2;
                                                width: 14px;
                                                height: 14px;
                                                source: item.expanded
                                                    ? @image-url("../../assets/icons/octicon-file-directory-open-fill-16.svg")
                                                    : @image-url("../../assets/icons/octicon-file-directory-fill-16.svg");
                                                image-fit: contain;
                                            }
                                            if item.kind == "file": FileChangeTypeIcon {
                                                x: 18px;
                                                y: (parent.height - self.height) / 2;
                                                width: 14px;
                                                height: 14px;
                                                change-type: item.change-type;
                                                muted-fg: root.github-fg-muted;
                                                success-fg: root.github-success-fg;
                                                danger-fg: root.github-danger-fg;
                                                attention-fg: root.github-attention-fg;
                                            }
                                        }
                                        if item.kind == "folder": Text {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            text: item.name;
                                            horizontal_alignment: left;
                                            vertical_alignment: center;
                                            font-family: root.tree-font-family;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: root.github-fg-default;
                                            overflow: elide;
                                        }
                                        if item.kind == "folder": Text {
                                            width: 24px;
                                            height: parent.height;
                                            text: item.file-count;
                                            horizontal_alignment: right;
                                            vertical_alignment: center;
                                            font-family: root.tree-font-family;
                                            font-size: 12px;
                                            color: root.github-fg-muted;
                                        }
                                        if item.kind == "file": Rectangle {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            filename := Text {
                                                x: 0px;
                                                width: min(self.preferred-width, max(0px, parent.width - 60px));
                                                height: parent.height;
                                                text: item.name;
                                                horizontal_alignment: left;
                                                vertical_alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 14px;
                                                font-weight: root.selected-file-index == item.file-index ? 600 : 400;
                                                color: root.github-fg-default;
                                                overflow: elide;
                                            }
                                            added-count := Text {
                                                x: filename.width + 7px;
                                                width: self.preferred-width;
                                                height: parent.height;
                                                text: "+" + item.added-lines;
                                                horizontal_alignment: left;
                                                vertical_alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: root.github-success-fg;
                                            }
                                            Text {
                                                x: added-count.x + added-count.preferred-width + 7px;
                                                width: self.preferred-width;
                                                height: parent.height;
                                                text: "−" + item.removed-lines;
                                                horizontal_alignment: left;
                                                vertical_alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: root.github-danger-fg;
                                            }
                                        }
                                    }
                                    tree-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active-popover = "";
                                            if item.kind == "folder" { root.toggle-folder(item.path); }
                                            else { root.select-file(item.file-index); }
                                        }
                                    }
                                }
                            }

                            if root.tree-items.length == 0: MaterialText {
                                width: parent.width;
                                height: 72px;
                                text: root.file-filter == "" ? "No changed files" : "No matching files";
                                horizontal_alignment: center;
                                vertical_alignment: center;
                                font-family: root.tree-font-family;
                                font-size: 14px;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }
                }

                if root.file-list-visible: Rectangle { x: root.file-list-width; width: 1px; height: parent.height; background: root.github-border-default; }

                Rectangle {
                    x: root.file-list-visible ? root.file-list-width + 1px : 0px;
                    width: root.file-list-visible ? parent.width - root.file-list-width - 1px : parent.width;
                    height: parent.height;
                    background: root.github-bg-default;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;

                        Rectangle {
                            width: parent.width;
                            height: 46px;
                            z: 20;
                            background: root.github-bg-default;
                            border-width: 0px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                Rectangle {
                                    width: 16px;
                                    height: parent.height;
                                    FileChangeTypeIcon {
                                        y: (parent.height - self.height) / 2;
                                        width: 16px;
                                        height: 16px;
                                        change-type: root.selected-file-change-type;
                                        muted-fg: root.github-fg-muted;
                                        success-fg: root.github-success-fg;
                                        danger-fg: root.github-danger-fg;
                                        attention-fg: root.github-attention-fg;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: parent.height;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 2px;

                                        MaterialText {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            text: root.selected-file-path == "" ? "Select a changed file" : root.selected-file-path;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: MaterialPalette.on_surface;
                                            overflow: elide;
                                            vertical_alignment: center;
                                        }
                                        FileToolbarButton {
                                            icon-source: @image-url("../../assets/icons/octicon-copy-16.svg");
                                            button-enabled: root.selected-file-path != "";
                                            tooltip-text: "Copy file path";
                                            clicked => { root.copy-file-path(root.selected-file-path); }
                                        }
                                        FileToolbarButton {
                                            icon-source: root.context-expanded
                                                ? @image-url("../../assets/icons/octicon-fold-16.svg")
                                                : @image-url("../../assets/icons/octicon-unfold-16.svg");
                                            button-enabled: (root.has-expandable-hunks || root.context-expanded) && !root.viewing-file && !root.code-loading;
                                            tooltip-text: root.context-expanded ? "Collapse non-diff lines" : "Expand all lines";
                                            clicked => {
                                                if root.context-expanded { root.collapse-non-diff-lines(); }
                                                else { root.expand-all-hunks(); }
                                            }
                                        }
                                    }
                                }
                                FileDiffStat {
                                    additions: root.selected-file-added-lines;
                                    deletions: root.selected-file-removed-lines;
                                    has-selection: root.selected-file-index >= 0;
                                    font-family: root.tree-font-family;
                                }
                                MaterialText { width: 48px; height: parent.height; text: root.selected-file-index < 0 ? "" : (root.selected-file-index + 1) + " / " + root.files.length; horizontal_alignment: center; font-size: 10px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                                FileToolbarButton {
                                    icon-source: @image-url("../../assets/icons/octicon-chevron-left-16.svg");
                                    button-enabled: root.selected-file-index > 0 && !root.code-loading;
                                    tooltip-text: "Previous file";
                                    clicked => { root.select-relative-file(-1); }
                                }
                                FileToolbarButton {
                                    icon-source: @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                                    button-enabled: root.selected-file-index >= 0 && root.selected-file-index + 1 < root.files.length && !root.code-loading;
                                    tooltip-text: "Next file";
                                    tooltip-align-right: true;
                                    clicked => { root.select-relative-file(1); }
                                }
                                FileMenuButton {
                                    button-enabled: root.selected-file-index >= 0 && !root.code-loading;
                                    viewing-file: root.viewing-file;
                                    open: root.active-popover == "file-menu";
                                    toggle-menu => {
                                        root.active-popover = root.active-popover == "file-menu" ? "" : "file-menu";
                                    }
                                    action => {
                                        root.active-popover = "";
                                        root.view-file();
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: root.github-border-default; }
                        }

                        diff-scroll := ListView {
                            width: parent.width;
                            vertical-stretch: 1;
                            horizontal_scrollbar_policy: ScrollBarPolicy.as_needed;
                            vertical_scrollbar_policy: ScrollBarPolicy.as_needed;

                            for line[line-index] in root.lines: Rectangle {
                                width: max(diff-scroll.visible_width, 116px + root.measured-code-width);
                                height: line.kind == "hunk" ? root.hunk-line-height : root.code-line-height;
                                background: line.kind == "addition"
                                    ? root.diff-addition-background
                                    : (line.kind == "deletion"
                                        ? root.diff-deletion-background
                                        : (line.kind == "hunk" ? root.hunk-background : root.github-bg-default));
                                HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 0px;
                                        Rectangle {
                                            width: 44px;
                                            height: parent.height;
                                            background: line.kind == "addition" ? root.diff-addition-gutter-background : (line.kind == "deletion" ? root.diff-deletion-gutter-background : (line.kind == "hunk" ? root.hunk-gutter-background : root.github-bg-default));
                                            MaterialText { width: parent.width - 7px; height: parent.height; text: line.old-line == 0 ? "" : line.old-line; horizontal_alignment: right; vertical_alignment: center; font-family: root.code-font-family; font-size: root.code-font-size; color: root.github-fg-muted; }
                                        }
                                        Rectangle {
                                            width: 44px;
                                            height: parent.height;
                                            background: line.kind == "addition" ? root.diff-addition-gutter-background : (line.kind == "deletion" ? root.diff-deletion-gutter-background : (line.kind == "hunk" ? root.hunk-gutter-background : root.github-bg-default));
                                            MaterialText { width: parent.width - 7px; height: parent.height; text: line.new-line == 0 ? "" : line.new-line; horizontal_alignment: right; vertical_alignment: center; font-family: root.code-font-family; font-size: root.code-font-size; color: root.github-fg-muted; }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: parent.height;
                                            background: line.kind == "hunk" ? root.hunk-background : transparent;
                                            MaterialText { width: parent.width; height: parent.height; text: line.kind == "addition" ? "+" : (line.kind == "deletion" ? "−" : ""); horizontal_alignment: center; vertical_alignment: center; font-family: root.code-font-family; font-size: root.code-font-size; color: root.github-fg-default; }
                                        }
                                        if line.kind == "hunk": Rectangle {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            Text {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                text: line.content;
                                                horizontal_alignment: left;
                                                vertical_alignment: center;
                                                overflow: clip;
                                                font-family: root.code-font-family;
                                                font-size: root.code-font-size;
                                                color: root.hunk-foreground;
                                            }
                                        }
                                        if line.kind != "hunk" && root.live-resizing: Rectangle {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: line.content;
                                                vertical_alignment: center;
                                                overflow: clip;
                                                font-family: root.code-font-family;
                                                font-size: root.code-font-size;
                                                color: root.github-fg-default;
                                            }
                                        }
                                        if line.kind != "hunk" && !root.live-resizing: HorizontalLayout {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            spacing: 0px;
                                            for token in line.tokens: Text {
                                                width: self.preferred-width;
                                                height: parent.height;
                                                text: token.text;
                                                vertical_alignment: center;
                                                overflow: clip;
                                                font-family: root.code-font-family;
                                                font-size: root.code-font-size;
                                                font-weight: token.bold ? 600 : 400;
                                                font-italic: token.italic;
                                                color: line.kind == "hunk"
                                                    ? MaterialPalette.on_secondary_container
                                                    : (AppState.effective-dark-mode ? token.dark-color : token.color);
                                            }
                                        }
                                }
                                if line.kind == "hunk" && line.expandable: Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: 88px;
                                    height: parent.height;
                                    background: hunk-expand-touch.has-hover ? MaterialPalette.primary_container : transparent;
                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("../../assets/icons/octicon-unfold-16.svg");
                                        image-fit: contain;
                                    }
                                    hunk-expand-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.expand-hunk(line-index); }
                                    }
                                }
                            }
                        }

                    }

                    if root.code-loading: CodeRenderingIndicator {
                        x: (parent.width - self.width) / 2;
                        y: 56px;
                    }

                }

                file-list-resize-handle := TouchArea {
                    x: root.file-list-visible ? root.file-list-width - 4px : -10px;
                    y: 0px;
                    width: root.file-list-visible ? 9px : 0px;
                    height: parent.height;
                    z: 100;
                    mouse-cursor: col-resize;
                    moved => {
                        if root.file-list-resizing {
                            // The handle moves with the divider, so its local
                            // pointer delta is the distance still left to
                            // follow, not the distance from the original
                            // press. Applying it to the current width keeps
                            // the divider locked to the pointer.
                            root.file-list-preferred-width = max(
                                root.file-list-min-width,
                                min(
                                    root.file-list-max-width,
                                    root.file-list-width + (self.mouse-x - self.pressed-x)
                                )
                            );
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.file-list-resizing = true;
                            root.file-list-drag-start-width = root.file-list-width;
                        } else if event.kind == PointerEventKind.up {
                            root.file-list-resizing = false;
                        } else if event.kind == PointerEventKind.cancel {
                            root.file-list-preferred-width = root.file-list-drag-start-width;
                            root.file-list-resizing = false;
                        }
                    }
                }
                Rectangle {
                    x: root.file-list-width - 1px;
                    y: 0px;
                    width: 3px;
                    height: parent.height;
                    z: 101;
                    background: MaterialPalette.primary;
                    opacity: root.file-list-visible && (root.file-list-resizing || file-list-resize-handle.has-hover) ? 0.8 : 0;
                }

                // Mount the popover after both the file tree and diff panes.
                // A child of the left pane cannot out-z the later-painted diff
                // sibling, regardless of its local z value.
                if root.file-list-visible: filter-menu := GitHubFilterMenu {
                    z: 1000;
                    x: root.file-list-width - 46px;
                    y: 9px;
                    open: root.active-popover == "file-filter";
                    extension-filters: root.extension-filters;
                    only-manifest-files: root.only-manifest-files;
                    show-viewed-files: root.show-viewed-files;
                    font-family: root.tree-font-family;
                    toggle-extension(extension) => { root.toggle-extension-filter(extension); }
                    toggle-manifest => { root.toggle-manifest-filter(); }
                    toggle-viewed => { root.toggle-viewed-files(); }
                }
            }
        }
    }

    if root.commit-range-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 1000;
        background: #00000066;

        // Slint rectangles do not capture pointer input. Without this, clicks and
        // hovers fall through the scrim to header actions and the Files tree.
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(640px, parent.width - 48px);
            height: min(720px, parent.height - 48px);
            border-radius: 12px;
            border-width: 1px;
            border-color: root.github-border-default;
            background: root.github-bg-default;
            clip: true;

            MaterialText {
                x: 24px;
                y: 14px;
                width: parent.width - 80px;
                height: 30px;
                text: "Select commits to view";
                font-size: 18px;
                font-weight: 600;
                color: root.github-fg-default;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 48px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: commit-range-close-touch.has-hover ? root.github-bg-muted : transparent;
                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-x-16.svg");
                    image-fit: contain;
                    colorize: root.github-fg-muted;
                }
                commit-range-close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.commit-range-dialog-open = false; }
                }
            }
            Rectangle {
                x: 0px;
                y: 56px;
                width: parent.width;
                height: 1px;
                background: root.github-border-default;
            }

            commit-range-scroll := ScrollView {
                x: 0px;
                y: 57px;
                width: parent.width;
                height: parent.height - 123px;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-height: commit-range-content.preferred-height;

                commit-range-content := VerticalLayout {
                    width: commit-range-scroll.visible-width;
                    spacing: 0px;

                    all-commits-row := Rectangle {
                        width: parent.width;
                        height: 56px;
                        background: all-commits-touch.has-hover ? root.github-bg-muted : root.github-bg-default;
                        Image {
                            x: 24px;
                            y: 12px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-check-16.svg");
                            image-fit: contain;
                            colorize: root.github-fg-muted;
                            opacity: root.draft-range-start < 0 ? 1 : 0;
                        }
                        MaterialText {
                            x: 56px;
                            y: 5px;
                            width: parent.width - 80px;
                            height: 24px;
                            text: "All commits";
                            font-size: 15px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            vertical-alignment: center;
                        }
                        MaterialText {
                            x: 56px;
                            y: 29px;
                            width: parent.width - 80px;
                            height: 21px;
                            text: max(root.commit-count, root.commits.length) + " commits";
                            font-size: 13px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                        all-commits-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.draft-range-start = -1;
                                root.draft-range-end = -1;
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 72px;
                        background: root.github-bg-default;
                        MaterialText {
                            x: 56px;
                            y: 7px;
                            width: parent.width - 80px;
                            height: 25px;
                            text: "Changes since your last review";
                            font-size: 15px;
                            font-weight: 600;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                        MaterialText {
                            x: 56px;
                            y: 35px;
                            width: parent.width - 80px;
                            height: 22px;
                            text: "No previous review found";
                            font-size: 13px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 42px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-muted;
                        MaterialText {
                            x: 24px;
                            width: parent.width - 48px;
                            height: parent.height;
                            text: "Select a range of commits";
                            font-size: 13px;
                            font-weight: 600;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                    }

                    if root.commits-loading: Rectangle {
                        width: parent.width;
                        height: 180px;
                        MaterialText {
                            width: parent.width;
                            height: parent.height;
                            text: "Loading commits…";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-family: "Hiragino Sans GB";
                            color: root.github-fg-muted;
                        }
                    }
                    if !root.commits-loading && root.commits-error != "": Rectangle {
                        width: parent.width;
                        height: 220px;
                        CenteredErrorState {
                            x: 24px;
                            width: parent.width - 48px;
                            height: parent.height;
                            background-color: root.github-bg-default;
                            outline-color: root.github-border-default;
                            foreground-color: root.github-fg-default;
                            muted-color: root.github-fg-muted;
                            retry => { root.ensure-commits(); }
                        }
                    }
                    if !root.commits-loading && root.commits-error == "": VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        for commit[index] in root.commits: Rectangle {
                        private property <bool> range-selected: root.draft-range-start >= 0
                            && index >= min(root.draft-range-start, root.draft-range-end)
                            && index <= max(root.draft-range-start, root.draft-range-end);
                        width: parent.width;
                        height: max(58px, commit-title.preferred-height + 37px);
                        background: commit-choice-touch.has-hover
                            ? root.github-bg-muted
                            : root.github-bg-default;

                        Rectangle {
                            x: 24px;
                            y: 10px;
                            width: 20px;
                            height: 20px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: range-selected ? #0969da : root.github-border-default;
                            background: range-selected ? #0969da : root.github-bg-default;
                            if range-selected: Image {
                                x: 2px;
                                y: 2px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-check-16.svg");
                                image-fit: contain;
                                colorize: #ffffff;
                            }
                        }
                        commit-title := Text {
                            x: 56px;
                            y: 7px;
                            width: parent.width - 180px;
                            height: self.preferred-height;
                            text: commit.title;
                            font-family: "Hiragino Sans GB";
                            font-size: 14px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                        MaterialText {
                            x: 56px;
                            y: commit-title.y + commit-title.height + 3px;
                            width: parent.width - 180px;
                            height: 20px;
                            text: commit.author + " committed on " + commit.date-label;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        MaterialText {
                            x: parent.width - 108px;
                            y: 7px;
                            width: 84px;
                            height: 22px;
                            text: commit.short-sha;
                            font-family: root.code-font-family;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        if index + 1 < root.commits.length: Rectangle {
                            x: 56px;
                            y: parent.height - 1px;
                            width: parent.width - 80px;
                            height: 1px;
                            background: root.github-border-default;
                        }
                            commit-choice-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-draft-commit(index); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 66px;
                width: parent.width;
                height: 66px;
                border-width: 1px;
                border-color: root.github-border-default;
                background: root.github-bg-default;
                Rectangle {
                    x: parent.width - 220px;
                    y: 15px;
                    width: 92px;
                    height: 36px;
                    ReviewActionButton {
                        width: parent.width;
                        text: "Cancel";
                        clicked => { root.commit-range-dialog-open = false; }
                    }
                }
                Rectangle {
                    x: parent.width - 116px;
                    y: 15px;
                    width: 96px;
                    height: 36px;
                    ReviewActionButton {
                        width: parent.width;
                        text: "Save";
                        success: true;
                        button-enabled: !root.commits-loading && !root.loading;
                        clicked => {
                            root.apply-commit-range(root.draft-range-start, root.draft-range-end);
                            root.commit-range-dialog-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.review-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 1000;
        background: #00000066;

        // Slint rectangles do not capture pointer input. Without this, clicks and
        // hovers fall through the scrim to readiness / review / merge controls.
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 48px);
            height: min(500px, parent.height - 48px);
            border-radius: 12px;
            border-width: 1px;
            border-color: root.github-border-default;
            background: root.github-bg-default;

            MaterialText {
                x: 20px;
                y: 16px;
                width: parent.width - 64px;
                height: 28px;
                text: "Review changes";
                font_size: 16px;
                font_weight: 600;
                color: root.github-fg-default;
                vertical_alignment: center;
            }
            Rectangle {
                x: parent.width - 44px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: review-close-touch.has-hover ? root.github-bg-muted : transparent;
                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: root.github-fg-muted;
                }
                review-close-touch := TouchArea {
                    enabled: !root.action-loading;
                    mouse-cursor: pointer;
                    clicked => { root.review-dialog-open = false; }
                }
            }
            Rectangle { x: 0px; y: 56px; width: parent.width; height: 1px; background: root.github-border-default; }

            MaterialText {
                x: 20px;
                y: 72px;
                width: parent.width - 40px;
                height: 20px;
                text: "Review summary";
                font_size: 12px;
                font_weight: 600;
                color: root.github-fg-default;
            }
            Rectangle {
                x: 20px;
                y: 98px;
                width: parent.width - 40px;
                height: 112px;
                border-radius: 6px;
                border-width: 1px;
                border-color: review-editor.has-focus ? #0969da : root.github-border-default;
                background: root.github-bg-default;
                review-editor := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    text <=> root.review-body;
                    single-line: false;
                    wrap: word-wrap;
                    color: root.github-fg-default;
                    font-size: 12px;
                    enabled: !root.action-loading;
                }
            }

            VerticalLayout {
                x: 12px;
                y: 220px;
                width: parent.width - 24px;
                spacing: 0px;
                ReviewChoice {
                    width: parent.width;
                    title: "Comment";
                    description: "Submit general feedback without explicit approval.";
                    selected: root.selected-review-action == "comment";
                    choice-enabled: root.can-comment && !root.action-loading;
                    chosen => { root.selected-review-action = "comment"; }
                }
                ReviewChoice {
                    width: parent.width;
                    title: "Approve";
                    description: "Submit feedback and approve merging these changes.";
                    selected: root.selected-review-action == "approve";
                    choice-enabled: root.can-approve && !root.action-loading;
                    chosen => { root.selected-review-action = "approve"; }
                }
                ReviewChoice {
                    width: parent.width;
                    title: "Request changes";
                    description: root.provider == "gitee" && !root.can-request-changes
                        ? "Gitee public v5 does not provide this review action."
                        : "Submit feedback that must be addressed before merging.";
                    selected: root.selected-review-action == "request_changes";
                    choice-enabled: root.can-request-changes && !root.action-loading;
                    chosen => { root.selected-review-action = "request_changes"; }
                }
            }

            Rectangle { x: 0px; y: parent.height - 62px; width: parent.width; height: 1px; background: root.github-border-default; }
            Rectangle {
                x: parent.width - 238px;
                y: parent.height - 49px;
                width: 94px;
                height: 36px;
                ReviewActionButton {
                    width: parent.width;
                    text: "Cancel";
                    button-enabled: !root.action-loading;
                    clicked => { root.review-dialog-open = false; }
                }
            }
            Rectangle {
                x: parent.width - 132px;
                y: parent.height - 49px;
                width: 112px;
                height: 36px;
                ReviewActionButton {
                    width: parent.width;
                    text: root.action-loading ? "Submitting…" : "Submit review";
                    success: true;
                    button-enabled: !root.action-loading;
                    clicked => { root.submit-review(root.selected-review-action, root.review-body); }
                }
            }
        }
    }

    if root.merge-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 1000;
        background: #00000066;

        // Same scrim hit-target as review/revert: block all underlay interaction.
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(500px, parent.width - 48px);
            height: min(470px, parent.height - 48px);
            border-radius: 12px;
            border-width: 1px;
            border-color: root.github-border-default;
            background: root.github-bg-default;

            MaterialText {
                x: 20px;
                y: 16px;
                width: parent.width - 64px;
                height: 28px;
                text: "Merge pull request #" + root.pull-request-number;
                font_size: 16px;
                font_weight: 600;
                color: root.github-fg-default;
                vertical_alignment: center;
            }
            Rectangle {
                x: parent.width - 44px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: merge-close-touch.has-hover ? root.github-bg-muted : transparent;
                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: root.github-fg-muted;
                }
                merge-close-touch := TouchArea {
                    enabled: !root.action-loading;
                    mouse-cursor: pointer;
                    clicked => { root.merge-dialog-open = false; }
                }
            }
            Rectangle { x: 0px; y: 56px; width: parent.width; height: 1px; background: root.github-border-default; }
            MaterialText {
                x: 20px;
                y: 70px;
                width: parent.width - 40px;
                height: 36px;
                text: "Choose how the commits from " + root.source-branch + " are added to " + root.target-branch + ".";
                font_size: 12px;
                color: root.github-fg-muted;
                wrap: word-wrap;
            }

            VerticalLayout {
                x: 12px;
                y: 112px;
                width: parent.width - 24px;
                spacing: 0px;
                if root.merge-method-merge: ReviewChoice {
                    width: parent.width;
                    title: "Create a merge commit";
                    description: "All commits will be added with a merge commit.";
                    selected: root.selected-merge-method == "merge";
                    choice-enabled: !root.action-loading;
                    chosen => { root.selected-merge-method = "merge"; }
                }
                if root.merge-method-squash: ReviewChoice {
                    width: parent.width;
                    title: "Squash and merge";
                    description: "The commits will be combined into one commit.";
                    selected: root.selected-merge-method == "squash";
                    choice-enabled: !root.action-loading;
                    chosen => { root.selected-merge-method = "squash"; }
                }
                if root.merge-method-rebase: ReviewChoice {
                    width: parent.width;
                    title: "Rebase and merge";
                    description: "The commits will be rebased onto the base branch.";
                    selected: root.selected-merge-method == "rebase";
                    choice-enabled: !root.action-loading;
                    chosen => { root.selected-merge-method = "rebase"; }
                }
                if root.merge-method-fast-forward: ReviewChoice {
                    width: parent.width;
                    title: "Fast-forward and merge";
                    description: "Move the base branch directly to the pull request head.";
                    selected: root.selected-merge-method == "fast_forward";
                    choice-enabled: !root.action-loading;
                    chosen => { root.selected-merge-method = "fast_forward"; }
                }
            }

            Rectangle {
                x: 20px;
                y: parent.height - 104px;
                width: parent.width - 40px;
                height: 34px;
                background: source-branch-touch.has-hover ? root.github-bg-muted : transparent;
                Rectangle {
                    x: 0px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.remove-source-branch ? #0969da : root.github-border-default;
                    background: root.remove-source-branch ? #0969da : transparent;
                    if root.remove-source-branch: MaterialText {
                        width: parent.width;
                        height: parent.height;
                        text: "✓";
                        font_size: 11px;
                        font_weight: 700;
                        color: #ffffff;
                        horizontal_alignment: center;
                        vertical_alignment: center;
                    }
                }
                MaterialText {
                    x: 26px;
                    width: parent.width - 26px;
                    height: parent.height;
                    text: "Delete the source branch after merging";
                    font_size: 12px;
                    color: root.github-fg-default;
                    vertical_alignment: center;
                }
                source-branch-touch := TouchArea {
                    enabled: !root.action-loading;
                    mouse-cursor: pointer;
                    clicked => { root.remove-source-branch = !root.remove-source-branch; }
                }
            }

            Rectangle { x: 0px; y: parent.height - 62px; width: parent.width; height: 1px; background: root.github-border-default; }
            Rectangle {
                x: parent.width - 250px;
                y: parent.height - 49px;
                width: 94px;
                height: 36px;
                ReviewActionButton {
                    width: parent.width;
                    text: "Cancel";
                    button-enabled: !root.action-loading;
                    clicked => { root.merge-dialog-open = false; }
                }
            }
            Rectangle {
                x: parent.width - 144px;
                y: parent.height - 49px;
                width: 124px;
                height: 36px;
                ReviewActionButton {
                    width: parent.width;
                    text: root.action-loading ? "Merging…" : "Confirm merge";
                    success: true;
                    button-enabled: !root.action-loading && root.can-merge;
                    clicked => { root.merge(root.selected-merge-method, root.remove-source-branch); }
                }
            }
        }
    }

    if root.revert-dialog-open: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        z: 1000;
        background: #00000066;

        // Same scrim hit-target as review/merge: block all underlay interaction.
        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(500px, parent.width - 48px);
            height: 300px;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.github-border-default;
            background: root.github-bg-default;

            MaterialText {
                x: 20px;
                y: 16px;
                width: parent.width - 64px;
                height: 28px;
                text: "Revert pull request #" + root.pull-request-number;
                font-size: 16px;
                font-weight: 600;
                color: root.github-fg-default;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 44px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: revert-close-touch.has-hover ? root.github-bg-muted : transparent;
                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: root.github-fg-muted;
                }
                revert-close-touch := TouchArea {
                    enabled: !root.action-loading;
                    mouse-cursor: root.action-loading ? default : pointer;
                    clicked => { root.revert-dialog-open = false; }
                }
            }
            Rectangle {
                x: 0px;
                y: 56px;
                width: parent.width;
                height: 1px;
                background: root.github-border-default;
            }
            MaterialText {
                x: 20px;
                y: 78px;
                width: parent.width - 40px;
                height: 28px;
                text: "Reverse the changes introduced by this merged pull request?";
                font-size: 14px;
                font-weight: 600;
                color: root.github-fg-default;
                wrap: word-wrap;
                vertical-alignment: top;
            }
            MaterialText {
                x: 20px;
                y: 122px;
                width: parent.width - 40px;
                height: 92px;
                text: root.revert-confirmation;
                font-size: 12px;
                color: root.github-fg-muted;
                wrap: word-wrap;
                vertical-alignment: top;
            }
            Rectangle {
                x: 0px;
                y: parent.height - 62px;
                width: parent.width;
                height: 1px;
                background: root.github-border-default;
            }
            Rectangle {
                x: parent.width - 20px - confirm-revert.width - 12px - 94px;
                y: parent.height - 49px;
                width: 94px;
                height: 36px;
                ReviewActionButton {
                    width: parent.width;
                    text: "Cancel";
                    button-enabled: !root.action-loading;
                    clicked => { root.revert-dialog-open = false; }
                }
            }
            confirm-revert := ReviewActionButton {
                x: parent.width - 20px - self.width;
                y: parent.height - 49px;
                hug-content: true;
                text: root.action-loading ? "Working…" : root.revert-action-label;
                danger: true;
                button-enabled: !root.action-loading && root.can-revert;
                tooltip-text: root.can-revert ? "" : root.revert-block-reason;
                clicked => { root.revert(); }
            }
        }
    }
}
