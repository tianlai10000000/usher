                    }

                    if root.large-diff-deferred || root.large-diff-loading: GitHubLargeDiffPlaceholder {
                        z: 30;
                        x: 0px;
                        y: 46px;
                        width: parent.width;
                        height: parent.height - 46px;
                        loading: root.large-diff-loading;
                        bg-default: root.github-bg-default;
                        bg-muted: root.github-bg-muted;
                        fg-muted: root.github-fg-muted;
                        accent-fg: GitHubTheme.accent-fg;
                        load => { root.load-large-diff(); }
                    }

                    if root.code-loading && !root.large-diff-loading: GitHubCodeRenderingIndicator {
                        x: (parent.width - self.width) / 2;
                        y: 56px;
                    }

                }

                file-list-resize-handle := TouchArea {
                    x: root.file-list-visible ? root.file-list-width - 4px : -10px;
                    y: 0px;
                    width: root.file-list-visible ? 9px : 0px;
                    height: parent.height;
                    z: 100;
                    mouse-cursor: col-resize;
                    moved => {
                        if root.file-list-resizing {
                            // The handle moves with the divider, so its local
                            // pointer delta is the distance still left to
                            // follow, not the distance from the original
                            // press. Applying it to the current width keeps
                            // the divider locked to the pointer.
                            root.file-list-preferred-width = max(
                                root.file-list-min-width,
                                min(
                                    root.file-list-max-width,
                                    root.file-list-width + (self.mouse-x - self.pressed-x)
                                )
                            );
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.file-list-resizing = true;
                            root.file-list-drag-start-width = root.file-list-width;
                        } else if event.kind == PointerEventKind.up {
                            root.file-list-resizing = false;
                        } else if event.kind == PointerEventKind.cancel {
                            root.file-list-preferred-width = root.file-list-drag-start-width;
                            root.file-list-resizing = false;
                        }
                    }
                }
                Rectangle {
                    x: root.file-list-width - 1px;
                    y: 0px;
                    width: 3px;
                    height: parent.height;
                    z: 101;
                    background: GitHubTheme.fg-muted;
                    opacity: root.file-list-visible && (root.file-list-resizing || file-list-resize-handle.has-hover) ? 0.8 : 0;
                }

                // Sync the filter IconButton position to the workspace-root
                // ActionMenu host. Nested ids are not visible outside this
                // conditional, so push coordinates through root properties.
                if root.file-list-visible: filter-menu-anchor := Rectangle {
                    x: root.file-list-width - 46px;
                    y: 9px;
                    width: 34px;
                    height: 34px;
                    background: transparent;
                    init => {
                        root.filter-menu-anchor-x = self.absolute-position.x - root.absolute-position.x;
                        root.filter-menu-anchor-y = self.absolute-position.y - root.absolute-position.y;
                    }
                    changed absolute-position => {
                        root.filter-menu-anchor-x = self.absolute-position.x - root.absolute-position.x;
                        root.filter-menu-anchor-y = self.absolute-position.y - root.absolute-position.y;
                    }
                }
            }
        }
        }

        // Paint the split-pane boundary in the live viewport instead of the
        // frozen diff tree so it remains visible throughout a divider drag.
        if root.ai-review-panel-visible: Rectangle {
            x: parent.width - GitHubMetrics.border-thin;
            y: 0px;
            width: GitHubMetrics.border-thin;
            height: parent.height;
            z: 200;
            background: root.github-border-default;
        }
    }

    review-actions-menu := GitHubActionMenu {
        open: root.selected-tab == 0 && root.active-popover == "review-actions";
        viewport-x: root.shell-leading-inset;
        viewport-y: 0px;
        viewport-width: root.content-width;
        viewport-height: root.height;
        anchor-x: root.review-menu-anchor-x;
        anchor-y: root.review-menu-anchor-y;
        anchor-width: 32px;
        anchor-height: 32px;
        menu-width: 184px;
        content-height: 40px;
        align: "end";
        dismiss-requested => { root.active-popover = ""; }

        GitHubActionListItem {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            text: I18n.pr-review-dismiss-review;
            danger: true;
            item-enabled: !root.action-loading;
            activated => {
                root.active-popover = "";
                root.dismiss-review-reason = "";
                root.dismiss-review-dialog-open = true;
            }
        }
    }

    // Host File extensions above VerticalLayout siblings (toolbar z:80, tabs)
    // so auto-flip on short/narrow windows is not covered. Anchor coords are
    // synced from filter-menu-anchor inside the files pane.
    if root.selected-tab == 2 && root.file-list-visible && !root.loading && root.error-text == "": GitHubFilterMenu {
        z: 1200;
        x: root.filter-menu-anchor-x;
        y: root.filter-menu-anchor-y;
        open: root.active-popover == "file-filter";
        viewport-global-x: root.absolute-position.x + root.shell-leading-inset;
        viewport-global-y: root.absolute-position.y;
        viewport-width: root.content-width;
        viewport-height: root.height;
        extension-filters: root.extension-filters;
        only-manifest-files: root.only-manifest-files;
        show-viewed-files: root.show-viewed-files;
        font-family: root.tree-font-family;
        toggle-extension(extension) => { root.toggle-extension-filter(extension); }
        toggle-manifest => { root.toggle-manifest-filter(); }
        toggle-viewed => { root.toggle-viewed-files(); }
        dismiss => { root.active-popover = ""; }
    }

    commit-dialog-frame := GitHubDialog {
        viewport-x: -root.absolute-position.x;
        viewport-y: 0px;
        viewport-width: root.application-width;
        viewport-height: root.dialog-viewport-height;
        backdrop-y: 0px;
        backdrop-height: root.dialog-viewport-height;
        dialog-visible: root.commit-range-dialog-open;
        modal: false;
        title: I18n.pr-review-select-commits;
        dialog-width: 640px;
        dialog-height: min(720px, root.dialog-viewport-height - 32px);
        body-padding: 0px;
        close-enabled: !root.loading;
        primary-label: I18n.common-save;
        primary-success: true;
        primary-enabled: !root.commits-loading && !root.loading;
        close-requested => { root.commit-range-dialog-open = false; }
        cancel-clicked => { root.commit-range-dialog-open = false; }
        primary-clicked => {
            root.apply-commit-range(root.draft-range-start, root.draft-range-end);
            root.commit-range-dialog-open = false;
        }

            if root.commit-range-dialog-open: commit-range-scroll := ScrollView {
                x: commit-dialog-frame.content-x;
                y: commit-dialog-frame.content-y;
                width: commit-dialog-frame.content-width;
                height: commit-dialog-frame.content-height;
                z: 3100;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-height: commit-range-content.preferred-height;

                commit-range-content := VerticalLayout {
                    width: commit-range-scroll.visible-width;
                    spacing: 0px;

                    all-commits-row := Rectangle {
                        width: parent.width;
                        height: 56px;
                        background: all-commits-touch.has-hover ? root.github-bg-muted : root.github-bg-default;
                        Image {
                            x: 24px;
                            y: 12px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-check-16.svg");
                            image-fit: contain;
                            colorize: root.github-fg-muted;
                            opacity: root.draft-range-start < 0 ? 1 : 0;
                        }
                        Text {
                            x: 56px;
                            y: 5px;
                            width: parent.width - 80px;
                            height: 24px;
                            text: I18n.pr-review-all-commits;
                            font-size: 15px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 56px;
                            y: 29px;
                            width: parent.width - 80px;
                            height: 21px;
                            text: max(root.commit-count, root.commits.length) + " commits";
                            font-size: 13px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                        all-commits-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.draft-range-start = -1;
                                root.draft-range-end = -1;
                            }
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 72px;
                        background: root.github-bg-default;
                        Text {
                            x: 56px;
                            y: 7px;
                            width: parent.width - 80px;
                            height: 25px;
                            text: I18n.pr-review-changes-since-review;
                            font-size: 15px;
                            font-weight: 600;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 56px;
                            y: 35px;
                            width: parent.width - 80px;
                            height: 22px;
                            text: I18n.pr-review-no-previous-review;
                            font-size: 13px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: parent.width;
                        height: 42px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-muted;
                        Text {
                            x: 24px;
                            width: parent.width - 48px;
                            height: parent.height;
                            text: I18n.pr-review-select-commit-range;
                            font-size: 13px;
                            font-weight: 600;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                        }
                    }

                    if root.commits-loading: GitHubCenteredLoadingState {
                        width: parent.width;
                        height: 180px;
                        label: I18n.pr-review-loading-commits;
                        foreground: root.github-fg-muted;
                    }
                    if !root.commits-loading && root.commits-error != "": Rectangle {
                        width: parent.width;
                        height: 220px;
                        GitHubCenteredErrorState {
                            x: 24px;
                            width: parent.width - 48px;
                            height: parent.height;
                            background-color: root.github-bg-default;
                            outline-color: root.github-border-default;
                            foreground-color: root.github-fg-default;
                            muted-color: root.github-fg-muted;
                            retry => { root.ensure-commits(); }
                        }
                    }
                    if !root.commits-loading && root.commits-error == "": VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        for commit[index] in root.commits: Rectangle {
                        private property <bool> range-selected: root.draft-range-start >= 0
                            && index >= min(root.draft-range-start, root.draft-range-end)
                            && index <= max(root.draft-range-start, root.draft-range-end);
                        width: parent.width;
                        height: max(58px, commit-title.preferred-height + 37px);
                        background: commit-choice-touch.has-hover
                            ? root.github-bg-muted
                            : root.github-bg-default;

                        Rectangle {
                            x: 24px;
                            y: 10px;
                            width: 20px;
                            height: 20px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: range-selected ? GitHubTheme.accent-emphasis : root.github-border-default;
                            background: range-selected ? GitHubTheme.accent-emphasis : root.github-bg-default;
                            if range-selected: Image {
                                x: 2px;
                                y: 2px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-check-16.svg");
                                image-fit: contain;
                                colorize: GitHubTheme.fg-on-emphasis;
                            }
                        }
                        commit-title := Text {
                            x: 56px;
                            y: 7px;
                            width: parent.width - 180px;
                            height: self.preferred-height;
                            text: commit.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                        Text {
                            x: 56px;
                            y: commit-title.y + commit-title.height + 3px;
                            width: parent.width - 180px;
                            height: 20px;
                            text: commit.identity-action + " on " + commit.date-label;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 108px;
                            y: 7px;
                            width: 84px;
                            height: 22px;
                            text: commit.short-sha;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        if index + 1 < root.commits.length: Rectangle {
                            x: 56px;
                            y: parent.height - 1px;
                            width: parent.width - 80px;
                            height: 1px;
                            background: root.github-border-default;
                        }
                            commit-choice-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-draft-commit(index); }
                            }
                        }
                    }
                }
            }
    }

    dismiss-review-dialog-frame := GitHubDialog {
        viewport-x: -root.absolute-position.x;
        viewport-y: 0px;
        viewport-width: root.application-width;
        viewport-height: root.dialog-viewport-height;
        backdrop-y: 0px;
        backdrop-height: root.dialog-viewport-height;
        dialog-visible: root.dismiss-review-dialog-open;
        modal: false;
        title: I18n.pr-review-dismiss-review;
        dialog-width: 480px;
        dialog-height: 324px;
        body-padding: 0px;
        close-enabled: !root.action-loading;
        primary-label: root.action-loading ? I18n.pr-review-dismissing : I18n.pr-review-dismiss-review;
        primary-danger: true;
        primary-enabled: !root.action-loading && root.dismiss-review-reason != "";
        primary-busy: root.action-loading;
        close-requested => { root.dismiss-review-dialog-open = false; }
        cancel-clicked => { root.dismiss-review-dialog-open = false; }
        primary-clicked => {
            root.dismiss-review(root.dismiss-review-id, root.dismiss-review-reason);
        }

        if root.dismiss-review-dialog-open: Text {
            x: dismiss-review-dialog-frame.content-x + 16px;
            y: dismiss-review-dialog-frame.content-y + 14px;
            width: dismiss-review-dialog-frame.content-width - 32px;
            height: 42px;
            z: 3100;
            text: I18n.pr-review-dismiss-explanation-prefix + " " + root.dismiss-review-author
                + " " + I18n.pr-review-dismiss-explanation-suffix;
            font-size: 12px;
            color: root.github-fg-muted;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        if root.dismiss-review-dialog-open: Text {
            x: dismiss-review-dialog-frame.content-x + 16px;
            y: dismiss-review-dialog-frame.content-y + 66px;
            width: dismiss-review-dialog-frame.content-width - 32px;
            height: 20px;
            z: 3100;
            text: I18n.pr-review-dismiss-reason;
            font-size: 12px;
            font-weight: 600;
            color: root.github-fg-default;
        }
        if root.dismiss-review-dialog-open: Rectangle {
            x: dismiss-review-dialog-frame.content-x + 16px;
            y: dismiss-review-dialog-frame.content-y + 92px;
            width: dismiss-review-dialog-frame.content-width - 32px;
            height: 92px;
            z: 3100;
            border-radius: 6px;
            border-width: 1px;
            border-color: dismiss-reason-editor.has-focus
                ? GitHubTheme.accent-emphasis
                : root.github-border-default;
            background: root.github-bg-default;
            dismiss-reason-editor := TextInput {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text <=> root.dismiss-review-reason;
                single-line: false;
                wrap: word-wrap;
                color: root.github-fg-default;
                font-size: 12px;
                enabled: !root.action-loading;
            }
        }
    }

    review-dialog-frame := GitHubDialog {
        viewport-x: -root.absolute-position.x;
        viewport-y: 0px;
        viewport-width: root.application-width;
        viewport-height: root.dialog-viewport-height;
        backdrop-y: 0px;
        backdrop-height: root.dialog-viewport-height;
        dialog-visible: root.review-dialog-open;
        modal: false;
        title: I18n.pr-review-review-changes;
        dialog-width: 480px;
        dialog-height: min(500px, root.dialog-viewport-height - 32px);
        body-padding: 0px;
        close-enabled: !root.action-loading;
        primary-label: root.action-loading ? I18n.pr-review-submitting : I18n.pr-review-submit-review;
        primary-success: true;
        primary-enabled: !root.action-loading;
        primary-busy: root.action-loading;
        close-requested => { root.review-dialog-open = false; }
        cancel-clicked => { root.review-dialog-open = false; }
        primary-clicked => { root.submit-review(root.selected-review-action, root.review-body); }

        if root.review-dialog-open: Text {
            x: review-dialog-frame.content-x + 16px;
            y: review-dialog-frame.content-y + 16px;
            width: review-dialog-frame.content-width - 32px;
            height: 20px;
            z: 3100;
            text: I18n.pr-review-review-summary;
            font-size: 12px;
            font-weight: 600;
            color: root.github-fg-default;
        }
        if root.review-dialog-open: Rectangle {
            x: review-dialog-frame.content-x + 16px;
            y: review-dialog-frame.content-y + 42px;
            width: review-dialog-frame.content-width - 32px;
            height: 112px;
            z: 3100;
            border-radius: 6px;
            border-width: 1px;
            border-color: review-editor.has-focus ? GitHubTheme.accent-emphasis : root.github-border-default;
            background: root.github-bg-default;
            review-editor := TextInput {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text <=> root.review-body;
                single-line: false;
                wrap: word-wrap;
                color: root.github-fg-default;
                font-size: 12px;
                enabled: !root.action-loading;
            }
        }
        if root.review-dialog-open: VerticalLayout {
            x: review-dialog-frame.content-x + 8px;
            y: review-dialog-frame.content-y + 164px;
            width: review-dialog-frame.content-width - 16px;
            z: 3100;
            spacing: 0px;
            GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-comment;
                description: I18n.pr-review-comment-description;
                selected: root.selected-review-action == "comment";
                choice-enabled: root.can-comment && !root.action-loading;
                chosen => { root.selected-review-action = "comment"; }
            }
            GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-approve;
                description: I18n.pr-review-approve-description;
                selected: root.selected-review-action == "approve";
                choice-enabled: root.can-approve && !root.action-loading;
                chosen => { root.selected-review-action = "approve"; }
            }
            GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-request-changes;
                description: root.provider == "gitee" && !root.can-request-changes
                    ? I18n.pr-review-gitee-review-action-unavailable
                    : I18n.pr-review-request-changes-description;
                selected: root.selected-review-action == "request_changes";
                choice-enabled: root.can-request-changes && !root.action-loading;
                chosen => { root.selected-review-action = "request_changes"; }
            }
        }
    }

    merge-dialog-frame := GitHubDialog {
        viewport-x: -root.absolute-position.x;
        viewport-y: 0px;
        viewport-width: root.application-width;
        viewport-height: root.dialog-viewport-height;
        backdrop-y: 0px;
        backdrop-height: root.dialog-viewport-height;
        dialog-visible: root.merge-dialog-open;
        modal: false;
        title: I18n.pr-review-merge-pull-request + " #" + root.pull-request-number;
        dialog-width: 480px;
        dialog-height: min(470px, root.dialog-viewport-height - 32px);
        body-padding: 0px;
        close-enabled: !root.action-loading;
        primary-label: root.action-loading ? I18n.pr-review-merging : I18n.pr-review-confirm-merge;
        primary-success: true;
        primary-enabled: !root.action-loading && root.can-merge;
        primary-busy: root.action-loading;
        close-requested => { root.merge-dialog-open = false; }
        cancel-clicked => { root.merge-dialog-open = false; }
        primary-clicked => {
            root.merge(
                root.selected-merge-method,
                root.merge-delete-source-branch-supported && root.remove-source-branch,
            );
        }

        if root.merge-dialog-open: Text {
            x: merge-dialog-frame.content-x + 16px;
            y: merge-dialog-frame.content-y + 14px;
            width: merge-dialog-frame.content-width - 32px;
            height: 36px;
            z: 3100;
            text: I18n.pr-review-merge-description-prefix + " " + root.source-branch + " " + I18n.pr-review-merge-description-infix + " " + root.target-branch + ".";
            font-size: 12px;
            color: root.github-fg-muted;
            wrap: word-wrap;
        }
        if root.merge-dialog-open: VerticalLayout {
            x: merge-dialog-frame.content-x + 8px;
            y: merge-dialog-frame.content-y + 56px;
            width: merge-dialog-frame.content-width - 16px;
            z: 3100;
            spacing: 0px;
            if root.merge-method-merge: GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-create-merge-commit;
                description: I18n.pr-review-create-merge-commit-description;
                selected: root.selected-merge-method == "merge";
                choice-enabled: !root.action-loading;
                chosen => { root.selected-merge-method = "merge"; }
            }
            if root.merge-method-squash: GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-squash-merge;
                description: I18n.pr-review-squash-merge-description;
                selected: root.selected-merge-method == "squash";
                choice-enabled: !root.action-loading;
                chosen => { root.selected-merge-method = "squash"; }
            }
            if root.merge-method-rebase: GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-rebase-merge;
                description: I18n.pr-review-rebase-merge-description;
                selected: root.selected-merge-method == "rebase";
                choice-enabled: !root.action-loading;
                chosen => { root.selected-merge-method = "rebase"; }
            }
            if root.merge-method-fast-forward: GitHubReviewChoice {
                width: parent.width;
                title: I18n.pr-review-fast-forward-merge;
                description: I18n.pr-review-fast-forward-merge-description;
                selected: root.selected-merge-method == "fast_forward";
                choice-enabled: !root.action-loading;
                chosen => { root.selected-merge-method = "fast_forward"; }
            }
        }
        if root.merge-dialog-open && root.merge-delete-source-branch-supported: Rectangle {
            x: merge-dialog-frame.content-x + 16px;
            y: merge-dialog-frame.content-y + merge-dialog-frame.content-height - 42px;
            width: merge-dialog-frame.content-width - 32px;
            height: 34px;
            z: 3100;
            border-radius: 6px;
            background: source-branch-touch.has-hover ? root.github-bg-muted : transparent;
            Rectangle {
                x: 0px;
                y: 8px;
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: 1px;
                border-color: root.remove-source-branch ? GitHubTheme.accent-emphasis : root.github-border-default;
                background: root.remove-source-branch ? GitHubTheme.accent-emphasis : transparent;
                if root.remove-source-branch: Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-16.svg");
                    colorize: GitHubTheme.fg-on-emphasis;
                }
            }
            Text {
                x: 26px;
                width: parent.width - 26px;
                height: parent.height;
                text: I18n.pr-review-delete-source-branch;
                font-size: 12px;
                color: root.github-fg-default;
                vertical-alignment: center;
            }
            source-branch-touch := TouchArea {
                enabled: !root.action-loading;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { root.remove-source-branch = !root.remove-source-branch; }
            }
        }
    }

    revert-dialog-frame := GitHubDialog {
        viewport-x: -root.absolute-position.x;
        viewport-y: 0px;
        viewport-width: root.application-width;
        viewport-height: root.dialog-viewport-height;
        backdrop-y: 0px;
        backdrop-height: root.dialog-viewport-height;
        dialog-visible: root.revert-dialog-open;
        modal: false;
        title: I18n.pr-review-revert-pull-request + " #" + root.pull-request-number;
        dialog-width: 480px;
        dialog-height: 296px;
        body-padding: 16px;
        close-enabled: !root.action-loading;
        primary-label: root.action-loading ? I18n.common-working : root.revert-action-label;
        primary-danger: true;
        primary-enabled: !root.action-loading && root.can-revert;
        primary-busy: root.action-loading;
        close-requested => { root.revert-dialog-open = false; }
        cancel-clicked => { root.revert-dialog-open = false; }
        primary-clicked => { root.revert(); }

        if root.revert-dialog-open: Text {
            x: revert-dialog-frame.content-x;
            y: revert-dialog-frame.content-y;
            width: revert-dialog-frame.content-width;
            height: 36px;
            z: 3100;
            text: I18n.pr-review-revert-confirmation;
            font-size: 14px;
            font-weight: 600;
            color: root.github-fg-default;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        if root.revert-dialog-open: Text {
            x: revert-dialog-frame.content-x;
            y: revert-dialog-frame.content-y + 48px;
            width: revert-dialog-frame.content-width;
            height: revert-dialog-frame.content-height - 48px;
            z: 3100;
            text: root.revert-confirmation;
            font-size: 12px;
            color: root.github-fg-muted;
            wrap: word-wrap;
            vertical-alignment: top;
        }
    }
}
