import { ListView, ScrollView } from "@material";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { AppState } from "../../state/app_state.slint";
import { TransientOverlayState } from "../../state/transient_overlay_state.slint";
import { GitHubDialog } from "../../components/dialog/github_dialog.slint";
import { WorkflowPrDiffFile, WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrDiffSelectionRange, WorkflowPrDiffTextSlice, WorkflowPrDiffGlyphRange, WorkflowPrDiffGlyphRect, WorkflowPrDiffFindMatch, WorkflowPrDiffLine, WorkflowPrDiffRowMetric, WorkflowPrDiffVirtualWindow, WorkflowPrTreeItem, WorkflowPrFileExtensionFilter, WorkflowPrConversationItem, GitHubConversationAvatar, GitHubCommitIdentityAvatars, WorkflowPrCommit, GitHubCommentButton, GitHubPullRequestStateBadge, GitHubBranchLabel, GitHubRelativeTimestamp, GitHubPullRequestSummaryMetrics, GitHubPullRequestSummaryRow, GitHubCenteredErrorState, GitHubPullRequestTabButton, GitHubCommitRangeButton, GitHubMergeReadinessBadge, GitHubReviewChoice } from "../../components/pr_review/shell.slint";
import { GitHubTreeIndentGuides, GitHubCommitMessageToggleButton, GitHubFileToolbarButton, GitHubCommitSummaryNavButton, GitHubFileChangeTypeIcon, GitHubSelectableDiffCode, GitHubSplitDiffSide, GitHubDiffViewPreview, GitHubDiffViewChoice, GitHubDiffSettingsPopover, GitHubFileTreeToggleButton, GitHubFileMenuButton, GitHubDiffStatSegment, GitHubDiffStatBar, GitHubFileDiffStat, GitHubCodeRenderingIndicator, GitHubLargeDiffPlaceholder, GitHubFileFilterField, GitHubFilterMenu, GitHubDiffFindBar } from "../../components/pr_review/content.slint";
import { GitHubCopyButton } from "../../components/button/github_copy_button.slint";
import { GitHubIconButton } from "../../components/button/github_icon_button.slint";
import { GitHubTooltip } from "../../components/github_tooltip.slint";
import { GitHubTooltipAlignment, GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubCenteredLoadingState } from "../../components/github_spinner.slint";
import { GitHubVirtualListScrollbar } from "../../components/github_scroll_view.slint";
import { GitHubActionListItem, GitHubActionMenu, GitHubActionMenuTriggerArea } from "../../components/github_action_menu.slint";
import { PullRequestReviewPageContract } from "../../features/pr_review/contract.slint";
import { I18n } from "@i18n";
export component GitHubPullRequestReviewPage inherits PullRequestReviewPageContract {
    // This route intentionally spans the full window so its Dialogs can cover
    // the docked AI Review panel. Do not let the root FocusScope consume a
    // panel click merely to focus itself; nested PR controls own their focus.
    focus-on-click: false;

    // Full application viewport used by route-owned root overlays. The page
    // root stays at x=0; ordinary review content applies shell-leading-inset
    // internally so the sidebar can translate it without moving the large
    // render-tree root. shell-content-width changes only at motion boundaries,
    // avoiding a full diff-tree reflow on every animation frame.
    private property <string> selected-file-change-type:
        root.selected-file-index >= 0 && root.selected-file-index < root.files.length
            ? root.files[root.selected-file-index].change-type
            : "edit_file";
    private property <length> file-list-min-width: 220px;
    private property <length> file-list-max-width: max(root.file-list-min-width, min(520px, root.content-width * 0.45));
    // Preserve the session preference while clamping the rendered width when
    // the window becomes narrower.
    private property <length> file-list-width: max(root.file-list-min-width, min(root.file-list-max-width, root.file-list-preferred-width));
    private property <bool> file-list-resizing: false;
    private property <length> file-list-drag-start-width: root.file-list-width;
    // Session show/hide preference. Width-threshold crossings auto-set this;
    // the toolbar toggle always flips it, including while below the breakpoint.
    private property <bool> file-list-user-visible: true;
    private property <bool> show-single-commit-summary:
        root.commit-range-start >= 0
            && root.commit-range-start == root.commit-range-end
            && root.commit-range-start < root.commits.length;
    // Rust registers GitHub's preferred macOS monospace face (SFMono-Regular)
    // at startup. Menlo remains the explicit fallback when that system font is
    // unavailable; Slint 1.17 accepts one family name rather than a CSS stack.
    private property <length> code-line-height: 22px;
    private property <length> hunk-line-height: 28px;
    // GitHub Commits tab: one shared card per UTC+08:00 date group.
    // Match Primer Box-row density (~16px vertical padding) and the gap
    // under "Commits on …" before the bordered card.
    private property <length> commit-tab-row-height: 72px;
    private property <length> commit-tab-group-header-height: 44px;
    private property <length> commit-tab-content-x: 16px;
    private property <length> commit-tab-content-y: 12px;
    private property <length> commit-tab-card-radius: 6px;
    // Expanded: title band + body + author footer (avatar). Collapsed is 72px.
    private property <length> commit-tab-title-band: 36px;
    private property <length> commit-tab-author-band: 28px;
    private property <length> commit-tab-body-footer-gap: 8px;
    // Derive the cell advance from the actual registered face instead of a
    // hard-coded estimate. Selection, wrapping, and token geometry share it.
    private property <length> code-character-width:
        max(1px, code-cell-measure.preferred-width / 32);
    private property <length> code-natural-line-height:
        max(1px, code-cell-measure.preferred-height);
    private property <length> measured-code-width:
        max(root.max-code-columns * root.code-character-width, longest-code-line-measure.preferred-width);
    // GitHub Primer functional tokens (primer/primitives:
    // src/tokens/functional/color/fgColor.json5) and DiffBlob tokens.
    private property <color> github-bg-default: GitHubTheme.canvas-default;
    private property <color> github-bg-muted: GitHubTheme.canvas-subtle;
    private property <color> github-border-default: GitHubTheme.border-default;
    private property <color> github-fg-default: GitHubTheme.fg-default;
    private property <color> github-fg-muted: GitHubTheme.fg-muted;
    private property <color> github-success-fg: GitHubTheme.success-fg;
    private property <color> github-danger-fg: GitHubTheme.danger-fg-strong;
    private property <color> github-attention-fg: GitHubTheme.attention-fg;
    private property <color> github-done-fg: GitHubTheme.done-fg-strong;
    private property <color> github-accent-fg: GitHubTheme.accent-fg-strong;
    private property <color> github-accent-muted: GitHubTheme.accent-subtle;
    // Match the filter-input selection brush so diff copy looks Primer-native.
    private property <color> diff-selection-background: GitHubTheme.diff-selection-bg;
    // Chromium/Blink Find-in-page colors used by GitHub code pages.
    private property <color> diff-find-match-background: GitHubTheme.diff-find-match-bg;
    private property <color> diff-find-current-background: GitHubTheme.diff-find-current-bg;
    // GitHub-style code selection (code column only; gutters are excluded).
    private property <int> diff-sel-anchor-line: -1;
    private property <int> diff-sel-anchor-col: 0;
    private property <int> diff-sel-focus-line: -1;
    private property <int> diff-sel-focus-col: 0;
    private property <string> diff-sel-side: "";
    private property <string> diff-selection-focus-side: "";
    private property <bool> diff-selecting: false;
    private property <bool> diff-sel-select-all: false;
    // Multi-click streak for GitHub-style word (2) / line (3) selection. Kept on
    // the workspace so ListView recycling cannot reset it between clicks.
    private property <int> diff-click-streak: 0;
    private property <duration> diff-click-last-at: 0ms;
    private property <int> diff-click-last-line: -1;
    private property <int> diff-click-last-col: -1;
    private property <string> diff-click-last-side: "";
    // In-diff find bar (⌘/Ctrl+F). Docked in the selected-file toolbar.
    private property <bool> diff-find-open: false;
    private property <bool> diff-find-focus-pending: false;
    private property <string> diff-find-query: "";
    // Query of the last computed result set. Row bindings key off this instead
    // of the live input so mounted rows only re-resolve when results refresh.
    private property <string> diff-find-effective-query: "";
    private property <[WorkflowPrDiffFindMatch]> diff-find-matches: [];
    private property <int> diff-find-index: -1;
    // Snapshot the selected row instead of binding every field through
    // model[index]. Replacing a model while retaining index 0 does not reliably
    // invalidate dynamic item access in Slint.
    private property <WorkflowPrDiffFindMatch> diff-find-current;
    private property <bool> diff-find-has-current:
        root.diff-find-open
        && root.diff-find-index >= 0
        && root.diff-find-index < root.diff-find-matches.length;
    private property <int> diff-find-cur-line:
        root.diff-find-has-current ? root.diff-find-current.line : -1;
    private property <int> diff-find-cur-start:
        root.diff-find-has-current ? root.diff-find-current.start-column : 0;
    private property <int> diff-find-cur-end:
        root.diff-find-has-current ? root.diff-find-current.end-column : 0;
    private property <int> diff-find-cur-start-char:
        root.diff-find-has-current ? root.diff-find-current.start-char : 0;
    private property <int> diff-find-cur-end-char:
        root.diff-find-has-current ? root.diff-find-current.end-char : 0;
    private property <string> diff-find-cur-side:
        root.diff-find-has-current ? root.diff-find-current.side : "";
    private property <string> diff-find-cur-prefix:
        root.diff-find-has-current ? root.diff-find-current.prefix : "";
    private property <string> diff-find-cur-text:
        root.diff-find-has-current ? root.diff-find-current.text : "";
    // Explicit navigation increments this revision. The diff surface handles
    // that edge with one synchronous viewport calculation and does no Find
    // positioning work during later scrolling or layout changes.
    private property <int> diff-find-scroll-revision: 0;
    private property <bool> diff-find-input-focused: false;
    private property <bool> hunk-scroll-restore-pending: false;
    private property <length> hunk-scroll-anchor-screen-y: 0px;
    private property <length> hunk-scroll-anchor-content-y: 0px;
    private property <bool> hunk-scroll-anchor-resolved: false;
    private property <bool> diff-sel-active: root.diff-sel-anchor-line >= 0 && root.diff-sel-focus-line >= 0;
    private property <bool> diff-sel-anchor-first:
        root.diff-sel-anchor-line < root.diff-sel-focus-line
            || (root.diff-sel-anchor-line == root.diff-sel-focus-line
                && root.diff-sel-anchor-col <= root.diff-sel-focus-col);
    private property <int> diff-sel-lo-line:
        root.diff-sel-anchor-first ? root.diff-sel-anchor-line : root.diff-sel-focus-line;
    private property <int> diff-sel-hi-line:
        root.diff-sel-anchor-first ? root.diff-sel-focus-line : root.diff-sel-anchor-line;
    private property <int> diff-sel-lo-col:
        root.diff-sel-anchor-first ? root.diff-sel-anchor-col : root.diff-sel-focus-col;
    private property <int> diff-sel-hi-col:
        root.diff-sel-anchor-first ? root.diff-sel-focus-col : root.diff-sel-anchor-col;
    private property <color> diff-addition-background: GitHubTheme.diff-addition-bg;
    private property <color> diff-addition-gutter-background: GitHubTheme.diff-addition-gutter-bg;
    private property <color> diff-deletion-background: GitHubTheme.diff-deletion-bg;
    private property <color> diff-deletion-gutter-background: GitHubTheme.diff-deletion-gutter-bg;
    private property <color> hunk-background: root.github-accent-muted;
    private property <color> hunk-gutter-background: GitHubTheme.diff-hunk-gutter-bg;
    private property <color> hunk-foreground: root.github-fg-muted;
    private property <string> selected-review-action: "comment";
    private property <string> review-body: "";
    private property <string> dismiss-review-id: "";
    private property <string> dismiss-review-author: "";
    private property <string> dismiss-review-reason: "";
    private property <length> review-menu-anchor-x: 0px;
    private property <length> review-menu-anchor-y: 0px;
    private property <string> conversation-comment-body: "";
    private property <string> pending-conversation-comment: "";
    private property <string> selected-merge-method: "merge";
    private property <bool> remove-source-branch: false;
    private property <int> draft-range-start: -1;
    private property <int> draft-range-end: -1;
    private property <bool> modal-open:
        root.review-dialog-open
            || root.dismiss-review-dialog-open
            || root.merge-dialog-open
            || root.revert-dialog-open
            || root.commit-range-dialog-open;
    // Lightweight menus share one in-window popover state. Native PopupWindow
    // grabs the pointer on macOS, suppressing underlay hover and consuming the
    // first click that should switch directly to another menu.
    private property <string> active-popover: "";
    private property <string> pending-diff-view: root.diff-view;
    private property <bool> pending-ignore-whitespace: root.ignore-whitespace;
    private property <length> content-width: max(0px, root.shell-content-width);
    // PR content stops above the persistent status bar. Dialog surfaces must
    // use this actually mounted height as well, otherwise their bottom radius
    // extends into the reserved strip and is clipped by the route boundary.
    private property <length> dialog-viewport-height: root.height;
    private property <length> stable-layout-width: root.content-width;
    private property <length> stable-layout-height: root.height;
    // File-filter ActionMenu mounts on the workspace root (above the
    // files-changed-toolbar z:80 band). These track the filter IconButton in
    // workspace-local coordinates.
    private property <length> filter-menu-anchor-x: 0px;
    private property <length> filter-menu-anchor-y: 0px;
    // Primer `$width-md` (768px). GitHub's PR Files changed Layout uses
    // `Layout--flowRow-until-md` + `sidebarPosition-flowRow-none`, which sets
    // `.Layout-sidebar { display: none }` under `max-width: 767.98px`.
    // Crossing the threshold auto-collapses / auto-expands; the toolbar
    // toggle always overrides so the tree can be reopened while narrow.
    // Use the live content width (not frozen `stable-layout-width`); the shell
    // inset is excluded so the breakpoint matches the actual review column.
    private property <length> file-tree-collapse-breakpoint: 768px;
    private property <bool> file-list-below-breakpoint:
        root.content-width < root.file-tree-collapse-breakpoint;
    private property <bool> file-list-visible: root.file-list-user-visible;
    private property <bool> compact-title-wraps:
        root.stable-layout-width - 32px < compact-title-measure.preferred-width;
    private property <bool> compact-summary-wraps:
        root.stable-layout-width - 32px < compact-summary-metrics.inline-width;
    // Keep the PR header compact while leaving the content below on its
    // established 24px grid.
    private property <bool> wide-title-wraps:
        root.stable-layout-width - 32px < compact-title-measure.preferred-width;
    private property <bool> wide-summary-wraps:
        root.stable-layout-width - 32px < compact-summary-metrics.inline-width;
    // Estimate wrapped line count from the single-line preferred width. Do not
    // use Text.preferred-height for the visible title: it can stay on the
    // single-line metric and let the summary row cover later title lines.
    private property <length> compact-title-avail-width: max(1px, root.stable-layout-width - 32px);
    private property <int> compact-title-line-count: !root.compact-title-wraps ? 1
        : (compact-title-measure.preferred-width <= root.compact-title-avail-width * 2 ? 2 : 3);
    private property <length> wide-title-avail-width: max(1px, root.stable-layout-width - 32px);
    private property <int> wide-title-line-count: !root.wide-title-wraps ? 1
        : (compact-title-measure.preferred-width <= root.wide-title-avail-width * 2 ? 2 : 3);
    // ~30px per line for 22px Hiragino; 52px was short enough to clip "#N".
    private property <length> compact-title-block-height: root.compact-title-line-count == 1 ? 32px
        : (root.compact-title-line-count == 2 ? 60px : 88px);
    private property <length> wide-title-block-height: root.wide-title-line-count == 1 ? 30px
        : (root.wide-title-line-count == 2 ? 60px : 88px);
    private property <length> compact-title-height-extra: root.compact-title-line-count == 1 ? 0px
        : (root.compact-title-line-count == 2 ? 36px : 64px);
    private property <length> wide-title-height-extra: root.wide-title-line-count == 1 ? 0px
        : (root.wide-title-line-count == 2 ? 36px : 64px);

    function begin-diff-selection(line: int, col: int, side: string) {
        let now = animation-tick();
        let same-target =
            line == root.diff-click-last-line
            && side == root.diff-click-last-side
            && Math.abs(col - root.diff-click-last-col) <= 1;
        if (now - root.diff-click-last-at < 500ms && same-target) {
            root.diff-click-streak += 1;
        } else {
            root.diff-click-streak = 1;
        }
        root.diff-click-last-at = now;
        root.diff-click-last-line = line;
        root.diff-click-last-col = max(0, col);
        root.diff-click-last-side = side;

        // Match Slint TextInput / GitHub: 1=caret, 2=word, 3=line, then repeat.
        let mode = mod(root.diff-click-streak - 1, 3);
        if (mode == 1 || mode == 2) {
            let range = root.resolve-diff-click-range(line, max(0, col), side, mode);
            root.apply-diff-selection-range(
                range.start-line,
                range.start-column,
                range.end-line,
                range.end-column,
                side
            );
            return;
        }

        root.diff-sel-anchor-line = line;
        root.diff-sel-anchor-col = max(0, col);
        root.diff-sel-focus-line = line;
        root.diff-sel-focus-col = max(0, col);
        root.diff-sel-side = side;
        root.diff-selection-focus-side = side;
        root.diff-selecting = true;
        root.diff-sel-select-all = false;
        diff-selection-focus.focus();
    }

    function apply-diff-selection-range(start-line: int, start-col: int, end-line: int, end-col: int, side: string) {
        root.diff-sel-anchor-line = start-line;
        root.diff-sel-anchor-col = max(0, start-col);
        root.diff-sel-focus-line = end-line;
        root.diff-sel-focus-col = max(0, end-col);
        root.diff-sel-side = side;
        root.diff-selection-focus-side = side;
        // Freeze until pointer-up so a tiny move cannot shrink a word/line pick.
        root.diff-selecting = false;
        root.diff-sel-select-all = false;
        diff-selection-focus.focus();
    }

    function update-diff-selection(line: int, col: int, side: string) {
        if (!root.diff-selecting || side != root.diff-sel-side) {
            return;
        }
        root.diff-sel-focus-line = max(0, min(line, max(0, root.lines.length - 1)));
        root.diff-sel-focus-col = max(0, col);
    }

    function end-diff-selection() {
        root.diff-selecting = false;
        // A plain click without drag is not a selection (GitHub keeps no range).
        if (root.diff-sel-anchor-line == root.diff-sel-focus-line
            && root.diff-sel-anchor-col == root.diff-sel-focus-col) {
            root.clear-diff-selection();
            return;
        }
        if (root.diff-sel-active) {
            diff-selection-focus.focus();
        }
    }

    function clear-diff-selection() {
        root.diff-sel-anchor-line = -1;
        root.diff-sel-anchor-col = 0;
        root.diff-sel-focus-line = -1;
        root.diff-sel-focus-col = 0;
        root.diff-sel-side = "";
        root.diff-selecting = false;
        root.diff-sel-select-all = false;
    }

    function copy-active-diff-selection() {
        if (!root.diff-sel-active) {
            return;
        }
        root.copy-diff-selection(
            root.diff-sel-lo-line,
            root.diff-sel-lo-col,
            root.diff-sel-hi-line,
            root.diff-sel-hi-col,
            root.diff-sel-side
        );
    }

    function select-all-diff-content() {
        if (root.lines.length == 0) {
            return;
        }
        root.diff-sel-anchor-line = 0;
        root.diff-sel-anchor-col = 0;
        root.diff-sel-focus-line = root.lines.length - 1;
        root.diff-sel-focus-col = 2147483647;
        root.diff-sel-side = root.diff-view == "split"
            ? (root.diff-selection-focus-side == "left" ? "left" : "right")
            : "";
        root.diff-selecting = false;
        root.diff-sel-select-all = true;
    }

    function open-diff-find() {
        if (root.selected-tab != 2 || root.selected-file-index < 0) {
            return;
        }
        root.diff-find-open = true;
        root.diff-find-focus-pending = true;
        root.refresh-diff-find-matches();
    }

    function close-diff-find() {
        diff-find-debounce.stop();
        root.diff-find-open = false;
        root.diff-find-focus-pending = false;
        root.diff-find-query = "";
        root.diff-find-effective-query = "";
        root.diff-find-matches = [];
        root.diff-find-index = -1;
        root.sync-diff-find-current();
        root.diff-find-input-focused = false;
    }

    function sync-diff-find-current() {
        if root.diff-find-index >= 0
            && root.diff-find-index < root.diff-find-matches.length {
            root.diff-find-current = root.diff-find-matches[root.diff-find-index];
        } else {
            root.diff-find-current = {
                line: -1,
                start-column: 0,
                end-column: 0,
                start-char: 0,
                end-char: 0,
                side: "",
                prefix: "",
                text: ""
            };
        }
    }

    function refresh-diff-find-matches() {
        diff-find-debounce.stop();
        if (!root.diff-find-open) {
            return;
        }
        root.diff-find-effective-query = root.diff-find-query;
        root.diff-find-matches = root.find-diff-matches(
            root.diff-find-query,
            root.diff-view == "split"
        );
        if (root.diff-find-matches.length == 0) {
            root.diff-find-index = -1;
            root.sync-diff-find-current();
            return;
        }
        if (root.diff-find-index < 0 || root.diff-find-index >= root.diff-find-matches.length) {
            root.diff-find-index = 0;
        }
        root.sync-diff-find-current();
    }

    function step-diff-find(backward: bool) {
        // Enter / next / previous resolve a pending debounced refresh first so
        // stepping always walks the results of the visible query.
        if (diff-find-debounce.running) {
            root.refresh-diff-find-matches();
        }
        if !root.diff-find-input-focused
            || root.diff-find-matches.length == 0 {
            return;
        }
        root.diff-find-index = root.step-diff-find-index(
            root.diff-find-index,
            root.diff-find-matches.length,
            backward
        );
        root.sync-diff-find-current();
        root.diff-find-scroll-revision += 1;
    }

    function toggle-draft-commit(index: int) {
        if root.draft-range-start < 0 || root.draft-range-end < 0 {
            root.draft-range-start = index;
            root.draft-range-end = index;
            return;
        }

        let range-start = min(root.draft-range-start, root.draft-range-end);
        let range-end = max(root.draft-range-start, root.draft-range-end);
        if index < range-start {
            root.draft-range-start = index;
            root.draft-range-end = range-end;
        } else if index > range-end {
            root.draft-range-start = range-start;
            root.draft-range-end = index;
        } else if range-start == range-end {
            root.draft-range-start = -1;
            root.draft-range-end = -1;
        } else if index == range-start {
            root.draft-range-start = range-start + 1;
            root.draft-range-end = range-end;
        } else if index == range-end {
            root.draft-range-start = range-start;
            root.draft-range-end = range-end - 1;
        }
        // A commit inside a multi-commit range cannot be removed without
        // creating a gap, so keep the contiguous GitHub-style range intact.
    }

    changed file-filter => { root.filter-files(root.file-filter); }
    changed selected-file-index => {
        root.clear-diff-selection();
        root.close-diff-find();
    }
    changed selected-tab => {
        root.clear-diff-selection();
        root.close-diff-find();
    }
    changed diff-view => {
        root.clear-diff-selection();
        root.refresh-diff-find-matches();
    }
    changed line-content-revision => {
        root.clear-diff-selection();
        root.refresh-diff-find-matches();
    }
    changed viewing-file => {
        root.clear-diff-selection();
        root.refresh-diff-find-matches();
    }
    changed diff-find-query => {
        // Typing selects the first result from the new result set once the
        // debounced refresh lands, and does not increment the command-only
        // scroll revision. The debounce keeps full-file scans off every
        // keystroke; Enter and the next/previous arrows flush it immediately.
        root.diff-find-index = -1;
        if (root.diff-find-open) {
            diff-find-debounce.start();
        }
    }
    changed review-dialog-open => {
        if (root.review-dialog-open) {
            root.active-popover = "";
            root.selected-review-action = root.can-comment ? "comment" : (root.can-approve ? "approve" : "request_changes");
        }
    }
    changed dismiss-review-dialog-open => {
        if root.dismiss-review-dialog-open {
            root.active-popover = "";
        }
    }
    changed remote-review-state => {
        // Clear the Conversation composer after a successful Comment submit.
        if root.remote-review-state == "commented" && root.pending-conversation-comment != "" {
            root.conversation-comment-body = "";
            root.pending-conversation-comment = "";
        }
    }
    changed merge-dialog-open => {
        if (root.merge-dialog-open) {
            root.active-popover = "";
            root.selected-merge-method = root.merge-method-merge ? "merge" : (root.merge-method-squash ? "squash" : (root.merge-method-rebase ? "rebase" : "fast_forward"));
        }
    }
    changed revert-dialog-open => {
        if root.revert-dialog-open {
            root.active-popover = "";
        }
    }
    changed commit-range-dialog-open => {
        if root.commit-range-dialog-open {
            root.active-popover = "";
            root.draft-range-start = root.commit-range-start;
            root.draft-range-end = root.commit-range-end;
        }
    }
    changed live-resizing => {
        // Snapshot the final pre-resize geometry before AppKit begins sending
        // continuous size updates. When resizing ends, adopt the final size once.
        root.stable-layout-width = root.content-width;
        root.stable-layout-height = root.height;
    }
    changed width => {
        if !root.live-resizing {
            root.stable-layout-width = root.content-width;
        }
    }
    changed shell-content-width => {
        if !root.live-resizing {
            root.stable-layout-width = root.content-width;
        }
    }
    changed height => {
        if !root.live-resizing {
            root.stable-layout-height = root.height;
        }
    }
    changed file-list-below-breakpoint => {
        // Auto-collapse when crossing below Primer md; auto-expand when
        // returning above. Manual toggle may still reopen while narrow.
        root.file-list-user-visible = !root.file-list-below-breakpoint;
    }
    init => {
        if root.file-list-below-breakpoint {
            root.file-list-user-visible = false;
        }
    }

    // Capture ⌘/Ctrl+F while focus is in Filters/TextInputs under Files changed.
    // Esc for open dialogs is owned by nested GitHubDialog capture; reject here
    // so the dialog FocusScope on the path can accept it.
    capture-key-pressed(event) => {
        if (root.selected-tab == 2
            && event.modifiers.control
            && (event.text == "f" || event.text == "F")) {
            root.open-diff-find();
            return accept;
        }
        if (root.diff-find-open
            && root.diff-find-input-focused
            && event.modifiers.control
            && (event.text == "g" || event.text == "G")) {
            root.step-diff-find(event.modifiers.shift);
            return accept;
        }
        return reject;
    }

    // Debounce for find-as-you-type: each keystroke restarts the window so the
    // full-file scan runs once per pause instead of on every character.
    diff-find-debounce := Timer {
        interval: 180ms;
        running: false;
        triggered => {
            self.running = false;
            root.refresh-diff-find-matches();
        }
    }

    Rectangle {
        x: root.shell-leading-inset;
        width: root.content-width;
        height: 100%;
        background: root.github-bg-default;
    }

    // Owns ⌘/Ctrl+C for code selection. Zero-size at the workspace root so
    // nested Files changed conditionals cannot hide the focus target.
    diff-selection-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            // Slint's winit backend mirrors Qt on Apple: ⌘ is reported as
            // `control`, and the physical Control key as `meta`. Use `control`
            // on every platform so ⌘/Ctrl+C matches the terminal drawer.
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.open-diff-find();
                return accept;
            }
            if (event.modifiers.control && (event.text == "g" || event.text == "G")) {
                if root.diff-find-open && root.diff-find-input-focused {
                    root.step-diff-find(event.modifiers.shift);
                    return accept;
                }
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-active-diff-selection();
                return accept;
            }
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all-diff-content();
                return accept;
            }
            if (event.text == Key.Escape) {
                // Prefer dismissing an open dialog over find/selection when the
                // workspace still holds focus (GitHubDialog also handles Esc
                // while it or its nested fields are focused).
                if (root.review-dialog-open && !root.action-loading) {
                    root.review-dialog-open = false;
                    return accept;
                }
                if (root.dismiss-review-dialog-open && !root.action-loading) {
                    root.dismiss-review-dialog-open = false;
                    return accept;
                }
                if (root.merge-dialog-open && !root.action-loading) {
                    root.merge-dialog-open = false;
                    return accept;
                }
                if (root.revert-dialog-open && !root.action-loading) {
                    root.revert-dialog-open = false;
                    return accept;
                }
                if (root.commit-range-dialog-open && !root.loading) {
                    root.commit-range-dialog-open = false;
                    return accept;
                }
                if (root.diff-find-open) {
                    root.close-diff-find();
                    return accept;
                }
                root.clear-diff-selection();
                return accept;
            }
            return reject;
        }
    }

    compact-title-measure := Text {
        visible: false;
        text: root.pull-request-title + " #" + root.pull-request-number;
        font-size: 22px;
        font-weight: 600;
    }
    compact-summary-metrics := GitHubPullRequestSummaryMetrics {
        state-kind: root.merge-readiness-kind;
        author: root.author;
        commit-count: root.commit-count;
        target-branch: root.target-branch;
        source-branch: root.source-branch;
        updated-at: root.updated-at;
    }

    // One off-screen font measurement keeps the horizontal scroll extent and
    // every row background on the same pixel width. Column-count estimates are
    // retained only as a fallback while the measured line is unavailable.
    longest-code-line-measure := Text {
        visible: false;
        text: root.longest-code-line;
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        font-weight: 400;
        overflow: clip;
    }
    code-cell-measure := Text {
        visible: false;
        text: "00000000000000000000000000000000";
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        font-weight: 400;
        overflow: clip;
        wrap: no-wrap;
    }

    // Consume clicks on non-interactive workspace areas so they cannot reach
    // the pull-request list retained underneath this full-window overlay.
    // Also dismiss the root-mounted readiness ActionMenu via the shared chrome
    // channel so blank clicks close it without a page-covering root scrim.
    TouchArea {
        x: root.shell-leading-inset;
        width: root.content-width;
        height: root.height;
        clicked => {
            root.active-popover = "";
            TransientOverlayState.dismiss-all();
        }
    }

    // The viewport follows the AI Review divider on every pointer move while
    // the expensive diff layout below keeps its pre-drag width. Shrinking
    // clips the frozen tree; releasing the pointer commits the final layout.
    content-viewport := Rectangle {
        x: root.shell-leading-inset;
        width: root.content-width;
        height: root.height;
        clip: true;
        background: root.github-bg-default;

        VerticalLayout {
            width: root.stable-layout-width;
            height: root.stable-layout-height;
            spacing: 0px;

        Rectangle {
            width: parent.width;
            height: root.stable-layout-width < 1500px
                ? 92px
                    + root.compact-title-height-extra
                    + (root.compact-summary-wraps ? 32px : 0px)
                : (76px
                    + root.wide-title-height-extra
                    + (root.wide-summary-wraps ? 32px : 0px));
            // Keep action-button tooltips above the following files toolbar and
            // above the title/summary that are painted later in this band.
            z: 1;
            clip: false;
            background: root.github-bg-default;
            border-width: 0px;

            if root.stable-layout-width >= 1500px: HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 16px;
                // Pin actions to the title's first line (GitHub wide header).
                padding-top: 16px;
                spacing: 16px;
                // Keep default main-axis stretch so the title column expands;
                // alignment:start would collapse preferred-width:0 siblings and
                // leave Merged/Review/Merge stuck beside the title.
                cross-axis-alignment: start;
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    // Leave open so wrapped title and relative-time tooltips can
                    // escape like GitHub; title never uses ellipsis.
                    clip: false;
                    z: 0;
                    wide-title := Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: root.wide-title-block-height;
                        text: root.pull-request-title + " #" + root.pull-request-number;
                        font-size: 22px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                        wrap: word-wrap;
                        overflow: clip;
                        vertical-alignment: top;
                    }
                    GitHubPullRequestSummaryRow {
                        x: 0px;
                        y: root.wide-title-block-height + 6px;
                        width: parent.width;
                        state-kind: root.merge-readiness-kind;
                        author: root.author;
                        commit-count: root.commit-count;
                        target-branch: root.target-branch;
                        source-branch: root.source-branch;
                        updated-at: root.updated-at;
                        updated-at-tooltip: root.updated-at-tooltip;
                        compact: false;
                        success-color: root.github-success-fg;
                        danger-color: root.github-danger-fg;
                        done-color: root.github-done-fg;
                        muted-color: root.github-fg-muted;
                        muted-background: root.github-bg-muted;
                        branch-background: root.github-accent-muted;
                        branch-foreground: GitHubTheme.accent-fg-strong;
                        copy-source-branch(branch) => { root.copy-source-branch(branch) }
                    }
                }

            }

            if root.stable-layout-width < 1500px: Rectangle {
                width: parent.width;
                height: parent.height;
                clip: false;

                compact-title := Text {
                    z: 0;
                    x: 16px;
                    y: 16px;
                    width: parent.width - 32px;
                    height: root.compact-title-block-height;
                    text: root.pull-request-title + " #" + root.pull-request-number;
                    font-size: 22px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    wrap: word-wrap;
                    overflow: clip;
                    vertical-alignment: top;
                }
                compact-summary-row := GitHubPullRequestSummaryRow {
                    z: 0;
                    x: 16px;
                    y: 16px + root.compact-title-block-height + 6px;
                    width: parent.width - 32px;
                    state-kind: root.merge-readiness-kind;
                    author: root.author;
                    commit-count: root.commit-count;
                    target-branch: root.target-branch;
                    source-branch: root.source-branch;
                    updated-at: root.updated-at;
                    updated-at-tooltip: root.updated-at-tooltip;
                    compact: true;
                    success-color: root.github-success-fg;
                    danger-color: root.github-danger-fg;
                    done-color: root.github-done-fg;
                    muted-color: root.github-fg-muted;
                    muted-background: root.github-bg-muted;
                    branch-background: root.github-accent-muted;
                    branch-foreground: GitHubTheme.accent-fg-strong;
                    copy-source-branch(branch) => { root.copy-source-branch(branch) }
                }
            }

        }

        Rectangle { width: parent.width; height: 1px; background: root.github-border-default; }

        review-tabs := Rectangle {
            width: parent.width;
            height: 48px;
            background: root.github-bg-default;
            accessible-role: tab-list;
            accessible-label: I18n.pr-review-sections;
            private property <bool> show-aggregate-diffstat: root.content-width >= 840px;
            HorizontalLayout {
                x: 16px;
                width: parent.width - 32px;
                spacing: 4px;
                alignment: start;
                GitHubPullRequestTabButton {
                    label: I18n.pr-review-conversation;
                    // Badge summaries load with the PR detail. Keep them independent
                    // from the lazily mounted Conversation payload.
                    count: root.conversation-count;
                    icon: @image-url("../../assets/icons/octicon-comment-discussion-16.svg");
                    selected: root.selected-tab == 0;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 0;
                        root.select-tab(0);
                    }
                }
                GitHubPullRequestTabButton {
                    label: I18n.pr-review-commits;
                    // Loading this tab must not be what makes its badge appear.
                    count: root.commit-count;
                    icon: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                    selected: root.selected-tab == 1;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 1;
                        root.select-tab(1);
                    }
                }
                GitHubPullRequestTabButton {
                    label: I18n.pr-review-files-changed;
                    count: root.files.length;
                    icon: @image-url("../../assets/icons/octicon-file-diff-16.svg");
                    selected: root.selected-tab == 2;
                    clicked => {
                        root.active-popover = "";
                        root.selected-tab = 2;
                        root.select-tab(2);
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if review-tabs.show-aggregate-diffstat: GitHubFileDiffStat {
                    height: parent.height;
                    additions: root.added-lines;
                    deletions: root.removed-lines;
                    has-selection: true;
                }
            }
        }

        Rectangle { width: parent.width; height: 1px; background: root.github-border-default; }

        if root.selected-tab == 2: files-changed-toolbar := Rectangle {
            width: parent.width;
            height: 46px;
            // The SHA tooltip opens below this row. Keep the row above the
            // following file toolbar so the GitHub-style bubble is not covered.
            z: 80;
            // GitHub Files changed commit toolbar: default surface + hairline
            // top/bottom borders (top is the shared 1px rule above this row).
            background: root.github-bg-default;
            clip: false;

            // Paint the rule below toolbar controls so descendant tooltips are
            // never crossed by a later sibling separator.
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.github-border-default;
            }

            // Gear center in toolbar coordinates. Derive panel x and caret x
            // from this same value so caret never depends on popover.self.x
            // (which can disagree with the bound x during layout).
            property <length> diff-settings-anchor-x:
                files-toolbar-leading.x + diff-settings-button.x + 15px;
            property <length> diff-settings-popover-x:
                max(8px, min(self.width - 232px - 8px, self.diff-settings-anchor-x - 116px));
            property <length> diff-settings-caret-x:
                max(18px, min(214px, self.diff-settings-anchor-x - self.diff-settings-popover-x));

            HorizontalLayout {
                padding-right: 0px;
                spacing: 0px;

                files-toolbar-leading := Rectangle {
                    // Keep the commit summary origin attached to the live file-tree
                    // divider while the user drags it; never snapshot this width.
                    width: root.file-list-visible ? root.file-list-width + 1px : 320px;
                    height: parent.height;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        GitHubFileTreeToggleButton {
                            file-tree-visible: root.file-list-visible;
                            clicked => {
                                root.file-list-resizing = false;
                                root.file-list-user-visible = !root.file-list-user-visible;
                            }
                        }
                        commit-range-button := GitHubCommitRangeButton {
                            y: (parent.height - self.height) / 2;
                            text: root.commit-range-label;
                            clicked => {
                                root.commit-range-dialog-open = true;
                                root.ensure-commits();
                            }
                        }
                        diff-settings-button := GitHubFileToolbarButton {
                            width: 30px;
                            height: parent.height;
                            icon-source: @image-url("../../assets/icons/octicon-gear-16.svg");
                            selected: root.active-popover == "diff-settings";
                            outlined: true;
                            tooltip-text: I18n.pr-review-open-diff-settings;
                            clicked => {
                                if root.active-popover == "diff-settings" {
                                    root.active-popover = "";
                                } else {
                                    root.pending-diff-view = root.diff-view;
                                    root.pending-ignore-whitespace = root.ignore-whitespace;
                                    root.active-popover = "diff-settings";
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if !root.show-single-commit-summary: Rectangle { horizontal-stretch: 1; }

                if root.show-single-commit-summary: HorizontalLayout {
                    horizontal-stretch: 1;
                    height: parent.height;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    single-commit-title := Text {
                        horizontal-stretch: 1;
                        height: parent.height;
                        text: root.commits[root.commit-range-start].title;
                        font-size: 14px;
                        font-weight: 600;
                        color: root.github-fg-default;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 112px;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-default;
                        clip: true;

                        GitHubCommitSummaryNavButton {
                            x: 0px;
                            width: 56px;
                            text: I18n.pr-review-prev;
                            icon-source: @image-url("../../assets/icons/octicon-chevron-left-16.svg");
                            button-enabled: root.commit-range-start + 1 < root.commits.length;
                            clicked => {
                                root.apply-commit-range(
                                    root.commit-range-start + 1,
                                    root.commit-range-start + 1
                                );
                            }
                        }
                        GitHubCommitSummaryNavButton {
                            x: 56px;
                            width: 56px;
                            text: I18n.common-next;
                            icon-source: @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                            icon-after: true;
                            draw-divider: true;
                            button-enabled: root.commit-range-start > 0;
                            clicked => {
                                root.apply-commit-range(
                                    root.commit-range-start - 1,
                                    root.commit-range-start - 1
                                );
                            }
                        }
                    }

                    if root.content-width >= 1100px: GitHubCommitIdentityAvatars {
                        avatar-size: 22px;
                        author-avatar: root.commits[root.commit-range-start].avatar;
                        author-label: root.commits[root.commit-range-start].avatar-label;
                        committer-avatar: root.commits[root.commit-range-start].committer-avatar;
                        committer-label: root.commits[root.commit-range-start].committer-avatar-label;
                        show-committer: root.commits[root.commit-range-start].show-committer;
                    }
                    if root.content-width >= 1100px: single-commit-author := Text {
                        width: min(190px, self.preferred-width);
                        height: parent.height;
                        text: root.commits[root.commit-range-start].identity-action
                            + " "
                            + root.commits[root.commit-range-start].short-date-label;
                        font-size: 11px;
                        color: root.github-fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: 96px;
                        height: parent.height;
                        text: "Commit " + root.commits[root.commit-range-start].short-sha;
                        font-size: 11px;
                        color: root.github-fg-muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    GitHubCopyButton {
                        tooltip-text: I18n.pr-review-copy-full-sha-for + " "
                            + root.commits[root.commit-range-start].short-sha;
                        tooltip-align-right: true;
                        copy-requested => {
                            root.copy-commit-sha(root.commits[root.commit-range-start].sha)
                        }
                    }
                }

                Rectangle {
                    // Keep the Primer 32px action mounted with a 12px trailing
                    // inset so it remains distinct from the review-pane divider.
                    width: GitHubMetrics.control-medium-size + GitHubMetrics.size-12;
                    height: parent.height;
                    GitHubIconButton {
                        y: (parent.height - self.height) / 2;
                        icon: @image-url("../../assets/icons/octicon-copilot-16.svg");
                        invisible: true;
                        selected: root.ai-review-panel-visible;
                        loading: root.ai-review-status == "running";
                        tooltip-text: root.ai-review-panel-visible
                            ? I18n.ai-review-close
                            : I18n.pr-list-review-with-ai;
                        tooltip-align-right: true;
                        button-enabled: true;
                        clicked => { root.toggle-ai-review(); }
                    }
                }
            }

            // Host on the full toolbar row (not the leading strip) so the panel
            // can extend over the diff while the Primer caret stays under the gear.
            GitHubDiffSettingsPopover {
                z: 1000;
                x: files-changed-toolbar.diff-settings-popover-x;
                // Leave Primer-like gap under the gear (mt-2 + caret height).
                y: 50px;
                caret-x: files-changed-toolbar.diff-settings-caret-x;
                open: root.active-popover == "diff-settings";
                pending-view <=> root.pending-diff-view;
                pending-ignore-whitespace <=> root.pending-ignore-whitespace;
                ignore-whitespace-supported: root.ignore-whitespace-supported;
                bg-default: root.github-bg-default;
                bg-hover: GitHubTheme.control-raised-hover;
                bg-muted: root.github-bg-muted;
                border-default: root.github-border-default;
                accent-fg: root.github-accent-fg;
                fg-default: root.github-fg-default;
                fg-muted: root.github-fg-muted;
                addition-color: GitHubTheme.diff-addition-stat;
                deletion-color: GitHubTheme.diff-deletion-stat;
                apply(view, ignore-whitespace) => {
                    root.active-popover = "";
                    root.apply-diff-settings(view, ignore-whitespace);
                }
                dismiss-requested => { root.active-popover = ""; }
            }

        }

        if root.selected-tab == 2 && (root.too-many-commits || root.files-truncated): Rectangle {
            width: parent.width;
            height: 32px;
            background: GitHubTheme.done-muted;
            Text {
                x: 18px;
                width: parent.width - 36px;
                height: parent.height;
                text: root.files-truncated
                    ? I18n.pr-review-files-truncated-warning
                    : I18n.pr-review-too-many-commits-warning;
                vertical-alignment: center;
                font-size: 11px;
                color: GitHubTheme.done-fg;
            }
        }

        if root.selected-tab == 0: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.github-bg-default;

            if root.conversation-loading: GitHubCenteredLoadingState {
                width: parent.width;
                height: parent.height;
                label: I18n.pr-review-loading-conversation;
                foreground: root.github-fg-muted;
            }
            if !root.conversation-loading && root.conversation-error != "": GitHubCenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                retry => { root.select-tab(0); }
            }
            if !root.conversation-loading && root.conversation-error == "": conversation-scroll := ScrollView {
                // GitHub Conversation is one document: timeline + composer share
                // a single scroll, so the Write box sits after the last event
                // instead of staying pinned to the viewport bottom.
                x: max(24px, (parent.width - min(920px, parent.width - 48px)) / 2);
                y: 0px;
                width: min(920px, parent.width - 48px);
                height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                viewport-width: self.visible-width;
                viewport-height: conversation-flow.preferred-height;

                conversation-flow := VerticalLayout {
                    x: 16px;
                    width: max(0px, conversation-scroll.visible-width - 32px);
                    spacing: 16px;
                    alignment: start;
                    // Keep the initial breathing room below the tabs inside the
                    // scroll document so it moves away with the conversation.
                    padding-top: 20px;
                    padding-bottom: 20px;

                if root.conversation-items.length == 0: Rectangle {
                    width: parent.width;
                    height: 120px;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: I18n.pr-review-no-conversation;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: root.github-fg-muted;
                    }
                }
                if root.conversation-items.length > 0: ListView {
                    width: parent.width;
                    height: root.conversation-content-height * 1px
                        + root.expanded-commit-body-height * 1px;
                    vertical-stretch: 0;
                    horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                    vertical_scrollbar_policy: ScrollBarPolicy.always_off;
                    for item[index] in root.conversation-items: Rectangle {
                        private property <bool> is-card:
                            item.kind == "description" || item.kind == "comment" || item.kind == "review";
                        private property <bool> commit-expanded:
                            item.kind == "commit" && item.message-expanded;
                        // GitHub's timeline rail is not the avatar axis. It sits
                        // 16 px inside the card edge (x=52) and activity content
                        // begins another 28 px to its right.
                        private property <length> rail-x: 68px;
                        private property <length> activity-anchor-y:
                            item.kind == "commit" ? item.row-height * 1px / 2 : self.height / 2;
                        private property <length> rail-before-end-y:
                            self.is-card ? 6px : self.activity-anchor-y;
                        private property <length> rail-after-start-y:
                            self.is-card ? self.height - 6px : self.activity-anchor-y;
                        // Hug the wrapped body; keep a small gap before the next
                        // timeline row (Rust message-body-height over-estimates).
                        private property <length> commit-body-extra:
                            self.commit-expanded && item.message-body != ""
                                ? conv-commit-body-measure.preferred-height + 8px
                                : 0px;
                        height: item.row-height * 1px + self.commit-body-extra;
                        background: transparent;

                        // The Material ListView owns pointer input inside its
                        // viewport, so the workspace-level blank dismiss layer
                        // cannot see clicks between timeline controls. Keep a
                        // row-sized target below the real controls so ordinary
                        // Conversation clicks close an open ActionMenu.
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: default;
                            clicked => { root.active-popover = ""; }
                        }

                        // Same wrap metrics as the visible expanded body.
                        conv-commit-body-measure := Text {
                            visible: false;
                            width: parent.width - 168px;
                            text: item.message-body;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        if item.connect-before: Rectangle {
                            x: parent.rail-x - 1px;
                            y: 0px;
                            width: 2px;
                            height: parent.rail-before-end-y;
                            background: root.github-border-default;
                        }
                        if item.connect-after: Rectangle {
                            x: parent.rail-x - 1px;
                            y: parent.rail-after-start-y;
                            width: 2px;
                            height: parent.height - parent.rail-after-start-y;
                            background: root.github-border-default;
                        }

                        if item.kind == "commits": Rectangle {
                            x: 56px;
                            y: (parent.height - 24px) / 2;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.github-bg-default;
                            Image {
                                x: 4px;
                                y: 4px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-repo-push-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "commits": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Text {
                                width: self.preferred-width;
                                text: item.author;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.body;
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if item.created-at != "": GitHubRelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                // Trailing free space after the label; avoids ListView clip.
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if item.kind == "commit": Rectangle {
                            // 12px badge centered on the rail and the collapsed
                            // title band, not the expanded message body.
                            x: 62px;
                            y: (item.row-height * 1px - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            background: root.github-bg-default;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "commit": Rectangle {
                            x: 96px;
                            y: 0px;
                            width: parent.width - 96px;
                            height: item.row-height * 1px;
                            background: transparent;
                            private property <length> title-max-width:
                                self.width - 28px - 6px - 18px - 8px - 72px;
                            private property <length> title-width:
                                min(conv-commit-title-measure.preferred-width, self.title-max-width);

                            GitHubConversationAvatar {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: item.avatar;
                                fallback-label: item.avatar-label;
                            }
                            Text {
                                x: 28px;
                                y: (parent.height - 22px) / 2;
                                width: parent.title-width;
                                height: 22px;
                                text: item.body;
                                font-size: 13px;
                                color: conv-commit-title-touch.has-hover ? root.github-accent-fg : root.github-fg-default;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if conv-commit-title-touch.has-hover: Rectangle {
                                x: 28px;
                                y: (parent.height - 22px) / 2 + 20px;
                                width: parent.title-width;
                                height: 1px;
                                background: root.github-accent-fg;
                            }
                            conv-commit-title-measure := Text {
                                visible: false;
                                text: item.body;
                                font-size: 13px;
                            }
                            conv-commit-title-touch := TouchArea {
                                x: 28px;
                                y: (parent.height - 22px) / 2;
                                width: parent.title-width;
                                height: 22px;
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(item.id); }
                            }
                            if item.message-body != "": GitHubCommitMessageToggleButton {
                                x: 28px + parent.title-width + 6px;
                                y: (parent.height - self.height) / 2;
                                expanded: item.message-expanded;
                                clicked => { root.toggle-commit-message(item.id); }
                            }
                            Text {
                                x: parent.width - 72px;
                                width: 72px;
                                height: parent.height;
                                text: item.state;
                                font-size: 12px;
                                color: conv-commit-sha-touch.has-hover ? root.github-accent-fg : root.github-fg-muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            conv-commit-sha-touch := TouchArea {
                                x: parent.width - 72px;
                                width: 72px;
                                height: parent.height;
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(item.id); }
                            }
                        }
                        if item.kind == "commit" && item.message-expanded && item.message-body != "": Text {
                            // GitHub's expanded message is a preformatted block
                            // aligned 28 px after the timeline rail; the title
                            // stays indented by its compact author avatar.
                            x: 96px;
                            y: item.row-height * 1px;
                            width: parent.width - 168px;
                            height: self.preferred-height;
                            text: item.message-body;
                            font-size: 12px;
                            color: root.github-fg-muted;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }

                        if item.kind == "merged": Rectangle {
                            x: 52px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.github-done-fg;
                            Image {
                                x: 8px;
                                y: 8px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-git-merge-16.svg");
                                colorize: GitHubTheme.fg-on-emphasis;
                            }
                        }

                        if item.kind == "merged": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            GitHubConversationAvatar {
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: item.avatar;
                                fallback-label: item.avatar-label;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.author;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            Text {
                                width: self.preferred-width;
                                text: I18n.pr-review-merged-commit;
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.body;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            Text {
                                width: self.preferred-width;
                                text: I18n.pr-review-into;
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            GitHubBranchLabel {
                                text: item.state;
                                background-color: root.github-accent-muted;
                                foreground-color: GitHubTheme.accent-fg-strong;
                            }
                            if item.created-at != "": GitHubRelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                        }

                        if item.kind == "review_summary": GitHubConversationAvatar {
                            x: 0px;
                            y: 4px;
                            avatar: item.avatar;
                            fallback-label: item.avatar-label;
                        }

                        if item.kind == "review_summary": Rectangle {
                            x: 52px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.github-bg-muted;
                            Image {
                                x: 8px;
                                y: 8px;
                                width: 16px;
                                height: 16px;
                                source: item.state == "approved"
                                    ? @image-url("../../assets/icons/octicon-check-16.svg")
                                    : ((item.state == "changes_requested" || item.state == "rejected")
                                        ? @image-url("../../assets/icons/octicon-x-16.svg")
                                        : @image-url("../../assets/icons/octicon-eye-16.svg"));
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "review_requested": Rectangle {
                            x: 52px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.github-bg-muted;
                            Image {
                                x: 8px;
                                y: 8px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-eye-16.svg");
                                colorize: root.github-fg-muted;
                            }
                        }

                        if item.kind == "review_requested": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 7px;
                            cross-axis-alignment: center;
                            GitHubConversationAvatar {
                                avatar-size: 20px;
                                label-size: 9px;
                                avatar: item.avatar;
                                fallback-label: item.avatar-label;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.author;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.body;
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if item.state != "": Text {
                                width: self.preferred-width;
                                text: item.state;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            if item.created-at != "": GitHubRelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if item.kind == "review_summary": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 7px;
                            cross-axis-alignment: center;
                            Text {
                                width: self.preferred-width;
                                text: item.author;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                            }
                            Text {
                                width: self.preferred-width;
                                text: item.body;
                                font-size: 13px;
                                color: root.github-fg-muted;
                            }
                            if item.created-at != "": GitHubRelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                // Below tip is clipped by the following review card.
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            review-actions-button := Rectangle {
                                private property <bool> menu-open:
                                    root.active-popover == "review-actions"
                                    && root.dismiss-review-id == item.review-id;
                                visible: item.can-dismiss;
                                width: item.can-dismiss ? 32px : 0px;
                                height: 32px;
                                border-radius: 6px;
                                background: self.menu-open
                                    ? GitHubTheme.control-transparent-selected
                                    : (review-actions-touch.pressed
                                    ? GitHubTheme.control-transparent-active
                                    : (review-actions-touch.has-hover
                                        ? GitHubTheme.control-transparent-hover
                                        : transparent));
                                Image {
                                    x: 8px;
                                    y: 8px;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
                                    colorize: review-actions-button.menu-open
                                        ? root.github-accent-fg
                                        : root.github-fg-muted;
                                }
                                review-actions-touch := GitHubActionMenuTriggerArea {
                                    menu-open: review-actions-button.menu-open;
                                    trigger-enabled: item.can-dismiss && !root.action-loading;
                                    accessible-role: button;
                                    accessible-label: I18n.pr-review-review-actions;
                                    request-open => {
                                        root.dismiss-review-id = item.review-id;
                                        root.dismiss-review-author = item.author;
                                        root.review-menu-anchor-x = review-actions-button.absolute-position.x
                                            - root.absolute-position.x;
                                        root.review-menu-anchor-y = review-actions-button.absolute-position.y
                                            - root.absolute-position.y;
                                        root.active-popover = "review-actions";
                                    }
                                    request-close => { root.active-popover = ""; }
                                }
                                changed absolute-position => {
                                    if root.active-popover == "review-actions"
                                            && root.dismiss-review-id == item.review-id {
                                        root.review-menu-anchor-x = self.absolute-position.x
                                            - root.absolute-position.x;
                                        root.review-menu-anchor-y = self.absolute-position.y
                                            - root.absolute-position.y;
                                    }
                                }
                            }
                        }

                        if item.kind == "event": Rectangle {
                            x: 52px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.github-bg-muted;
                            border-width: 1px;
                            border-color: root.github-border-default;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "●";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: root.github-fg-muted;
                                font-size: 10px;
                            }
                        }

                        if item.kind == "event": HorizontalLayout {
                            x: 96px;
                            width: parent.width - 96px;
                            height: parent.height;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Text {
                                width: self.preferred-width;
                                text: item.author;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.github-fg-default;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: item.body;
                                font-size: 13px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if item.created-at != "": GitHubRelativeTimestamp {
                                text: item.created-at;
                                tooltip-text: item.created-at-tooltip;
                                tooltip-align-right: true;
                                tooltip-above: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                            }
                        }

                        if self.is-card && item.kind != "review": GitHubConversationAvatar {
                            x: 0px;
                            y: 6px;
                            avatar: item.avatar;
                            fallback-label: item.avatar-label;
                        }

                        if self.is-card: Rectangle {
                            x: 52px;
                            y: 6px;
                            width: parent.width - 52px;
                            height: parent.height - 12px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.github-border-default;
                            background: root.github-bg-default;
                            clip: true;

                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                spacing: 0px;

                                Rectangle {
                                    width: parent.width;
                                    height: 36px;
                                    background: item.kind == "description" || item.kind == "review"
                                        ? root.github-accent-muted
                                        : root.github-bg-muted;
                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Text {
                                            width: self.preferred-width;
                                            text: item.author;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: root.github-fg-default;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            width: self.preferred-width;
                                            text: item.kind == "review" && item.state != ""
                                                ? (item.state == "approved"
                                                    ? I18n.pr-review-approved-changes
                                                    : (item.state == "changes_requested" || item.state == "rejected"
                                                        ? I18n.pr-review-requested-changes
                                                        : I18n.pr-review-left-comment))
                                                : I18n.pr-review-commented;
                                            font-size: 12px;
                                            color: root.github-fg-muted;
                                            vertical-alignment: center;
                                        }
                                        if item.kind != "review" && item.created-at != "": GitHubRelativeTimestamp {
                                            text: item.created-at;
                                            tooltip-text: item.created-at-tooltip;
                                            // Trailing free space in the card header.
                                            tooltip-after: true;
                                            foreground-color: root.github-fg-muted;
                                            label-font-size: 11px;
                                        }
                                        if item.kind == "review" && item.author-association == "AUTHOR": Rectangle {
                                            width: 46px;
                                            height: 22px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: root.github-border-default;
                                            background: transparent;
                                            Text {
                                                width: parent.width;
                                                height: parent.height;
                                                text: I18n.common-author;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-size: 10px;
                                                color: root.github-fg-muted;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }

                                if item.body == "": Rectangle {
                                    width: parent.width;
                                    height: 40px;
                                    background: root.github-bg-default;
                                    Text {
                                        x: 14px;
                                        y: 10px;
                                        width: parent.width - 28px;
                                        height: 20px;
                                        text: I18n.pr-review-no-description;
                                        wrap: word-wrap;
                                        overflow: clip;
                                        font-size: 13px;
                                        color: root.github-fg-default;
                                        font-italic: true;
                                        vertical-alignment: center;
                                    }
                                }
                                if item.body != "": Rectangle {
                                    width: parent.width;
                                    vertical-stretch: 1;
                                    background: root.github-bg-default;
                                    Text {
                                        x: 14px;
                                        y: 12px;
                                        width: parent.width - 28px;
                                        height: parent.height - 24px;
                                        text: item.body;
                                        wrap: word-wrap;
                                        overflow: clip;
                                        font-size: 13px;
                                        color: root.github-fg-default;
                                    }
                                }
                            }
                        }
                    }
                }

                // GitHub Conversation comment composer (plain text only; no Preview).
                Rectangle {
                    width: parent.width;
                    height: 228px;
                    vertical-stretch: 0;
                    background: transparent;

                    GitHubConversationAvatar {
                        x: 0px;
                        y: 0px;
                        avatar: AppState.user-avatar;
                        fallback-label: "Y";
                    }

                    Rectangle {
                        x: 52px;
                        y: 0px;
                        width: parent.width - 52px;
                        height: parent.height;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        background: root.github-bg-default;
                        clip: true;

                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 0px;

                            // Tab header: selected Write tab sits on the muted bar.
                            Rectangle {
                                width: parent.width;
                                height: 40px;
                                background: root.github-bg-muted;
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: parent.width;
                                    height: 1px;
                                    background: root.github-border-default;
                                }
                                Rectangle {
                                    x: 8px;
                                    y: 8px;
                                    width: 64px;
                                    height: 33px;
                                    border-top-left-radius: 6px;
                                    border-top-right-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.github-border-default;
                                    background: root.github-bg-default;
                                    Rectangle {
                                        x: 1px;
                                        y: parent.height - 1px;
                                        width: parent.width - 2px;
                                        height: 2px;
                                        background: root.github-bg-default;
                                    }
                                    Text {
                                        width: parent.width;
                                        height: parent.height - 1px;
                                        text: I18n.pr-review-write;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.github-fg-default;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                vertical-stretch: 1;
                                min-height: 120px;
                                background: root.github-bg-default;
                                Rectangle {
                                    x: 12px;
                                    y: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height - 16px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: conversation-comment-editor.has-focus
                                        ? GitHubTheme.accent-emphasis
                                        : root.github-border-default;
                                    background: GitHubTheme.canvas-default;
                                    if root.conversation-comment-body == "" && !conversation-comment-editor.has-focus: Text {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: 20px;
                                        text: I18n.pr-review-leave-comment;
                                        font-size: 14px;
                                        color: root.github-fg-muted;
                                    }
                                    conversation-comment-editor := TextInput {
                                        x: 12px;
                                        y: 8px;
                                        width: parent.width - 24px;
                                        height: parent.height - 16px;
                                        text <=> root.conversation-comment-body;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: root.github-fg-default;
                                        font-size: 14px;
                                        enabled: root.can-comment && !root.action-loading;
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                height: 52px;
                                background: root.github-bg-default;
                                Rectangle {
                                    y: 0px;
                                    width: parent.width;
                                    height: 1px;
                                    background: root.github-border-default;
                                }
                                Text {
                                    x: 12px;
                                    y: 1px;
                                    width: parent.width - 140px;
                                    height: parent.height - 1px;
                                    text: root.can-comment
                                        ? I18n.pr-review-plain-text-comments-supported
                                        : I18n.pr-review-configure-to-comment;
                                    font-size: 12px;
                                    color: root.github-fg-muted;
                                    vertical-alignment: center;
                                }
                                GitHubCommentButton {
                                    x: parent.width - 108px;
                                    y: 10px;
                                    width: 96px;
                                    height: 32px;
                                    text: root.action-loading ? I18n.pr-review-commenting : I18n.pr-review-comment;
                                    button-enabled: root.can-comment && !root.action-loading && root.conversation-comment-body != "";
                                    tooltip-text: root.can-comment
                                        ? (root.conversation-comment-body == ""
                                            ? I18n.pr-review-write-comment
                                            : I18n.pr-review-add-comment)
                                        : I18n.pr-review-configure-to-comment;
                                    clicked => {
                                        root.pending-conversation-comment = root.conversation-comment-body;
                                        root.submit-review("comment", root.conversation-comment-body);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        if root.selected-tab == 1: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.github-bg-default;
            if root.commits-loading: GitHubCenteredLoadingState {
                width: parent.width;
                height: parent.height;
                label: I18n.pr-review-loading-commits;
                foreground: root.github-fg-muted;
            }
            if !root.commits-loading && root.commits-error != "": GitHubCenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                retry => { root.select-tab(1); }
            }
            if !root.commits-loading && root.commits-error == "": ListView {
                x: max(24px, (parent.width - min(980px, parent.width - 48px)) / 2);
                y: 20px;
                width: min(980px, parent.width - 48px);
                height: parent.height - 40px;
                    for commit in root.commits: commit-item := Rectangle {
                    private property <bool> commit-expanded: commit.message-expanded;
                    // Prefer measured wrap height so expanded rows hug body text
                    // (no blank band above the author footer). Multiple rows may
                    // stay expanded independently.
                    private property <length> title-max-width: commit.message-body != ""
                        ? (parent.width - 66px) - 220px - 36px
                        : (parent.width - 66px) - 220px;
                    private property <length> title-block-height:
                        max(20px, commit-item-title-measure.preferred-height);
                    private property <length> title-extra:
                        max(0px, self.title-block-height - 20px);
                    private property <length> measured-body-height:
                        !self.commit-expanded || commit.message-body == ""
                            ? 0px
                            : commit-tab-body-measure.preferred-height;
                    // Title wrap grows collapsed and expanded rows; body height
                    // only applies while expanded.
                    private property <length> expand-extra: self.title-extra
                        + (self.commit-expanded
                            ? self.measured-body-height
                                + root.commit-tab-title-band
                                + root.commit-tab-body-footer-gap
                                + root.commit-tab-author-band
                                - root.commit-tab-row-height
                            : 0px);
                    height: (commit.group-start
                        ? root.commit-tab-group-header-height + root.commit-tab-row-height
                        : root.commit-tab-row-height) + self.expand-extra;
                    background: transparent;
                    commit-item-title-measure := Text {
                        visible: false;
                        width: commit-item.title-max-width;
                        text: commit.title;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        x: 20px;
                        y: commit.group-start ? root.commit-tab-group-header-height : 0px;
                        width: 2px;
                        height: parent.height - (commit.group-start ? root.commit-tab-group-header-height : 0px);
                        background: root.github-border-default;
                    }
                    if commit.group-start: Rectangle {
                        x: 12px;
                        // Center the timeline badge in the inter-card header gap.
                        y: (root.commit-tab-group-header-height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        background: root.github-bg-default;
                        Image {
                            x: 1px;
                            y: 1px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-git-commit-16.svg");
                            image-fit: contain;
                            colorize: root.github-fg-muted;
                        }
                    }
                    if commit.group-start: Text {
                        x: 48px;
                        // Same vertical center as the badge so the date label
                        // sits in the middle of the gap between cards.
                        y: (root.commit-tab-group-header-height - self.height) / 2;
                        width: parent.width - 66px;
                        height: 24px;
                        text: I18n.pr-review-commits-on + " " + commit.date-label;
                        vertical-alignment: center;
                        font-size: 14px;
                        font-weight: 600;
                        color: root.github-fg-muted;
                    }
                    // Per-row card chrome so multi-expand preferred-heights stay
                    // bordered without a precomputed group-expand-extra sum.
                    // Use the Rectangle border + radii (Primer medium 6px) so
                    // corners are not squared off by full-height edge strokes.
                    // Non-start rows overlap the previous bottom border by 1px
                    // to keep a single separator between commits.
                    Rectangle {
                        x: 48px;
                        y: commit.group-start
                            ? root.commit-tab-group-header-height
                            : -1px;
                        width: parent.width - 66px;
                        height: root.commit-tab-row-height + commit-item.expand-extra
                            + (commit.group-start ? 0px : 1px);
                        background: root.github-bg-default;
                        border-width: 1px;
                        border-color: root.github-border-default;
                        border-top-left-radius: commit.group-start ? root.commit-tab-card-radius : 0px;
                        border-top-right-radius: commit.group-start ? root.commit-tab-card-radius : 0px;
                        border-bottom-left-radius: commit.group-end ? root.commit-tab-card-radius : 0px;
                        border-bottom-right-radius: commit.group-end ? root.commit-tab-card-radius : 0px;
                    }
                    commit-row := Rectangle {
                        x: 48px;
                        y: commit.group-start ? root.commit-tab-group-header-height : 0px;
                        width: parent.width - 66px;
                        height: root.commit-tab-row-height + commit-item.expand-extra;
                        background: transparent;
                        // Natural single-line width pins the kebab beside short titles.
                        private property <length> title-hit-width:
                            min(commit-item.title-max-width, tab-commit-title-natural.preferred-width);
                        // TextInput reports the exact caret origin at the end of
                        // wrapped text (horizontal). Vertical placement uses the
                        // visible Text line metrics instead — TextInput line boxes
                        // can sit above the rendered title and lift the kebab.
                        private property <length> title-end-x: self.title-hit-width;
                        private property <length> title-line-height:
                            max(20px, tab-commit-title-natural.preferred-height);
                        // True when the title wraps past one line — kebab Y is
                        // tuned separately for single-line vs multi-line.
                        private property <bool> title-wrapped:
                            commit-item.title-block-height > self.title-line-height + 1px;
                        // Child TouchAreas steal hover from the full-row area;
                        // OR them so chrome fill stays while title/SHA/copy/time
                        // (and kebab) are hovered. Title underline + SHA chip
                        // still key off their own has-hover only.
                        private property <bool> time-hovered: false;
                        private property <bool> sha-hovered: false;
                        private property <bool> row-hovered:
                            tab-commit-row-touch.has-hover
                            || tab-commit-title-touch.has-hover
                            || self.sha-hovered
                            || copy-sha-button.has-hover
                            || (commit.message-body != "" && commit-kebab.has-hover)
                            || (commit.short-date-label != "" && self.time-hovered);
                        private property <length> content-trail-width: 188px;
                        private property <color> sha-hover-fill:
                            GitHubTheme.control-muted-hover;

                        // Hidden measure keeps expand-extra and the author footer
                        // aligned to the wrapped body without blank gaps.
                        commit-tab-body-measure := Text {
                            visible: false;
                            width: parent.width - commit-row.content-trail-width;
                            text: commit.message-body;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        // Hover fill covers the full expanded row (title + body +
                        // author), staying inside the group border / separators.
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            background: commit-row.row-hovered ? root.github-bg-muted : transparent;
                            border-top-left-radius: commit.group-start ? root.commit-tab-card-radius - 1px : 0px;
                            border-top-right-radius: commit.group-start ? root.commit-tab-card-radius - 1px : 0px;
                            border-bottom-left-radius: commit.group-end ? root.commit-tab-card-radius - 1px : 0px;
                            border-bottom-right-radius: commit.group-end ? root.commit-tab-card-radius - 1px : 0px;
                        }

                        // Row chrome: muted fill on hover only. Navigation is
                        // title + short-SHA only; kebab only expands the body.
                        tab-commit-row-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }

                        tab-commit-title-natural := Text {
                            visible: false;
                            text: commit.title;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        // Layout probe for the exact end of the final wrapped
                        // title line. It stays mounted and transparent so a
                        // width change recomputes the kebab position without
                        // rebuilding the commit model.
                        title-end-probe := TextInput {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            opacity: 0;
                            enabled: false;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            text: commit.title;
                            font-size: 14px;
                            font-weight: 600;
                            text-cursor-width: 0px;
                            init => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            changed width => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            changed text => {
                                self.set-selection-offsets(2147483647, 2147483647);
                            }
                            cursor-position-changed(position) => {
                                commit-row.title-end-x = position.x;
                            }
                        }
                        if !tab-commit-title-touch.has-hover: Text {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            text: commit.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                        // StyledText draws an underline per glyph run, including
                        // each wrapped line, matching GitHub's inline link. The
                        // old Rectangle produced one unrelated blue rule.
                        if tab-commit-title-touch.has-hover: StyledText {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: commit-item.title-max-width;
                            height: commit-item.title-block-height;
                            text: @markdown("<u>**\{commit.title}**</u>");
                            default-font-size: 14px;
                            default-color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }
                        tab-commit-title-touch := TouchArea {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y;
                            width: parent.title-hit-width;
                            height: commit-item.title-block-height;
                            mouse-cursor: pointer;
                            clicked => { root.open-commit(commit.sha); }
                        }

                        // Collapsed: author under title. Expanded: body then author footer.
                        if !commit-item.commit-expanded: HorizontalLayout {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-content-y + commit-item.title-block-height + 4px;
                            width: parent.width - commit-row.content-trail-width;
                            height: 22px;
                            spacing: 4px;
                            cross-axis-alignment: center;
                            GitHubCommitIdentityAvatars {
                                avatar-size: 20px;
                                author-avatar: commit.avatar;
                                author-label: commit.avatar-label;
                                committer-avatar: commit.committer-avatar;
                                committer-label: commit.committer-avatar-label;
                                show-committer: commit.show-committer;
                            }
                            Text {
                                width: self.preferred-width;
                                text: commit.identity-action;
                                font-size: 12px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if commit.short-date-label != "": GitHubRelativeTimestamp {
                                text: commit.short-date-label;
                                tooltip-text: commit.authored-at;
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                                label-height: 22px;
                                changed has-hover => {
                                    commit-row.time-hovered = self.has-hover;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if commit-item.commit-expanded && commit.message-body != "": Text {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-title-band + commit-item.title-extra;
                            width: parent.width - commit-row.content-trail-width;
                            height: commit-tab-body-measure.preferred-height;
                            text: commit.message-body;
                            font-size: 12px;
                            color: root.github-fg-default;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }

                        if commit-item.commit-expanded: HorizontalLayout {
                            x: root.commit-tab-content-x;
                            y: root.commit-tab-title-band
                                + commit-item.title-extra
                                + (commit.message-body != ""
                                    ? commit-tab-body-measure.preferred-height
                                    : 0px)
                                + root.commit-tab-body-footer-gap;
                            width: parent.width - commit-row.content-trail-width;
                            height: root.commit-tab-author-band;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            GitHubCommitIdentityAvatars {
                                avatar-size: 20px;
                                author-avatar: commit.avatar;
                                author-label: commit.avatar-label;
                                committer-avatar: commit.committer-avatar;
                                committer-label: commit.committer-avatar-label;
                                show-committer: commit.show-committer;
                            }
                            Text {
                                width: self.preferred-width;
                                text: commit.identity-action;
                                font-size: 12px;
                                color: root.github-fg-muted;
                                vertical-alignment: center;
                            }
                            if commit.short-date-label != "": GitHubRelativeTimestamp {
                                text: commit.short-date-label;
                                tooltip-text: commit.authored-at;
                                tooltip-after: true;
                                foreground-color: root.github-fg-muted;
                                label-font-size: 12px;
                                label-height: root.commit-tab-author-band;
                                changed has-hover => {
                                    commit-row.time-hovered = self.has-hover;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if commit.verified: Text {
                            x: parent.width - 226px;
                            y: 0px;
                            width: 64px;
                            height: root.commit-tab-row-height;
                            text: I18n.pr-review-verified;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.github-success-fg;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        tab-commit-sha-natural := Text {
                            visible: false;
                            text: commit.short-sha;
                            font-size: 12px;
                        }
                        // GitHub short SHA is plain text at rest. Its rounded
                        // control-hover pill appears only while the SHA itself
                        // is hovered—never from row chrome alone. Use Primer
                        // the shared semantic control-hover token, not
                        // page `bg-muted`, so the pill stays visible on both
                        // white and row-muted fills.
                        commit-sha-chip := Rectangle {
                            z: 1;
                            x: parent.width - 58px - self.width;
                            y: (parent.height - self.height) / 2;
                            width: tab-commit-sha-natural.preferred-width + 16px;
                            height: 28px;
                            border-radius: 6px;
                            border-width: 0px;
                            background: commit-row.sha-hovered
                                ? commit-row.sha-hover-fill
                                : transparent;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: commit.short-sha;
                                font-size: 12px;
                                color: root.github-fg-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            tab-commit-sha-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-commit(commit.sha); }
                                changed has-hover => {
                                    commit-row.sha-hovered = self.has-hover;
                                }
                            }
                            GitHubTooltip {
                                preferred-placement: GitHubTooltipPlacement.Top;
                                alignment: GitHubTooltipAlignment.End;
                                text: commit-row.sha-hovered ? I18n.pr-review-view-commit-details : "";
                            }
                        }
                        copy-sha-button := GitHubCopyButton {
                            x: parent.width - 44px;
                            y: (parent.height - self.height) / 2;
                            tooltip-text: I18n.pr-review-copy-full-sha;
                            tooltip-align-right: true;
                            copy-requested => { root.copy-commit-sha(commit.sha) }
                        }
                        // Always mounted so row-hovered can read has-hover; hide
                        // when there is no message body to expand. Declared last
                        // so the kebab wins hit-testing over the title touch.
                        commit-kebab := GitHubCommitMessageToggleButton {
                            visible: commit.message-body != "";
                            x: min(
                                root.commit-tab-content-x + parent.title-end-x + 8px,
                                root.commit-tab-content-x + commit-item.title-max-width + 8px
                            );
                            // Single-line and multi-line kebabs use separate Y
                            // nudges — tune each branch independently.
                            y: parent.title-wrapped
                                ? (root.commit-tab-content-y
                                    + commit-item.title-block-height
                                    - (parent.title-line-height + self.height) / 2
                                    + 3px)
                                : (root.commit-tab-content-y
                                    + commit-item.title-block-height
                                    - (parent.title-line-height + self.height) / 2
                                    - 3px);
                            expanded: commit-item.commit-expanded;
                            clicked => { root.toggle-commit-message(commit.sha); }
                        }
                    }
                }
            }
            if !root.commits-loading && root.commits-error == "" && root.commits.length == 0: Text {
                width: parent.width;
                height: parent.height;
                text: I18n.pr-review-no-commits;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.github-fg-muted;
            }
        }

        if root.selected-tab == 2: Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            // File-filter ActionMenu may flip above into the tab row; the menu
            // itself mounts on the workspace root so toolbar z:80 cannot cover it.
            clip: false;
            background: root.github-bg-default;

            if root.loading: GitHubCenteredLoadingState {
                width: parent.width;
                height: parent.height;
                label: I18n.pr-review-loading-files;
                foreground: root.github-fg-muted;
            }

            if !root.loading && root.error-text != "": GitHubCenteredErrorState {
                width: parent.width;
                height: parent.height;
                background-color: root.github-bg-default;
                outline-color: root.github-border-default;
                foreground-color: root.github-fg-default;
                muted-color: root.github-fg-muted;
                action-label: root.error-kind == "authentication" || root.error-kind == "configuration"
                    ? I18n.common-open-settings
                    : I18n.common-try-again;
                retry => {
                    if root.error-kind == "authentication" || root.error-kind == "configuration" {
                        root.open-settings();
                    } else {
                        root.reload(root.ignore-whitespace);
                    }
                }
            }

            if !root.loading && root.error-text == "": diff-surface := Rectangle {
                width: parent.width;
                height: parent.height;
                // Keep false so the file-filter ActionMenu can flip above the
                // tree header into the tabs row without being clipped here.
                clip: false;
                background: transparent;
                private property <int> observed-line-model-revision: root.line-model-revision;
                private property <int> observed-line-content-revision: root.line-content-revision;
                private property <int> observed-hunk-scroll-restore-revision:
                    root.hunk-scroll-restore-revision;
                private property <int> observed-diff-find-scroll-revision:
                    root.diff-find-scroll-revision;
                private property <WorkflowPrDiffVirtualWindow> virtual-window;
                private property <bool> refreshing-virtual-window: false;
                private property <length> diagnostic-viewport-y: diff-scroll.viewport-y;
                private property <length> diagnostic-viewport-height: diff-scroll.viewport-height;
                private property <length> diagnostic-visible-height: diff-scroll.visible-height;
                private property <length> diagnostic-visible-width: diff-scroll.visible-width;
                private property <bool> diagnostic-find-open: root.diff-find-open;
                // Hunk replacement updates the exact-height index before the
                // clicked source anchor is restored. Keep the existing bounded
                // retries for the asynchronous highlighted-model replacement.
                private property <int> hunk-scroll-restore-attempts: 0;

                function request-hunk-expansion(line-index: int, direction: string, content-y: length) {
                    root.hunk-scroll-anchor-screen-y = content-y + diff-scroll.viewport-y;
                    root.hunk-scroll-anchor-resolved = false;
                    root.hunk-scroll-restore-pending = true;
                    root.expand-hunk(line-index, direction);
                }

                function emit-scroll-diagnostic(kind: string, requested-y: length) {
                    if root.scroll-diagnostics-enabled {
                        root.diagnose-diff-scroll(
                            kind,
                            diff-scroll.viewport-y / 1px,
                            requested-y / 1px,
                            diff-scroll.visible-height / 1px,
                            diff-scroll.viewport-height / 1px,
                            root.diff-find-open,
                            root.diff-find-input-focused,
                            root.hunk-scroll-restore-pending,
                            root.diff-find-scroll-revision,
                            root.line-model-revision,
                            diff-surface.hunk-scroll-restore-attempts
                        );
                    }
                }

                function refresh-virtual-window() {
                    if diff-surface.refreshing-virtual-window {
                        return;
                    }
                    diff-surface.refreshing-virtual-window = true;
                    let code-width = root.diff-view == "split"
                        ? max(1.0, ((diff-scroll.visible_width / 1px) - 1.0) / 2.0 - 70.0)
                        : max(1.0, (diff-scroll.visible_width / 1px) - 120.0);
                    let next = root.layout-diff-virtual-window(
                        root.line-content-revision,
                        root.line-metrics,
                        max(0.0, -diff-scroll.viewport-y / 1px),
                        max(1.0, diff-scroll.visible-height / 1px),
                        code-width,
                        root.code-character-width / 1px,
                        root.code-line-height / 1px,
                        root.hunk-line-height / 1px
                    );
                    let clamped-y = -next.scroll-offset * 1px;
                    diff-surface.virtual-window = next;
                    if Math.abs(diff-scroll.viewport-y - clamped-y) > 0.5px {
                        diff-scroll.viewport-y = clamped-y;
                    }
                    diff-surface.refreshing-virtual-window = false;
                }

                init => {
                    diff-surface.refresh-virtual-window();
                    diff-surface.emit-scroll-diagnostic("surface-init", diff-scroll.viewport-y);
                }

                changed diagnostic-viewport-y => {
                    diff-surface.refresh-virtual-window();
                    diff-surface.emit-scroll-diagnostic("viewport", diff-scroll.viewport-y);
                }

                changed diagnostic-viewport-height => {
                    diff-surface.emit-scroll-diagnostic("extent", diff-scroll.viewport-y);
                }

                changed diagnostic-visible-height => {
                    diff-surface.refresh-virtual-window();
                    diff-surface.emit-scroll-diagnostic("visible", diff-scroll.viewport-y);
                }

                changed diagnostic-visible-width => {
                    diff-surface.refresh-virtual-window();
                }

                changed diagnostic-find-open => {
                    diff-surface.emit-scroll-diagnostic(
                        root.diff-find-open ? "find-open" : "find-close",
                        diff-scroll.viewport-y
                    );
                }

                function apply-diff-find-scroll() {
                    if !root.diff-find-has-current
                        || !root.diff-find-input-focused
                        || root.live-resizing {
                        return;
                    }
                    let code-width = root.diff-view == "split"
                        ? max(1.0, ((diff-scroll.visible_width / 1px) - 1.0) / 2.0 - 70.0)
                        : max(1.0, (diff-scroll.visible_width / 1px) - 120.0);
                    let target-y = root.resolve-diff-find-viewport-y(
                        root.diff-find-cur-line,
                        root.diff-find-cur-start-char,
                        code-width,
                        root.code-character-width / 1px,
                        root.diff-view == "split" ? root.diff-find-cur-side : "",
                        diff-scroll.viewport-y / 1px,
                        diff-scroll.visible-height / 1px,
                        diff-scroll.viewport-height / 1px
                    );
                    if Math.abs(diff-scroll.viewport-y - target-y * 1px) > 1px {
                        diff-surface.emit-scroll-diagnostic("find-write", target-y * 1px);
                        diff-scroll.viewport-y = target-y * 1px;
                    }
                }

                changed observed-line-model-revision => {
                    root.hunk-scroll-restore-pending = false;
                    root.hunk-scroll-anchor-resolved = false;
                    diff-surface.emit-scroll-diagnostic("model-reset-write", 0px);
                    diff-scroll.viewport-x = 0px;
                    diff-scroll.viewport-y = 0px;
                }

                changed observed-line-content-revision => {
                    diff-surface.refresh-virtual-window();
                }

                changed observed-hunk-scroll-restore-revision => {
                    if root.hunk-scroll-restore-pending {
                        diff-surface.hunk-scroll-restore-attempts = 12;
                    }
                }

                changed observed-diff-find-scroll-revision => {
                    // One command, one calculation, at most one viewport write.
                    // No timer or observer can re-enter this during scrolling.
                    diff-surface.apply-diff-find-scroll();
                }

                hunk-scroll-restore-timer := Timer {
                    interval: 16ms;
                    running: root.hunk-scroll-restore-pending
                        && diff-surface.hunk-scroll-restore-attempts > 0;
                    triggered => {
                        if root.hunk-scroll-restore-pending
                            && root.hunk-scroll-anchor-resolved {
                            let minimum-y = min(
                                0px,
                                diff-scroll.visible-height - diff-scroll.viewport-height,
                            );
                            let target-y = root.hunk-scroll-anchor-screen-y
                                - root.hunk-scroll-anchor-content-y;
                            diff-surface.emit-scroll-diagnostic("hunk-write", target-y);
                            diff-scroll.viewport-y = max(minimum-y, min(0px, target-y));
                            if diff-surface.hunk-scroll-restore-attempts <= 1 {
                                diff-surface.hunk-scroll-restore-attempts = 0;
                                root.hunk-scroll-restore-pending = false;
                                root.hunk-scroll-anchor-resolved = false;
                            } else {
                                diff-surface.hunk-scroll-restore-attempts -= 1;
                            }
                        } else if root.hunk-scroll-restore-pending {
                            diff-surface.hunk-scroll-restore-attempts -= 1;
                            if diff-surface.hunk-scroll-restore-attempts <= 0 {
                                root.hunk-scroll-restore-pending = false;
                            }
                        }
                    }
                }

                if root.file-list-visible: Rectangle {
                    x: 0px;
                    width: root.file-list-width;
                    height: parent.height;
                    background: root.github-bg-default;
                    border-width: 0px;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;
                        Rectangle {
                            width: parent.width;
                            height: 52px;
                            z: 20;
                            background: root.github-bg-default;
                            GitHubFileFilterField {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 66px;
                                text <=> root.file-filter;
                                font-family: root.tree-font-family;
                            }
                            Rectangle {
                                x: parent.width - 46px;
                                y: 9px;
                                width: 34px;
                                height: 34px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.file-filters-active
                                    ? (GitHubTheme.accent-fg)
                                    : root.github-border-default;
                                background: filter-button-touch.has-hover
                                    ? (root.active-popover == "file-filter"
                                        ? (GitHubTheme.control-soft-rest)
                                        : root.github-bg-muted)
                                    : (root.active-popover == "file-filter"
                                        ? (GitHubTheme.control-soft-hover)
                                        : root.github-bg-default);
                                Image {
                                    x: 9px;
                                    y: 9px;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../../assets/icons/octicon-filter-16.svg");
                                    image-fit: contain;
                                    colorize: root.file-filters-active
                                        ? (GitHubTheme.accent-fg)
                                        : root.github-fg-muted;
                                }
                                filter-button-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.active-popover = root.active-popover == "file-filter" ? "" : "file-filter";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            vertical-stretch: 1;

                            file-scroll := ListView {
                                width: parent.width;
                                height: parent.height;
                                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                                vertical_scrollbar_policy: ScrollBarPolicy.as_needed;
                                for item in root.tree-items: Rectangle {
                                    width: file-scroll.visible_width;
                                    height: 28px;
                                    background: item.kind == "file" && root.selected-file-index == item.file-index
                                        ? root.github-accent-muted
                                        : (root.active-popover != "diff-settings" && tree-touch.has-hover
                                            ? root.github-bg-muted
                                            : transparent);
                                    border-width: 0px;
                                    GitHubTreeIndentGuides { width: parent.width; height: parent.height; depth: item.depth; }
                                    HorizontalLayout {
                                        padding-left: 10px + item.depth * 18px;
                                        padding-right: 10px;
                                        spacing: 7px;
                                        Rectangle {
                                            width: 32px;
                                            height: parent.height;
                                            if item.kind == "folder": Image {
                                                x: 0px;
                                                y: (parent.height - self.height) / 2;
                                                width: 12px;
                                                height: 12px;
                                                source: item.expanded
                                                    ? @image-url("../../assets/icons/octicon-chevron-down-16.svg")
                                                    : @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                                                image-fit: contain;
                                            }
                                            if item.kind == "folder": Image {
                                                x: 18px;
                                                y: (parent.height - self.height) / 2;
                                                width: 14px;
                                                height: 14px;
                                                source: item.expanded
                                                    ? @image-url("../../assets/icons/octicon-file-directory-open-fill-16.svg")
                                                    : @image-url("../../assets/icons/octicon-file-directory-fill-16.svg");
                                                image-fit: contain;
                                            }
                                            if item.kind == "file": GitHubFileChangeTypeIcon {
                                                x: 18px;
                                                y: (parent.height - self.height) / 2;
                                                width: 14px;
                                                height: 14px;
                                                change-type: item.change-type;
                                                muted-fg: root.github-fg-muted;
                                                success-fg: root.github-success-fg;
                                                danger-fg: root.github-danger-fg;
                                                attention-fg: root.github-attention-fg;
                                            }
                                        }
                                        if item.kind == "folder": Text {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            text: item.name;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                            font-family: root.tree-font-family;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: root.github-fg-default;
                                            overflow: elide;
                                        }
                                        if item.kind == "folder": Text {
                                            width: 24px;
                                            height: parent.height;
                                            text: item.file-count;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            font-family: root.tree-font-family;
                                            font-size: 12px;
                                            color: root.github-fg-muted;
                                        }
                                        if item.kind == "file": Rectangle {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            filename := Text {
                                                x: 0px;
                                                width: min(self.preferred-width, max(0px, parent.width - 60px));
                                                height: parent.height;
                                                text: item.name;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 14px;
                                                font-weight: root.selected-file-index == item.file-index ? 600 : 400;
                                                color: root.github-fg-default;
                                                overflow: elide;
                                            }
                                            added-count := Text {
                                                x: filename.width + 7px;
                                                width: self.preferred-width;
                                                height: parent.height;
                                                text: "+" + item.added-lines;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: root.github-success-fg;
                                            }
                                            Text {
                                                x: added-count.x + added-count.preferred-width + 7px;
                                                width: self.preferred-width;
                                                height: parent.height;
                                                text: "−" + item.removed-lines;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                font-family: root.tree-font-family;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: root.github-danger-fg;
                                            }
                                        }
                                    }
                                    tree-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.active-popover = "";
                                            if item.kind == "folder" { root.toggle-folder(item.path); }
                                            else { root.select-file(item.file-index); }
                                        }
                                    }
                                }
                            }

                            if root.tree-items.length == 0: Text {
                                width: parent.width;
                                height: 72px;
                                text: root.file-filter == ""
                                    ? I18n.pr-review-no-changed-files
                                    : I18n.pr-review-no-matching-files;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-family: root.tree-font-family;
                                font-size: 14px;
                                color: GitHubTheme.fg-muted;
                            }
                        }
                    }
                }

                if root.file-list-visible: Rectangle { x: root.file-list-width; width: 1px; height: parent.height; background: root.github-border-default; }

                Rectangle {
                    x: root.file-list-visible ? root.file-list-width + 1px : 0px;
                    width: root.file-list-visible ? parent.width - root.file-list-width - 1px : parent.width;
                    height: parent.height;
                    background: root.github-bg-default;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;

                        Rectangle {
                            width: parent.width;
                            height: 46px;
                            z: 20;
                            background: root.github-bg-default;
                            border-width: 0px;
                            Rectangle {
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: root.github-border-default;
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                // The file toolbar is 46px tall while icon actions are
                                // GitHub's 32px controls. Center their hit targets and
                                // allow their tooltip layer to sit over the diff below.
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 16px;
                                    height: parent.height;
                                    GitHubFileChangeTypeIcon {
                                        y: (parent.height - self.height) / 2;
                                        width: 16px;
                                        height: 16px;
                                        change-type: root.selected-file-change-type;
                                        muted-fg: root.github-fg-muted;
                                        success-fg: root.github-success-fg;
                                        danger-fg: root.github-danger-fg;
                                        attention-fg: root.github-attention-fg;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: parent.height;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 2px;
                                        // This is the layout that owns the 32px copy
                                        // control. Keep it centered within the 46px
                                        // selected-file toolbar.
                                        cross-axis-alignment: center;

                                        Text {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            text: root.selected-file-path == ""
                                                ? I18n.pr-review-select-changed-file
                                                : root.selected-file-path;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: GitHubTheme.fg-default;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        GitHubCopyButton {
                                            button-enabled: root.selected-file-path != "";
                                            tooltip-text: I18n.pr-review-copy-file-path;
                                            // An above-tooltip would leave this toolbar's
                                            // stacking context. Show it over the diff body.
                                            tooltip-above: false;
                                            copy-requested => { root.copy-file-path(root.selected-file-path) }
                                        }
                                        GitHubFileToolbarButton {
                                            icon-source: root.context-expanded
                                                ? @image-url("../../assets/icons/octicon-fold-16.svg")
                                                : @image-url("../../assets/icons/octicon-unfold-16.svg");
                                            button-enabled: (root.has-expandable-hunks || root.context-expanded) && !root.viewing-file && !root.code-loading;
                                            tooltip-text: root.context-expanded
                                                ? I18n.pr-review-collapse-non-diff
                                                : I18n.pr-review-expand-all-lines;
                                            clicked => {
                                                if root.context-expanded { root.collapse-non-diff-lines(); }
                                                else { root.expand-all-hunks(); }
                                            }
                                        }
                                    }
                                }
                                GitHubFileDiffStat {
                                    additions: root.selected-file-added-lines;
                                    deletions: root.selected-file-removed-lines;
                                    has-selection: root.selected-file-index >= 0;
                                }
                                diff-find-bar := GitHubDiffFindBar {
                                    visible: root.diff-find-open;
                                    width: root.diff-find-open ? 320px : 0px;
                                    query <=> root.diff-find-query;
                                    current-index: root.diff-find-index;
                                    match-count: root.diff-find-matches.length;
                                    previous => {
                                        // GitHubDiffFindBar focuses its input
                                        // before emitting this explicit command.
                                        // Mirror that state synchronously so
                                        // callback ordering cannot drop reveal.
                                        root.diff-find-input-focused = true;
                                        root.step-diff-find(true);
                                    }
                                    next => {
                                        root.diff-find-input-focused = true;
                                        root.step-diff-find(false);
                                    }
                                    close => { root.close-diff-find(); }
                                    accepted(backward) => { root.step-diff-find(backward); }
                                    input-focus-changed(focused) => {
                                        root.diff-find-input-focused = focused;
                                    }
                                }
                                find-focus-timer := Timer {
                                    interval: 16ms;
                                    running: root.diff-find-focus-pending && root.diff-find-open;
                                    triggered => {
                                        if (root.diff-find-open && root.diff-find-focus-pending) {
                                            diff-find-bar.focus-input();
                                            root.diff-find-focus-pending = false;
                                        }
                                    }
                                }
                                if !root.diff-find-open: Text {
                                    width: 48px;
                                    height: parent.height;
                                    text: root.selected-file-index < 0 ? "" : (root.selected-file-index + 1) + " / " + root.files.length;
                                    horizontal-alignment: center;
                                    font-size: 10px;
                                    color: GitHubTheme.fg-muted;
                                    vertical-alignment: center;
                                }
                                if !root.diff-find-open: GitHubFileToolbarButton {
                                    icon-source: @image-url("../../assets/icons/octicon-chevron-left-16.svg");
                                    button-enabled: root.selected-file-index > 0 && !root.code-loading;
                                    tooltip-text: I18n.pr-review-previous-file;
                                    clicked => { root.select-relative-file(-1); }
                                }
                                if !root.diff-find-open: GitHubFileToolbarButton {
                                    icon-source: @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                                    button-enabled: root.selected-file-index >= 0 && root.selected-file-index + 1 < root.files.length && !root.code-loading;
                                    tooltip-text: I18n.pr-review-next-file;
                                    tooltip-align-right: true;
                                    clicked => { root.select-relative-file(1); }
                                }
                                GitHubFileMenuButton {
                                    button-enabled: root.selected-file-index >= 0 && !root.code-loading;
                                    viewing-file: root.viewing-file;
                                    open: root.active-popover == "file-menu";
                                    viewport-global-x: root.absolute-position.x + root.shell-leading-inset;
                                    viewport-global-y: root.absolute-position.y;
                                    viewport-width: root.content-width;
                                    viewport-height: root.height;
                                    toggle-menu => {
                                        root.active-popover = root.active-popover == "file-menu" ? "" : "file-menu";
                                    }
                                    close-menu => { root.active-popover = ""; }
                                    action => {
                                        root.active-popover = "";
                                        root.view-file();
                                    }
                                }
                            }
                        }

                        diff-scroll-frame := Rectangle {
                            width: parent.width;
                            vertical-stretch: 1;
                            background: transparent;

                        diff-scroll := ScrollView {
                            width: parent.width;
                            height: parent.height;
                            visible: !root.large-diff-deferred && !root.large-diff-loading;
                            // A Flickable normally steals vertical drags after
                            // 8px and cancels the code TouchArea. GitHub treats
                            // dragging code as selection; wheel/touchpad and
                            // the vertical scrollbar continue to scroll this view.
                            interactive: false;
                            // Diff rows calculate their wrapped height from the
                            // available code column. Never reserve or expose a
                            // horizontal track for content that already wraps.
                            horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                            vertical_scrollbar_policy: ScrollBarPolicy.always_off;
                            viewport_width: self.visible_width;
                            viewport_height: max(
                                self.visible_height,
                                diff-surface.virtual-window.content-height * 1px
                            );
                            for virtual-row in diff-surface.virtual-window.rows: diff-line-row := Rectangle {
                                private property <int> line-index: virtual-row.index;
                                private property <WorkflowPrDiffLine> line: virtual-row.line;
                                private property <int> observed-hunk-scroll-restore-revision:
                                    root.hunk-scroll-restore-revision;
                                function report-hunk-scroll-anchor() {
                                    if root.hunk-scroll-restore-pending
                                        && line.source-index == root.hunk-scroll-anchor-source-index {
                                        root.hunk-scroll-anchor-content-y = self.y;
                                        root.hunk-scroll-anchor-resolved = true;
                                    }
                                }
                                init => { self.report-hunk-scroll-anchor(); }
                                changed y => {
                                    self.report-hunk-scroll-anchor();
                                }
                                // A retained overscan row may keep its component
                                // instance while the highlighted model changes.
                                // The Rust-side revision provides a deterministic
                                // post-update anchor report in that case.
                                changed observed-hunk-scroll-restore-revision => {
                                    self.report-hunk-scroll-anchor();
                                }
                                private property <length> split-code-width:
                                    max(1px, (diff-scroll.visible_width - 1px) / 2 - 70px);
                                private property <length> split-content-width:
                                    max(line.left-columns, line.right-columns) * root.code-character-width;
                                private property <int> split-visual-lines:
                                    max(1, Math.ceil(self.split-content-width / self.split-code-width));
                                private property <length> unified-code-width:
                                    max(1px, diff-scroll.visible_width - 120px);
                                private property <length> unified-content-width:
                                    line.left-columns * root.code-character-width;
                                private property <bool> unified-wraps:
                                    root.diff-view != "split"
                                    && line.kind != "hunk"
                                    && self.unified-content-width > self.unified-code-width;
                                private property <int> unified-visual-lines:
                                    max(1, Math.ceil(self.unified-content-width / self.unified-code-width));
                                x: 0px;
                                y: virtual-row.start * 1px;
                                width: diff-scroll.visible_width;
                                height: virtual-row.size * 1px;
                                background: line.kind == "addition"
                                    ? root.diff-addition-background
                                    : (line.kind == "deletion"
                                        ? root.diff-deletion-background
                                        : (line.kind == "hunk" ? root.hunk-background : root.github-bg-default));
                                if root.diff-view != "split": unified-row := Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        // Absolute gutters match GitHubSplitDiffSide: HorizontalLayout was
                                        // still vertically centering +/- across soft-wrapped row height.
                                        private property <length> gutter-width: 120px;

                                        if line.kind == "hunk" && line.expandable: Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: 100px;
                                            height: parent.height;
                                            background: root.hunk-gutter-background;

                                            if line.expand-all: Rectangle {
                                                width: parent.width;
                                                height: parent.height;
                                                background: hunk-expand-all-touch.has-hover ? root.github-accent-fg : transparent;
                                                Image {
                                                    x: (parent.width - 16px) / 2;
                                                    y: (parent.height - 16px) / 2;
                                                    width: 16px;
                                                    height: 16px;
                                                    source: @image-url("../../assets/icons/octicon-unfold-16.svg");
                                                    image-fit: contain;
                                                    colorize: hunk-expand-all-touch.has-hover ? GitHubTheme.fg-on-emphasis : root.github-fg-muted;
                                                }
                                                hunk-expand-all-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { diff-surface.request-hunk-expansion(line.source-index, "all", diff-line-row.y); }
                                                }
                                            }
                                            if line.expand-down && !line.expand-all: Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width;
                                                height: line.expand-up ? parent.height / 2 : parent.height;
                                                background: hunk-expand-down-touch.has-hover ? root.github-accent-fg : transparent;
                                                Image {
                                                    x: (parent.width - 16px) / 2;
                                                    y: (parent.height - 16px) / 2;
                                                    width: 16px;
                                                    height: 16px;
                                                    source: @image-url("../../assets/icons/octicon-fold-down-16.svg");
                                                    image-fit: contain;
                                                    colorize: hunk-expand-down-touch.has-hover ? GitHubTheme.fg-on-emphasis : root.github-fg-muted;
                                                }
                                                hunk-expand-down-touch := TouchArea {
                                                    mouse-cursor: pointer;
