import { MaterialText, FilledButton, Horizontal, Vertical } from "@material";
import { Route } from "../route/routeMap.slint";
import { NotificationManager, Notification, NotificationType, CustomComponentType } from "../components/notify/notification.slint";

export component Notification {
    callback navigate(Route);
    
    // 消息计数器
    private property <int> message-counter: 0;

    Rectangle {
        width: parent.width;
        height: parent.height;

        Vertical {
            width: parent.width;
            vertical-stretch: 1;

            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Notification";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }
    
                FilledButton {
                    text: "Show Notificationdasdasdaddasdsd ";
    
                    clicked => {
                        // 使用对象参数，类似 JavaScript
                        
                        // 递增计数器
                        root.message-counter += 1;
                        
                        // 示例1：使用默认图标（不传入 icon），带编号
                        NotificationManager.show(
                            NotificationType.Success, {
                            title: "Success",
                            message: "Hello, worlifidasdasdsdsa dsa ifidasdasdsa dsad! Nsdsa dsa ifidasdasdsa dsad! Nsdsa dsa ifidasdasdsa dsad! Nsdsa dsa ifidasdasdsa dsad! Nsdsa dsa ifidasdasdsa dsad! Nsa dsa ifidasdasdsa dsad! Notifidasdasdsa dsa d dsadadsdsadsada #" + root.message-counter,
                            duration: 3000 // 0 表示永久
                        });

                        // TODO: 自定义消息内部内容的示例
                        // 使用自定义组件渲染（type 参数会被忽略）
                        // NotificationManager.show(NotificationType.Info, {
                        //     message: "Hello, world!",
                        //     icon: "ui/assets/icons/error.svg",
                        //     duration: 5000,
                        //     component: CustomComponentType.ActionsNotify
                        // });
                        
                        // 示例2：使用自定义图标（传入 icon）
                        // NotificationManager.show(NotificationType.Success, {
                        //     message: "Custom icon!",
                        //     icon: "ui/assets/icons/error.svg"
                        // });
                        
                        // 示例3：便捷方法，使用默认图标
                        // NotificationManager.info({ message: "Info message" });
                        
                        // 示例4：便捷方法，使用自定义图标和持续时间
                        // NotificationManager.warn({ 
                        //     message: "Warning!", 
                        //     duration: 5000,
                        //     icon: "ui/assets/icons/custom.svg"
                        // });
                    }
                }
            }

            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Notification";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }
     
                FilledButton {
                    text: "Show Notification With Actions ";
    
                    clicked => {

                        root.message-counter += 1;
                        
                        // 使用 ActionsNotify 组件：带标题、消息和操作按钮
                        // tag 用于在 Rust 回调中区分不同业务场景
                        NotificationManager.show(
                            NotificationType.Info, {
                            title: "确认操作",
                            message: "这是个带有两个操作按钮的通知消息 #" + root.message-counter,
                            duration: 0, // 0 表示永久，需要用户手动关闭或点击按钮
                            component: CustomComponentType.ActionsNotify,
                            actions: ["取消", "确认"],
                            tag: "confirm-action"  // 在 Rust on_action_clicked 中使用此 tag 区分
                        });
                    }
                }
            }

            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Notification";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }
    
                FilledButton {
                    text: "Show Notification With Single Actions ";
    
                    clicked => {

                        root.message-counter += 1;
                        
                        // 使用 ActionsNotify 组件：带标题、消息和单个操作按钮
                        NotificationManager.show(
                            NotificationType.Info, {
                            title: "确认操作",
                            message: "这是一个带有操作按钮的通知消息 #" + root.message-counter,
                            duration: 0, // 0 表示永久，需要用户手动关闭或点击按钮
                            component: CustomComponentType.ActionsNotify,
                            actions: ["取消"],
                            tag: "single-action"
                        });
                    }
                }
            }

            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Notification";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }
    
                FilledButton {
                    text: "Show Notification Without Actions ";
    
                    clicked => {

                        root.message-counter += 1;
                        
                        // 使用 ActionsNotify 组件：带标题、消息和操作按钮
                        NotificationManager.show(
                            NotificationType.Info, {
                            title: "确认操作",
                            message: "这是一个不带有任何操作按钮的通知消息 #" + root.message-counter,
                            duration: 0, // 0 表示永久，需要用户手动关闭或点击按钮
                            component: CustomComponentType.ActionsNotify,
                            actions: []
                        });
                    }
                }
            }


            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Notification";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }

                FilledButton {
                    text: "Close All Notification";
    
                    clicked => {
                        NotificationManager.remove-all();
                    }
                }

                FilledButton {
                    text: "Clear Notification";
    
                    clicked => {
                        NotificationManager.clear();
                    }
                }
            }
        }
    }
}