import { MaterialText, FilledButton, Horizontal, Vertical } from "@material";
import { Route } from "../route/routeMap.slint";
import { ToastManager, ToastType, ToastOptions } from "../components/toast/toast_manager.slint";

export component Toast {
    callback navigate(Route);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Vertical {
            width: parent.width;
            vertical-stretch: 1;
            spacing: 16px;
            padding: 16px;

            // 标题
            Horizontal {
                width: parent.width;
                height: 50px;
                alignment: start;
                vertical-stretch: 0;
    
                MaterialText {
                    text: "Toast Example";
                    color: #c31010;
                    font_size: 26px;
                    font_weight: 600;
                    vertical_alignment: center;
                }
            }

            // Toast 类型示例
            Vertical {
                width: parent.width;
                spacing: 12px;

                MaterialText {
                    text: "Type Example";
                    font_size: 18px;
                    font_weight: 500;
                }

                Horizontal {
                    spacing: 8px;
                    width: parent.width;

                    FilledButton {
                        text: "Success";
                        clicked => {
                            ToastManager.success({ message: "Success!" });
                        }
                    }

                    FilledButton {
                        text: "Error";
                        clicked => {
                            ToastManager.error({ message: "Error!" });
                        }
                    }

                    FilledButton {
                        text: "Loading";
                        clicked => {
                            ToastManager.loading({ message: "Loading...", overlay: true, close-on-click: true });
                        }
                    }

                    FilledButton {
                        text: "Text";
                        clicked => {
                            ToastManager.info({ message: "This is a text message" });
                        }
                    }
                }
            }

            // 位置示例
            Vertical {
                width: parent.width;
                spacing: 12px;

                MaterialText {
                    text: "Position Example";
                    font_size: 18px;
                    font_weight: 500;
                }

                Horizontal {
                    spacing: 8px;
                    width: parent.width;

                    FilledButton {
                        text: "Top";
                        clicked => {
                            ToastManager.success({ message: "top", position: "top" });
                        }
                    }

                    FilledButton {
                        text: "Middle";
                        clicked => {
                            ToastManager.success({ message: "middle", position: "middle" });
                        }
                    }

                    FilledButton {
                        text: "Bottom";
                        clicked => {
                            ToastManager.success({ message: "bottom", position: "bottom" });
                        }
                    }
                }
            }

            // 功能示例
            Vertical {
                width: parent.width;
                spacing: 12px;

                MaterialText {
                    text: "Functions Example";
                    font_size: 18px;
                    font_weight: 500;
                }

                Horizontal {
                    spacing: 8px;
                    width: parent.width;

                    FilledButton {
                        text: "With Overlay";
                        clicked => {
                            ToastManager.success({ message: "OverlayOverlayOverlayOverlayOverlayOverlayOverlayOverlayOverlayOverlayOverlayOverlay", overlay: true, close-on-click: true });
                        }
                    }

                    FilledButton {
                        text: "Close on Click";
                        clicked => {
                            ToastManager.success({ message: "Close on Click", close-on-click: true });
                        }
                    }

                    FilledButton {
                        text: "Both";
                        clicked => {
                            ToastManager.success({ message: "Overlay + Close on Click", overlay: true, close-on-click: true });
                        }
                    }
                }
            }

            // 特殊示例
            Vertical {
                width: parent.width;
                spacing: 12px;

                MaterialText {
                    text: "Special Example";
                    font_size: 18px;
                    font_weight: 500;
                }

                Horizontal {
                    spacing: 8px;
                    width: parent.width;

                    FilledButton {
                        text: "Long Message";
                        clicked => {
                            ToastManager.info({ message: "This is a long messagedssdasdsdsadad sd sdasdasda sfaffdfds" });
                        }
                    }

                    FilledButton {
                        text: "Custom Duration";
                        clicked => {
                            ToastManager.success({ message: "Close after 5 seconds", duration: 5000 });
                        }
                    }

                    FilledButton {
                        text: "show method with type";
                        clicked => {
                            ToastManager.show(ToastType.Success, { message: "show method with type", position: "top" });
                        }
                    }
                }
            }

            // success\error\info\loading示例
            Vertical {
                width: parent.width;
                spacing: 12px;

                MaterialText {
                    text: "success、error、info、loading Example";
                    font_size: 18px;
                    font_weight: 500;
                }

                Horizontal {
                    spacing: 8px;
                    width: parent.width;

                    FilledButton {
                        text: "Success";
                        clicked => {
                            ToastManager.show(ToastType.Success, { message: "This is a long messagedssdasdsdsadad sd sdasdasda sfaffdfds" });
                        }
                    }

                    FilledButton {
                        text: "Error";
                        clicked => {
                            ToastManager.show(ToastType.Error, { message: "This is a long me11111ssagedssdasdsdsadad sd sdasdasda sfaffdfds" });
                        }
                    }
                }
            }            
        }
    }
}
