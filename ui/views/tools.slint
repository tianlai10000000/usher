import { MaterialText, FilledButton, Horizontal, Vertical, ElevatedCard, MaterialStyleMetrics, MaterialPalette } from "@material";
import { Route } from "../route/routeMap.slint";

export component Tools {
    callback navigate(Route);

    // Input property for available viewport height
    in property <length> viewport-height;

    // Dynamic data source for cards; replace with real data later.
    property <[string]> tool_labels: ["Tools1", "Tools2", "Tools3", "Tools4", "Tools5", "Tools6", "Tools7", "Tools8", "Tools9", "Tools10", "Tools11", "Tools12", "Tools13", "Tools14", "Tools15"];

    // Responsive columns based on width
    property <int> columns: root.width >= 1000px ? 5 :
        root.width >= 800px ? 4 :
        root.width >= 600px ? 3 :
        root.width >= 400px ? 2 :
        1;

    // Calculate number of rows needed
    property <int> rows: Math.ceil(tool_labels.length / columns);

    // Layout constants
    property <length> padding-size: MaterialStyleMetrics.padding_16;
    property <length> row-spacing: MaterialStyleMetrics.padding_8;
    property <length> col-spacing: MaterialStyleMetrics.padding_16;

    // Calculate available dimensions
    property <length> available-width: root.width - (padding-size * 2);
    // Only subtract bottom padding since top is flush with page
    property <length> available-height: viewport-height > 0px ? viewport-height - padding-size : root.width * 0.6;

    // Calculate card dimensions dynamically
    property <length> card-width: (available-width - ((columns - 1) * col-spacing)) / columns;
    property <length> card-height: (available-height - ((rows - 1) * row-spacing)) / rows;

    Rectangle {
        width: parent.width;
        height: parent.height;

        Vertical {
            width: parent.width;
            padding-left: MaterialStyleMetrics.padding_8;
            padding-right: 0;
            padding-top: 0;
            padding-bottom: 0;
            spacing: row-spacing;
            alignment: start;


            // Create rows dynamically
            for row_index in rows : Horizontal {
                spacing: col-spacing;
                alignment: start;

                // Calculate start and end indices for this row
                property <int> start_index: row_index * columns;
                property <int> end_index: Math.min(start_index + columns, tool_labels.length);
                property <int> cards_in_row: end_index - start_index;

                // Display cards for this row
                for col_index in cards_in_row : Rectangle {
                    width: card-width;
                    height: card-height;
                    
                    property <int> card_index: start_index + col_index;
                    property <string> card_label: tool_labels[card_index];

                    card := ElevatedCard {
                        width: 100%;
                        height: 100%;
                        clickable: true;

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border_radius: MaterialStyleMetrics.border_radius_12;
                            background: MaterialPalette.primary;
                            opacity: hover-area.has-hover ? 0.08 : 0;
                            animate opacity { duration: 120ms; }
                        }

                        VerticalLayout {
                            padding: MaterialStyleMetrics.padding_16;
                            alignment: center;

                            MaterialText {
                                text: card_label;
                                color: #c31010;
                                font_size: 26px;
                                font_weight: 600;
                                horizontal_alignment: center;
                            }
                        }
                    }

                    hover-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { card.clicked(); }
                    }
                }
            }
        }
    }
}