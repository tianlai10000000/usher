import { Route } from "../route/routeMap.slint";
import { GitHubButton } from "../components/settings/github_settings_controls.slint";
import { GitHubBlankslate } from "../components/github_blankslate.slint";
import { GitHubPageHeader } from "../components/page/github_page_header.slint";
import {
    GitHubProjectGridCard,
    GitHubProjectIconButton,
    GitHubProjectListRow,
    GitHubProjectSearchField,
    GitHubProjectViewSwitcher,
    ProjectItem
} from "../components/project/github_project_components.slint";
import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
export { ProjectItem } from "../components/project/github_project_components.slint";
// Project uses Primer's Card/List collection, medium controls, Labels and
// Dialog safe-area geometry. See docs/specs/ui-design.md.




// Primer's 32 px icon-only view controls, separated by the product-specified
// 8 px gap so the two view choices remain visually distinct.










export component GitHubProjectPage {
    callback navigate(Route);
    callback open-project(string, string, string, string, string, image, bool);
    callback open-terminal(string, string, string);
    callback add-project(string, string, string, string, string, string, bool);
    callback preview-logo(string);
    callback search-projects(string);
    callback reload-projects();

    in property <length> viewport-height;
    in property <length> viewport-width;
    in property <[ProjectItem]> projects: [];
    in-out property <bool> show-add-modal: false;
    in-out property <string> new-project-name: "";
    in-out property <string> new-project-alias: "";
    in-out property <string> new-project-local-repo: "";
    in-out property <string> new-project-remote-repo: "";
    in-out property <string> new-project-logo: "";
    in-out property <string> new-project-tags: "";
    in-out property <bool> new-project-pr-auto-update: false;
    in property <image> logo-preview-image: @image-url("../../logo.png");
    in property <string> logo-preview-status: "Using app default logo";
    in-out property <string> add-error: "";
    in-out property <string> modal-mode: "add";
    in-out property <string> modal-original-alias: "";
    in-out property <string> search-query: "";
    in-out property <string> view-mode: "grid";
    in property <bool> loading: false;
    in property <string> load-error: "";

    private property <length> available-width: max(320px, root.width - 32px);
    private property <length> content-width:
        min(GitHubMetrics.page-content-max-width, root.available-width);
    // Keep the content column on whole logical pixels so toolbar IconButtons
    // are not painted from a half-pixel origin after centering.
    private property <length> content-x:
        Math.floor(max(0px, (root.available-width - root.content-width) / 2) / 1px) * 1px;
    // Derive columns from the actual content width. A project card stays
    // readable before another column is introduced.
    private property <length> grid-card-min-width: 280px;
    private property <int> grid-columns:
        root.content-width >= root.grid-card-min-width * 4 + 48px ? 4
        : root.content-width >= root.grid-card-min-width * 3 + 32px ? 3
        : root.content-width >= root.grid-card-min-width * 2 + 16px ? 2
        : 1;
    private property <int> grid-rows: Math.ceil(root.projects.length / root.grid-columns);
    // Floor the divided card width. A fractional card width shifts the trailing
    // terminal/edit/delete cluster onto a half-pixel and FemtoVG blurs the SVGs.
    private property <length> grid-card-width:
        Math.floor(
            (root.content-width - ((root.grid-columns - 1) * 16px))
                / root.grid-columns
                / 1px
        ) * 1px;

    height: page-content.preferred-height;

    page-host := Rectangle {
        width: root.available-width;
        height: page-content.preferred-height;
        background: transparent;

        page-content := VerticalLayout {
            x: root.content-x;
            width: root.content-width;
            spacing: 16px;
            alignment: start;

            GitHubPageHeader {
                width: parent.width;
                title: "Projects";
                description: "Manage local repositories and open their delivery workflows.";
                leading-icon: @image-url("../assets/icons/octicon-repo-16.svg");
                actions-width: 120px;

                GitHubButton {
                    x: parent.width - self.width;
                    y: 0px;
                    text: "New project";
                    primary: true;
                    clicked => {
                        root.modal-mode = "add";
                        root.modal-original-alias = "";
                        root.new-project-name = "";
                        root.new-project-alias = "";
                        root.new-project-local-repo = "";
                        root.new-project-remote-repo = "";
                        root.new-project-logo = "";
                        root.new-project-tags = "";
                        root.new-project-pr-auto-update = false;
                        root.preview-logo("");
                        root.add-error = "";
                        root.show-add-modal = true;
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 48px;
                background: transparent;

                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: GitHubTheme.border-default;
                }

                GitHubProjectSearchField {
                    x: 0px;
                    y: 0px;
                    width: min(360px, parent.width - 136px);
                    text <=> root.search-query;
                    accepted(query) => { root.search-projects(query); }
                }

                GitHubProjectViewSwitcher {
                    x: Math.floor((parent.width - 120px) / 1px) * 1px;
                    y: 0px;
                    mode <=> root.view-mode;
                }

                GitHubProjectIconButton {
                    x: Math.floor((parent.width - 32px) / 1px) * 1px;
                    y: 0px;
                    icon: @image-url("../assets/icons/octicon-sync-16.svg");
                    tooltip: "Reload projects";
                    loading: root.loading;
                    // Trailing toolbar edge: grow the tip left so it is not clipped.
                    tooltip-end: true;
                    clicked => { root.reload-projects(); }
                }
            }

            list-box := Rectangle {
                width: parent.width;
                height: root.loading || root.load-error != "" || root.projects.length == 0
                    ? (root.search-query == "" ? 224px : 184px)
                    : root.view-mode == "list"
                        ? root.projects.length * 136px
                        : root.grid-rows * 220px - 16px;
                border-radius: 6px;
                border-width: root.loading || root.load-error != ""
                    || root.projects.length == 0 || root.view-mode == "list"
                        ? 1px : 0px;
                border-color: GitHubTheme.border-default;
                background: root.loading || root.load-error != ""
                    || root.projects.length == 0 || root.view-mode == "list"
                    ? (GitHubTheme.canvas-default)
                    : transparent;
                // Clip row hover fills inside the border so the Box edge stays visible.
                clip: root.loading || root.load-error != ""
                    || root.projects.length == 0 || root.view-mode == "list";

                if root.loading: GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: true;
                    loading: true;
                    heading: "Loading projects";
                    description: "Reading the local project registry.";
                }

                if !root.loading && root.load-error != "": GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: true;
                    error: true;
                    icon: @image-url("../assets/icons/octicon-alert-16.svg");
                    heading: "Projects could not be loaded";
                    description: root.load-error;
                    primary-label: "Try again";
                    primary-clicked => { root.reload-projects(); }
                }

                if !root.loading && root.load-error == "" && root.projects.length == 0: GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: root.search-query != "";
                    icon: root.search-query == ""
                        ? @image-url("../assets/icons/octicon-repo-16.svg")
                        : @image-url("../assets/icons/octicon-search-16.svg");
                    heading: root.search-query == "" ? "No projects yet" : "No matching projects";
                    description: root.search-query == ""
                        ? "Add a local Git repository to get started."
                        : "Try another project name or alias.";
                    primary-label: root.search-query == "" ? "New project" : "";
                    primary-clicked => {
                        root.modal-mode = "add";
                        root.modal-original-alias = "";
                        root.new-project-name = "";
                        root.new-project-alias = "";
                        root.new-project-local-repo = "";
                        root.new-project-remote-repo = "";
                        root.new-project-logo = "";
                        root.new-project-tags = "";
                        root.new-project-pr-auto-update = false;
                        root.preview-logo("");
                        root.add-error = "";
                        root.show-add-modal = true;
                    }
                }

                // Only mount the active representation. Keeping both the list
                // rows and grid cards alive made every window resize evaluate
                // two complete project trees even though one was never painted.
                for project[index] in (root.view-mode == "list" ? root.projects : []): GitHubProjectListRow {
                    y: index * 136px;
                    width: parent.width;
                    visible: root.view-mode == "list";
                    project: project;
                    first: index == 0;
                    open-requested => {
                        root.open-project(project.project_name, project.project_alias, project.local_repo, project.remote_repo, project.logo, project.logo_image, project.is_pr_auto_update);
                        root.navigate(Route.Workflow);
                    }
                    terminal-requested => {
                        root.open-terminal(project.project_name, project.project_alias, project.local_repo);
                    }
                    edit-requested => {
                        root.modal-mode = "edit";
                        root.modal-original-alias = project.project_alias;
                        root.new-project-name = project.project_name;
                        root.new-project-alias = project.project_alias;
                        root.new-project-local-repo = project.local_repo;
                        root.new-project-remote-repo = project.remote_repo;
                        root.new-project-logo = project.logo;
                        root.new-project-tags = project.project_tags_text;
                        root.new-project-pr-auto-update = project.is_pr_auto_update;
                        root.preview-logo(project.logo);
                        root.add-error = "";
                        root.show-add-modal = true;
                    }
                    delete-requested => {
                        root.modal-mode = "delete";
                        root.modal-original-alias = project.project_alias;
                        root.new-project-name = project.project_name;
                        root.new-project-alias = project.project_alias;
                        root.new-project-local-repo = project.local_repo;
                        root.new-project-remote-repo = project.remote_repo;
                        root.new-project-logo = project.logo;
                        root.new-project-tags = project.project_tags_text;
                        root.new-project-pr-auto-update = project.is_pr_auto_update;
                        root.add-error = "";
                        root.show-add-modal = true;
                    }
                }

                for row-index in (root.view-mode == "grid" ? root.grid-rows : 0): grid-row := HorizontalLayout {
                    y: row-index * 220px;
                    width: parent.width;
                    height: 204px;
                    spacing: 16px;
                    alignment: start;
                    visible: root.view-mode == "grid";

                    private property <int> start-index: row-index * root.grid-columns;
                    private property <int> end-index:
                        Math.min(self.start-index + root.grid-columns, root.projects.length);
                    private property <int> cards-in-row: self.end-index - self.start-index;

                    for column-index in self.cards-in-row: GitHubProjectGridCard {
                        width: root.grid-card-width;
                        project: root.projects[grid-row.start-index + column-index];
                        open-requested => {
                            root.open-project(self.project.project_name, self.project.project_alias, self.project.local_repo, self.project.remote_repo, self.project.logo, self.project.logo_image, self.project.is_pr_auto_update);
                            root.navigate(Route.Workflow);
                        }
                        terminal-requested => {
                            root.open-terminal(self.project.project_name, self.project.project_alias, self.project.local_repo);
                        }
                        edit-requested => {
                            root.modal-mode = "edit";
                            root.modal-original-alias = self.project.project_alias;
                            root.new-project-name = self.project.project_name;
                            root.new-project-alias = self.project.project_alias;
                            root.new-project-local-repo = self.project.local_repo;
                            root.new-project-remote-repo = self.project.remote_repo;
                            root.new-project-logo = self.project.logo;
                            root.new-project-tags = self.project.project_tags_text;
                            root.new-project-pr-auto-update = self.project.is_pr_auto_update;
                            root.preview-logo(self.project.logo);
                            root.add-error = "";
                            root.show-add-modal = true;
                        }
                        delete-requested => {
                            root.modal-mode = "delete";
                            root.modal-original-alias = self.project.project_alias;
                            root.new-project-name = self.project.project_name;
                            root.new-project-alias = self.project.project_alias;
                            root.new-project-local-repo = self.project.local_repo;
                            root.new-project-remote-repo = self.project.remote_repo;
                            root.new-project-logo = self.project.logo;
                            root.new-project-tags = self.project.project_tags_text;
                            root.new-project-pr-auto-update = self.project.is_pr_auto_update;
                            root.add-error = "";
                            root.show-add-modal = true;
                        }
                    }
                }
            }
        }
    }
}
