import { Route } from "../route/routeMap.slint";
import { GitHubButton } from "../components/settings/github_settings_controls.slint";
import { GitHubBlankslate } from "../components/github_blankslate.slint";
import { GitHubPageHeader } from "../components/page/github_page_header.slint";
import { I18n } from "@i18n";
import { ProjectBridge } from "../features/project/bridge.slint";
import {
    GitHubProjectGridCard,
    GitHubProjectIconButton,
    GitHubProjectListRow,
    GitHubProjectSearchField,
    GitHubProjectViewSwitcher
} from "../components/project/github_project_components.slint";
import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
// Project uses Primer's Card/List collection, medium controls, Labels and
// Dialog safe-area geometry. See docs/specs/ui-design.md.




// Primer's 32 px icon-only view controls, separated by the product-specified
// 8 px gap so the two view choices remain visually distinct.










export component GitHubProjectPage {
    callback navigate(Route);
    callback open-project(string, string, string, string, string, image, bool);

    in property <length> viewport-height;
    in property <length> viewport-width;


    private property <length> available-width: max(320px, root.width - 32px);
    private property <length> content-width:
        min(GitHubMetrics.page-content-max-width, root.available-width);
    // Keep the content column on whole logical pixels so toolbar IconButtons
    // are not painted from a half-pixel origin after centering.
    private property <length> content-x:
        Math.floor(max(0px, (root.available-width - root.content-width) / 2) / 1px) * 1px;
    // Derive columns from the actual content width. A project card stays
    // readable before another column is introduced.
    private property <length> grid-card-min-width: 280px;
    private property <int> grid-columns:
        root.content-width >= root.grid-card-min-width * 4 + 48px ? 4
        : root.content-width >= root.grid-card-min-width * 3 + 32px ? 3
        : root.content-width >= root.grid-card-min-width * 2 + 16px ? 2
        : 1;
    private property <int> grid-rows: Math.ceil(ProjectBridge.items.length / root.grid-columns);
    // Floor the divided card width. A fractional card width shifts the trailing
    // terminal/edit/delete cluster onto a half-pixel and FemtoVG blurs the SVGs.
    private property <length> grid-card-width:
        Math.floor(
            (root.content-width - ((root.grid-columns - 1) * 16px))
                / root.grid-columns
                / 1px
        ) * 1px;

    height: page-content.preferred-height;

    page-host := Rectangle {
        width: root.available-width;
        height: page-content.preferred-height;
        background: transparent;

        page-content := VerticalLayout {
            x: root.content-x;
            width: root.content-width;
            spacing: 16px;
            alignment: start;

            GitHubPageHeader {
                width: parent.width;
                title: I18n.common-projects;
                description: I18n.projects-description;
                leading-icon: @image-url("../assets/icons/octicon-repo-16.svg");
                actions-width: 120px;

                GitHubButton {
                    x: parent.width - self.width;
                    y: 0px;
                    text: I18n.projects-new-project;
                    primary: true;
                    clicked => {
                        ProjectBridge.modal-mode = "add";
                        ProjectBridge.prepare-hooks("");
                        ProjectBridge.modal-original-alias = "";
                        ProjectBridge.new-name = "";
                        ProjectBridge.new-alias = "";
                        ProjectBridge.new-local-repo = "";
                        ProjectBridge.new-remote-repo = "";
                        ProjectBridge.new-logo = "";
                        ProjectBridge.new-tags = "";
                        ProjectBridge.new-pr-auto-update = false;
                        ProjectBridge.preview-logo("");
                        ProjectBridge.add-error = "";
                        ProjectBridge.show-add-modal = true;
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 48px;
                background: transparent;

                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: GitHubTheme.border-default;
                }

                GitHubProjectSearchField {
                    x: 0px;
                    y: 0px;
                    width: min(360px, parent.width - 136px);
                    text <=> ProjectBridge.search-query;
                    accepted(query) => { ProjectBridge.search-projects(query); }
                }

                GitHubProjectViewSwitcher {
                    x: Math.floor((parent.width - 112px) / 1px) * 1px;
                    y: 0px;
                    mode <=> ProjectBridge.view-mode;
                }

                GitHubProjectIconButton {
                    x: Math.floor((parent.width - 32px) / 1px) * 1px;
                    y: 0px;
                    icon: @image-url("../assets/icons/octicon-sync-16.svg");
                    tooltip: I18n.tooltip-reload-projects;
                    loading: ProjectBridge.list-loading;
                    // Trailing toolbar edge: grow the tip left so it is not clipped.
                    tooltip-end: true;
                    clicked => { ProjectBridge.reload-projects(); }
                }
            }

            list-box := Rectangle {
                width: parent.width;
                height: ProjectBridge.list-loading || ProjectBridge.list-error != "" || ProjectBridge.items.length == 0
                    ? (ProjectBridge.search-query == "" ? 224px : 184px)
                    : ProjectBridge.view-mode == "list"
                        ? ProjectBridge.items.length * 136px
                        : root.grid-rows * 220px - 16px;
                border-radius: 6px;
                border-width: ProjectBridge.list-loading || ProjectBridge.list-error != ""
                    || ProjectBridge.items.length == 0 || ProjectBridge.view-mode == "list"
                        ? 1px : 0px;
                border-color: GitHubTheme.border-default;
                background: ProjectBridge.list-loading || ProjectBridge.list-error != ""
                    || ProjectBridge.items.length == 0 || ProjectBridge.view-mode == "list"
                    ? (GitHubTheme.canvas-default)
                    : transparent;
                // Clip row hover fills inside the border so the Box edge stays visible.
                clip: ProjectBridge.list-loading || ProjectBridge.list-error != ""
                    || ProjectBridge.items.length == 0 || ProjectBridge.view-mode == "list";

                if ProjectBridge.list-loading: GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: true;
                    loading: true;
                    heading: I18n.projects-loading;
                    description: I18n.projects-loading-registry;
                }

                if !ProjectBridge.list-loading && ProjectBridge.list-error != "": GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: true;
                    error: true;
                    icon: @image-url("../assets/icons/octicon-alert-16.svg");
                    heading: I18n.projects-load-failed;
                    description: ProjectBridge.list-error;
                    primary-label: I18n.common-try-again;
                    primary-clicked => { ProjectBridge.reload-projects(); }
                }

                if !ProjectBridge.list-loading && ProjectBridge.list-error == "" && ProjectBridge.items.length == 0: GitHubBlankslate {
                    width: parent.width;
                    height: parent.height;
                    narrow: ProjectBridge.search-query != "";
                    icon: ProjectBridge.search-query == ""
                        ? @image-url("../assets/icons/octicon-repo-16.svg")
                        : @image-url("../assets/icons/octicon-search-16.svg");
                    heading: ProjectBridge.search-query == "" ? I18n.projects-none : I18n.projects-no-matches;
                    description: ProjectBridge.search-query == ""
                        ? I18n.projects-add-repository-to-start
                        : I18n.projects-try-another;
                    primary-label: ProjectBridge.search-query == "" ? I18n.projects-new-project : "";
                    primary-clicked => {
                        ProjectBridge.modal-mode = "add";
                        ProjectBridge.prepare-hooks("");
                        ProjectBridge.modal-original-alias = "";
                        ProjectBridge.new-name = "";
                        ProjectBridge.new-alias = "";
                        ProjectBridge.new-local-repo = "";
                        ProjectBridge.new-remote-repo = "";
                        ProjectBridge.new-logo = "";
                        ProjectBridge.new-tags = "";
                        ProjectBridge.new-pr-auto-update = false;
                        ProjectBridge.preview-logo("");
                        ProjectBridge.add-error = "";
                        ProjectBridge.show-add-modal = true;
                    }
                }

                // Only mount the active representation. Keeping both the list
                // rows and grid cards alive made every window resize evaluate
                // two complete project trees even though one was never painted.
                for project[index] in (ProjectBridge.view-mode == "list" ? ProjectBridge.items : []): GitHubProjectListRow {
                    y: index * 136px;
                    width: parent.width;
                    visible: ProjectBridge.view-mode == "list";
                    project: project;
                    first: index == 0;
                    open-requested => {
                        root.open-project(project.project_name, project.project_alias, project.local_repo, project.remote_repo, project.logo, project.logo_image, project.is_pr_auto_update);
                    }
                    terminal-requested => {
                        ProjectBridge.open-terminal(project.project_name, project.project_alias, project.local_repo);
                    }
                    edit-requested => {
                        ProjectBridge.modal-mode = "edit";
                        ProjectBridge.prepare-hooks(project.project_alias);
                        ProjectBridge.modal-original-alias = project.project_alias;
                        ProjectBridge.new-name = project.project_name;
                        ProjectBridge.new-alias = project.project_alias;
                        ProjectBridge.new-local-repo = project.local_repo;
                        ProjectBridge.new-remote-repo = project.remote_repo;
                        ProjectBridge.new-logo = project.logo;
                        ProjectBridge.new-tags = project.project_tags_text;
                        ProjectBridge.new-pr-auto-update = project.is_pr_auto_update;
                        ProjectBridge.preview-logo(project.logo);
                        ProjectBridge.add-error = "";
                        ProjectBridge.show-add-modal = true;
                    }
                    delete-requested => {
                        ProjectBridge.modal-mode = "delete";
                        ProjectBridge.modal-original-alias = project.project_alias;
                        ProjectBridge.new-name = project.project_name;
                        ProjectBridge.new-alias = project.project_alias;
                        ProjectBridge.new-local-repo = project.local_repo;
                        ProjectBridge.new-remote-repo = project.remote_repo;
                        ProjectBridge.new-logo = project.logo;
                        ProjectBridge.new-tags = project.project_tags_text;
                        ProjectBridge.new-pr-auto-update = project.is_pr_auto_update;
                        ProjectBridge.add-error = "";
                        ProjectBridge.show-add-modal = true;
                    }
                }

                for row-index in (ProjectBridge.view-mode == "grid" ? root.grid-rows : 0): grid-row := HorizontalLayout {
                    y: row-index * 220px;
                    width: parent.width;
                    height: 204px;
                    spacing: 16px;
                    alignment: start;
                    visible: ProjectBridge.view-mode == "grid";

                    private property <int> start-index: row-index * root.grid-columns;
                    private property <int> end-index:
                        Math.min(self.start-index + root.grid-columns, ProjectBridge.items.length);
                    private property <int> cards-in-row: self.end-index - self.start-index;

                    for column-index in self.cards-in-row: GitHubProjectGridCard {
                        width: root.grid-card-width;
                        project: ProjectBridge.items[grid-row.start-index + column-index];
                        open-requested => {
                            root.open-project(self.project.project_name, self.project.project_alias, self.project.local_repo, self.project.remote_repo, self.project.logo, self.project.logo_image, self.project.is_pr_auto_update);
                        }
                        terminal-requested => {
                            ProjectBridge.open-terminal(self.project.project_name, self.project.project_alias, self.project.local_repo);
                        }
                        edit-requested => {
                            ProjectBridge.modal-mode = "edit";
                            ProjectBridge.prepare-hooks(self.project.project_alias);
                            ProjectBridge.modal-original-alias = self.project.project_alias;
                            ProjectBridge.new-name = self.project.project_name;
                            ProjectBridge.new-alias = self.project.project_alias;
                            ProjectBridge.new-local-repo = self.project.local_repo;
                            ProjectBridge.new-remote-repo = self.project.remote_repo;
                            ProjectBridge.new-logo = self.project.logo;
                            ProjectBridge.new-tags = self.project.project_tags_text;
                            ProjectBridge.new-pr-auto-update = self.project.is_pr_auto_update;
                            ProjectBridge.preview-logo(self.project.logo);
                            ProjectBridge.add-error = "";
                            ProjectBridge.show-add-modal = true;
                        }
                        delete-requested => {
                            ProjectBridge.modal-mode = "delete";
                            ProjectBridge.modal-original-alias = self.project.project_alias;
                            ProjectBridge.new-name = self.project.project_name;
                            ProjectBridge.new-alias = self.project.project_alias;
                            ProjectBridge.new-local-repo = self.project.local_repo;
                            ProjectBridge.new-remote-repo = self.project.remote_repo;
                            ProjectBridge.new-logo = self.project.logo;
                            ProjectBridge.new-tags = self.project.project_tags_text;
                            ProjectBridge.new-pr-auto-update = self.project.is_pr_auto_update;
                            ProjectBridge.add-error = "";
                            ProjectBridge.show-add-modal = true;
                        }
                    }
                }
            }
        }
    }
}
