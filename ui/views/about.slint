import { AppState } from "../state/app_state.slint";
import { PageView } from "../components/page/page_view.slint";

component AboutDetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> last: false;

    width: 100%;
    height: 48px;
    background: transparent;

    Text {
        x: 16px;
        width: 112px;
        height: parent.height;
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        vertical-alignment: center;
    }

    Text {
        x: 136px;
        width: parent.width - 152px;
        height: parent.height;
        text: root.value;
        font-size: 14px;
        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
        vertical-alignment: center;
        overflow: elide;
    }

    if !root.last: Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    }
}

export component About inherits PageView {
    private property <length> available-width: max(320px, root.width - 32px);
    private property <length> content-width: min(896px, root.available-width);

    about-host := Rectangle {
        width: root.available-width;
        height: about-content.preferred-height;
        background: transparent;

        about-content := VerticalLayout {
            x: max(0px, (parent.width - root.content-width) / 2);
            width: root.content-width;
            spacing: 24px;
            alignment: start;

            Text {
                width: parent.width;
                text: "About";
                font-size: 24px;
                font-weight: 600;
                color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            }

            HorizontalLayout {
                width: parent.width;
                spacing: 16px;
                alignment: start;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
                    background: AppState.effective-dark-mode ? #21262d : #f6f8fa;
                    clip: true;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 48px;
                        height: 48px;
                        source: @image-url("../../logo.png");
                    }
                }

                VerticalLayout {
                    width: root.content-width - 80px;
                    spacing: 6px;
                    alignment: start;

                    HorizontalLayout {
                        width: parent.width;
                        height: 30px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "Usher";
                            font-size: 24px;
                            font-weight: 600;
                            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: version-text.preferred-width + 16px;
                            height: 20px;
                            y: 5px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
                            background: transparent;

                            version-text := Text {
                                width: parent.width;
                                height: parent.height;
                                text: "v" + AppState.version;
                                font-size: 12px;
                                font-weight: 500;
                                color: AppState.effective-dark-mode ? #9198a1 : #59636e;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        width: parent.width;
                        text: "A desktop workspace for local Git projects and repeatable delivery workflows.";
                        font-size: 14px;
                        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "About Usher";
                    font-size: 20px;
                    font-weight: 600;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }

                Text {
                    width: parent.width;
                    text: "Usher brings project metadata, pull request summaries, guided Git workflows, an embedded terminal, update management, and desktop notifications into one focused application.";
                    font-size: 14px;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Application information";
                    font-size: 16px;
                    font-weight: 600;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }

                Rectangle {
                    width: parent.width;
                    height: 144px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
                    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        AboutDetailRow {
                            label: "Author";
                            value: "yuankai";
                        }
                        AboutDetailRow {
                            label: "Contact";
                            value: "tianlai10000000@gmail.com";
                        }
                        AboutDetailRow {
                            label: "License";
                            value: "Proprietary (non-open-source)";
                            last: true;
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 52px;
                border-radius: 6px;
                border-width: 1px;
                border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
                background: AppState.effective-dark-mode ? #151b23 : #f6f8fa;

                Image {
                    x: 16px;
                    y: 18px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../assets/icons/octicon-info-16.svg");
                    colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                }
                Text {
                    x: 44px;
                    width: parent.width - 60px;
                    height: parent.height;
                    text: "Usher is under active development.";
                    font-size: 14px;
                    color: AppState.effective-dark-mode ? #9198a1 : #59636e;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
