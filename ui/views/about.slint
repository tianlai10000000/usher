import { AppState } from "../state/app_state.slint";
import { GitHubPageView } from "../components/page/page_view.slint";
import { GitHubTheme } from "../theme/github_theme.slint";
import { I18n } from "@i18n";



import { GitHubAboutDetailRow } from "../components/about/github_about_components.slint";
export component GitHubAboutPage inherits GitHubPageView {
    private property <length> available-width: max(320px, root.width - 32px);
    private property <length> content-width: min(896px, root.available-width);

    about-host := Rectangle {
        width: root.available-width;
        height: about-content.preferred-height;
        background: transparent;

        about-content := VerticalLayout {
            x: max(0px, (parent.width - root.content-width) / 2);
            width: root.content-width;
            spacing: 24px;
            alignment: start;

            Text {
                width: parent.width;
                text: I18n.common-about;
                font-size: 24px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
            }

            HorizontalLayout {
                width: parent.width;
                spacing: 16px;
                alignment: start;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: GitHubTheme.border-default;
                    background: GitHubTheme.control-default-rest;
                    clip: true;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 48px;
                        height: 48px;
                        source: @image-url("../../logo.png");
                    }
                }

                VerticalLayout {
                    width: root.content-width - 80px;
                    spacing: 6px;
                    alignment: start;

                    HorizontalLayout {
                        width: parent.width;
                        height: 30px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "Usher";
                            font-size: 24px;
                            font-weight: 600;
                            color: GitHubTheme.fg-default;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: version-text.preferred-width + 16px;
                            height: 20px;
                            y: 5px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: GitHubTheme.border-default;
                            background: transparent;

                            version-text := Text {
                                width: parent.width;
                                height: parent.height;
                                text: "v" + AppState.version;
                                font-size: 12px;
                                font-weight: 500;
                                color: GitHubTheme.fg-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        width: parent.width;
                        text: I18n.about-tagline;
                        font-size: 14px;
                        color: GitHubTheme.fg-muted;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.navigation-about-usher;
                    font-size: 20px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                Text {
                    width: parent.width;
                    text: I18n.about-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-default;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.about-application-information;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                Rectangle {
                    width: parent.width;
                    height: 144px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: GitHubTheme.border-default;
                    background: GitHubTheme.canvas-default;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        GitHubAboutDetailRow {
                            label: I18n.common-author;
                            value: "yuankai";
                        }
                        GitHubAboutDetailRow {
                            label: I18n.common-contact;
                            value: "tianlai10000000@gmail.com";
                        }
                        GitHubAboutDetailRow {
                            label: I18n.common-license;
                            value: I18n.about-license-proprietary;
                            last: true;
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 52px;
                border-radius: 6px;
                border-width: 1px;
                border-color: GitHubTheme.border-default;
                background: GitHubTheme.canvas-subtle;

                Image {
                    x: 16px;
                    y: 18px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../assets/icons/octicon-info-16.svg");
                    colorize: GitHubTheme.fg-muted;
                }
                Text {
                    x: 44px;
                    width: parent.width - 60px;
                    height: parent.height;
                    text: I18n.about-development-notice;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
