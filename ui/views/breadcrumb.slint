import { Route } from "../route/routeMap.slint";
import { AppState } from "../state/app_state.slint";
import { GitHubTooltip } from "../components/github_tooltip.slint";

// Primer Breadcrumbs "normal" variant:
// 14 px link text, accent-colored ancestors, default-colored current page,
// hover underline, and the official compact slanted divider geometry.
component BreadcrumbItem {
    in property <image> icon;
    in property <string> text;
    in property <bool> is-current: false;
    in property <bool> clickable: true;

    callback clicked();

    private property <color> default-foreground: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    private property <color> link-foreground: AppState.effective-dark-mode ? #4493f8 : #0969da;
    private property <bool> has-icon: icon.width > 0 && icon.height > 0;
    private property <length> label-x: root.has-icon ? 22px : 0px;

    width: root.label-x + item-label.preferred-width;
    height: 32px;

    if root.has-icon: Image {
        x: 0px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.is-current ? root.default-foreground : root.link-foreground;
    }

    item-label := Text {
        x: root.label-x;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: 400;
        color: root.is-current ? root.default-foreground : root.link-foreground;
        vertical-alignment: center;
    }

    // Slint Text has no text-decoration property, so draw Primer's link
    // underline only beneath the glyph run.
    if item-touch.has-hover && root.clickable && !root.is-current: Rectangle {
        x: root.label-x;
        y: 24px;
        width: item-label.width;
        height: 1px;
        background: root.link-foreground;
    }

    item-touch := TouchArea {
        mouse-cursor: root.clickable && !root.is-current ? pointer : default;

        clicked => {
            if root.clickable && !root.is-current {
                root.clicked();
            }
        }
    }
}

component BreadcrumbSeparator {
    width: 15px;
    height: 32px;

    // Primer React uses a 0.8 em line rotated 15 degrees with 0.5 em inline
    // margins. At the 14 px body size that maps to an 11 px divider.
    Rectangle {
        x: 7px;
        y: 10px;
        width: 1px;
        height: 11px;
        background: AppState.effective-dark-mode ? #9198a1 : #59636e;
        transform-rotation: 15deg;
        transform-origin: { x: 0.5px, y: 5.5px };
    }
}

// PageHeader trailing action: an invisible Primer IconButton with the standard
// 32 px control size, 6 px radius, and semantic transparent hover/press fills.
component BreadcrumbBackButton inherits Rectangle {
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: back-touch.pressed
        ? (AppState.effective-dark-mode ? #6e768166 : #818b9833)
        : (back-touch.has-hover
            ? (AppState.effective-dark-mode ? #6e768133 : #818b981f)
            : transparent);
    clip: false;

    Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/icons/octicon-arrow-left-16.svg");
        colorize: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    }

    back-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if back-touch.has-hover: GitHubTooltip {
        z: 100;
        x: -4px;
        y: root.height + 4px;
        text: "Back";
    }
}

export component Breadcrumb inherits Rectangle {
    in property <Route> current-route: Route.Home;
    in property <Route> previous-route: Route.Home;

    callback navigate(Route);
    callback back();

    private property <bool> is-about-page: current-route == Route.About;
    private property <bool> is-detail-page: current-route == Route.Detail;
    private property <bool> is-settings-page: current-route == Route.Settings;
    private property <bool> is-home: current-route == Route.Home;
    private property <bool> can-go-back: !is-home && previous-route != current-route;

    height: 40px;
    // Alpha ≈ 0.35 on fill only (not root.opacity) so crumb text stays opaque.
    // Real translucency needs page content scrolling underneath this bar.
    background: AppState.effective-dark-mode ? #0d1117df : #ffffffdf;
    clip: false;
    drop-shadow-blur: 5px;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: AppState.effective-dark-mode ? #0000002a : #1f232814;

    // Slint rectangles do not capture pointer input. Without this shield,
    // clicks fall through the translucent bar onto scrolled page controls
    // (e.g. Project "New project" under the overlay). Later crumb/back
    // TouchAreas still win hit-testing on their own geometry.
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: default;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        // The page ScrollView contributes a 4 px outer gutter before each
        // page's 24 px content inset. Add the same offset so breadcrumbs and
        // page headings share one left edge.
        padding-left: 20px;
        padding-right: 16px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        breadcrumb-region := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            background: transparent;
            clip: true;

            HorizontalLayout {
                x: 0px;
                width: self.preferred-width;
                height: parent.height;
                alignment: start;
                spacing: 0px;

                BreadcrumbItem {
                    icon: @image-url("../assets/icons/home.svg");
                    text: "Home";
                    is-current: root.is-home;
                    clickable: !root.is-home;
                    clicked => { root.navigate(Route.Home); }
                }

                if root.is-about-page: BreadcrumbSeparator {}
                if root.is-about-page: BreadcrumbItem {
                    icon: @image-url("../assets/icons/about.svg");
                    text: "About";
                    is-current: true;
                }

                if root.is-settings-page: BreadcrumbSeparator {}
                if root.is-settings-page: BreadcrumbItem {
                    icon: @image-url("../assets/icons/settings.svg");
                    text: "Settings";
                    is-current: true;
                }

                if root.is-detail-page: BreadcrumbSeparator {}
                if root.is-detail-page: BreadcrumbItem {
                    icon: @image-url("../assets/icons/list.svg");
                    text: "List";
                    clicked => { root.navigate(Route.List); }
                }
                if root.is-detail-page: BreadcrumbSeparator {}
                if root.is-detail-page: BreadcrumbItem {
                    icon: @image-url("../assets/icons/detail.svg");
                    text: "Detail";
                    is-current: true;
                }

                if root.current-route == Route.Search: BreadcrumbSeparator {}
                if root.current-route == Route.Search: BreadcrumbItem {
                    icon: @image-url("../assets/icons/search.svg");
                    text: "Search";
                    is-current: true;
                }

                if root.current-route == Route.Notification: BreadcrumbSeparator {}
                if root.current-route == Route.Notification: BreadcrumbItem {
                    icon: @image-url("../assets/icons/settings.svg");
                    text: "Notify";
                    is-current: true;
                }

                if root.current-route == Route.Toast: BreadcrumbSeparator {}
                if root.current-route == Route.Toast: BreadcrumbItem {
                    icon: @image-url("../assets/icons/info.svg");
                    text: "Toast";
                    is-current: true;
                }

                if root.current-route == Route.Dialog: BreadcrumbSeparator {}
                if root.current-route == Route.Dialog: BreadcrumbItem {
                    icon: @image-url("../assets/icons/chat.svg");
                    text: "Dialog";
                    is-current: true;
                }

                if root.current-route == Route.Tools: BreadcrumbSeparator {}
                if root.current-route == Route.Tools: BreadcrumbItem {
                    icon: @image-url("../assets/icons/tools.svg");
                    text: "Tools";
                    is-current: true;
                }

                if root.current-route == Route.Project: BreadcrumbSeparator {}
                if root.current-route == Route.Project: BreadcrumbItem {
                    icon: @image-url("../assets/icons/project.svg");
                    text: "Projects";
                    is-current: true;
                }

                if root.current-route == Route.Workflow: BreadcrumbSeparator {}
                if root.current-route == Route.Workflow: BreadcrumbItem {
                    icon: @image-url("../assets/icons/project.svg");
                    text: "Projects";
                    clicked => { root.navigate(Route.Project); }
                }
                if root.current-route == Route.Workflow: BreadcrumbSeparator {}
                if root.current-route == Route.Workflow: BreadcrumbItem {
                    icon: @image-url("../assets/icons/commit.svg");
                    text: "Workflow";
                    is-current: true;
                }

                if root.current-route == Route.Chat: BreadcrumbSeparator {}
                if root.current-route == Route.Chat: BreadcrumbItem {
                    icon: @image-url("../assets/icons/chat.svg");
                    text: "Chat";
                    is-current: true;
                }

                if root.current-route == Route.List: BreadcrumbSeparator {}
                if root.current-route == Route.List: BreadcrumbItem {
                    icon: @image-url("../assets/icons/list.svg");
                    text: "List";
                    is-current: true;
                }
            }
        }

        if root.can-go-back: BreadcrumbBackButton {
            clicked => { root.back(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    }
}
