import { MaterialText, Vertical, OutlineButton, Horizontal, RadioButtonTile, FilterChip, TonalIconButton, TonalButton, Switch } from "@material";
import { AppState } from "../state/app_state.slint";
import { UpdateLogic } from "../components/update/update.slint";
import { NotificationManager } from "../components/notify/notification.slint";
import { LoadingIconOutlineButton } from "../components/button/loading_icon_outline_button.slint";

export component Settings {
    callback check-update();
    
    Vertical {
        padding: 0px;
        spacing: 0px;
        
        Horizontal {
            height: 64px;
            horizontal-stretch: 1;

            // Label
            MaterialText {
                text: "Theme";
                vertical_alignment: center;
                font-size: 16px;
                font-weight: 400;
            }

            Horizontal {
                alignment: start;
                spacing: 0px;

                RadioButtonTile {
                    text: "Light";
                    checked: AppState.theme_mode == 0;
        
                    radio_button_clicked => {
                        AppState.toggle-theme(0);
                    }
                }
        
                RadioButtonTile {
                    text: "Dark";
                    checked: AppState.theme_mode == 1;
        
                    radio_button_clicked => {
                        AppState.toggle-theme(1);
                    }
                }

                RadioButtonTile {
                    text: "Auto";
                    checked: AppState.theme_mode == 2;
        
                    radio_button_clicked => {
                        AppState.toggle-theme(2);
                    }
                }
            }
        }

        Horizontal {
            height: 50px;
            alignment: start;

            // Label
            MaterialText {
                text: "Current Version";
                vertical_alignment: center;
                font-size: 16px;
                font-weight: 400;
            }

            // current version
            MaterialText {
                text: "v" + AppState.version;
                vertical_alignment: center;
                font-size: 14px;
                font-weight: 400;
            }

            LoadingIconOutlineButton {
                loading: UpdateLogic.checking-update;
                text: "Check for Updates";
                clicked => {
                    UpdateLogic.checking-update = true;
                    root.check-update();
                }
            }
        }

        Horizontal {
            height: 46px;
            alignment: start;
            vertical-stretch: 0;

            // Label
            MaterialText {
                text: "Auto Update";
                vertical_alignment: center;
                font-size: 16px;
                font-weight: 400;
            }

            Switch {
                checked: AppState.auto-update;
                width: 48px;
                height: 28px;
                checked_state_changed(checked) => {
                    AppState.auto-update = checked;
                    AppState.toggle-auto-update(checked);
                }
            }
        }
    }
}