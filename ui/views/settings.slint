import { AppState, LanguageOption } from "../state/app_state.slint";
export { AppState, LanguageOption } from "../state/app_state.slint";
import { I18n } from "@i18n";
import { GitHubScrollView } from "../components/github_scroll_view.slint";
import { GitHubTheme } from "../theme/github_theme.slint";
import { GitHubTooltipOverlayHost } from "../components/github_tooltip_overlay.slint";
import {
    GitHubSettingsNavItem,
    GitHubSettingsSectionMenuButton
} from "../components/settings/github_settings_controls.slint";
import { GitHubSettingsPane } from "../components/settings/github_settings_layout.slint";
import { AiReviewRuleItem } from "@ai-review-settings";
export { AiReviewRuleItem } from "@ai-review-settings";

export component GitHubSettingsPage inherits Rectangle {
    // ComponentContainer clips an external tree but does not rewrite these
    // public geometry properties. The Rust bridge keeps them synchronized with
    // the host viewport so responsive layout and scrolling use the real size.
    in-out property <length> viewport-width: 800px;
    in-out property <length> viewport-height: 768px;
    width: root.viewport-width;
    height: root.viewport-height;
    background: GitHubTheme.canvas-default;
    callback check-update();
    callback simulate-crash();
    callback open-log-directory();
    callback export-diagnostics();

    in-out property <bool> simulate-crash-active: false;
    in-out property <bool> reveal-git-tokens: false;
    in-out property <bool> git-tokens-saved: false;
    in-out property <bool> git-hosting-config-saved: false;
    in-out property <bool> reveal-ai-agent-api-key: false;
    in-out property <bool> ai-agent-saved: false;
    in-out property <bool> ai-agent-testing: false;
    in-out property <bool> update-checking: false;
    in property <[AiReviewRuleItem]> ai-review-rules: [];
    in property <int> ai-review-max-concurrent-tasks: 3;
    in-out property <bool> ai-review-rule-add-pending: false;
    in-out property <string> ai-review-rule-name-error: "";
    in-out property <string> ai-review-rule-path-error: "";
    callback ai-review-set-max-concurrent-tasks(int);
    callback ai-review-add-rule(string, string);
    callback ai-review-delete-rule(string);
    callback ai-review-set-default-rule(string);

    // ComponentFactory pages are destroyed with their route. Start each new
    // tree from a sentinel and select the defaults on the next UI tick so
    // Slint 1.17.1 cannot reuse a stale tab binding from the previous tree.
    private property <int> selected-section: -1;
    private property <int> hosting-config-tab: -1;
    private property <bool> initial-tab-sync-pending: true;
    private property <bool> compact-navigation-open: false;
    private property <int> compact-navigation-selection: -1;
    private property <length> page-gutter: root.width >= 1000px ? 48px : 16px;
    private property <length> available-width: max(0px, root.width - root.page-gutter * 2);
    private property <length> page-width: min(1120px, root.available-width);
    private property <bool> compact-layout: root.page-width < 768px;
    private property <length> nav-width: 180px;
    private property <length> nav-content-gap: 32px;

    initial-tab-sync := Timer {
        interval: 1ms;
        running: root.initial-tab-sync-pending;
        triggered => {
            root.selected-section = 0;
            root.hosting-config-tab = 0;
            root.initial-tab-sync-pending = false;
        }
    }

    settings-scroll := GitHubScrollView {
        width: root.width;
        height: root.height;
        viewport_x: 0px;

        content-host := Rectangle {
            width: settings-scroll.visible_width;
            // Keep the 16px top inset plus a deliberate 24px end margin. This
            // is vertical breathing room below the final setting, not a
            // horizontal-scroll gutter.
            height: max(settings-scroll.visible_height, page-column.preferred-height + 40px);
            background: GitHubTheme.canvas-default;

                    page-column := VerticalLayout {
                        x: root.page-gutter
                            + max(0px, (root.available-width - root.page-width) / 2);
                        y: 16px;
                        width: root.page-width;
                        spacing: 24px;
                        alignment: start;

                        Text {
                            width: parent.width;
                            text: I18n.settings-title;
                            font-size: 24px;
                            font-weight: 600;
                            color: GitHubTheme.fg-default;
                        }

                        if !root.compact-layout: HorizontalLayout {
                            width: parent.width;
                            height: max(140px, wide-settings-pane.height);
                            spacing: root.nav-content-gap;
                            alignment: start;

                            VerticalLayout {
                                width: root.nav-width;
                                spacing: 4px;
                                alignment: start;

                                GitHubSettingsNavItem {
                                    text: I18n.settings-general-title;
                                    selected: root.selected-section == 0;
                                    clicked => { root.selected-section = 0; }
                                }
                                GitHubSettingsNavItem {
                                    text: I18n.settings-code-hosting-title;
                                    selected: root.selected-section == 1;
                                    clicked => { root.selected-section = 1; }
                                }
                                GitHubSettingsNavItem {
                                    text: I18n.settings-ai-agent-title;
                                    selected: root.selected-section == 2;
                                    clicked => { root.selected-section = 2; }
                                }
                                GitHubSettingsNavItem {
                                    text: I18n.settings-ai-review-title;
                                    selected: root.selected-section == 3;
                                    clicked => { root.selected-section = 3; }
                                }
                                GitHubSettingsNavItem {
                                    text: I18n.settings-diagnostics-title;
                                    selected: root.selected-section == 4;
                                    clicked => { root.selected-section = 4; }
                                }
                            }

                            wide-settings-pane := GitHubSettingsPane {
                                width: root.page-width - root.nav-width - root.nav-content-gap;
                                selected-section: root.selected-section;
                                simulate-crash-active <=> root.simulate-crash-active;
                                reveal-git-tokens <=> root.reveal-git-tokens;
                                git-tokens-saved <=> root.git-tokens-saved;
                                git-hosting-config-saved <=> root.git-hosting-config-saved;
                                reveal-ai-agent-api-key <=> root.reveal-ai-agent-api-key;
                                ai-agent-saved <=> root.ai-agent-saved;
                                ai-agent-testing <=> root.ai-agent-testing;
                                hosting-config-tab <=> root.hosting-config-tab;
                                update-checking <=> root.update-checking;
                                ai-review-rules: root.ai-review-rules;
                                ai-review-max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                                ai-review-rule-add-pending <=> root.ai-review-rule-add-pending;
                                ai-review-rule-name-error <=> root.ai-review-rule-name-error;
                                ai-review-rule-path-error <=> root.ai-review-rule-path-error;
                                ai-review-set-max-concurrent-tasks(value) => { root.ai-review-set-max-concurrent-tasks(value); }
                                ai-review-add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                                ai-review-delete-rule(id) => { root.ai-review-delete-rule(id); }
                                ai-review-set-default-rule(id) => { root.ai-review-set-default-rule(id); }
                                check-update => { root.check-update(); }
                                simulate-crash => { root.simulate-crash(); }
                                open-log-directory => { root.open-log-directory(); }
                                export-diagnostics => { root.export-diagnostics(); }
                            }
                        }

                        if root.compact-layout: VerticalLayout {
                            width: parent.width;
                            height: compact-settings-pane.height
                                + (root.compact-navigation-open ? 242px : 56px);
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                width: parent.width;
                                height: 40px;
                                background: transparent;

                                GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 0;
                                    text: I18n.settings-general-title;
                                    open: root.compact-navigation-open;
                                    clicked => {
                                        root.compact-navigation-selection = root.selected-section;
                                        root.compact-navigation-open = !root.compact-navigation-open;
                                    }
                                }
                                GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 1;
                                    text: I18n.settings-code-hosting-title;
                                    open: root.compact-navigation-open;
                                    clicked => {
                                        root.compact-navigation-selection = root.selected-section;
                                        root.compact-navigation-open = !root.compact-navigation-open;
                                    }
                                }
                                GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 2;
                                    text: I18n.settings-ai-agent-title;
                                    open: root.compact-navigation-open;
                                    clicked => {
                                        root.compact-navigation-selection = root.selected-section;
                                        root.compact-navigation-open = !root.compact-navigation-open;
                                    }
                                }
                                GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 3;
                                    text: I18n.settings-ai-review-title;
                                    open: root.compact-navigation-open;
                                    clicked => {
                                        root.compact-navigation-selection = root.selected-section;
                                        root.compact-navigation-open = !root.compact-navigation-open;
                                    }
                                }
                                GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 4;
                                    text: I18n.settings-diagnostics-title;
                                    open: root.compact-navigation-open;
                                    clicked => {
                                        root.compact-navigation-selection = root.selected-section;
                                        root.compact-navigation-open = !root.compact-navigation-open;
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                height: root.compact-navigation-open ? 170px : 0px;
                                visible: root.compact-navigation-open;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: GitHubTheme.border-default;
                                background: GitHubTheme.canvas-default;

                                VerticalLayout {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    spacing: 0px;

                                    GitHubSettingsNavItem {
                                        text: I18n.settings-general-title;
                                        selected: root.compact-navigation-selection == 0;
                                        clicked => {
                                            root.compact-navigation-selection = 0;
                                            root.selected-section = 0;
                                            root.compact-navigation-open = false;
                                        }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-code-hosting-title;
                                        selected: root.compact-navigation-selection == 1;
                                        clicked => {
                                            root.compact-navigation-selection = 1;
                                            root.selected-section = 1;
                                            root.compact-navigation-open = false;
                                        }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-ai-agent-title;
                                        selected: root.compact-navigation-selection == 2;
                                        clicked => {
                                            root.compact-navigation-selection = 2;
                                            root.selected-section = 2;
                                            root.compact-navigation-open = false;
                                        }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-ai-review-title;
                                        selected: root.compact-navigation-selection == 3;
                                        clicked => {
                                            root.compact-navigation-selection = 3;
                                            root.selected-section = 3;
                                            root.compact-navigation-open = false;
                                        }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-diagnostics-title;
                                        selected: root.compact-navigation-selection == 4;
                                        clicked => {
                                            root.compact-navigation-selection = 4;
                                            root.selected-section = 4;
                                            root.compact-navigation-open = false;
                                        }
                                    }
                                }
                            }

                            compact-settings-pane := GitHubSettingsPane {
                                width: root.page-width;
                                selected-section: root.selected-section;
                                simulate-crash-active <=> root.simulate-crash-active;
                                reveal-git-tokens <=> root.reveal-git-tokens;
                                git-tokens-saved <=> root.git-tokens-saved;
                                git-hosting-config-saved <=> root.git-hosting-config-saved;
                                reveal-ai-agent-api-key <=> root.reveal-ai-agent-api-key;
                                ai-agent-saved <=> root.ai-agent-saved;
                                ai-agent-testing <=> root.ai-agent-testing;
                                hosting-config-tab <=> root.hosting-config-tab;
                                update-checking <=> root.update-checking;
                                ai-review-rules: root.ai-review-rules;
                                ai-review-max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                                ai-review-rule-add-pending <=> root.ai-review-rule-add-pending;
                                ai-review-rule-name-error <=> root.ai-review-rule-name-error;
                                ai-review-rule-path-error <=> root.ai-review-rule-path-error;
                                ai-review-set-max-concurrent-tasks(value) => { root.ai-review-set-max-concurrent-tasks(value); }
                                ai-review-add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                                ai-review-delete-rule(id) => { root.ai-review-delete-rule(id); }
                                ai-review-set-default-rule(id) => { root.ai-review-set-default-rule(id); }
                                check-update => { root.check-update(); }
                                simulate-crash => { root.simulate-crash(); }
                                open-log-directory => { root.open-log-directory(); }
                                export-diagnostics => { root.export-diagnostics(); }
                            }
                        }
                    }
        }
    }

    // Settings is also an independent ComponentFactory/global graph. Mount a
    // local root portal so present and future shared controls keep full Tooltip
    // behavior without reaching into MainWindow globals.
    GitHubTooltipOverlayHost {
        width: parent.width;
        height: parent.height;
        z: 10000;
    }
}
