import { AppState, LanguageOption } from "../state/app_state.slint";
export { AppState, LanguageOption } from "../state/app_state.slint";
import { I18n } from "@i18n";
import { GitHubScrollView } from "../components/github_scroll_view.slint";
import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
import { GitHubTooltipOverlayHost } from "../components/github_tooltip_overlay.slint";
import { TooltipOverlayState } from "../state/tooltip_overlay_state.slint";
export { TooltipOverlayState } from "../state/tooltip_overlay_state.slint";
import { GitHubHookTooltipOverlay, HookTooltipState } from "../components/settings/github_hook_tooltip.slint";
export { HookTooltipState, HookTooltipKind } from "../components/settings/github_hook_tooltip.slint";
import {
    GitHubSettingsNavItem,
    GitHubSettingsSectionMenuButton
} from "../components/settings/github_settings_controls.slint";
import { GitHubSettingsPane } from "../components/settings/github_settings_layout.slint";
import { ManifestInterfaceLanguagePickerOverlay, ManifestReplyLanguagePickerOverlay } from "@language-picker";
import { GitHubSelectState, GitHubSelectPopup, GitHubSelectOption } from "../components/input/github_select.slint";
export { GitHubSelectState } from "../components/input/github_select.slint";
import { AiReviewRuleItem } from "@ai-review-settings";
export { AiReviewRuleItem } from "@ai-review-settings";
export { HookSettingsState, HookChoice, HookEventChoice, HookSummary, HookLanguageDraft, HookCodeToken, HookCodeLine } from "../components/settings/github_hook_settings.slint";
import { HookSettingsState, GitHubHookSettingsOverlay, GitHubHookDialog } from "../components/settings/github_hook_settings.slint";

// ComponentFactory embeds this Window without showing a second native window.
// An implicit Window wrapper would paint the style's opaque default background.
export component GitHubSettingsPage inherits Window {
    // ComponentContainer clips an external tree but does not rewrite these
    // public geometry properties. The Rust bridge keeps them synchronized with
    // the host viewport so responsive layout and scrolling use the real size.
    in-out property <length> viewport-width: 800px;
    in-out property <length> viewport-height: 768px;
    in-out property <length> window-width: root.viewport-width;
    in-out property <length> window-height: root.viewport-height;
    in-out property <length> content-origin-x: 0px;
    in-out property <length> content-origin-y: 0px;
    // The cross-crate factory remains mounted after its first visit. The host
    // therefore publishes route activity explicitly so heavyweight transient
    // descendants can release their item trees while Settings is hidden.
    in property <bool> route-active: true;
    changed route-active => {
        if !root.route-active {
            HookTooltipState.dismiss();
            TooltipOverlayState.dismiss-all();
            GitHubSelectState.close(false);
        }
    }
    width: root.window-width;
    height: root.window-height;
    background: transparent;
    callback hook-dialog-visibility-changed(bool);
    callback close-hook-editor();
    callback dismiss-hook-menu() -> bool;
    dismiss-hook-menu => {
        if GitHubSelectState.open {
            GitHubSelectState.close(true);
            return true;
        }
        return false;
    }
    close-hook-editor => {
        draft-reset-focus.focus();
        GitHubSelectState.close(false);
        HookSettingsState.dialog-mode = "";
    }
    private property <bool> hook-dialog-open:
        root.route-active && HookSettingsState.dialog-mode != "";
    changed hook-dialog-open => { HookTooltipState.dismiss(); root.hook-dialog-visibility-changed(root.hook-dialog-open); }
    callback check-update();
    callback simulate-crash();
    callback open-log-directory();
    callback export-diagnostics();
    callback dismiss-select();
    callback select-pointer-released(length, length);
    dismiss-select => { GitHubSelectState.close(false); }
    select-pointer-released(x, y) => {
        GitHubSelectState.pointer-released(
            x + root.absolute-position.x, y + root.absolute-position.y);
    }

    in-out property <bool> simulate-crash-active: false;
    in-out property <bool> reveal-git-tokens: false;
    in-out property <bool> git-tokens-saved: false;
    in-out property <bool> git-hosting-config-saved: false;
    in-out property <bool> reveal-ai-agent-api-key: false;
    in-out property <bool> ai-agent-saved: false;
    in-out property <bool> ai-agent-testing: false;
    in-out property <bool> update-checking: false;
    in-out property <int> route-entry-revision: 0;
    in property <[AiReviewRuleItem]> ai-review-rules: [];
    in property <int> ai-review-max-concurrent-tasks: 3;
    in-out property <bool> ai-review-rule-add-pending: false;
    in-out property <string> ai-review-rule-name-error: "";
    in-out property <string> ai-review-rule-path-error: "";
    callback ai-review-set-max-concurrent-tasks(int);
    callback ai-review-add-rule(string, string);
    callback ai-review-delete-rule(string);
    callback ai-review-set-default-rule(string);

    // Start the lazily created tree from a sentinel and select its defaults on
    // the next UI tick so Slint 1.17.1 invalidates cached selector bindings.
    private property <int> selected-section: -1;
    private property <int> hosting-config-tab: -1;
    private property <bool> initial-tab-sync-pending: true;
    private property <bool> compact-navigation-open:
        GitHubSelectState.open && GitHubSelectState.owner == "settings-section";
    private property <length> page-gutter: root.viewport-width >= 1000px ? 48px : 16px;
    private property <length> available-width: max(0px, root.viewport-width - root.page-gutter * 2);
    private property <length> page-width: min(1120px, root.available-width);
    private property <bool> compact-layout: root.page-width < 768px;
    private property <length> nav-width: 180px;
    private property <length> nav-content-gap: 32px;
    private property <length> section-scroll-offset: settings-title.preferred-height + page-column.spacing;

    changed selected-section => {
        GitHubSelectState.open = false;
        if !root.compact-layout {
            settings-scroll.viewport_y = -root.section-scroll-offset;
        }
    }
    changed viewport-width => { GitHubSelectState.open = false; }
    changed viewport-height => { GitHubSelectState.open = false; }
    changed window-width => { GitHubSelectState.close(false); }
    changed window-height => { GitHubSelectState.close(false); }

    changed route-entry-revision => {
        draft-reset-focus.focus();
        GitHubSelectState.close(false);
        root.simulate-crash-active = false;
        root.reveal-git-tokens = false;
        root.reveal-ai-agent-api-key = false;
    }

    // The Settings factory stays mounted between routes. Move focus away from
    // any active editor before Rust restores the committed values, otherwise
    // TextInput's live edit binding can retain an unsaved draft.
    draft-reset-focus := FocusScope {
        width: 0px;
        height: 0px;
    }

    initial-tab-sync := Timer {
        interval: 1ms;
        running: root.initial-tab-sync-pending;
        triggered => {
            root.selected-section = 0;
            root.hosting-config-tab = 0;
            root.initial-tab-sync-pending = false;
        }
    }

    settings-scroll := GitHubScrollView {
        x: root.content-origin-x;
        y: root.content-origin-y;
        width: root.viewport-width;
        height: root.viewport-height;
        viewport_x: 0px;
        changed viewport_y => { GitHubSelectState.open = false; }

        content-host := Rectangle {
            width: settings-scroll.visible_width;
            // Keep the 16px top inset plus a deliberate 24px end margin. This
            // is vertical breathing room below the final setting, not a
            // horizontal-scroll gutter.
            height: max(settings-scroll.visible_height
                + (root.compact-layout ? 0px : root.section-scroll-offset),
                page-column.preferred-height + 40px);
            background: GitHubTheme.canvas-default;

                    page-column := VerticalLayout {
                        x: root.page-gutter
                            + max(0px, (root.available-width - root.page-width) / 2);
                        y: 16px;
                        width: root.page-width;
                        spacing: 24px;
                        alignment: start;

                        settings-title := Text {
                            width: parent.width;
                            text: I18n.settings-title;
                            font-size: 24px;
                            font-weight: 600;
                            color: GitHubTheme.fg-default;
                        }

                        if !root.compact-layout: wide-layout := HorizontalLayout {
                            width: parent.width;
                            height: max(wide-navigation.preferred-height, wide-settings-pane.height);
                            spacing: root.nav-content-gap;
                            alignment: start;

                            Rectangle {
                                width: root.nav-width;
                                height: parent.height;
                                background: transparent;

                                wide-navigation := VerticalLayout {
                                    width: parent.width;
                                    height: self.preferred-height;
                                    // Sticky within the existing scroll chain; keep the
                                    // navigation inside its column at the document end.
                                    y: min(
                                        max(0px, parent.height - self.height),
                                        max(0px, -settings-scroll.viewport_y
                                            - page-column.y - wide-layout.y + 16px)
                                    );
                                    spacing: 4px;
                                    alignment: start;

                                    GitHubSettingsNavItem {
                                        text: I18n.settings-general-title;
                                        selected: root.selected-section == 0;
                                        clicked => { root.selected-section = 0; }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-code-hosting-title;
                                        selected: root.selected-section == 1;
                                        clicked => { root.selected-section = 1; }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-ai-agent-title;
                                        selected: root.selected-section == 2;
                                        clicked => { root.selected-section = 2; }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-ai-review-title;
                                        selected: root.selected-section == 3;
                                        clicked => { root.selected-section = 3; }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.hooks-title;
                                        selected: root.selected-section == 4;
                                        clicked => { root.selected-section = 4; }
                                    }
                                    GitHubSettingsNavItem {
                                        text: I18n.settings-diagnostics-title;
                                        selected: root.selected-section == 5;
                                        clicked => { root.selected-section = 5; }
                                    }
                                }

                            }

                            wide-settings-pane := GitHubSettingsPane {
                                viewport-origin-x: root.absolute-position.x + settings-scroll.x + page-column.x + root.nav-width + root.nav-content-gap;
                                viewport-origin-y: root.absolute-position.y + settings-scroll.y + settings-scroll.viewport_y + page-column.y + wide-layout.y;
                                width: root.page-width - root.nav-width - root.nav-content-gap;
                                selected-section: root.selected-section;
                                route-entry-revision: root.route-entry-revision;
                                simulate-crash-active <=> root.simulate-crash-active;
                                reveal-git-tokens <=> root.reveal-git-tokens;
                                git-tokens-saved <=> root.git-tokens-saved;
                                git-hosting-config-saved <=> root.git-hosting-config-saved;
                                reveal-ai-agent-api-key <=> root.reveal-ai-agent-api-key;
                                ai-agent-saved <=> root.ai-agent-saved;
                                ai-agent-testing <=> root.ai-agent-testing;
                                hosting-config-tab <=> root.hosting-config-tab;
                                update-checking <=> root.update-checking;
                                ai-review-rules: root.ai-review-rules;
                                ai-review-max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                                ai-review-rule-add-pending <=> root.ai-review-rule-add-pending;
                                ai-review-rule-name-error <=> root.ai-review-rule-name-error;
                                ai-review-rule-path-error <=> root.ai-review-rule-path-error;
                                ai-review-set-max-concurrent-tasks(value) => { root.ai-review-set-max-concurrent-tasks(value); }
                                ai-review-add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                                ai-review-delete-rule(id) => { root.ai-review-delete-rule(id); }
                                ai-review-set-default-rule(id) => { root.ai-review-set-default-rule(id); }
                                check-update => { root.check-update(); }
                                simulate-crash => { root.simulate-crash(); }
                                open-log-directory => { root.open-log-directory(); }
                                export-diagnostics => { root.export-diagnostics(); }
                            }
                        }

                        if root.compact-layout: compact-column := VerticalLayout {
                            width: parent.width;
                            height: compact-settings-pane.height + 56px;
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                width: parent.width;
                                height: 40px;
                                background: transparent;

                                general-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 0;
                                    text: I18n.settings-general-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "0", 0,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                                hosting-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 1;
                                    text: I18n.settings-code-hosting-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "1", 1,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                                ai-agent-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 2;
                                    text: I18n.settings-ai-agent-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "2", 2,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                                ai-review-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 3;
                                    text: I18n.settings-ai-review-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "3", 3,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                                hooks-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 4;
                                    text: I18n.hooks-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "4", 4,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                                diagnostics-section-trigger := GitHubSettingsSectionMenuButton {
                                    width: parent.width;
                                    visible: root.selected-section == 5;
                                    text: I18n.settings-diagnostics-title;
                                    open: root.compact-navigation-open;
                                    restore-focus-on-close: GitHubSelectState.restore-focus;
                                    clicked => {
                                        if self.open { GitHubSelectState.close(true); } else {
                                            GitHubSelectState.show("settings-section", "5", 5,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        }
                                    }
                                }
                            }

                            compact-settings-pane := GitHubSettingsPane {
                                viewport-origin-x: root.absolute-position.x + settings-scroll.x + page-column.x;
                                viewport-origin-y: root.absolute-position.y + settings-scroll.y + settings-scroll.viewport_y + page-column.y + compact-column.y + self.y;
                                width: root.page-width;
                                selected-section: root.selected-section;
                                route-entry-revision: root.route-entry-revision;
                                simulate-crash-active <=> root.simulate-crash-active;
                                reveal-git-tokens <=> root.reveal-git-tokens;
                                git-tokens-saved <=> root.git-tokens-saved;
                                git-hosting-config-saved <=> root.git-hosting-config-saved;
                                reveal-ai-agent-api-key <=> root.reveal-ai-agent-api-key;
                                ai-agent-saved <=> root.ai-agent-saved;
                                ai-agent-testing <=> root.ai-agent-testing;
                                hosting-config-tab <=> root.hosting-config-tab;
                                update-checking <=> root.update-checking;
                                ai-review-rules: root.ai-review-rules;
                                ai-review-max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                                ai-review-rule-add-pending <=> root.ai-review-rule-add-pending;
                                ai-review-rule-name-error <=> root.ai-review-rule-name-error;
                                ai-review-rule-path-error <=> root.ai-review-rule-path-error;
                                ai-review-set-max-concurrent-tasks(value) => { root.ai-review-set-max-concurrent-tasks(value); }
                                ai-review-add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                                ai-review-delete-rule(id) => { root.ai-review-delete-rule(id); }
                                ai-review-set-default-rule(id) => { root.ai-review-set-default-rule(id); }
                                check-update => { root.check-update(); }
                                simulate-crash => { root.simulate-crash(); }
                                open-log-directory => { root.open-log-directory(); }
                                export-diagnostics => { root.export-diagnostics(); }
                            }
                        }
                    }
        }
    }

    settings-section-popup := GitHubSelectPopup {
        z: 7900;
        owner: "settings-section";
        option-count: 6;
        selected(index) => {
            root.selected-section = index;
            GitHubSelectState.close(true);
        }
        GitHubSelectOption {
            x: 0px; y: 0px; width: settings-section-popup.option-width;
            text: I18n.settings-general-title;
            selected: root.selected-section == 0;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 0;
            activated => { settings-section-popup.selected(0); }
        }
        GitHubSelectOption {
            x: 0px; y: GitHubMetrics.size-32; width: settings-section-popup.option-width;
            text: I18n.settings-code-hosting-title;
            selected: root.selected-section == 1;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 1;
            activated => { settings-section-popup.selected(1); }
        }
        GitHubSelectOption {
            x: 0px; y: GitHubMetrics.size-32 * 2; width: settings-section-popup.option-width;
            text: I18n.settings-ai-agent-title;
            selected: root.selected-section == 2;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 2;
            activated => { settings-section-popup.selected(2); }
        }
        GitHubSelectOption {
            x: 0px; y: GitHubMetrics.size-32 * 3; width: settings-section-popup.option-width;
            text: I18n.settings-ai-review-title;
            selected: root.selected-section == 3;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 3;
            activated => { settings-section-popup.selected(3); }
        }
        GitHubSelectOption {
            x: 0px; y: GitHubMetrics.size-32 * 4; width: settings-section-popup.option-width;
            text: I18n.hooks-title;
            selected: root.selected-section == 4;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 4;
            activated => { settings-section-popup.selected(4); }
        }
        GitHubSelectOption {
            x: 0px; y: GitHubMetrics.size-32 * 5; width: settings-section-popup.option-width;
            text: I18n.settings-diagnostics-title;
            selected: root.selected-section == 5;
            active: root.compact-navigation-open && GitHubSelectState.active-index == 5;
            activated => { settings-section-popup.selected(5); }
        }
    }

    GitHubHookDialog {
        x: 0px; y: 0px; width: root.width; height: root.height; z: 8000;
        route-active: root.route-active;
    }
    ManifestInterfaceLanguagePickerOverlay { z: 9000; }
    ManifestReplyLanguagePickerOverlay { z: 9000; }
    GitHubHookSettingsOverlay { width: parent.width; height: parent.height; z: 9000; }

    // Settings is also an independent ComponentFactory/global graph. Mount a
    // local root portal so present and future shared controls keep full Tooltip
    // behavior without reaching into MainWindow globals.
    GitHubTooltipOverlayHost {
        width: parent.width;
        height: parent.height;
        z: 10000;
    }
    GitHubHookTooltipOverlay { x: 0px; y: 0px; width: root.width; height: root.height; z: 10001; }
}
