import { AppState } from "../state/app_state.slint";
export { AppState } from "../state/app_state.slint";
import { I18n } from "@i18n";
import { GitHubScrollView } from "../components/github_scroll_view.slint";
import { GitHubBlankslate } from "../components/github_blankslate.slint";
import { GitHubButton } from "../components/settings/github_settings_controls.slint";
import { GitHubSegmentedControl } from "../components/github_segmented_control.slint";
import { GitHubPageHeader } from "../components/page/github_page_header.slint";
import { GitHubPagination } from "../components/navigation/github_pagination.slint";
import {
    GitHubMessageListItem,
    MessageListItem,
    MessageLevel
} from "../components/messages/github_message_components.slint";
import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
import { GitHubMessageTooltipOverlayHost } from "../components/messages/github_message_tooltip.slint";
import { MessageTooltipOverlayState } from "../state/message_tooltip_overlay_state.slint";

export { MessageListItem, MessageLevel } from "../components/messages/github_message_components.slint";

export component GitHubMessagesPage inherits Rectangle {
    // Keep the shared translation catalog linked even before this page's copy
    // migration is complete. All independently generated roots must expose the
    // same bundle index table.
    private property <string> i18n-catalog-sentinel: I18n.language-title;
    in-out property <length> viewport-width: 800px;
    in-out property <length> viewport-height: 768px;
    // The small static page shell survives route changes so ComponentFactory
    // bindings are never remounted. Rust clears message payloads from the 20
    // stable row slots while inactive.
    in property <bool> active: false;
    in property <[MessageListItem]> messages: [];
    in property <int> page-row-count: 0;
    in property <int> current-page: 1;
    in property <int> page-count: 1;
    in property <[int]> page-links: [];
    in-out property <length> scroll-y <=> message-scroll.viewport_y;
    // Counts are pushed from Rust on every snapshot. Do not derive tab badges
    // from `messages.length` string concat inside SegmentedControlItem — that
    // binding can freeze after the first paint on this ComponentFactory page.
    in property <int> total-count: 0;
    in property <int> unread-count: 0;
    in property <int> read-count: 0;
    in property <int> filter-count-suffix-offset: 0;
    // Complete status sentence from Rust. Do not build this with unread-count
    // string concat here — that freezes after first paint on this factory page.
    in property <string> status-description: I18n.messages-caught-up;
    callback set-read(string, bool);
    callback mark-all-read();
    callback delete-message(string);
    callback clear-messages();
    callback activate-target(string);
    callback change-filter(int);
    callback change-page(int);

    in property <int> selected-filter: 0;
    private property <bool> clear-confirmation: false;
    private property <bool> unread-filter: root.selected-filter == 1;
    private property <bool> read-filter: root.selected-filter == 2;
    private property <bool> filtered-empty:
        root.unread-filter ? root.unread-count == 0
        : root.read-filter ? root.read-count == 0
        : root.total-count == 0;
    private property <int> visible-count: root.page-row-count;
    private property <length> row-height: root.width < 720px ? 76px : 84px;
    private property <length> page-gutter: root.width >= 1000px ? 48px : 20px;
    private property <length> available-width: max(0px, root.width - root.page-gutter * 2);
    private property <length> page-width: min(1040px, root.available-width);
    private property <bool> compact-actions: root.page-width < 720px;
    private property <length> actions-y: root.compact-actions ? 100px : 20px;
    private property <length> filters-y: root.compact-actions ? 148px : 100px;
    private property <length> list-y: root.filters-y + 44px;

    width: root.viewport-width;
    height: root.viewport-height;
    background: GitHubTheme.canvas-default;
    clip: false;

    public function clamp-scroll() {
        message-scroll.viewport_y = max(
            min(0px, message-scroll.viewport_y),
            -max(0px, message-scroll.content_height - message-scroll.visible-height)
        );
    }

    changed active => {
        if !root.active {
            root.clear-confirmation = false;
            MessageTooltipOverlayState.dismiss-all();
        }
    }

    clear-confirmation-reset := Timer {
        interval: 3000ms;
        running: root.active && root.clear-confirmation;
        triggered => { root.clear-confirmation = false; }
    }

    message-scroll := GitHubScrollView {
        width: root.width;
        height: root.height;
        viewport_x: 0px;

        page-content := Rectangle {
            x: root.page-gutter + max(0px, (root.available-width - root.page-width) / 2);
            width: root.page-width;
            height: max(
                message-scroll.visible-height,
                message-list.preferred-height + root.list-y
                    + (root.page-count > 1 ? GitHubMetrics.size-64 : GitHubMetrics.size-8)
            );
            background: transparent;
            clip: false;

            GitHubPageHeader {
                x: 0px;
                y: GitHubMetrics.size-16;
                width: parent.width;
                title: I18n.common-notifications;
                description: root.status-description;
                leading-icon: @image-url("../assets/icons/octicon-inbox-16.svg");
                large-title: true;
                actions-width: root.compact-actions ? 0px : header-actions.width;
            }

            header-actions := HorizontalLayout {
                x: root.compact-actions ? 0px : parent.width - self.width;
                y: root.actions-y;
                width: mark-read-button.width + clear-button.width + GitHubMetrics.size-8;
                height: GitHubMetrics.size-32;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                mark-read-button := GitHubButton {
                    text: I18n.messages-mark-all-read;
                    disabled: root.unread-count == 0;
                    clicked => { root.mark-all-read(); }
                }

                clear-button := GitHubButton {
                    text: root.clear-confirmation ? I18n.messages-confirm-clear : I18n.messages-clear-all;
                    danger: true;
                    disabled: root.total-count == 0;
                    clicked => {
                        if root.clear-confirmation {
                            root.clear-messages();
                            root.clear-confirmation = false;
                        } else {
                            root.clear-confirmation = true;
                        }
                    }
                }
            }

            GitHubSegmentedControl {
                x: 0px;
                y: root.filters-y;
                group-label: I18n.messages-filter;
                items: [
                    { label: I18n.common-all, count: root.total-count, count-suffix-offset: root.filter-count-suffix-offset, enabled: true },
                    { label: I18n.common-unread, count: root.unread-count, count-suffix-offset: root.filter-count-suffix-offset, enabled: true },
                    { label: I18n.common-read, count: root.read-count, count-suffix-offset: root.filter-count-suffix-offset, enabled: true },
                ];
                selected-index: root.selected-filter;
                selection-changed(index) => {
                    MessageTooltipOverlayState.dismiss-all();
                    root.change-filter(index);
                }
            }

            message-list := VerticalLayout {
                x: 0px;
                y: root.list-y;
                width: parent.width;
                spacing: 0px;
                alignment: start;

                if root.filtered-empty: GitHubBlankslate {
                    width: parent.width;
                    heading: root.unread-filter
                        ? I18n.messages-no-unread
                        : (root.read-filter ? I18n.messages-no-read : I18n.messages-none-yet);
                    description: root.unread-filter
                        ? I18n.messages-empty-unread-description
                        : (root.read-filter
                            ? I18n.messages-empty-read-description
                            : I18n.messages-empty-all-description);
                    icon: @image-url("../assets/icons/octicon-inbox-16.svg");
                    bordered: true;
                    spacious: true;
                }

                // Each bounded row owns its border; only the end rows clip
                // rounded corners. No full-document rounded offscreen texture.
                Rectangle {
                    width: parent.width;
                    height: root.visible-count * root.row-height;
                    visible: root.visible-count > 0;
                    background: transparent;

                    visible-messages := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        alignment: start;

                        for message[index] in root.messages: GitHubMessageListItem {
                            width: parent.width;
                            height: index < root.visible-count ? root.row-height : 0px;
                            visible: index < root.visible-count;
                            item: message;
                            compact: root.width < 720px;
                            framed: true;
                            first-row: index == 0;
                            last-row: index == root.visible-count - 1;
                            activated(id) => {
                                if !message.read {
                                    root.set-read(id, true);
                                }
                                if message.target != "" {
                                    root.activate-target(message.target);
                                }
                            }
                            read-changed(id, read) => { root.set-read(id, read); }
                            delete-requested(id) => { root.delete-message(id); }
                        }
                    }
                }
            }

            GitHubPagination {
                visible: root.page-count > 1;
                x: 0px;
                y: root.list-y + message-list.preferred-height + GitHubMetrics.size-16;
                width: parent.width;
                current-page: root.current-page;
                page-count: root.page-count;
                pages: root.page-links;
                page-selected(number) => {
                    MessageTooltipOverlayState.dismiss-all();
                    root.change-page(number);
                }
            }
        }
    }

    // ComponentFactory pages own an independent global graph. Keep the shared
    // positioning algorithm, but mount its portal inside this page's viewport.
    GitHubMessageTooltipOverlayHost {
        width: parent.width;
        height: parent.height;
        z: 10000;
    }

}
