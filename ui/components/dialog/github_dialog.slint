import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { TransientOverlayState } from "../../state/transient_overlay_state.slint";

// Shared Primer Dialog surface for every application-owned modal.
//
// Geometry follows docs/specs/ui-design.md and Primer Dialog:
// 16 px header/body/footer safe areas, 8 px close-button edge inset,
// medium 32 px footer controls, and 296/320/480/640 px width variants.
// Feature-specific content nests as @children so Esc capture stays on the
// focus path; modality, chrome, footer actions, disabled/busy states, and
// input blocking stay here.
export component GitHubDialog inherits FocusScope {
    in property <bool> dialog-visible: false;
    in property <bool> show-backdrop: true;
    // When true, Esc does not dismiss. Backdrop dismiss stays independent via
    // dismiss-on-backdrop so callers can combine either gesture.
    in property <bool> modal: false;
    in property <string> title;
    in property <string> subtitle: "";
    in property <length> dialog-width: 480px;
    in property <length> dialog-height: 320px;
    in property <length> body-padding: 16px;
    in property <bool> show-footer: true;
    in property <bool> show-close: true;
    in property <bool> close-enabled: true;
    in property <bool> dismiss-on-backdrop: false;
    in property <[string]> secondary-actions: [];
    in property <string> cancel-label: "Cancel";
    in property <bool> show-cancel: true;
    in property <string> primary-label: "";
    in property <bool> primary-enabled: true;
    in property <bool> primary-busy: false;
    in property <bool> primary-danger: false;
    in property <bool> primary-success: false;
    in property <bool> fullscreen-on-narrow: true;
    // Dialogs normally fill their direct host. Route-owned dialogs can supply
    // the complete window viewport in host-local coordinates so shared chrome,
    // backdrop, and centering remain window-relative across docked sidebars.
    in property <length> viewport-x: 0px;
    in property <length> viewport-y: 0px;
    in property <length> viewport-width: root.width;
    in property <length> viewport-height: root.height;
    // A host may reserve a separately-owned native title bar. Surface
    // placement still uses the complete viewport, while the backdrop can stop
    // at the host edge so that title-bar continuation paints only once.
    in property <length> backdrop-x: root.viewport-x;
    in property <length> backdrop-y: root.viewport-y;
    in property <length> backdrop-width: root.viewport-width;
    in property <length> backdrop-height: root.viewport-height;

    callback close-requested();
    callback cancel-clicked();
    callback secondary-action-clicked(int);
    callback primary-clicked();

    private property <length> header-height: root.subtitle == "" ? 56px : 72px;
    private property <length> footer-height: root.show-footer ? 64px : 0px;
    private property <bool> narrow-fullscreen:
        root.fullscreen-on-narrow && root.viewport-width < GitHubMetrics.breakpoint-small;
    out property <length> content-x: dialog-surface.x + root.body-padding;
    out property <length> content-y: dialog-surface.y + root.header-height + root.body-padding;
    out property <length> content-width: dialog-surface.width - root.body-padding * 2;
    out property <length> content-height: dialog-surface.height
        - root.header-height - root.footer-height - root.body-padding * 2;

    // Primer Dialog dismisses on Esc unless the caller opts into a hard-modal
    // session (unsaved forms, blocking progress, or DialogManager.modal).
    private property <bool> escape-dismisses:
        root.dialog-visible && !root.modal && root.close-enabled;
    private property <int> dismiss-revision: TransientOverlayState.dismiss-revision;

    visible: root.dialog-visible;
    width: 100%;
    height: 100%;
    z: 3000;

    changed dialog-visible => {
        if root.dialog-visible {
            if root.show-close && root.close-enabled {
                close-button.focus();
            } else {
                root.focus();
            }
        } else if root.has-focus {
            root.clear-focus();
        }
    }

    changed dismiss-revision => {
        if root.dialog-visible
                && root.show-backdrop
                && root.dismiss-on-backdrop
                && root.close-enabled {
            root.close-requested();
        }
    }

    // Intercept Esc before nested TextInputs so the dialog closes even while
    // a field inside @children has focus (matches github.com Dialog).
    capture-key-pressed(event) => {
        if root.escape-dismisses && event.text == Key.Escape {
            root.close-requested();
            return accept;
        }
        return reject;
    }

    key-pressed(event) => {
        if root.escape-dismisses && event.text == Key.Escape {
            root.close-requested();
            return accept;
        }
        return reject;
    }

    Rectangle {
        x: root.backdrop-x;
        y: root.backdrop-y;
        width: root.backdrop-width;
        height: root.backdrop-height;
        background: root.show-backdrop ? GitHubTheme.backdrop : transparent;

        backdrop-touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: default;
            clicked => {
                if root.dismiss-on-backdrop && root.close-enabled {
                    root.close-requested();
                }
            }
        }
    }

    dialog-surface := Rectangle {
        x: root.narrow-fullscreen
            ? root.viewport-x
            : root.viewport-x + (root.viewport-width - self.width) / 2;
        y: root.narrow-fullscreen
            ? root.viewport-y
            : root.viewport-y + (root.viewport-height - self.height) / 2;
        width: root.narrow-fullscreen
            ? root.viewport-width
            : min(root.dialog-width, root.viewport-width - GitHubMetrics.size-32);
        height: root.narrow-fullscreen
            ? root.viewport-height
            : min(root.dialog-height, root.viewport-height - GitHubMetrics.size-32);
        border-radius: root.narrow-fullscreen ? 0px : GitHubMetrics.radius-large;
        border-width: root.narrow-fullscreen ? 0px : GitHubMetrics.border-thin;
        border-color: GitHubTheme.border-default;
        background: GitHubTheme.canvas-default;
        drop-shadow-blur: 24px;
        drop-shadow-color: GitHubTheme.backdrop-medium;
        drop-shadow-offset-y: 8px;
    }

    // Keep all chrome in the component root coordinate system. Feature body
    // content consumes the exported content geometry as nested @children.
    TouchArea {
        x: dialog-surface.x;
        y: dialog-surface.y;
        width: dialog-surface.width;
        height: dialog-surface.height;
        mouse-cursor: default;
    }

    Rectangle {
        x: dialog-surface.x;
        y: dialog-surface.y + root.header-height - 1px;
        width: dialog-surface.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }

    Text {
        x: dialog-surface.x + 16px;
        y: dialog-surface.y + (root.subtitle == "" ? 0px : 10px);
        width: dialog-surface.width - (root.show-close ? 64px : 32px);
        height: root.subtitle == "" ? root.header-height : 28px;
        text: root.title;
        font-size: root.subtitle == "" ? 16px : 20px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.subtitle != "": Text {
        x: dialog-surface.x + 16px;
        y: dialog-surface.y + 40px;
        width: dialog-surface.width - (root.show-close ? 64px : 32px);
        height: 20px;
        text: root.subtitle;
        font-size: 13px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    // Keep the close control above nested body content. Feature dialogs may
    // raise ScrollView/list z (e.g. commit range at 3100).
    close-button := GitHubIconButton {
        visible: root.show-close;
        z: 4000;
        x: dialog-surface.x + dialog-surface.width - 40px;
        y: dialog-surface.y + 8px;
        icon: @image-url("../../assets/icons/octicon-x-16.svg");
        tooltip-text: "Close";
        show-tooltip: false;
        tooltip-above: false;
        tooltip-align-right: true;
        button-enabled: root.show-close && root.close-enabled;
        foreground: GitHubTheme.fg-muted;
        clicked => { root.close-requested(); }
    }

    if root.show-footer: Rectangle {
        x: dialog-surface.x;
        y: dialog-surface.y + dialog-surface.height - root.footer-height;
        width: dialog-surface.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }

    if root.show-footer: HorizontalLayout {
        x: dialog-surface.x + 16px;
        y: dialog-surface.y + dialog-surface.height - 48px;
        width: dialog-surface.width - 32px;
        height: 32px;
        spacing: 8px;
        alignment: end;

        Rectangle { horizontal-stretch: 1; }

        for action[index] in root.secondary-actions: GitHubButton {
            text: action;
            clicked => { root.secondary-action-clicked(index); }
        }

        if root.show-cancel: GitHubButton {
            text: root.cancel-label;
            disabled: !root.close-enabled;
            clicked => { root.cancel-clicked(); }
        }

        if root.primary-label != "": GitHubButton {
            text: root.primary-label;
            primary: root.primary-success;
            danger: root.primary-danger;
            disabled: !root.primary-enabled;
            busy: root.primary-busy;
            clicked => { root.primary-clicked(); }
        }
    }

    // Nested body content stays on the Esc capture path.
    @children
}
