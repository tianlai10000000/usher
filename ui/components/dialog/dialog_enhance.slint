import { DialogManager } from "./dialog_manager.slint";
import { GitHubDialog } from "./github_dialog.slint";
import { GitHubScrollView } from "../github_scroll_view.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";

// Imperative DialogManager adapter. All visible chrome is owned by the same
// GitHubDialog used by project, PR review, and update surfaces.
export component GitHubDialogEnhance inherits Rectangle {
    callback on-default-action-clicked(string);
    callback on-action-clicked(string, int);

    private property <length> requested-width: DialogManager.width-is-percent
        ? root.width * DialogManager.width-percent / 100
        : DialogManager.width-px;
    private property <length> requested-height: DialogManager.height-is-percent
        ? root.height * DialogManager.height-percent / 100
        : DialogManager.height-px;

    dialog-frame := GitHubDialog {
        dialog-visible: DialogManager.visible;
        show-backdrop: DialogManager.overlay;
        // DialogManager.modal blocks both Esc and backdrop dismiss.
        modal: DialogManager.modal;
        title: DialogManager.title;
        dialog-width: max(296px, root.requested-width);
        dialog-height: max(200px, root.requested-height);
        body-padding: 16px;
        dismiss-on-backdrop: !DialogManager.modal;
        secondary-actions: DialogManager.actions;
        show-cancel: false;
        primary-label: DialogManager.default-action;
        primary-success: true;
        close-requested => { DialogManager.close(); }
        secondary-action-clicked(index) => {
            root.on-action-clicked(DialogManager.id, index);
        }
        primary-clicked => {
            root.on-default-action-clicked(DialogManager.id);
        }

        if DialogManager.visible: GitHubScrollView {
            x: dialog-frame.content-x;
            y: dialog-frame.content-y;
            width: dialog-frame.content-width;
            height: dialog-frame.content-height;
            z: 3100;

            content-text := Text {
                width: dialog-frame.content-width;
                min-height: dialog-frame.content-height;
                text: DialogManager.content;
                font-size: 14px;
                color: GitHubTheme.fg-default;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }
}
