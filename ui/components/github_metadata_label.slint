import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";

// Primer-style neutral Label for concise, non-interactive contextual metadata.
// Keep it content-sized so callers can place multiple labels in a single row.
export component GitHubMetadataLabel inherits Rectangle {
    in property <string> text: "";
    // A zero value keeps the natural width; callers can bound long aliases.
    in property <length> max-label-width: 0px;

    label-measure := Text {
        visible: false;
        text: root.text;
        font-size: GitHubMetrics.text-small;
        font-weight: 500;
        wrap: no-wrap;
    }

    private property <length> natural-width:
        label-measure.preferred-width + GitHubMetrics.size-12;
    width: root.max-label-width > 0px
        ? min(root.natural-width, root.max-label-width)
        : root.natural-width;
    height: GitHubMetrics.size-20;
    // Slint does not clamp an arbitrarily large radius like CSS. Bind the
    // radius to half the fixed height so this remains a capsule, not an oval.
    border-radius: root.height / 2;
    border-width: GitHubMetrics.border-thin;
    border-color: GitHubTheme.border-default;
    background: GitHubTheme.canvas-subtle;
    vertical-stretch: 0;

    Text {
        x: GitHubMetrics.size-6;
        // Keep the optical correction inside the label so elision and the
        // rounded border cannot be disturbed by an overflowing text box.
        y: GitHubMetrics.size-2;
        width: parent.width - GitHubMetrics.size-12;
        height: parent.height - GitHubMetrics.size-2;
        text: root.text;
        font-size: GitHubMetrics.text-small;
        font-weight: 500;
        color: GitHubTheme.fg-default;
        horizontal-alignment: left;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }
}
