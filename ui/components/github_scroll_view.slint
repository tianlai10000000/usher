import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";

// Application-owned vertical viewport with GitHub/Primer semantic scrollbar
// colors. Content stays one mounted layout tree while scrolling/resizing.
export component GitHubScrollView inherits Rectangle {
    in-out property <length> viewport_x <=> scroll-area.viewport-x;
    in-out property <length> viewport_y <=> scroll-area.viewport-y;
    out property <length> visible_width: scroll-area.width;
    out property <length> visible_height: scroll-area.height;
    out property <length> content_height: content-column.preferred-height;
    in property <bool> interactive: true;
    // Disable wheel/touchpad scrolling while retaining the optional scrollbar
    // for nested editors that own their own standard ScrollView.
    in property <bool> wheel-enabled: true;
    in property <bool> show-scrollbar: true;
    // Benchmark-only legacy mode keeps the previous live-geometry mapping.
    // Production freezes the mapping for the complete direct drag gesture.
    in property <bool> stable-scrollbar-drag: true;
    // Optional blank-viewport interaction reporting for hosts that coordinate
    // transient overlays across sibling surfaces.
    in property <bool> report-pointer-interactions: false;
    // Full-size macOS content can extend beneath the native title bar. Keep
    // the document itself edge-to-edge while moving the draggable thumb out
    // of AppKit's window-drag region.
    in property <length> scrollbar-top-inset: 0px;
    in property <length> scrollbar-bottom-inset: 0px;
    callback user-scroll-started();
    callback user-wheel-direction(length);
    callback scrollbar-dragging-changed(bool);
    callback pointer-interaction-started();

    out property <bool> scrollbar-dragging: root.dragging;
    out property <length> scrollbar-drag-pointer-y: root.drag-pointer-y;
    out property <length> scrollbar-drag-thumb-y: root.displayed-thumb-y;
    out property <int> scrollbar-drag-release-revision: root.drag-release-revision;
    out property <length> scrollbar-drag-release-position: root.drag-release-position;

    private property <bool> needs-scroll:
        root.content_height > root.visible_height;
    private property <length> scrollbar-width: GitHubMetrics.size-8;
    private property <length> scrollbar-track-height: max(
        0px,
        root.height - root.scrollbar-top-inset - root.scrollbar-bottom-inset
    );
    private property <length> thumb-height:
        root.needs-scroll
            ? max(
                GitHubMetrics.size-32,
                root.scrollbar-track-height * root.visible_height
                    / max(root.visible_height, root.content_height)
            )
            : root.scrollbar-track-height;
    private property <length> scroll-range:
        max(1px, root.content_height - root.visible_height);
    private property <length> thumb-range:
        max(1px, root.scrollbar-track-height - root.thumb-height - GitHubMetrics.size-4);
    private property <bool> dragging: false;
    private property <length> drag-maximum: 0px;
    private property <length> drag-thumb-height: 0px;
    private property <length> drag-thumb-range: 0px;
    private property <length> drag-thumb-y: 0px;
    private property <length> drag-pointer-y: 0px;
    private property <length> drag-pointer-offset: 0px;
    private property <int> drag-release-revision: 0;
    private property <length> drag-release-position: 0px;
    private property <bool> pending-wheel-direction: false;
    private property <length> last-observed-viewport-y: 0px;
    private property <bool> pre-flick-wheel-movement-pending: false;
    private property <length> pre-flick-wheel-movement: 0px;
    private property <length> displayed-thumb-height:
        root.dragging && root.stable-scrollbar-drag
            ? root.drag-thumb-height
            : root.thumb-height;
    private property <length> displayed-thumb-y:
        root.dragging && root.stable-scrollbar-drag
            ? root.drag-thumb-y
            : GitHubMetrics.size-2
                + max(0px, -root.viewport_y) / root.scroll-range
                    * root.thumb-range;

    function apply-stable-drag(pointer-y: length) {
        root.drag-pointer-y = pointer-y;
        let next-thumb-y = max(
            GitHubMetrics.size-2,
            min(
                GitHubMetrics.size-2 + root.drag-thumb-range,
                pointer-y - root.drag-pointer-offset
            )
        );
        if Math.abs(next-thumb-y - root.drag-thumb-y) <= 0.25px {
            return;
        }
        root.drag-thumb-y = next-thumb-y;
        root.viewport_y = -(
            (next-thumb-y - GitHubMetrics.size-2)
                / max(1px, root.drag-thumb-range) * root.drag-maximum
        );
    }

    function begin-stable-drag(pointer-y: length) {
        root.drag-maximum = max(0px, root.content_height - root.visible_height);
        root.drag-thumb-height = root.thumb-height;
        root.drag-thumb-range = max(
            1px,
            root.scrollbar-track-height - root.drag-thumb-height - GitHubMetrics.size-4
        );
        root.drag-thumb-y = GitHubMetrics.size-2
            + max(0px, -root.viewport_y) / max(1px, root.drag-maximum)
                * root.drag-thumb-range;
        let pressed-on-thumb = pointer-y >= root.drag-thumb-y
            && pointer-y <= root.drag-thumb-y + root.drag-thumb-height;
        root.drag-pointer-offset = pressed-on-thumb
            ? pointer-y - root.drag-thumb-y
            : root.drag-thumb-height / 2;
        root.drag-pointer-y = pointer-y;
        root.dragging = true;
        root.scrollbar-dragging-changed(true);
        root.apply-stable-drag(pointer-y);
    }

    function apply-legacy-drag(pointer-y: length) {
        root.drag-pointer-y = pointer-y;
        root.viewport_y = -max(
            0px,
            min(
                root.scroll-range,
                (pointer-y - root.thumb-height / 2)
                    / root.thumb-range * root.scroll-range
            )
        );
        root.drag-thumb-y = GitHubMetrics.size-2
            + max(0px, -root.viewport_y) / root.scroll-range * root.thumb-range;
    }

    function clamp-viewport-to-content() {
        if !root.dragging {
            root.viewport_y = -max(
                0px,
                min(-root.viewport_y, root.content_height - root.visible_height)
            );
        }
    }

    background: transparent;
    clip: true;

    init => {
        root.last-observed-viewport-y = root.viewport_y;
    }

    changed viewport_y => {
        let movement = root.viewport_y - root.last-observed-viewport-y;
        root.last-observed-viewport-y = root.viewport_y;
        if root.pending-wheel-direction
            && !root.dragging
            && Math.abs(movement) > 0.25px {
            root.pending-wheel-direction = false;
            root.user-wheel-direction(movement);
        } else if !root.dragging && Math.abs(movement) > 0.25px {
            // Discrete wheel and phased touchpad events update the Flickable's
            // viewport before `flicked`; retain that synchronous movement until
            // the callback below can attribute it to user input. The zero-delay
            // timer prevents unrelated programmatic scrolling from becoming a
            // candidate for a later wheel gesture.
            root.pre-flick-wheel-movement = movement;
            root.pre-flick-wheel-movement-pending = true;
            pre-flick-wheel-expiry.restart();
        }
    }
    changed content_height => { root.clamp-viewport-to-content(); }
    changed visible_height => { root.clamp-viewport-to-content(); }

    pre-flick-wheel-expiry := Timer {
        interval: 0ms;
        running: false;
        triggered => {
            self.running = false;
            root.pre-flick-wheel-movement-pending = false;
        }
    }

    scroll-area := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: root.wheel-enabled
            ? max(self.height, content-column.preferred-height)
            : self.height;
        interactive: root.interactive;
        flicked => {
            root.user-scroll-started();
            if root.pre-flick-wheel-movement-pending {
                let movement = root.pre-flick-wheel-movement;
                root.pre-flick-wheel-movement-pending = false;
                pre-flick-wheel-expiry.stop();
                root.pending-wheel-direction = false;
                root.user-wheel-direction(movement);
            } else {
                // Unphased mouse wheels begin a physics animation before the
                // viewport changes. The first animation delta is reported by
                // `changed viewport_y` with the same movement sign as before.
                root.pending-wheel-direction = true;
            }
        }

        if root.report-pointer-interactions: viewport-interaction := TouchArea {
            width: scroll-area.width;
            height: scroll-area.viewport-height;
            clicked => { root.pointer-interaction-started(); }
        }

        content-column := VerticalLayout {
            width: scroll-area.width;
            alignment: start;
            @children
        }
    }

    if root.show-scrollbar && root.needs-scroll && root.scrollbar-track-height > 0px: Rectangle {
        x: parent.width - root.scrollbar-width;
        y: root.scrollbar-top-inset;
        width: root.scrollbar-width;
        height: root.scrollbar-track-height;
        background: transparent;
        z: 20;

        scrollbar-hit := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.user-scroll-started();
                    root.pending-wheel-direction = false;
                    if root.stable-scrollbar-drag {
                        root.begin-stable-drag(self.mouse-y);
                    } else {
                        root.dragging = true;
                        root.scrollbar-dragging-changed(true);
                        root.apply-legacy-drag(self.mouse-y);
                    }
                } else if event.kind == PointerEventKind.up
                    || event.kind == PointerEventKind.cancel {
                    if root.dragging {
                        if root.stable-scrollbar-drag {
                            root.apply-stable-drag(self.mouse-y);
                        } else {
                            root.apply-legacy-drag(self.mouse-y);
                        }
                        root.drag-release-position = root.viewport_y;
                        root.drag-release-revision += 1;
                        root.dragging = false;
                        root.scrollbar-dragging-changed(false);
                    }
                }
            }
            moved => {
                if self.pressed {
                    if root.stable-scrollbar-drag {
                        root.apply-stable-drag(self.mouse-y);
                    } else {
                        root.apply-legacy-drag(self.mouse-y);
                    }
                }
            }
        }

        Rectangle {
            x: (parent.width - GitHubMetrics.size-4) / 2;
            y: GitHubMetrics.size-2;
            width: GitHubMetrics.size-4;
            height: parent.height - GitHubMetrics.size-4;
            border-radius: GitHubMetrics.radius-small;
            background: GitHubTheme.scrollbar-track;
            opacity: scrollbar-hit.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }
        }

        scrollbar-thumb := Rectangle {
            x: (parent.width - GitHubMetrics.size-4) / 2;
            y: root.displayed-thumb-y;
            width: GitHubMetrics.size-4;
            height: root.displayed-thumb-height;
            border-radius: GitHubMetrics.radius-small;
            background: GitHubTheme.scrollbar-thumb;
            opacity: scrollbar-hit.has-hover || root.dragging ? 1 : 0.55;
            animate opacity { duration: 120ms; easing: ease-out; }
        }
    }
}

// Exact-extent scrollbar for application-owned virtual lists. The range and
// thumb geometry are captured for one direct gesture so resize/model changes
// cannot move the pointer mapping before release.
export component GitHubVirtualListScrollbar inherits Rectangle {
    in-out property <length> viewport-y;
    in property <length> visible-height;
    in property <length> content-height;
    in property <bool> enabled: true;

    private property <bool> dragging: false;
    private property <length> drag-content-height: 0px;
    private property <length> drag-maximum: 0px;
    private property <length> drag-thumb-height: 0px;
    private property <length> drag-thumb-y: 0px;
    private property <length> drag-pointer-offset: 0px;
    private property <length> live-maximum:
        max(0px, root.content-height - root.visible-height);
    private property <length> live-thumb-height:
        root.live-maximum > 0px
            ? max(
                GitHubMetrics.size-32,
                root.height * root.visible-height
                    / max(root.visible-height, root.content-height)
            )
            : root.height;
    private property <length> live-thumb-range:
        max(1px, root.height - root.live-thumb-height - GitHubMetrics.size-4);
    private property <length> live-thumb-y:
        GitHubMetrics.size-2
            + max(0px, -root.viewport-y) / max(1px, root.live-maximum)
                * root.live-thumb-range;
    private property <length> displayed-thumb-height:
        root.dragging ? root.drag-thumb-height : root.live-thumb-height;
    private property <length> displayed-thumb-y:
        root.dragging ? root.drag-thumb-y : root.live-thumb-y;

    function apply-drag(pointer-y: length) {
        let thumb-range = max(
            1px,
            root.height - root.drag-thumb-height - GitHubMetrics.size-4
        );
        let next-thumb-y = max(
            GitHubMetrics.size-2,
            min(
                GitHubMetrics.size-2 + thumb-range,
                pointer-y - root.drag-pointer-offset
            )
        );
        // macOS can continue delivering mouse-drag events after the pointer has
        // reached a track edge. One mapped thumb position owns at most one
        // viewport write per drag gesture.
        if Math.abs(next-thumb-y - root.drag-thumb-y) <= 0.25px {
            return;
        }
        root.drag-thumb-y = next-thumb-y;
        root.viewport-y = -(
            (root.drag-thumb-y - GitHubMetrics.size-2) / thumb-range
                * root.drag-maximum
        );
    }

    function begin-drag(pointer-y: length) {
        root.drag-content-height = max(root.visible-height, root.content-height);
        root.drag-maximum = max(0px, root.drag-content-height - root.visible-height);
        root.drag-thumb-height = root.live-thumb-height;
        let thumb-top = root.live-thumb-y;
        root.drag-thumb-y = thumb-top;
        let pressed-on-thumb = pointer-y >= thumb-top
            && pointer-y <= thumb-top + root.drag-thumb-height;
        root.drag-pointer-offset = pressed-on-thumb
            ? pointer-y - thumb-top
            : root.drag-thumb-height / 2;
        root.dragging = true;
        root.apply-drag(pointer-y);
    }

    visible: root.enabled && (root.dragging || root.live-maximum > 0px);
    width: GitHubMetrics.size-8;
    background: transparent;

    scrollbar-hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.begin-drag(self.mouse-y);
            } else if event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed && root.dragging {
                root.apply-drag(self.mouse-y);
            }
        }
    }

    Rectangle {
        x: (parent.width - GitHubMetrics.size-4) / 2;
        y: GitHubMetrics.size-2;
        width: GitHubMetrics.size-4;
        height: parent.height - GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-small;
        background: GitHubTheme.scrollbar-track;
        opacity: scrollbar-hit.has-hover || root.dragging ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: (parent.width - GitHubMetrics.size-4) / 2;
        y: root.displayed-thumb-y;
        width: GitHubMetrics.size-4;
        height: root.displayed-thumb-height;
        border-radius: GitHubMetrics.radius-small;
        background: GitHubTheme.scrollbar-thumb;
        opacity: scrollbar-hit.has-hover || root.dragging ? 1 : 0.55;
        animate opacity { duration: 120ms; easing: ease-out; }
    }
}
