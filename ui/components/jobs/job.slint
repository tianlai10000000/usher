import { GitHubScrollView } from "../github_scroll_view.slint";
import { AppState } from "../../state/app_state.slint";
import { GitHubCenteredLoadingState, GitHubSpinner } from "../github_spinner.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";

export struct JobLogLineItem {
    text: string,
    prefix: string,
    // GitHub workflow-command levels: plain, notice, warning, error, debug.
    kind: string,
}

export struct JobLogVirtualRow {
    line: JobLogLineItem,
    line-number: int,
    visual-lines: [string],
    offset: float,
    extent: float,
}

export struct JobLogWindow {
    rows: [JobLogVirtualRow],
    content-height: float,
    loading: bool,
}

export global JobLogLayout {
    in-out property <int> epoch: 0;
    callback layout-window([JobLogLineItem], int, float, float, float, float, int) -> JobLogWindow;
}

// Public Job input/snapshot item. Callers provide the immutable name/command
// pair; their workflow controller fills the GitHub-compatible runtime fields.
export struct JobStepItem {
    name: string,
    command: string,
    status: string,
    conclusion: string,
    detail: string,
    // Joined raw log (expandable check / diagnostics). Display uses log-lines.
    log: string,
    has-log: bool,
    log-loaded: bool,
    // Lazy, virtualized source-line model; wrapped rows keep their source number.
    log-lines: [JobLogLineItem],
    log-revision: int,
    duration: string,
    default-expanded: bool,
}

// One GitHub Actions log source line. Long content wraps onto continuation
// lines while the original source line number remains on the first visual row.
component GitHubActionsLogLineRow inherits Rectangle {
    init => {
        if AppState.benchmark-job-log-created-rows >= 0 {
            AppState.benchmark-job-log-created-rows += 1;
        }
    }
    in property <JobLogLineItem> line;
    in property <int> line-number;
    in property <color> foreground;
    in property <color> muted-foreground;
    in property <[string]> wrapped-lines;
    private property <[string]> visual-lines: root.wrapped-lines;
    private property <length> visual-line-pitch: 20px;
    private property <length> text-width: max(1px, root.width - 80px);
    private property <color> hover-background: GitHubTheme.control-muted-rest;
    private property <color> attention-background: GitHubTheme.attention-muted;
    private property <color> danger-background: GitHubTheme.diff-deletion-bg;
    private property <color> accent-background: GitHubTheme.accent-subtle;
    // Keep source-row padding separate from the pitch of wrapped visual lines.
    private property <length> min-line-height: 32px;
    // Extra vertical breathing room keeps wrapped output readable, especially
    // for CJK and long JSON lines, without changing source-line numbering.
    private property <length> pad-y: 9px;
    // Slint's preferred height is the shaped advance, not a paint-safe glyph
    // box. FemtoVG can otherwise clip CJK and punctuation at the lower edge.
    private property <length> glyph-safety-height: 4px;
    private property <length> measured-content-height: max(
        1px,
        root.measured-single-line-height + max(0, root.visual-lines.length - 1) * root.visual-line-pitch
    );
    private property <length> measured-single-line-height:
        max(1px, single-line-measure.preferred-height);
    private property <length> single-line-height:
        root.measured-single-line-height + root.glyph-safety-height;
    private property <bool> wraps:
        root.measured-content-height > root.measured-single-line-height + 1px;
    // Prefer measured-box centering over Text vertical-alignment:center —
    // font ascent/descent makes glyphs look optically high in the wash.
    private property <length> content-y: root.wraps
        ? root.pad-y
        : (root.height - root.measured-content-height) / 2;
    private property <length> number-y: root.wraps
        ? root.pad-y
        : (root.height - root.measured-single-line-height) / 2;

    width: 100%;
    height: max(root.min-line-height, root.measured-content-height + root.pad-y * 2);
    background: root.line.kind == "warning" ? root.attention-background
        : (root.line.kind == "error" ? root.danger-background
        : (root.line.kind == "notice" ? root.accent-background
        : (row-touch.has-hover ? root.hover-background : transparent)));

    single-line-measure := Text {
        visible: false;
        text: "Ag";
        wrap: no-wrap;
        font-size: 12px;
        font-family: "monospace";
    }

    Text {
        x: 16px;
        y: root.number-y;
        width: 32px;
        height: root.single-line-height;
        text: root.line-number;
        wrap: no-wrap;
        horizontal-alignment: right;
        vertical-alignment: top;
        color: root.muted-foreground;
        font-size: 12px;
        font-family: "monospace";
    }

    for visual-line[index] in root.visual-lines: Text {
        x: 64px;
        y: root.content-y + index * root.visual-line-pitch;
        width: root.text-width;
        height: root.single-line-height;
        text: visual-line;
        wrap: no-wrap;
        vertical-alignment: top;
        color: root.line.kind == "debug" ? root.muted-foreground : root.foreground;
        font-size: 12px;
        font-family: "monospace";
    }

    row-touch := TouchArea {
        width: parent.width;
        height: parent.height;
    }
}

// Reproduces the GitHub Actions job-log surface shown in
// https://docs.github.com/assets/cb-95207/images/help/repository/actions-quickstart-logs.png.
// Rows use its compact 40 px disclosure-list geometry and the matching Primer
// canvas tokens for the active application theme.
component GitHubActionsJobStepRow inherits Rectangle {
    in property <JobStepItem> step;
    in property <length> max-log-height: 420px;
    in property <bool> fill-log-height: false;
    in property <bool> expanded: false;
    in property <bool> animations-enabled: true;
    private property <bool> expandable: !root.queued && (root.step.has-log || root.running);
    private property <bool> interactive: root.expandable;
    private property <bool> keyboard-focus-visible: false;
    private property <bool> queued: root.step.status == "queued";
    private property <bool> running: root.step.status == "in_progress";
    private property <bool> succeeded:
        root.step.status == "completed" && root.step.conclusion == "success";
    private property <bool> failed:
        root.step.status == "completed" && root.step.conclusion == "failure";
    private property <bool> cancelled:
        root.step.status == "completed" && root.step.conclusion == "cancelled";
    private property <color> log-canvas: GitHubTheme.code-canvas;
    // Expanded header is the stronger muted wash; collapsed hover is lighter.
    // GitHub Actions: idle rows are bare canvas; hover then expanded fill.
    private property <color> step-header-expanded: GitHubTheme.control-muted-rest;
    private property <color> step-header-hover: GitHubTheme.code-row-hover;
    private property <color> fg-default: GitHubTheme.fg-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    callback toggle();

    width: 100%;
    height: step-layout.preferred-height;
    vertical-stretch: 0;
    background: root.log-canvas;

    step-layout := VerticalLayout {
        width: parent.width;
        spacing: 0px;
        vertical-stretch: 0;

        header := Rectangle {
            width: parent.width;
            height: 40px;
            vertical-stretch: 0;
            background: root.log-canvas;

            header-focus := FocusScope {
                width: 100%;
                height: 100%;
                accessible-role: button;
                accessible-enabled: root.interactive;
                accessible-label: root.step.name;
                accessible-checkable: root.interactive;
                accessible-checked: root.expanded;
                key-pressed(event) => {
                    root.keyboard-focus-visible = true;
                    if (root.interactive
                            && (event.text == Key.Return || event.text == " ")) {
                        root.toggle();
                        return accept;
                    }
                    return reject;
                }
                focus-gained(reason) => {
                    root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
                }
                focus-lost => {
                    root.keyboard-focus-visible = false;
                }
            }

            Rectangle {
                // Idle collapsed rows stay on the bare log canvas. Hover uses a
                // lighter wash than the expanded header (GitHub Actions job logs).
                x: 8px;
                y: 2px;
                width: parent.width - 16px;
                height: parent.height - 4px;
                border-radius: 6px;
                background: root.expanded
                    ? root.step-header-expanded
                    : (row-touch.has-hover && root.interactive
                        ? root.step-header-hover
                        : transparent);
            }

            if header-focus.has-focus && root.keyboard-focus-visible: Rectangle {
                x: 8px;
                y: 2px;
                width: parent.width - 16px;
                height: parent.height - 4px;
                border-radius: GitHubMetrics.radius-medium;
                border-width: GitHubMetrics.focus-outline-width;
                border-color: GitHubTheme.focus-outline;
                background: transparent;
            }

            // Keep the disclosure column reserved for every row so all titles
            // align exactly as they do in the GitHub Actions list.
            if root.expandable: Image {
                x: 16px;
                y: 12px;
                width: 16px;
                height: 16px;
                source: root.expanded
                    ? @image-url("../../assets/icons/octicon-chevron-down-16.svg")
                    : @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                image-fit: contain;
                colorize: root.fg-muted;
            }

            status-circle := Rectangle {
                x: 44px;
                y: 10px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: root.queued ? 1px : 0px;
                border-color: root.fg-muted;
                // Success/failure use filled 16px circle Octicons; keep this
                // slot transparent so both marks share the same visual diameter.
                background: transparent;

                if root.succeeded: Image {
                    x: 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-circle-fill-16.svg");
                    image-fit: contain;
                    // GitHub Actions: expanded success marks use default
                    // foreground; collapsed rows stay muted.
                    colorize: root.expanded ? root.fg-default : root.fg-muted;
                }

                if root.failed: Image {
                    x: 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-x-circle-fill-16.svg");
                    image-fit: contain;
                    colorize: GitHubTheme.danger-fg;
                }

                if root.cancelled: Image {
                    x: 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-stop-16.svg");
                    image-fit: contain;
                    colorize: GitHubTheme.attention-fg;
                }

                if root.running: GitHubSpinner {
                    x: 1px;
                    y: 1px;
                    spinner-size: 18px;
                    foreground: GitHubTheme.attention-fg;
                    spinning: root.animations-enabled;
                }

                if root.queued: Rectangle {
                    x: 7px;
                    y: 7px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.fg-muted;
                }
            }

            Text {
                x: 80px;
                y: 0px;
                width: parent.width - 160px;
                height: parent.height;
                text: root.step.name;
                font-size: 14px;
                font-weight: 400;
                color: root.fg-default;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: parent.width - 72px;
                y: 0px;
                width: 56px;
                height: parent.height;
                // Pending steps have not been measured yet. GitHub leaves this
                // cell empty instead of presenting a dash as a result.
                text: root.queued ? "" : root.step.duration;
                font-size: 12px;
                font-weight: 400;
                color: root.fg-muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }

            row-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: root.interactive;
                mouse-cursor: root.interactive ? pointer : default;
                clicked => {
                    root.keyboard-focus-visible = false;
                    header-focus.focus();
                    root.toggle();
                }
            }
        }

        if root.expanded: Rectangle {
            width: parent.width;
            // Run pages can fill the output frame; embedded multi-step jobs
            // retain a bounded source-row budget. Wrapped lines scroll here.
            height: root.fill-log-height ? root.max-log-height
                : min(root.max-log-height, max(60px, root.step.log-lines.length * 36px + 24px));
            vertical-stretch: 0;
            background: root.log-canvas;

            // Each source line owns a variable-height row. Wrapped continuation
            // lines stay indented under the message and do not repeat the
            // source line number, matching GitHub Actions.
            if !root.step.log-loaded || log-window.loading: GitHubCenteredLoadingState {
                width: parent.width;
                height: parent.height;
                label: I18n.jobs-loading-logs;
                foreground: root.fg-muted;
            }
            log-measure := Text {
                visible: false;
                text: "Ag";
                font-size: 12px;
                font-family: "monospace";
            }
            private property <JobLogWindow> log-window;
            private property <bool> refreshing: false;
            private property <length> observed-y: log-rows.viewport-y;
            private property <length> observed-width: log-rows.width;
            private property <length> observed-height: log-rows.height;
            private property <length> observed-line-height: log-measure.preferred-height;
            private property <int> observed-revision: root.step.log-revision;
            private property <[JobLogLineItem]> observed-lines: root.step.log-lines;
            private property <int> observed-epoch: JobLogLayout.epoch;
            function refresh-window() {
                if self.refreshing { return; }
                self.refreshing = true;
                let next = JobLogLayout.layout-window(root.step.log-lines, root.step.log-revision,
                    max(1px, log-rows.width - 80px) / 1px,
                    max(0px, -log-rows.viewport-y) / 1px,
                    log-rows.height / 1px, log-measure.preferred-height / 1px, JobLogLayout.epoch);
                self.log-window = next;
                self.refreshing = false;
            }
            init => { self.refresh-window(); }
            changed observed-y => { self.refresh-window(); }
            changed observed-width => { self.refresh-window(); }
            changed observed-height => { self.refresh-window(); }
            changed observed-line-height => { self.refresh-window(); }
            changed observed-revision => { self.refresh-window(); }
            changed observed-lines => { self.refresh-window(); }
            changed observed-epoch => { self.refresh-window(); }
            log-rows := GitHubScrollView {
                y: 12px;
                width: parent.width;
                height: parent.height - 24px;
                visible: root.step.log-loaded && !log-window.loading;
                interactive: false;
                Rectangle {
                    width: log-rows.width;
                    height: log-window.content-height * 1px;
                    for row in log-window.rows: GitHubActionsLogLineRow {
                        x: 0px;
                        y: row.offset * 1px;
                        width: parent.width;
                        height: row.extent * 1px;
                        line: row.line;
                        line-number: row.line-number;
                        wrapped-lines: row.visual-lines;
                        foreground: root.fg-default;
                        muted-foreground: root.fg-muted;
                    }
                }
            }
        }
    }
}

export component GitHubActionsJob inherits Rectangle {
    in property <length> max-log-height: 420px;
    in property <bool> fill-log-height: false;
    in property <string> title: I18n.jobs-steps;
    in property <string> summary: "";
    in property <string> empty-text: I18n.jobs-empty-steps;
    in property <[JobStepItem]> steps: [];
    // Controlled public state: the workflow owner binds snapshots into these
    // properties and may read them back without inspecting individual rows.
    in-out property <string> execution-status: "queued";
    in-out property <string> conclusion: "";
    in-out property <string> total-duration: "";
    out property <bool> is-running: root.execution-status == "in_progress";
    out property <bool> is-complete: root.execution-status == "completed";
    in property <bool> animations-enabled: true;
    // GitHub disclosures are independent: several steps may remain open.
    // The bit mask stores user overrides to each step's backend default.
    in-out property <int> expanded-step-overrides: 0;
    callback step-toggled(int);
    // Fired once when a not-yet-loaded disclosure is first opened.
    callback load-step-log(int);
    private property <color> log-canvas: GitHubTheme.code-canvas;
    private property <color> border-default: GitHubTheme.border-default;
    private property <color> fg-default: GitHubTheme.fg-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    pure function step-bit(index: int) -> int {
        return index == 0 ? 1 :
            index == 1 ? 2 :
            index == 2 ? 4 :
            index == 3 ? 8 :
            index == 4 ? 16 :
            index == 5 ? 32 :
            index == 6 ? 64 :
            index == 7 ? 128 :
            index == 8 ? 256 :
            index == 9 ? 512 :
            index == 10 ? 1024 :
            index == 11 ? 2048 :
            4096;
    }
    pure function is-overridden(index: int) -> bool {
        let bit = root.step-bit(index);
        return Math.mod(Math.floor(root.expanded-step-overrides / bit), 2) == 1;
    }
    pure function is-expanded(index: int, default-expanded: bool) -> bool {
        return default-expanded != root.is-overridden(index);
    }

    width: 100%;
    height: max(72px, steps-content.preferred-height);
    vertical-stretch: 0;
    background: root.log-canvas;
    clip: true;

    steps-content := VerticalLayout {
        width: root.width;
        spacing: 0px;
        vertical-stretch: 0;

        Rectangle {
            width: parent.width;
            height: 72px;
            vertical-stretch: 0;
            background: root.log-canvas;

            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: 26px;
                text: root.title;
                vertical-alignment: center;
                font-size: 20px;
                font-weight: 600;
                color: root.fg-default;
                overflow: elide;
            }

            Text {
                x: 16px;
                y: 38px;
                width: parent.width - 32px;
                height: 22px;
                text: root.summary;
                wrap: no-wrap;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: 400;
                color: root.fg-muted;
                overflow: elide;
            }
        }

        Rectangle {
            width: parent.width;
            height: 1px;
            vertical-stretch: 0;
            background: root.border-default;
        }

        // Keep the first step clear of the section divider and the surrounding
        // workflow card. Expanded-row insets then match all following rows.
        if root.steps.length > 0: Rectangle {
            width: parent.width;
            height: 8px;
            vertical-stretch: 0;
            background: root.log-canvas;
        }

        if root.steps.length == 0: Text {
            width: parent.width - 32px;
            x: 16px;
            height: 40px;
            vertical-stretch: 0;
            text: root.empty-text;
            vertical-alignment: center;
            color: root.fg-muted;
            font-size: 12px;
        }

        for step[index] in root.steps: GitHubActionsJobStepRow {
            max-log-height: root.max-log-height;
            fill-log-height: root.fill-log-height;
            width: parent.width;
            vertical-stretch: 0;
            step: step;
            expanded: root.is-expanded(index, step.default-expanded);
            animations-enabled: root.animations-enabled;
            toggle => {
                let opening = !root.is-expanded(index, step.default-expanded);
                let bit = root.step-bit(index);
                root.expanded-step-overrides = root.is-overridden(index)
                    ? root.expanded-step-overrides - bit
                    : root.expanded-step-overrides + bit;
                if opening && !step.log-loaded {
                    root.load-step-log(index);
                }
                root.step-toggled(index);
            }
        }
    }
}
