import { GitHubActionsJob, JobStepItem } from "job.slint";
import { GitHubVirtualListScrollbar } from "../github_scroll_view.slint";
import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";

component GitHubJobRunStatusIcon inherits Rectangle {
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <bool> animations-enabled: true;
    private property <bool> running: root.execution-status == "in_progress";
    private property <bool> succeeded:
        root.execution-status == "completed" && root.conclusion == "success";
    private property <bool> failed:
        root.execution-status == "completed" && root.conclusion == "failure";
    private property <bool> cancelled:
        root.execution-status == "completed" && root.conclusion == "cancelled";

    width: GitHubMetrics.size-24;
    height: GitHubMetrics.size-24;
    border-radius: GitHubMetrics.radius-full;
    border-width: root.execution-status == "queued" ? GitHubMetrics.border-thin : 0px;
    border-color: GitHubTheme.fg-muted;
    background: transparent;

    if root.execution-status == "queued": Rectangle {
        x: GitHubMetrics.size-8;
        y: GitHubMetrics.size-8;
        width: GitHubMetrics.size-8;
        height: GitHubMetrics.size-8;
        border-radius: GitHubMetrics.radius-full;
        background: GitHubTheme.fg-muted;
    }

    if root.running: GitHubSpinner {
        x: GitHubMetrics.size-2;
        y: GitHubMetrics.size-2;
        spinner-size: GitHubMetrics.icon-medium;
        foreground: GitHubTheme.attention-fg;
        spinning: root.animations-enabled;
    }

    if root.succeeded: Image {
        x: GitHubMetrics.size-4;
        y: GitHubMetrics.size-4;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: @image-url("../../assets/icons/octicon-check-circle-fill-16.svg");
        colorize: GitHubTheme.success-fg;
    }

    if root.failed: Image {
        x: GitHubMetrics.size-4;
        y: GitHubMetrics.size-4;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: @image-url("../../assets/icons/octicon-x-circle-fill-16.svg");
        colorize: GitHubTheme.danger-fg;
    }

    if root.cancelled: Image {
        x: GitHubMetrics.size-4;
        y: GitHubMetrics.size-4;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: @image-url("../../assets/icons/octicon-stop-16.svg");
        colorize: GitHubTheme.attention-fg;
    }
}

component GitHubJobRunJobItem inherits Rectangle {
    in property <string> job-name;
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <string> total-duration: "";
    in property <bool> animations-enabled: true;

    width: 100%;
    height: GitHubMetrics.control-medium-size;
    border-radius: GitHubMetrics.radius-medium;
    background: GitHubTheme.control-muted-rest;

    Rectangle {
        x: 0px;
        y: GitHubMetrics.size-4;
        width: GitHubMetrics.size-4;
        height: GitHubMetrics.size-24;
        border-radius: GitHubMetrics.size-2;
        background: GitHubTheme.accent-fg;
    }

    GitHubJobRunStatusIcon {
        x: GitHubMetrics.size-12;
        y: GitHubMetrics.size-4;
        execution-status: root.execution-status;
        conclusion: root.conclusion;
        animations-enabled: root.animations-enabled;
    }

    Text {
        x: GitHubMetrics.size-40;
        width: parent.width - self.x
            - (root.total-duration == "" ? GitHubMetrics.size-12 : GitHubMetrics.size-64);
        height: parent.height;
        text: root.job-name;
        font-size: GitHubMetrics.text-medium;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.total-duration != "": Text {
        x: parent.width - GitHubMetrics.size-44 - GitHubMetrics.size-12;
        width: GitHubMetrics.size-44;
        height: parent.height;
        text: root.total-duration;
        font-size: GitHubMetrics.text-small;
        color: GitHubTheme.fg-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

component GitHubJobRunHeader inherits Rectangle {
    in property <string> run-title;
    in property <string> workflow-name;
    in property <string> context-name;
    in property <string> trigger-detail;
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <bool> running: false;
    in property <bool> animations-enabled: true;
    in property <bool> compact: false;
    callback stop();

    private property <string> status-label:
        root.execution-status == "in_progress" ? I18n.jobs-in-progress
        : root.execution-status == "completed" && root.conclusion == "success" ? I18n.jobs-success
        : root.execution-status == "completed" && root.conclusion == "failure" ? I18n.jobs-failure
        : root.execution-status == "completed" && root.conclusion == "cancelled" ? I18n.jobs-cancelled
        : I18n.jobs-queued;
    private property <length> action-width: root.running ? 112px : 0px;

    width: 100%;
    height: root.compact && root.running ? 116px : 80px;
    background: transparent;

    GitHubJobRunStatusIcon {
        x: 0px;
        y: GitHubMetrics.size-4;
        execution-status: root.execution-status;
        conclusion: root.conclusion;
        animations-enabled: root.animations-enabled;
    }

    Text {
        x: GitHubMetrics.size-36;
        y: 0px;
        width: parent.width - self.x
            - (root.compact ? 0px : root.action-width);
        height: GitHubMetrics.size-32;
        text: root.run-title;
        font-size: GitHubMetrics.heading-medium;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: GitHubMetrics.size-36;
        y: GitHubMetrics.size-32;
        width: parent.width - self.x;
        height: GitHubMetrics.size-20;
        text: root.status-label + " · " + root.workflow-name + " · " + root.context-name;
        font-size: GitHubMetrics.text-small;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: GitHubMetrics.size-36;
        y: GitHubMetrics.size-48 + GitHubMetrics.size-4;
        width: parent.width - self.x;
        height: GitHubMetrics.size-20;
        text: root.trigger-detail;
        font-size: GitHubMetrics.text-small;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.running: GitHubButton {
        x: root.compact ? GitHubMetrics.size-36 : parent.width - self.width;
        y: root.compact ? GitHubMetrics.size-80 : GitHubMetrics.size-2;
        text: I18n.jobs-stop;
        danger: true;
        clicked => { root.stop(); }
    }

    Rectangle {
        y: parent.height - GitHubMetrics.border-thin;
        width: parent.width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-default;
    }
}

component GitHubJobRunJobsNav inherits Rectangle {
    in property <string> job-name;
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <string> total-duration: "";
    in property <bool> animations-enabled: true;

    width: 216px;
    height: 76px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: GitHubMetrics.size-28;
        text: I18n.jobs-title;
        font-size: GitHubMetrics.text-medium;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    GitHubJobRunJobItem {
        x: 0px;
        y: GitHubMetrics.size-32;
        width: parent.width;
        job-name: root.job-name;
        execution-status: root.execution-status;
        conclusion: root.conclusion;
        total-duration: root.total-duration;
        animations-enabled: root.animations-enabled;
    }
}

component GitHubJobRunJobFrame inherits Rectangle {
    in property <string> job-name;
    in property <string> summary;
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <string> total-duration: "";
    in property <[JobStepItem]> steps: [];
    in property <bool> animations-enabled: true;
    in-out property <int> expanded-step-overrides: 0;
    callback load-step-log(int);
    private property <length> viewport-y: 0px;
    private property <length> scroll-maximum: max(0px, run-job.height + 2px - root.height);
    changed scroll-maximum => {
        root.viewport-y = max(-root.scroll-maximum, min(0px, root.viewport-y));
    }

    width: 100%;
    border-radius: GitHubMetrics.radius-medium;
    border-width: GitHubMetrics.border-thin;
    border-color: GitHubTheme.border-default;
    background: GitHubTheme.code-canvas;
    clip: true;

    // A passive clipped viewport cannot capture phased wheel gestures or
    // pointer drags from the virtual log lists. Unhandled wheel input scrolls
    // the ordered steps, so later steps remain reachable in a fixed-height frame.
    TouchArea {
        width: parent.width;
        height: parent.height;
        scroll-event(event) => {
            if root.scroll-maximum > 0px {
                root.viewport-y = max(-root.scroll-maximum, min(0px, root.viewport-y + event.delta-y));
                return accept;
            }
            return reject;
        }
    }

    run-job := GitHubActionsJob {
        x: GitHubMetrics.border-thin;
        y: GitHubMetrics.border-thin + root.viewport-y;
        width: parent.width - GitHubMetrics.size-2 - 12px;
        max-log-height: root.steps.length == 1
            ? max(60px, root.height - 123px)
            : max(60px, min(420px, root.height - 123px));
        fill-log-height: root.steps.length == 1;
        title: root.job-name;
        summary: root.summary;
        execution-status: root.execution-status;
        conclusion: root.conclusion;
        total-duration: root.total-duration;
        steps: root.steps;
        animations-enabled: root.animations-enabled;
        expanded-step-overrides <=> root.expanded-step-overrides;
        load-step-log(index) => {
            root.load-step-log(index);
        }
    }

    steps-scrollbar := GitHubVirtualListScrollbar {
        x: parent.width - self.width;
        y: 1px;
        height: max(0px, parent.height - 2px);
        viewport-y <=> root.viewport-y;
        visible-height: parent.height - 2px;
        content-height: run-job.height;
    }
}

export component GitHubJobRunSurface {
    in property <string> run-title: I18n.common-job-run;
    in property <string> workflow-name: "Workflow";
    in property <string> context-name: "Usher";
    in property <string> job-name: "job";
    in property <string> trigger-detail: I18n.jobs-started-manually;
    in property <string> summary: "";
    in property <string> execution-status: "queued";
    in property <string> conclusion: "";
    in property <string> total-duration: "";
    in property <[JobStepItem]> steps: [];
    in property <bool> running: false;
    in property <bool> animations-enabled: true;
    callback stop();
    callback load-step-log(int);

    private property <bool> compact: root.width < GitHubMetrics.breakpoint-medium;
    private property <int> expanded-step-overrides: 0;
    private property <length> content-width:
        min(root.width, GitHubMetrics.page-wide-content-max-width);

    width: 100%;

    run-layout := Rectangle {
        x: (parent.width - root.content-width) / 2;
        width: root.content-width;
        height: root.height;
        background: transparent;

        run-header := GitHubJobRunHeader {
            x: 0px;
            y: 0px;
            run-title: root.run-title;
            workflow-name: root.workflow-name;
            context-name: root.context-name;
            trigger-detail: root.trigger-detail;
            execution-status: root.execution-status;
            conclusion: root.conclusion;
            running: root.running;
            animations-enabled: root.animations-enabled;
            compact: root.compact;
            stop => { root.stop(); }
        }

        if !root.compact: Rectangle {
            y: run-header.height + GitHubMetrics.size-20;
            width: parent.width;
            height: max(0px, root.height - self.y);
            background: transparent;

            jobs-nav := GitHubJobRunJobsNav {
                x: 0px;
                y: 0px;
                width: 216px;
                job-name: root.job-name;
                execution-status: root.execution-status;
                conclusion: root.conclusion;
                total-duration: root.total-duration;
                animations-enabled: root.animations-enabled;
            }

            job-frame := GitHubJobRunJobFrame {
                x: jobs-nav.width + GitHubMetrics.size-24;
                y: 0px;
                width: parent.width - self.x;
                height: parent.height;
                job-name: root.job-name;
                summary: root.summary;
                execution-status: root.execution-status;
                conclusion: root.conclusion;
                total-duration: root.total-duration;
                steps: root.steps;
                animations-enabled: root.animations-enabled;
                expanded-step-overrides <=> root.expanded-step-overrides;
                load-step-log(index) => { root.load-step-log(index); }
            }
        }

        if root.compact: Rectangle {
            y: run-header.height + GitHubMetrics.size-20;
            width: parent.width;
            height: max(0px, root.height - self.y);
            background: transparent;

            GitHubJobRunJobsNav {
                x: 0px;
                y: 0px;
                width: parent.width;
                job-name: root.job-name;
                execution-status: root.execution-status;
                conclusion: root.conclusion;
                total-duration: root.total-duration;
                animations-enabled: root.animations-enabled;
            }

            GitHubJobRunJobFrame {
                y: 76px + GitHubMetrics.size-16;
                width: parent.width;
                height: max(0px, parent.height - self.y);
                job-name: root.job-name;
                summary: root.summary;
                execution-status: root.execution-status;
                conclusion: root.conclusion;
                total-duration: root.total-duration;
                steps: root.steps;
                animations-enabled: root.animations-enabled;
                expanded-step-overrides <=> root.expanded-step-overrides;
                load-step-log(index) => { root.load-step-log(index); }
            }
        }
    }
}
