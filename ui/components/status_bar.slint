import { Horizontal, Vertical, MaterialText, MaterialPalette, MaterialStyleMetrics, LinearProgressIndicator } from "@material";
import { ToolTip } from "@material";
import { UpdateLogic } from "./update/update.slint";
import { NotificationManager } from "./notify/notification.slint";
import { AppState } from "../state/app_state.slint";
import { LayoutConstants } from "../layout_constants.slint";
import { ColorsTheme } from "../theme/color.slint";

// Enum to identify which popup is active
enum ActivePopup {
    None,
    UpdateCheck,
    DownloadProgress,
    Notification,
    Network,
    Version,
}

// Status bar item component - simple version without built-in popup
component StatusBarItem inherits Rectangle {
    in property <string> label;
    in property <string> tooltip-text;
    in property <bool> clickable: true;
    in property <bool> active: false;
    in property <bool> show-icon: false;
    in property <image> icon;
    in property <color> icon-color: MaterialPalette.on_surface_variant;
    
    // Output: item's absolute x position and width for popup positioning
    out property <length> item-x: self.absolute-position.x;
    out property <length> item-width: self.width;
    
    callback clicked();
    
    height: LayoutConstants.status-bar-height - 1px;
    min-width: 24px;
    background: hover-area.pressed ? MaterialPalette.surface_container_highest : 
                hover-area.has-hover ? MaterialPalette.surface_container_high : transparent;
    
    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.clickable;
        
        clicked => {
            if (root.clickable) {
                root.clicked();
            }
        }
    }
    
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        
        if root.show-icon : Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                y: parent.height / 2 - self.height / 2;
                colorize: root.icon-color;
            }
        }
        
        if root.label != "" : MaterialText {
            text: root.label;
            font-size: 12px;
            color: root.active ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface_variant;
            vertical_alignment: center;
        }
    }
    
    // Tooltip
    if hover-area.has-hover && tooltip-text != "" : ToolTip {
        y: -24px;
        text: root.tooltip-text;
    }
}

// Main status bar component
export component StatusBar inherits Rectangle {
    // Internal popup state - using enum to track which popup is active
    property <ActivePopup> active-popup: ActivePopup.None;
    property <string> popup-title: "";
    property <string> popup-content: "";
    
    // Popup dimensions
    property <length> popup-width: 220px;
    
    // Dynamic anchor position - binds to the currently active item's real-time position
    property <length> popup-anchor-x: 
        active-popup == ActivePopup.UpdateCheck ? update-check-item.item-x :
        active-popup == ActivePopup.DownloadProgress ? download-progress-item.item-x :
        active-popup == ActivePopup.Notification ? notification-item.item-x :
        active-popup == ActivePopup.Network ? network-item.item-x :
        active-popup == ActivePopup.Version ? version-item.item-x : 0px;
    
    property <length> popup-anchor-width:
        active-popup == ActivePopup.UpdateCheck ? update-check-item.item-width :
        active-popup == ActivePopup.DownloadProgress ? download-progress-item.item-width :
        active-popup == ActivePopup.Notification ? notification-item.item-width :
        active-popup == ActivePopup.Network ? network-item.item-width :
        active-popup == ActivePopup.Version ? version-item.item-width : 0px;
    
    // Convert absolute anchor x to relative x (relative to StatusBar)
    property <length> popup-anchor-rel-x: popup-anchor-x - root.absolute-position.x;
    
    // Helper: center x position (before clamping)
    property <length> popup-center-x: popup-anchor-rel-x + (popup-anchor-width / 2) - (popup-width / 2);
    // Helper: min x (left edge margin)
    property <length> popup-min-x: 8px;
    // Helper: max x (right edge margin)
    property <length> popup-max-x: root.width - popup-width - 8px;
    
    // Calculate popup x position: center above the anchor, with boundary clamping
    property <length> popup-x: 
        popup-center-x < popup-min-x ? popup-min-x : 
        (popup-center-x > popup-max-x ? popup-max-x : popup-center-x);
    
    height: LayoutConstants.status-bar-height;
    background: MaterialPalette.surface_container_low;

    Vertical {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding: 0px;

        // Top border
        Rectangle {
            width: 100%;
            height: 1px;
            background: MaterialPalette.outline_variant;
        }
        
        HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;
            padding: 0px;
                
            // Left status item container
            status-items-left := HorizontalLayout {
                spacing: 0px;
                alignment: start;
                
                // Update check status
                update-check-item := StatusBarItem {
                    label: UpdateLogic.checking-update ? "Update Checking..." : "";
                    tooltip-text: "Checking for updates...";
                    active: UpdateLogic.checking-update;
                    visible: UpdateLogic.checking-update;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.UpdateCheck) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Update Check";
                            root.popup-content = "Checking if an update is available, please wait...";
                            root.active-popup = ActivePopup.UpdateCheck;
                        }
                    }
                }
                
                // Download progress status
                download-progress-item := Rectangle {
                    property <length> item-x: self.absolute-position.x;
                    property <length> item-width: self.width;
                    
                    height: LayoutConstants.status-bar-height - 1px;
                    visible: UpdateLogic.is-downloading;
                    background: hover-area.pressed ? MaterialPalette.surface_container_highest : 
                                hover-area.has-hover ? MaterialPalette.surface_container_high : transparent;
                    
                    hover-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        
                        clicked => {
                            if (root.active-popup == ActivePopup.DownloadProgress) {
                                root.active-popup = ActivePopup.None;
                            } else {
                                root.popup-title = "Download Progress";
                                root.popup-content = "Downloading: " + UpdateLogic.new-version + "\n" +
                                    "Progress: " + Math.round(UpdateLogic.download-progress * 100) + "%\n" +
                                    "Status: " + UpdateLogic.download-status;
                                root.active-popup = ActivePopup.DownloadProgress;
                            }
                        }
                    }
                    
                    Horizontal {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 8px;
                        
                        MaterialText {
                            text: "Downloading " + Math.round(UpdateLogic.download-progress * 100) + "%";
                            font-size: 12px;
                            color: MaterialPalette.primary;
                            vertical_alignment: center;
                        }
                        
                        Rectangle {
                            width: 60px;
                            height: 4px;
                            background: MaterialPalette.surface_container_highest;
                            border-radius: 2px;
                            
                            Rectangle {
                                width: parent.width * UpdateLogic.download-progress;
                                height: 100%;
                                background: MaterialPalette.primary;
                                border-radius: 2px;
                            }
                        }
                    }
                    
                    // Tooltip
                    if hover-area.has-hover : ToolTip {
                        y: -28px;
                        text: "Download progress: " + Math.round(UpdateLogic.download-progress * 100) + "%\n" +
                            UpdateLogic.download-status;
                    }
                }
                
                // Notification status
                notification-item := StatusBarItem {
                    label: "Notifications " + NotificationManager.queue.length;
                    tooltip-text: NotificationManager.queue.length > 0 ? 
                                (NotificationManager.queue.length + " unread notifications") : 
                                "No notifications";
                    active: NotificationManager.queue.length > 0;
                    visible: true;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Notification) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Notifications";
                            root.popup-content = NotificationManager.queue.length > 0 ? 
                                ("Currently " + NotificationManager.queue.length + " unread notifications") :
                                "No notifications";
                            root.active-popup = ActivePopup.Notification;
                        }
                    }
                }
            }
            
            // Middle spacer (for left/right alignment)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            
            // Right status item container
            status-items-right := HorizontalLayout {
                spacing: 0px;
                alignment: end;
                
                // Network status (simple online indicator)
                network-item := StatusBarItem {
                    label: "";
                    tooltip-text: AppState.network-online ? "Network connected" : "Network disconnected";
                    active: AppState.network-online;
                    visible: true;
                    show-icon: true;
                    icon: AppState.network-online ? @image-url("../assets/icons/wifi.svg") : @image-url("../assets/icons/wifi_off.svg");
                    icon-color: AppState.network-online ? ColorsTheme.success : ColorsTheme.error;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Network) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Network Status";
                            root.popup-content = AppState.network-online ? "Network connected" : "Network disconnected";
                            root.active-popup = ActivePopup.Network;
                        }
                    }
                }
                
                // Application version info
                version-item := StatusBarItem {
                    label: "v" + AppState.version;
                    tooltip-text: "Version: " + AppState.version;
                    active: true;
                    visible: AppState.version != "";
                    clickable: true;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Version) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Version: ";
                            root.popup-content = "Version: " + AppState.version;
                            root.active-popup = ActivePopup.Version;
                        }
                    }
                }
            }
        }
    }
    
    // Click-outside-to-close overlay (covers area above status bar only)
    if active-popup != ActivePopup.None : Rectangle {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: 9999px;
        height: root.absolute-position.y;
        background: transparent;
        
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.active-popup = ActivePopup.None;
            }
        }
    }
    
    // Popup overlay - displayed above status bar, responsive to layout changes
    if active-popup != ActivePopup.None : Rectangle {
        x: root.popup-x;
        y: -popup-content-layout.preferred-height - 2px;
        width: root.popup-width;
        height: popup-content-layout.preferred-height;
        background: MaterialPalette.surface_container_high;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000050;
        
        // Popup content - height auto-expands based on content (flex-like)
        popup-content-layout := VerticalLayout {
            width: 100%;
            spacing: 8px;
            padding: 12px;
            
            if root.popup-title != "" : MaterialText {
                width: root.popup-width - 24px;
                text: root.popup-title;
                font-size: 14px;
                font-weight: 600;
                color: MaterialPalette.on_surface;
                overflow: elide;
            }
            
            if root.popup-content != "" : MaterialText {
                width: root.popup-width - 24px;
                text: root.popup-content;
                font-size: 12px;
                color: MaterialPalette.on_surface_variant;
                wrap: word-wrap;
            }
        }
    }
}
