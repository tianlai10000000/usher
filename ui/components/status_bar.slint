import { UpdateLogic } from "./update/update.slint";
import { NotificationManager } from "./notify/notification.slint";
import { AppState } from "../state/app_state.slint";
import { LayoutConstants } from "../layout_constants.slint";
import { GitHubTooltip } from "./github_tooltip.slint";
import { GitHubActionMenu } from "./github_action_menu.slint";
import { GitHubProgressBar } from "./github_progress_bar.slint";
import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";

// Enum to identify which popup is active
enum ActivePopup {
    None,
    UpdateCheck,
    DownloadProgress,
    Notification,
    Network,
    Version,
}

// Status bar item component - simple version without built-in popup
component GitHubStatusBarItem inherits Rectangle {
    in property <string> label;
    in property <string> tooltip-text;
    in property <bool> clickable: true;
    in property <bool> active: false;
    in property <bool> show-icon: false;
    in property <image> icon;
    in property <color> icon-color: GitHubTheme.fg-muted;
    private property <bool> keyboard-focus-visible: false;
    property <color> fg-muted: GitHubTheme.fg-muted;
    property <color> control-hover: GitHubTheme.control-transparent-hover;
    property <color> control-active: GitHubTheme.control-transparent-active;
    
    // Output: item's absolute x position and width for popup positioning
    out property <length> item-x: self.absolute-position.x;
    out property <length> item-width: self.width;
    
    callback clicked();
    
    height: LayoutConstants.status-bar-height - 1px;
    min-width: 28px;
    border-radius: 6px;
    background: hover-area.pressed ? root.control-active :
                hover-area.has-hover || root.active ? root.control-hover : transparent;

    status-focus := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.clickable;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }
    
    hover-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.clickable;
        
        clicked => {
            if (root.clickable) {
                root.keyboard-focus-visible = false;
                status-focus.focus();
                root.clicked();
            }
        }
    }
    
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 4px;
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        
        if root.show-icon : Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                y: parent.height / 2 - self.height / 2;
                colorize: root.icon-color;
            }
        }
        
        if root.label != "" : Text {
            text: root.label;
            font-size: 12px;
            color: root.fg-muted;
            vertical-alignment: center;
        }
    }

    if status-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height - GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
    
    // Tooltip
    if hover-area.has-hover && tooltip-text != "" : GitHubTooltip {
        y: -24px;
        text: root.tooltip-text;
    }
}

// GitHub has no persistent web status bar equivalent. This desktop utility
// surface composes Primer canvas, border, typography, control and overlay tokens.
export component GitHubStatusBar inherits Rectangle {
    // Internal popup state - using enum to track which popup is active
    property <ActivePopup> active-popup: ActivePopup.None;
    property <string> popup-title: "";
    property <string> popup-content: "";
    
    // Popup dimensions
    property <length> popup-width: 220px;
    property <color> canvas-default: GitHubTheme.canvas-default;
    property <color> canvas-subtle: GitHubTheme.canvas-subtle;
    property <color> fg-default: GitHubTheme.fg-default;
    property <color> fg-muted: GitHubTheme.fg-muted;
    property <color> border-default: GitHubTheme.border-default;
    property <color> accent-fg: GitHubTheme.accent-fg;
    property <color> success-fg: GitHubTheme.success-fg;
    property <color> danger-fg: GitHubTheme.danger-fg;
    property <color> control-hover: GitHubTheme.control-transparent-hover;
    property <color> control-active: GitHubTheme.control-transparent-active;
    
    // Dynamic anchor position - binds to the currently active item's real-time position
    property <length> popup-anchor-x: 
        active-popup == ActivePopup.UpdateCheck ? update-check-item.item-x :
        active-popup == ActivePopup.DownloadProgress ? download-progress-item.item-x :
        active-popup == ActivePopup.Notification ? notification-item.item-x :
        active-popup == ActivePopup.Network ? network-item.item-x :
        active-popup == ActivePopup.Version ? version-item.item-x : 0px;
    
    property <length> popup-anchor-width:
        active-popup == ActivePopup.UpdateCheck ? update-check-item.item-width :
        active-popup == ActivePopup.DownloadProgress ? download-progress-item.item-width :
        active-popup == ActivePopup.Notification ? notification-item.item-width :
        active-popup == ActivePopup.Network ? network-item.item-width :
        active-popup == ActivePopup.Version ? version-item.item-width : 0px;
    
    // Convert absolute anchor x to relative x (relative to GitHubStatusBar)
    property <length> popup-anchor-rel-x: popup-anchor-x - root.absolute-position.x;
    
    height: LayoutConstants.status-bar-height;
    background: root.canvas-subtle;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding: 0px;

        // Top border
        Rectangle {
            width: 100%;
            height: 1px;
            background: root.border-default;
        }
        
        HorizontalLayout {
            width: 100%;
            vertical-stretch: 1;
            spacing: 0px;
            padding-left: 8px;
            padding-right: 8px;
                
            // Left status item container
            status-items-left := HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 0px;
                alignment: start;
                
                // Update check status
                update-check-item := GitHubStatusBarItem {
                    label: UpdateLogic.checking-update ? "Update Checking..." : "";
                    tooltip-text: "Checking for updates...";
                    active: UpdateLogic.checking-update;
                    visible: UpdateLogic.checking-update;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.UpdateCheck) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Update Check";
                            root.popup-content = "Checking if an update is available, please wait...";
                            root.active-popup = ActivePopup.UpdateCheck;
                        }
                    }
                }
                
                // Download progress status
                download-progress-item := Rectangle {
                    property <length> item-x: self.absolute-position.x;
                    property <length> item-width: self.width;
                    
                    height: LayoutConstants.status-bar-height - 1px;
                    visible: UpdateLogic.is-downloading;
                    border-radius: 6px;
                    background: hover-area.pressed ? root.control-active :
                                hover-area.has-hover ? root.control-hover : transparent;
                    
                    hover-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        
                        clicked => {
                            if (root.active-popup == ActivePopup.DownloadProgress) {
                                root.active-popup = ActivePopup.None;
                            } else {
                                root.popup-title = "Download Progress";
                                root.popup-content = "Downloading: " + UpdateLogic.new-version + "\n" +
                                    "Progress: " + Math.round(UpdateLogic.download-progress * 100) + "%\n" +
                                    "Status: " + UpdateLogic.download-status;
                                root.active-popup = ActivePopup.DownloadProgress;
                            }
                        }
                    }
                    
                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 8px;
                        
                        Text {
                            text: "Downloading " + Math.round(UpdateLogic.download-progress * 100) + "%";
                            font-size: 12px;
                            color: root.accent-fg;
                            vertical-alignment: center;
                        }

                        GitHubProgressBar {
                            width: 60px;
                            height: 4px;
                            progress: UpdateLogic.download-progress;
                            foreground: root.accent-fg;
                        }
                    }
                    
                    // Tooltip
                    if hover-area.has-hover : GitHubTooltip {
                        y: -28px;
                        text: "Download progress: " + Math.round(UpdateLogic.download-progress * 100) + "%\n" +
                            UpdateLogic.download-status;
                    }
                }
                
                // Notification status
                notification-item := GitHubStatusBarItem {
                    label: "Notifications " + NotificationManager.queue.length;
                    tooltip-text: NotificationManager.queue.length > 0 ? 
                                (NotificationManager.queue.length + " unread notifications") : 
                                "No notifications";
                    active: NotificationManager.queue.length > 0;
                    visible: true;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Notification) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Notifications";
                            root.popup-content = NotificationManager.queue.length > 0 ? 
                                ("Currently " + NotificationManager.queue.length + " unread notifications") :
                                "No notifications";
                            root.active-popup = ActivePopup.Notification;
                        }
                    }
                }
            }
            
            // Middle spacer (for left/right alignment)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            
            // Right status item container
            status-items-right := HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 0px;
                alignment: end;
                
                // Network status (simple online indicator)
                network-item := GitHubStatusBarItem {
                    label: "";
                    tooltip-text: AppState.network-online ? "Network connected" : "Network disconnected";
                    active: root.active-popup == ActivePopup.Network;
                    visible: true;
                    show-icon: true;
                    icon: AppState.network-online
                        ? @image-url("../assets/icons/octicon-broadcast-16.svg")
                        : @image-url("../assets/icons/octicon-alert-16.svg");
                    icon-color: AppState.network-online ? root.success-fg : root.danger-fg;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Network) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Network Status";
                            root.popup-content = AppState.network-online ? "Network connected" : "Network disconnected";
                            root.active-popup = ActivePopup.Network;
                        }
                    }
                }
                
                // Application version info
                version-item := GitHubStatusBarItem {
                    label: "v" + AppState.version;
                    tooltip-text: "Version: " + AppState.version;
                    active: root.active-popup == ActivePopup.Version;
                    visible: AppState.version != "";
                    clickable: true;
                    
                    clicked => {
                        if (root.active-popup == ActivePopup.Version) {
                            root.active-popup = ActivePopup.None;
                        } else {
                            root.popup-title = "Version: ";
                            root.popup-content = "Version: " + AppState.version;
                            root.active-popup = ActivePopup.Version;
                        }
                    }
                }
            }
        }
    }
    
    // Click-outside-to-close overlay (covers area above status bar only)
    if active-popup != ActivePopup.None : Rectangle {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: 9999px;
        height: root.absolute-position.y;
        background: transparent;
        
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.active-popup = ActivePopup.None;
            }
        }
    }
    
    // Popup overlay - Primer AnchoredOverlay flips above this bottom anchor and
    // scrolls internally if the window is shorter than its content.
    if active-popup != ActivePopup.None : GitHubActionMenu {
        open: true;
        viewport-x: -root.absolute-position.x;
        viewport-y: -root.absolute-position.y;
        viewport-width: root.width;
        viewport-height: root.absolute-position.y + root.height;
        anchor-x: root.popup-anchor-rel-x;
        anchor-y: 0px;
        anchor-width: root.popup-anchor-width;
        anchor-height: root.height;
        menu-width: root.popup-width;
        content-height: popup-content-layout.preferred-height;
        align: "center";
        side: "top";
        dismiss-requested => { root.active-popup = ActivePopup.None; }

        Rectangle {
            width: parent.width;
            height: popup-content-layout.preferred-height;

            // Popup content - height auto-expands based on content (flex-like)
            popup-content-layout := VerticalLayout {
                width: 100%;
                spacing: 8px;
                padding: 12px;

                if root.popup-title != "" : Text {
                    width: root.popup-width - 24px;
                    text: root.popup-title;
                    font-size: 14px;
                    font-weight: 600;
                    color: root.fg-default;
                    overflow: elide;
                }

                if root.popup-content != "" : Text {
                    width: root.popup-width - 24px;
                    text: root.popup-content;
                    font-size: 12px;
                    color: root.fg-muted;
                    wrap: word-wrap;
                }
            }
        }
    }
}
