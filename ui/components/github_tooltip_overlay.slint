import { TooltipOverlayState } from "../state/tooltip_overlay_state.slint";
import { GitHubTooltipSurface } from "./github_tooltip.slint";

// Window-root host for the shared tooltip portal. It has no input handler, so
// its full-window geometry can clamp painted tips without stealing hits.
export component GitHubTooltipOverlayHost inherits Rectangle {
    private property <int> observed-lease: 0;

    width: 100%;
    height: 100%;
    background: transparent;
    clip: false;

    if TooltipOverlayState.open && TooltipOverlayState.text != "": GitHubTooltipSurface {
        x: max(
            8px,
            min(
                TooltipOverlayState.x - root.absolute-position.x,
                root.width - self.width - 8px,
            ),
        );
        y: max(
            8px,
            min(
                TooltipOverlayState.y - root.absolute-position.y,
                root.height - self.height - 8px,
            ),
        );
        text: TooltipOverlayState.text;
    }

    lease-watch := Timer {
        interval: 48ms;
        running: TooltipOverlayState.open;
        triggered => {
            if TooltipOverlayState.lease == root.observed-lease {
                TooltipOverlayState.hide(TooltipOverlayState.token);
            } else {
                root.observed-lease = TooltipOverlayState.lease;
            }
        }
    }
}
