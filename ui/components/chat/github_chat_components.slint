import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { GitHubLink } from "../github_link.slint";


export enum MessageRole {
    User,
    Assistant,
}

export enum MessageStatus {
    Normal,
    Error,
    Success,
}

export struct ChatMessage {
    id: int,
    role: MessageRole,
    status: MessageStatus,
    content: string,
    rendered_content: string,
    preview_available: bool,
    preview_title: string,
    timestamp: string,
}

export struct ChatSelectionRect {
    x: float,
    y: float,
    width: float,
    height: float,
}

// Plain Text is the only layout owner. The selection rectangles and pointer
// surface are overlays, so beginning or extending a selection cannot remeasure
// the message bubble or move the Chat viewport.
component GitHubSelectableMessageText inherits Rectangle {
    in property <int> message-id: 0;
    in property <string> text;
    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <brush> text-color: GitHubTheme.fg-default;
    in property <bool> selection-active: false;
    in property <int> selection-start: 0;
    in property <int> selection-end: 0;

    callback selection-begin(int, int);
    callback selection-update(int, int);
    callback selection-finished();
    pure callback resolve-hit(string, float, float, float, float, string, float) -> int;
    pure callback resolve-selection-rects(string, int, int, float, float, string, float) -> [ChatSelectionRect];

    height: message-text.preferred-height;
    clip: true;

    line-probe := Text {
        width: 0px;
        height: 0px;
        visible: false;
        text: "Ag";
        font-family: root.font-family;
        font-size: root.font-size;
        wrap: no-wrap;
    }
    private property <length> line-pitch: max(1px, line-probe.preferred-height);

    if root.selection-active && root.selection-start != root.selection-end: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        private property <[ChatSelectionRect]> rects: root.resolve-selection-rects(
            root.text,
            root.selection-start,
            root.selection-end,
            root.width / 1px,
            root.line-pitch / 1px,
            root.font-family,
            root.font-size / 1px
        );
        for rect in self.rects: Rectangle {
            x: rect.x * 1px;
            y: rect.y * 1px;
            width: rect.width * 1px;
            height: rect.height * 1px;
            background: GitHubTheme.accent-muted;
        }
    }

    message-text := Text {
        width: parent.width;
        text: root.text;
        color: root.text-color;
        wrap: word-wrap;
        font-family: root.font-family;
        font-size: root.font-size;
    }

    text-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.text;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.selection-begin(
                    root.message-id,
                    root.resolve-hit(
                        root.text,
                        max(0px, min(self.mouse-x, root.width)) / 1px,
                        max(0px, min(self.mouse-y, root.height)) / 1px,
                        root.width / 1px,
                        root.line-pitch / 1px,
                        root.font-family,
                        root.font-size / 1px
                    )
                );
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.selection-finished();
            }
        }
        moved => {
            if !self.pressed { return; }
            root.selection-update(
                root.message-id,
                root.resolve-hit(
                    root.text,
                    max(0px, min(self.mouse-x, root.width)) / 1px,
                    max(0px, min(self.mouse-y, root.height)) / 1px,
                    root.width / 1px,
                    root.line-pitch / 1px,
                    root.font-family,
                    root.font-size / 1px
                )
            );
        }
    }
}

export component GitHubMessageBubble inherits Rectangle {
    in property <int> message-id: 0;
    in property <MessageRole> role;
    in property <MessageStatus> status: MessageStatus.Normal;
    in property <string> content;
    in property <string> rendered-content;
    in property <bool> preview-available: false;
    in property <string> preview-title: "";
    in property <string> timestamp;
    in property <bool> is-loading: false;
    in property <bool> performance-optimized: true;
    in property <string> application-font-family;
    in property <bool> selection-active: false;
    in property <int> selection-start: 0;
    in property <int> selection-end: 0;
    // 消息最大宽度（由外层 Chat 根据窗口宽度动态计算）
    in property <length> max-bubble-width: 420px;

    // 低频等待动效相位（由 Rust 定时器每 500ms 更新一次）
    in property <int> loading-phase: 0;

    callback open-artifact(int, string, string);
    callback selection-begin(int, int);
    callback selection-update(int, int);
    callback selection-finished();
    pure callback resolve-text-hit(string, float, float, float, float, string, float) -> int;
    pure callback resolve-selection-rects(string, int, int, float, float, string, float) -> [ChatSelectionRect];

    // The lightweight host stays mounted while the role-specific subtree is
    // selected below. This keeps height measurement valid when the optimized
    // variant does not instantiate the inactive role at all.
    height: role-host.preferred-height;
    background: transparent;

    role-host := VerticalLayout {
        spacing: 0px;

        // 用户消息布局（右对齐）
        if root.role == MessageRole.User || !root.performance-optimized: HorizontalLayout {
            visible: root.role == MessageRole.User;
            height: root.role == MessageRole.User ? self.preferred-height : 0px;
            spacing: 8px;
            alignment: end;

            // 发送的消息内容
            Rectangle {
                max-width: root.max-bubble-width;
                height: user-content.preferred-height;
                background: GitHubTheme.accent-subtle;
                border-radius: GitHubMetrics.radius-medium;
                border-width: GitHubMetrics.border-thin;
                border-color: GitHubTheme.accent-muted;

                user-content := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;

                    GitHubSelectableMessageText {
                        horizontal-stretch: 1;
                        message-id: root.message-id;
                        text: root.content;
                        text-color: GitHubTheme.fg-default;
                        font-family: root.application-font-family;
                        font-size: 14px;
                        selection-active: root.selection-active;
                        selection-start: root.selection-start;
                        selection-end: root.selection-end;
                        selection-begin(message-id, position) => { root.selection-begin(message-id, position); }
                        selection-update(message-id, position) => { root.selection-update(message-id, position); }
                        selection-finished => { root.selection-finished(); }
                        resolve-hit(text, x, y, width, pitch, family, size) => {
                            root.resolve-text-hit(text, x, y, width, pitch, family, size)
                        }
                        resolve-selection-rects(text, start, end, width, pitch, family, size) => {
                            root.resolve-selection-rects(text, start, end, width, pitch, family, size)
                        }
                    }

                    Text {
                        text: root.timestamp;
                        color: GitHubTheme.fg-muted;
                        font-size: 11px;
                        horizontal-alignment: right;
                    }
                }

            }

            // 用户头像
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: GitHubTheme.success-muted;

                Text {
                    text: "U";
                    color: GitHubTheme.success-fg;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // AI 消息布局（左对齐）
        if root.role == MessageRole.Assistant || !root.performance-optimized: HorizontalLayout {
            visible: root.role == MessageRole.Assistant;
            height: root.role == MessageRole.Assistant ? self.preferred-height : 0px;
            spacing: 8px;
            alignment: start;

            // AI 头像
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: GitHubTheme.done-muted;

                Text {
                    text: "AI";
                    color: GitHubTheme.done-fg;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 消息内容
            Rectangle {
                max-width: root.max-bubble-width;
                height: ai-content.preferred-height;
                background: GitHubTheme.canvas-subtle;
                border-radius: GitHubMetrics.radius-medium;
                border-width: GitHubMetrics.border-thin;
                border-color: GitHubTheme.border-default;

                ai-content := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;

                    // 加载状态
                    HorizontalLayout {
                        visible: root.is-loading;
                        height: root.is-loading ? self.preferred-height : 0px;
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "●";
                            color: GitHubTheme.success-emphasis;
                            font-size: 12px;
                        }

                        Text {
                            text: "Thinking";
                            color: GitHubTheme.fg-muted;
                            font-size: 14px;
                        }

                        Text {
                            text: root.loading-phase == 0 ? "." :
                                  root.loading-phase == 1 ? ".." : "...";
                            color: GitHubTheme.fg-muted;
                            font-size: 14px;
                        }
                    }

                    if !root.is-loading && root.preview-available: HorizontalLayout {
                        height: GitHubMetrics.size-24;
                        spacing: GitHubMetrics.size-6;
                        alignment: start;

                        Image {
                            width: GitHubMetrics.icon-medium;
                            height: GitHubMetrics.icon-medium;
                            source: @image-url("../../assets/icons/octicon-file-diff-16.svg");
                            colorize: GitHubTheme.accent-fg;
                        }
                        GitHubLink {
                            text: root.preview-title;
                            clicked => { root.open-artifact(root.message-id, root.preview-title, root.content); }
                        }
                    }

                    // Chat keeps a readable width-independent plain-text projection.
                    HorizontalLayout {
                        visible: !root.is-loading;
                        height: !root.is-loading ? self.preferred-height : 0px;
                        spacing: root.status == MessageStatus.Normal ? 0px : 6px;
                        alignment: start;

                        if root.status != MessageStatus.Normal: Image {
                            width: 16px;
                            height: 16px;
                            source: root.status == MessageStatus.Error
                                ? @image-url("../../assets/icons/octicon-x-circle-fill-16.svg")
                                : @image-url("../../assets/icons/octicon-check-circle-fill-16.svg");
                            colorize: root.status == MessageStatus.Error
                                ? GitHubTheme.danger-fg
                                : GitHubTheme.success-fg;
                        }

                        GitHubSelectableMessageText {
                            horizontal-stretch: 1;
                            message-id: root.message-id;
                            text: root.rendered-content;
                            text-color: GitHubTheme.fg-default;
                            font-family: root.application-font-family;
                            font-size: 14px;
                            selection-active: root.selection-active;
                            selection-start: root.selection-start;
                            selection-end: root.selection-end;
                            selection-begin(message-id, position) => { root.selection-begin(message-id, position); }
                            selection-update(message-id, position) => { root.selection-update(message-id, position); }
                            selection-finished => { root.selection-finished(); }
                            resolve-hit(text, x, y, width, pitch, family, size) => {
                                root.resolve-text-hit(text, x, y, width, pitch, family, size)
                            }
                            resolve-selection-rects(text, start, end, width, pitch, family, size) => {
                                root.resolve-selection-rects(text, start, end, width, pitch, family, size)
                            }
                        }
                    }

                    // 时间戳
                    Text {
                        visible: !root.is-loading && root.timestamp != "";
                        height: (!root.is-loading && root.timestamp != "") ? self.preferred-height : 0px;
                        text: root.timestamp;
                        color: GitHubTheme.fg-muted.with_alpha(0.7);
                        font-size: 11px;
                        horizontal-alignment: left;
                    }
                }

            }
        }
    }
}

export component GitHubChatWelcomeView inherits Rectangle {
    in property <[string]> suggestions: [
        "What can you help me with?",
        "Tell me a joke",
        "Explain quantum computing",
    ];

    callback suggestion-clicked(string);

    background: transparent;

    VerticalLayout {
        width: min(parent.width, 560px);
        x: (parent.width - self.width) / 2;
        alignment: center;
        spacing: GitHubMetrics.size-12;
        padding: GitHubMetrics.size-32;

        Text {
            text: "Welcome to Usher Chat";
            color: GitHubTheme.fg-default;
            font-size: GitHubMetrics.heading-small;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: "Start a conversation by typing a message below.";
            color: GitHubTheme.fg-muted;
            font-size: 14px;
            horizontal-alignment: center;
        }

        Rectangle {
            width: max(0px, parent.width - GitHubMetrics.size-64);
            height: suggestion-list.preferred-height;
            background: transparent;

            suggestion-list := VerticalLayout {
                x: (parent.width - self.width) / 2;
                width: min(parent.width, 420px);
                spacing: GitHubMetrics.size-8;
                padding-top: GitHubMetrics.size-16;

                Text {
                    text: "Try asking:";
                    color: GitHubTheme.fg-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                for suggestion[idx] in root.suggestions: GitHubButton {
                    width: parent.width;
                    text: suggestion;
                    clicked => { root.suggestion-clicked(suggestion); }
                }
            }
        }
    }
}
