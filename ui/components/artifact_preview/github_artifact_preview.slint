import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { AppState } from "../../state/app_state.slint";
import { Palette } from "std-widgets.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubCopyButton } from "../button/github_copy_button.slint";
import { GitHubScrollView, GitHubVirtualListScrollbar } from "../github_scroll_view.slint";
import { GitHubCenteredLoadingState } from "../github_spinner.slint";
import { GitHubMarkdownMetrics } from "../markdown/github_markdown_typography.slint";
import { I18n } from "@i18n";

export enum ArtifactPreviewKind {
    None,
    Markdown,
    Image,
    PlainText,
    Error,
}

export enum ArtifactPreviewBlockKind {
    Heading1,
    Heading2,
    Heading3,
    Heading4,
    Heading5,
    Heading6,
    Paragraph,
    ListItem,
    Quote,
    CodeBlock,
    Rule,
    TableRow,
}

export enum ArtifactPreviewInlineKind {
    Text,
    Strong,
    Emphasis,
    Strikethrough,
    Code,
    Link,
}

export struct ArtifactPreviewInlineSpan {
    kind: ArtifactPreviewInlineKind,
    start: int,
    end: int,
}

export struct ArtifactPreviewCodeToken {
    text: string,
    light-color: color,
    dark-color: color,
    bold: bool,
    italic: bool,
}

export struct ArtifactPreviewCodeLine {
    tokens: [ArtifactPreviewCodeToken],
}

export struct ArtifactPreviewBlock {
    kind: ArtifactPreviewBlockKind,
    styled: styled-text,
    list-marker: string,
    list-depth: int,
    code-lines: [ArtifactPreviewCodeLine],
    code-language: string,
    plain-text: string,
    layout-spans: [ArtifactPreviewInlineSpan],
}

export struct ArtifactPreviewVirtualRow {
    index: int,
    start: float,
    size: float,
    block: ArtifactPreviewBlock,
}

export struct ArtifactPreviewVirtualWindow {
    rows: [ArtifactPreviewVirtualRow],
    scroll-offset: float,
    content-height: float,
    projection-revision: int,
    layout-width: float,
    loading: bool,
}

component GitHubArtifactPreviewMarkdownBlock inherits Rectangle {
    in property <ArtifactPreviewBlock> block;
    in property <length> forced-height: 0px;
    in property <bool> virtual-code: false;
    in property <length> code-viewport-offset: 0px;
    in property <length> code-viewport-height: 0px;
    private property <int> first-code-line: root.virtual-code
        ? min(root.block.code-lines.length, max(0, Math.floor((root.code-viewport-offset - root.block-padding-top) / root.code-line-height) - 4)) : 0;
    private property <int> visible-code-lines: root.virtual-code
        ? min(root.block.code-lines.length - root.first-code-line, Math.ceil(root.code-viewport-height / root.code-line-height) + 8)
        : root.block.code-lines.length;
    in property <bool> first-block: false;
    in property <ArtifactPreviewBlockKind> previous-kind: ArtifactPreviewBlockKind.Paragraph;
    in property <string> body-font-family: "sans-serif";
    in property <string> application-font-family: "sans-serif";
    in property <string> code-font-family: "Menlo";
    callback open-link(string);

    private property <bool> is-code:
        root.block.kind == ArtifactPreviewBlockKind.CodeBlock;
    private property <bool> is-quote:
        root.block.kind == ArtifactPreviewBlockKind.Quote;
    private property <bool> is-table:
        root.block.kind == ArtifactPreviewBlockKind.TableRow;
    private property <bool> is-list:
        root.block.kind == ArtifactPreviewBlockKind.ListItem;
    private property <length> list-level-inset:
        min(2, max(0, root.block.list-depth)) * 24px;
    private property <length> list-marker-width: 24px;
    private property <bool> is-heading:
        root.block.kind == ArtifactPreviewBlockKind.Heading1
            || root.block.kind == ArtifactPreviewBlockKind.Heading2
            || root.block.kind == ArtifactPreviewBlockKind.Heading3
            || root.block.kind == ArtifactPreviewBlockKind.Heading4
            || root.block.kind == ArtifactPreviewBlockKind.Heading5
            || root.block.kind == ArtifactPreviewBlockKind.Heading6;
    private property <bool> previous-is-heading:
        root.previous-kind == ArtifactPreviewBlockKind.Heading1
            || root.previous-kind == ArtifactPreviewBlockKind.Heading2
            || root.previous-kind == ArtifactPreviewBlockKind.Heading3
            || root.previous-kind == ArtifactPreviewBlockKind.Heading4
            || root.previous-kind == ArtifactPreviewBlockKind.Heading5
            || root.previous-kind == ArtifactPreviewBlockKind.Heading6;
    private property <length> content-inset:
        root.is-code ? GitHubMetrics.size-12
            : root.is-quote ? GitHubMetrics.size-20
            : root.is-list ? root.list-level-inset + root.list-marker-width
            : root.is-table ? GitHubMetrics.size-8
            : 0px;
    private property <length> code-content-top:
        root.block.code-language == ""
            ? 10px
            : GitHubMarkdownMetrics.code-header-height + GitHubMetrics.size-8;
    private property <length> block-padding-top:
        root.is-heading ? 20px
            : root.is-code ? root.code-content-top
            : root.block.kind == ArtifactPreviewBlockKind.Rule ? 28px
            : root.is-quote ? 8px
            : root.is-table ? 10px
            : root.block.kind == ArtifactPreviewBlockKind.ListItem
                ? (root.previous-kind != ArtifactPreviewBlockKind.ListItem
                    ? (root.previous-kind == ArtifactPreviewBlockKind.Paragraph
                            || root.previous-is-heading ? 10px
                        : root.previous-kind == ArtifactPreviewBlockKind.CodeBlock ? 14px
                        : root.previous-kind == ArtifactPreviewBlockKind.Quote ? 8px
                        : 0px)
                    : 0px)
            : root.first-block ? 0px
            : root.previous-kind == ArtifactPreviewBlockKind.Paragraph ? 20px
            : root.previous-kind == ArtifactPreviewBlockKind.ListItem
                    || root.previous-is-heading ? 10px
            : root.previous-kind == ArtifactPreviewBlockKind.CodeBlock ? 14px
            : root.previous-kind == ArtifactPreviewBlockKind.Quote ? 8px
            : root.previous-kind == ArtifactPreviewBlockKind.Rule ? 0px
            : 11px;
    private property <length> block-padding-bottom:
        root.is-code ? 10px
            : root.is-quote ? GitHubMetrics.size-8
            : root.is-table ? 10px
            : 0px;

    private property <length> code-line-height: GitHubMarkdownMetrics.code-line-height;
    private property <length> intrinsic-height: root.block.kind == ArtifactPreviewBlockKind.Rule
        ? 57px
        : (root.is-code
                ? max(1, root.block.code-lines.length) * root.code-line-height
                : block-text.height)
            + root.block-padding-top + root.block-padding-bottom;
    height: root.forced-height > 0px ? root.forced-height : root.intrinsic-height;
    // Rounded clipping would allocate a texture as tall as the entire fence.
    // The virtual line window clips its own bounded, square viewport instead.
    clip: root.is-code && !root.virtual-code;
    background: root.is-code ? GitHubTheme.canvas-subtle : transparent;
    border-width: root.is-code ? GitHubMetrics.border-thin : 0px;
    border-color: root.is-code ? GitHubTheme.border-subtle : transparent;
    border-radius: root.is-code ? GitHubMetrics.radius-medium : 0px;

    if root.is-quote: quote-bar := Rectangle {
        x: 0px;
        y: root.block-padding-top;
        width: GitHubMetrics.size-4;
        height: max(
            GitHubMarkdownMetrics.document-body-line-height,
            block-text.height - GitHubMarkdownMetrics.glyph-safety-height
        );
        background: GitHubTheme.border-default;
    }

    if root.block.kind == ArtifactPreviewBlockKind.TableRow: Rectangle {
        y: parent.height - GitHubMetrics.border-thin;
        width: parent.width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-muted;
    }

    if root.block.kind == ArtifactPreviewBlockKind.Rule: Rectangle {
        y: (parent.height - 1px) / 2;
        width: parent.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }

    if root.is-list: list-marker-text := Text {
        x: root.list-level-inset;
        y: root.block-padding-top;
        width: root.list-marker-width - GitHubMetrics.size-6;
        height: GitHubMarkdownMetrics.document-body-line-height;
        text: root.block.list-marker;
        color: GitHubTheme.fg-default;
        font-family: root.body-font-family;
        font-size: GitHubMarkdownMetrics.document-body-font-size;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    block-text := StyledText {
        // Slint 1.18 exposes line-height-factor for Text/TextInput, but not
        // StyledText. Preview therefore keeps the measured StyledText height;
        // changing only the surrounding box would break exact block extents.
        visible: root.block.kind != ArtifactPreviewBlockKind.Rule
            && root.block.kind != ArtifactPreviewBlockKind.CodeBlock;
        x: root.content-inset;
        y: root.block-padding-top;
        width: root.is-list
            ? parent.width - self.x
            : parent.width - self.x * 2;
        height: max(
            root.block.kind == ArtifactPreviewBlockKind.Heading1
                    ? GitHubMarkdownMetrics.document-heading-1-line-height
                : root.block.kind == ArtifactPreviewBlockKind.Heading2
                    ? GitHubMarkdownMetrics.document-heading-2-line-height
                : root.block.kind == ArtifactPreviewBlockKind.Heading3
                    ? GitHubMarkdownMetrics.document-heading-3-line-height
                : root.is-heading
                    ? GitHubMarkdownMetrics.document-heading-compact-line-height
                : GitHubMarkdownMetrics.document-body-line-height,
            self.preferred-height + GitHubMarkdownMetrics.glyph-safety-height
        );
        text: root.block.styled;
        default-font-family: root.is-heading
            ? root.application-font-family
            : root.body-font-family;
        default-color: root.is-quote ? GitHubTheme.fg-muted : GitHubTheme.fg-default;
        default-font-size: root.block.kind == ArtifactPreviewBlockKind.Heading1
                ? GitHubMarkdownMetrics.document-heading-1-font-size
            : root.block.kind == ArtifactPreviewBlockKind.Heading2
                ? GitHubMarkdownMetrics.document-heading-2-font-size
            : root.block.kind == ArtifactPreviewBlockKind.Heading3
                ? GitHubMarkdownMetrics.document-heading-3-font-size
            : root.block.kind == ArtifactPreviewBlockKind.Heading4
                ? GitHubMarkdownMetrics.document-heading-4-font-size
            : root.block.kind == ArtifactPreviewBlockKind.Heading5
                    || root.block.kind == ArtifactPreviewBlockKind.Heading6
                ? GitHubMarkdownMetrics.document-heading-compact-font-size
            : root.block.kind == ArtifactPreviewBlockKind.TableRow ? GitHubMetrics.text-small
            : GitHubMarkdownMetrics.document-body-font-size;
        link-color: GitHubTheme.accent-fg;
        link-clicked(url) => { root.open-link(url); }
    }

    code-lines := Rectangle {
        visible: root.block.kind == ArtifactPreviewBlockKind.CodeBlock;
        x: root.content-inset;
        y: root.block-padding-top + root.first-code-line * root.code-line-height;
        width: parent.width - self.x * 2;
        height: max(1, root.visible-code-lines) * root.code-line-height;
        clip: true;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            for line-index in root.visible-code-lines: code-line := HorizontalLayout {
                private property <ArtifactPreviewCodeLine> line: root.block.code-lines[root.first-code-line + line-index];
                init => {
                    if AppState.benchmark-preview-created-lines >= 0 {
                        AppState.benchmark-preview-created-lines += 1;
                    }
                }
                width: parent.width;
                height: root.code-line-height;
                spacing: 0px;

                for token in code-line.line.tokens: Text {
                    width: self.preferred-width;
                    height: parent.height;
                    text: token.text;
                    color: GitHubTheme.dark-mode ? token.dark-color : token.light-color;
                    font-family: root.code-font-family;
                    font-size: GitHubMarkdownMetrics.code-font-size;
                    font-weight: token.bold ? 600 : 400;
                    font-italic: token.italic;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: clip;
                }
            }
        }
    }

    if root.is-code && root.block.code-language != "": Text {
        x: root.content-inset;
        y: GitHubMetrics.size-4;
        width: parent.width - root.content-inset * 2;
        height: GitHubMetrics.size-16;
        text: root.block.code-language;
        color: GitHubTheme.fg-muted;
        font-family: root.code-font-family;
        font-size: GitHubMetrics.text-small;
        vertical-alignment: center;
    }
}

export component GitHubArtifactPreviewSurface inherits Rectangle {
    in property <ArtifactPreviewKind> preview-kind: ArtifactPreviewKind.None;
    in property <[ArtifactPreviewBlock]> markdown-blocks: [];
    in property <string> plain-text: "";
    in property <image> preview-image;
    in property <string> error-text: "";
    in property <bool> loading: false;
    in property <string> loading-message: I18n.preview-preparing;
    in property <bool> layout-resizing: false;
    in property <bool> virtualized-markdown: true;
    in property <int> markdown-layout-revision: 0;
    in property <int> markdown-layout-epoch: 0;
    in property <string> application-font-family: ".AppleSystemUIFont";
    in property <string> code-font-family: "Menlo";
    private property <string> markdown-body-font-family:
        root.application-font-family == ".AppleSystemUIFont"
            ? "Gujarati MT"
            : root.application-font-family;
    callback layout-markdown-window(
        int,
        [ArtifactPreviewBlock],
        float,
        float,
        float,
        string
    ) -> ArtifactPreviewVirtualWindow;
    callback open-link(string);

    background: GitHubTheme.canvas-default;

    if root.loading: Rectangle {
        width: parent.width;
        height: parent.height;
        background: GitHubTheme.canvas-default;

        GitHubCenteredLoadingState {
            width: parent.width;
            height: parent.height;
            label: root.loading-message;
        }
    }

    if !root.loading && root.preview-kind == ArtifactPreviewKind.Markdown
            && !root.virtualized-markdown: GitHubScrollView {
        width: parent.width;
        height: parent.height;
        show-scrollbar: !root.layout-resizing;

        markdown-column := VerticalLayout {
            width: min(parent.width, 800px);
            x: (parent.width - self.width) / 2;
            spacing: 0px;
            padding-left: root.width < 560px ? GitHubMetrics.size-16 : GitHubMetrics.size-24;
            padding-right: root.width < 560px ? GitHubMetrics.size-16 : GitHubMetrics.size-24;
            padding-top: GitHubMetrics.size-12;
            padding-bottom: GitHubMetrics.size-32;
            alignment: start;

            for block[index] in root.markdown-blocks: GitHubArtifactPreviewMarkdownBlock {
                width: parent.width;
                block: block;
                first-block: index == 0;
                previous-kind: index > 0
                    ? root.markdown-blocks[index - 1].kind
                    : ArtifactPreviewBlockKind.Paragraph;
                body-font-family: root.markdown-body-font-family;
                application-font-family: root.application-font-family;
                code-font-family: root.code-font-family;
                open-link(url) => { root.open-link(url); }
            }
        }
    }

    if !root.loading && root.preview-kind == ArtifactPreviewKind.Markdown
            && root.virtualized-markdown: markdown-virtual-host := Rectangle {
        background: GitHubTheme.canvas-default;

        private property <ArtifactPreviewVirtualWindow> virtual-window;
        private property <bool> refreshing-window: false;
        private property <length> observed-viewport-y: markdown-scroll.content-y;
        private property <length> observed-visible-height: markdown-scroll.height;
        private property <length> observed-content-width: root.width;
        private property <int> observed-layout-revision: root.markdown-layout-revision;
        private property <int> observed-layout-epoch: root.markdown-layout-epoch;
        changed observed-layout-epoch => { self.refresh-window(); }
        private property <string> observed-font: root.markdown-body-font-family;
        changed observed-font => { self.refresh-window(); }
        private property <float> benchmark-offset: AppState.benchmark-preview-offset;
        changed benchmark-offset => {
            if self.benchmark-offset >= 0 {
                markdown-scroll.content-y = -max(0px, markdown-scroll.content-height - markdown-scroll.height) * self.benchmark-offset;
            }
        }

        function refresh-window() {
            if self.refreshing-window {
                return;
            }
            self.refreshing-window = true;
            let next = root.layout-markdown-window(
                root.markdown-layout-revision,
                root.markdown-blocks,
                max(0.0, -markdown-scroll.content-y / 1px),
                max(1.0, markdown-scroll.height / 1px),
                max(1.0, root.width / 1px),
                root.markdown-body-font-family
            );
            let clamped-y = -next.scroll-offset * 1px;
            if next.projection-revision != self.virtual-window.projection-revision
                    || next.loading != self.virtual-window.loading
                    || Math.abs(next.layout-width - self.virtual-window.layout-width) > 0.5
                    || Math.abs(next.content-height - self.virtual-window.content-height) > 0.5 {
                self.virtual-window = next;
            }
            if Math.abs(markdown-scroll.content-y - clamped-y) > 0.5px {
                markdown-scroll.content-y = clamped-y;
            }
            self.refreshing-window = false;
            if AppState.benchmark-preview-created-lines >= 0 {
                AppState.benchmark-preview-extent = self.virtual-window.content-height;
                AppState.benchmark-preview-tail = self.virtual-window.rows.length > 0
                    && self.virtual-window.rows[self.virtual-window.rows.length - 1].index == root.markdown-blocks.length - 1
                    && Math.abs(markdown-scroll.content-y + max(0px, markdown-scroll.content-height - markdown-scroll.height)) < 1px;
            }
        }

        init => { self.refresh-window(); }
        changed observed-viewport-y => { self.refresh-window(); }
        changed observed-visible-height => { self.refresh-window(); }
        changed observed-content-width => { self.refresh-window(); }
        changed observed-layout-revision => {
            markdown-scroll.content-y = 0px;
            self.refresh-window();
        }

        markdown-scroll := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: max(
                self.height,
                parent.virtual-window.content-height * 1px
            );

            for row in markdown-virtual-host.virtual-window.rows: Rectangle {
                y: row.start * 1px;
                width: markdown-scroll.width;
                height: row.size * 1px;

                markdown-list-block := GitHubArtifactPreviewMarkdownBlock {
                    x: (parent.width - self.width) / 2;
                    y: row.start <= 0.5 ? GitHubMetrics.size-12 : 0px;
                    width: min(markdown-virtual-host.virtual-window.layout-width * 1px, 800px)
                        - (markdown-virtual-host.virtual-window.layout-width < 560
                            ? GitHubMetrics.size-32
                            : GitHubMetrics.size-48);
                    forced-height: max(
                        1px,
                        parent.height - self.y
                            - (row.start + row.size
                                    >= markdown-scroll.content-height / 1px - 0.5
                                ? GitHubMetrics.size-32
                                : 0px)
                    );
                    block: row.block;
                    virtual-code: true;
                    code-viewport-offset: -markdown-scroll.content-y - row.start * 1px - self.y;
                    code-viewport-height: markdown-scroll.height;
                    first-block: row.index == 0;
                    previous-kind: row.index > 0
                        ? root.markdown-blocks[row.index - 1].kind
                        : ArtifactPreviewBlockKind.Paragraph;
                    body-font-family: root.markdown-body-font-family;
                    application-font-family: root.application-font-family;
                    code-font-family: root.code-font-family;
                    open-link(url) => { root.open-link(url); }
                }
            }
        }

        if self.virtual-window.loading && self.virtual-window.rows.length == 0: GitHubCenteredLoadingState {
            width: parent.width;
            height: parent.height;
            label: root.loading-message;
        }

        GitHubVirtualListScrollbar {
            x: parent.width - self.width;
            y: 0px;
            height: parent.height;
            viewport-y <=> markdown-scroll.content-y;
            visible-height: markdown-scroll.height;
            content-height: parent.virtual-window.content-height * 1px;
            enabled: !root.layout-resizing;
            z: 20;
        }
    }

    if !root.loading && root.preview-kind == ArtifactPreviewKind.PlainText: GitHubScrollView {
        width: parent.width;
        height: parent.height;
        show-scrollbar: !root.layout-resizing;

        Text {
            width: parent.width;
            text: root.plain-text;
            wrap: word-wrap;
            color: GitHubTheme.fg-default;
            font-size: GitHubMetrics.text-medium;
            font-family: "monospace";
        }
    }

    if !root.loading && root.preview-kind == ArtifactPreviewKind.Image: Rectangle {
        background: GitHubTheme.canvas-subtle;

        Image {
            x: GitHubMetrics.size-16;
            y: GitHubMetrics.size-16;
            width: parent.width - GitHubMetrics.size-32;
            height: parent.height - GitHubMetrics.size-32;
            source: root.preview-image;
            image-fit: contain;
        }
    }

    if !root.loading && root.preview-kind == ArtifactPreviewKind.Error: Rectangle {
        background: GitHubTheme.canvas-default;

        VerticalLayout {
            width: min(parent.width - GitHubMetrics.size-32, 520px);
            x: (parent.width - self.width) / 2;
            y: GitHubMetrics.size-48;
            spacing: GitHubMetrics.size-8;

            Text {
                text: I18n.preview-unavailable;
                color: GitHubTheme.fg-default;
                font-size: GitHubMetrics.heading-small;
                font-weight: 600;
            }
            Text {
                width: parent.width;
                text: root.error-text;
                color: GitHubTheme.fg-muted;
                font-size: GitHubMetrics.text-medium;
                wrap: word-wrap;
            }
        }
    }
}

export component GitHubArtifactPreviewPanel inherits Rectangle {
    in property <string> title: I18n.common-preview;
    in property <ArtifactPreviewKind> preview-kind: ArtifactPreviewKind.None;
    in property <[ArtifactPreviewBlock]> markdown-blocks: [];
    in property <string> plain-text: "";
    in property <image> preview-image;
    in property <string> error-text: "";
    in property <bool> loading: false;
    in property <string> loading-message: I18n.preview-preparing;
    in property <bool> can-copy: false;
    in property <bool> can-open-external: false;
    in property <string> copy-content: "";
    in property <bool> detached: false;
    // macOS detached windows move these actions into a native title-bar
    // accessory. Other hosts retain the shared in-content header.
    in property <bool> show-header: true;
    // Hosts report an active divider/native-window resize. The inexpensive
    // shell follows the live bounds, while the prepared document tree keeps
    // its last settled layout width and is clipped by preview-content-host.
    in property <bool> layout-resizing: false;
    // Docked open/close animations suspend painting of the prepared document.
    // The tree and its ModelRc stay mounted, so this is a presentation policy
    // rather than provider/session lifecycle state.
    in property <bool> content-suspended: false;
    in property <bool> performance-optimized: true;
    in property <int> markdown-layout-revision: 0;
    in property <int> markdown-layout-epoch: 0;
    in property <string> application-font-family: ".AppleSystemUIFont";
    in property <string> code-font-family: "Menlo";
    callback layout-markdown-window(
        int,
        [ArtifactPreviewBlock],
        float,
        float,
        float,
        string
    ) -> ArtifactPreviewVirtualWindow;
    callback close-requested();
    callback copy-requested(string) -> bool;
    callback open-external-requested();
    callback open-link(string);

    private property <length> stable-content-width: self.width;
    private property <length> content-layout-width:
        root.performance-optimized && root.layout-resizing
            ? root.stable-content-width
            : root.width;

    background: GitHubTheme.canvas-default;
    changed width => {
        if !root.layout-resizing {
            root.stable-content-width = root.width;
        }
    }
    changed layout-resizing => {
        // Capture before live geometry starts and commit the final width once
        // after it ends. This prevents every Markdown block from rewrapping on
        // every pointer event while preserving exact settled layout.
        root.stable-content-width = root.width;
    }

    header := Rectangle {
        y: 0px;
        width: parent.width;
        height: root.show-header ? GitHubMetrics.size-48 : 0px;
        visible: root.show-header;
        background: GitHubTheme.canvas-default;
        z: 100;

        Text {
            x: GitHubMetrics.size-16;
            width: max(0px, right-actions.x - self.x - GitHubMetrics.size-8);
            height: parent.height;
            text: root.title;
            color: GitHubTheme.fg-default;
            font-size: GitHubMetrics.text-medium;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        right-actions := HorizontalLayout {
            x: parent.width - self.width - GitHubMetrics.size-8;
            y: (parent.height - self.height) / 2;
            width: GitHubMetrics.control-medium-size
                + (root.can-copy
                    ? GitHubMetrics.control-medium-size + GitHubMetrics.size-4
                    : 0px)
                + (root.can-open-external
                    ? GitHubMetrics.control-medium-size + GitHubMetrics.size-4
                    : 0px);
            height: GitHubMetrics.control-medium-size;
            spacing: GitHubMetrics.size-4;

            if root.can-copy: GitHubCopyButton {
                tooltip-text: I18n.tooltip-copy-preview;
                copy-requested => { root.copy-requested(root.copy-content) }
            }
            if root.can-open-external: GitHubIconButton {
                icon: @image-url("../../assets/icons/octicon-link-external-16.svg");
                tooltip-text: I18n.tooltip-open-system-application;
                clicked => { root.open-external-requested(); }
            }
            GitHubIconButton {
                icon: @image-url("../../assets/icons/octicon-x-16.svg");
                tooltip-text: I18n.tooltip-close-preview;
                clicked => { root.close-requested(); }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: GitHubTheme.border-default;
        }
    }

    preview-content-host := Rectangle {
        x: 0px;
        y: header.height;
        width: parent.width;
        height: parent.height - header.height;
        background: GitHubTheme.canvas-default;
        clip: true;
        z: 0;

        GitHubArtifactPreviewSurface {
            width: root.content-layout-width;
            height: parent.height;
            // Keep the lightweight loading layer visible while the docked shell
            // opens; only prepared document painting needs suspension.
            visible: root.loading || !root.content-suspended;
            preview-kind: root.preview-kind;
            markdown-blocks: root.markdown-blocks;
            plain-text: root.plain-text;
            preview-image: root.preview-image;
            error-text: root.error-text;
            loading: root.loading;
            loading-message: root.loading-message;
            layout-resizing: root.layout-resizing;
            virtualized-markdown: root.performance-optimized;
            markdown-layout-revision: root.markdown-layout-revision;
            markdown-layout-epoch: root.markdown-layout-epoch;
            application-font-family: root.application-font-family;
            code-font-family: root.code-font-family;
            layout-markdown-window(
                revision,
                blocks,
                scroll-offset,
                visible-height,
                content-width,
                font-family
            ) => {
                root.layout-markdown-window(
                    revision,
                    blocks,
                    scroll-offset,
                    visible-height,
                    content-width,
                    font-family
                )
            }
            open-link(url) => { root.open-link(url); }
        }
    }
}

export component ArtifactPreviewWindow inherits Window {
    // Detached windows own an independent Slint component tree. Receive the
    // resolved application appearance explicitly so the local theme and
    // standard-widget palette cannot fall back to process defaults.
    in property <bool> effective-dark-mode: false;
    out property <bool> palette-synchronized:
        Palette.color-scheme == (root.effective-dark-mode
            ? ColorScheme.dark
            : ColorScheme.light);

    function apply-effective-theme() {
        AppState.theme-mode = root.effective-dark-mode ? 1 : 0;
        AppState.effective-dark-mode = root.effective-dark-mode;
        Palette.color-scheme = root.effective-dark-mode
            ? ColorScheme.dark
            : ColorScheme.light;
    }
    init => { root.apply-effective-theme(); }
    changed effective-dark-mode => { root.apply-effective-theme(); }
    in property <string> document-title: I18n.common-preview;
    in property <ArtifactPreviewKind> preview-kind: ArtifactPreviewKind.None;
    in property <[ArtifactPreviewBlock]> markdown-blocks: [];
    in property <string> plain-text: "";
    in property <image> preview-image;
    in property <string> error-text: "";
    in property <bool> loading: false;
    in property <string> loading-message: I18n.preview-preparing;
    in property <bool> can-copy: false;
    in property <bool> can-open-external: false;
    in property <string> copy-content: "";
    in property <string> application-font-family: ".AppleSystemUIFont";
    in property <string> code-font-family: "Menlo";
    in property <bool> performance-optimized: true;
    in property <bool> native-titlebar-actions: false;
    in property <int> markdown-layout-revision: 0;
    in property <int> markdown-layout-epoch: 0;
    in-out property <bool> native-live-resizing: false;
    out property <bool> layout-resizing:
        root.native-live-resizing || root.fallback-live-resizing;
    callback dismiss-requested();
    callback copy-requested(string) -> bool;
    callback open-external-requested();
    callback open-link(string);
    callback layout-markdown-window(
        int,
        [ArtifactPreviewBlock],
        float,
        float,
        float,
        string
    ) -> ArtifactPreviewVirtualWindow;

    // AppKit begin/end notifications are the precise path. This window-local
    // settle detector covers backends or synthetic native drags that only
    // publish width changes. It never shares state with MainWindow.
    private property <bool> fallback-live-resizing: false;

    title: root.document-title;
    preferred-width: 920px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 360px;
    background: GitHubTheme.canvas-default;
    default-font-family: root.application-font-family;

    changed width => {
        if !root.native-live-resizing {
            root.fallback-live-resizing = true;
            resize-settle-timer.restart();
        }
    }

    resize-settle-timer := Timer {
        interval: 500ms;
        running: root.fallback-live-resizing;
        triggered => {
            root.fallback-live-resizing = false;
        }
    }

    GitHubArtifactPreviewPanel {
        width: parent.width;
        height: parent.height;
        title: root.document-title;
        preview-kind: root.preview-kind;
        markdown-blocks: root.markdown-blocks;
        plain-text: root.plain-text;
        preview-image: root.preview-image;
        error-text: root.error-text;
        loading: root.loading;
        loading-message: root.loading-message;
        can-copy: root.can-copy;
        can-open-external: root.can-open-external;
        copy-content: root.copy-content;
        detached: true;
        show-header: !root.native-titlebar-actions;
        layout-resizing: root.layout-resizing;
        content-suspended: false;
        performance-optimized: root.performance-optimized;
        markdown-layout-revision: root.markdown-layout-revision;
            markdown-layout-epoch: root.markdown-layout-epoch;
        application-font-family: root.application-font-family;
        code-font-family: root.code-font-family;
        layout-markdown-window(
            revision,
            blocks,
            scroll-offset,
            visible-height,
            content-width,
            font-family
        ) => {
            root.layout-markdown-window(
                revision,
                blocks,
                scroll-offset,
                visible-height,
                content-width,
                font-family
            )
        }
        close-requested => { root.dismiss-requested(); }
        copy-requested(text) => { root.copy-requested(text) }
        open-external-requested => { root.open-external-requested(); }
        open-link(url) => { root.open-link(url); }
    }
}
