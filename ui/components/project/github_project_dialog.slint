import {
    GitHubTextField,
    GitHubToggle
} from "../settings/github_settings_controls.slint";
import { GitHubDialog } from "../dialog/github_dialog.slint";
import { GitHubScrollView } from "../github_scroll_view.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";
import { GitHubCheckbox } from "../input/github_checkbox.slint";
import { GitHubRadio } from "../input/github_radio.slint";
import { GitHubMetadataLabel, GitHubMetadataLabelVariant } from "../github_metadata_label.slint";

export struct ProjectHookChoice {
    id: string,
    name: string,
    description: string,
    status: string,
    enabled: bool,
    selected: bool,
    preferred-selected: bool,
}

export component GitHubProjectDialog {
    in property <bool> modal-visible: false;
    in property <string> mode: "add";
    in property <string> original-alias: "";
    in-out property <string> name;
    in-out property <string> alias;
    in-out property <string> local-repo;
    in-out property <string> remote-repo;
    in-out property <string> logo;
    in-out property <string> project-tags;
    in-out property <bool> is-pr-auto-update;
    in property <[ProjectHookChoice]> hook-choices;
    in property <int> selected-hook-count: 0;
    in property <int> selectable-hook-count: 0;
    in-out property <bool> hooks-enabled: false;
    in property <bool> hooks-ready: false;
    in property <string> hooks-status;
    callback toggle-hook(string, bool);
    in property <image> logo-preview-image: @image-url("../../../logo.png");
    in property <string> logo-preview-status: I18n.projects-using-default-logo;
    in-out property <string> error-text;
    callback submit(string, string, string, string, string, string, bool);
    callback preview-logo(string);
    callback confirm-delete(string);
    callback cancel();

    private property <bool> deleting: root.mode == "delete";
    private property <bool> hook-selection-error: false;
    private property <length> dialog-width: root.deleting ? 320px : 480px;
    private property <length> dialog-height: root.deleting
        ? 248px
        : min(680px, root.height - 32px);

    changed modal-visible => {
        if root.modal-visible {
            root.hook-selection-error = false;
        }
    }

    dialog-frame := GitHubDialog {
        dialog-visible: root.modal-visible;
        // Forms keep Esc dismissible; backdrop stays blocked so pointer
        // accidents do not discard edits (Primer form-dialog pattern).
        modal: false;
        title: root.mode == "edit"
            ? I18n.projects-edit-project
            : root.deleting ? I18n.projects-delete-project-question : I18n.projects-new-project;
        subtitle: root.deleting
            ? ""
            : (root.mode == "edit"
                ? I18n.projects-edit-description
                : I18n.projects-add-description);
        dialog-width: root.dialog-width;
        dialog-height: root.dialog-height;
        body-padding: 0px;
        primary-label: root.mode == "edit"
            ? I18n.projects-save-changes
            : root.deleting ? I18n.projects-delete-project : I18n.projects-add-project;
        primary-success: !root.deleting;
        primary-danger: root.deleting;
        close-requested => { root.cancel(); }
        cancel-clicked => { root.cancel(); }
        primary-clicked => {
            if root.deleting {
                root.confirm-delete(root.original-alias);
                return;
            }
            if root.name == "" || root.alias == "" || root.local-repo == "" || root.remote-repo == "" {
                root.error-text = I18n.projects-required-fields;
                return;
            }
            if root.hooks-enabled && root.selected-hook-count == 0 {
                root.hook-selection-error = true;
                return;
            }
            root.submit(root.name, root.alias, root.local-repo, root.remote-repo, root.logo, root.project-tags, root.is-pr-auto-update);
        }

        if root.modal-visible: Rectangle {
            x: dialog-frame.content-x;
            y: dialog-frame.content-y;
            width: dialog-frame.content-width;
            height: dialog-frame.content-height;
            z: 3100;
            background: transparent;
            clip: true;

                    if root.deleting: Rectangle {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: parent.height - 32px;
                        background: transparent;

                        Image {
                            x: 0px;
                            y: 2px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../assets/icons/octicon-alert-16.svg");
                            colorize: GitHubTheme.danger-fg;
                        }

                        Text {
                            x: 28px;
                            y: 0px;
                            width: parent.width - 28px;
                            text: I18n.projects-delete-confirmation-prefix + " “" + root.name + "” "
                                + I18n.projects-delete-confirmation-suffix;
                            font-size: 14px;
                            color: GitHubTheme.fg-default;
                            wrap: word-wrap;
                        }
                    }

                    if !root.deleting: GitHubScrollView {
                        width: parent.width;
                        height: parent.height;
                        interactive: true;
                        show-scrollbar: true;

                        form-content := Rectangle {
                            width: parent.width;
                            height: hook-section.y + hook-section.height + (root.error-text == "" ? 16px : 68px);
                            background: transparent;

                        GitHubTextField {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            label: I18n.projects-project-name;
                            text <=> root.name;
                            placeholder: I18n.projects-project-name-placeholder;
                            required: true;
                            validation-error: root.error-text != "" && root.name == "";
                            edited(text) => { root.error-text = ""; }
                        }
                        GitHubTextField {
                            x: 16px;
                            y: 86px;
                            width: parent.width - 32px;
                            label: I18n.projects-project-alias;
                            text <=> root.alias;
                            placeholder: I18n.projects-project-alias-placeholder;
                            required: true;
                            validation-error: root.error-text != "" && root.alias == "";
                            edited(text) => { root.error-text = ""; }
                        }
                        GitHubTextField {
                            x: 16px;
                            y: 156px;
                            width: parent.width - 32px;
                            label: I18n.projects-local-repository;
                            text <=> root.local-repo;
                            placeholder: "/path/to/repository";
                            required: true;
                            validation-error: root.error-text != "" && root.local-repo == "";
                            edited(text) => { root.error-text = ""; }
                        }
                        GitHubTextField {
                            x: 16px;
                            y: 226px;
                            width: parent.width - 32px;
                            label: I18n.projects-remote-repository;
                            text <=> root.remote-repo;
                            placeholder: "git@github.com:org/repo.git";
                            required: true;
                            validation-error: root.error-text != "" && root.remote-repo == "";
                            edited(text) => { root.error-text = ""; }
                        }
                        GitHubTextField {
                            x: 16px;
                            y: 296px;
                            width: parent.width - 32px;
                            label: I18n.projects-logo;
                            text <=> root.logo;
                            placeholder: I18n.projects-logo-placeholder;
                            caption: I18n.projects-logo-caption;
                            edited(text) => {
                                root.error-text = "";
                                root.preview-logo(text);
                            }
                        }
                        GitHubTextField {
                            x: 16px;
                            y: 386px;
                            width: parent.width - 32px;
                            label: I18n.projects-type-tags;
                            text <=> root.project-tags;
                            placeholder: I18n.projects-type-tags-placeholder;
                            caption: I18n.projects-type-tags-caption;
                        }

                        Rectangle {
                            x: 16px;
                            y: 476px;
                            width: parent.width - 32px;
                            height: 68px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: GitHubTheme.border-default;
                            background: GitHubTheme.canvas-subtle;

                            Text {
                                x: 12px;
                                y: 8px;
                                width: parent.width - 84px;
                                height: 20px;
                                text: I18n.projects-auto-refresh-pr-counts;
                                font-size: 14px;
                                font-weight: 600;
                                color: GitHubTheme.fg-default;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                x: 12px;
                                y: 32px;
                                width: parent.width - 84px;
                                height: 18px;
                                text: I18n.projects-auto-refresh-pr-counts-description;
                                font-size: 12px;
                                color: GitHubTheme.fg-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            GitHubToggle {
                                x: parent.width - 60px;
                                y: 22px;
                                checked: root.is-pr-auto-update;
                                toggled(value) => { root.is-pr-auto-update = value; }
                            }
                        }

                        Rectangle {
                            x: 16px;
                            y: 556px;
                            width: parent.width - 32px;
                            height: 76px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: GitHubTheme.border-default;
                            background: GitHubTheme.canvas-default;

                            Rectangle {
                                x: 12px;
                                y: 10px;
                                width: 56px;
                                height: 56px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: GitHubTheme.border-default;
                                background: GitHubTheme.control-default-rest;
                                clip: true;

                                Image {
                                    x: 8px;
                                    y: 8px;
                                    width: 40px;
                                    height: 40px;
                                    source: root.logo-preview-image;
                                }
                            }

                            Text {
                                x: 80px;
                                y: 12px;
                                width: parent.width - 92px;
                                height: 20px;
                                text: I18n.projects-logo-preview;
                                font-size: 14px;
                                font-weight: 600;
                                color: GitHubTheme.fg-default;
                                vertical-alignment: center;
                            }

                            Text {
                                x: 80px;
                                y: 36px;
                                width: parent.width - 92px;
                                height: 20px;
                                text: root.logo-preview-status;
                                font-size: 12px;
                                color: root.logo-preview-status == I18n.projects-invalid-logo-default
                                    ? (GitHubTheme.danger-fg)
                                    : (GitHubTheme.fg-muted);
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        hook-section := Rectangle {
                            x: 16px;
                            y: 644px;
                            width: parent.width - 32px;
                            private property <length> hook-list-height:
                                root.hook-choices.length * 60px + 2px;
                            height: 132px + (root.hooks-enabled
                                ? self.hook-list-height + 12px
                                    + (root.hook-selection-error ? 28px : 0px)
                                : 0px);
                            background: transparent;

                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: 20px;
                                text: I18n.hooks-title;
                                font-size: 14px;
                                font-weight: 600;
                                color: GitHubTheme.fg-default;
                            }

                            hook-mode := Rectangle {
                                x: 0px;
                                y: 24px;
                                width: parent.width;
                                height: 104px;
                                accessible-role: radio-group;
                                accessible-label: I18n.hooks-title;

                                GitHubRadio {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    text: I18n.projects-do-not-trigger-hooks;
                                    description: I18n.projects-do-not-trigger-hooks-description;
                                    checked: !root.hooks-enabled;
                                    chosen => {
                                        root.hooks-enabled = false;
                                        root.hook-selection-error = false;
                                    }
                                    stepped(delta) => {
                                        if delta != 0 {
                                            root.hooks-enabled = true;
                                            root.hook-selection-error = false;
                                        }
                                    }
                                }
                                GitHubRadio {
                                    x: 0px;
                                    y: 52px;
                                    width: parent.width;
                                    text: I18n.projects-trigger-selected-hooks;
                                    description: root.hooks-status != "" ? root.hooks-status
                                        : root.hook-choices.length == 0 ? I18n.projects-no-hooks
                                        : I18n.projects-trigger-selected-hooks-description;
                                    checked: root.hooks-enabled;
                                    control-enabled: root.hooks-ready
                                        && (root.selectable-hook-count > 0 || root.selected-hook-count > 0);
                                    chosen => {
                                        root.hooks-enabled = true;
                                        root.hook-selection-error = false;
                                    }
                                    stepped(delta) => {
                                        if delta != 0 {
                                            root.hooks-enabled = false;
                                            root.hook-selection-error = false;
                                        }
                                    }
                                }
                            }

                            if root.hooks-enabled: hook-list := Rectangle {
                                x: 28px; y: 140px;
                                width: parent.width - 28px;
                                height: hook-section.hook-list-height;
                                visible: root.hooks-enabled;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: GitHubTheme.border-default;
                                background: GitHubTheme.canvas-default;
                                for choice[index] in root.hook-choices: Rectangle {
                                    x: 1px; y: 1px + index * 60px;
                                    width: parent.width - 2px; height: 60px;
                                    background: transparent;
                                    GitHubCheckbox {
                                        x: 4px; y: (parent.height - self.height) / 2;
                                        width: parent.width - 8px - (choice.status == "" ? 0px : hook-status.width + 8px);
                                        text: choice.name;
                                        label-font-weight: 600;
                                        description: choice.description;
                                        checked: choice.selected;
                                        control-enabled: root.hooks-ready && choice.enabled;
                                        toggled(value) => {
                                            root.hook-selection-error = false;
                                            root.toggle-hook(choice.id, value);
                                        }
                                    }
                                    hook-status := GitHubMetadataLabel {
                                        variant: GitHubMetadataLabelVariant.Secondary;
                                        x: parent.width - self.width - 12px; y: 12px;
                                        text: choice.status;
                                        visible: choice.status != "";
                                    }
                                    Rectangle {
                                        x: 0px; y: parent.height - 1px;
                                        width: parent.width; height: 1px;
                                        background: GitHubTheme.border-default;
                                        visible: index < root.hook-choices.length - 1;
                                    }
                                }
                            }

                            if root.hooks-enabled && root.hook-selection-error: Text {
                                x: 28px;
                                y: 146px + hook-section.hook-list-height;
                                width: parent.width;
                                height: 20px;
                                text: I18n.projects-select-at-least-one-hook;
                                font-size: 12px;
                                color: GitHubTheme.danger-fg;
                            }
                        }

                        if root.error-text != "": Rectangle {
                            x: 16px;
                            y: hook-section.y + hook-section.height + 12px;
                            width: parent.width - 32px;
                            height: 40px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: GitHubTheme.danger-border-muted;
                            background: GitHubTheme.danger-inset;

                            Image {
                                x: 12px;
                                y: 12px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../assets/icons/octicon-alert-16.svg");
                                colorize: GitHubTheme.danger-fg;
                            }

                            Text {
                                x: 36px;
                                width: parent.width - 48px;
                                height: parent.height;
                                text: root.error-text;
                                font-size: 12px;
                                color: GitHubTheme.fg-default;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        }

                    }
        }
    }
}
