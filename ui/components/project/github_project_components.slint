import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubMetadataLabel } from "../github_metadata_label.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";


export struct ProjectItem {
    project_name: string,
    project_alias: string,
    local_repo: string,
    remote_repo: string,
    repo_type: string,
    logo: string,
    logo_image: image,
    is_pr_auto_update: bool,
    pr_count_loading: bool,
    pr_count_failed: bool,
    pr_fat_count_text: string,
    pr_uat_count_text: string,
    pr_prod_count_text: string,
    project_tags: [string],
    project_tags_text: string,
}

// A true corner ribbon crosses the card's upper-right corner at 45 degrees.
// The card clips its ends, producing the same top-edge/right-edge attachment
// as the selected design reference without consuming a metadata row.
export component GitHubProjectProviderRibbon inherits Rectangle {
    in property <string> repo-type: "";
    in property <bool> compact: false;

    private property <string> normalized-type: root.repo-type.to-lowercase();
    private property <string> provider-name: root.normalized-type == "gitlab"
        ? "GitLab"
        : root.normalized-type == "gitee"
            ? "Gitee"
            : "GitHub";
    private property <image> ribbon-image: root.normalized-type == "gitlab"
        ? (root.compact
            ? @image-url("../../assets/provider-ribbons/provider-ribbon-gitlab-compact.svg")
            : @image-url("../../assets/provider-ribbons/provider-ribbon-gitlab-full.svg"))
        : root.normalized-type == "gitee"
            ? (root.compact
                ? @image-url("../../assets/provider-ribbons/provider-ribbon-gitee-compact.svg")
                : @image-url("../../assets/provider-ribbons/provider-ribbon-gitee-full.svg"))
            : (root.compact
                ? @image-url("../../assets/provider-ribbons/provider-ribbon-github-compact.svg")
                : @image-url("../../assets/provider-ribbons/provider-ribbon-github-full.svg"));
    // Keep the corner footprint deliberately small. The long band extends
    // beyond this host and the card clips it into the final corner shape.
    width: root.compact ? 48px : 54px;
    height: self.width;
    background: transparent;
    clip: false;
    accessible-role: text;
    accessible-label: I18n.projects-repository-provider + ": " + root.provider-name;

    // FemtoVG renders Text under rotation as anti-aliased glyph outlines
    // instead of using its hinted glyph atlas. At this size that is visibly
    // soft on low-DPI displays. The application-owned SVG preserves the same
    // band, icon, and centered 45deg caption geometry, while this Image stays
    // axis-aligned so SVG rasterization happens directly at the output scale.
    Image {
        width: parent.width;
        height: parent.height;
        source: root.ribbon-image;
        image-fit: contain;
    }
}

export component GitHubProjectIconButton inherits GitHubIconButton {
    in property <string> tooltip: "";
    in property <bool> tooltip-end: false;
    tooltip-text: root.tooltip;
    tooltip-above: false;
    tooltip-align-right: root.tooltip-end;
    control-size: GitHubMetrics.control-medium-size;
    glyph-size: GitHubMetrics.icon-medium;
    foreground: root.danger ? GitHubTheme.danger-fg : GitHubTheme.fg-default;
}

export component GitHubProjectSearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: I18n.projects-find-placeholder;
    callback accepted(string);

    width: 320px;
    height: 32px;
    border-radius: 6px;
    border-width: search-input.has-focus ? 2px : 1px;
    border-color: search-input.has-focus
        ? (GitHubTheme.accent-fg)
        : (GitHubTheme.border-default);
    background: GitHubTheme.canvas-default;
    clip: false;

    Image {
        x: search-input.has-focus ? 9px : 10px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-search-16.svg");
        colorize: GitHubTheme.fg-muted;
    }

    search-input := TextInput {
        x: search-input.has-focus ? 33px : 34px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - self.x - (root.text == "" ? 12px : 40px);
        text <=> root.text;
        single-line: true;
        font-size: 14px;
        color: GitHubTheme.fg-default;
        selection-background-color: GitHubTheme.selection-bg;
        selection-foreground-color: self.color;
        accessible-role: text-input;
        accessible-enabled: true;
        accessible-label: root.placeholder;
        accessible-value <=> self.text;
        accepted => { root.accepted(self.text); }
    }

    if root.text == "" && !search-input.has-focus: Text {
        x: 34px;
        width: parent.width - 46px;
        height: parent.height;
        text: root.placeholder;
        font-size: 14px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.text != "": GitHubProjectIconButton {
        x: parent.width - GitHubMetrics.control-medium-size;
        y: 0px;
        icon: @image-url("../../assets/icons/octicon-x-16.svg");
        tooltip: I18n.tooltip-clear-search;
        tooltip-end: true;
        clicked => {
            root.text = "";
            root.accepted("");
        }
    }
}

export component GitHubProjectViewSwitcher inherits Rectangle {
    in-out property <string> mode: "grid";

    width: 72px;
    height: GitHubMetrics.control-medium-size;
    background: transparent;

    GitHubProjectIconButton {
        x: 0px;
        icon: @image-url("../../assets/icons/octicon-list-unordered-16.svg");
        tooltip: I18n.tooltip-list-view;
        invisible: false;
        selected: root.mode == "list";
        clicked => { root.mode = "list"; }
    }

    GitHubProjectIconButton {
        x: 40px;
        icon: @image-url("../../assets/icons/octicon-table-16.svg");
        tooltip: I18n.tooltip-grid-view;
        invisible: false;
        selected: root.mode == "grid";
        clicked => { root.mode = "grid"; }
    }
}

export component GitHubPullRequestSummary inherits Rectangle {
    in property <ProjectItem> project;

    width: 228px;
    height: 24px;
    background: transparent;

    if root.project.is_pr_auto_update: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 8px;
        alignment: end;

        Text {
            text: I18n.projects-pull-requests;
            font-size: 12px;
            color: GitHubTheme.fg-muted;
            vertical-alignment: center;
        }

        if root.project.pr_count_loading: GitHubSpinner {
            spinner-size: 14px;
            foreground: GitHubTheme.fg-muted;
        }

        if root.project.pr_count_failed: Image {
            width: 14px;
            height: 14px;
            source: @image-url("../../assets/icons/octicon-alert-16.svg");
            colorize: GitHubTheme.danger-fg;
        }

        Text {
            text: "FAT " + root.project.pr_fat_count_text;
            font-size: 12px;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
        Text {
            text: "UAT " + root.project.pr_uat_count_text;
            font-size: 12px;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
        Text {
            text: "PROD " + root.project.pr_prod_count_text;
            font-size: 12px;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
    }
}

export component GitHubProjectListRow inherits Rectangle {
    in property <ProjectItem> project;
    in property <bool> first: false;
    callback open-requested();
    callback terminal-requested();
    callback edit-requested();
    callback delete-requested();
    private property <bool> keyboard-focus-visible: false;

    // Identity + path metadata + topics (GitHub repo-row density with paths).
    height: 136px;
    clip: true;
    background: row-touch.has-hover
        ? (GitHubTheme.canvas-subtle)
        : transparent;

    // Separator above the row (not under the next row's hover fill), so the
    // Box border and row dividers stay visible while hovering.
    if !root.first: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        z: 2;
        background: GitHubTheme.border-default;
    }

    Rectangle {
        x: 16px;
        y: 16px;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        border-width: 1px;
        border-color: GitHubTheme.border-default;
        background: GitHubTheme.control-default-rest;
        clip: true;

        Image {
            x: 6px;
            y: 6px;
            width: 28px;
            height: 28px;
            source: root.project.logo_image;
        }
    }

    if root.project.repo_type != "": GitHubProjectProviderRibbon {
        x: parent.width - self.width;
        y: 0px;
        repo-type: root.project.repo_type;
        compact: true;
        z: 3;
    }

    title-line := HorizontalLayout {
        x: 72px;
        y: 14px;
        width: max(40px, parent.width - 72px - 184px);
        height: 24px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Text {
            text: root.project.project_name;
            font-size: 16px;
            font-weight: 600;
            color: GitHubTheme.accent-fg;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.project.project_alias != "": Rectangle {
            width: alias-label.width;
            height: parent.height;
            background: transparent;

            alias-label := GitHubMetadataLabel {
                // The 16px project name rasterizes lower than the 12px label.
                // Apply the title-row-only optical correction while keeping
                // the shared metadata label unchanged for other call sites.
                y: (parent.height - self.height) / 2 + GitHubMetrics.size-2;
                // ~24 Latin chars / ~12 CJK at 12px before ellipsis.
                max-label-width: 168px;
                text: root.project.project_alias;
            }
        }
    }

    Text {
        x: 72px;
        y: 42px;
        width: max(40px, parent.width - 72px - 184px);
        height: 20px;
        text: root.project.remote_repo;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 72px;
        y: 64px;
        width: max(40px, parent.width - 72px - 184px);
        height: 20px;
        text: root.project.local_repo;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: 72px;
        y: 96px;
        width: max(40px, parent.width - 72px - 252px);
        height: 24px;
        spacing: 6px;
        alignment: start;

        for project-tag in root.project.project_tags: GitHubMetadataLabel {
            text: project-tag;
        }
    }

    if root.project.is_pr_auto_update: GitHubPullRequestSummary {
        x: parent.width - self.width - 16px;
        y: 96px;
        project: root.project;
    }

    actions := HorizontalLayout {
        x: Math.floor((parent.width - 176px) / 1px) * 1px;
        y: 12px;
        width: 96px;
        height: 32px;
        spacing: 0px;
        alignment: end;

        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-terminal-16.svg");
            tooltip: I18n.tooltip-open-terminal;
            tooltip-end: true;
            clicked => { root.terminal-requested(); }
        }
        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-pencil-16.svg");
            tooltip: I18n.tooltip-edit-project;
            tooltip-end: true;
            clicked => { root.edit-requested(); }
        }
        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-trash-16.svg");
            tooltip: I18n.projects-delete-project;
            tooltip-end: true;
            danger: true;
            clicked => { root.delete-requested(); }
        }
    }

    row-focus := FocusScope {
        width: max(0px, parent.width - 184px);
        height: parent.height;
        accessible-role: button;
        accessible-enabled: true;
        accessible-label: I18n.projects-open-project + " " + root.project.project_name;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.open-requested();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }

    row-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: max(0px, parent.width - 184px);
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            row-focus.focus();
            root.open-requested();
        }
    }

    if row-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: 3px;
        y: 3px;
        width: max(0px, parent.width - 190px);
        height: parent.height - 6px;
        border-radius: GitHubMetrics.radius-medium;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

export component GitHubProjectGridCard inherits Rectangle {
    in property <ProjectItem> project;
    callback open-requested();
    callback terminal-requested();
    callback edit-requested();
    callback delete-requested();
    private property <bool> keyboard-focus-visible: false;

    // Primer repo card with path metadata filling the middle band.
    height: 204px;
    border-radius: 6px;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: card-touch.has-hover
        ? (GitHubTheme.canvas-subtle)
        : (GitHubTheme.canvas-default);
    clip: true;

    Rectangle {
        x: 16px;
        y: 16px;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        border-width: 1px;
        border-color: GitHubTheme.border-default;
        background: GitHubTheme.control-default-rest;
        clip: true;

        Image {
            x: 6px;
            y: 6px;
            width: 28px;
            height: 28px;
            source: root.project.logo_image;
        }
    }

    if root.project.repo_type != "": GitHubProjectProviderRibbon {
        x: parent.width - self.width;
        y: 0px;
        repo-type: root.project.repo_type;
        compact: parent.width < 320px;
    }

    Text {
        x: 68px;
        y: 14px;
        width: max(32px, parent.width - 152px);
        height: 24px;
        text: root.project.project_name;
        font-size: 16px;
        font-weight: 600;
        color: GitHubTheme.accent-fg;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.project.project_alias != "": GitHubMetadataLabel {
        x: 68px;
        y: 40px;
        max-label-width: min(168px, max(48px, parent.width - 152px));
        text: root.project.project_alias;
    }

    Text {
        x: 16px;
        y: 70px;
        width: parent.width - 32px;
        height: 20px;
        text: root.project.remote_repo;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 16px;
        y: 94px;
        width: parent.width - 32px;
        height: 20px;
        text: root.project.local_repo;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: 16px;
        y: 126px;
        width: parent.width - 32px;
        height: 20px;
        spacing: 6px;
        alignment: start;

        for project-tag in root.project.project_tags: GitHubMetadataLabel {
            text: project-tag;
        }
    }

    if root.project.is_pr_auto_update: Text {
        x: 16px;
        y: 168px;
        width: max(24px, parent.width - 136px);
        height: 20px;
        text: root.project.pr_count_loading
            ? I18n.projects-pull-requests-loading
            : root.project.pr_count_failed
                ? I18n.projects-pull-requests-unavailable
                : "FAT " + root.project.pr_fat_count_text
                    + " · UAT " + root.project.pr_uat_count_text
                    + " · PROD " + root.project.pr_prod_count_text;
        font-size: 12px;
        color: root.project.pr_count_failed
            ? (GitHubTheme.danger-fg)
            : (GitHubTheme.fg-muted);
        vertical-alignment: center;
        overflow: elide;
    }

    card-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: button;
        accessible-enabled: true;
        accessible-label: I18n.projects-open-project + " " + root.project.project_name;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.open-requested();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }

    card-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 160px;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            card-focus.focus();
            root.open-requested();
        }
    }

    TouchArea {
        x: 0px;
        y: 160px;
        width: max(0px, parent.width - 112px);
        height: 44px;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            card-focus.focus();
            root.open-requested();
        }
    }

    HorizontalLayout {
        // parent.width is the floored grid card width; keep the trailing
        // action cluster on the same whole-pixel grid.
        x: Math.floor((parent.width - 112px) / 1px) * 1px;
        y: 164px;
        width: 96px;
        height: 32px;
        spacing: 0px;
        alignment: end;

        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-terminal-16.svg");
            tooltip: I18n.tooltip-open-terminal;
            tooltip-above: true;
            tooltip-end: true;
            clicked => { root.terminal-requested(); }
        }
        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-pencil-16.svg");
            tooltip: I18n.tooltip-edit-project;
            tooltip-above: true;
            tooltip-end: true;
            clicked => { root.edit-requested(); }
        }
        GitHubProjectIconButton {
            icon: @image-url("../../assets/icons/octicon-trash-16.svg");
            tooltip: I18n.projects-delete-project;
            tooltip-above: true;
            tooltip-end: true;
            danger: true;
            clicked => { root.delete-requested(); }
        }
    }

    if card-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: GitHubMetrics.radius-medium;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}
