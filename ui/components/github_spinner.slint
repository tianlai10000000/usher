import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
import { I18n } from "@i18n";

// Primer Spinner is a visual, indeterminate progress indicator. Callers must
// also keep a visible loading label or status message; the spinner is never
// the only loading communication.
// Reference: https://primer.style/product/components/spinner/
//
// The theme-colored track is a static Path. The head is a static SVG whose
// transform rotates, avoiding per-frame Path reconstruction while preserving
// Primer's 2px track + quarter-ring head at every spinner size.
export component GitHubSpinner inherits Rectangle {
    in property <length> spinner-size: GitHubMetrics.icon-medium;
    in property <color> foreground: GitHubTheme.fg-muted;
    in property <bool> spinning: true;

    width: root.spinner-size;
    height: root.spinner-size;
    background: transparent;
    accessible-role: progress-indicator;
    accessible-label: I18n.common-loading;

    // Keep the Primer 2px stroke at every display size (SVG used
    // vector-effect="non-scaling-stroke").
    private property <float> vb: 100;
    private property <float> stroke-vb: 2 * root.vb / (root.spinner-size / 1px);
    private property <float> radius: root.vb / 2 - root.stroke-vb / 2;
    private property <float> inner-radius: root.radius - root.stroke-vb;
    private property <float> cx: root.vb / 2;
    private property <float> cy: root.vb / 2;
    // Full track ring at 25% opacity.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.vb;
        viewbox-height: root.vb;
        fill: root.foreground;
        opacity: 0.25;

        MoveTo {
            x: root.cx;
            y: root.cy - root.radius;
        }
        ArcTo {
            radius-x: root.radius;
            radius-y: root.radius;
            x: root.cx;
            y: root.cy + root.radius;
            sweep: true;
            large-arc: true;
        }
        ArcTo {
            radius-x: root.radius;
            radius-y: root.radius;
            x: root.cx;
            y: root.cy - root.radius;
            sweep: true;
            large-arc: true;
        }
        LineTo {
            x: root.cx;
            y: root.cy - root.inner-radius;
        }
        ArcTo {
            radius-x: root.inner-radius;
            radius-y: root.inner-radius;
            x: root.cx;
            y: root.cy + root.inner-radius;
            sweep: false;
            large-arc: true;
        }
        ArcTo {
            radius-x: root.inner-radius;
            radius-y: root.inner-radius;
            x: root.cx;
            y: root.cy - root.inner-radius;
            sweep: false;
            large-arc: true;
        }
    }

    // Rotate one cached visual instead of rebuilding arc geometry each frame.
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../assets/icons/github-spinner-head-16.svg");
        image-fit: contain;
        colorize: root.foreground;
        transform-rotation: root.spinning
            ? mod(animation-tick(), 1s) / 1s * 360deg
            : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }
}

// Centered spinner + status label used by PR list and PR review loading panels.
// Geometry matches the Workflow pull-request list: 32px spinner, 13px muted
// label, 42px vertical gap from spinner top to label top inside a 64px stack.
export component GitHubCenteredLoadingState inherits Rectangle {
    in property <string> label;
    in property <color> foreground: GitHubTheme.fg-muted;

    background: transparent;
    accessible-role: progress-indicator;
    accessible-label: root.label;

    GitHubSpinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - 64px) / 2;
        spinner-size: 32px;
        foreground: root.foreground;
    }

    Text {
        x: 24px;
        y: (parent.height - 64px) / 2 + 42px;
        width: parent.width - 48px;
        height: 22px;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        color: root.foreground;
    }
}
