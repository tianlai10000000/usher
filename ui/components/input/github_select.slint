import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubActionMenu, GitHubActionListItem } from "../github_action_menu.slint";
import { GitHubTransientFloatingOverlayHost } from "../github_floating_overlay.slint";
import { GitHubTooltipPlacement, GitHubTooltipAlignment } from "../../state/tooltip_overlay_state.slint";

export struct GitHubSelectGeometry { x: length, y: length, width: length, height: length }

// Transient presentation is local to the mounted UI tree. Feature callbacks
// retain ownership of committed values, including inside factory products.
export global GitHubSelectState {
    in-out property <bool> open: false;
    in-out property <string> owner: "";
    in-out property <string> selected-value: "";
    in-out property <int> active-index: 0;
    in-out property <bool> keyboard-navigation: false;
    in-out property <int> commit-revision: 0;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    in-out property <GitHubSelectGeometry> surface;
    in-out property <bool> restore-focus: true;

    public function close(restore: bool) {
        root.restore-focus = restore;
        root.open = false;
    }

    public function pointer-released(x: length, y: length) {
        if root.open
            && !(x >= root.surface.x && x < root.surface.x + root.surface.width
                && y >= root.surface.y && y < root.surface.y + root.surface.height)
            && !(x >= root.anchor-x && x < root.anchor-x + root.anchor-width
                && y >= root.anchor-y && y < root.anchor-y + root.anchor-height) {
            root.close(false);
        }
    }

    public function toggle(owner: string, value: string, index: int,
            x: length, y: length, width: length, height: length) {
        if root.open && root.owner == owner {
            root.close(true);
        } else {
            root.show(owner, value, index, x, y, width, height);
        }
    }

    public function show(owner: string, value: string, index: int,
            x: length, y: length, width: length, height: length) {
        root.owner = owner;
        root.selected-value = value;
        root.active-index = index;
        root.keyboard-navigation = false;
        root.anchor-x = x;
        root.anchor-y = y;
        root.anchor-width = width;
        root.anchor-height = height;
        root.restore-focus = true;
        root.open = true;
    }
}

// Mount at the owning page/window root, outside every scrolling layout.
export component GitHubSelectPopup inherits FocusScope {
    in property <string> owner;
    in property <int> option-count;
    // Page factories can occupy the whole window while their usable viewport
    // stops above persistent chrome such as the status bar. Keep collision
    // bounds explicit so page Selects do not treat covered space as available.
    in property <length> viewport-x: 0px;
    in property <length> viewport-y: 0px;
    in property <length> viewport-width: root.width;
    in property <length> viewport-height: root.height;
    // Group headings participate in layout but not option indexing.
    in property <length> list-content-height:
        root.option-count * GitHubMetrics.size-32;
    in property <length> active-option-offset:
        GitHubSelectState.active-index * GitHubMetrics.size-32;
    callback selected(int);
    private property <bool> open: GitHubSelectState.open && GitHubSelectState.owner == root.owner;
    private property <length> popup-width:
        max(0px, min(GitHubSelectState.anchor-width,
            root.viewport-width - GitHubMetrics.size-16));
    private property <length> anchor-top: GitHubSelectState.anchor-y - root.absolute-position.y;
    private property <length> space-above: max(0px,
        root.anchor-top - root.viewport-y - GitHubMetrics.size-12);
    private property <length> space-below: max(0px,
        root.viewport-y + root.viewport-height - root.anchor-top
            - GitHubSelectState.anchor-height - GitHubMetrics.size-12);
    private property <length> available-height: max(root.space-above, root.space-below);
    private property <length> popup-height: min(264px, root.available-height,
        root.list-content-height + GitHubMetrics.size-8);
    out property <length> option-width: max(0px, root.popup-width - GitHubMetrics.size-8);
    private property <GitHubSelectGeometry> surface-geometry: {
        x: menu.absolute-position.x, y: menu.absolute-position.y,
        width: menu.width, height: menu.height,
    };
    changed open => {
        if root.open { GitHubSelectState.surface = root.surface-geometry; }
    }
    changed surface-geometry => {
        if root.open { GitHubSelectState.surface = root.surface-geometry; }
    }
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    visible: root.open;
    // This scope only captures descendant keyboard events. Taking pointer
    // focus here would consume clicks intended for controls behind the host.
    focus-on-click: false;
    focus-on-tab-navigation: false;

    capture-key-pressed(event) => {
        if !root.open {
            return reject;
        }
        if event.text == Key.Escape || event.text == Key.Tab {
            GitHubSelectState.close(event.text == Key.Escape);
            return event.text == Key.Escape ? accept : reject;
        }
        if event.text == Key.DownArrow || event.text == Key.UpArrow {
            GitHubSelectState.keyboard-navigation = true;
            GitHubSelectState.active-index = mod(GitHubSelectState.active-index + root.option-count
                + (event.text == Key.DownArrow ? 1 : -1), max(1, root.option-count));
            return accept;
        }
        if event.text == Key.Home || event.text == Key.End {
            GitHubSelectState.keyboard-navigation = true;
            GitHubSelectState.active-index = event.text == Key.Home ? 0 : max(0, root.option-count - 1);
            return accept;
        }
        if event.text == Key.Return || event.text == " " {
            root.selected(GitHubSelectState.active-index);
            return accept;
        }
        return reject;
    }

    GitHubTransientFloatingOverlayHost {
        active: root.open;
        x: root.viewport-x;
        y: root.viewport-y;
        width: root.viewport-width;
        height: root.viewport-height;
        anchor-x: GitHubSelectState.anchor-x;
        anchor-y: GitHubSelectState.anchor-y;
        anchor-width: GitHubSelectState.anchor-width;
        anchor-height: GitHubSelectState.anchor-height;
        floating-width: root.popup-width;
        floating-height: root.popup-height;
        preferred-placement: root.space-below < root.popup-height && root.space-above > root.space-below
            ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.Start;

      // The shared floating host positions the surface. ActionMenu supplies
      // its chrome, scrolling, focus, and exclusive-menu lifecycle only.
      menu := GitHubActionMenu {
        x: 0px;
        y: 0px;
        width: root.popup-width;
        height: root.popup-height;
        open: root.open;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        anchor-x: GitHubSelectState.anchor-x - root.absolute-position.x - root.viewport-x;
        anchor-y: GitHubSelectState.anchor-y - root.absolute-position.y - root.viewport-y;
        anchor-width: GitHubSelectState.anchor-width;
        anchor-height: GitHubSelectState.anchor-height;
        menu-width: GitHubSelectState.anchor-width;
        menu-max-height: 264px;
        content-height: root.list-content-height + GitHubMetrics.size-8;
        reveal-offset: root.active-option-offset;
        reveal-height: GitHubMetrics.size-32 + GitHubMetrics.size-8;
        dismiss-requested => { GitHubSelectState.close(false); }

        Rectangle {
            x: GitHubMetrics.size-4;
            y: GitHubMetrics.size-4;
            width: root.option-width;
            height: root.list-content-height;
            @children
        }
      }
    }
}

export component GitHubSelectOption inherits GitHubActionListItem {
    in property <bool> active: false;
    in property <string> group-label: "";
    selectable: true;
    selected-visual-color: GitHubTheme.fg-default;
    keyboard-active: root.active && GitHubSelectState.keyboard-navigation;
    accessible-description: root.group-label;
    changed active => {
        if root.active { root.focus(); }
    }
}

// Primer ActionList group heading used by grouped Select/SelectPanel content.
// It stays outside option indexing so pointer and keyboard selection remain
// aligned even when callers mix any number of groups and options.
export component GitHubSelectGroupHeading inherits Rectangle {
    in property <string> text;
    in property <string> auxiliary-text: "";
    in property <bool> filled: false;

    width: 100%;
    height: GitHubMetrics.size-28;
    background: root.filled ? GitHubTheme.control-muted-rest : transparent;

    if root.filled: Rectangle {
        y: 0px;
        width: parent.width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-muted;
    }

    Text {
        x: GitHubMetrics.size-8;
        width: parent.width - GitHubMetrics.size-16
            - (root.auxiliary-text == "" ? 0px : GitHubMetrics.size-48);
        height: parent.height;
        text: root.text;
        accessible-label: root.auxiliary-text == ""
            ? root.text
            : root.text + ". " + root.auxiliary-text;
        font-size: GitHubMetrics.text-small;
        font-weight: 600;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.auxiliary-text != "": Text {
        x: parent.width - GitHubMetrics.size-56;
        width: GitHubMetrics.size-48;
        height: parent.height;
        text: root.auxiliary-text;
        font-size: GitHubMetrics.text-small;
        color: GitHubTheme.fg-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.filled: Rectangle {
        y: parent.height - GitHubMetrics.border-thin;
        width: parent.width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-muted;
    }
}
