import { GitHubTheme } from "../../theme/github_theme.slint";

export component GitHubRadio inherits FocusScope {
    in property <string> text;
    in property <string> description: "";
    in property <bool> checked: false;
    in property <bool> control-enabled: true;
    callback chosen();
    callback stepped(int);
    private property <bool> keyboard-focus: false;
    width: max(label.preferred-width, description-label.preferred-width) + 32px;
    height: root.description == "" ? 32px : 52px;
    enabled: root.control-enabled;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-enabled: root.control-enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
    focus-lost => { root.keyboard-focus = false; }
    key-pressed(event) => {
        root.keyboard-focus = true;
        if !root.control-enabled { return reject; }
        if event.text == " " || event.text == Key.Return { root.chosen(); return accept; }
        if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.stepped(-1); return accept; }
        if event.text == Key.RightArrow || event.text == Key.DownArrow { root.stepped(1); return accept; }
        return reject;
    }
    Rectangle {
        x: 1px; y: 5px; width: 22px; height: 22px; border-radius: 11px;
        background: transparent; border-width: 2px; border-color: GitHubTheme.accent-fg;
        visible: root.has-focus && root.keyboard-focus;
    }
    Rectangle {
        x: 4px; y: 8px; width: 16px; height: 16px; border-radius: 8px;
        border-width: 1px;
        border-color: root.checked || touch.has-hover ? GitHubTheme.accent-emphasis : GitHubTheme.border-strong;
        background: GitHubTheme.canvas-default;
        opacity: root.control-enabled ? 1 : 0.5;
        Rectangle {
            x: 4px; y: 4px; width: 8px; height: 8px; border-radius: 4px;
            background: GitHubTheme.accent-emphasis; visible: root.checked;
        }
    }
    label := Text {
        x: 28px; y: 0px; height: 32px; width: parent.width - 28px;
        text: root.text; font-size: 14px; vertical-alignment: center;
        color: root.control-enabled ? GitHubTheme.fg-default : GitHubTheme.control-disabled-fg;
        overflow: elide;
    }
    description-label := Text {
        x: 28px; y: 32px; width: parent.width - 28px; height: 20px;
        visible: root.description != "";
        text: root.description; font-size: 12px;
        color: GitHubTheme.fg-muted; overflow: elide;
    }
    touch := TouchArea {
        width: parent.width; height: parent.height; enabled: root.control-enabled;
        mouse-cursor: pointer;
        clicked => { root.focus(); root.keyboard-focus = false; root.chosen(); }
    }
}
