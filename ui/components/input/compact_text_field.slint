import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";

export component GitHubCompactTextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> accessible-name: root.placeholder;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <InputType> input-type: InputType.text;
    in property <length> field-height: GitHubMetrics.control-medium-size;
    in property <length> border-radius-size: GitHubMetrics.radius-medium;
    in property <length> input-font-size: GitHubMetrics.text-medium;
    in property <brush> field-background: GitHubTheme.canvas-default;
    in property <color> field-border-color: GitHubTheme.border-default;
    in property <bool> validation-error: false;
    callback edited(string);
    callback accepted(string);

    private property <length> horizontal-padding: 12px;
    private property <length> computed_x: 0px;

    height: root.field-height;
    border-radius: root.border-radius-size;
    border-width: input.has-focus
        ? GitHubMetrics.focus-outline-width
        : GitHubMetrics.border-thin;
    border-color: root.validation-error
        ? GitHubTheme.danger-emphasis
        : (input.has-focus
            ? GitHubTheme.focus-outline
            : root.field-border-color);
    background: root.field-background;
    clip: true;

    input := TextInput {
        x: root.horizontal-padding + min(0px,
            max(parent.width - root.horizontal-padding * 2 - self.width - self.text-cursor-width, root.computed_x));
        y: (parent.height - self.preferred-height) / 2;
        width: max(parent.width - root.horizontal-padding * 2 - self.text-cursor-width, self.preferred-width);
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        input-type: root.input-type;
        color: GitHubTheme.fg-default;
        font-size: root.input-font-size;
        text-cursor-width: 2px;
        single-line: true;
        selection-background-color: GitHubTheme.selection-bg;
        selection-foreground-color: self.color;
        accessible-role: text-input;
        accessible-enabled: root.enabled;
        accessible-label: root.accessible-name;
        accessible-value <=> self.text;

        cursor_position_changed(cursor_position) => {
            if cursor_position.x + root.computed_x < 0px {
                root.computed_x = -cursor_position.x;
            } else if cursor_position.x + root.computed_x > parent.width - root.horizontal-padding * 2 - self.text-cursor-width {
                root.computed_x = parent.width - root.horizontal-padding * 2 - cursor_position.x - self.text-cursor-width;
            }
        }

        edited => {
            root.edited(self.text);
        }

        accepted => {
            root.accepted(self.text);
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: root.horizontal-padding;
        y: (parent.height - self.preferred-height) / 2;
        text: root.placeholder;
        font-size: root.input-font-size;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
    }
}
