import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
import { TransientOverlayState } from "../state/transient_overlay_state.slint";

// Primer ActionMenu is an ActionList inside AnchoredOverlay. This shell owns
// the shared Overlay surface and collision-aware placement. Coordinates are in
// the component's parent space so callers can anchor from any page layer.
//
// Dismissal contract:
// 1. Escape, chrome dismiss-revision, and peer exclusive-generation are owned
//    here via dismiss-requested. Opening claims exclusivity so readiness /
//    filter / file menus switch on the first click without page-local wiring.
// 2. Page blank outside clicks stay on each host's sibling TouchArea under the
//    menu and under chrome that must keep receiving clicks. A full-viewport
//    hit target inside this z:10000 surface would swallow those triggers.
export component GitHubActionMenu inherits FocusScope {
    in property <bool> open: false;
    in property <length> viewport-x: 0px;
    in property <length> viewport-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <length> anchor-width: 0px;
    in property <length> anchor-height: 0px;
    in property <length> menu-width: 256px;
    in property <length> content-height: 0px;
    in property <length> menu-max-height: 600px;
    in property <string> align: "start";
    // "auto" flips to the side with more room; "top"/"bottom" pin a side.
    in property <string> side: "auto";
    in property <length> anchor-gap: 4px;
    in property <length> viewport-margin: 8px;
    in property <bool> dismiss-on-escape: true;
    in property <length> reveal-offset: -1px;
    in property <length> reveal-height: 0px;
    callback dismiss-requested();
    out property <bool> opens-above:
        root.side == "top"
        || (root.side == "auto"
            && root.space-below < root.desired-height
            && root.space-above > root.space-below);

    private property <length> desired-width:
        min(root.menu-width, max(0px, root.viewport-width - root.viewport-margin * 2));
    private property <length> desired-height: min(root.content-height, root.menu-max-height);
    private property <length> viewport-right: root.viewport-x + root.viewport-width;
    private property <length> viewport-bottom: root.viewport-y + root.viewport-height;
    private property <length> space-above:
        max(0px, root.anchor-y - root.viewport-y - root.viewport-margin - root.anchor-gap);
    private property <length> space-below:
        max(0px, root.viewport-bottom - root.viewport-margin
            - (root.anchor-y + root.anchor-height) - root.anchor-gap);
    private property <length> aligned-x:
        root.align == "end"
            ? root.anchor-x + root.anchor-width - root.desired-width
            : (root.align == "center"
                ? root.anchor-x + (root.anchor-width - root.desired-width) / 2
                : root.anchor-x);
    private property <length> scroll-offset-y: 0px;
    private property <int> dismiss-revision: TransientOverlayState.dismiss-revision;
    private property <int> exclusive-generation: TransientOverlayState.exclusive-generation;
    private property <int> exclusive-token: 0;

    changed reveal-offset => {
        if root.open && root.reveal-offset >= 0px {
            root.scroll-offset-y = -max(0px, min(root.content-height - root.height,
                max(root.reveal-offset + root.reveal-height - root.height,
                    min(-root.scroll-offset-y, root.reveal-offset))));
        }
    }

    accessible-role: list;

    changed open => {
        if root.open {
            // Claim after stamping the next generation so the synchronous
            // exclusive-generation notification cannot dismiss this opener.
            root.exclusive-token = TransientOverlayState.exclusive-generation + 1;
            TransientOverlayState.claim-exclusive();
            root.scroll-offset-y = root.reveal-offset < 0px ? 0px
                : -max(0px, min(root.content-height - root.height,
                    root.reveal-offset + root.reveal-height - root.height));
            root.focus();
        } else if root.has-focus {
            root.clear-focus();
        }
    }

    changed dismiss-revision => {
        if root.open {
            TransientOverlayState.note-closed-open-menu();
            root.dismiss-requested();
        }
    }

    changed exclusive-generation => {
        if root.open && root.exclusive-token != TransientOverlayState.exclusive-generation {
            root.dismiss-requested();
        }
    }

    capture-key-pressed(event) => {
        if root.open && root.dismiss-on-escape && event.text == Key.Escape {
            root.dismiss-requested();
            return accept;
        }
        return reject;
    }

    key-pressed(event) => {
        if root.open && root.dismiss-on-escape && event.text == Key.Escape {
            root.dismiss-requested();
            return accept;
        }
        return reject;
    }

    visible: root.open && root.width > 0px && root.height > 0px;
    x: max(
        root.viewport-x + root.viewport-margin,
        min(root.viewport-right - root.viewport-margin - root.desired-width, root.aligned-x)
    );
    y: root.opens-above
        ? root.anchor-y - root.anchor-gap - root.height
        : root.anchor-y + root.anchor-height + root.anchor-gap;
    width: root.desired-width;
    height: min(root.desired-height, root.opens-above ? root.space-above : root.space-below);
    z: 10000;

    menu-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        border-width: 1px;
        border-color: GitHubTheme.border-default;
        background: GitHubTheme.canvas-overlay;
        drop-shadow-blur: 18px;
        drop-shadow-color: GitHubTheme.shadow-floating-medium;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Own blank areas so the page-level outside-click scrim cannot receive
        // events through the menu.
        TouchArea { mouse-cursor: default; }

        menu-scroll := Flickable {
            width: parent.width;
            height: parent.height;
            viewport-width: self.width;
            viewport-height: max(self.height, root.content-height);
            viewport-x: 0px;
            viewport-y <=> root.scroll-offset-y;
            interactive: true;

            content-host := Rectangle {
                width: menu-scroll.width;
                height: root.content-height;
                background: transparent;
                @children
            }
        }

        if root.content-height > root.height: scroll-thumb := Rectangle {
            x: parent.width - 7px;
            y: 2px + (-menu-scroll.viewport-y)
                * (parent.height - self.height - 4px)
                / max(1px, root.content-height - parent.height);
            width: 5px;
            height: max(24px, (parent.height - 4px) * parent.height / root.content-height);
            border-radius: 3px;
            background: GitHubTheme.drag-handle;
        }
    }
}

// Press/click reconciler for ActionMenu triggers that may share one pointer
// event with TransientOverlayState.dismiss-all (native title-bar / shell
// chrome). Combines press-time open state with closed-open-menu so a gesture
// that chrome-dismisses an open menu ends closed, while a gesture that starts
// from a closed menu can still open.
export component GitHubActionMenuTriggerArea inherits TouchArea {
    in property <bool> menu-open: false;
    in property <bool> trigger-enabled: true;
    callback request-open();
    callback request-close();
    callback activated();

    private property <bool> open-on-press: false;

    enabled: root.trigger-enabled;
    mouse-cursor: root.trigger-enabled ? pointer : default;

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.open-on-press = root.menu-open;
            // Drop a stale latch from an earlier blank-area dismiss so the next
            // intentional open is not blocked.
            if !root.menu-open {
                TransientOverlayState.consume-closed-open-menu();
            }
        }
    }

    clicked => {
        root.activated();
        if root.open-on-press || TransientOverlayState.closed-open-menu {
            TransientOverlayState.consume-closed-open-menu();
            if root.menu-open {
                root.request-close();
            }
        } else if !root.menu-open {
            root.request-open();
        }
    }
}

// Shared ActionList row for ActionMenu content. Feature menus provide their
// own model/state but reuse this geometry and interaction contract.
export component GitHubActionListItem inherits FocusScope {
    in property <string> text;
    in property <string> description: "";
    in property <string> trailing-text: "";
    in property <length> label-font-size: GitHubMetrics.text-medium;
    in property <int> label-font-weight: 400;
    in property <color> selected-visual-color: GitHubTheme.accent-fg;
    in property <bool> show-bottom-divider: false;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> selectable: false;
    in property <bool> item-enabled: true;
    in property <bool> danger: false;
    in property <bool> keyboard-active: false;
    in property <length> bottom-padding: 0px;
    callback activated();

    private property <bool> has-icon:
        root.icon.width > 0 && root.icon.height > 0;
    private property <bool> keyboard-focus-visible: false;
    private property <length> row-height:
        (root.description == "" ? GitHubMetrics.size-32 : GitHubMetrics.size-48)
        + root.bottom-padding;
    // Single-select lists reserve the Check slot for every row so selection
    // never shifts labels or changes the menu's perceived geometry.
    private property <bool> has-leading-visual:
        root.selectable || root.selected || root.has-icon;
    private property <length> content-x:
        root.has-leading-visual ? GitHubMetrics.size-32 : GitHubMetrics.size-8;

    width: 100%;
    height: root.row-height;
    enabled: root.item-enabled;
    accessible-role: button;
    accessible-enabled: root.item-enabled;
    accessible-label: root.description == ""
        ? root.text
        : root.text + ". " + root.description;
    accessible-checkable: root.selectable;
    accessible-checked: root.selected;

    key-pressed(event) => {
        root.keyboard-focus-visible = true;
        if (root.item-enabled
                && (event.text == Key.Return || event.text == " ")) {
            root.activated();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
    }
    focus-lost => {
        root.keyboard-focus-visible = false;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: GitHubMetrics.radius-medium;
        background: item-touch.pressed
            ? GitHubTheme.control-transparent-active
            : (root.keyboard-active || (root.has-focus && root.keyboard-focus-visible)
                ? GitHubTheme.accent-subtle
                : (item-touch.has-hover && root.item-enabled
                    ? (root.danger
                        ? GitHubTheme.danger-muted
                        : GitHubTheme.control-transparent-hover)
                    : transparent));
    }

    if root.selected: Image {
        x: GitHubMetrics.size-8;
        y: (parent.height - self.height) / 2;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: @image-url("../assets/icons/octicon-check-16.svg");
        colorize: root.item-enabled
            ? root.selected-visual-color
            : GitHubTheme.control-disabled-fg;
    }

    if !root.selected && root.has-icon: Image {
        x: GitHubMetrics.size-8;
        y: (parent.height - self.height) / 2;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: root.icon;
        colorize: !root.item-enabled
            ? GitHubTheme.control-disabled-fg
            : (root.danger ? GitHubTheme.danger-fg : GitHubTheme.fg-muted);
    }

    Text {
        x: root.content-x;
        y: root.description == "" ? 0px : GitHubMetrics.size-6;
        width: parent.width - self.x - GitHubMetrics.size-8
            - (root.trailing-text == "" ? 0px : GitHubMetrics.size-64);
        height: root.description == "" ? parent.height : GitHubMetrics.size-20;
        text: root.text;
        font-size: root.label-font-size;
        font-weight: root.label-font-weight;
        color: !root.item-enabled
            ? GitHubTheme.control-disabled-fg
            : (root.danger ? GitHubTheme.danger-fg : GitHubTheme.fg-default);
        vertical-alignment: center;
        overflow: elide;
    }

    if root.description != "": Text {
        x: root.content-x;
        y: GitHubMetrics.size-20 + GitHubMetrics.size-6;
        width: parent.width - self.x - GitHubMetrics.size-8;
        height: GitHubMetrics.size-16;
        text: root.description;
        font-size: GitHubMetrics.text-small;
        color: root.item-enabled
            ? GitHubTheme.fg-muted
            : GitHubTheme.control-disabled-fg;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.trailing-text != "": Text {
        x: parent.width - GitHubMetrics.size-64;
        width: GitHubMetrics.size-48;
        height: parent.height;
        text: root.trailing-text;
        font-size: GitHubMetrics.text-small;
        color: root.item-enabled
            ? GitHubTheme.fg-muted
            : GitHubTheme.control-disabled-fg;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.show-bottom-divider: Rectangle {
        y: parent.height - GitHubMetrics.border-thin;
        width: parent.width;
        height: GitHubMetrics.border-thin;
        background: GitHubTheme.border-muted;
    }

    item-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.item-enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            root.focus();
            root.activated();
        }
    }

    if root.keyboard-active || (root.has-focus && root.keyboard-focus-visible): Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: GitHubMetrics.radius-medium;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}
