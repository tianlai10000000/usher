import { AppState } from "../../state/app_state.slint";
import { NotificationType } from "notification.slint";

// Floating application notifications reproduce Primer React Banner's compact
// geometry: 8px outer padding, 1px semantic border, 6px radius, 16px status
// Octicon, 14px text, and stacked actions below complex content.
export component ActionsNotify inherits Rectangle {
    in property <int> notification-id;
    in property <string> title;
    in property <string> message;
    in property <image> icon;
    in property <[string]> actions: [];
    in property <NotificationType> notification-type: NotificationType.Info;

    callback close-clicked();
    callback action-clicked(/* action-index */ int);

    private property <bool> dark: AppState.effective-dark-mode;
    private property <color> foreground: root.dark ? #f0f6fc : #1f2328;
    private property <color> muted-foreground: root.dark ? #b7bdc8 : #59636e;
    private property <color> canvas: root.dark ? #0d1117 : #ffffff;
    private property <color> border: root.dark ? #3d444d : #d1d9e0;
    private property <color> semantic-foreground:
        root.notification-type == NotificationType.Success ? (root.dark ? #3fb950 : #1a7f37) :
        root.notification-type == NotificationType.Info ? (root.dark ? #4493f8 : #0969da) :
        root.notification-type == NotificationType.Warning ? (root.dark ? #d29922 : #9a6700) :
        (root.dark ? #f85149 : #cf222e);

    height: max(48px, banner-content.preferred-height);
    background: root.canvas;
    border-width: 1px;
    border-color: root.border;
    border-radius: 6px;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: root.dark ? #00000066 : #1f232826;

    banner-content := VerticalLayout {
        width: parent.width;
        spacing: 4px;
        padding: 8px;

        HorizontalLayout {
            min-height: 32px;
            spacing: 0px;
            padding-right: 32px;
            alignment: start;

            Rectangle {
                width: 32px;
                min-height: 32px;
                background: transparent;

                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: root.icon;
                    colorize: root.semantic-foreground;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                padding-top: 6px;
                padding-bottom: 6px;

                if root.title != "": Text {
                    text: root.title;
                    color: root.foreground;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }

                if root.message != "": Text {
                    text: root.message;
                    color: root.title == "" ? root.foreground : root.muted-foreground;
                    font-size: 14px;
                    font-weight: 400;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
            }
        }

        if root.actions.length > 0: HorizontalLayout {
            height: 36px;
            spacing: 12px;
            padding-top: 4px;
            alignment: end;

            // Keep the card-level action group pinned to the trailing edge,
            // secondary first and primary last.
            Rectangle { horizontal-stretch: 1; }

            for action[index] in root.actions: Rectangle {
                private property <bool> primary:
                    root.actions.length > 1 && index == root.actions.length - 1;

                action-label-measure := Text {
                    visible: false;
                    text: action;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                }

                width: max(64px, action-label-measure.preferred-width + 24px);
                horizontal-stretch: 0;
                height: 32px;
                border-radius: 6px;
                border-width: primary ? 0px : 1px;
                border-color: root.dark ? #3d444d : #d1d9e0;
                background: primary
                    ? (action-touch.has-hover ? (root.dark ? #2ea043 : #1a7f37) : (root.dark ? #238636 : #1f883d))
                    : (action-touch.has-hover ? (root.dark ? #30363d : #f3f4f6) : (root.dark ? #21262d : #f6f8fa));

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: action;
                        color: primary ? #ffffff : root.foreground;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                action-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action-clicked(index); }
                }
            }
        }
    }

    close-button := Rectangle {
        x: parent.width - 40px;
        y: 8px;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: close-touch.has-hover
            ? (root.dark ? #ffffff14 : #1f23280f)
            : transparent;

        Image {
            x: 8px;
            y: 8px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/octicon-x-16.svg");
            colorize: root.muted-foreground;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close-clicked(); }
        }
    }
}
