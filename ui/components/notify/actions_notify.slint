import { GitHubTheme } from "../../theme/github_theme.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { NotificationType } from "notification.slint";

// Floating application notifications reproduce Primer React Banner's compact
// geometry: 8px outer padding, 1px semantic border, 6px radius, 16px status
// Octicon, 14px text, and stacked actions below complex content.
export component GitHubNotificationBanner inherits Rectangle {
    in property <int> notification-id;
    in property <string> title;
    in property <string> message;
    in property <image> icon;
    in property <[string]> actions: [];
    in property <NotificationType> notification-type: NotificationType.Info;

    callback close-clicked();
    callback action-clicked(/* action-index */ int);

    private property <color> foreground: GitHubTheme.fg-default;
    private property <color> muted-foreground: GitHubTheme.fg-muted;
    private property <color> canvas:
        root.notification-type == NotificationType.Success ? GitHubTheme.success-muted :
        root.notification-type == NotificationType.Info ? GitHubTheme.accent-subtle :
        root.notification-type == NotificationType.Warning ? GitHubTheme.attention-muted :
        GitHubTheme.danger-muted;
    private property <color> border:
        root.notification-type == NotificationType.Success ? GitHubTheme.success-fg :
        root.notification-type == NotificationType.Info ? GitHubTheme.accent-muted :
        root.notification-type == NotificationType.Warning ? GitHubTheme.attention-fg :
        GitHubTheme.danger-border-muted;
    private property <color> semantic-foreground:
        root.notification-type == NotificationType.Success ? GitHubTheme.success-fg :
        root.notification-type == NotificationType.Info ? GitHubTheme.accent-fg :
        root.notification-type == NotificationType.Warning ? GitHubTheme.attention-fg :
        GitHubTheme.danger-fg;

    height: max(48px, banner-content.preferred-height);
    background: root.canvas;
    border-width: 1px;
    border-color: root.border;
    border-radius: 6px;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: GitHubTheme.shadow-floating-medium;

    banner-content := VerticalLayout {
        width: parent.width;
        spacing: 4px;
        padding: 8px;

        HorizontalLayout {
            min-height: 32px;
            spacing: 0px;
            padding-right: 32px;
            alignment: start;

            Rectangle {
                width: 32px;
                min-height: 32px;
                background: transparent;

                Image {
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    source: root.icon;
                    colorize: root.semantic-foreground;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                padding-top: 6px;
                padding-bottom: 6px;

                if root.title != "": Text {
                    text: root.title;
                    color: root.foreground;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }

                if root.message != "": Text {
                    text: root.message;
                    color: root.title == "" ? root.foreground : root.muted-foreground;
                    font-size: 14px;
                    font-weight: 400;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
            }
        }

        if root.actions.length > 0: HorizontalLayout {
            height: 36px;
            spacing: 12px;
            padding-top: 4px;
            alignment: end;

            // Keep the card-level action group pinned to the trailing edge,
            // secondary first and primary last.
            Rectangle { horizontal-stretch: 1; }

            for action[index] in root.actions: GitHubButton {
                text: action;
                primary: root.actions.length > 1
                    && index == root.actions.length - 1;
                clicked => { root.action-clicked(index); }
            }
        }
    }

    close-button := GitHubIconButton {
        x: parent.width - 40px;
        y: 8px;
        icon: @image-url("../../assets/icons/octicon-x-16.svg");
        tooltip-text: "Dismiss notification";
        show-tooltip: false;
        tooltip-align-right: true;
        tooltip-above: false;
        foreground: root.muted-foreground;
        clicked => { root.close-clicked(); }
    }
}
