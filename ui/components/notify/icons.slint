// Primer Banner uses outline Octicons at 16px for 14px notification text.
export global NotificationIcons {
    out property <image> info: @image-url("../../assets/icons/octicon-info-16.svg");
    out property <image> success: @image-url("../../assets/icons/octicon-check-circle-16.svg");
    out property <image> warning: @image-url("../../assets/icons/octicon-alert-16.svg");
    out property <image> error: @image-url("../../assets/icons/octicon-stop-16.svg");
}
