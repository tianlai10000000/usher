// 嵌入式通知图标（编译时嵌入，无需运行时加载）
export global NotificationIcons {
    out property <image> info: @image-url("../../assets/icons/info.svg");
    out property <image> success: @image-url("../../assets/icons/success.svg");
    out property <image> warning: @image-url("../../assets/icons/warning.svg");
    out property <image> error: @image-url("../../assets/icons/error.svg");
}
