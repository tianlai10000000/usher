import { Notification } from "notification.slint";
import { ActionsNotify } from "actions_notify.slint";

export component NotificationItem inherits Rectangle {
    in property <Notification> notification;
    in property <int> index;

    callback dismissed(int);
    callback hovered(int, bool);
    callback action-clicked(/* id */ int, /* action-index */ int);

    private property <bool> is-hovered: hover-area.has-hover;
    private property <length> item-spacing: 8px;

    width: 100%;
    height: notification.dismissed ? 0px : banner.height + root.item-spacing;
    opacity: notification.dismissed ? 0 : 1;
    background: transparent;
    clip: true;
    animate height { duration: 180ms; easing: ease-out; }
    animate opacity { duration: 120ms; }

    hover-area := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: default;
    }

    banner := ActionsNotify {
        width: parent.width;
        notification-id: root.notification.id;
        title: root.notification.title;
        message: root.notification.message;
        icon: root.notification.icon;
        actions: root.notification.actions;
        notification-type: root.notification.type;

        close-clicked => { root.dismissed(root.notification.id); }
        action-clicked(action-index) => {
            root.action-clicked(root.notification.id, action-index);
        }
    }

    changed is-hovered => {
        root.hovered(root.notification.id, root.is-hovered);
    }
}
