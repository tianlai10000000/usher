import { I18n } from "@i18n";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubTooltipSurface } from "../github_tooltip.slint";
import { GitHubFloatingOverlayHost } from "../github_floating_overlay.slint";
import { GitHubTooltipAlignment } from "../../state/tooltip_overlay_state.slint";

export enum HookTooltipKind { None, Edit, Delete, Stop, ViewRun, ClearHistory }
export global HookTooltipState {
    in-out property <HookTooltipKind> kind: HookTooltipKind.None;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    in-out property <int> lease: 0;
    public function show(kind: HookTooltipKind, x: length, y: length, width: length, height: length) {
        root.kind = kind;
        root.anchor-x = x; root.anchor-y = y;
        root.anchor-width = width; root.anchor-height = height;
        root.lease += 1;
    }
    public function hide(kind: HookTooltipKind, x: length, y: length) {
        if root.kind == kind && root.anchor-x == x && root.anchor-y == y {
            root.kind = HookTooltipKind.None;
        }
    }
    public function dismiss() { root.kind = HookTooltipKind.None; }
}

// UI-103: each factory action publishes a literal kind. Never pass a tooltip
// string through a recycled list delegate or conditionally remount its surface.

export component GitHubHookEditAction inherits GitHubIconButton {
    private property <bool> published-position: false;
    private property <bool> detached: root.published-position
        && root.absolute-position.x == 0px && root.absolute-position.y == 0px;
    show-tooltip: false;
    tooltip-text: I18n.hooks-edit;
    icon: @image-url("../../assets/icons/octicon-pencil-16.svg");
    private property <bool> tip-active: root.tooltip-active && root.visible && root.button-enabled && !root.detached;
    changed tip-active => { root.publish-tip(); }
    changed absolute-position => { root.publish-tip(); }
    function publish-tip() {
        if root.tip-active && root.width > 0px && root.height > 0px {
            HookTooltipState.show(HookTooltipKind.Edit, root.absolute-position.x,
                root.absolute-position.y, root.width, root.height);
            if root.absolute-position.x != 0px || root.absolute-position.y != 0px { root.published-position = true; }
        } else {
            HookTooltipState.hide(HookTooltipKind.Edit, root.absolute-position.x, root.absolute-position.y);
        }
    }
    Timer {
        interval: 32ms; running: root.tip-active;
        triggered => {
            if HookTooltipState.kind == HookTooltipKind.Edit
                    && HookTooltipState.anchor-x == root.absolute-position.x
                    && HookTooltipState.anchor-y == root.absolute-position.y {
                HookTooltipState.lease += 1;
            }
        }
    }
}

