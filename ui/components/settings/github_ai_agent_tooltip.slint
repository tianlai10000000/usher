import { I18n } from "@i18n";
import { FloatingOverlayRect } from "../../state/floating_overlay_bridge.slint";
import { GitHubTooltipAlignment, GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubToggle } from "./github_settings_controls.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubFixedTooltipAnchor } from "../github_fixed_tooltip_anchor.slint";
import { GitHubTransientFloatingOverlayHost } from "../github_floating_overlay.slint";
import { GitHubTooltipSurface } from "../github_tooltip.slint";

export enum AgentTooltipKind { None, Add, Activate, Current, TestConnection, Edit, Delete, DeleteDisabled }

// A claim carries action identity and geometry only. Tokens reject stale
// releases/renewals after a new row, dialog or lifecycle boundary takes over.
export global AgentTooltipState {
    in-out property <bool> enabled: false;
    in-out property <FloatingOverlayRect> viewport;
    in-out property <AgentTooltipKind> kind: AgentTooltipKind.None;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    in-out property <int> token: 0;
    in-out property <int> lease: 0;
    in-out property <int> dismiss-revision: 0;
    callback show(AgentTooltipKind, length, length, length, length) -> int;
    callback renew(int, AgentTooltipKind, length, length, length, length);
    callback hide(int);
    callback dismiss();
    show(kind, x, y, width, height) => {
        if !root.enabled || kind == AgentTooltipKind.None || width <= 0px || height <= 0px { return 0; }
        root.token += 1; root.kind = kind;
        root.anchor-x = x; root.anchor-y = y;
        root.anchor-width = width; root.anchor-height = height;
        root.lease += 1;
        return root.token;
    }
    renew(token, kind, x, y, width, height) => {
        if root.enabled && token == root.token && root.kind == kind {
            root.anchor-x = x; root.anchor-y = y;
            root.anchor-width = width; root.anchor-height = height;
            root.lease += 1;
        }
    }
    hide(token) => {
        if token == root.token { root.kind = AgentTooltipKind.None; }
    }
    dismiss() => {
        root.kind = AgentTooltipKind.None;
        root.token += 1; root.dismiss-revision += 1;
    }
}

// Shared chrome and lifecycle have no action/label parameter. Every semantic
// leaf below owns its literal kind and its own permanently mounted anchor.
component GitHubAiAgentAction inherits GitHubIconButton {
    in property <FloatingOverlayRect> tooltip-viewport;
    in property <bool> tooltip-eligible: true;
    in property <bool> tip-requested: root.tooltip-active;
    out property <bool> tip-publishable: AgentTooltipState.enabled
        && root.visible && root.tooltip-eligible && root.tip-requested && !root.suppressed;
    private property <bool> suppressed: false;
    private property <int> dismiss-revision: AgentTooltipState.dismiss-revision;
    callback activated();
    show-tooltip: false;
    changed dismiss-revision => { root.suppressed = root.tip-requested; }
    changed tip-requested => { if !root.tip-requested { root.suppressed = false; } }
    clicked => { AgentTooltipState.dismiss(); root.activated(); }
}

export component GitHubAiAgentAddAction inherits GitHubAiAgentAction {
    private property <int> claim: 0;
    tooltip-text: I18n.settings-ai-agent-add;
    icon: @image-url("../../assets/icons/octicon-plus-16.svg");
    primary: true; invisible: false;
    GitHubFixedTooltipAnchor {
        active: root.tip-publishable;
        bounded: true; viewport: root.tooltip-viewport;
        publish(x, y, w, h) => { root.claim = AgentTooltipState.show(AgentTooltipKind.Add, x, y, w, h); }
        release(x, y) => { AgentTooltipState.hide(root.claim); }
        renew(x, y, w, h) => { AgentTooltipState.renew(root.claim, AgentTooltipKind.Add, x, y, w, h); }
    }
}

// Preserve the shared Toggle's click, keyboard, focus and checked rendering.
component GitHubAiAgentActivationToggle inherits GitHubToggle {
    in property <FloatingOverlayRect> tooltip-viewport;
    in property <bool> tooltip-eligible: true;
    in property <bool> tip-requested: root.has-hover || root.tooltip-focus;
    out property <bool> tip-publishable: AgentTooltipState.enabled
        && root.visible && root.tooltip-eligible && root.tip-requested && !root.suppressed;
    private property <bool> suppressed: false;
    private property <int> dismiss-revision: AgentTooltipState.dismiss-revision;
    callback activated();
    changed dismiss-revision => { root.suppressed = root.tip-requested; }
    changed tip-requested => { if !root.tip-requested { root.suppressed = false; } }
    toggled(value) => { AgentTooltipState.dismiss(); if value { root.activated(); } }
}

export component GitHubAiAgentActivateToggle inherits GitHubAiAgentActivationToggle {
    private property <int> claim: 0;
    checked: false;
    accessible-label: I18n.settings-ai-agent-activate;
    GitHubFixedTooltipAnchor {
        active: root.tip-publishable;
        bounded: true; viewport: root.tooltip-viewport;
        publish(x, y, w, h) => { root.claim = AgentTooltipState.show(AgentTooltipKind.Activate, x, y, w, h); }
        release(x, y) => { AgentTooltipState.hide(root.claim); }
        renew(x, y, w, h) => { AgentTooltipState.renew(root.claim, AgentTooltipKind.Activate, x, y, w, h); }
    }
}

export component GitHubAiAgentCurrentToggle inherits GitHubAiAgentActivationToggle {
    private property <int> claim: 0;
    checked: true; interaction-enabled: false;
    accessible-label: I18n.settings-ai-agent-active-badge;
    tip-requested: disabled-hover.has-hover;
    disabled-hover := TouchArea { width: 100%; height: 100%; mouse-cursor: default; clicked => { AgentTooltipState.dismiss(); } }
    GitHubFixedTooltipAnchor {
        active: root.tip-publishable;
        bounded: true; viewport: root.tooltip-viewport;
        publish(x, y, w, h) => { root.claim = AgentTooltipState.show(AgentTooltipKind.Current, x, y, w, h); }
        release(x, y) => { AgentTooltipState.hide(root.claim); }
        renew(x, y, w, h) => { AgentTooltipState.renew(root.claim, AgentTooltipKind.Current, x, y, w, h); }
    }
}

