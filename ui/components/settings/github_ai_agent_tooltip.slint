export component GitHubAiAgentDeleteDisabledAction inherits GitHubAiAgentAction {
    private property <int> claim: 0;
    tooltip-text: I18n.settings-ai-agent-delete-active-disabled;
    icon: @image-url("../../assets/icons/octicon-trash-16.svg");
    danger: true; button-enabled: false;
    tip-requested: disabled-hover.has-hover;
    disabled-hover := TouchArea { width: 100%; height: 100%; mouse-cursor: default; clicked => { AgentTooltipState.dismiss(); } }
    GitHubFixedTooltipAnchor {
        active: root.tip-publishable;
        bounded: true; viewport: root.tooltip-viewport;
        publish(x, y, w, h) => { root.claim = AgentTooltipState.show(AgentTooltipKind.DeleteDisabled, x, y, w, h); }
        release(x, y) => { AgentTooltipState.hide(root.claim); }
        renew(x, y, w, h) => { AgentTooltipState.renew(root.claim, AgentTooltipKind.DeleteDisabled, x, y, w, h); }
    }
}

// One transient locator, seven independent mounted measure/paint surfaces.
export component GitHubAiAgentTooltipOverlay inherits Rectangle {
    in property <bool> tooltip-enabled: false;
    in property <FloatingOverlayRect> anchor-viewport;
    out property <bool> active: root.tooltip-enabled && AgentTooltipState.kind != AgentTooltipKind.None;
    private property <int> observed-lease: 0;
    width: 100%; height: 100%; background: transparent; clip: false;
    init => { AgentTooltipState.enabled = root.tooltip-enabled; AgentTooltipState.viewport = root.anchor-viewport; }
    changed tooltip-enabled => {
        AgentTooltipState.enabled = root.tooltip-enabled;
        if !root.tooltip-enabled { AgentTooltipState.dismiss(); }
    }
    changed anchor-viewport => {
        AgentTooltipState.viewport = root.anchor-viewport;
        AgentTooltipState.dismiss();
    }
    floating := GitHubTransientFloatingOverlayHost {
        active: root.active;
        anchor-x: AgentTooltipState.anchor-x; anchor-y: AgentTooltipState.anchor-y;
        anchor-width: AgentTooltipState.anchor-width; anchor-height: AgentTooltipState.anchor-height;
        preferred-placement: GitHubTooltipPlacement.Top;
        alignment: GitHubTooltipAlignment.Center;
        floating-width:
            AgentTooltipState.kind == AgentTooltipKind.Add ? surface-add.width :
            AgentTooltipState.kind == AgentTooltipKind.Activate ? surface-activate.width :
            AgentTooltipState.kind == AgentTooltipKind.Current ? surface-current.width :
            AgentTooltipState.kind == AgentTooltipKind.TestConnection ? surface-test-connection.width :
            AgentTooltipState.kind == AgentTooltipKind.Edit ? surface-edit.width :
            AgentTooltipState.kind == AgentTooltipKind.Delete ? surface-delete.width :
            AgentTooltipState.kind == AgentTooltipKind.DeleteDisabled ? surface-deletedisabled.width :
            0px;
        floating-height:
            AgentTooltipState.kind == AgentTooltipKind.Add ? surface-add.height :
            AgentTooltipState.kind == AgentTooltipKind.Activate ? surface-activate.height :
            AgentTooltipState.kind == AgentTooltipKind.Current ? surface-current.height :
            AgentTooltipState.kind == AgentTooltipKind.TestConnection ? surface-test-connection.height :
            AgentTooltipState.kind == AgentTooltipKind.Edit ? surface-edit.height :
            AgentTooltipState.kind == AgentTooltipKind.Delete ? surface-delete.height :
            AgentTooltipState.kind == AgentTooltipKind.DeleteDisabled ? surface-deletedisabled.height :
            0px;
        surface-add := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.Add;
            text: I18n.settings-ai-agent-add;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-activate := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.Activate;
            text: I18n.settings-ai-agent-activate;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-current := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.Current;
            text: I18n.settings-ai-agent-active-badge;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-test-connection := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.TestConnection;
            text: I18n.common-test-connection;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-edit := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.Edit;
            text: I18n.settings-ai-agent-edit;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-delete := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.Delete;
            text: I18n.common-delete;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
        surface-deletedisabled := GitHubTooltipSurface {
            visible: AgentTooltipState.kind == AgentTooltipKind.DeleteDisabled;
            text: I18n.settings-ai-agent-delete-active-disabled;
            viewport-max-width: max(0px, root.width - 16px);
            viewport-max-height: max(0px, root.height - 16px);
        }
    }
    Timer {
        interval: 48ms; running: root.active;
        triggered => {
            if AgentTooltipState.lease == root.observed-lease { AgentTooltipState.dismiss(); }
            else { root.observed-lease = AgentTooltipState.lease; }
        }
    }
}

