import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";

export component GitHubSettingsSectionMenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> open: false;
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    width: 100%;
    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: menu-touch.has-hover
        ? GitHubTheme.control-default-hover
        : GitHubTheme.control-default-rest;
    accessible-role: button;
    accessible-label: root.text;

    menu-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    Text {
        x: 12px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 28px;
        y: 12px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
        colorize: GitHubTheme.fg-muted;
        transform-rotation: root.open ? 180deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    menu-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            menu-focus.focus();
            root.clicked();
        }
    }

    if menu-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        border-width: 2px;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

// Shared controls for Settings and About.
//
// Geometry follows the current Primer Product UI medium controls: 32px control
// height, 6px medium radius, 1px border, 12px horizontal button padding, and
// SplitPageLayout/NavList navigation at the 768px regular breakpoint.
export component GitHubSettingsNavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> item-enabled: true;
    private property <bool> keyboard-focus-visible: false;
    callback clicked();

    width: 100%;
    height: 32px;
    border-radius: 6px;
    background: root.selected
        ? (GitHubTheme.control-muted-rest)
        : (nav-touch.has-hover
            ? GitHubTheme.control-default-hover
            : transparent);
    opacity: root.item-enabled ? 1 : 0.5;
    accessible-role: tab;
    accessible-enabled: root.item-enabled;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;

    nav-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (root.item-enabled && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    if nav-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }

    if root.selected: Rectangle {
        x: 0px;
        y: 4px;
        width: 4px;
        height: 24px;
        border-radius: 2px;
        background: GitHubTheme.accent-fg;
    }

    Text {
        x: 16px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    nav-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.item-enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            nav-focus.focus();
            root.clicked();
        }
    }
}

export component GitHubButton inherits Rectangle {
    in property <string> text;
    in property <image> leading-icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> busy: false;
    in property <length> label-font-size: GitHubMetrics.text-medium;
    private property <bool> has-leading-icon:
        root.leading-icon.width > 0 && root.leading-icon.height > 0;
    private property <bool> keyboard-focus-visible: false;
    callback clicked();

    label-measure := Text {
        visible: false;
        text: root.text;
        font-size: root.label-font-size;
        // Match the visible label weight so preferred-width is not underestimated.
        font-weight: 600;
        wrap: no-wrap;
    }

    // 12px side padding + 16px spinner + 4px gap, reserved from the first frame
    // so busy state never shrinks the label or truncates it.
    private property <length> pad-x: 12px;
    private property <length> spinner-slot: GitHubMetrics.icon-medium + 4px;
    width: max(72px, label-measure.preferred-width + root.pad-x * 2 + root.spinner-slot);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary
        ? (GitHubTheme.control-primary-rest)
        : root.danger
            ? (button-touch.has-hover
                ? (GitHubTheme.danger-emphasis)
                : (GitHubTheme.border-default))
        : (GitHubTheme.border-default);
    background: root.primary
        ? (button-touch.pressed
            ? (GitHubTheme.control-primary-active)
            : (button-touch.has-hover
                ? (GitHubTheme.control-primary-hover)
                : (GitHubTheme.control-primary-rest)))
        : root.danger
            ? (button-touch.pressed
                ? (GitHubTheme.control-danger-active)
                : (button-touch.has-hover
                    ? (GitHubTheme.danger-emphasis)
                    : (GitHubTheme.control-default-rest)))
            : root.selected
                ? (button-touch.has-hover
                    ? GitHubTheme.control-default-hover
                    : GitHubTheme.control-default-active)
            : (button-touch.pressed
                ? (GitHubTheme.control-default-active)
                : (button-touch.has-hover
                    ? (GitHubTheme.control-default-hover)
                    : (GitHubTheme.control-default-rest)));
    opacity: root.disabled ? 0.5 : 1;
    clip: false;
    accessible-role: button;
    accessible-enabled: !root.disabled && !root.busy;
    accessible-label: root.text;
    accessible-checkable: root.selected;
    accessible-checked: root.selected;

    button-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (!root.disabled && !root.busy
                    && (event.text == Key.Return || event.text == " ")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    if button-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }

    if root.busy: GitHubSpinner {
        x: root.pad-x;
        y: (parent.height - self.height) / 2;
        spinner-size: GitHubMetrics.icon-medium;
        foreground: root.primary || (root.danger && button-touch.has-hover)
            ? GitHubTheme.fg-on-emphasis
            : root.danger
                ? (GitHubTheme.danger-fg)
                : (GitHubTheme.fg-default);
    }

    if root.has-leading-icon && !root.busy: Image {
        x: root.pad-x;
        y: (parent.height - self.height) / 2;
        width: GitHubMetrics.icon-medium;
        height: GitHubMetrics.icon-medium;
        source: root.leading-icon;
        image-fit: contain;
        colorize: root.primary || (root.danger && button-touch.has-hover)
            ? GitHubTheme.fg-on-emphasis
            : root.danger
                ? GitHubTheme.danger-fg
                : GitHubTheme.fg-default;
    }

    Text {
        x: root.busy || root.has-leading-icon
            ? root.pad-x + root.spinner-slot
            : root.pad-x;
        width: parent.width - self.x - root.pad-x;
        height: parent.height;
        text: root.text;
        font-size: root.label-font-size;
        font-weight: 600;
        color: root.primary || (root.danger && button-touch.has-hover)
            ? GitHubTheme.fg-on-emphasis
            : root.danger
                ? (GitHubTheme.danger-fg)
                : (GitHubTheme.fg-default);
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    button-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.disabled && !root.busy;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            button-focus.focus();
            root.clicked();
        }
    }
}

export component GitHubToggle inherits Rectangle {
    // Host state is authoritative so external actions such as "Disable all"
    // cannot leave the switch's visual state behind.
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    private property <bool> keyboard-focus-visible: false;
    callback toggled(bool);

    private property <bool> interactive: root.enabled && !root.loading;

    width: 48px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.checked
        ? (GitHubTheme.control-primary-rest)
        : (GitHubTheme.border-strong);
    background: root.checked
        ? (GitHubTheme.control-primary-rest)
        : GitHubTheme.control-input-bg;
    opacity: root.enabled ? 1 : 0.5;
    clip: false;
    accessible-role: switch;
    accessible-enabled: root.interactive;
    accessible-checkable: true;
    accessible-checked: root.checked;

    toggle-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (root.interactive && (event.text == Key.Return || event.text == " ")) {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    if toggle-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-full;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }

    Text {
        x: root.checked ? 5px : 21px;
        width: 20px;
        height: parent.height;
        text: root.checked ? I18n.common-on : I18n.common-off;
        font-size: 9px;
        font-weight: 600;
        color: root.checked ? GitHubTheme.fg-on-emphasis : (GitHubTheme.fg-muted);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !root.loading: Rectangle {
        x: root.checked ? 27px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? GitHubTheme.fg-on-emphasis : (GitHubTheme.fg-muted);
        animate x { duration: 120ms; easing: ease-out; }
    }

    if root.loading: GitHubSpinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        spinner-size: GitHubMetrics.icon-medium;
        foreground: root.checked
            ? GitHubTheme.fg-on-emphasis
            : GitHubTheme.fg-muted;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.interactive;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            toggle-focus.focus();
            root.toggled(!root.checked);
        }
    }
}

export component GitHubTextField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> caption: "";
    in property <bool> secret: false;
    in property <bool> reveal: false;
    in property <bool> enabled: true;
    in property <bool> required: false;
    in property <bool> loading: false;
    in property <bool> validation-error: false;
    in property <string> validation-message: "";
    callback edited(string);

    // Secret fields stay on Primer medium 14px body text when revealed.
    // Slint's password mask is the large U+25CF ● glyph (not the browser
    // U+2022 • used by github.com), so shrink + letter-space only while
    // masked so the dots match GitHub password/token field density.
    private property <bool> masking: root.secret && !root.reveal;

    width: 100%;
    private property <string> supporting-text:
        root.validation-message != "" ? root.validation-message : root.caption;

    height: root.supporting-text == "" ? 58px : 78px;
    background: transparent;
    opacity: root.enabled ? 1 : 0.6;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 20px;
        text: root.required ? root.label + " *" : root.label;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    field := Rectangle {
        x: 0px;
        y: 26px;
        width: parent.width;
        height: 32px;
        border-radius: 6px;
        border-width: field-input.has-focus ? 2px : 1px;
        border-color: root.validation-error
            ? GitHubTheme.danger-emphasis
            : (field-input.has-focus
                ? GitHubTheme.accent-fg
                : GitHubTheme.border-default);
        background: GitHubTheme.canvas-default;
        clip: true;

        field-input := TextInput {
            x: field-input.has-focus ? 11px : 12px;
            y: (parent.height - self.preferred-height) / 2;
            width: parent.width
                - (field-input.has-focus ? 22px : 24px)
                - (root.loading ? 24px : 0px);
            text <=> root.text;
            enabled: root.enabled && !root.loading;
            input-type: root.masking ? InputType.password : InputType.text;
            single-line: true;
            font-size: root.masking ? 10px : 14px;
            letter-spacing: root.masking ? 1.5px : 0px;
            color: GitHubTheme.fg-default;
            selection-background-color: GitHubTheme.selection-bg;
            selection-foreground-color: self.color;
            accessible-role: text-input;
            accessible-enabled: self.enabled;
            accessible-label: root.label;
            accessible-value <=> self.text;
            edited => { root.edited(self.text); }
        }

        if root.text == "" && !field-input.has-focus: Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.placeholder;
            font-size: 14px;
            color: GitHubTheme.fg-muted;
            vertical-alignment: center;
            overflow: elide;
        }

    }

    // Keep the transformed spinner outside the clipped TextInput subtree.
    // FemtoVG otherwise redraws the clipped text with subtly changing grayscale
    // antialiasing on non-Retina 60 Hz displays as the sibling image rotates.
    if root.loading: GitHubSpinner {
        x: field.x + field.width - 24px;
        y: field.y + 8px;
        spinner-size: GitHubMetrics.icon-medium;
    }

    if root.supporting-text != "": Text {
        x: 0px;
        y: 62px;
        width: parent.width;
        height: 16px;
        text: root.supporting-text;
        font-size: 12px;
        color: root.validation-error
            ? GitHubTheme.danger-fg
            : GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component GitHubSegment inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    private property <bool> keyboard-focus-visible: false;
    callback clicked();

    label-measure := Text {
        visible: false;
        text: root.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        wrap: no-wrap;
    }

    width: max(72px, label-measure.preferred-width + 24px);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected
        ? (GitHubTheme.border-strong)
        : (GitHubTheme.border-default);
    background: root.selected
        ? (GitHubTheme.control-default-active)
        : (segment-touch.has-hover
            ? (GitHubTheme.control-default-hover)
            : (GitHubTheme.control-default-rest));
    clip: false;
    accessible-role: tab;
    accessible-enabled: true;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;

    segment-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    if segment-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        color: GitHubTheme.fg-default;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    segment-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            segment-focus.focus();
            root.clicked();
        }
    }
}
