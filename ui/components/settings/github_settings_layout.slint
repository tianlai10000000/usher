import { AppState } from "../../state/app_state.slint";
import { UpdateLogic } from "../update/update.slint";
import { GitHubPageView } from "../page/page_view.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import {
    GitHubButton,
    GitHubSegment,
    GitHubSettingsNavItem,
    GitHubTextField,
    GitHubToggle
} from "./github_settings_controls.slint";

export component GitHubSettingsSectionMenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> open: false;
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    width: 100%;
    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: menu-touch.has-hover
        ? GitHubTheme.control-default-hover
        : GitHubTheme.control-default-rest;

    menu-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    Text {
        x: 12px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 28px;
        y: 12px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
        colorize: GitHubTheme.fg-muted;
        transform-rotation: root.open ? 180deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    menu-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            menu-focus.focus();
            root.clicked();
        }
    }

    if menu-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        border-width: 2px;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

export component GitHubSettingsSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description: "";

    width: 100%;
    height: root.description == "" ? 45px : 65px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 26px;
        text: root.title;
        font-size: 20px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    if root.description != "": Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: 20px;
        text: root.description;
        font-size: 14px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }
}

export component GitHubSettingToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 100%;
    height: 64px;
    background: transparent;

    Text {
        x: 0px;
        y: 10px;
        width: parent.width - 72px;
        height: 20px;
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 0px;
        y: 32px;
        width: parent.width - 72px;
        height: 18px;
        text: root.description;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    GitHubToggle {
        x: parent.width - self.width;
        y: 20px;
        checked <=> root.checked;
        enabled: root.enabled;
        toggled(value) => { root.toggled(value); }
    }
}

export component GitHubProviderNavigation inherits Rectangle {
    in property <int> selected: 0;
    callback changed(int);

    width: 100%;
    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        GitHubSegment {
            text: "Gitee";
            selected: root.selected == 0;
            clicked => { root.changed(0); }
        }
        GitHubSegment {
            text: "GitHub";
            selected: root.selected == 1;
            clicked => { root.changed(1); }
        }
        GitHubSegment {
            text: "GitLab";
            selected: root.selected == 2;
            clicked => { root.changed(2); }
        }
    }
}

export component GitHubSettingsPane inherits Rectangle {
    in property <int> selected-section: 0;
    in-out property <bool> simulate-crash-active: false;
    in-out property <bool> reveal-git-tokens: false;
    in-out property <bool> git-tokens-saved: false;
    in-out property <bool> git-hosting-config-saved: false;
    in-out property <bool> reveal-ai-agent-api-key: false;
    in-out property <bool> ai-agent-saved: false;
    in-out property <bool> ai-agent-testing: false;
    in-out property <int> ai-agent-provider-index: -1;
    in-out property <int> hosting-config-tab: 0;
    callback check-update();
    callback simulate-crash();

    height: pane-content.preferred-height;
    background: transparent;

    pane-content := VerticalLayout {
        width: root.width;
        spacing: 24px;
        alignment: start;

        if root.selected-section == 0: VerticalLayout {
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "General";
                description: "Manage appearance and update preferences.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Appearance";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Choose how Usher looks. Auto follows your system appearance.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: "Light";
                        selected: AppState.theme-mode == 0;
                        clicked => { AppState.toggle-theme(0); }
                    }
                    GitHubSegment {
                        text: "Dark";
                        selected: AppState.theme-mode == 1;
                        clicked => { AppState.toggle-theme(1); }
                    }
                    GitHubSegment {
                        text: "Auto";
                        selected: AppState.theme-mode == 2;
                        clicked => { AppState.toggle-theme(2); }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Sound";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                GitHubSettingToggleRow {
                    title: "UI sound effects";
                    description: "Play a system click when using the page Back button.";
                    checked: AppState.ui-sound-effects;
                    toggled(value) => {
                        AppState.ui-sound-effects = value;
                        AppState.toggle-ui-sound-effects(value);
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Updates";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                Rectangle {
                    width: parent.width;
                    height: 48px;
                    background: transparent;

                    Text {
                        x: 0px;
                        width: parent.width - 180px;
                        height: parent.height;
                        text: "Current version  v" + AppState.version;
                        font-size: 14px;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    GitHubButton {
                        x: parent.width - self.width;
                        y: 8px;
                        text: UpdateLogic.checking-update ? "Checking…" : "Check for updates";
                        busy: UpdateLogic.checking-update;
                        clicked => {
                            UpdateLogic.checking-update = true;
                            root.check-update();
                        }
                    }
                }

                GitHubSettingToggleRow {
                    title: "Automatic updates";
                    description: "Download and install new versions automatically.";
                    checked: AppState.auto-update;
                    toggled(value) => {
                        AppState.auto-update = value;
                        AppState.toggle-auto-update(value);
                    }
                }
            }
        }

        if root.selected-section == 1: VerticalLayout {
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "Code hosting";
                description: "Configure credentials and enterprise API endpoints.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Personal access tokens";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Tokens are stored locally and used for pull request summaries and workflows.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubTextField {
                    label: "GitHub token";
                    text <=> AppState.git-github-token;
                    placeholder: "ghp_xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "GitLab token";
                    text <=> AppState.git-gitlab-token;
                    placeholder: "glpat-xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "Gitee public token";
                    text <=> AppState.git-gitee-token;
                    placeholder: "token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "Gitee Enterprise token";
                    text <=> AppState.git-gitee-enterprise-token;
                    placeholder: "private-token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked <=> root.reveal-git-tokens;
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 220px;
                        height: parent.height;
                        text: root.reveal-git-tokens ? "Tokens are visible" : "Show tokens";
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.git-tokens-saved ? "Saved" : "Save tokens";
                        primary: true;
                        clicked => {
                            AppState.save-git-tokens(
                                AppState.git-github-token,
                                AppState.git-gitlab-token,
                                AppState.git-gitee-token,
                                AppState.git-gitee-enterprise-token
                            );
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Enterprise API configuration";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Enter a service host or a complete REST API root. Provider version paths are added when omitted.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubProviderNavigation {
                    selected: root.hosting-config-tab;
                    changed(value) => {
                        root.hosting-config-tab = value;
                        root.git-hosting-config-saved = false;
                    }
                }

                if root.hosting-config-tab == 0: VerticalLayout {
                    width: parent.width;
                    spacing: 12px;
                    GitHubTextField {
                        label: "Gitee API base URL";
                        text <=> AppState.git-gitee-api-base-url;
                        placeholder: "https://code.example.com/api/v8";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                    GitHubTextField {
                        label: "Gitee Enterprise";
                        text <=> AppState.git-gitee-enterprise;
                        placeholder: "enterprise-name";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                }
                if root.hosting-config-tab == 1: VerticalLayout {
                    width: parent.width;
                    spacing: 12px;
                    GitHubTextField {
                        label: "GitHub API base URL";
                        text <=> AppState.git-github-api-base-url;
                        placeholder: "https://github.example.com/api/v3";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                    GitHubTextField {
                        label: "GitHub Enterprise";
                        text <=> AppState.git-github-enterprise;
                        placeholder: "enterprise-name";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                }
                if root.hosting-config-tab == 2: VerticalLayout {
                    width: parent.width;
                    spacing: 12px;
                    GitHubTextField {
                        label: "GitLab API base URL";
                        text <=> AppState.git-gitlab-api-base-url;
                        placeholder: "https://gitlab.example.com/api/v4";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                    GitHubTextField {
                        label: "GitLab Enterprise";
                        text <=> AppState.git-gitlab-enterprise;
                        placeholder: "enterprise-name";
                        edited(_) => { root.git-hosting-config-saved = false; }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.git-hosting-config-saved ? "Saved" : "Save API configuration";
                        primary: true;
                        clicked => {
                            AppState.save-git-hosting-config(
                                AppState.git-github-api-base-url,
                                AppState.git-github-enterprise,
                                AppState.git-gitlab-api-base-url,
                                AppState.git-gitlab-enterprise,
                                AppState.git-gitee-api-base-url,
                                AppState.git-gitee-enterprise
                            );
                        }
                    }
                }
            }
        }

        if root.selected-section == 2: VerticalLayout {
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "AI Agent";
                description: "Connect an OpenAI-compatible provider for workflow assistance.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Provider";
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: "Custom";
                        selected: AppState.ai-agent-provider == "custom";
                        clicked => {
                            root.ai-agent-provider-index = 0;
                            AppState.ai-agent-provider = "custom";
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "DeepSeek";
                        selected: AppState.ai-agent-provider == "deepseek";
                        clicked => {
                            root.ai-agent-provider-index = 1;
                            AppState.ai-agent-provider = "deepseek";
                            AppState.ai-agent-base-url = "https://api.deepseek.com";
                            AppState.ai-agent-model = "deepseek-v4-flash";
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "OpenAI";
                        selected: AppState.ai-agent-provider == "openai";
                        clicked => {
                            root.ai-agent-provider-index = 2;
                            AppState.ai-agent-provider = "openai";
                            AppState.ai-agent-base-url = "https://api.openai.com/v1";
                            AppState.ai-agent-model = "gpt-4o-mini";
                            root.ai-agent-saved = false;
                        }
                    }
                }

                GitHubTextField {
                    label: "Base URL";
                    text <=> AppState.ai-agent-base-url;
                    placeholder: "https://api.example.com/v1";
                    caption: "The provider's OpenAI-compatible API root.";
                    edited(_) => {
                        AppState.ai-agent-provider = "custom";
                        root.ai-agent-provider-index = 0;
                        root.ai-agent-saved = false;
                    }
                }
                GitHubTextField {
                    label: "API key";
                    text <=> AppState.ai-agent-api-key;
                    placeholder: "sk-...";
                    secret: true;
                    reveal: root.reveal-ai-agent-api-key;
                    edited(_) => { root.ai-agent-saved = false; }
                }
                GitHubTextField {
                    label: "Model";
                    text <=> AppState.ai-agent-model;
                    placeholder: "Model name";
                    caption: "For example: deepseek-v4-flash or gpt-4o-mini.";
                    edited(_) => {
                        AppState.ai-agent-provider = "custom";
                        root.ai-agent-provider-index = 0;
                        root.ai-agent-saved = false;
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked <=> root.reveal-ai-agent-api-key;
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 330px;
                        height: parent.height;
                        text: root.reveal-ai-agent-api-key ? "API key is visible" : "Show API key";
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    save-agent := GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.ai-agent-saved ? "Saved" : "Save";
                        primary: true;
                        clicked => {
                            AppState.save-ai-agent-settings(
                                AppState.ai-agent-provider,
                                AppState.ai-agent-base-url,
                                AppState.ai-agent-api-key,
                                AppState.ai-agent-model
                            );
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.ai-agent-testing ? "Testing…" : "Test connection";
                        busy: root.ai-agent-testing;
                        clicked => {
                            if (!root.ai-agent-testing) {
                                root.ai-agent-testing = true;
                                AppState.test-ai-agent-connection(
                                    AppState.ai-agent-base-url,
                                    AppState.ai-agent-api-key,
                                    AppState.ai-agent-model
                                );
                            }
                        }
                    }
                }
            }
        }

        if root.selected-section == 3: VerticalLayout {
            width: parent.width;
            spacing: 8px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "Diagnostics";
                description: "Control local diagnostic output and failure testing.";
            }

            GitHubSettingToggleRow {
                title: "Tracing file logs";
                description: "Write detailed application traces to the local log directory.";
                checked: AppState.tracing-logger-active;
                toggled(value) => {
                    AppState.tracing-logger-active = value;
                    AppState.toggle-tracing-logger-active(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: "Terminal verbose logs";
                description: "Include verbose terminal session diagnostics in local logs.";
                checked: AppState.terminal-verbose-logging;
                toggled(value) => {
                    AppState.terminal-verbose-logging = value;
                    AppState.toggle-terminal-verbose-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            Rectangle {
                width: parent.width;
                height: 84px;
                border-radius: 6px;
                border-width: 1px;
                border-color: GitHubTheme.danger-fg;
                background: GitHubTheme.canvas-overlay;

                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 104px;
                    height: 20px;
                    text: "Simulate a crash";
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }
                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 104px;
                    height: 34px;
                    text: "Verify crash reporting. This immediately terminates the application.";
                    font-size: 12px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
                GitHubToggle {
                    x: parent.width - self.width - 16px;
                    y: 30px;
                    checked: root.simulate-crash-active;
                    toggled(value) => {
                        if (value) {
                            root.simulate-crash();
                        }
                    }
                }
            }
        }
    }
}
