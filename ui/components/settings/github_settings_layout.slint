import { AppState } from "../../state/app_state.slint";
import { GitHubPageView } from "../page/page_view.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import {
    GitHubButton,
    GitHubSegment,
    GitHubSettingsNavItem,
    GitHubTextField,
    GitHubToggle
} from "./github_settings_controls.slint";
import { GitHubAiReviewSettingsSection, AiReviewRuleItem } from "@ai-review-settings";

export component GitHubSettingsSectionMenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> open: false;
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    width: 100%;
    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: menu-touch.has-hover
        ? GitHubTheme.control-default-hover
        : GitHubTheme.control-default-rest;

    menu-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    Text {
        x: 12px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 28px;
        y: 12px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
        colorize: GitHubTheme.fg-muted;
        transform-rotation: root.open ? 180deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    menu-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            menu-focus.focus();
            root.clicked();
        }
    }

    if menu-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 8px;
        border-width: 2px;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

export component GitHubSettingsSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description: "";

    width: 100%;
    height: root.description == "" ? 45px : 65px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 26px;
        text: root.title;
        font-size: 20px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    if root.description != "": Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: 20px;
        text: root.description;
        font-size: 14px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }
}

export component GitHubSettingToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 100%;
    height: 64px;
    background: transparent;

    Text {
        x: 0px;
        y: 10px;
        width: parent.width - 72px;
        height: 20px;
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 0px;
        y: 32px;
        width: parent.width - 72px;
        height: 18px;
        text: root.description;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    GitHubToggle {
        x: parent.width - self.width;
        y: 20px;
        checked: root.checked;
        enabled: root.enabled;
        toggled(value) => { root.toggled(value); }
    }
}

export component GitHubProviderNavigation inherits Rectangle {
    in property <int> selected: 0;
    callback changed(int);

    width: 100%;
    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        GitHubSegment {
            text: "Gitee";
            selected: root.selected == 0;
            clicked => { root.changed(0); }
        }
        GitHubSegment {
            text: "GitHub";
            selected: root.selected == 1;
            clicked => { root.changed(1); }
        }
        GitHubSegment {
            text: "GitLab";
            selected: root.selected == 2;
            clicked => { root.changed(2); }
        }
    }
}

export component GitHubSettingsPane inherits Rectangle {
    in property <int> selected-section: 0;
    in-out property <bool> simulate-crash-active: false;
    in-out property <bool> reveal-git-tokens: false;
    in-out property <bool> git-tokens-saved: false;
    in-out property <bool> git-hosting-config-saved: false;
    in-out property <bool> reveal-ai-agent-api-key: false;
    in-out property <bool> ai-agent-saved: false;
    in-out property <bool> ai-agent-testing: false;
    in-out property <int> ai-agent-provider-index: -1;
    in-out property <int> hosting-config-tab: 0;
    in-out property <bool> update-checking: false;
    in property <[AiReviewRuleItem]> ai-review-rules: [];
    in property <int> ai-review-max-concurrent-tasks: 3;
    in-out property <bool> ai-review-rule-add-pending: false;
    in-out property <string> ai-review-rule-name-error: "";
    in-out property <string> ai-review-rule-path-error: "";
    callback ai-review-set-max-concurrent-tasks(int);
    callback ai-review-add-rule(string, string);
    callback ai-review-delete-rule(string);
    callback ai-review-set-default-rule(string);
    callback check-update();
    callback simulate-crash();
    callback open-log-directory();
    callback export-diagnostics();
    private property <bool> any-log-output-enabled:
        AppState.application-console-logging
        || AppState.application-file-logging
        || AppState.tracing-logger-active
        || AppState.terminal-verbose-logging
        || AppState.memory-diagnostics-logging;

    function set-all-log-output(enabled: bool) {
        AppState.application-console-logging = enabled;
        AppState.application-file-logging = enabled;
        AppState.tracing-logger-active = enabled;
        AppState.terminal-verbose-logging = enabled;
        AppState.memory-diagnostics-logging = enabled;
        AppState.toggle-application-console-logging(enabled);
        AppState.toggle-application-file-logging(enabled);
        AppState.toggle-tracing-logger-active(enabled);
        AppState.toggle-terminal-verbose-logging(enabled);
        AppState.toggle-memory-diagnostics-logging(enabled);
    }

    height: pane-content.height;
    background: transparent;
    clip: true;

    pane-content := Rectangle {
        width: root.width;
        height: root.selected-section == 1 ? code-hosting-section.preferred-height
            : (root.selected-section == 2 ? ai-agent-section.preferred-height
                : (root.selected-section == 3 ? ai-review-section.preferred-height
                    : (root.selected-section == 4 ? diagnostics-section.preferred-height
                        : general-section.preferred-height)));
        background: transparent;

        // Fixed leaves avoid stale sibling bindings when the factory page is
        // rebuilt or a section changes under Slint 1.17.1.
        general-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 0;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "General";
                description: "Manage appearance and update preferences.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Appearance";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Choose how Usher looks. Auto follows your system appearance.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: "Light";
                        selected: AppState.theme-mode == 0;
                        clicked => { AppState.toggle-theme(0); }
                    }
                    GitHubSegment {
                        text: "Dark";
                        selected: AppState.theme-mode == 1;
                        clicked => { AppState.toggle-theme(1); }
                    }
                    GitHubSegment {
                        text: "Auto";
                        selected: AppState.theme-mode == 2;
                        clicked => { AppState.toggle-theme(2); }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "File preview";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Choose where artifacts open and which file providers may parse content.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: "Right panel";
                        selected: AppState.artifact-preview-presentation-mode == 0;
                        clicked => {
                            AppState.artifact-preview-presentation-mode = 0;
                            AppState.set-artifact-preview-presentation-mode(0);
                        }
                    }
                    GitHubSegment {
                        text: "Separate window";
                        selected: AppState.artifact-preview-presentation-mode == 1;
                        clicked => {
                            AppState.artifact-preview-presentation-mode = 1;
                            AppState.set-artifact-preview-presentation-mode(1);
                        }
                    }
                }

                GitHubSettingToggleRow {
                    title: "Markdown";
                    description: "Render Markdown documents in the shared preview surface.";
                    checked: AppState.artifact-preview-markdown-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-markdown-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("markdown", value);
                    }
                }
                GitHubSettingToggleRow {
                    title: "Images";
                    description: "Decode supported local image files on demand.";
                    checked: AppState.artifact-preview-image-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-image-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("image", value);
                    }
                }
                GitHubSettingToggleRow {
                    title: "Plain text";
                    description: "Preview UTF-8 text and source files.";
                    checked: AppState.artifact-preview-plain-text-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-plain-text-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("plain-text", value);
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 36px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        width: max(120px, parent.width - 220px);
                        height: parent.height;
                        text: "Release channel";
                        font-size: 14px;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                    GitHubSegment {
                        width: 96px;
                        text: "Stable";
                        selected: AppState.update-channel == "stable";
                        clicked => {
                            AppState.update-channel = "stable";
                            AppState.set-update-channel("stable");
                        }
                    }
                    GitHubSegment {
                        width: 96px;
                        text: "Alpha";
                        selected: AppState.update-channel == "alpha";
                        clicked => {
                            AppState.update-channel = "alpha";
                            AppState.set-update-channel("alpha");
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Sound";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                GitHubSettingToggleRow {
                    title: "UI sound effects";
                    description: "Play a system click when using the page Back button.";
                    checked: AppState.ui-sound-effects;
                    toggled(value) => {
                        AppState.ui-sound-effects = value;
                        AppState.toggle-ui-sound-effects(value);
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Updates";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                Rectangle {
                    width: parent.width;
                    height: 48px;
                    background: transparent;

                    Text {
                        x: 0px;
                        width: parent.width - 200px;
                        height: parent.height;
                        text: "Current version  v" + AppState.version;
                        font-size: 14px;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    GitHubButton {
                        x: parent.width - self.width;
                        y: 8px;
                        text: root.update-checking ? "Checking…" : "Check for updates";
                        busy: root.update-checking;
                        clicked => {
                            // Busy flag is host-owned; Rust dual-writes begin/end
                            // through SettingsPageBridge (operation mode).
                            root.check-update();
                        }
                    }
                }

                GitHubSettingToggleRow {
                    title: "Automatic updates";
                    description: "Download and install new versions automatically.";
                    checked: AppState.auto-update;
                    toggled(value) => {
                        AppState.auto-update = value;
                        AppState.toggle-auto-update(value);
                    }
                }
            }
        }

        code-hosting-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 1;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "Code hosting";
                description: "Configure credentials and enterprise API endpoints.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Personal access tokens";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Tokens are stored locally and used for pull request summaries and workflows.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubTextField {
                    label: "GitHub token";
                    text <=> AppState.git-github-token;
                    placeholder: "ghp_xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "GitLab token";
                    text <=> AppState.git-gitlab-token;
                    placeholder: "glpat-xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "Gitee public token";
                    text <=> AppState.git-gitee-token;
                    placeholder: "token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: "Gitee Enterprise token";
                    text <=> AppState.git-gitee-enterprise-token;
                    placeholder: "private-token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked: root.reveal-git-tokens;
                        toggled(value) => { root.reveal-git-tokens = value; }
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 220px;
                        height: parent.height;
                        text: root.reveal-git-tokens ? "Tokens are visible" : "Show tokens";
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.git-tokens-saved ? "Saved" : "Save tokens";
                        primary: true;
                        clicked => {
                            AppState.save-git-tokens(
                                AppState.git-github-token,
                                AppState.git-gitlab-token,
                                AppState.git-gitee-token,
                                AppState.git-gitee-enterprise-token
                            );
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Enterprise API configuration";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: "Enter a service host or a complete REST API root. Provider version paths are added when omitted.";
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubProviderNavigation {
                    selected: root.hosting-config-tab;
                    changed(value) => {
                        root.hosting-config-tab = value;
                        root.git-hosting-config-saved = false;
                    }
                }

                provider-form-host := Rectangle {
                    width: parent.width;
                    height: max(gitee-provider-form.preferred-height,
                        max(github-provider-form.preferred-height, gitlab-provider-form.preferred-height));
                    background: transparent;
                    clip: true;

                    // Select fixed provider leaves by visibility; rebuilding
                    // conditional field trees can retain the previous labels.
                    gitee-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 0;
                        GitHubTextField {
                            label: "Gitee API base URL";
                            text <=> AppState.git-gitee-api-base-url;
                            placeholder: "https://code.example.com/api/v8";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "Gitee Enterprise";
                            text <=> AppState.git-gitee-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                    github-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 1;
                        GitHubTextField {
                            label: "GitHub API base URL";
                            text <=> AppState.git-github-api-base-url;
                            placeholder: "https://github.example.com/api/v3";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "GitHub Enterprise";
                            text <=> AppState.git-github-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                    gitlab-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 2;
                        GitHubTextField {
                            label: "GitLab API base URL";
                            text <=> AppState.git-gitlab-api-base-url;
                            placeholder: "https://gitlab.example.com/api/v4";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "GitLab Enterprise";
                            text <=> AppState.git-gitlab-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.git-hosting-config-saved ? "Saved" : "Save API configuration";
                        primary: true;
                        clicked => {
                            AppState.save-git-hosting-config(
                                AppState.git-github-api-base-url,
                                AppState.git-github-enterprise,
                                AppState.git-gitlab-api-base-url,
                                AppState.git-gitlab-enterprise,
                                AppState.git-gitee-api-base-url,
                                AppState.git-gitee-enterprise
                            );
                        }
                    }
                }
            }
        }

        ai-agent-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 2;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "AI Agent";
                description: "Connect an OpenAI-compatible provider for workflow assistance.";
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Provider";
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: "Custom";
                        selected: AppState.ai-agent-provider == "custom";
                        clicked => {
                            root.ai-agent-provider-index = 0;
                            AppState.ai-agent-provider = "custom";
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "DeepSeek";
                        selected: AppState.ai-agent-provider == "deepseek";
                        clicked => {
                            root.ai-agent-provider-index = 1;
                            AppState.ai-agent-provider = "deepseek";
                            AppState.ai-agent-base-url = "https://api.deepseek.com";
                            AppState.ai-agent-model = "deepseek-v4-flash";
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "OpenAI";
                        selected: AppState.ai-agent-provider == "openai";
                        clicked => {
                            root.ai-agent-provider-index = 2;
                            AppState.ai-agent-provider = "openai";
                            AppState.ai-agent-base-url = "https://api.openai.com/v1";
                            AppState.ai-agent-model = "gpt-4o-mini";
                            root.ai-agent-saved = false;
                        }
                    }
                }

                GitHubTextField {
                    label: "Base URL";
                    text <=> AppState.ai-agent-base-url;
                    placeholder: "https://api.example.com/v1";
                    caption: "The provider's OpenAI-compatible API root.";
                    edited(_) => {
                        AppState.ai-agent-provider = "custom";
                        root.ai-agent-provider-index = 0;
                        root.ai-agent-saved = false;
                    }
                }
                GitHubTextField {
                    label: "API key";
                    text <=> AppState.ai-agent-api-key;
                    placeholder: "sk-...";
                    secret: true;
                    reveal: root.reveal-ai-agent-api-key;
                    edited(_) => { root.ai-agent-saved = false; }
                }
                GitHubTextField {
                    label: "Model";
                    text <=> AppState.ai-agent-model;
                    placeholder: "Model name";
                    caption: "For example: deepseek-v4-flash or gpt-4o-mini.";
                    edited(_) => {
                        AppState.ai-agent-provider = "custom";
                        root.ai-agent-provider-index = 0;
                        root.ai-agent-saved = false;
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked: root.reveal-ai-agent-api-key;
                        toggled(value) => { root.reveal-ai-agent-api-key = value; }
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 330px;
                        height: parent.height;
                        text: root.reveal-ai-agent-api-key ? "API key is visible" : "Show API key";
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    save-agent := GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.ai-agent-saved ? "Saved" : "Save";
                        primary: true;
                        clicked => {
                            AppState.save-ai-agent-settings(
                                AppState.ai-agent-provider,
                                AppState.ai-agent-base-url,
                                AppState.ai-agent-api-key,
                                AppState.ai-agent-model
                            );
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.ai-agent-testing ? "Testing…" : "Test connection";
                        busy: root.ai-agent-testing;
                        clicked => {
                            // Busy flag is host-owned; Rust dual-writes begin/end.
                            if (!root.ai-agent-testing) {
                                AppState.test-ai-agent-connection(
                                    AppState.ai-agent-base-url,
                                    AppState.ai-agent-api-key,
                                    AppState.ai-agent-model
                                );
                            }
                        }
                    }
                }
            }
        }

        ai-review-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 3;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "AI Review";
                description: "Configure review concurrency and reusable Markdown rule presets.";
            }

            GitHubAiReviewSettingsSection {
                width: parent.width;
                rules: root.ai-review-rules;
                max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                rule-add-pending <=> root.ai-review-rule-add-pending;
                rule-name-error <=> root.ai-review-rule-name-error;
                rule-path-error <=> root.ai-review-rule-path-error;
                set-max-concurrent-tasks(value) => {
                    root.ai-review-set-max-concurrent-tasks(value);
                }
                add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                delete-rule(id) => { root.ai-review-delete-rule(id); }
                set-default-rule(id) => { root.ai-review-set-default-rule(id); }
            }
        }

        diagnostics-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 4;
            width: parent.width;
            spacing: 8px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: "Diagnostics";
                description: "Choose where application logs are written and which detailed diagnostics are included.";
            }

            HorizontalLayout {
                width: parent.width;
                height: 32px;
                alignment: space-between;

                Text {
                    text: "Logging controls";
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }

                GitHubButton {
                    width: 96px;
                    text: root.any-log-output-enabled ? "Disable all" : "Enable all";
                    clicked => { root.set-all-log-output(!root.any-log-output-enabled); }
                }
            }

            Text {
                width: parent.width;
                height: 24px;
                text: "Log destinations";
                font-size: 14px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
                vertical-alignment: center;
            }

            GitHubSettingToggleRow {
                title: "Console output";
                description: "Write application logs to the process standard output.";
                checked: AppState.application-console-logging;
                toggled(value) => {
                    AppState.application-console-logging = value;
                    AppState.toggle-application-console-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: "Application file logs";
                description: "Write plain-text application logs to usher.log.";
                checked: AppState.application-file-logging;
                toggled(value) => {
                    AppState.application-file-logging = value;
                    AppState.toggle-application-file-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: "Structured tracing file";
                description: "Write structured tracing events to usher_tracing.log.";
                checked: AppState.tracing-logger-active;
                toggled(value) => {
                    AppState.tracing-logger-active = value;
                    AppState.toggle-tracing-logger-active(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            Text {
                width: parent.width;
                height: 32px;
                text: "Detailed diagnostics";
                font-size: 14px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
                vertical-alignment: bottom;
            }

            GitHubSettingToggleRow {
                title: "Terminal verbose diagnostics";
                description: "Include input, PTY output, viewport, and render details in enabled outputs.";
                checked: AppState.terminal-verbose-logging;
                toggled(value) => {
                    AppState.terminal-verbose-logging = value;
                    AppState.toggle-terminal-verbose-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: "Memory diagnostics";
                description: "Include periodic process memory and retained UI model measurements.";
                checked: AppState.memory-diagnostics-logging;
                toggled(value) => {
                    AppState.memory-diagnostics-logging = value;
                    AppState.toggle-memory-diagnostics-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            HorizontalLayout {
                width: parent.width;
                height: 32px;
                spacing: 8px;
                alignment: start;

                GitHubButton {
                    text: "Open logs";
                    clicked => { root.open-log-directory(); }
                }
                GitHubButton {
                    text: "Export diagnostics";
                    clicked => { root.export-diagnostics(); }
                }
            }

            Rectangle {
                width: parent.width;
                height: 84px;
                border-radius: 6px;
                border-width: 1px;
                border-color: GitHubTheme.danger-fg;
                background: GitHubTheme.canvas-overlay;

                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 104px;
                    height: 20px;
                    text: "Simulate a crash";
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }
                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 104px;
                    height: 34px;
                    text: "Verify crash reporting. This immediately terminates the application.";
                    font-size: 12px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
                GitHubToggle {
                    x: parent.width - self.width - 16px;
                    y: 30px;
                    checked: root.simulate-crash-active;
                    toggled(value) => {
                        if (value) {
                            root.simulate-crash();
                        }
                    }
                }
            }
        }
    }
}
