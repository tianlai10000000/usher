import { AppState } from "../../state/app_state.slint";
import { I18n } from "@i18n";
import { GitHubPageView } from "../page/page_view.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import {
    GitHubButton,
    GitHubSegment,
    GitHubSettingsNavItem,
    GitHubTextField,
    GitHubToggle
} from "./github_settings_controls.slint";
import {
    ManifestInterfaceLanguagePicker,
    ManifestReplyLanguagePicker
} from "@language-picker";
import { GitHubAiReviewSettingsSection, AiReviewRuleItem } from "@ai-review-settings";

export component GitHubSettingsSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> description: "";

    width: 100%;
    height: root.description == "" ? 45px : 65px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 26px;
        text: root.title;
        font-size: 20px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    if root.description != "": Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: 20px;
        text: root.description;
        font-size: 14px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }
}

export component GitHubSettingToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 100%;
    height: 64px;
    background: transparent;

    Text {
        x: 0px;
        y: 10px;
        width: parent.width - 72px;
        height: 20px;
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 0px;
        y: 32px;
        width: parent.width - 72px;
        height: 18px;
        text: root.description;
        font-size: 12px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    GitHubToggle {
        x: parent.width - self.width;
        y: 20px;
        checked: root.checked;
        enabled: root.enabled;
        toggled(value) => { root.toggled(value); }
    }
}

export component GitHubProviderNavigation inherits Rectangle {
    in property <int> selected: 0;
    callback changed(int);

    width: 100%;
    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        GitHubSegment {
            text: "Gitee";
            selected: root.selected == 0;
            clicked => { root.changed(0); }
        }
        GitHubSegment {
            text: "GitHub";
            selected: root.selected == 1;
            clicked => { root.changed(1); }
        }
        GitHubSegment {
            text: "GitLab";
            selected: root.selected == 2;
            clicked => { root.changed(2); }
        }
    }
}

export component GitHubSettingsPane inherits Rectangle {
    in property <int> selected-section: 0;
    in-out property <bool> simulate-crash-active: false;
    in-out property <bool> reveal-git-tokens: false;
    in-out property <bool> git-tokens-saved: false;
    in-out property <bool> git-hosting-config-saved: false;
    in-out property <bool> reveal-ai-agent-api-key: false;
    in-out property <bool> ai-agent-saved: false;
    in-out property <bool> ai-agent-testing: false;
    in-out property <int> hosting-config-tab: 0;
    in-out property <bool> update-checking: false;
    in property <[AiReviewRuleItem]> ai-review-rules: [];
    in property <int> ai-review-max-concurrent-tasks: 3;
    in-out property <bool> ai-review-rule-add-pending: false;
    in-out property <string> ai-review-rule-name-error: "";
    in-out property <string> ai-review-rule-path-error: "";
    callback ai-review-set-max-concurrent-tasks(int);
    callback ai-review-add-rule(string, string);
    callback ai-review-delete-rule(string);
    callback ai-review-set-default-rule(string);
    callback check-update();
    callback simulate-crash();
    callback open-log-directory();
    callback export-diagnostics();
    private property <bool> any-log-output-enabled:
        AppState.application-console-logging
        || AppState.application-file-logging
        || AppState.tracing-logger-active
        || AppState.terminal-verbose-logging
        || AppState.memory-diagnostics-logging;

    function set-all-log-output(enabled: bool) {
        AppState.application-console-logging = enabled;
        AppState.application-file-logging = enabled;
        AppState.tracing-logger-active = enabled;
        AppState.terminal-verbose-logging = enabled;
        AppState.memory-diagnostics-logging = enabled;
        AppState.toggle-application-console-logging(enabled);
        AppState.toggle-application-file-logging(enabled);
        AppState.toggle-tracing-logger-active(enabled);
        AppState.toggle-terminal-verbose-logging(enabled);
        AppState.toggle-memory-diagnostics-logging(enabled);
    }

    height: pane-content.height;
    background: transparent;
    clip: true;

    pane-content := Rectangle {
        width: root.width;
        height: root.selected-section == 1 ? code-hosting-section.preferred-height
            : (root.selected-section == 2 ? ai-agent-section.preferred-height
                : (root.selected-section == 3 ? ai-review-section.preferred-height
                    : (root.selected-section == 4 ? diagnostics-section.preferred-height
                        : general-section.preferred-height)));
        background: transparent;

        // Fixed leaves avoid stale sibling bindings when the factory page is
        // rebuilt or a section changes under Slint 1.17.1.
        general-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 0;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: I18n.settings-general-title;
                description: I18n.settings-general-description;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: I18n.language-title;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: I18n.language-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
                ManifestInterfaceLanguagePicker {
                    width: parent.width;
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.settings-general-appearance;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: I18n.settings-general-appearance-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: I18n.settings-general-light;
                        selected: AppState.theme-mode == 0;
                        clicked => { AppState.toggle-theme(0); }
                    }
                    GitHubSegment {
                        text: I18n.settings-general-dark;
                        selected: AppState.theme-mode == 1;
                        clicked => { AppState.toggle-theme(1); }
                    }
                    GitHubSegment {
                        text: I18n.common-auto;
                        selected: AppState.theme-mode == 2;
                        clicked => { AppState.toggle-theme(2); }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.settings-general-file-preview;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: I18n.settings-general-file-preview-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: I18n.settings-general-right-panel;
                        selected: AppState.artifact-preview-presentation-mode == 0;
                        clicked => {
                            AppState.artifact-preview-presentation-mode = 0;
                            AppState.set-artifact-preview-presentation-mode(0);
                        }
                    }
                    GitHubSegment {
                        text: I18n.settings-general-separate-window;
                        selected: AppState.artifact-preview-presentation-mode == 1;
                        clicked => {
                            AppState.artifact-preview-presentation-mode = 1;
                            AppState.set-artifact-preview-presentation-mode(1);
                        }
                    }
                }

                GitHubSettingToggleRow {
                    title: I18n.settings-general-markdown;
                    description: I18n.settings-general-markdown-description;
                    checked: AppState.artifact-preview-markdown-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-markdown-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("markdown", value);
                    }
                }
                GitHubSettingToggleRow {
                    title: I18n.settings-general-images;
                    description: I18n.settings-general-images-description;
                    checked: AppState.artifact-preview-image-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-image-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("image", value);
                    }
                }
                GitHubSettingToggleRow {
                    title: I18n.settings-general-plain-text;
                    description: I18n.settings-general-plain-text-description;
                    checked: AppState.artifact-preview-plain-text-enabled;
                    toggled(value) => {
                        AppState.artifact-preview-plain-text-enabled = value;
                        AppState.set-artifact-preview-provider-enabled("plain-text", value);
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 36px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        width: max(120px, parent.width - 220px);
                        height: parent.height;
                        text: I18n.settings-general-release-channel;
                        font-size: 14px;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                    }
                    GitHubSegment {
                        width: 96px;
                        text: I18n.settings-release-stable;
                        selected: AppState.update-channel == "stable";
                        clicked => {
                            AppState.update-channel = "stable";
                            AppState.set-update-channel("stable");
                        }
                    }
                    GitHubSegment {
                        width: 96px;
                        text: I18n.settings-release-alpha;
                        selected: AppState.update-channel == "alpha";
                        clicked => {
                            AppState.update-channel = "alpha";
                            AppState.set-update-channel("alpha");
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: I18n.settings-general-sound;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                GitHubSettingToggleRow {
                    title: I18n.settings-general-ui-sound-effects;
                    description: I18n.settings-general-ui-sound-effects-description;
                    checked: AppState.ui-sound-effects;
                    toggled(value) => {
                        AppState.ui-sound-effects = value;
                        AppState.toggle-ui-sound-effects(value);
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                alignment: start;

                Text {
                    text: I18n.settings-general-updates;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                Rectangle {
                    width: parent.width;
                    height: 48px;
                    background: transparent;

                    Text {
                        x: 0px;
                        width: parent.width - 200px;
                        height: parent.height;
                        text: I18n.settings-general-version-prefix + "  v" + AppState.version;
                        font-size: 14px;
                        color: GitHubTheme.fg-default;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    GitHubButton {
                        x: parent.width - self.width;
                        y: 8px;
                        text: root.update-checking ? I18n.common-checking : I18n.common-check-for-updates;
                        busy: root.update-checking;
                        clicked => {
                            // Busy flag is host-owned; Rust dual-writes begin/end
                            // through SettingsPageBridge (operation mode).
                            root.check-update();
                        }
                    }
                }

                GitHubSettingToggleRow {
                    title: I18n.settings-general-automatic-updates;
                    description: I18n.settings-general-automatic-updates-description;
                    checked: AppState.auto-update;
                    toggled(value) => {
                        AppState.auto-update = value;
                        AppState.toggle-auto-update(value);
                    }
                }
            }
        }

        code-hosting-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 1;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: I18n.settings-code-hosting-title;
                description: I18n.settings-code-hosting-description;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.settings-code-hosting-personal-access-tokens;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: I18n.settings-code-hosting-tokens-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubTextField {
                    label: I18n.settings-code-hosting-github-token;
                    text <=> AppState.git-github-token;
                    placeholder: "ghp_xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: I18n.settings-code-hosting-gitlab-token;
                    text <=> AppState.git-gitlab-token;
                    placeholder: "glpat-xxx";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: I18n.settings-code-hosting-gitee-public-token;
                    text <=> AppState.git-gitee-token;
                    placeholder: "token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }
                GitHubTextField {
                    label: I18n.settings-code-hosting-gitee-enterprise-token;
                    text <=> AppState.git-gitee-enterprise-token;
                    placeholder: "private-token";
                    secret: true;
                    reveal: root.reveal-git-tokens;
                    edited(_) => { root.git-tokens-saved = false; }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked: root.reveal-git-tokens;
                        toggled(value) => { root.reveal-git-tokens = value; }
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 220px;
                        height: parent.height;
                        text: root.reveal-git-tokens
                            ? I18n.settings-code-hosting-tokens-visible
                            : I18n.common-show-tokens;
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.git-tokens-saved
                            ? I18n.common-saved
                            : I18n.settings-code-hosting-save-tokens;
                        primary: true;
                        clicked => {
                            AppState.save-git-tokens(
                                AppState.git-github-token,
                                AppState.git-gitlab-token,
                                AppState.git-gitee-token,
                                AppState.git-gitee-enterprise-token
                            );
                        }
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.settings-code-hosting-enterprise-api;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }
                Text {
                    width: parent.width;
                    text: I18n.settings-code-hosting-enterprise-api-description;
                    font-size: 14px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }

                GitHubProviderNavigation {
                    selected: root.hosting-config-tab;
                    changed(value) => {
                        root.hosting-config-tab = value;
                        root.git-hosting-config-saved = false;
                    }
                }

                provider-form-host := Rectangle {
                    width: parent.width;
                    height: max(gitee-provider-form.preferred-height,
                        max(github-provider-form.preferred-height, gitlab-provider-form.preferred-height));
                    background: transparent;
                    clip: true;

                    // Select fixed provider leaves by visibility; rebuilding
                    // conditional field trees can retain the previous labels.
                    gitee-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 0;
                        GitHubTextField {
                            label: "Gitee " + I18n.settings-code-hosting-api-base-url;
                            text <=> AppState.git-gitee-api-base-url;
                            placeholder: "https://code.example.com/api/v8";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "Gitee " + I18n.settings-code-hosting-enterprise;
                            text <=> AppState.git-gitee-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                    github-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 1;
                        GitHubTextField {
                            label: "GitHub " + I18n.settings-code-hosting-api-base-url;
                            text <=> AppState.git-github-api-base-url;
                            placeholder: "https://github.example.com/api/v3";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "GitHub " + I18n.settings-code-hosting-enterprise;
                            text <=> AppState.git-github-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                    gitlab-provider-form := VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        visible: root.hosting-config-tab == 2;
                        GitHubTextField {
                            label: "GitLab " + I18n.settings-code-hosting-api-base-url;
                            text <=> AppState.git-gitlab-api-base-url;
                            placeholder: "https://gitlab.example.com/api/v4";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                        GitHubTextField {
                            label: "GitLab " + I18n.settings-code-hosting-enterprise;
                            text <=> AppState.git-gitlab-enterprise;
                            placeholder: "enterprise-name";
                            edited(_) => { root.git-hosting-config-saved = false; }
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.git-hosting-config-saved
                            ? I18n.common-saved
                            : I18n.settings-code-hosting-save-api-configuration;
                        primary: true;
                        clicked => {
                            AppState.save-git-hosting-config(
                                AppState.git-github-api-base-url,
                                AppState.git-github-enterprise,
                                AppState.git-gitlab-api-base-url,
                                AppState.git-gitlab-enterprise,
                                AppState.git-gitee-api-base-url,
                                AppState.git-gitee-enterprise
                            );
                        }
                    }
                }
            }
        }

        ai-agent-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 2;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: I18n.settings-ai-agent-title;
                description: I18n.settings-ai-agent-description;
            }

            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;

                Text {
                    text: I18n.settings-ai-agent-provider;
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    spacing: 8px;
                    alignment: start;

                    GitHubSegment {
                        text: I18n.common-custom;
                        selected: AppState.ai-agent-provider == "custom";
                        clicked => {
                            AppState.select-ai-agent-provider("custom");
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "DeepSeek";
                        selected: AppState.ai-agent-provider == "deepseek";
                        clicked => {
                            AppState.select-ai-agent-provider("deepseek");
                            root.ai-agent-saved = false;
                        }
                    }
                    GitHubSegment {
                        text: "OpenAI";
                        selected: AppState.ai-agent-provider == "openai";
                        clicked => {
                            AppState.select-ai-agent-provider("openai");
                            root.ai-agent-saved = false;
                        }
                    }
                }

                GitHubTextField {
                    label: I18n.settings-ai-agent-base-url;
                    text <=> AppState.ai-agent-base-url;
                    placeholder: "https://api.example.com/v1";
                    caption: I18n.settings-ai-agent-provider-api-caption;
                    edited(value) => {
                        AppState.set-ai-agent-base-url(value);
                        root.ai-agent-saved = false;
                    }
                }
                GitHubTextField {
                    label: I18n.settings-ai-agent-api-key;
                    text <=> AppState.ai-agent-api-key;
                    placeholder: "sk-...";
                    secret: true;
                    reveal: root.reveal-ai-agent-api-key;
                    edited(value) => {
                        AppState.set-ai-agent-api-key(value);
                        root.ai-agent-saved = false;
                    }
                }
                GitHubTextField {
                    label: I18n.settings-ai-agent-model;
                    text <=> AppState.ai-agent-model;
                    placeholder: I18n.settings-ai-agent-model-placeholder;
                    caption: I18n.settings-ai-agent-model-caption;
                    edited(value) => {
                        AppState.set-ai-agent-model(value);
                        root.ai-agent-saved = false;
                    }
                }

                VerticalLayout {
                    width: parent.width;
                    spacing: 6px;

                    Text {
                        width: parent.width;
                        text: I18n.settings-ai-agent-reply-language;
                        font-size: 14px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                    }
                    Text {
                        width: parent.width;
                        text: I18n.settings-ai-agent-reply-language-description;
                        font-size: 12px;
                        color: GitHubTheme.fg-muted;
                        wrap: word-wrap;
                    }
                    ManifestReplyLanguagePicker {
                        width: parent.width;
                        changed => {
                            root.ai-agent-saved = false;
                        }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: 40px;
                    background: transparent;

                    GitHubToggle {
                        x: 0px;
                        y: 8px;
                        checked: root.reveal-ai-agent-api-key;
                        toggled(value) => { root.reveal-ai-agent-api-key = value; }
                    }
                    Text {
                        x: 60px;
                        width: parent.width - 330px;
                        height: parent.height;
                        text: root.reveal-ai-agent-api-key
                            ? I18n.settings-ai-agent-api-key-visible
                            : I18n.common-show-api-key;
                        font-size: 13px;
                        color: GitHubTheme.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    save-agent := GitHubButton {
                        x: parent.width - self.width;
                        y: 4px;
                        text: root.ai-agent-saved ? I18n.common-saved : I18n.common-save;
                        primary: true;
                        clicked => {
                            AppState.save-ai-agent-settings(
                                AppState.ai-agent-provider,
                                AppState.ai-agent-base-url,
                                AppState.ai-agent-api-key,
                                AppState.ai-agent-model,
                                AppState.ai-agent-reply-language-selection.id
                            );
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: 32px;
                    alignment: end;
                    GitHubButton {
                        text: root.ai-agent-testing ? I18n.common-testing : I18n.common-test-connection;
                        busy: root.ai-agent-testing;
                        clicked => {
                            // Busy flag is host-owned; Rust dual-writes begin/end.
                            if (!root.ai-agent-testing) {
                                AppState.test-ai-agent-connection(
                                    AppState.ai-agent-base-url,
                                    AppState.ai-agent-api-key,
                                    AppState.ai-agent-model
                                );
                            }
                        }
                    }
                }
            }
        }

        ai-review-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 3;
            width: parent.width;
            spacing: 24px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: I18n.settings-ai-review-title;
                description: I18n.settings-ai-review-description;
            }

            GitHubAiReviewSettingsSection {
                width: parent.width;
                rules: root.ai-review-rules;
                max-concurrent-tasks: root.ai-review-max-concurrent-tasks;
                rule-add-pending <=> root.ai-review-rule-add-pending;
                rule-name-error <=> root.ai-review-rule-name-error;
                rule-path-error <=> root.ai-review-rule-path-error;
                set-max-concurrent-tasks(value) => {
                    root.ai-review-set-max-concurrent-tasks(value);
                }
                add-rule(name, path) => { root.ai-review-add-rule(name, path); }
                delete-rule(id) => { root.ai-review-delete-rule(id); }
                set-default-rule(id) => { root.ai-review-set-default-rule(id); }
            }
        }

        diagnostics-section := VerticalLayout {
            height: parent.height;
            visible: root.selected-section == 4;
            width: parent.width;
            spacing: 8px;
            alignment: start;

            GitHubSettingsSectionHeader {
                title: I18n.settings-diagnostics-title;
                description: I18n.settings-diagnostics-description;
            }

            HorizontalLayout {
                width: parent.width;
                height: 32px;
                alignment: space-between;

                Text {
                    text: I18n.settings-diagnostics-logging-controls;
                    font-size: 16px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }

                GitHubButton {
                    width: 96px;
                    text: root.any-log-output-enabled ? I18n.common-disable-all : I18n.common-enable-all;
                    clicked => { root.set-all-log-output(!root.any-log-output-enabled); }
                }
            }

            Text {
                width: parent.width;
                height: 24px;
                text: I18n.settings-diagnostics-log-destinations;
                font-size: 14px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
                vertical-alignment: center;
            }

            GitHubSettingToggleRow {
                title: I18n.settings-diagnostics-console-output;
                description: I18n.settings-diagnostics-console-description;
                checked: AppState.application-console-logging;
                toggled(value) => {
                    AppState.application-console-logging = value;
                    AppState.toggle-application-console-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: I18n.settings-diagnostics-application-file-logs;
                description: I18n.settings-diagnostics-application-file-description;
                checked: AppState.application-file-logging;
                toggled(value) => {
                    AppState.application-file-logging = value;
                    AppState.toggle-application-file-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: I18n.settings-diagnostics-structured-tracing;
                description: I18n.settings-diagnostics-structured-tracing-description;
                checked: AppState.tracing-logger-active;
                toggled(value) => {
                    AppState.tracing-logger-active = value;
                    AppState.toggle-tracing-logger-active(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            Text {
                width: parent.width;
                height: 32px;
                text: I18n.settings-diagnostics-detailed;
                font-size: 14px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
                vertical-alignment: bottom;
            }

            GitHubSettingToggleRow {
                title: I18n.settings-diagnostics-terminal-verbose;
                description: I18n.settings-diagnostics-terminal-verbose-description;
                checked: AppState.terminal-verbose-logging;
                toggled(value) => {
                    AppState.terminal-verbose-logging = value;
                    AppState.toggle-terminal-verbose-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            GitHubSettingToggleRow {
                title: I18n.settings-diagnostics-memory;
                description: I18n.settings-diagnostics-memory-description;
                checked: AppState.memory-diagnostics-logging;
                toggled(value) => {
                    AppState.memory-diagnostics-logging = value;
                    AppState.toggle-memory-diagnostics-logging(value);
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            HorizontalLayout {
                width: parent.width;
                height: 32px;
                spacing: 8px;
                alignment: start;

                GitHubButton {
                    text: I18n.settings-diagnostics-open-logs;
                    clicked => { root.open-log-directory(); }
                }
                GitHubButton {
                    text: I18n.settings-diagnostics-export;
                    clicked => { root.export-diagnostics(); }
                }
            }

            Rectangle {
                width: parent.width;
                height: 84px;
                border-radius: 6px;
                border-width: 1px;
                border-color: GitHubTheme.danger-fg;
                background: GitHubTheme.canvas-overlay;

                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 104px;
                    height: 20px;
                    text: I18n.settings-diagnostics-simulate-crash;
                    font-size: 14px;
                    font-weight: 600;
                    color: GitHubTheme.fg-default;
                    vertical-alignment: center;
                }
                Text {
                    x: 16px;
                    y: 34px;
                    width: parent.width - 104px;
                    height: 34px;
                    text: I18n.settings-diagnostics-simulate-crash-description;
                    font-size: 12px;
                    color: GitHubTheme.fg-muted;
                    wrap: word-wrap;
                }
                GitHubToggle {
                    x: parent.width - self.width - 16px;
                    y: 30px;
                    checked: root.simulate-crash-active;
                    toggled(value) => {
                        if (value) {
                            root.simulate-crash();
                        }
                    }
                }
            }
        }
    }
}
