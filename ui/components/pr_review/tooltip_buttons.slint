import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubCopyButton } from "../button/github_copy_button.slint";
import { GitHubTooltipPlacement, GitHubTooltipAlignment } from "../../state/tooltip_overlay_state.slint";
import { PrReviewTooltipState } from "tooltip_state.slint";
import { PrConflictsBackTooltipAnchor, PrConflictsToggleFilesTooltipAnchor, PrConflictsRefreshTooltipAnchor, PrConflictsPreviousTooltipAnchor, PrConflictsNextTooltipAnchor, PrCopyFullShaTooltipAnchor, PrCopyFilePathTooltipAnchor, PrCopySourceBranchTooltipAnchor, PrConflictsCopyTooltipAnchor, PrCopiedTooltipAnchor, PrCloseAiReviewTooltipAnchor, PrReviewWithAiTooltipAnchor } from "tooltip_anchors.slint";
import { I18n } from "@i18n";

export component GitHubPrConflictsBackButton inherits GitHubIconButton {
    tooltip-text: I18n.conflicts-back;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrConflictsBackTooltipAnchor {
        active: PrReviewTooltipState.enabled && root.tooltip-active;
        placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom;
        alignment: root.tooltip-align-right ? GitHubTooltipAlignment.End : GitHubTooltipAlignment.Center;
    }
}

export component GitHubPrConflictsFilesButton inherits GitHubIconButton {
    tooltip-text: I18n.conflicts-toggle-files;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrConflictsToggleFilesTooltipAnchor {
        active: PrReviewTooltipState.enabled && root.tooltip-active;
        placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom;
        alignment: root.tooltip-align-right ? GitHubTooltipAlignment.End : GitHubTooltipAlignment.Center;
    }
}

