// Commit-range metadata remains on the dynamic portal; success uses its own fixed leaf.
export component GitHubPrDynamicCopyButton inherits GitHubCopyButton {
    show-tooltip: !PrReviewTooltipState.enabled || !root.copied;
    PrCopiedTooltipAnchor {
        active: PrReviewTooltipState.enabled && root.copied;
        placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom;
        alignment: root.tooltip-align-right ? GitHubTooltipAlignment.End : GitHubTooltipAlignment.Center;
    }
}

export component GitHubPrAiReviewButton inherits GitHubIconButton {
    tooltip-text: root.selected ? I18n.ai-review-close : I18n.pr-list-review-with-ai;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrCloseAiReviewTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active && root.selected; alignment: GitHubTooltipAlignment.End; }
    PrReviewWithAiTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active && !root.selected; alignment: GitHubTooltipAlignment.End; }
}
