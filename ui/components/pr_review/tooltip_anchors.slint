import { GitHubFixedTooltipAnchor } from "../github_fixed_tooltip_anchor.slint";
import { GitHubTooltipPlacement, GitHubTooltipAlignment } from "../../state/tooltip_overlay_state.slint";
import { PrReviewTooltipState, PrReviewTooltipKind } from "tooltip_state.slint";

component PrReviewTooltipAnchor inherits GitHubFixedTooltipAnchor {
    in property <GitHubTooltipPlacement> placement: GitHubTooltipPlacement.Top;
    in property <GitHubTooltipAlignment> alignment: GitHubTooltipAlignment.Center;
    in-out property <int> claim: 0;
    bounded: true;
    viewport: PrReviewTooltipState.viewport;
    release(x, y) => { PrReviewTooltipState.hide(root.claim); }
    renew(x, y, width, height) => { PrReviewTooltipState.renew(root.claim, x, y, width, height); }
}

export component PrShowCommitDescriptionTooltipAnchor inherits PrReviewTooltipAnchor {
    publish(x, y, width, height) => {
        root.claim = PrReviewTooltipState.show(PrReviewTooltipKind.ShowCommitDescription, x, y, width, height, root.placement, root.alignment);
    }
}

export component PrHideCommitDescriptionTooltipAnchor inherits PrReviewTooltipAnchor {
    publish(x, y, width, height) => {
        root.claim = PrReviewTooltipState.show(PrReviewTooltipKind.HideCommitDescription, x, y, width, height, root.placement, root.alignment);
