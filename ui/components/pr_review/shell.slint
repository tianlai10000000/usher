import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubTooltip } from "../github_tooltip.slint";
import { GitHubTooltipAlignment, GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubActionMenu, GitHubActionMenuTriggerArea } from "../github_action_menu.slint";
import { GitHubBlankslate } from "../github_blankslate.slint";
import { GitHubCopyButton } from "../button/github_copy_button.slint";

export struct WorkflowPrDiffFile {
    path: string,
    old-path: string,
    change-type: string,
    added-lines: int,
    removed-lines: int,
    viewed: bool,
    line-count: int,
}

export struct WorkflowPrDiffToken {
    text: string,
    // Unicode character range in the displayed, tab-expanded source line.
    start-char: int,
    end-char: int,
    color: color,
    dark-color: color,
    bold: bool,
    italic: bool,
}

export struct WorkflowPrDiffSelectionHit {
    line: int,
    // Unicode character index into the displayed (tab-expanded) line text.
    column: int,
}

// Document-ordered code-column range from a multi-click (word/line) gesture.
// Columns are Unicode character indices into the displayed (tab-expanded) text.
export struct WorkflowPrDiffSelectionRange {
    start-line: int,
    start-column: int,
    end-line: int,
    end-column: int,
}

// UTF-8 slices retained for wrapped native TextInput selection geometry.
export struct WorkflowPrDiffTextSlice {
    prefix: string,
    text: string,
    prefix-bytes: int,
    text-bytes: int,
}

export struct WorkflowPrDiffGlyphRange {
    // Token-local shaped caret interval in rendered logical pixels.
    x: float,
    width: float,
}

export struct WorkflowPrDiffGlyphRect {
    // One visual-line rectangle from native shaped selection geometry.
    x: float,
    y: float,
    width: float,
    height: float,
}

// One in-diff find hit. `side` is empty for Unified, or `left` / `right` for Split.
// `prefix` / `text` are retained for wrapped native TextInput highlight geometry.
export struct WorkflowPrDiffFindMatch {
    line: int,
    start-column: int,
    end-column: int,
    start-char: int,
    end-char: int,
    side: string,
    prefix: string,
    text: string,
}

export struct WorkflowPrDiffLine {
    old-line: int,
    new-line: int,
    kind: string,
    content: string,
    tokens: [WorkflowPrDiffToken],
    expandable: bool,
    expand-all: bool,
    expand-up: bool,
    expand-down: bool,
    source-index: int,
    left-line: int,
    left-columns: int,
    left-kind: string,
    left-content: string,
    left-tokens: [WorkflowPrDiffToken],
    right-line: int,
    right-columns: int,
    right-kind: string,
    right-content: string,
    right-tokens: [WorkflowPrDiffToken],
}

export struct WorkflowPrDiffRowMetric {
    kind: string,
    columns: int,
    double-hunk: bool,
}

export struct WorkflowPrDiffVirtualRow {
    index: int,
    start: float,
    size: float,
    line: WorkflowPrDiffLine,
}

export struct WorkflowPrDiffVirtualWindow {
    rows: [WorkflowPrDiffVirtualRow],
    scroll-offset: float,
    content-height: float,
}

export struct WorkflowPrTreeItem {
    kind: string,
    name: string,
    path: string,
    depth: int,
    file-index: int,
    expanded: bool,
    added-lines: int,
    removed-lines: int,
    change-type: string,
    file-count: int,
}

export struct WorkflowPrFileExtensionFilter {
    extension: string,
    count: int,
    selected: bool,
}

export struct WorkflowPrConversationItem {
    id: string,
    kind: string,
    author: string,
    avatar: image,
    avatar-label: string,
    author-association: string,
    body: string,
    // Commit rows only: body lines after the title for ellipsis expansion.
    message-body: string,
    message-body-height: int,
    // Independent of other rows; multiple commits may stay expanded.
    message-expanded: bool,
    created-at: string,
    created-at-tooltip: string,
    state: string,
    review-id: string,
    can-dismiss: bool,
    connect-before: bool,
    connect-after: bool,
    // Precomputed ListView row height from Rust so cards can hug short bodies
    // without relying on Slint string length APIs.
    row-height: int,
}

export component GitHubConversationAvatar inherits Rectangle {
    in property <image> avatar;
    in property <string> fallback-label;
    in property <length> avatar-size: 40px;
    in property <length> label-size: 13px;

    width: root.avatar-size;
    height: root.avatar-size;
    border-radius: root.avatar-size / 2;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: root.avatar.width > 0
        ? transparent
        : (GitHubTheme.control-default-rest);
    clip: true;

    if root.avatar.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: root.avatar;
        image-fit: cover;
    }

    if root.avatar.width <= 0: Text {
        width: parent.width;
        height: parent.height;
        text: root.fallback-label;
        font-size: root.label-size;
        font-weight: 600;
        color: GitHubTheme.fg-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component GitHubCommitIdentityAvatars inherits Rectangle {
    in property <length> avatar-size: 20px;
    in property <image> author-avatar;
    in property <string> author-label;
    in property <image> committer-avatar;
    in property <string> committer-label;
    in property <bool> show-committer: false;

    width: root.show-committer ? root.avatar-size + 14px : root.avatar-size;
    height: root.avatar-size;
    background: transparent;

    GitHubConversationAvatar {
        x: 0px;
        avatar-size: root.avatar-size;
        label-size: root.avatar-size <= 20px ? 9px : 10px;
        avatar: root.author-avatar;
        fallback-label: root.author-label;
    }
    if root.show-committer: GitHubConversationAvatar {
        z: 1;
        x: 14px;
        avatar-size: root.avatar-size;
        label-size: root.avatar-size <= 20px ? 9px : 10px;
        avatar: root.committer-avatar;
        fallback-label: root.committer-label;
    }
}

export struct WorkflowPrCommit {
    sha: string,
    short-sha: string,
    title: string,
    message: string,
    message-body: string,
    message-body-height: int,
    // Independent of other rows; multiple commits may stay expanded.
    message-expanded: bool,
    // Sum of expand layout extras for this UTC+08:00 date group (group-start only).
    group-expand-extra: int,
    author: string,
    avatar: image,
    avatar-label: string,
    authored-at: string,
    committer: string,
    committer-avatar: image,
    committer-avatar-label: string,
    committed-at: string,
    show-committer: bool,
    identity-action: string,
    date-label: string,
    short-date-label: string,
    group-start: bool,
    group-end: bool,
    group-size: int,
    verified: bool,
}

export component GitHubReviewActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> success: false;
    in property <bool> danger: false;
    in property <bool> button-enabled: true;
    in property <bool> show-chevron: false;
    in property <bool> titlebar-mode: false;
    // When true, width follows Primer Button medium inline padding (12px×2)
    // plus the label, matching GitHub's content-sized secondary actions.
    in property <bool> hug-content: false;
    // Parents that paint later siblings over this control (PR title under the
    // compact header actions) host the tip themselves. Nested tips still lose.
    in property <bool> embed-tooltip: true;
    // Compact leading-edge headers left-align tips so a long tip cannot flush
    // past the window's left gutter. Trailing-edge strips keep end alignment.
    in property <bool> tooltip-align-start: false;
    in property <string> tooltip-text: "";
    out property <bool> has-hover: action-touch.has-hover;
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    // Primer default Button tokens (not Material surfaces) so header actions
    // like "Create revert PR" match GitHub's secondary btn.
    private property <color> default-fg: GitHubTheme.fg-default;
    private property <color> default-border: GitHubTheme.border-default;
    private property <color> default-bg: GitHubTheme.control-default-rest;
    private property <color> default-bg-hover: GitHubTheme.control-default-hover;

    width: root.hug-content
        ? (label-text.preferred-width + (root.show-chevron ? 40px : 24px))
        : 96px;
    height: 36px;
    background: transparent;

    // Dim only the button surface when disabled. Tooltips stay full-opacity
    // children of this root so they do not inherit the disabled fade.
    button-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.danger
            ? (GitHubTheme.danger-emphasis)
            : (root.success
                ? (GitHubTheme.control-primary-rest)
                : (root.primary ? GitHubTheme.success-emphasis : root.default-border));
        background: root.success
            ? (action-touch.has-hover && root.button-enabled ? (GitHubTheme.control-primary-hover) : (GitHubTheme.control-primary-rest))
            : root.danger
            ? (action-touch.has-hover && root.button-enabled
                ? GitHubTheme.control-danger-selected
                : (GitHubTheme.danger-emphasis))
            : root.primary
            ? (action-touch.has-hover ? GitHubTheme.success-emphasis.darker(8%) : GitHubTheme.success-emphasis)
            : (action-touch.has-hover && root.button-enabled ? root.default-bg-hover : root.default-bg);
        opacity: root.button-enabled ? 1 : 0.5;

        label-text := Text {
            // Keep an unconstrained preferred-width when hugging so the root
            // width binding cannot circularly clamp the measured label.
            // Chevron buttons reserve a real trailing lane instead of centering
            // the label beneath the icon.
            x: root.show-chevron
                ? 12px
                : (root.hug-content ? (parent.width - self.preferred-width) / 2 : 0px);
            width: root.show-chevron
                ? (root.hug-content ? self.preferred-width : parent.width - 40px)
                : (root.hug-content ? self.preferred-width : parent.width);
            height: parent.height;
            text: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 600;
            color: root.primary || root.success || root.danger ? GitHubTheme.fg-on-emphasis : root.default-fg;
        }

        if root.show-chevron: Image {
            x: parent.width - 25px;
            // The Octicon path's visual center sits below its 16px viewBox
            // center, so lift the glyph one logical pixel to align with text.
            y: (parent.height - self.height) / 2 - 1px;
            width: 14px;
            height: 14px;
            source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
            image-fit: contain;
            colorize: GitHubTheme.fg-on-emphasis;
        }
    }

    action-focus := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: button;
        accessible-enabled: root.button-enabled;
        accessible-label: root.text;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if root.button-enabled && (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }

    action-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            action-focus.focus();
            if (root.button-enabled) { root.clicked(); }
        }
    }
    if action-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
    if root.embed-tooltip && root.tooltip-text != "": GitHubTooltip {
        z: 10001;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: root.tooltip-align-start
            ? GitHubTooltipAlignment.Start
            : GitHubTooltipAlignment.End;
        text: action-touch.has-hover ? root.tooltip-text : "";
    }
}

// Primer-like primary green button used by the Conversation comment composer.
export component GitHubCommentButton inherits Rectangle {
    in property <string> text: "Comment";
    in property <bool> button-enabled: true;
    in property <string> tooltip-text: "";
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    width: 96px;
    height: 32px;
    background: transparent;

    button-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        border-width: 1px;
        border-color: GitHubTheme.control-primary-rest;
        background: root.button-enabled
            ? (action-touch.has-hover
                ? (GitHubTheme.control-primary-hover)
                : (GitHubTheme.control-primary-rest))
            : (GitHubTheme.control-primary-disabled);
        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            color: GitHubTheme.fg-on-emphasis;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    comment-focus := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: button;
        accessible-enabled: root.button-enabled;
        accessible-label: root.text;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if root.button-enabled && (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }
    action-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            root.keyboard-focus-visible = false;
            comment-focus.focus();
            if (root.button-enabled) { root.clicked(); }
        }
    }
    if comment-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
    if root.tooltip-text != "": GitHubTooltip {
        preferred-placement: GitHubTooltipPlacement.Top;
        alignment: GitHubTooltipAlignment.End;
        text: action-touch.has-hover ? root.tooltip-text : "";
    }
}

export component GitHubPullRequestStateBadge inherits Rectangle {
    in property <string> kind;
    in property <color> success-color;
    in property <color> danger-color;
    in property <color> done-color;
    private property <string> state-label: root.kind == "merged"
        ? "Merged"
        : (root.kind == "closed" ? "Closed" : "Open");
    private property <color> state-color: root.kind == "merged"
        ? root.done-color
        : (root.kind == "closed" ? root.danger-color : root.success-color);

    width: state-label-text.preferred-width + 40px;
    height: 28px;
    border-radius: 14px;
    background: root.state-color;

    Image {
        x: 10px;
        y: 7px;
        width: 14px;
        height: 14px;
        source: @image-url("../../assets/icons/octicon-git-pull-request-16.svg");
        image-fit: contain;
        colorize: GitHubTheme.fg-on-emphasis;
    }
    state-label-text := Text {
        x: 30px;
        width: self.preferred-width;
        height: parent.height;
        text: root.state-label;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: GitHubTheme.fg-on-emphasis;
    }
}

export component GitHubBranchLabel inherits Rectangle {
    in property <string> text;
    in property <color> background-color;
    in property <color> foreground-color;

    // GitHub keeps the full branch name visible; never elide into "...".
    width: branch-label-text.preferred-width + 16px;
    height: 26px;
    border-radius: 6px;
    background: root.background-color;

    branch-label-text := Text {
        x: 8px;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 13px;
        color: root.foreground-color;
    }
}

// GitHub-style relative timestamp with an absolute datetime Tooltip.
export component GitHubRelativeTimestamp inherits Rectangle {
    in property <string> text;
    in property <string> tooltip-text;
    in property <color> foreground-color;
    in property <length> label-font-size: 13px;
    // Match the surrounding author/meta row; 26px is for header chips.
    in property <length> label-height: 26px;
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    // Semantic preferences only; the root host may flip at viewport edges.
    in property <bool> tooltip-beside: false;
    // Place the tip to the right of the label (into trailing free space).
    in property <bool> tooltip-after: false;
    out property <bool> has-hover: time-touch.has-hover;

    width: max(1px, time-label.preferred-width);
    height: root.label-height;
    background: transparent;
    clip: false;

    time-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.label-font-size;
        color: root.foreground-color;
        vertical-alignment: center;
        overflow: elide;
    }
    time-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: default;
    }
    if root.tooltip-text != "": GitHubTooltip {
        preferred-placement: root.tooltip-after
            ? GitHubTooltipPlacement.Right
            : (root.tooltip-beside
                ? GitHubTooltipPlacement.Left
                : (root.tooltip-above
                    ? GitHubTooltipPlacement.Top
                    : GitHubTooltipPlacement.Bottom));
        alignment: root.tooltip-align-right
            ? GitHubTooltipAlignment.End
            : GitHubTooltipAlignment.Center;
        text: time-touch.has-hover ? root.tooltip-text : "";
    }
}

export component GitHubPullRequestSummaryMetrics inherits Rectangle {
    in property <string> state-kind;
    in property <string> author;
    in property <int> commit-count: 0;
    in property <string> target-branch;
    in property <string> source-branch;
    in property <string> updated-at;
    private property <string> state-label: root.state-kind == "merged"
        ? "Merged"
        : (root.state-kind == "closed" ? "Closed" : "Open");
    out property <length> inline-width:
        state-measure.preferred-width + 40px
        + min(120px, author-measure.preferred-width)
        + summary-measure.preferred-width
        + target-measure.preferred-width + 16px
        + from-measure.preferred-width
        + source-measure.preferred-width + 16px
        + 28px
        + max(0px, updated-measure.preferred-width)
        + 48px;

    visible: false;
    width: 0px;
    height: 0px;

    state-measure := Text {
        text: root.state-label;
        font-size: 12px;
        font-weight: 600;
    }
    author-measure := Text {
        text: root.author;
        font-size: 13px;
        font-weight: 600;
    }
    summary-measure := Text {
        text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
        font-size: 13px;
    }
    target-measure := Text {
        text: root.target-branch;
        font-size: 13px;
    }
    from-measure := Text {
        text: "from";
        font-size: 13px;
    }
    source-measure := Text {
        text: root.source-branch;
        font-size: 13px;
    }
    updated-measure := Text {
        text: root.updated-at;
        font-size: 13px;
    }
}

export component GitHubPullRequestSummaryRow inherits Rectangle {
    in property <string> state-kind;
    in property <string> author;
    in property <int> commit-count: 0;
    in property <string> target-branch;
    in property <string> source-branch;
    in property <string> updated-at;
    in property <string> updated-at-tooltip;
    in property <bool> compact: false;
    in property <color> success-color;
    in property <color> danger-color;
    in property <color> done-color;
    in property <color> muted-color;
    in property <color> muted-background;
    in property <color> branch-background;
    in property <color> branch-foreground;
    // Keep branch names fully visible like GitHub: one row when they fit,
    // otherwise move the branch segment to a second row (never elide).
    out property <bool> wraps: root.width < metrics.inline-width;
    callback copy-source-branch(string) -> bool;

    height: root.wraps ? 64px : 32px;
    // Tooltips must escape this one-line layout; clipping turns the hovered
    // timestamp tooltip into a dark underline.
    clip: false;

    metrics := GitHubPullRequestSummaryMetrics {
        state-kind: root.state-kind;
        author: root.author;
        commit-count: root.commit-count;
        target-branch: root.target-branch;
        source-branch: root.source-branch;
        updated-at: root.updated-at;
    }

    if !root.wraps: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        GitHubPullRequestStateBadge {
            kind: root.state-kind;
            success-color: root.success-color;
            danger-color: root.danger-color;
            done-color: root.done-color;
        }
        Rectangle {
            width: min(root.compact ? 120px : 150px, author-label.preferred-width);
            height: 24px;
            author-label := Text {
                width: parent.width;
                height: parent.height;
                text: root.author;
                font-size: 13px;
                font-weight: 600;
                color: root.muted-color;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                width: parent.width;
                height: 1px;
                background: root.muted-color;
            }
        }
        merge-summary-label := Text {
            width: self.preferred-width;
            height: 26px;
            text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        GitHubBranchLabel {
            text: root.target-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        from-label := Text {
            width: self.preferred-width;
            height: 26px;
            text: "from";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        GitHubBranchLabel {
            text: root.source-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        GitHubCopyButton {
            tooltip-text: "Copy source branch";
            tooltip-above: false;
            tooltip-align-right: true;
            copy-requested => {
                root.copy-source-branch(root.source-branch)
            }
        }
        if root.updated-at != "": GitHubRelativeTimestamp {
            text: root.updated-at;
            tooltip-text: root.updated-at-tooltip;
            tooltip-align-right: true;
            foreground-color: root.muted-color;
            label-font-size: 13px;
        }
    }

    if root.wraps: HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        GitHubPullRequestStateBadge {
            kind: root.state-kind;
            success-color: root.success-color;
            danger-color: root.danger-color;
            done-color: root.done-color;
        }
        Rectangle {
            width: min(root.compact ? 120px : 150px, compact-author-label.preferred-width);
            height: 24px;
            compact-author-label := Text {
                width: parent.width;
                height: parent.height;
                text: root.author;
                font-size: 13px;
                font-weight: 600;
                color: root.muted-color;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                width: parent.width;
                height: 1px;
                background: root.muted-color;
            }
        }
        compact-summary-label := Text {
            width: self.preferred-width;
            height: 26px;
            text: "wants to merge " + root.commit-count + (root.commit-count == 1 ? " commit into" : " commits into");
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
    }

    if root.wraps: HorizontalLayout {
        x: 0px;
        y: 34px;
        width: parent.width;
        height: 28px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        GitHubBranchLabel {
            text: root.target-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        compact-from-label := Text {
            width: self.preferred-width;
            height: 26px;
            text: "from";
            font-size: 13px;
            color: root.muted-color;
            vertical-alignment: center;
        }
        GitHubBranchLabel {
            text: root.source-branch;
            background-color: root.branch-background;
            foreground-color: root.branch-foreground;
        }
        GitHubCopyButton {
            tooltip-text: "Copy source branch";
            tooltip-above: false;
            tooltip-align-right: true;
            copy-requested => {
                root.copy-source-branch(root.source-branch)
            }
        }
        if root.updated-at != "": GitHubRelativeTimestamp {
            text: root.updated-at;
            tooltip-text: root.updated-at-tooltip;
            tooltip-align-right: true;
            foreground-color: root.muted-color;
            label-font-size: 13px;
        }
    }
}

export component GitHubCenteredErrorState inherits Rectangle {
    in property <string> title: "Uh oh!";
    in property <string> detail: "There was an error while loading. Please reload this page.";
    in property <color> background-color;
    in property <color> outline-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    callback retry();

    background: root.background-color;

    GitHubBlankslate {
        x: 24px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 48px;
        icon: @image-url("../../assets/icons/octicon-alert-16.svg");
        heading: root.title;
        description: root.detail;
        primary-label: "Try again";
        error: true;
        narrow: true;
        primary-clicked => { root.retry(); }
    }
}

export component GitHubPullRequestTabButton inherits Rectangle {
    in property <string> label;
    in property <int> count: 0;
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    // Primer UnderlineNav item inside a 48px row: 32px rounded hover control,
    // coral underline on the shared baseline. Spec: docs/specs/ui-design.md
    // “UnderlineNav tabs”.
    width: root.content-width;
    height: 48px;
    background: transparent;
    border-width: 0px;
    clip: false;

    tab-focus := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: tab;
        accessible-enabled: true;
        accessible-label: root.label + ", " + root.count;
        accessible-checkable: true;
        accessible-checked: root.selected;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    private property <length> count-badge-width: max(22px, count-label.preferred-width + 12px);
    private property <length> label-width: label-measure.preferred-width;
    // Primer UnderlineNav item: 8px outer padding and 8px between icon,
    // label, and counter. Reserve the selected label width in every state so
    // changing tabs never shifts neighboring items.
    private property <length> content-width: 8px + 16px + 8px + root.label-width + 8px + root.count-badge-width + 8px;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        wrap: no-wrap;
    }

    if tab-touch.has-hover: Rectangle {
        x: 0px;
        y: 8px;
        width: parent.width;
        height: 32px;
        border-radius: 6px;
        background: GitHubTheme.underline-nav-hover;
    }

    Image {
        x: 8px;
        y: 16px;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
        colorize: GitHubTheme.fg-default;
    }
    tab-label := Text {
        x: 32px;
        y: 8px;
        width: root.label-width;
        height: 32px;
        text: root.label;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }
    Rectangle {
        x: tab-label.x + tab-label.width + 8px;
        y: 14px;
        width: root.count-badge-width;
        height: 20px;
        border-radius: 10px;
        background: GitHubTheme.overlay-handle;
        count-label := Text {
            width: parent.width;
            height: parent.height;
            text: root.count;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 11px;
            font-weight: 600;
            color: GitHubTheme.fg-default;
        }
    }
    if root.selected: Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        border-radius: 1px;
        background: GitHubTheme.underline-nav-selected;
    }
    tab-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            tab-focus.focus();
            root.clicked();
        }
    }
    if tab-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: GitHubMetrics.size-4;
        y: GitHubMetrics.size-6;
        width: parent.width - GitHubMetrics.size-8;
        height: parent.height - GitHubMetrics.size-12;
        border-radius: GitHubMetrics.radius-medium;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

export component GitHubCommitRangeButton inherits Rectangle {
    in property <string> text: "All commits";
    callback clicked();
    private property <bool> keyboard-focus-visible: false;

    width: max(132px, range-label.preferred-width + 66px);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: GitHubTheme.border-default;
    background: range-touch.has-hover
        ? (GitHubTheme.control-default-hover)
        : (GitHubTheme.canvas-subtle);

    range-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    Image {
        x: 12px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-stack-16.svg");
        image-fit: contain;
        colorize: GitHubTheme.fg-muted;
    }
    range-label := Text {
        x: 36px;
        y: 0px;
        width: min(self.preferred-width, parent.width - 62px);
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: 500;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 24px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
        image-fit: contain;
        colorize: GitHubTheme.fg-muted;
    }
    range-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            range-focus.focus();
            root.clicked();
        }
    }
    if range-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

export component GitHubMergeReadinessBadge inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <string> detail;
    in property <bool> titlebar-mode: false;
    // Trailing-edge badges open with ActionMenu `align: end`. Leading-edge
    // compact headers use `align: start` so a wide overlay does not flush the
    // window's left margin.
    in property <bool> popup-align-end: true;
    // Workspace modals disable the badge and close any open detail so the
    // in-window popover cannot outlive the scrim.
    in property <bool> interactions-enabled: true;
    in property <bool> popup-open: false;
    // Title-bar callers mount overlays at the window root. Keeping the badge's
    // local menu disabled there avoids relying on overflow through a 46px
    // title-bar ancestor for rendering and pointer hit-testing.
    in property <bool> render-popup: true;
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    in property <color> background-color;
    in property <color> badge-border-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    in property <color> success-color;
    in property <color> attention-color;
    in property <color> danger-color;
    in property <color> done-color;
    private property <bool> keyboard-focus-visible: false;
    private property <color> state-color: root.kind == "ready"
        ? root.success-color
        : (root.kind == "merged"
            ? root.done-color
            : ((root.kind == "conflicts" || root.kind == "changes_requested" || root.kind == "checks_failed" || root.kind == "closed")
                ? root.danger-color
                : ((root.kind == "review_required" || root.kind == "checks_pending" || root.kind == "branch_out_of_date" || root.kind == "discussions_unresolved" || root.kind == "blocked")
                    ? root.attention-color
                    : root.muted-color)));
    private property <image> state-icon: root.kind == "ready" || root.kind == "merged"
        ? @image-url("../../assets/icons/octicon-check-16.svg")
        : ((root.kind == "conflicts" || root.kind == "changes_requested" || root.kind == "checks_failed" || root.kind == "closed")
            ? @image-url("../../assets/icons/octicon-x-16.svg")
            : ((root.kind == "checking" || root.kind == "unavailable")
                ? @image-url("../../assets/icons/octicon-sync-16.svg")
                : @image-url("../../assets/icons/octicon-alert-16.svg")));

    // Primer Button medium + leadingVisual geometry: 12px inline padding, 16px
    // icon, 8px gap. Do not floor the width — GitHub hugs the label ("Merged").
    width: min(320px, label-text.preferred-width + 48px);
    height: root.titlebar-mode ? 28px : 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.badge-border-color;
    background: badge-touch.has-hover && root.interactions-enabled
        ? (GitHubTheme.control-neutral-hover)
        : root.background-color;

    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.state-color;
        Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: root.state-icon;
            image-fit: contain;
            colorize: GitHubTheme.fg-on-emphasis;
        }
    }
    // Match GitHubReviewActionButton: fill the badge height and center the glyph
    // box. A fixed 20px line plus +1px optical nudge left the label off-midline.
    label-text := Text {
        x: 36px;
        y: 0px;
        width: min(self.preferred-width, parent.width - self.x - 12px);
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-family: "SF Pro Text";
        font-size: 13px;
        font-weight: 600;
        color: root.foreground-color;
        overflow: elide;
    }
    badge-focus := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: button;
        accessible-enabled: root.interactions-enabled;
        accessible-label: root.label + ". " + root.detail;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if root.interactions-enabled && (event.text == Key.Return || event.text == " ") {
                root.toggle-popup();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }
    // Title-bar chrome dismiss may close this menu on the same pointer event;
    // use press-state reconciliation so a second click closes instead of
    // dismiss→toggle-reopen.
    badge-touch := GitHubActionMenuTriggerArea {
        trigger-enabled: root.interactions-enabled;
        menu-open: root.popup-open;
        activated => {
            root.keyboard-focus-visible = false;
            badge-focus.focus();
        }
        request-open => {
            if !root.popup-open {
                root.toggle-popup();
            }
        }
        request-close => {
            if root.popup-open {
                root.toggle-popup();
            }
        }
    }
    if badge-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
    callback toggle-popup();

    // Primer Overlay/ActionMenu metrics: spacer-3 (16px) padding, large radius
    // (12px), max width ~320px.
    popup-measure-title := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.label;
        font-size: 14px;
        font-weight: 600;
    }
    popup-measure-detail := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.detail;
        font-size: 12px;
    }
    private property <length> popup-width: min(
        320px,
        max(
            popup-measure-title.preferred-width + 52px,
            popup-measure-detail.preferred-width + 32px
        )
    );
    popup-measure-detail-wrapped := Text {
        x: 0px;
        y: 0px;
        width: root.popup-width - 32px;
        height: self.preferred-height;
        opacity: 0;
        text: root.detail;
        wrap: word-wrap;
        font-size: 12px;
    }
    private property <length> popup-height: 16px + 28px + 8px + max(20px, popup-measure-detail-wrapped.preferred-height) + 16px;

    readiness-popup := GitHubActionMenu {
        open: root.render-popup && root.popup-open && root.interactions-enabled;
        viewport-x: root.viewport-global-x - root.absolute-position.x;
        viewport-y: root.viewport-global-y - root.absolute-position.y;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        anchor-x: 0px;
        anchor-y: 0px;
        anchor-width: root.width;
        anchor-height: root.height;
        menu-width: root.popup-width;
        content-height: root.popup-height;
        align: root.popup-align-end ? "end" : "start";
        // Dismiss must close, never toggle — a closed menu must stay closed.
        dismiss-requested => {
            if root.popup-open {
                root.toggle-popup();
            }
        }

        Rectangle {
            width: parent.width;
            height: root.popup-height;

            Rectangle {
                x: 16px;
                y: 18px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.state-color;
                Image {
                    x: 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    source: root.state-icon;
                    image-fit: contain;
                    colorize: GitHubTheme.fg-on-emphasis;
                }
            }
            Text {
                x: 44px;
                y: 12px;
                width: parent.width - 60px;
                height: 28px;
                text: root.label;
                vertical-alignment: center;
                font-size: 14px;
                font-weight: 600;
                color: root.foreground-color;
            }
            Text {
                x: 16px;
                y: 48px;
                width: parent.width - 32px;
                height: parent.height - 64px;
                text: root.detail;
                vertical-alignment: top;
                wrap: word-wrap;
                font-size: 12px;
                color: root.muted-color;
            }
        }
    }
}

export component GitHubHeaderActionStrip inherits Rectangle {
    in property <string> readiness-kind;
    in property <string> readiness-label;
    in property <string> readiness-detail;
    in property <string> remote-review-state;
    in property <bool> show-readiness: true;
    // Wide headers pin actions to the trailing edge; narrow headers keep them
    // left-aligned beside the back link like GitHub's compact PR header.
    in property <bool> align-start: false;
    in property <bool> action-loading: false;
    in property <bool> can-comment: false;
    in property <bool> can-approve: false;
    in property <bool> can-request-changes: false;
    in property <bool> can-merge: false;
    in property <bool> can-revert: false;
    in property <bool> titlebar-mode: false;
    // When a workspace modal is open, freeze header actions so popovers and
    // hover tips cannot outlive the scrim.
    in property <bool> actions-enabled: true;
    in property <bool> readiness-popup-open: false;
    in property <bool> render-readiness-popup: true;
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    in property <string> revert-action-label: "Revert pull request";
    in property <string> merge-block-reason;
    in property <color> background-color;
    in property <color> outline-color;
    in property <color> foreground-color;
    in property <color> muted-color;
    in property <color> success-color;
    in property <color> attention-color;
    in property <color> danger-color;
    in property <color> done-color;
    callback review();
    callback merge();
    callback revert();
    callback toggle-readiness-popup();
    callback readiness-anchor-changed(length, length, length, length);

    private property <bool> terminal-state:
        root.readiness-kind == "merged" || root.readiness-kind == "closed";

    height: root.titlebar-mode ? 28px : 36px;
    clip: false;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.titlebar-mode ? 8px : 12px;
        // Wide strips need stretch so the leading spacer pushes all actions
        // against the trailing edge. Compact strips intentionally retain
        // start alignment beside the back link.
        alignment: root.align-start ? start : stretch;
        if !root.align-start: Rectangle { horizontal-stretch: 1; }
        if root.show-readiness && root.readiness-label != "": Rectangle {
            width: readiness-badge.width;
            height: parent.height;
            readiness-badge := GitHubMergeReadinessBadge {
                y: (parent.height - self.height) / 2;
                titlebar-mode: root.titlebar-mode;
                kind: root.readiness-kind;
                label: root.readiness-label;
                detail: root.readiness-detail;
                // Compact (align-start) headers keep the badge near the left
                // gutter; open the overlay start-aligned so it cannot flush the
                // window edge. Wide strips keep ActionMenu end alignment.
                popup-align-end: !root.align-start;
                interactions-enabled: root.actions-enabled;
                popup-open: root.readiness-popup-open;
                render-popup: root.render-readiness-popup;
                viewport-global-x: root.viewport-global-x;
                viewport-global-y: root.viewport-global-y;
                viewport-width: root.viewport-width;
                viewport-height: root.viewport-height;
                background-color: root.background-color;
                badge-border-color: root.outline-color;
                foreground-color: root.foreground-color;
                muted-color: root.muted-color;
                success-color: root.success-color;
                attention-color: root.attention-color;
                danger-color: root.danger-color;
                done-color: root.done-color;
                toggle-popup => { root.toggle-readiness-popup(); }
                changed absolute-position => {
                    root.readiness-anchor-changed(
                        self.absolute-position.x,
                        self.absolute-position.y,
                        self.width,
                        self.height
                    );
                }
                changed width => {
                    root.readiness-anchor-changed(
                        self.absolute-position.x,
                        self.absolute-position.y,
                        self.width,
                        self.height
                    );
                }
                changed height => {
                    root.readiness-anchor-changed(
                        self.absolute-position.x,
                        self.absolute-position.y,
                        self.width,
                        self.height
                    );
                }
            }
        }
        if !root.terminal-state && (root.remote-review-state == "review_approved" || root.remote-review-state == "approved"): Rectangle {
            // Hug the complete status text. The previous compact fixed width
            // clipped "Approved" and forced the icon below its text baseline.
            width: approved-label.preferred-width + 38px;
            height: parent.height;
            Image {
                x: 8px;
                // Match the label's optical center; this check path is weighted
                // slightly below the center of its 16px viewBox.
                y: (parent.height - self.height) / 2 - 1px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-check-16.svg");
                colorize: root.success-color;
            }
            approved-label := Text {
                x: 30px;
                width: self.preferred-width;
                height: parent.height;
                text: "Approved";
                horizontal-alignment: left;
                vertical-alignment: center;
                font-size: 12px;
                font-weight: 600;
                color: root.success-color;
            }
        }
        if !root.terminal-state: Rectangle {
            width: root.titlebar-mode ? 112px : 120px;
            height: parent.height;
            GitHubReviewActionButton {
                y: (parent.height - self.height) / 2;
                height: root.titlebar-mode ? 28px : 36px;
                width: parent.width;
                titlebar-mode: root.titlebar-mode;
                text: "Review changes";
                tooltip-align-start: root.align-start;
                button-enabled: root.actions-enabled && !root.action-loading && (root.can-comment || root.can-approve || root.can-request-changes);
                tooltip-text: root.can-comment || root.can-approve || root.can-request-changes
                    ? "Comment, approve, or request changes"
                    : "Configure provider credentials to submit a review";
                clicked => { root.review(); }
            }
        }
        if !root.terminal-state: Rectangle {
            width: root.titlebar-mode ? 148px : 172px;
            height: parent.height;
            GitHubReviewActionButton {
                y: (parent.height - self.height) / 2;
                height: root.titlebar-mode ? 28px : 36px;
                width: parent.width;
                titlebar-mode: root.titlebar-mode;
                text: root.action-loading ? "Working…" : "Merge pull request";
                success: true;
                show-chevron: true;
                tooltip-align-start: root.align-start;
                button-enabled: root.actions-enabled && !root.action-loading && root.can-merge;
                tooltip-text: root.can-merge ? "Choose a merge method" : root.merge-block-reason;
                clicked => { root.merge(); }
            }
        }
        if root.readiness-kind == "merged" && root.can-revert: Rectangle {
            // Prefer a visible Primer-style secondary button on the same row as
            // the readiness control over GitHub's kebab ActionMenu, so the full
            // provider label stays readable without a truncated overflow item.
            width: revert-action.width;
            height: parent.height;
            revert-action := GitHubReviewActionButton {
                y: (parent.height - self.height) / 2;
                height: root.titlebar-mode ? 28px : 36px;
                titlebar-mode: root.titlebar-mode;
                hug-content: true;
                tooltip-align-start: root.align-start;
                text: root.action-loading ? "Working…" : root.revert-action-label;
                button-enabled: root.actions-enabled && !root.action-loading;
                tooltip-text: "Reverse the changes from this merged pull request";
                clicked => { root.revert(); }
            }
        }
    }
}

export component GitHubReviewChoice inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected: false;
    in property <bool> choice-enabled: true;
    callback chosen();
    private property <bool> keyboard-focus-visible: false;

    height: 58px;
    border-radius: 6px;
    background: choice-touch.has-hover && root.choice-enabled
        ? (GitHubTheme.control-default-rest)
        : transparent;
    opacity: root.choice-enabled ? 1 : 0.48;

    Rectangle {
        x: 12px;
        y: 14px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.selected ? GitHubTheme.accent-emphasis : (GitHubTheme.border-strong);
        background: root.selected ? GitHubTheme.accent-emphasis : transparent;
        if root.selected: Rectangle {
            x: 5px;
            y: 5px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: GitHubTheme.fg-on-emphasis;
        }
    }
    Text {
        x: 40px;
        y: 8px;
        width: parent.width - 52px;
        height: 22px;
        text: root.title;
        font-size: 13px;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }
    Text {
        x: 40px;
        y: 30px;
        width: parent.width - 52px;
        height: 20px;
        text: root.description;
        font-size: 11px;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }
    choice-focus := FocusScope {
        width: 100%;
        height: 100%;
        accessible-role: radio-button;
        accessible-enabled: root.choice-enabled;
        accessible-label: root.title + ". " + root.description;
        accessible-checkable: true;
        accessible-checked: root.selected;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if root.choice-enabled && (event.text == Key.Return || event.text == " ") {
                root.chosen();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => { root.keyboard-focus-visible = false; }
    }
    choice-touch := TouchArea {
        enabled: root.choice-enabled;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            choice-focus.focus();
            root.chosen();
        }
    }
    if choice-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}
