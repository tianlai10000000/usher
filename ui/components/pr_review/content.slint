import { PrReviewTooltipState } from "tooltip_state.slint";
import { PrShowCommitDescriptionTooltipAnchor, PrHideCommitDescriptionTooltipAnchor, PrOpenDiffSettingsTooltipAnchor, PrPreviousFileTooltipAnchor, PrNextFileTooltipAnchor, PrCollapseNonDiffTooltipAnchor, PrExpandAllLinesTooltipAnchor, PrHideFileTreeTooltipAnchor, PrShowFileTreeTooltipAnchor, PrMoreFileActionsTooltipAnchor } from "tooltip_anchors.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { TransientOverlayState } from "../../state/transient_overlay_state.slint";
import { WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrDiffTextSlice, WorkflowPrDiffGlyphRange, WorkflowPrDiffGlyphRect, WorkflowPrDiffFindMatch, WorkflowPrFileExtensionFilter } from "./shell.slint";
import { GitHubTooltip } from "../github_tooltip.slint";
import { GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubActionListItem, GitHubActionMenu } from "../github_action_menu.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubCompactElevation } from "../github_elevation.slint";
import { GitHubSpinner } from "../github_spinner.slint";
import { I18n } from "@i18n";

export component GitHubTreeIndentGuides inherits Rectangle {
    in property <int> depth: 0;
    background: transparent;
    border-width: 0px;
    if root.depth > 0: Rectangle { x: 15px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
    if root.depth > 1: Rectangle { x: 33px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
    if root.depth > 2: Rectangle { x: 51px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
    if root.depth > 3: Rectangle { x: 69px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
    if root.depth > 4: Rectangle { x: 87px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
    if root.depth > 5: Rectangle { x: 105px; width: 1px; height: parent.height; background: GitHubTheme.border-default; }
}

// GitHub Commits kebab: bordered muted pill; accent fill + icon when expanded.
// Clicks must only toggle the message body — never open commit detail.
export component GitHubCommitMessageToggleButton inherits Rectangle {
    in property <bool> expanded: false;
    out property <bool> has-hover: toggle-touch.has-hover;
    private property <bool> tooltip-dismissed: false;
    callback clicked();

    private property <color> accent-fg: GitHubTheme.accent-fg-strong;
    private property <color> accent-bg: GitHubTheme.accent-subtle;
    private property <color> accent-bg-hover: GitHubTheme.accent-subtle-hover;
    private property <color> accent-border: GitHubTheme.accent-muted;
    private property <color> idle-fg: GitHubTheme.fg-muted;
    private property <color> idle-border: GitHubTheme.border-default;
    private property <color> idle-bg: GitHubTheme.control-default-rest;
    private property <color> idle-bg-hover: GitHubTheme.control-muted-hover;

    // Above sibling title/row hit targets in the commit row.
    z: 2;
    width: 26px;
    height: 16px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.expanded ? root.accent-border : root.idle-border;
    // Expanded = Primer accent-muted selected chip (GitHub commits list).
    background: root.expanded
        ? (toggle-touch.has-hover ? root.accent-bg-hover : root.accent-bg)
        : (toggle-touch.has-hover ? root.idle-bg-hover : root.idle-bg);

    Image {
        // 12px Octicon in the 20px chip matches GitHub's compact control.
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        image-fit: contain;
        colorize: root.expanded ? root.accent-fg : root.idle-fg;
    }
    toggle-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        changed has-hover => { if !self.has-hover { root.tooltip-dismissed = false; } }
        clicked => { root.tooltip-dismissed = true; PrReviewTooltipState.dismiss(); root.clicked(); }
    }
    PrShowCommitDescriptionTooltipAnchor { active: PrReviewTooltipState.enabled && toggle-touch.has-hover && !root.expanded && !root.tooltip-dismissed; }
    PrHideCommitDescriptionTooltipAnchor { active: PrReviewTooltipState.enabled && toggle-touch.has-hover && root.expanded && !root.tooltip-dismissed; }
    GitHubTooltip {
        preferred-placement: GitHubTooltipPlacement.Top;
        text: !PrReviewTooltipState.enabled && toggle-touch.has-hover
            ? (root.expanded ? I18n.diff-hide-commit-description : I18n.diff-show-commit-description)
            : "";
    }
}

export component GitHubFileToolbarButton inherits Rectangle {
    in property <image> icon-source;
    in property <bool> button-enabled: true;
    in property <bool> selected: false;
    in property <bool> outlined: false;
    in property <string> tooltip-text;
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    out property <bool> has-hover: icon-button.has-hover;
    out property <bool> tooltip-active: !root.selected && icon-button.tooltip-active;
    in property <bool> show-tooltip: true;
    callback clicked();

    width: 30px;
    height: 46px;
    background: transparent;

    icon-button := GitHubIconButton {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        control-size: 28px;
        glyph-size: 16px;
        icon: root.icon-source;
        tooltip-text: root.selected ? "" : root.tooltip-text;
        show-tooltip: root.show-tooltip;
        tooltip-align-right: root.tooltip-align-right;
        tooltip-above: root.tooltip-above;
        invisible: !root.outlined;
        selected: root.selected;
        button-enabled: root.button-enabled;
        clicked => { root.clicked(); }
    }
}

export component GitHubCommitSummaryNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> icon-after: false;
    in property <bool> button-enabled: true;
    in property <bool> draw-divider: false;
    callback clicked();

    height: 28px;
    background: nav-touch.has-hover && root.button-enabled
        ? GitHubTheme.control-soft-rest
        : transparent;
    opacity: root.button-enabled ? 1 : 0.5;

    if root.draw-divider: Rectangle {
        x: 0px;
        width: 1px;
        height: parent.height;
        background: GitHubTheme.border-default;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 4px;
        alignment: center;
        cross-axis-alignment: center;

        if !root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: GitHubTheme.fg-muted;
        }
        Text {
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: GitHubTheme.fg-default;
            vertical-alignment: center;
        }
        if root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: GitHubTheme.fg-muted;
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if root.button-enabled {
                root.clicked();
            }
        }
    }
}

// Shared by the Files changed tree and the selected-file toolbar so both
// surfaces use the same Primer status Octicon for a given change type.
export component GitHubFileChangeTypeIcon inherits Image {
    in property <string> change-type: "edit_file";
    in property <color> muted-fg;
    in property <color> success-fg;
    in property <color> danger-fg;
    in property <color> attention-fg;

    width: 14px;
    height: 14px;
    source: root.change-type == "new_file"
        ? @image-url("../../assets/icons/octicon-file-added-16.svg")
        : (root.change-type == "deleted_file"
            ? @image-url("../../assets/icons/octicon-file-removed-16.svg")
            : (root.change-type == "renamed_file"
                ? @image-url("../../assets/icons/octicon-file-moved-16.svg")
                : @image-url("../../assets/icons/octicon-file-diff-16.svg")));
    image-fit: contain;
    colorize: root.change-type == "new_file"
        ? root.success-fg
        : (root.change-type == "deleted_file"
            ? root.danger-fg
            : (root.change-type == "renamed_file"
                ? root.attention-fg
                : root.muted-fg));
}

// GitHub-style selectable code cell. Syntax tokens stay as Text; selection is a
// workspace-owned range so drag can cross ListView rows. Gutters and +/- stay
// outside this component, matching GitHub's code-column copy behavior.
export component GitHubSelectableDiffCode inherits Rectangle {
    in property <string> content;
    in property <int> content-columns: content.character-count;
    in property <[WorkflowPrDiffToken]> tokens;
    in property <bool> show-tokens: false;
    in property <bool> wrap-content: false;
    in property <string> code-font-family;
    in property <length> code-font-size;
    in property <length> code-character-width: 7.2px;
    in property <length> nominal-row-height: 28px;
    in property <color> fg-default;
    in property <color> selection-background;
    in property <int> line-index: -1;
    in property <string> side: "";
    in property <bool> multi-sel-active: false;
    in property <string> multi-sel-side: "";
    in property <int> multi-sel-lo-line: -1;
    in property <int> multi-sel-hi-line: -1;
    in property <int> multi-sel-lo-col: 0;
    in property <int> multi-sel-hi-col: 0;
    in property <bool> multi-sel-select-all: false;
    in property <bool> find-active: false;
    in property <int> find-start-col: 0;
    in property <int> find-end-col: 0;
    in property <int> find-start-char: 0;
    in property <int> find-end-char: 0;
    in property <string> find-prefix: "";
    in property <string> find-text: "";
    in property <[WorkflowPrDiffFindMatch]> find-matches: [];
    in property <color> find-match-background;
    in property <color> find-background;
    callback multi-sel-begin(int, int, string);
    callback multi-sel-update(int, int, string);
    callback multi-sel-end();
    callback multi-sel-edge(int);
    // pointer x/y, row height, code width, cell width, wrap/line pitch,
    // font family/size, side
    callback resolve-hit(int, float, float, float, float, float, float, string, float, string) -> WorkflowPrDiffSelectionHit;
    pure callback resolve-token-hit(string, float, float, string, float, bool, bool) -> int;
    pure callback resolve-token-range(string, int, int, float, string, float, bool, bool) -> WorkflowPrDiffGlyphRange;
    pure callback resolve-wrapped-range(string, int, int, float, float, string, float) -> [WorkflowPrDiffGlyphRect];
    pure callback resolve-selection-slice(int, string, int, int) -> WorkflowPrDiffTextSlice;
    pure callback resolve-wrap-line-start(int, string, int, int) -> int;

    private property <bool> in-multi-sel:
        root.multi-sel-active
        && root.multi-sel-side == root.side
        && root.line-index >= root.multi-sel-lo-line
        && root.line-index <= root.multi-sel-hi-line;
    private property <int> content-chars: root.content.character-count;
    private property <int> visible-columns:
        max(1, Math.floor(max(1px, root.width) / root.code-character-width));
    // Wrap math must use display columns (tabs/CJK), matching row-height and
    // unified-wraps — character-count alone under-wraps wide glyphs.
    private property <int> visual-line-count:
        root.wrap-content
            ? max(1, Math.ceil(max(1, root.content-columns) / root.visible-columns))
            : 1;
    private property <bool> highlight-from-start:
        root.line-index > root.multi-sel-lo-line;
    private property <bool> highlight-to-end:
        root.line-index < root.multi-sel-hi-line;
    private property <int> highlight-start-col:
        root.highlight-from-start ? 0 : root.multi-sel-lo-col;
    private property <int> highlight-end-col:
        root.highlight-to-end
            ? max(root.content-chars, root.highlight-start-col + 1)
            : max(root.highlight-start-col, min(root.multi-sel-hi-col, root.content-chars));
    private property <bool> find-visible:
        root.find-active && (root.find-end-col > root.find-start-col || root.find-text != "");
    clip: true;

    // Measure the natural font box once, then use Slint's native line-height
    // control to make paint, exact row extents and selection geometry share the
    // same nominal pitch.
    wrap-line-probe := Text {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        visible: false;
        text: "Ag";
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        font-weight: 400;
        overflow: clip;
        wrap: no-wrap;
    }
    private property <length> natural-line-height:
        max(1px, wrap-line-probe.preferred-height);
    private property <float> wrapped-line-height-factor:
        root.nominal-row-height / root.natural-line-height;
    private property <length> wrap-line-pitch:
        root.wrap-content ? root.nominal-row-height : root.natural-line-height;
    // Selection rectangles only exist for selected, visible ListView rows.
    // Normal scrolling remains token-only and keeps the lazy model bounded.
    if root.in-multi-sel && root.multi-sel-select-all: Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.selection-background;
    }

    if root.wrap-content && root.in-multi-sel && !root.multi-sel-select-all
        && root.highlight-end-col > root.highlight-start-col: wrapped-selection := Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        private property <[WorkflowPrDiffGlyphRect]> glyph-rects:
            root.resolve-wrapped-range(
                root.content,
                root.highlight-start-col,
                root.highlight-end-col,
                root.width / 1px,
                root.wrap-line-pitch / 1px,
                root.code-font-family,
                root.code-font-size / 1px
            );
        for glyph in self.glyph-rects: Rectangle {
            x: glyph.x * 1px;
            y: glyph.y * 1px;
            width: glyph.width * 1px;
            height: glyph.height * 1px;
            background: root.selection-background;
        }
    }

    if root.find-visible && root.wrap-content: active-wrapped-find := Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        private property <[WorkflowPrDiffGlyphRect]> glyph-rects:
            root.resolve-wrapped-range(
                root.content,
                root.find-start-char,
                root.find-end-char,
                root.width / 1px,
                root.wrap-line-pitch / 1px,
                root.code-font-family,
                root.code-font-size / 1px
            );
        for glyph in self.glyph-rects: Rectangle {
            x: glyph.x * 1px;
            y: glyph.y * 1px;
            width: glyph.width * 1px;
            height: glyph.height * 1px;
            background: root.find-background;
        }
    }

    for hit in root.find-matches: inactive-find-highlight := Rectangle {
        private property <bool> is-current:
            root.find-active
            && hit.start-char == root.find-start-char
            && hit.end-char == root.find-end-char;
        private property <[WorkflowPrDiffGlyphRect]> wrapped-glyph-rects:
            root.wrap-content
                ? root.resolve-wrapped-range(
                    root.content,
                    hit.start-char,
                    hit.end-char,
                    root.width / 1px,
                    root.wrap-line-pitch / 1px,
                    root.code-font-family,
                    root.code-font-size / 1px
                )
                : [];

        width: parent.width;
        height: parent.height;
        background: transparent;

        if root.wrap-content: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            for glyph in inactive-find-highlight.wrapped-glyph-rects: Rectangle {
                visible: !inactive-find-highlight.is-current;
                x: glyph.x * 1px;
                y: glyph.y * 1px;
                width: glyph.width * 1px;
                height: glyph.height * 1px;
                background: root.find-match-background;
            }
        }

        if !root.wrap-content: Rectangle {
            visible: !inactive-find-highlight.is-current;
            x: hit.prefix == "" ? 0px : inactive-prefix.preferred-width;
            y: (parent.height - root.nominal-row-height) / 2;
            width: max(
                max(1, hit.end-column - hit.start-column) * root.code-character-width,
                max(root.code-character-width, inactive-match.preferred-width)
            );
            height: root.nominal-row-height;
            background: root.find-match-background;
        }

        inactive-prefix := Text {
            width: 0px;
            height: 0px;
            visible: false;
            text: !root.wrap-content ? hit.prefix : "";
            font-family: root.code-font-family;
            font-size: root.code-font-size;
            font-weight: 400;
            wrap: no-wrap;
        }
        inactive-match := Text {
            width: 0px;
            height: 0px;
            visible: false;
            text: hit.text;
            font-family: root.code-font-family;
            font-size: root.code-font-size;
            font-weight: 400;
            wrap: no-wrap;
        }
    }

    if root.show-tokens: token-row := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        for token in root.tokens: token-cell := Rectangle {
            private property <int> selection-start:
                max(token.start-char, root.highlight-start-col);
            private property <int> selection-end:
                min(token.end-char, root.highlight-end-col);
            private property <bool> selection-visible:
                root.in-multi-sel && !root.multi-sel-select-all
                && self.selection-end > self.selection-start;
            width: token-text.preferred-width;
            height: parent.height;

            if token-cell.selection-visible: token-selection := Rectangle {
                private property <WorkflowPrDiffGlyphRange> glyph-range:
                    root.resolve-token-range(
                        token.text,
                        token-cell.selection-start - token.start-char,
                        token-cell.selection-end - token.start-char,
                        token-cell.width / 1px,
                        root.code-font-family,
                        root.code-font-size / 1px,
                        token.bold,
                        token.italic
                    );
                x: self.glyph-range.x * 1px;
                y: (parent.height - root.nominal-row-height) / 2;
                width: self.glyph-range.width * 1px;
                height: root.nominal-row-height;
                background: root.selection-background;
            }

            if root.find-visible
                && root.find-end-char > token.start-char
                && root.find-start-char < token.end-char: active-find := Rectangle {
                private property <int> start-char: max(token.start-char, root.find-start-char);
                private property <int> end-char: min(token.end-char, root.find-end-char);
                private property <WorkflowPrDiffGlyphRange> glyph-range:
                    root.resolve-token-range(
                        token.text,
                        self.start-char - token.start-char,
                        self.end-char - token.start-char,
                        token-cell.width / 1px,
                        root.code-font-family,
                        root.code-font-size / 1px,
                        token.bold,
                        token.italic
                    );
                x: self.glyph-range.x * 1px;
                y: (parent.height - root.nominal-row-height) / 2;
                width: self.glyph-range.width * 1px;
                height: root.nominal-row-height;
                background: root.find-background;
            }

            token-text := Text {
                width: self.preferred-width;
                height: parent.height;
                text: token.text;
                vertical-alignment: center;
                overflow: clip;
                font-family: root.code-font-family;
                font-size: root.code-font-size;
                font-weight: token.bold ? 600 : 400;
                font-italic: token.italic;
                color: GitHubTheme.dark-mode ? token.dark-color : token.color;
            }
            token-touch := TouchArea {
                mouse-cursor: text;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.multi-sel-begin(
                            root.line-index,
                            token.start-char + root.resolve-token-hit(
                                token.text,
                                max(0px, min(self.mouse-x, token-cell.width)) / 1px,
                                token-cell.width / 1px,
                                root.code-font-family,
                                root.code-font-size / 1px,
                                token.bold,
                                token.italic
                            ),
                            root.side
                        );
                    } else if event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel {
                        root.multi-sel-end();
                    }
                }
                moved => {
                    if !self.pressed { return; }
                    if self.mouse-y >= 0px && self.mouse-y <= token-cell.height
                        && self.mouse-x >= 0px && self.mouse-x <= token-cell.width {
                        root.multi-sel-update(
                            root.line-index,
                            token.start-char + root.resolve-token-hit(
                                token.text,
                                self.mouse-x / 1px,
                                token-cell.width / 1px,
                                root.code-font-family,
                                root.code-font-size / 1px,
                                token.bold,
                                token.italic
                            ),
                            root.side
                        );
                    } else {
                        let hit = root.resolve-hit(
                            root.line-index,
                            (token-cell.x + self.mouse-x) / 1px,
                            self.mouse-y / 1px,
                            root.height / 1px,
                            root.width / 1px,
                            root.code-character-width / 1px,
                            root.nominal-row-height / 1px,
                            root.code-font-family,
                            root.code-font-size / 1px,
                            root.side
                        );
                        root.multi-sel-update(hit.line, hit.column, root.side);
                    }
                    root.multi-sel-edge(
                        self.mouse-y < 0px ? -1 : (self.mouse-y > root.height ? 1 : 0)
                    );
                }
            }
        }
        trailing-hit := Rectangle {
            horizontal-stretch: 1;
            trailing-touch := TouchArea {
                mouse-cursor: text;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.multi-sel-begin(root.line-index, root.content-chars, root.side);
                    } else if event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel {
                        root.multi-sel-end();
                    }
                }
                moved => {
                    if !self.pressed { return; }
                    let hit = root.resolve-hit(
                        root.line-index,
                        (trailing-hit.x + self.mouse-x) / 1px,
                        self.mouse-y / 1px,
                        root.height / 1px,
                        root.width / 1px,
                        root.code-character-width / 1px,
                        root.nominal-row-height / 1px,
                        root.code-font-family,
                        root.code-font-size / 1px,
                        root.side
                    );
                    root.multi-sel-update(hit.line, hit.column, root.side);
                    root.multi-sel-edge(
                        self.mouse-y < 0px ? -1 : (self.mouse-y > root.height ? 1 : 0)
                    );
                }
            }
        }
    }
    // Keep Slint auto-wrap for text painting. Selection uses the shared Parley
    // facade above so adjacent translucent visual-line rectangles never overlap.
    if !root.show-tokens: code-input := TextInput {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.content;
        read-only: true;
        single-line: false;
        text-cursor-width: 0px;
        vertical-alignment: root.wrap-content ? top : center;
        wrap: root.wrap-content ? word-wrap : no-wrap;
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        font-weight: 400;
        line-height-factor: root.wrap-content ? root.wrapped-line-height-factor : 1;
        color: root.fg-default;
        selection-foreground-color: root.fg-default;
        selection-background-color: transparent;
    }

    if !root.show-tokens: TouchArea {
        mouse-cursor: text;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.multi-sel-begin(
                    root.line-index,
                    root.col-at(self.mouse-x, self.mouse-y),
                    root.side
                );
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.multi-sel-end();
            }
        }
        moved => {
            if (!self.pressed) {
                return;
            }
            let hit = root.resolve-hit(
                root.line-index,
                self.mouse-x / 1px,
                self.mouse-y / 1px,
                root.height / 1px,
                root.width / 1px,
                root.code-character-width / 1px,
                root.wrap-content ? root.wrap-line-pitch / 1px : root.nominal-row-height / 1px,
                root.code-font-family,
                root.code-font-size / 1px,
                root.side
            );
            root.multi-sel-update(hit.line, hit.column, root.side);
            root.multi-sel-edge(
                self.mouse-y < 0px ? -1 : (self.mouse-y > root.height ? 1 : 0)
            );
        }
    }

    function col-at(x: length, y: length) -> int {
        // Unified path for wrap and non-wrap so click/drag share soft-wrap
        // (or preferred-width) hit testing from Rust.
        return root.resolve-hit(
            root.line-index,
            max(0px, x) / 1px,
            max(0px, y) / 1px,
            root.height / 1px,
            root.width / 1px,
            root.code-character-width / 1px,
            root.wrap-content ? root.wrap-line-pitch / 1px : root.nominal-row-height / 1px,
            root.code-font-family,
            root.code-font-size / 1px,
            root.side
        ).column;
    }

}

export component GitHubSplitDiffSide inherits Rectangle {
    in property <int> line-number;
    in property <string> kind;
    in property <string> content;
    in property <int> content-columns: content.character-count;
    in property <[WorkflowPrDiffToken]> tokens;
    in property <bool> live-resizing: false;
    in property <bool> wrap-content: false;
    in property <string> code-font-family;
    in property <length> code-font-size;
    in property <length> code-line-height;
    in property <color> bg-default;
    in property <color> fg-default;
    in property <color> fg-muted;
    in property <color> addition-background;
    in property <color> addition-gutter-background;
    in property <color> deletion-background;
    in property <color> deletion-gutter-background;
    in property <color> selection-background;
    in property <length> code-character-width: 7.2px;
    in property <int> line-index: -1;
    in property <string> side: "";
    in property <bool> multi-sel-active: false;
    in property <string> multi-sel-side: "";
    in property <int> multi-sel-lo-line: -1;
    in property <int> multi-sel-hi-line: -1;
    in property <int> multi-sel-lo-col: 0;
    in property <int> multi-sel-hi-col: 0;
    in property <bool> multi-sel-select-all: false;
    in property <bool> find-active: false;
    in property <int> find-start-col: 0;
    in property <int> find-end-col: 0;
    in property <int> find-start-char: 0;
    in property <int> find-end-char: 0;
    in property <string> find-prefix: "";
    in property <string> find-text: "";
    in property <[WorkflowPrDiffFindMatch]> find-matches: [];
    in property <color> find-match-background;
    in property <color> find-background;
    callback multi-sel-begin(int, int, string);
    callback multi-sel-update(int, int, string);
    callback multi-sel-end();
    callback multi-sel-edge(int);
    callback resolve-hit(int, float, float, float, float, float, float, string, float, string) -> WorkflowPrDiffSelectionHit;
    pure callback resolve-token-hit(string, float, float, string, float, bool, bool) -> int;
    pure callback resolve-token-range(string, int, int, float, string, float, bool, bool) -> WorkflowPrDiffGlyphRange;
    pure callback resolve-wrapped-range(string, int, int, float, float, string, float) -> [WorkflowPrDiffGlyphRect];
    pure callback resolve-selection-slice(int, string, int, int) -> WorkflowPrDiffTextSlice;
    pure callback resolve-wrap-line-start(int, string, int, int) -> int;

    background: root.kind == "addition"
        ? root.addition-background
        : (root.kind == "deletion" ? root.deletion-background : root.bg-default);

    // Absolute columns match GitHub's table-cell geometry and prevent a tall
    // wrapped row from cross-axis-centering its line number / change marker.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 50px;
        height: parent.height;
        background: root.kind == "addition"
            ? root.addition-gutter-background
            : (root.kind == "deletion" ? root.deletion-gutter-background : root.bg-default);
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.code-line-height;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.line-number == 0 ? "" : root.line-number;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: root.code-font-family;
                font-size: root.code-font-size;
                font-weight: 400;
                color: root.kind == "addition" || root.kind == "deletion"
                    ? root.fg-default
                    : root.fg-muted;
            }
        }
    }
    Rectangle {
        x: 50px;
        y: 0px;
        width: 20px;
        height: parent.height;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.code-line-height;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.kind == "addition" ? "+" : (root.kind == "deletion" ? "-" : "");
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: root.code-font-family;
                font-size: root.code-font-size;
                font-weight: 400;
                color: root.fg-default;
            }
        }
    }
    GitHubSelectableDiffCode {
        x: 70px;
        y: 0px;
        width: parent.width - 70px;
        height: parent.height;
        content: root.content;
        content-columns: root.content-columns;
        tokens: root.tokens;
        show-tokens: !root.live-resizing && !root.wrap-content;
        wrap-content: root.wrap-content;
        code-font-family: root.code-font-family;
        code-font-size: root.code-font-size;
        code-character-width: root.code-character-width;
        nominal-row-height: root.code-line-height;
        fg-default: root.fg-default;
        selection-background: root.selection-background;
        line-index: root.line-index;
        side: root.side;
        multi-sel-active: root.multi-sel-active;
        multi-sel-side: root.multi-sel-side;
        multi-sel-lo-line: root.multi-sel-lo-line;
        multi-sel-hi-line: root.multi-sel-hi-line;
        multi-sel-lo-col: root.multi-sel-lo-col;
        multi-sel-hi-col: root.multi-sel-hi-col;
        multi-sel-select-all: root.multi-sel-select-all;
        find-active: root.find-active;
        find-start-col: root.find-start-col;
        find-end-col: root.find-end-col;
        find-start-char: root.find-start-char;
        find-end-char: root.find-end-char;
        find-prefix: root.find-prefix;
        find-text: root.find-text;
        find-matches: root.find-matches;
        find-match-background: root.find-match-background;
        find-background: root.find-background;
        multi-sel-begin(line, col, side) => { root.multi-sel-begin(line, col, side); }
        multi-sel-update(line, col, side) => { root.multi-sel-update(line, col, side); }
        multi-sel-end => { root.multi-sel-end(); }
        multi-sel-edge(direction) => { root.multi-sel-edge(direction); }
        resolve-hit(line, x, y, row-height, code-width, cell-width, line-pitch, family, size, side) => {
            root.resolve-hit(line, x, y, row-height, code-width, cell-width, line-pitch, family, size, side)
        }
        resolve-token-hit(text, x, width, family, size, bold, italic) => {
            root.resolve-token-hit(text, x, width, family, size, bold, italic)
        }
        resolve-token-range(text, start, end, width, family, size, bold, italic) => {
            root.resolve-token-range(text, start, end, width, family, size, bold, italic)
        }
        resolve-wrapped-range(text, start, end, width, pitch, family, size) => {
            root.resolve-wrapped-range(text, start, end, width, pitch, family, size)
        }
        resolve-selection-slice(line, side, start-col, end-col) => {
            root.resolve-selection-slice(line, side, start-col, end-col)
        }
        resolve-wrap-line-start(line, side, caret, max-cols) => {
            root.resolve-wrap-line-start(line, side, caret, max-cols)
        }
    }
}

export component GitHubDiffViewPreview inherits Rectangle {
    in property <bool> split: false;
    in property <color> canvas-color;
    in property <color> outline-color;
    in property <color> addition-color;
    in property <color> deletion-color;
    in property <color> neutral-color;

    width: 52px;
    height: 52px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.outline-color;
    background: root.canvas-color;

    if !root.split: VerticalLayout {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        spacing: 3px;
        Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
    }

    if root.split: HorizontalLayout {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        spacing: 4px;
        VerticalLayout {
            spacing: 3px;
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        }
        VerticalLayout {
            spacing: 3px;
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        }
    }
}

export component GitHubDiffViewChoice inherits Rectangle {
    in property <string> label;
    in property <bool> split: false;
    in property <bool> selected: false;
    in property <color> bg-default;
    in property <color> bg-hover;
    in property <color> border-default;
    in property <color> accent-fg;
    in property <color> fg-default;
    in property <color> addition-color;
    in property <color> deletion-color;
    in property <color> neutral-color;
    callback choose();

    width: 100px;
    height: 98px;
    border-radius: 6px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.accent-fg : root.border-default;
    background: choice-touch.has-hover ? root.bg-hover : root.bg-default;

    GitHubDiffViewPreview {
        x: (parent.width - self.width) / 2;
        y: 10px;
        split: root.split;
        canvas-color: root.bg-default;
        outline-color: root.border-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.neutral-color;
    }
    Rectangle {
        x: 10px;
        y: 72px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.selected ? root.accent-fg : root.border-default;
        background: root.selected ? root.accent-fg : root.bg-default;
        if root.selected: Rectangle {
            x: 4px;
            y: 4px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: GitHubTheme.fg-on-emphasis;
        }
    }
    Text {
        x: 29px;
        y: 68px;
        width: parent.width - 36px;
        height: 22px;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: root.fg-default;
        vertical-alignment: center;
    }
    choice-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.choose(); }
    }
}

export component GitHubDiffSettingsPopover inherits Rectangle {
    in property <bool> open: false;
    // Tip of the upward Primer caret, relative to this popover's left edge.
    // Callers set this to the trigger-button center minus the panel's x so the
    // caret stays under the gear even when the panel is edge-clamped.
    in property <length> caret-x: self.width / 2;
    in-out property <string> pending-view: "unified";
    in-out property <bool> pending-ignore-whitespace: false;
    in property <bool> ignore-whitespace-supported: false;
    in property <color> bg-default;
    in property <color> bg-hover;
    in property <color> bg-muted;
    in property <color> border-default;
    in property <color> accent-fg;
    in property <color> fg-default;
    in property <color> fg-muted;
    in property <color> addition-color;
    in property <color> deletion-color;
    callback apply(string, bool);
    callback dismiss-requested();
    private property <int> dismiss-revision: TransientOverlayState.dismiss-revision;
    private property <int> popover-dismiss-revision:
        TransientOverlayState.popover-dismiss-revision;
    private property <int> exclusive-generation: TransientOverlayState.exclusive-generation;
    private property <int> exclusive-token: 0;

    changed open => {
        if root.open {
            // Share ActionMenu exclusivity so Diff view / readiness / file menus
            // switch on the first click at the component layer.
            root.exclusive-token = TransientOverlayState.exclusive-generation + 1;
            TransientOverlayState.claim-exclusive();
        }
    }

    changed dismiss-revision => {
        if root.open {
            TransientOverlayState.note-closed-open-menu();
            root.dismiss-requested();
        }
    }

    changed popover-dismiss-revision => {
        if root.open {
            TransientOverlayState.note-closed-open-menu();
            root.dismiss-requested();
        }
    }

    changed exclusive-generation => {
        if root.open && root.exclusive-token != TransientOverlayState.exclusive-generation {
            root.dismiss-requested();
        }
    }

    visible: root.open;
    width: 232px;
    height: 212px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.border-default;
    background: root.bg-default;
    // Caret draws above the top edge; do not clip it.
    clip: false;

    // The visual overlay must also own its complete pointer area. Without this
    // mounted hit target, blank areas of the popover allow hover to reach the
    // file-tree delegates painted underneath it.
    popover-pointer-shield := TouchArea {
        mouse-cursor: default;
    }

    // Primer `.Popover-message` caret: CSS border triangles (::before 8px /
    // ::after 7px). Slint Path fill is unreliable for this; use 45° squares
    // so the tip reads as a bordered speech-bubble like GitHub.
    private property <length> caret-tip-x: max(18px, min(root.width - 18px, root.caret-x));
    // Outer diamond = borderColor-default
    Rectangle {
        x: root.caret-tip-x - 6px;
        y: -6px;
        width: 12px;
        height: 12px;
        background: root.border-default;
        transform-rotation: 45deg;
        transform-origin: { x: 6px, y: 6px };
    }
    // Inner diamond = overlay bg; sit 1px lower so the tip keeps a border rim
    Rectangle {
        x: root.caret-tip-x - 5px;
        y: -4px;
        width: 10px;
        height: 10px;
        background: root.bg-default;
        transform-rotation: 45deg;
        transform-origin: { x: 5px, y: 5px };
    }
    // Cover the panel's top border under the caret so it joins seamlessly.
    Rectangle {
        x: root.caret-tip-x - 6px;
        y: 0px;
        width: 12px;
        height: 2px;
        background: root.bg-default;
    }

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 22px;
        text: I18n.diff-view;
        font-size: 13px;
        font-weight: 600;
        color: root.fg-default;
        vertical-alignment: center;
    }
    GitHubDiffViewChoice {
        x: 12px;
        y: 34px;
        label: I18n.diff-unified;
        selected: root.pending-view != "split";
        bg-default: root.bg-default;
        bg-hover: root.bg-hover;
        border-default: root.border-default;
        accent-fg: root.accent-fg;
        fg-default: root.fg-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.bg-muted;
        choose => { root.pending-view = "unified"; }
    }
    GitHubDiffViewChoice {
        x: 120px;
        y: 34px;
        label: I18n.diff-split;
        split: true;
        selected: root.pending-view == "split";
        bg-default: root.bg-default;
        bg-hover: root.bg-hover;
        border-default: root.border-default;
        accent-fg: root.accent-fg;
        fg-default: root.fg-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.bg-muted;
        choose => { root.pending-view = "split"; }
    }

    Rectangle {
        x: 12px;
        y: 140px;
        width: 16px;
        height: 16px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.pending-ignore-whitespace && root.ignore-whitespace-supported
            ? root.accent-fg
            : root.border-default;
        background: root.pending-ignore-whitespace && root.ignore-whitespace-supported
            ? root.accent-fg
            : root.bg-default;
        opacity: root.ignore-whitespace-supported ? 1 : 0.5;
        if root.pending-ignore-whitespace && root.ignore-whitespace-supported: Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: @image-url("../../assets/icons/octicon-check-16.svg");
            colorize: GitHubTheme.fg-on-emphasis;
        }
    }
    Text {
        x: 34px;
        y: 136px;
        width: parent.width - 46px;
        height: 24px;
        text: I18n.diff-hide-whitespace;
        font-size: 12px;
        font-weight: 600;
        color: root.ignore-whitespace-supported ? root.fg-default : root.fg-muted;
        vertical-alignment: center;
    }
    whitespace-touch := TouchArea {
        x: 8px;
        y: 134px;
        width: parent.width - 16px;
        height: 28px;
        mouse-cursor: root.ignore-whitespace-supported ? pointer : default;
        clicked => {
            if root.ignore-whitespace-supported {
                root.pending-ignore-whitespace = !root.pending-ignore-whitespace;
            }
        }
    }

    Rectangle {
        x: 12px;
        y: 170px;
        width: parent.width - 24px;
        height: 30px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.border-default;
        background: apply-touch.has-hover ? root.bg-hover : root.bg-muted;
        Text {
            width: parent.width;
            height: parent.height;
            text: I18n.diff-apply-reload;
            font-size: 12px;
            font-weight: 600;
            color: root.fg-default;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        apply-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.apply(root.pending-view, root.pending-ignore-whitespace);
            }
        }
    }
}

export component GitHubFileTreeToggleButton inherits Rectangle {
    in property <bool> file-tree-visible: true;
    callback clicked();

    width: 32px;
    height: 46px;
    background: transparent;

    tree-button := GitHubIconButton {
        x: 0px;
        y: 7px;
        control-size: 32px;
        icon: root.file-tree-visible
            ? @image-url("../../assets/icons/octicon-sidebar-collapse-16.svg")
            : @image-url("../../assets/icons/octicon-sidebar-expand-16.svg");
        show-tooltip: !PrReviewTooltipState.enabled;
        tooltip-text: root.file-tree-visible ? I18n.diff-hide-file-tree : I18n.diff-show-file-tree;
        tooltip-above: false;
        // This is the first Files changed control. Keep its downward tooltip
        // inside the review surface so it cannot overlap the sidebar divider.
        tooltip-align-left: true;
        selected: root.file-tree-visible;
        clicked => { root.clicked(); }
    }
    PrHideFileTreeTooltipAnchor { active: PrReviewTooltipState.enabled && tree-button.tooltip-active && root.file-tree-visible; placement: GitHubTooltipPlacement.Bottom; }
    PrShowFileTreeTooltipAnchor { active: PrReviewTooltipState.enabled && tree-button.tooltip-active && !root.file-tree-visible; placement: GitHubTooltipPlacement.Bottom; }

}

export component GitHubFileMenuButton inherits Rectangle {
    in property <bool> button-enabled: true;
    in property <bool> viewing-file: false;
    in property <bool> open: false;
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    callback action();
    callback toggle-menu();
    callback close-menu();

    width: 30px;
    height: 46px;

    more-button := GitHubFileToolbarButton {
        width: parent.width;
        height: parent.height;
        icon-source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        button-enabled: root.button-enabled;
        selected: root.open;
        show-tooltip: !PrReviewTooltipState.enabled;
        tooltip-text: I18n.diff-more-file-actions;
        tooltip-align-right: true;
        clicked => { root.toggle-menu(); }
    }

    PrMoreFileActionsTooltipAnchor { active: PrReviewTooltipState.enabled && more-button.tooltip-active; placement: GitHubTooltipPlacement.Bottom; }

    menu-popup := GitHubActionMenu {
        open: root.open;
        viewport-x: root.viewport-global-x - root.absolute-position.x;
        viewport-y: root.viewport-global-y - root.absolute-position.y;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        anchor-x: 0px;
        anchor-y: 0px;
        anchor-width: root.width;
        anchor-height: root.height;
        menu-width: GitHubMetrics.overlay-width-xsmall;
        content-height: GitHubMetrics.size-48;
        align: "end";
        dismiss-requested => { root.close-menu(); }

        GitHubActionListItem {
            x: GitHubMetrics.size-8;
            y: GitHubMetrics.size-8;
            width: parent.width - GitHubMetrics.size-16;
            text: root.viewing-file ? I18n.diff-view-diff : I18n.diff-view-file;
            icon: @image-url("../../assets/icons/octicon-eye-16.svg");
            activated => { root.action(); }
        }
    }
}

export component GitHubDiffStatSegment inherits Rectangle {
    in property <string> kind: "neutral";
    width: 8px;
    height: 8px;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.kind == "added"
            ? (GitHubTheme.dark-mode
                ? @image-url("../../assets/icons/github-diffstat-added-dark-8.svg")
                : @image-url("../../assets/icons/github-diffstat-added-8.svg"))
            : (root.kind == "deleted"
                ? (GitHubTheme.dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-deleted-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-deleted-8.svg"))
                : (GitHubTheme.dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-neutral-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-neutral-8.svg")));
    }
}

export component GitHubDiffStatBar inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    private property <int> total: root.additions + root.deletions;
    // GitHub assigns whole fifths independently. Any fractional remainder is
    // intentionally rendered as a neutral block rather than rounded up.
    private property <int> added-blocks: root.total == 0 ? 0 : Math.floor(root.additions * 5 / root.total);
    private property <int> deleted-blocks: root.total == 0 ? 0 : Math.floor(root.deletions * 5 / root.total);
    width: 44px;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 8px;
        spacing: 1px;
        GitHubDiffStatSegment { kind: root.added-blocks > 0 ? "added" : (root.deleted-blocks > 0 ? "deleted" : "neutral"); }
        GitHubDiffStatSegment { kind: root.added-blocks > 1 ? "added" : (root.added-blocks + root.deleted-blocks > 1 ? "deleted" : "neutral"); }
        GitHubDiffStatSegment { kind: root.added-blocks > 2 ? "added" : (root.added-blocks + root.deleted-blocks > 2 ? "deleted" : "neutral"); }
        GitHubDiffStatSegment { kind: root.added-blocks > 3 ? "added" : (root.added-blocks + root.deleted-blocks > 3 ? "deleted" : "neutral"); }
        GitHubDiffStatSegment { kind: root.added-blocks > 4 ? "added" : (root.added-blocks + root.deleted-blocks > 4 ? "deleted" : "neutral"); }
    }
}

export component GitHubFileDiffStat inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    in property <bool> has-selection: true;

    width: diffstat-bar.x + diffstat-bar.width;
    height: 46px;
    horizontal-stretch: 0;
    background: transparent;
    accessible-role: none;

    added-stat := Text {
        x: 0px;
        // Text glyphs sit optically high when their line box is geometrically
        // centered. Nudge them down to share the diff-stat blocks' midline.
        y: (parent.height - self.height) / 2 + 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "+" + root.additions : "";
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: GitHubTheme.success-fg;
    }

    removed-stat := Text {
        x: added-stat.x + added-stat.width + 4px;
        y: (parent.height - self.height) / 2 + 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "−" + root.deletions : "";
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: GitHubTheme.danger-fg;
    }

    diffstat-bar := GitHubDiffStatBar {
        x: removed-stat.x + removed-stat.width + 4px;
        y: (parent.height - self.height) / 2;
        additions: root.additions;
        deletions: root.deletions;
    }
}

export component GitHubCodeRenderingIndicator inherits Rectangle {
    width: 166px;
    height: 36px;
    background: transparent;

    GitHubCompactElevation {
        target-width: root.width;
        target-height: root.height;
        shadow-color: GitHubTheme.shadow-floating-medium;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 8px;
        border-width: 1px;
        border-color: GitHubTheme.border-default;
        background: GitHubTheme.canvas-overlay;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 13px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;
        cross-axis-alignment: center;

        GitHubSpinner {
            width: 16px;
            height: 16px;
            spinner-size: 16px;
            foreground: GitHubTheme.success-emphasis;
        }

        Text {
            height: 20px;
            text: I18n.diff-rendering-code;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 600;
            color: GitHubTheme.fg-default;
        }
    }
}

export component GitHubLargeDiffPlaceholder inherits Rectangle {
    in property <bool> loading: false;
    in property <color> bg-default;
    in property <color> bg-muted;
    in property <color> fg-muted;
    in property <color> accent-fg;
    callback load();

    background: root.bg-default;
    // GitHub renders the large-diff prompt in a compact diff body instead of
    // vertically centering it in the entire remaining viewport.
    private property <length> github-placeholder-height: min(root.height, 264px);

    // GitHub keeps a faint code-shaped skeleton behind the action and status.
    Rectangle { x: 24px; y: 24px; width: 110px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 146px; y: 24px; width: 210px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 52px; y: 48px; width: 230px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 294px; y: 48px; width: 260px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 52px; y: 72px; width: 150px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 214px; y: 72px; width: 96px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 322px; y: 72px; width: 132px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 24px; y: 96px; width: 80px; height: 12px; border-radius: 3px; background: root.bg-muted; }

    if !root.loading: Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(26px, root.github-placeholder-height / 2 - 38px);
        width: load-label.preferred-width + 16px;
        height: 32px;
        background: transparent;
        load-label := Text {
            width: parent.width;
            height: parent.height;
            text: I18n.diff-load;
            horizontal-alignment: center;
            vertical-alignment: center;
            // GitHub: Button--link Button--medium Button f4.
            font-size: 16px;
            font-weight: 500;
            color: root.accent-fg;
        }
        load-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.load(); }
        }
    }

    if root.loading: GitHubSpinner {
        x: (parent.width - self.width) / 2;
        y: max(26px, root.github-placeholder-height / 2 - 42px);
        spinner-size: 32px;
        foreground: root.fg-muted;
    }

    Text {
        x: 16px;
        y: max(62px, root.github-placeholder-height / 2);
        width: parent.width - 32px;
        height: 28px;
        text: I18n.diff-large-not-rendered;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        color: root.fg-muted;
    }
}

export component GitHubFileFilterField inherits Rectangle {
    in-out property <string> text;
    in property <string> font-family: ".SF NS";

    height: 32px;
    border-radius: 6px;
    border-width: filter-input.has-focus ? 2px : 1px;
    border-color: filter-input.has-focus
        ? (GitHubTheme.accent-fg)
        : (GitHubTheme.border-default);
    background: GitHubTheme.canvas-default;
    clip: true;

    Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-search-16.svg");
        image-fit: contain;
        colorize: GitHubTheme.fg-muted;
    }

    filter-input := TextInput {
        x: 32px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text <=> root.text;
        single-line: true;
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: GitHubTheme.fg-default;
        selection-background-color: GitHubTheme.diff-selection-bg;
        selection-foreground-color: self.color;
    }

    if root.text == "": Text {
        x: 32px;
        width: parent.width - 40px;
        height: parent.height;
        text: I18n.diff-filter-files;
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: GitHubTheme.fg-muted;
    }
}

// Compact find bar for Files changed. GitHub's PR Files changed page has no
// first-party find chrome (browser find-in-page fills that role). This docks an
// editor-style panel (CodeMirror/GitHub file-editor ⌘/Ctrl+F) into the selected
// file toolbar: query, match index/total, previous, next, and close.
export component GitHubDiffFindBar inherits Rectangle {
    in-out property <string> query;
    in property <int> current-index: -1;
    in property <int> match-count: 0;
    in property <string> font-family: ".SF NS";
    callback previous();
    callback next();
    callback close();
    callback accepted(bool);
    callback input-focus-changed(bool);
    out property <bool> input-focused: find-input.has-focus;

    private property <string> counter-text:
        root.query == ""
            ? ""
            : (root.match-count <= 0
                ? I18n.common-no-results
                : (root.current-index + 1) + "/" + root.match-count);
    private property <bool> has-matches: root.match-count > 0;

    width: 320px;
    height: 46px;
    background: transparent;

    changed input-focused => {
        root.input-focus-changed(root.input-focused);
    }

    bar := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 28px;
        border-radius: 6px;
        border-width: find-input.has-focus ? 2px : 1px;
        border-color: find-input.has-focus
            ? (GitHubTheme.accent-fg)
            : (GitHubTheme.border-default);
        background: GitHubTheme.canvas-default;
        clip: true;

        Image {
            x: 8px;
            y: 6px;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/octicon-search-16.svg");
            image-fit: contain;
            colorize: GitHubTheme.fg-muted;
        }

        find-input := TextInput {
            x: 28px;
            y: 0px;
            width: parent.width - 168px;
            height: parent.height;
            text <=> root.query;
            single-line: true;
            vertical-alignment: center;
            font-family: root.font-family;
            font-size: 12px;
            color: GitHubTheme.fg-default;
            selection-background-color: GitHubTheme.diff-selection-bg;
            selection-foreground-color: self.color;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.accepted(event.modifiers.shift);
                    return accept;
                }
                return reject;
            }
        }

        if root.query == "": Text {
            x: 28px;
            width: parent.width - 168px;
            height: parent.height;
            text: I18n.diff-find;
            vertical-alignment: center;
            font-family: root.font-family;
            font-size: 12px;
            color: GitHubTheme.fg-muted;
        }

        Text {
            x: parent.width - 140px;
            width: 52px;
            height: parent.height;
            text: root.counter-text;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-family: root.font-family;
            font-size: 11px;
            color: root.query != "" && !root.has-matches
                ? (GitHubTheme.danger-fg-strong)
                : (GitHubTheme.fg-muted);
            overflow: elide;
        }

        // Compact 22px controls stay inside the 28px bar so hover fills align.
        find-prev := Rectangle {
            x: parent.width - 82px;
            y: 3px;
            width: 22px;
            height: 22px;
            border-radius: 4px;
            background: prev-touch.has-hover && root.has-matches
                ? (GitHubTheme.control-soft-hover)
                : transparent;
            opacity: root.has-matches ? 1 : 0.38;
            Image {
                x: 3px;
                y: 3px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-chevron-up-16.svg");
                image-fit: contain;
                colorize: GitHubTheme.fg-muted;
            }
            prev-touch := TouchArea {
                mouse-cursor: root.has-matches ? pointer : default;
                clicked => {
                    if root.has-matches {
                        find-input.focus();
                        root.previous();
                    }
                }
            }
        }
        find-next := Rectangle {
            x: parent.width - 56px;
            y: 3px;
            width: 22px;
            height: 22px;
            border-radius: 4px;
            background: next-touch.has-hover && root.has-matches
                ? (GitHubTheme.control-soft-hover)
                : transparent;
            opacity: root.has-matches ? 1 : 0.38;
            Image {
                x: 3px;
                y: 3px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-chevron-down-16.svg");
                image-fit: contain;
                colorize: GitHubTheme.fg-muted;
            }
            next-touch := TouchArea {
                mouse-cursor: root.has-matches ? pointer : default;
                clicked => {
                    if root.has-matches {
                        find-input.focus();
                        root.next();
                    }
                }
            }
        }
        find-close := Rectangle {
            x: parent.width - 30px;
            y: 3px;
            width: 22px;
            height: 22px;
            border-radius: 4px;
            background: close-touch.has-hover
                ? (GitHubTheme.control-soft-hover)
                : transparent;
            Image {
                x: 3px;
                y: 3px;
                width: 16px;
                height: 16px;
                source: @image-url("../../assets/icons/octicon-x-16.svg");
                image-fit: contain;
                colorize: GitHubTheme.fg-muted;
            }
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
        }
    }

    public function focus-input() {
        find-input.focus();
        if (root.query != "") {
            find-input.select-all();
        }
    }
}

// Primer ActionMenu for the file-tree filter. Rows are plain ActionList items
// (not a nested ListView) so GitHubActionMenu owns viewport collision, auto
// flip, height clamping, and vertical scrolling — nesting ListView inside the
// overlay Flickable lets delegates paint outside the clipped surface and steals
// wheel events, which shows up as detached rows and a cut-off bottom on short
// windows. See docs/specs/ui-design.md "Anchored action menus".
export component GitHubFilterMenu inherits Rectangle {
    in property <[WorkflowPrFileExtensionFilter]> extension-filters: [];
    in property <bool> only-manifest-files: false;
    in property <bool> show-viewed-files: true;
    in property <string> font-family: ".SF NS";
    in property <bool> open: false;
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    callback toggle-extension(string);
    callback toggle-manifest();
    callback toggle-viewed();
    callback dismiss();

    // Header 53 + extension rows + divider 1 + two footer options 72.
    private property <length> extensions-height: root.extension-filters.length * 36px;
    private property <length> popup-content-height: 53px + root.extensions-height + 1px + 72px;

    width: 34px;
    height: 34px;
    background: transparent;

    filter-popup := GitHubActionMenu {
        open: root.open;
        viewport-x: root.viewport-global-x - root.absolute-position.x;
        viewport-y: root.viewport-global-y - root.absolute-position.y;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        anchor-x: 0px;
        anchor-y: 0px;
        anchor-width: root.width;
        anchor-height: root.height;
        menu-width: 224px;
        content-height: root.popup-content-height;
        menu-max-height: 432px;
        align: "start";
        side: "auto";
        dismiss-requested => { root.dismiss(); }

        Rectangle {
            width: parent.width;
            height: root.popup-content-height;

            Text {
                x: 16px;
                y: 0px;
                width: parent.width - 32px;
                height: 53px;
                text: I18n.diff-file-extensions;
                vertical-alignment: center;
                font-family: root.font-family;
                font-size: 14px;
                font-weight: 600;
                color: GitHubTheme.fg-default;
            }

            for extension[index] in root.extension-filters: Rectangle {
                x: 0px;
                y: 53px + index * 36px;
                width: parent.width;
                height: 36px;
                background: extension-touch.has-hover
                    ? (GitHubTheme.control-neutral-hover)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-16.svg");
                    image-fit: contain;
                    colorize: GitHubTheme.fg-muted;
                    opacity: extension.selected ? 1 : 0;
                }
                Text {
                    x: 48px;
                    width: parent.width - 96px;
                    height: parent.height;
                    text: extension.label;
                    vertical-alignment: center;
                    font-family: root.font-family;
                    font-size: 14px;
                    color: GitHubTheme.fg-default;
                    overflow: elide;
                }
                Rectangle {
                    x: parent.width - 48px;
                    y: 8px;
                    width: 32px;
                    height: 20px;
                    border-radius: 10px;
                    background: GitHubTheme.control-neutral-hover;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: extension.count;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-family: root.font-family;
                        font-size: 12px;
                        font-weight: 600;
                        color: GitHubTheme.fg-default;
                    }
                }
                extension-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-extension(extension.extension); }
                }
            }

            Rectangle {
                x: 0px;
                y: 53px + root.extensions-height;
                width: parent.width;
                height: 1px;
                background: GitHubTheme.border-default;
            }

            for option[index] in [I18n.diff-only-manifest-files, I18n.diff-viewed-files]: Rectangle {
                x: 0px;
                y: 54px + root.extensions-height + index * 36px;
                width: parent.width;
                height: 36px;
                background: option-touch.has-hover
                    ? (GitHubTheme.control-neutral-hover)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-16.svg");
                    image-fit: contain;
                    colorize: GitHubTheme.fg-muted;
                    opacity: (index == 0 ? root.only-manifest-files : root.show-viewed-files) ? 1 : 0;
                }
                Text {
                    x: 48px;
                    width: parent.width - 64px;
                    height: parent.height;
                    text: option;
                    vertical-alignment: center;
                    font-family: root.font-family;
                    font-size: 14px;
                    color: GitHubTheme.fg-default;
                }
                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if index == 0 { root.toggle-manifest(); }
                        else { root.toggle-viewed(); }
                    }
                }
            }
        }
    }
}

// Literal fixed-action leaves keep factory labels out of shared instance parameters.
export component GitHubPrOpenDiffSettingsButton inherits GitHubFileToolbarButton {
    tooltip-text: I18n.pr-review-open-diff-settings;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrOpenDiffSettingsTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active; placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom; }
}
export component GitHubPrPreviousFileButton inherits GitHubFileToolbarButton {
    tooltip-text: I18n.pr-review-previous-file;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrPreviousFileTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active; placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom; }
}
export component GitHubPrNextFileButton inherits GitHubFileToolbarButton {
    tooltip-text: I18n.pr-review-next-file;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrNextFileTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active; placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom; }
}
export component GitHubPrContextToggleButton inherits GitHubFileToolbarButton {
    in property <bool> context-expanded: false;
    tooltip-text: root.context-expanded ? I18n.pr-review-collapse-non-diff : I18n.pr-review-expand-all-lines;
    show-tooltip: !PrReviewTooltipState.enabled;
    PrCollapseNonDiffTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active && root.context-expanded; placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom; }
    PrExpandAllLinesTooltipAnchor { active: PrReviewTooltipState.enabled && root.tooltip-active && !root.context-expanded; placement: root.tooltip-above ? GitHubTooltipPlacement.Top : GitHubTooltipPlacement.Bottom; }
}
