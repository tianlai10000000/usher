import { MaterialPalette, MaterialText, ToolTip } from "@material";
import { ListView } from "../../../material-1.7.1-fixed/ui/components/list_view.slint";
import { ScrollView } from "../../../material-1.7.1-fixed/ui/components/scroll_view.slint";
import { AppState } from "../../state/app_state.slint";
import { WorkflowPrDiffToken, WorkflowPrDiffSelectionHit, WorkflowPrFileExtensionFilter } from "./shell.slint";

export component TreeIndentGuides inherits Rectangle {
    in property <int> depth: 0;
    background: transparent;
    border-width: 0px;
    if root.depth > 0: Rectangle { x: 15px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 1: Rectangle { x: 33px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 2: Rectangle { x: 51px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 3: Rectangle { x: 69px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 4: Rectangle { x: 87px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
    if root.depth > 5: Rectangle { x: 105px; width: 1px; height: parent.height; background: AppState.effective-dark-mode ? #3d444d : #d1d9e0; }
}

// GitHub Commits kebab: bordered muted pill; accent fill + icon when expanded.
// Clicks must only toggle the message body — never open commit detail.
export component CommitMessageToggleButton inherits Rectangle {
    in property <bool> expanded: false;
    out property <bool> has-hover: toggle-touch.has-hover;
    callback clicked();

    private property <color> accent-fg: AppState.effective-dark-mode ? #58a6ff : #0969da;
    private property <color> accent-bg: AppState.effective-dark-mode ? #388bfd1a : #ddf4ff;
    private property <color> accent-bg-hover: AppState.effective-dark-mode ? #388bfd33 : #b6e3ff;
    private property <color> accent-border: AppState.effective-dark-mode ? #388bfd66 : #54aeff66;
    private property <color> idle-fg: AppState.effective-dark-mode ? #9198a1 : #59636e;
    private property <color> idle-border: AppState.effective-dark-mode ? #3d444d : #d0d7de;
    private property <color> idle-bg: AppState.effective-dark-mode ? #21262d : #f6f8fa;
    private property <color> idle-bg-hover: AppState.effective-dark-mode ? #656c7633 : #eaeef2;

    // Above sibling title/row hit targets in the commit row.
    z: 2;
    width: 28px;
    height: 20px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.expanded ? root.accent-border : root.idle-border;
    // Expanded = Primer accent-muted selected chip (GitHub commits list).
    background: root.expanded
        ? (toggle-touch.has-hover ? root.accent-bg-hover : root.accent-bg)
        : (toggle-touch.has-hover ? root.idle-bg-hover : root.idle-bg);

    Image {
        // 12px Octicon in the 20px chip matches GitHub's compact control.
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        image-fit: contain;
        colorize: root.expanded ? root.accent-fg : root.idle-fg;
    }
    toggle-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if toggle-touch.has-hover: ToolTip {
        y: -self.height - 4px;
        text: root.expanded ? "Hide commit description" : "Show commit description";
    }
}

export component FileToolbarButton inherits Rectangle {
    in property <image> icon-source;
    in property <bool> button-enabled: true;
    in property <bool> selected: false;
    in property <bool> outlined: false;
    in property <string> tooltip-text;
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    out property <bool> has-hover: button-touch.has-hover;
    callback clicked();

    width: 30px;
    height: 46px;
    background: transparent;

    button-surface := Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 28px;
        border-radius: 6px;
        border-width: root.outlined ? 1px : 0px;
        border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
        background: root.selected
            ? (button-touch.has-hover
                ? (AppState.effective-dark-mode ? #656c7626 : #eff2f5)
                : (AppState.effective-dark-mode ? #656c7633 : #e6eaef))
            : (root.outlined
                ? (button-touch.has-hover && root.button-enabled
                    ? (AppState.effective-dark-mode ? #262c36 : #eff2f5)
                    : (AppState.effective-dark-mode ? #212830 : #f6f8fa))
                : (button-touch.has-hover && root.button-enabled ? MaterialPalette.surface_container_high : transparent));
        opacity: root.button-enabled ? 1 : 0.38;

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon-source;
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }
    button-touch := TouchArea {
        y: button-surface.y;
        height: button-surface.height;
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if root.button-enabled { root.clicked(); }
        }
    }
    if button-touch.has-hover && !root.selected && root.tooltip-text != "": ToolTip {
        x: root.tooltip-align-right ? root.width - self.width : 0px;
        // List delegates paint in order. A downward tooltip from a commit-row
        // copy action would therefore be covered by the following row, even
        // though ToolTip itself has a high local z-order.
        y: root.tooltip-above ? -self.height - 4px : root.height + 4px;
        text: root.tooltip-text;
    }
}

export component CommitSummaryNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-source;
    in property <bool> icon-after: false;
    in property <bool> button-enabled: true;
    in property <bool> draw-divider: false;
    callback clicked();

    height: 28px;
    background: nav-touch.has-hover && root.button-enabled
        ? (AppState.effective-dark-mode ? #656c7626 : #f3f4f6)
        : transparent;
    opacity: root.button-enabled ? 1 : 0.5;

    if root.draw-divider: Rectangle {
        x: 0px;
        width: 1px;
        height: parent.height;
        background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 4px;
        alignment: center;
        cross-axis-alignment: center;

        if !root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
        MaterialText {
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            vertical-alignment: center;
        }
        if root.icon-after: Image {
            width: 12px;
            height: 12px;
            source: root.icon-source;
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }

    nav-touch := TouchArea {
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if root.button-enabled {
                root.clicked();
            }
        }
    }
}

// Shared by the Files changed tree and the selected-file toolbar so both
// surfaces use the same Primer status Octicon for a given change type.
export component FileChangeTypeIcon inherits Image {
    in property <string> change-type: "edit_file";
    in property <color> muted-fg;
    in property <color> success-fg;
    in property <color> danger-fg;
    in property <color> attention-fg;

    width: 14px;
    height: 14px;
    source: root.change-type == "new_file"
        ? @image-url("../../assets/icons/octicon-file-added-16.svg")
        : (root.change-type == "deleted_file"
            ? @image-url("../../assets/icons/octicon-file-removed-16.svg")
            : (root.change-type == "renamed_file"
                ? @image-url("../../assets/icons/octicon-file-moved-16.svg")
                : @image-url("../../assets/icons/octicon-file-diff-16.svg")));
    image-fit: contain;
    colorize: root.change-type == "new_file"
        ? root.success-fg
        : (root.change-type == "deleted_file"
            ? root.danger-fg
            : (root.change-type == "renamed_file"
                ? root.attention-fg
                : root.muted-fg));
}

// GitHub-style selectable code cell. Syntax tokens stay as Text; selection is a
// workspace-owned range so drag can cross ListView rows. Gutters and +/- stay
// outside this component, matching GitHub's code-column copy behavior.
export component SelectableDiffCode inherits Rectangle {
    in property <string> content;
    in property <int> content-columns: content.character-count;
    in property <[WorkflowPrDiffToken]> tokens;
    in property <bool> show-tokens: false;
    in property <bool> wrap-content: false;
    in property <string> code-font-family;
    in property <length> code-font-size;
    in property <length> code-character-width: 7.2px;
    in property <length> nominal-row-height: 28px;
    in property <color> fg-default;
    in property <color> selection-background;
    in property <int> line-index: -1;
    in property <string> side: "";
    in property <bool> multi-sel-active: false;
    in property <string> multi-sel-side: "";
    in property <int> multi-sel-lo-line: -1;
    in property <int> multi-sel-hi-line: -1;
    in property <int> multi-sel-lo-col: 0;
    in property <int> multi-sel-hi-col: 0;
    in property <bool> multi-sel-select-all: false;
    callback multi-sel-begin(int, int, string);
    callback multi-sel-update(int, int, string);
    callback multi-sel-end();
    callback multi-sel-edge(int);
    callback resolve-hit(int, float, float, float, float, float, string) -> WorkflowPrDiffSelectionHit;

    private property <bool> in-multi-sel:
        root.multi-sel-active
        && root.multi-sel-side == root.side
        && root.line-index >= root.multi-sel-lo-line
        && root.line-index <= root.multi-sel-hi-line;
    private property <int> visible-columns:
        max(1, Math.floor(max(1px, root.width) / root.code-character-width));
    private property <int> visual-line-count:
        root.wrap-content
            ? max(1, Math.ceil(max(1, root.content-columns) / root.visible-columns))
            : 1;
    private property <bool> highlight-from-start:
        root.line-index > root.multi-sel-lo-line;
    private property <bool> highlight-to-end:
        root.line-index < root.multi-sel-hi-line;
    private property <int> highlight-start-col:
        root.highlight-from-start ? 0 : root.multi-sel-lo-col;
    private property <int> highlight-end-col:
        root.highlight-to-end
            ? max(root.content-columns, root.highlight-start-col + 1)
            : max(root.highlight-start-col, min(root.multi-sel-hi-col, root.content-columns));
    clip: true;

    // Selection rectangles only exist for selected, visible ListView rows.
    // Normal scrolling remains token-only and keeps the lazy model bounded.
    if root.in-multi-sel && root.multi-sel-select-all: Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.selection-background;
    }

    for visual-line in root.in-multi-sel && !root.multi-sel-select-all ? root.visual-line-count : 0: Rectangle {
        private property <int> segment-start:
            root.wrap-content ? visual-line * root.visible-columns : 0;
        private property <int> segment-end:
            root.wrap-content
                ? min(root.content-columns, self.segment-start + root.visible-columns)
                : root.content-columns;
        private property <int> selected-start:
            max(root.highlight-start-col, self.segment-start);
        private property <int> selected-end:
            min(root.highlight-end-col, self.segment-end);

        visible: self.selected-end > self.selected-start;
        x: (self.selected-start - self.segment-start) * root.code-character-width;
        y: root.wrap-content
            ? visual-line * root.nominal-row-height
            : (root.height - root.nominal-row-height) / 2;
        width: max(
            root.code-character-width,
            (self.selected-end - self.selected-start) * root.code-character-width
        );
        height: root.nominal-row-height;
        background: root.selection-background;
    }

    if root.show-tokens: HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        for token in root.tokens: Text {
            width: self.preferred-width;
            height: parent.height;
            text: token.text;
            vertical-alignment: center;
            overflow: clip;
            font-family: root.code-font-family;
            font-size: root.code-font-size;
            font-weight: token.bold ? 600 : 400;
            font-italic: token.italic;
            color: AppState.effective-dark-mode ? token.dark-color : token.color;
        }
    }
    if !root.show-tokens: Text {
        x: 0px;
        y: root.wrap-content ? 2px : 0px;
        width: parent.width;
        height: parent.height - (root.wrap-content ? 2px : 0px);
        text: root.content;
        vertical-alignment: root.wrap-content ? top : center;
        overflow: clip;
        // Row height and selection hit-testing use the same fixed-column
        // segmentation. Avoid word-wrap choosing different break points.
        wrap: root.wrap-content ? char-wrap : no-wrap;
        font-family: root.code-font-family;
        font-size: root.code-font-size;
        color: root.fg-default;
    }

    TouchArea {
        mouse-cursor: text;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.multi-sel-begin(
                    root.line-index,
                    root.col-at(self.mouse-x, self.mouse-y),
                    root.side
                );
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.multi-sel-end();
            }
        }
        moved => {
            if (!self.pressed) {
                return;
            }
            let hit = root.resolve-hit(
                root.line-index,
                self.mouse-x / 1px,
                self.mouse-y / 1px,
                root.height / 1px,
                root.width / 1px,
                root.code-character-width / 1px,
                root.side
            );
            root.multi-sel-update(hit.line, hit.column, root.side);
            root.multi-sel-edge(
                self.mouse-y < 0px ? -1 : (self.mouse-y > root.height ? 1 : 0)
            );
        }
    }

    function col-at(x: length, y: length) -> int {
        let visual-line = root.wrap-content
            ? max(0, min(root.visual-line-count - 1, Math.floor(y / root.nominal-row-height)))
            : 0;
        // Round to the nearest caret boundary so releasing on the right half of
        // a glyph includes that character in the copied range.
        return max(
            0,
            min(
                root.content-columns,
                visual-line * root.visible-columns
                    + Math.floor((max(0px, x) + root.code-character-width / 2) / root.code-character-width)
            )
        );
    }

}

export component SplitDiffSide inherits Rectangle {
    in property <int> line-number;
    in property <string> kind;
    in property <string> content;
    in property <int> content-columns: content.character-count;
    in property <[WorkflowPrDiffToken]> tokens;
    in property <bool> live-resizing: false;
    in property <bool> wrap-content: false;
    in property <string> code-font-family;
    in property <length> code-font-size;
    in property <length> code-line-height;
    in property <color> bg-default;
    in property <color> fg-default;
    in property <color> fg-muted;
    in property <color> addition-background;
    in property <color> addition-gutter-background;
    in property <color> deletion-background;
    in property <color> deletion-gutter-background;
    in property <color> selection-background;
    in property <length> code-character-width: 7.2px;
    in property <int> line-index: -1;
    in property <string> side: "";
    in property <bool> multi-sel-active: false;
    in property <string> multi-sel-side: "";
    in property <int> multi-sel-lo-line: -1;
    in property <int> multi-sel-hi-line: -1;
    in property <int> multi-sel-lo-col: 0;
    in property <int> multi-sel-hi-col: 0;
    in property <bool> multi-sel-select-all: false;
    callback multi-sel-begin(int, int, string);
    callback multi-sel-update(int, int, string);
    callback multi-sel-end();
    callback multi-sel-edge(int);
    callback resolve-hit(int, float, float, float, float, float, string) -> WorkflowPrDiffSelectionHit;

    background: root.kind == "addition"
        ? root.addition-background
        : (root.kind == "deletion" ? root.deletion-background : root.bg-default);

    // Absolute columns match GitHub's table-cell geometry and prevent a tall
    // wrapped row from cross-axis-centering its line number.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 50px;
        height: parent.height;
        background: root.kind == "addition"
            ? root.addition-gutter-background
            : (root.kind == "deletion" ? root.deletion-gutter-background : root.bg-default);
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.code-line-height;
            text: root.line-number == 0 ? "" : root.line-number;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: root.code-font-family;
            font-size: root.code-font-size;
            color: root.kind == "addition" || root.kind == "deletion"
                ? root.fg-default
                : root.fg-muted;
        }
    }
    Rectangle {
        x: 50px;
        y: 0px;
        width: 20px;
        height: parent.height;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.code-line-height;
            text: root.kind == "addition" ? "+" : (root.kind == "deletion" ? "-" : "");
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: root.code-font-family;
            font-size: root.code-font-size;
            color: root.fg-default;
        }
    }
    SelectableDiffCode {
        x: 70px;
        y: 0px;
        width: parent.width - 70px;
        height: parent.height;
        content: root.content;
        content-columns: root.content-columns;
        tokens: root.tokens;
        show-tokens: !root.live-resizing && !root.wrap-content;
        wrap-content: root.wrap-content;
        code-font-family: root.code-font-family;
        code-font-size: root.code-font-size;
        code-character-width: root.code-character-width;
        nominal-row-height: root.code-line-height;
        fg-default: root.fg-default;
        selection-background: root.selection-background;
        line-index: root.line-index;
        side: root.side;
        multi-sel-active: root.multi-sel-active;
        multi-sel-side: root.multi-sel-side;
        multi-sel-lo-line: root.multi-sel-lo-line;
        multi-sel-hi-line: root.multi-sel-hi-line;
        multi-sel-lo-col: root.multi-sel-lo-col;
        multi-sel-hi-col: root.multi-sel-hi-col;
        multi-sel-select-all: root.multi-sel-select-all;
        multi-sel-begin(line, col, side) => { root.multi-sel-begin(line, col, side); }
        multi-sel-update(line, col, side) => { root.multi-sel-update(line, col, side); }
        multi-sel-end => { root.multi-sel-end(); }
        multi-sel-edge(direction) => { root.multi-sel-edge(direction); }
        resolve-hit(line, x, y, row-height, code-width, cell-width, side) => {
            root.resolve-hit(line, x, y, row-height, code-width, cell-width, side)
        }
    }
}

export component DiffViewPreview inherits Rectangle {
    in property <bool> split: false;
    in property <color> canvas-color;
    in property <color> outline-color;
    in property <color> addition-color;
    in property <color> deletion-color;
    in property <color> neutral-color;

    width: 52px;
    height: 52px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.outline-color;
    background: root.canvas-color;

    if !root.split: VerticalLayout {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        spacing: 3px;
        Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
        Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
    }

    if root.split: HorizontalLayout {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        spacing: 4px;
        VerticalLayout {
            spacing: 3px;
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.deletion-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        }
        VerticalLayout {
            spacing: 3px;
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.addition-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
            Rectangle { height: 4px; border-radius: 2px; background: root.neutral-color; }
        }
    }
}

export component DiffViewChoice inherits Rectangle {
    in property <string> label;
    in property <bool> split: false;
    in property <bool> selected: false;
    in property <color> bg-default;
    in property <color> bg-hover;
    in property <color> border-default;
    in property <color> accent-fg;
    in property <color> fg-default;
    in property <color> addition-color;
    in property <color> deletion-color;
    in property <color> neutral-color;
    callback choose();

    width: 100px;
    height: 98px;
    border-radius: 6px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.accent-fg : root.border-default;
    background: choice-touch.has-hover ? root.bg-hover : root.bg-default;

    DiffViewPreview {
        x: (parent.width - self.width) / 2;
        y: 10px;
        split: root.split;
        canvas-color: root.bg-default;
        outline-color: root.border-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.neutral-color;
    }
    Rectangle {
        x: 10px;
        y: 72px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.selected ? root.accent-fg : root.border-default;
        background: root.selected ? root.accent-fg : root.bg-default;
        if root.selected: Rectangle {
            x: 4px;
            y: 4px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffffff;
        }
    }
    MaterialText {
        x: 29px;
        y: 68px;
        width: parent.width - 36px;
        height: 22px;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: root.fg-default;
        vertical-alignment: center;
    }
    choice-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.choose(); }
    }
}

export component DiffSettingsPopover inherits Rectangle {
    in property <bool> open: false;
    // Tip of the upward Primer caret, relative to this popover's left edge.
    // Callers set this to the trigger-button center minus the panel's x so the
    // caret stays under the gear even when the panel is edge-clamped.
    in property <length> caret-x: self.width / 2;
    in-out property <string> pending-view: "unified";
    in-out property <bool> pending-ignore-whitespace: false;
    in property <bool> ignore-whitespace-supported: false;
    in property <color> bg-default;
    in property <color> bg-hover;
    in property <color> bg-muted;
    in property <color> border-default;
    in property <color> accent-fg;
    in property <color> fg-default;
    in property <color> fg-muted;
    in property <color> addition-color;
    in property <color> deletion-color;
    callback apply(string, bool);

    visible: root.open;
    width: 232px;
    height: 212px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.border-default;
    background: root.bg-default;
    // Caret draws above the top edge; do not clip it.
    clip: false;

    // The visual overlay must also own its complete pointer area. Without this
    // mounted hit target, blank areas of the popover allow hover to reach the
    // file-tree delegates painted underneath it.
    popover-pointer-shield := TouchArea {
        mouse-cursor: default;
    }

    // Primer `.Popover-message` caret: CSS border triangles (::before 8px /
    // ::after 7px). Slint Path fill is unreliable for this; use 45° squares
    // so the tip reads as a bordered speech-bubble like GitHub.
    private property <length> caret-tip-x: max(18px, min(root.width - 18px, root.caret-x));
    // Outer diamond = borderColor-default
    Rectangle {
        x: root.caret-tip-x - 6px;
        y: -6px;
        width: 12px;
        height: 12px;
        background: root.border-default;
        transform-rotation: 45deg;
        transform-origin: { x: 6px, y: 6px };
    }
    // Inner diamond = overlay bg; sit 1px lower so the tip keeps a border rim
    Rectangle {
        x: root.caret-tip-x - 5px;
        y: -4px;
        width: 10px;
        height: 10px;
        background: root.bg-default;
        transform-rotation: 45deg;
        transform-origin: { x: 5px, y: 5px };
    }
    // Cover the panel's top border under the caret so it joins seamlessly.
    Rectangle {
        x: root.caret-tip-x - 6px;
        y: 0px;
        width: 12px;
        height: 2px;
        background: root.bg-default;
    }

    MaterialText {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 22px;
        text: "Diff view";
        font-size: 13px;
        font-weight: 600;
        color: root.fg-default;
        vertical-alignment: center;
    }
    DiffViewChoice {
        x: 12px;
        y: 34px;
        label: "Unified";
        selected: root.pending-view != "split";
        bg-default: root.bg-default;
        bg-hover: root.bg-hover;
        border-default: root.border-default;
        accent-fg: root.accent-fg;
        fg-default: root.fg-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.bg-muted;
        choose => { root.pending-view = "unified"; }
    }
    DiffViewChoice {
        x: 120px;
        y: 34px;
        label: "Split";
        split: true;
        selected: root.pending-view == "split";
        bg-default: root.bg-default;
        bg-hover: root.bg-hover;
        border-default: root.border-default;
        accent-fg: root.accent-fg;
        fg-default: root.fg-default;
        addition-color: root.addition-color;
        deletion-color: root.deletion-color;
        neutral-color: root.bg-muted;
        choose => { root.pending-view = "split"; }
    }

    Rectangle {
        x: 12px;
        y: 140px;
        width: 16px;
        height: 16px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.pending-ignore-whitespace && root.ignore-whitespace-supported
            ? root.accent-fg
            : root.border-default;
        background: root.pending-ignore-whitespace && root.ignore-whitespace-supported
            ? root.accent-fg
            : root.bg-default;
        opacity: root.ignore-whitespace-supported ? 1 : 0.5;
        if root.pending-ignore-whitespace && root.ignore-whitespace-supported: Image {
            x: 2px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: @image-url("../../assets/icons/octicon-check-16.svg");
            colorize: #ffffff;
        }
    }
    MaterialText {
        x: 34px;
        y: 136px;
        width: parent.width - 46px;
        height: 24px;
        text: "Hide whitespace";
        font-size: 12px;
        font-weight: 600;
        color: root.ignore-whitespace-supported ? root.fg-default : root.fg-muted;
        vertical-alignment: center;
    }
    whitespace-touch := TouchArea {
        x: 8px;
        y: 134px;
        width: parent.width - 16px;
        height: 28px;
        mouse-cursor: root.ignore-whitespace-supported ? pointer : default;
        clicked => {
            if root.ignore-whitespace-supported {
                root.pending-ignore-whitespace = !root.pending-ignore-whitespace;
            }
        }
    }

    Rectangle {
        x: 12px;
        y: 170px;
        width: parent.width - 24px;
        height: 30px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.border-default;
        background: apply-touch.has-hover ? root.bg-hover : root.bg-muted;
        MaterialText {
            width: parent.width;
            height: parent.height;
            text: "Apply and reload";
            font-size: 12px;
            font-weight: 600;
            color: root.fg-default;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        apply-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.apply(root.pending-view, root.pending-ignore-whitespace);
            }
        }
    }
}

export component FileTreeToggleButton inherits Rectangle {
    in property <bool> file-tree-visible: true;
    callback clicked();

    width: 32px;
    height: 46px;
    background: transparent;

    button-surface := Rectangle {
        y: 7px;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: root.file-tree-visible
            ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
            : (toggle-touch.has-hover
                ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                : transparent);
        Image {
            x: 8px;
            y: 8px;
            width: 16px;
            height: 16px;
            source: root.file-tree-visible
                ? @image-url("../../assets/icons/octicon-sidebar-collapse-16.svg")
                : @image-url("../../assets/icons/octicon-sidebar-expand-16.svg");
            image-fit: contain;
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }

    toggle-touch := TouchArea {
        y: button-surface.y;
        width: button-surface.width;
        height: button-surface.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if toggle-touch.has-hover: ToolTip {
        x: 0px;
        y: root.height + 4px;
        text: root.file-tree-visible ? "Hide file tree" : "Show file tree";
    }
}

export component FileMenuButton inherits Rectangle {
    in property <bool> button-enabled: true;
    in property <bool> viewing-file: false;
    in property <bool> open: false;
    callback action();
    callback toggle-menu();

    width: 30px;
    height: 46px;

    FileToolbarButton {
        width: parent.width;
        height: parent.height;
        icon-source: @image-url("../../assets/icons/octicon-kebab-horizontal-16.svg");
        button-enabled: root.button-enabled;
        selected: root.open;
        tooltip-text: "More file actions";
        tooltip-align-right: true;
        clicked => { root.toggle-menu(); }
    }

    menu-popup := Rectangle {
        x: root.width - self.width;
        y: root.height - 4px;
        width: 192px;
        height: 52px;
        visible: root.open;
        z: 10000;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            background: AppState.effective-dark-mode ? #151b23 : #ffffff;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 6px;

            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: 36px;
                border-radius: 8px;
                background: view-file-touch.has-hover
                    ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-eye-16.svg");
                    image-fit: contain;
                    colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                }
                MaterialText {
                    x: 48px;
                    width: parent.width - 64px;
                    height: parent.height;
                    text: root.viewing-file ? "View diff" : "View file";
                    vertical_alignment: center;
                    font-size: 14px;
                    font-weight: 400;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }
                view-file-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action();
                    }
                }
            }

        }
    }
}

export component DiffStatSegment inherits Rectangle {
    in property <string> kind: "neutral";
    width: 8px;
    height: 8px;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.kind == "added"
            ? (AppState.effective-dark-mode
                ? @image-url("../../assets/icons/github-diffstat-added-dark-8.svg")
                : @image-url("../../assets/icons/github-diffstat-added-8.svg"))
            : (root.kind == "deleted"
                ? (AppState.effective-dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-deleted-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-deleted-8.svg"))
                : (AppState.effective-dark-mode
                    ? @image-url("../../assets/icons/github-diffstat-neutral-dark-8.svg")
                    : @image-url("../../assets/icons/github-diffstat-neutral-8.svg")));
    }
}

export component DiffStatBar inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    private property <int> total: root.additions + root.deletions;
    // GitHub assigns whole fifths independently. Any fractional remainder is
    // intentionally rendered as a neutral block rather than rounded up.
    private property <int> added-blocks: root.total == 0 ? 0 : Math.floor(root.additions * 5 / root.total);
    private property <int> deleted-blocks: root.total == 0 ? 0 : Math.floor(root.deletions * 5 / root.total);
    width: 44px;
    height: 16px;
    background: transparent;
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 8px;
        spacing: 1px;
        DiffStatSegment { kind: root.added-blocks > 0 ? "added" : (root.deleted-blocks > 0 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 1 ? "added" : (root.added-blocks + root.deleted-blocks > 1 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 2 ? "added" : (root.added-blocks + root.deleted-blocks > 2 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 3 ? "added" : (root.added-blocks + root.deleted-blocks > 3 ? "deleted" : "neutral"); }
        DiffStatSegment { kind: root.added-blocks > 4 ? "added" : (root.added-blocks + root.deleted-blocks > 4 ? "deleted" : "neutral"); }
    }
}

export component FileDiffStat inherits Rectangle {
    in property <int> additions;
    in property <int> deletions;
    in property <bool> has-selection: true;

    width: diffstat-bar.x + diffstat-bar.width;
    height: 46px;
    horizontal-stretch: 0;
    background: transparent;
    accessible-role: none;

    added-stat := Text {
        x: 0px;
        // Align the rendered glyph bounds with the centered 8px diff-stat blocks.
        y: (parent.height - self.height) / 2 - 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "+" + root.additions : "";
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: AppState.effective-dark-mode ? #3fb950 : #1f883d;
    }

    removed-stat := Text {
        x: added-stat.x + added-stat.width + 4px;
        y: (parent.height - self.height) / 2 - 1px;
        width: self.preferred-width;
        height: 16px;
        text: root.has-selection ? "−" + root.deletions : "";
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: AppState.effective-dark-mode ? #f85149 : #cf222e;
    }

    diffstat-bar := DiffStatBar {
        x: removed-stat.x + removed-stat.width + 4px;
        y: (parent.height - self.height) / 2;
        additions: root.additions;
        deletions: root.deletions;
    }
}

export component CodeRenderingIndicator inherits Rectangle {
    width: 166px;
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: AppState.effective-dark-mode ? #151b23 : #ffffff;
    drop-shadow-blur: 14px;
    drop-shadow-color: AppState.effective-dark-mode ? #00000066 : #1f232826;
    drop-shadow-offset-y: 4px;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 13px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            width: 16px;
            height: parent.height;
            background: transparent;

            private property <float> rotation-progress: mod(animation-tick(), 900ms) / 900ms;

            Image {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 16px;
                source: @image-url("../../assets/icons/loading.svg");
                image-fit: contain;
                colorize: MaterialPalette.primary;
                transform-rotation: parent.rotation-progress * 360deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
        }

        MaterialText {
            text: "Rendering code";
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 600;
            color: MaterialPalette.on_surface;
        }
    }
}

export component LargeDiffPlaceholder inherits Rectangle {
    in property <bool> loading: false;
    in property <color> bg-default;
    in property <color> bg-muted;
    in property <color> fg-muted;
    in property <color> accent-fg;
    callback load();

    background: root.bg-default;
    // GitHub renders the large-diff prompt in a compact diff body instead of
    // vertically centering it in the entire remaining viewport.
    private property <length> github-placeholder-height: min(root.height, 264px);

    // GitHub keeps a faint code-shaped skeleton behind the action and status.
    Rectangle { x: 24px; y: 24px; width: 110px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 146px; y: 24px; width: 210px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 52px; y: 48px; width: 230px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 294px; y: 48px; width: 260px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 52px; y: 72px; width: 150px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 214px; y: 72px; width: 96px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 322px; y: 72px; width: 132px; height: 12px; border-radius: 3px; background: root.bg-muted; }
    Rectangle { x: 24px; y: 96px; width: 80px; height: 12px; border-radius: 3px; background: root.bg-muted; }

    if !root.loading: Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(26px, root.github-placeholder-height / 2 - 38px);
        width: load-label.preferred-width + 16px;
        height: 32px;
        background: transparent;
        load-label := MaterialText {
            width: parent.width;
            height: parent.height;
            text: "Load diff";
            horizontal-alignment: center;
            vertical-alignment: center;
            // GitHub: Button--link Button--medium Button f4.
            font-size: 16px;
            font-weight: 500;
            color: root.accent-fg;
        }
        load-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.load(); }
        }
    }

    if root.loading: Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(26px, root.github-placeholder-height / 2 - 42px);
        width: 32px;
        height: 32px;
        // GitHub Primer Spinner uses a 1000ms linear rotation.
        private property <float> rotation-progress: mod(animation-tick(), 1000ms) / 1000ms;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../../assets/icons/github-spinner-16.svg");
            image-fit: contain;
            colorize: root.fg-muted;
            transform-rotation: parent.rotation-progress * 360deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
        }
    }

    MaterialText {
        x: 16px;
        y: max(62px, root.github-placeholder-height / 2);
        width: parent.width - 32px;
        height: 28px;
        text: "Large diffs are not rendered by default.";
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        color: root.fg-muted;
    }
}

export component GitHubFileFilterField inherits Rectangle {
    in-out property <string> text;
    in property <string> font-family: ".SF NS";

    height: 32px;
    border-radius: 6px;
    border-width: filter-input.has-focus ? 2px : 1px;
    border-color: filter-input.has-focus
        ? (AppState.effective-dark-mode ? #4493f8 : #0969da)
        : (AppState.effective-dark-mode ? #3d444d : #d1d9e0);
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    clip: true;

    Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("../../assets/icons/octicon-search-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }

    filter-input := TextInput {
        x: 32px;
        y: 0px;
        width: parent.width - 40px;
        height: parent.height;
        text <=> root.text;
        single-line: true;
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        selection-background-color: AppState.effective-dark-mode ? #388bfd66 : #0969da55;
        selection-foreground-color: self.color;
    }

    if root.text == "": Text {
        x: 32px;
        width: parent.width - 40px;
        height: parent.height;
        text: "Filter files…";
        vertical-alignment: center;
        font-family: root.font-family;
        font-size: 14px;
        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }
}

export component GitHubFilterMenu inherits Rectangle {
    in property <[WorkflowPrFileExtensionFilter]> extension-filters: [];
    in property <bool> only-manifest-files: false;
    in property <bool> show-viewed-files: true;
    in property <string> font-family: ".SF NS";
    in property <bool> open: false;
    callback toggle-extension(string);
    callback toggle-manifest();
    callback toggle-viewed();

    width: 34px;
    height: 34px;
    background: transparent;

    filter-popup := Rectangle {
        x: 0px;
        y: root.height + 6px;
        width: 224px;
        height: 53px + min(root.extension-filters.length * 36px, 252px) + 1px + 72px;
        visible: root.open;
        z: 10000;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            background: AppState.effective-dark-mode ? #151b23 : #ffffff;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000030;
            drop-shadow-offset-y: 6px;
            clip: true;

            Text {
                x: 16px;
                y: 0px;
                width: parent.width - 32px;
                height: 53px;
                text: "File extensions";
                vertical-alignment: center;
                font-family: root.font-family;
                font-size: 14px;
                font-weight: 600;
                color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            }

            extension-list := ListView {
                x: 0px;
                y: 53px;
                width: parent.width;
                height: min(root.extension-filters.length * 36px, 252px);
                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                vertical_scrollbar_policy: root.extension-filters.length > 7 ? ScrollBarPolicy.as_needed : ScrollBarPolicy.always_off;
                for extension in root.extension-filters: Rectangle {
                    width: extension-list.visible_width;
                    height: 36px;
                    background: extension-touch.has-hover
                        ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                        : transparent;
                    Image {
                        x: 16px;
                        y: 10px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-check-16.svg");
                        image-fit: contain;
                        colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                        opacity: extension.selected ? 1 : 0;
                    }
                    Text {
                        x: 48px;
                        width: parent.width - 96px;
                        height: parent.height;
                        text: extension.extension;
                        vertical-alignment: center;
                        font-family: root.font-family;
                        font-size: 14px;
                        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 48px;
                        y: 8px;
                        width: 32px;
                        height: 20px;
                        border-radius: 10px;
                        background: AppState.effective-dark-mode ? #656c7633 : #818b981f;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: extension.count;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-family: root.font-family;
                            font-size: 12px;
                            font-weight: 600;
                            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                        }
                    }
                    extension-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-extension(extension.extension); }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: 53px + extension-list.height;
                width: parent.width;
                height: 1px;
                background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            }

            for option[index] in ["Only manifest files", "Viewed files"]: Rectangle {
                x: 0px;
                y: 54px + extension-list.height + index * 36px;
                width: parent.width;
                height: 36px;
                background: option-touch.has-hover
                    ? (AppState.effective-dark-mode ? #656c7633 : #818b981f)
                    : transparent;
                Image {
                    x: 16px;
                    y: 10px;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../assets/icons/octicon-check-16.svg");
                    image-fit: contain;
                    colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
                    opacity: (index == 0 ? root.only-manifest-files : root.show-viewed-files) ? 1 : 0;
                }
                Text {
                    x: 48px;
                    width: parent.width - 64px;
                    height: parent.height;
                    text: option;
                    vertical-alignment: center;
                    font-family: root.font-family;
                    font-size: 14px;
                    color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                }
                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if index == 0 { root.toggle-manifest(); }
                        else { root.toggle-viewed(); }
                    }
                }
            }
        }
    }
}
