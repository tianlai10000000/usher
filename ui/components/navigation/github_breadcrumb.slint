import { Route } from "../../route/routeMap.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubLink } from "../github_link.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";

// Primer Breadcrumbs "normal" variant:
// 14 px link text, accent-colored ancestors, default-colored current page,
// hover underline, and the official compact slanted divider geometry.
component GitHubBreadcrumbItem {
    in property <image> icon;
    in property <string> text;
    in property <bool> is-current: false;
    in property <bool> clickable: true;

    callback clicked();

    // Breadcrumbs use the same 14px Lucide geometry and subdued foreground as
    // the trailing title-bar Settings action. Route text still carries the
    // link/current-page hierarchy; icons remain one consistent command style.
    private property <color> icon-foreground: GitHubTheme.fg-subtle;
    private property <color> link-foreground: GitHubTheme.accent-fg;
    private property <bool> has-icon: icon.width > 0 && icon.height > 0;
    private property <length> icon-size: 14px;
    private property <length> label-x: root.has-icon
        ? root.icon-size + GitHubMetrics.size-6
        : 0px;
    width: root.label-x + item-label-measure.preferred-width;
    height: 32px;

    item-label-measure := Text {
        visible: false;
        text: root.text;
        font-size: 14px;
    }

    if root.has-icon: Image {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.icon-foreground;
    }

    if root.is-current: Text {
        x: root.label-x;
        y: 0px;
        width: item-label-measure.preferred-width;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        font-weight: 400;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    if !root.is-current: GitHubLink {
        x: root.label-x;
        // GitHubLink owns a compact 20 px line box while the breadcrumb row is
        // 32 px tall. Geometric centering keeps Latin and CJK labels aligned
        // with the icon without a locale-specific optical offset.
        y: (root.height - self.height) / 2;
        text: root.text;
        link-enabled: root.clickable;
        clicked => { root.clicked(); }
    }

    // Keep a leading icon inside the same breadcrumb action.
    if root.has-icon && !root.is-current: TouchArea {
        x: 0px;
        width: root.label-x;
        mouse-cursor: root.clickable ? pointer : default;
        enabled: root.clickable;
        clicked => { root.clicked(); }
    }
}

component GitHubBreadcrumbSeparator {
    width: 15px;
    height: 32px;

    // Primer React uses a 0.8 em line rotated 15 degrees with 0.5 em inline
    // margins. At the 14 px body size that maps to an 11 px divider.
    Rectangle {
        x: 7px;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 11px;
        background: GitHubTheme.fg-muted;
        transform-rotation: 15deg;
        transform-origin: { x: 0.5px, y: 5.5px };
    }
}

// PageHeader trailing action: an invisible Primer IconButton with the standard
// 32 px control size, 6 px radius, and semantic transparent hover/press fills.
component GitHubBreadcrumbBackButton inherits GitHubIconButton {
    callback back();

    icon: @image-url("../../assets/icons/octicon-arrow-left-16.svg");
    tooltip-text: I18n.common-back;
    tooltip-above: false;
    foreground: GitHubTheme.fg-default;
    clicked => { root.back(); }
}

export component GitHubBreadcrumb inherits Rectangle {
    in property <Route> current-route: Route.Home;
    in property <Route> previous-route: Route.Home;
    in property <bool> navigation-can-go-back: false;
    in property <bool> show-back-button: true;
    // The macOS shell mounts breadcrumbs in the native title-bar inset. Keep
    // blank title-bar space free of input handlers so it remains draggable.
    in property <bool> titlebar-mode: false;
    in property <length> trailing-reserved-width: 0px;
    in property <bool> show-bottom-divider: true;

    callback navigate(Route);
    callback back();

    private property <bool> is-about-page: current-route == Route.About;
    private property <bool> is-settings-page: current-route == Route.Settings;
    private property <bool> is-messages-page: current-route == Route.Messages;
    private property <bool> is-ui-components-page: current-route == Route.UiComponents;
    private property <bool> is-home: current-route == Route.Home;

    height: root.titlebar-mode ? 46px : 40px;
    // Alpha ≈ 0.35 on fill only (not root.opacity) so crumb text stays opaque.
    // Real translucency needs page content scrolling underneath this bar.
    background: root.titlebar-mode ? transparent : GitHubTheme.canvas-translucent;
    clip: false;
    drop-shadow-blur: root.titlebar-mode ? 0px : 5px;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: root.titlebar-mode ? transparent : GitHubTheme.shadow-floating-subtle;

    // Slint rectangles do not capture pointer input. Without this shield,
    // clicks fall through the translucent bar onto scrolled page controls
    // (e.g. Project "New project" under the overlay). Later crumb/back
    // TouchAreas still win hit-testing on their own geometry.
    if !root.titlebar-mode: TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: default;
    }

    HorizontalLayout {
        // Title-bar content uses the geometric center of the full 46px inset.
        y: 0px;
        width: parent.width;
        height: parent.height;
        // The page ScrollView contributes a 4 px outer gutter before each
        // page's 24 px content inset. Add the same offset so breadcrumbs and
        // page headings share one left edge.
        padding-left: 20px;
        padding-right: 16px + root.trailing-reserved-width;
        padding-top: root.titlebar-mode ? 7px : 4px;
        padding-bottom: root.titlebar-mode ? 7px : 4px;
        spacing: 8px;

        breadcrumb-region := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            background: transparent;
            clip: true;

            HorizontalLayout {
                x: 0px;
                width: self.preferred-width;
                height: parent.height;
                alignment: start;
                spacing: 0px;

                GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-home.svg");
                    text: I18n.navigation-home;
                    is-current: root.is-home;
                    clickable: !root.is-home;
                    clicked => { root.navigate(Route.Home); }
                }

                if root.is-about-page: GitHubBreadcrumbSeparator {}
                if root.is-about-page: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-help.svg");
                    text: I18n.common-about;
                    is-current: true;
                }

                if root.is-settings-page: GitHubBreadcrumbSeparator {}
                if root.is-settings-page: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-settings.svg");
                    text: I18n.common-settings;
                    is-current: true;
                }

                if root.current-route == Route.Search: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.Search: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-search.svg");
                    text: I18n.common-search;
                    is-current: true;
                }

                if root.is-messages-page: GitHubBreadcrumbSeparator {}
                if root.is-messages-page: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-bell.svg");
                    text: I18n.common-notifications;
                    is-current: true;
                }

                if root.is-ui-components-page: GitHubBreadcrumbSeparator {}
                if root.is-ui-components-page: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-components.svg");
                    text: I18n.navigation-ui-components;
                    is-current: true;
                }

                if root.current-route == Route.Project: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.Project: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-projects.svg");
                    text: I18n.common-projects;
                    is-current: true;
                }

                if root.current-route == Route.Workflow: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.Workflow: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-projects.svg");
                    text: I18n.common-projects;
                    clicked => { root.navigate(Route.Project); }
                }
                if root.current-route == Route.Workflow: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.Workflow: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-components.svg");
                    text: I18n.common-workflow;
                    is-current: true;
                }

                if root.current-route == Route.JobRun: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.JobRun: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-components.svg");
                    text: I18n.common-job-run;
                    is-current: true;
                }

                if root.current-route == Route.Chat: GitHubBreadcrumbSeparator {}
                if root.current-route == Route.Chat: GitHubBreadcrumbItem {
                    icon: @image-url("../../assets/icons/lucide-sidebar-chat.svg");
                    text: I18n.navigation-chat;
                    is-current: true;
                }

            }
        }

        if root.show-back-button && root.navigation-can-go-back: GitHubBreadcrumbBackButton {
            back => { root.back(); }
        }
    }

    if root.show-bottom-divider: Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: GitHubTheme.border-default;
    }
}
