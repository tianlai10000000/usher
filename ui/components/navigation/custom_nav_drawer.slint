import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { Route } from "../../route/routeMap.slint";
import { I18n } from "@i18n";

export struct NavItem {
    icon: image,
    text: string,
}

// Codex-style docked sidebar/content boundary. The temporary hover sidebar is
// a bordered, rounded overlay and intentionally does not reuse these inward
// elevation lobes.
export component GitHubSidebarRightEdge inherits Rectangle {
    width: 21px;
    background: transparent;

    Rectangle {
        width: 20px;
        height: parent.height;
        background: @linear-gradient(90deg,
            transparent 0%,
            #00000001 40%,
            #00000003 72%,
            GitHubTheme.sidebar-content-shadow-wide 100%);
    }

    Rectangle {
        x: GitHubMetrics.size-12;
        width: GitHubMetrics.size-8;
        height: parent.height;
        background: @linear-gradient(90deg,
            transparent 0%,
            #00000002 55%,
            GitHubTheme.sidebar-content-shadow-near 100%);
    }

    Rectangle {
        x: 20px;
        width: GitHubMetrics.border-thin;
        height: parent.height;
        background: GitHubTheme.shell-divider;
    }

}

component GitHubNavigationItem {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected: false;
    in property <int> label-weight: 400;
    in property <length> label-y-offset: 0px;

    callback clicked();

    private property <bool> keyboard-focus-visible: false;
    private property <color> item-foreground: root.selected
        ? GitHubTheme.fg-default
        : GitHubTheme.sidebar-navigation-fg;
    // Shared with the macOS traffic-light cluster (shifted +8pt in macos.rs).
    private property <length> icon-x:
        GitHubMetrics.sidebar-nav-icon-center-x
            - GitHubMetrics.sidebar-nav-icon-size / 2
            - GitHubMetrics.size-8;

    // The complete 32px band remains interactive; the 31px background below
    // leaves a 1px visual gap before the next row without breaking hover.
    height: 32px;
    accessible-role: tab;
    accessible-enabled: true;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;

    navigation-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    item-background := Rectangle {
        x: GitHubMetrics.size-8;
        width: parent.width - GitHubMetrics.size-16;
        height: 31px;
        border-radius: 10px;
        background: item-touch.pressed
            ? GitHubTheme.sidebar-item-active
            : root.selected
                ? GitHubTheme.sidebar-item-selected
                : item-touch.has-hover
                    ? GitHubTheme.sidebar-item-hover
                    : transparent;

        Image {
            x: root.icon-x;
            y: (parent.height - self.height) / 2;
            width: GitHubMetrics.sidebar-nav-icon-size;
            height: GitHubMetrics.sidebar-nav-icon-size;
            source: root.icon;
            image-fit: contain;
            colorize: root.item-foreground;
        }

        Text {
            x: GitHubMetrics.size-32;
            y: root.label-y-offset;
            width: parent.width - self.x - GitHubMetrics.size-8;
            height: parent.height;
            text: root.text;
            color: root.item-foreground;
            font-size: 13px;
            font-weight: root.label-weight;
            vertical-alignment: center;
            overflow: elide;
        }

    }

    item-touch := TouchArea {
        x: GitHubMetrics.size-8;
        width: parent.width - GitHubMetrics.size-16;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            navigation-focus.focus();
            root.keyboard-focus-visible = false;
            root.clicked();
        }
    }

    if navigation-focus.has-focus && root.keyboard-focus-visible: Rectangle {
        x: GitHubMetrics.size-8;
        width: parent.width - GitHubMetrics.size-16;
        height: 31px;
        border-radius: 10px;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }
}

// Desktop application sidebar inspired by ChatGPT's macOS shell. The owner
// decides whether this surface is docked or temporarily overlaid.
export component GitHubNavigationSidebar inherits Rectangle {
    in property <[NavItem]> items;
    in property <int> item-count: root.items.length;
    in property <int> current-index: -1;
    in property <Route> current-route: Route.Home;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> show-sidebar-control: true;
    in property <bool> show-history-controls: true;
    in property <bool> native-vibrancy: false;
    in property <bool> native-window-active: true;
    // Docked macOS sidebars paint the surface that Codex composites above its
    // Menu backdrop. Temporary hover sidebars already own an opaque parent.
    in property <bool> paint-native-surface: true;
    in property <length> titlebar-inset: 0px;
    in property <image> header-chevron-icon: @image-url("../../assets/icons/lucide-sidebar-chevron-down.svg");
    in property <image> search-icon: @image-url("../../assets/icons/lucide-sidebar-search.svg");
    in property <image> notification-icon: @image-url("../../assets/icons/lucide-sidebar-bell.svg");
    in property <image> settings-icon: @image-url("../../assets/icons/lucide-sidebar-settings.svg");
    in property <image> about-icon: @image-url("../../assets/icons/lucide-sidebar-help.svg");
    in property <string> toggle-shortcut-label: "";
    in property <string> back-shortcut-label: "";
    in property <string> forward-shortcut-label: "";

    callback selected(item-index: int);
    callback navigate(Route);
    callback toggle-docked();
    callback back();
    callback forward();
    // The host uses this to dismiss any window-scoped transient overlay before
    // applying a navigation or chrome action.
    callback interaction-started();

    width: GitHubMetrics.application-sidebar-width;
    height: 100%;
    background: root.native-vibrancy
        ? (root.paint-native-surface
            ? (root.native-window-active
                ? GitHubTheme.sidebar-native-active-canvas
                : GitHubTheme.sidebar-native-inactive-canvas)
            : transparent)
        : GitHubTheme.sidebar-canvas;
    accessible-role: tab-list;
    accessible-label: I18n.navigation-primary;

    // Receive clicks on sidebar chrome that is not occupied by a control.
    // Interactive children are painted later and keep their own hit targets.
    TouchArea {
        clicked => { root.interaction-started(); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        padding: 0px;

        native-control-row := Rectangle {
            width: parent.width;
            height: root.native-vibrancy
                ? root.titlebar-inset
                : (root.show-sidebar-control || root.show-history-controls
                    ? GitHubMetrics.size-40
                    : 0px);
            background: transparent;

            if root.show-sidebar-control: GitHubIconButton {
                x: GitHubMetrics.size-8;
                y: (parent.height - self.height) / 2;
                control-size: GitHubMetrics.control-medium-size;
                icon: @image-url("../../assets/icons/octicon-sidebar-collapse-16.svg");
                tooltip-text: root.toggle-shortcut-label == ""
                    ? I18n.tooltip-hide-sidebar
                    : I18n.tooltip-hide-sidebar + " (" + root.toggle-shortcut-label + ")";
                tooltip-above: false;
                foreground: GitHubTheme.fg-muted;
                clicked => {
                    root.interaction-started();
                    root.toggle-docked();
                }
            }

            if root.show-history-controls: GitHubIconButton {
                x: 44px;
                y: (parent.height - self.height) / 2;
                control-size: GitHubMetrics.control-medium-size;
                icon: @image-url("../../assets/icons/octicon-arrow-left-16.svg");
                tooltip-text: root.back-shortcut-label == ""
                    ? I18n.common-back
                    : I18n.common-back + " (" + root.back-shortcut-label + ")";
                tooltip-above: false;
                foreground: GitHubTheme.fg-muted;
                button-enabled: root.can-go-back;
                clicked => {
                    root.interaction-started();
                    root.back();
                }
            }

            if root.show-history-controls: GitHubIconButton {
                x: GitHubMetrics.size-80;
                y: (parent.height - self.height) / 2;
                control-size: GitHubMetrics.control-medium-size;
                icon: @image-url("../../assets/icons/octicon-chevron-right-16.svg");
                tooltip-text: root.forward-shortcut-label == ""
                    ? I18n.tooltip-forward
                    : I18n.tooltip-forward + " (" + root.forward-shortcut-label + ")";
                tooltip-above: false;
                foreground: GitHubTheme.fg-muted;
                button-enabled: root.can-go-forward;
                clicked => {
                    root.interaction-started();
                    root.forward();
                }
            }
        }

        product-header := Rectangle {
            width: parent.width;
            height: 52px;
            background: transparent;

            // Codex aligns the product title with the nav icon left edges.
            Text {
                x: GitHubMetrics.sidebar-nav-icon-center-x
                    - GitHubMetrics.sidebar-nav-icon-size / 2;
                width: 58px;
                height: parent.height;
                text: "Usher";
                color: GitHubTheme.fg-default;
                font-size: GitHubMetrics.text-large;
                font-weight: 600;
                vertical-alignment: center;
            }

            Image {
                x: GitHubMetrics.sidebar-nav-icon-center-x
                    - GitHubMetrics.sidebar-nav-icon-size / 2
                    + 56px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: root.header-chevron-icon;
                colorize: GitHubTheme.fg-muted;
            }

            GitHubIconButton {
                x: parent.width - 64px;
                y: (parent.height - self.height) / 2;
                control-size: GitHubMetrics.size-24;
                // 16px in a 24px control → 4px inset (whole pixels). 15px sat
                // on 4.5px and FemtoVG bilinear-blurred the SVG bitmap.
                glyph-size: GitHubMetrics.sidebar-nav-icon-size;
                icon: root.search-icon;
                tooltip-text: I18n.common-search;
                tooltip-above: false;
                foreground: GitHubTheme.fg-muted;
                clicked => {
                    root.interaction-started();
                    root.navigate(Route.Search);
                }
            }

            GitHubIconButton {
                x: parent.width - GitHubMetrics.size-32;
                y: (parent.height - self.height) / 2;
                control-size: GitHubMetrics.size-24;
                glyph-size: GitHubMetrics.sidebar-nav-icon-size;
                icon: root.notification-icon;
                tooltip-text: I18n.common-notifications;
                tooltip-above: false;
                tooltip-align-right: true;
                foreground: GitHubTheme.fg-muted;
                selected: root.current-route == Route.Messages;
                clicked => {
                    root.interaction-started();
                    root.navigate(Route.Messages);
                }
            }
        }

        nav-scroll := Flickable {
            width: parent.width;
            height: parent.height
                - native-control-row.height
                - product-header.height
                - GitHubMetrics.size-48
                - 1px;
            viewport-width: parent.width;
            interactive: true;

            // Flickable owns pointer input across its viewport, so its empty
            // area needs a local dismiss target instead of relying on the
            // sidebar background behind it.
            TouchArea {
                width: nav-scroll.width;
                height: nav-scroll.height;
                clicked => { root.interaction-started(); }
            }

            VerticalLayout {
                width: parent.width;
                spacing: 0px;
                padding-top: GitHubMetrics.size-2;
                padding-bottom: GitHubMetrics.size-12;

                for item[index] in root.items: GitHubNavigationItem {
                    width: parent.width;
                    visible: index < root.item-count;
                    height: self.visible ? 32px : 0px;
                    icon: item.icon;
                    text: item.text;
                    selected: index == root.current-index;
                    clicked => {
                        root.interaction-started();
                        root.selected(index);
                    }
                }
            }
        }

        Rectangle {
            width: parent.width;
            height: 1px;
            background: GitHubTheme.sidebar-divider;
        }

        Rectangle {
            width: parent.width;
            height: GitHubMetrics.size-48;
            background: transparent;

            GitHubNavigationItem {
                x: 0px;
                y: 9px;
                width: parent.width - GitHubMetrics.size-40;
                icon: root.settings-icon;
                text: I18n.common-settings;
                label-weight: 400;
                label-y-offset: 1px;
                selected: root.current-route == Route.Settings;
                clicked => {
                    root.interaction-started();
                    root.navigate(Route.Settings);
                }
            }

            GitHubIconButton {
                x: parent.width - GitHubMetrics.size-32;
                y: GitHubMetrics.size-12;
                control-size: GitHubMetrics.size-24;
                glyph-size: GitHubMetrics.sidebar-nav-icon-size;
                icon: root.about-icon;
                tooltip-text: I18n.navigation-about-usher;
                show-tooltip: false;
                tooltip-above: true;
                foreground: GitHubTheme.fg-muted;
                selected: root.current-route == Route.About;
                clicked => {
                    root.interaction-started();
                    root.navigate(Route.About);
                }
            }
        }
    }

}
