import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";

// 导航菜单项数据结构
export struct NavItem {
    icon: image,
    text: string,
}

// 自定义导航菜单项模板
// Primer ActionList/NavList compact geometry: 32px control, 6px radius,
// 16–20px leading visual, semantic transparent-control interaction colors.
component GitHubNavigationItem {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected: false;
    in property <int> index;
    private property <bool> keyboard-focus-visible: false;
    
    callback clicked();
    callback hovered(string, int, bool);
    
    property <bool> has-icon: root.icon.width > 0 && root.icon.height > 0;
    property <color> fg-default: GitHubTheme.fg-default;
    property <color> fg-muted: GitHubTheme.fg-muted;
    property <color> control-hover: GitHubTheme.control-transparent-hover;
    property <color> control-selected: GitHubTheme.control-transparent-selected;
    property <color> control-active: GitHubTheme.control-transparent-active;
    property <color> item-color: selected ? root.fg-default : root.fg-muted;
    
    property <length> icon-size: GitHubMetrics.icon-large;
    property <length> item-height: GitHubMetrics.size-44;

    height: item-height;
    accessible-role: tab;
    accessible-enabled: true;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;

    navigation-focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            root.keyboard-focus-visible = true;
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus-visible = false;
        }
    }

    Rectangle {
        width: root.width;
        height: root.item-height;
        background: transparent;

        hover-bg := Rectangle {
            width: GitHubMetrics.size-36;
            height: GitHubMetrics.size-36;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: GitHubMetrics.radius-medium;
            background: hover-area.pressed
                ? root.control-active
                : root.selected
                    ? root.control-selected
                    : hover-area.has-hover ? root.control-hover : transparent;
            animate background { duration: 120ms; easing: ease-out; }
        }

        if root.has-icon : Image {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: root.icon-size;
            height: root.icon-size;
            source: root.icon;
            colorize: root.item-color;
        }

        hover-area := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;

            clicked => {
                navigation-focus.focus();
                // Some platforms report programmatic focus as tab navigation.
                // Pointer activation must never leave a keyboard focus ring.
                root.keyboard-focus-visible = false;
                root.clicked();
            }

            changed has-hover => {
                root.hovered(root.text, root.index, self.has-hover);
            }
        }

        if navigation-focus.has-focus && root.keyboard-focus-visible: Rectangle {
            x: (root.width - GitHubMetrics.size-40) / 2;
            y: (root.height - GitHubMetrics.size-40) / 2;
            width: GitHubMetrics.size-40;
            height: GitHubMetrics.size-40;
            border-radius: GitHubMetrics.radius-medium + GitHubMetrics.size-2;
            border-width: GitHubMetrics.focus-outline-width;
            border-color: GitHubTheme.focus-outline;
            background: transparent;
        }
    }

    animate item-color { duration: 120ms; easing: ease-out; }
}

// 自定义导航抽屉组件
export component GitHubNavigationRail {
    in property <[NavItem]> items;
    in property <int> current_index: -1;  // -1 表示无选中项
    in-out property <string> hovered-tooltip-text: "";
    in-out property <int> hovered-tooltip-index: -1;
    // Negative when scrolled down; MainWindow tooltip Y must add this offset.
    in-out property <length> scroll-offset-y <=> nav-scroll.viewport-y;

    callback selected(item_index: int);
    width: 100%;
    // Fill the rail so Flickable can clip and scroll when items overflow.
    height: 100%;
    accessible-role: tab-list;
    accessible-label: "Primary navigation";

    // Wheel/trackpad scroll only — no scrollbar chrome in the 48px rail.
    // Tooltips stay on MainWindow (outside this clip) and use scroll-offset-y.
    nav-scroll := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        interactive: true;

        VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 4px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: GitHubMetrics.size-8;
            padding-bottom: GitHubMetrics.size-8;

            for item[index] in root.items : GitHubNavigationItem {
                width: parent.width;
                icon: item.icon;
                text: item.text;
                selected: index == root.current_index;
                index: index;

                clicked => {
                    root.selected(index);
                }

                hovered(text, item-index, visible) => {
                    if visible {
                        root.hovered-tooltip-text = text;
                        root.hovered-tooltip-index = item-index;
                    } else if root.hovered-tooltip-text == text {
                        root.hovered-tooltip-text = "";
                        root.hovered-tooltip-index = -1;
                    }
                }
            }
        }
    }
}
