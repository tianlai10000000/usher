// 自定义导航抽屉组件 - 用于替代 Material NavigationDrawer
// 主要改进：去除顶部标题，减小菜单项高度和图标大小

import {
    MaterialPalette, MaterialStyleMetrics, MaterialAnimations,
    Icon
} from "@material";

// 导航菜单项数据结构
export struct NavItem {
    icon: image,
    text: string,
}

// 自定义导航菜单项模板
component NavItemTemplate {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected: false;
    in property <int> index;
    
    callback clicked();
    callback hovered(string, int, bool);
    
    property <bool> has_icon: root.icon.width > 0 && root.icon.height > 0;
    property <color> item_color: selected ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
    
    property <length> icon_size: 20px;
    property <length> item_height: 32px;

    height: item_height;
    
    Rectangle {
        width: root.width;
        height: root.item_height;
        background: transparent;

        hover-bg := Rectangle {
            width: 28px;
            height: 28px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 6px;
            background: hover-area.has-hover
                ? MaterialPalette.surface_container_high
                : transparent;
            animate background { duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }
        }

        if root.has_icon : Icon {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: root.icon_size;
            height: root.icon_size;
            source: root.icon;
            colorize: root.item_color;
        }

        hover-area := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;

            clicked => {
                root.clicked();
            }

            changed has-hover => {
                root.hovered(root.text, root.index, self.has-hover);
            }
        }
    }
    
    animate item_color { duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }
}

// 自定义导航抽屉组件
export component CustomNavDrawer {
    in property <[NavItem]> items;
    in property <int> current_index: -1;  // -1 表示无选中项
    in-out property <string> hovered-tooltip-text: "";
    in-out property <int> hovered-tooltip-index: -1;
    
    callback selected(item_index: int);
    width: 100%;
    
    VerticalLayout {
        width: parent.width;
        alignment: start;
        spacing: 12px;
        padding-left: 0;
        padding-right: 0;
        padding-top: MaterialStyleMetrics.padding_8;
        padding-bottom: MaterialStyleMetrics.padding_8;
        
        for item[index] in root.items : NavItemTemplate {
            width: parent.width;
            icon: item.icon;
            text: item.text;
            selected: index == root.current_index;
            index: index;
            
            clicked => {
                root.selected(index);
            }

            hovered(text, item-index, visible) => {
                if visible {
                    root.hovered-tooltip-text = text;
                    root.hovered-tooltip-index = item-index;
                } else if root.hovered-tooltip-text == text {
                    root.hovered-tooltip-text = "";
                    root.hovered-tooltip-index = -1;
                }
            }
        }
    }
}
