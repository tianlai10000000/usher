// 自定义导航抽屉组件 - 用于替代 Material NavigationDrawer
// 主要改进：去除顶部标题，减小菜单项高度和图标大小

import {
    MaterialAnimations, Icon
} from "@material";
import { AppState } from "../../state/app_state.slint";

// 导航菜单项数据结构
export struct NavItem {
    icon: image,
    text: string,
}

// 自定义导航菜单项模板
// Primer ActionList/NavList compact geometry: 32px control, 6px radius,
// 16–20px leading visual, semantic transparent-control interaction colors.
component NavItemTemplate {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected: false;
    in property <int> index;
    
    callback clicked();
    callback hovered(string, int, bool);
    
    property <bool> has-icon: root.icon.width > 0 && root.icon.height > 0;
    property <color> fg-default: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    property <color> fg-muted: AppState.effective-dark-mode ? #9198a1 : #59636e;
    property <color> control-hover: AppState.effective-dark-mode ? #ffffff1a : #818b981f;
    property <color> control-selected: AppState.effective-dark-mode ? #ffffff1f : #818b9826;
    property <color> control-active: AppState.effective-dark-mode ? #ffffff29 : #818b9833;
    property <color> item-color: selected ? root.fg-default : root.fg-muted;
    
    property <length> icon-size: 20px;
    property <length> item-height: 40px;

    height: item-height;
    
    Rectangle {
        width: root.width;
        height: root.item-height;
        background: transparent;

        hover-bg := Rectangle {
            width: 32px;
            height: 32px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 6px;
            background: hover-area.pressed
                ? root.control-active
                : root.selected
                    ? root.control-selected
                    : hover-area.has-hover ? root.control-hover : transparent;
            animate background { duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }
        }

        if root.has-icon : Icon {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: root.icon-size;
            height: root.icon-size;
            source: root.icon;
            colorize: root.item-color;
        }

        hover-area := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;

            clicked => {
                root.clicked();
            }

            changed has-hover => {
                root.hovered(root.text, root.index, self.has-hover);
            }
        }
    }
    
    animate item-color { duration: MaterialAnimations.opacity_duration; easing: MaterialAnimations.opacity_easing; }
}

// 自定义导航抽屉组件
export component CustomNavDrawer {
    in property <[NavItem]> items;
    in property <int> current_index: -1;  // -1 表示无选中项
    in-out property <string> hovered-tooltip-text: "";
    in-out property <int> hovered-tooltip-index: -1;
    // Negative when scrolled down; MainWindow tooltip Y must add this offset.
    in-out property <length> scroll-offset-y <=> nav-scroll.viewport-y;

    callback selected(item_index: int);
    width: 100%;
    // Fill the rail so Flickable can clip and scroll when items overflow.
    height: 100%;

    // Wheel/trackpad scroll only — no scrollbar chrome in the 48px rail.
    // Tooltips stay on MainWindow (outside this clip) and use scroll-offset-y.
    nav-scroll := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        interactive: true;

        VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 4px;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 8px;
            padding-bottom: 8px;

            for item[index] in root.items : NavItemTemplate {
                width: parent.width;
                icon: item.icon;
                text: item.text;
                selected: index == root.current_index;
                index: index;

                clicked => {
                    root.selected(index);
                }

                hovered(text, item-index, visible) => {
                    if visible {
                        root.hovered-tooltip-text = text;
                        root.hovered-tooltip-index = item-index;
                    } else if root.hovered-tooltip-text == text {
                        root.hovered-tooltip-text = "";
                        root.hovered-tooltip-index = -1;
                    }
                }
            }
        }
    }
}
