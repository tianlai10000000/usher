// Shared Codex-inspired Markdown rhythm for compact conversations and full
// document Preview. Rust's virtual Preview metrics mirror the document values.
export global GitHubMarkdownMetrics {
    out property <length> conversation-body-font-size: 14px;
    out property <length> conversation-body-line-height: 22px;
    out property <length> conversation-heading-1-font-size: 24px;
    out property <length> conversation-heading-2-font-size: 20px;
    out property <length> conversation-heading-3-font-size: 17px;
    out property <length> conversation-heading-compact-font-size: 15px;
    out property <length> conversation-heading-1-line-height: 30px;
    out property <length> conversation-heading-2-line-height: 25px;
    out property <length> conversation-heading-3-line-height: 22px;
    out property <length> conversation-heading-compact-line-height: 20px;

    out property <length> document-body-font-size: 14px;
    out property <length> document-body-line-height: 22px;
    out property <length> document-heading-1-font-size: 24px;
    out property <length> document-heading-2-font-size: 20px;
    out property <length> document-heading-3-font-size: 17px;
    out property <length> document-heading-4-font-size: 15px;
    out property <length> document-heading-compact-font-size: 15px;
    out property <length> document-heading-1-line-height: 30px;
    out property <length> document-heading-2-line-height: 25px;
    out property <length> document-heading-3-line-height: 22px;
    out property <length> document-heading-compact-line-height: 20px;

    out property <length> code-font-size: 12px;
    out property <length> code-line-height: 19px;
    out property <length> code-header-height: 24px;
    out property <length> glyph-safety-height: 4px;
}
