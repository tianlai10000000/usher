import { GitHubFloatingOverlayHost } from "../github_floating_overlay.slint";
import { GitHubTooltipSurface } from "../github_tooltip.slint";
import {
    GitHubTooltipAlignment,
    GitHubTooltipPlacement,
} from "../../state/tooltip_overlay_state.slint";
import { I18n } from "@i18n";
import {
    MessageTooltipKind,
    MessageTooltipOverlayState,
} from "../../state/message_tooltip_overlay_state.slint";

// Do not consolidate these anchors behind a `kind` input. The Messages list is
// an isolated ComponentFactory whose recycled delegates have retained sibling
// input values. Each leaf publishes its action kind directly so neither a
// string nor an enum crosses that boundary.
export component GitHubMarkReadTooltipAnchor inherits Rectangle {
    in property <bool> active: false;

    private property <bool> has-published-non-origin-position: false;
    private property <bool> detached:
        root.has-published-non-origin-position
        && root.absolute-position.x == 0px
        && root.absolute-position.y == 0px;

    width: 100%;
    height: 100%;
    background: transparent;

    init => { root.publish(); }
    changed active => { root.publish(); }
    changed absolute-position => { root.publish(); }
    changed width => { root.publish(); }
    changed height => { root.publish(); }

    lease-timer := Timer {
        interval: 32ms;
        running: root.active;
        triggered => {
            if !root.detached && root.width > 0px && root.height > 0px {
                MessageTooltipOverlayState.renew(
                    MessageTooltipKind.MarkRead,
                    root.absolute-position.x,
                    root.absolute-position.y,
                    root.width,
                    root.height,
                );
            }
        }
    }

    function publish() {
        if root.active && !root.detached && root.width > 0px && root.height > 0px {
            MessageTooltipOverlayState.show(
                MessageTooltipKind.MarkRead,
                root.absolute-position.x,
                root.absolute-position.y,
                root.width,
                root.height,
            );
            if root.absolute-position.x != 0px || root.absolute-position.y != 0px {
                root.has-published-non-origin-position = true;
            }
        } else {
            MessageTooltipOverlayState.hide(
                MessageTooltipKind.MarkRead,
                root.absolute-position.x,
                root.absolute-position.y,
            );
        }
    }
}

