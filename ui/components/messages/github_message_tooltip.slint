// Factory-root portal. Keep all three literal surfaces mounted for the complete
// page lifetime. Opacity selects the active one without allowing Slint to reuse
// a conditional node's previous text or preferred width.
export component GitHubMessageTooltipOverlayHost inherits Rectangle {
    in property <length> boundary-padding: 8px;
    in property <length> anchor-gap: 4px;
    private property <int> observed-lease: 0;

    width: 100%;
    height: 100%;
    background: transparent;
    clip: false;

    mark-read-host := GitHubFloatingOverlayHost {
        opacity: MessageTooltipOverlayState.kind == MessageTooltipKind.MarkRead ? 1 : 0;
        anchor-x: MessageTooltipOverlayState.anchor-x;
        anchor-y: MessageTooltipOverlayState.anchor-y;
        anchor-width: MessageTooltipOverlayState.anchor-width;
        anchor-height: MessageTooltipOverlayState.anchor-height;
        floating-width: mark-read-surface.width;
        floating-height: mark-read-surface.height;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.End;
        boundary-padding: root.boundary-padding;
        anchor-gap: root.anchor-gap;

        mark-read-surface := GitHubTooltipSurface {
            text: I18n.messages-mark-as-read;
            viewport-max-width: max(0px, root.width - root.boundary-padding * 2);
            viewport-max-height: max(0px, root.height - root.boundary-padding * 2);
        }
    }

    mark-unread-host := GitHubFloatingOverlayHost {
        opacity: MessageTooltipOverlayState.kind == MessageTooltipKind.MarkUnread ? 1 : 0;
        anchor-x: MessageTooltipOverlayState.anchor-x;
        anchor-y: MessageTooltipOverlayState.anchor-y;
        anchor-width: MessageTooltipOverlayState.anchor-width;
        anchor-height: MessageTooltipOverlayState.anchor-height;
        floating-width: mark-unread-surface.width;
        floating-height: mark-unread-surface.height;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.End;
        boundary-padding: root.boundary-padding;
        anchor-gap: root.anchor-gap;

        mark-unread-surface := GitHubTooltipSurface {
            text: I18n.messages-mark-as-unread;
            viewport-max-width: max(0px, root.width - root.boundary-padding * 2);
            viewport-max-height: max(0px, root.height - root.boundary-padding * 2);
        }
    }

    delete-host := GitHubFloatingOverlayHost {
        opacity: MessageTooltipOverlayState.kind == MessageTooltipKind.Delete ? 1 : 0;
        anchor-x: MessageTooltipOverlayState.anchor-x;
        anchor-y: MessageTooltipOverlayState.anchor-y;
        anchor-width: MessageTooltipOverlayState.anchor-width;
        anchor-height: MessageTooltipOverlayState.anchor-height;
        floating-width: delete-surface.width;
        floating-height: delete-surface.height;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.End;
        boundary-padding: root.boundary-padding;
        anchor-gap: root.anchor-gap;

        delete-surface := GitHubTooltipSurface {
            text: I18n.common-delete;
            viewport-max-width: max(0px, root.width - root.boundary-padding * 2);
            viewport-max-height: max(0px, root.height - root.boundary-padding * 2);
        }
    }

    lease-watch := Timer {
        interval: 48ms;
        running: MessageTooltipOverlayState.kind != MessageTooltipKind.None;
        triggered => {
            if MessageTooltipOverlayState.lease == root.observed-lease {
                MessageTooltipOverlayState.dismiss-all();
            } else {
                root.observed-lease = MessageTooltipOverlayState.lease;
            }
        }
    }
}
