export component MessageMarkToggleAction inherits MessageActionChrome {
    in property <bool> read: false;
    accessible-label: root.read ? "Mark as unread" : "Mark as read";

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        opacity: root.read ? 0 : 1;
        source: @image-url("../../assets/icons/octicon-check-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        opacity: root.read ? 1 : 0;
        source: @image-url("../../assets/icons/octicon-unread-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    MessageMarkReadTip {
        z: 100;
        x: parent.width - self.width;
        y: parent.height - 6px;
        open: root.tip-active && !root.read;
    }

    MessageMarkUnreadTip {
        z: 100;
        x: parent.width - self.width;
        y: parent.height  - 6px; 
        open: root.tip-active && root.read;
    }
}

export component MessageDeleteAction inherits MessageActionChrome {
    danger-hover: true;
    hover-foreground: GitHubTheme.danger-fg;
    accessible-label: "Delete";

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        source: @image-url("../../assets/icons/octicon-trash-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    MessageDeleteTip {
        z: 100;
        x: parent.width - self.width;
        y: parent.height - 6px;
        open: root.tip-active;
    }
}
