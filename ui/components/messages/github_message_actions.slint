import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import {
    GitHubDeleteTooltipAnchor,
    GitHubMarkReadTooltipAnchor,
    GitHubMarkUnreadTooltipAnchor,
} from "./github_message_tooltip.slint";
import { MessageTooltipOverlayState } from "../../state/message_tooltip_overlay_state.slint";
import { I18n } from "@i18n";

// Inbox row actions must NOT share `in property <image>` or tip-label strings.
// Slint list rows alias those bindings. Each action publishes a literal label
// to the Messages factory's page-owned tooltip portal.

component MessageActionChrome inherits FocusScope {
    in property <bool> tip-enabled: true;
    in property <length> control-size: GitHubMetrics.control-medium-size;
    in property <length> glyph-size: GitHubMetrics.icon-medium;
    in property <color> foreground: GitHubTheme.fg-muted;
    in property <color> hover-foreground: root.foreground;
    in property <bool> danger-hover: false;
    out property <bool> has-hover: button-touch.has-hover;
    out property <bool> tip-active:
        root.tip-enabled
        && (button-touch.has-hover || root.keyboard-focus-visible);
    out property <color> glyph-color: button-touch.has-hover
        ? root.hover-foreground
        : root.foreground;
    private property <bool> keyboard-focus-visible: false;
    callback clicked();

    focus-on-click: false;
    width: root.control-size;
    height: root.control-size;
    accessible-role: button;

    key-pressed(event) => {
        root.keyboard-focus-visible = true;
        if event.text == Key.Return || event.text == " " {
            // Read/delete callbacks can immediately replace this list delegate.
            MessageTooltipOverlayState.dismiss-all();
            root.clicked();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
    }
    focus-lost => {
        root.keyboard-focus-visible = false;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: GitHubMetrics.radius-medium;
        background: button-touch.pressed
            ? GitHubTheme.control-transparent-active
            : (button-touch.has-hover
                ? (root.danger-hover
                    ? GitHubTheme.danger-muted
                    : GitHubTheme.control-transparent-hover)
                : transparent);
        animate background { duration: 100ms; easing: ease-out; }

        @children
    }

    button-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.keyboard-focus-visible = false;
            root.focus();
            MessageTooltipOverlayState.dismiss-all();
            root.clicked();
        }
    }
}

// Keep read and unread as separate fixed leaves. ComponentFactory list rows
// must never switch an Image source or stack state images behind opacity.
export component MessageMarkReadAction inherits MessageActionChrome {
    accessible-label: I18n.messages-mark-as-read;

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        source: @image-url("../../assets/icons/octicon-unread-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    GitHubMarkReadTooltipAnchor {
        active: root.tip-active;
    }
}

export component MessageMarkUnreadAction inherits MessageActionChrome {
    accessible-label: I18n.messages-mark-as-unread;

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        source: @image-url("../../assets/icons/octicon-read-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    GitHubMarkUnreadTooltipAnchor {
        active: root.tip-active;
    }
}

export component MessageDeleteAction inherits MessageActionChrome {
    danger-hover: true;
    hover-foreground: GitHubTheme.danger-fg;
    accessible-label: I18n.common-delete;

    Image {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        source: @image-url("../../assets/icons/octicon-trash-16.svg");
        image-fit: contain;
        colorize: root.glyph-color;
    }

    GitHubDeleteTooltipAnchor {
        active: root.tip-active;
    }
}
