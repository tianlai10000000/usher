import { FactoryTooltipKind, FactoryTooltipState } from "../../state/factory_tooltip_state.slint";
import { GitHubFixedTooltipAnchor } from "../github_fixed_tooltip_anchor.slint";

export component ShowcaseInvisibleTooltipAnchor inherits GitHubFixedTooltipAnchor {
    bounded: FactoryTooltipState.enabled;
    viewport: FactoryTooltipState.viewport;
    publish(x, y, w, h) => { FactoryTooltipState.show(FactoryTooltipKind.Invisible, x, y, w, h); }
    release(x, y) => { FactoryTooltipState.hide(FactoryTooltipKind.Invisible, x, y); }
    renew(x, y, w, h) => { FactoryTooltipState.renew(FactoryTooltipKind.Invisible, x, y, w, h); }
}

