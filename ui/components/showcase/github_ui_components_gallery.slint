import { Route } from "../../route/routeMap.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubPageHeader } from "../page/github_page_header.slint";
import { GitHubButton, GitHubToggle, GitHubTextField, GitHubSettingsNavItem, GitHubSettingsSectionMenuButton } from "../settings/github_settings_controls.slint";
import { GitHubSelectState, GitHubSelectPopup, GitHubSelectOption } from "../input/github_select.slint";
import { GitHubCompactTextField } from "../input/compact_text_field.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubCopyButton } from "../button/github_copy_button.slint";
import { GitHubLink } from "../github_link.slint";
import { GitHubMetadataLabel } from "../github_metadata_label.slint";
import { GitHubCounterLabel, GitHubCounterScheme } from "../label/github_counter_label.slint";
import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubProgressBar } from "../github_progress_bar.slint";
import { GitHubBlankslate } from "../github_blankslate.slint";
import { GitHubSegmentedControl, GitHubSegmentedControlIconOnly } from "../github_segmented_control.slint";
import { GitHubUnderlineNav, GitHubUnderlineNavItem } from "../navigation/github_underline_nav.slint";
import { GitHubActionMenu, GitHubActionListItem } from "../github_action_menu.slint";
import { GitHubFilterMenuButton, GitHubFilterMenuFrame, GitHubFilterMenuItem } from "../github_filter_menu.slint";
import { ToastManager, ToastType } from "../toast/toast_manager.slint";
import { NotificationManager, NotificationType, NotificationDelivery, CustomComponentType } from "../notify/notification.slint";
import { NotificationIcons } from "../notify/icons.slint";
import { GitHubNotificationBanner } from "../notify/actions_notify.slint";
import { DialogManager } from "../dialog/dialog_manager.slint";
import { GitHubMessageListItem, MessageLevel } from "../messages/github_message_components.slint";
import { GitHubPagination } from "../navigation/github_pagination.slint";
import { GitHubAiReviewFindingRow, GitHubAiReviewSeverityLabel } from "../ai_review/github_ai_review_components.slint";
import { GitHubAgentResponseShowcase } from "github_agent_response_showcase.slint";

component GitHubShowcaseSection inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <length> content-height;

    private property <length> section-height:
        60px + root.content-height + GitHubMetrics.size-12;

    width: 100%;
    min-height: root.section-height;
    preferred-height: root.section-height;
    max-height: root.section-height;
    background: transparent;

    Text {
        x: 0px;
        y: GitHubMetrics.size-12;
        width: parent.width;
        height: GitHubMetrics.size-24;
        text: root.title;
        font-size: GitHubMetrics.heading-small;
        font-weight: 600;
        color: GitHubTheme.fg-default;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: GitHubMetrics.size-36;
        width: parent.width;
        height: GitHubMetrics.size-20;
        text: root.description;
        font-size: GitHubMetrics.text-small;
        color: GitHubTheme.fg-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    showcase-content := Rectangle {
        x: 0px;
        y: 60px;
        width: parent.width;
        height: root.content-height;
        background: transparent;
        clip: false;
        @children
    }
}

component GitHubShowcaseLabel inherits Text {
    in property <string> label;
    text: root.label;
    font-size: GitHubMetrics.text-small;
    font-weight: 600;
    color: GitHubTheme.fg-muted;
    vertical-alignment: center;
}

component GitHubShowcaseSampleSurface inherits Rectangle {
    border-radius: GitHubMetrics.radius-medium;
    border-width: GitHubMetrics.border-thin;
    border-color: GitHubTheme.border-default;
    background: GitHubTheme.canvas-subtle;
    clip: false;
    @children
}

component GitHubShowcaseStateBadge inherits Rectangle {
    in property <string> text;
    in property <string> kind: "neutral";

    label-measure := Text {
        visible: false;
        text: root.text;
        font-size: GitHubMetrics.text-small;
        font-weight: 600;
    }

    width: label-measure.preferred-width + GitHubMetrics.size-16;
    height: GitHubMetrics.size-24;
    border-radius: GitHubMetrics.radius-medium;
    border-width: GitHubMetrics.border-thin;
    border-color: root.kind == "success"
        ? GitHubTheme.success-emphasis
        : root.kind == "danger"
            ? GitHubTheme.danger-emphasis
            : GitHubTheme.border-default;
    background: root.kind == "success"
        ? GitHubTheme.success-muted
        : root.kind == "danger"
            ? GitHubTheme.danger-muted
            : GitHubTheme.control-muted-rest;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: GitHubMetrics.text-small;
        font-weight: 600;
        color: root.kind == "success"
            ? GitHubTheme.success-fg
            : root.kind == "danger"
                ? GitHubTheme.danger-fg
                : GitHubTheme.fg-default;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

global GitHubSelectDemoState {
    in-out property <int> value: 1;
}

export component GitHubSelectDemoOverlay inherits GitHubSelectPopup {
    owner: "showcase";
    option-count: 3;
    selected(index) => {
        GitHubSelectDemoState.value = index;
        GitHubSelectState.open = false;
    }
    for label[index] in ["System default", "English", "Chinese (Simplified)"]: GitHubSelectOption {
        x: 0px;
        y: index * GitHubMetrics.size-32;
        width: root.option-width;
        text: label;
        selected: GitHubSelectDemoState.value == index;
        active: GitHubSelectState.open && GitHubSelectState.active-index == index;
        activated => {
            GitHubSelectDemoState.value = index;
            GitHubSelectState.open = false;
        }
    }
}

export component GitHubUiComponentsGallery inherits Rectangle {
    callback navigate(Route);
    callback open-artifact-preview-fixture(string);

    private property <bool> toggle-checked: true;
    private property <int> selected-segment: 0;
    private property <int> selected-icon-segment: 1;
    private property <int> selected-tab: 0;
    private property <int> selected-action: 0;
    private property <string> field-text: "";
    private property <string> compact-field-text: "";
    private property <float> progress-value: 0.62;
    private property <bool> blankslate-loading: false;
    private property <bool> action-menu-open: false;
    private property <string> action-menu-align: "start";
    private property <string> action-menu-side: "bottom";
    private property <string> filter-menu: "";
    private property <string> filter-status: "all";
    private property <string> filter-owner: "any";
    private property <string> filter-sort: "newest";
    private property <int> select-value: GitHubSelectDemoState.value;

    function show-toast-example(action: int) {
        if action == 0 {
            ToastManager.info({ message: "Informational Toast", position: "bottom" });
        } else if action == 1 {
            ToastManager.success({ message: "Operation completed", position: "bottom" });
        } else if action == 2 {
            ToastManager.error({ message: "Operation failed", position: "bottom" });
        } else if action == 3 {
            ToastManager.loading({ message: "Loading with overlay", overlay: true, close-on-click: true });
        } else if action == 4 {
            ToastManager.success({ message: "Top position", position: "top" });
        } else if action == 5 {
            ToastManager.info({ message: "Middle position", position: "middle" });
        } else if action == 6 {
            ToastManager.error({ message: "Bottom position", position: "bottom" });
        } else if action == 7 {
            ToastManager.success({ message: "Closes after five seconds", duration: 5000 });
        } else {
            ToastManager.show(ToastType.Success, {
                message: "Click the overlay to dismiss",
                overlay: true,
                close-on-click: true,
                width: "360px"
            });
        }
    }

    function show-notification-example(action: int) {
        if action == 0 {
            NotificationManager.info({ title: "Information", message: "Review the current settings." });
        } else if action == 1 {
            NotificationManager.success({ title: "Saved", message: "Configuration was saved." });
        } else if action == 2 {
            NotificationManager.warn({ title: "Attention", message: "A follow-up action is required." });
        } else if action == 3 {
            NotificationManager.error({ title: "Failed", message: "The request could not be completed." });
        } else if action == 4 {
            NotificationManager.show(NotificationType.Info, {
                title: "Update available",
                message: "Choose an action to exercise Banner callbacks.",
                component: CustomComponentType.ActionsNotify,
                actions: ["Later", "Install"],
                tag: "ui-components"
            });
        } else if action == 5 {
            NotificationManager.remove-all();
        } else if action == 6 {
            NotificationManager.clear();
        } else {
            // Permanent stack exercises the in-card Dismiss all footer (queue >= 2).
            NotificationManager.info({
                title: "Webhook received",
                message: "A webhook event is ready for review.",
                duration: 0
            });
            NotificationManager.success({
                title: "Saved",
                message: "Configuration was saved.",
                duration: 0
            });
            NotificationManager.warn({
                title: "Attention",
                message: "A follow-up action is required.",
                duration: 0
            });
        }
    }

    function send-message-example(action: int) {
        if action == 0 {
            NotificationManager.info({
                title: "General message", message: "A general application message was received.",
                source: "Usher", category: "general"
            });
        } else if action == 1 {
            NotificationManager.info({
                title: "Webhook received", message: "A webhook event is ready for review.",
                source: "Webhook", category: "webhook"
            });
        } else if action == 2 {
            NotificationManager.info({
                title: "Update available", message: "Usher 1.0.0 is ready to install.",
                source: "Updater", category: "software_update"
            });
        } else if action == 3 {
            NotificationManager.success({
                title: "CD workflow completed", message: "The release passed verification and is live.",
                source: "CD", category: "cd_workflow"
            });
        } else if action == 4 {
            NotificationManager.warn({
                title: "Action recommended", message: "Review the deployment configuration before continuing.",
                source: "Usher", category: "general"
            });
        } else if action == 5 {
            NotificationManager.error({
                title: "Critical failure", message: "This test always requests a native system notification.",
                source: "Usher", category: "general",
                native-delivery: NotificationDelivery.Always
            });
        } else {
            NotificationManager.info({
                title: "In-app only", message: "This message is stored in Inbox without a system notification.",
                source: "Usher", category: "general",
                native-delivery: NotificationDelivery.Never
            });
        }
    }

    function show-dialog-example(action: int) {
        if action == 0 {
            DialogManager.show({
                id: "gallery-confirm",
                title: "Confirm change",
                content: "This modal dialog uses fixed dimensions, a backdrop, one secondary action, and one primary action.",
                actions: ["Cancel"],
                default-action: "Confirm",
                overlay: true,
                modal: true,
                width: "440px",
                height: "280px"
            });
        } else if action == 1 {
            DialogManager.show({
                id: "gallery-non-modal",
                title: "Non-modal example",
                content: "Press Escape, use the close button, or click the backdrop to dismiss this percentage-sized dialog.",
                actions: [],
                default-action: "Done",
                overlay: true,
                modal: false,
                width: "52%",
                height: "42%"
            });
        } else {
            DialogManager.show({
                id: "gallery-no-backdrop",
                title: "Dialog without backdrop",
                content: "This variant keeps the underlying page visible and exercises the overlay property.",
                actions: ["Close"],
                default-action: "",
                overlay: false,
                modal: false,
                width: "400px",
                height: "240px"
            });
        }
    }

    height: gallery-content.preferred-height;
    background: transparent;

    gallery-content := VerticalLayout {
        width: parent.width;
        spacing: 0px;
        alignment: start;

        GitHubPageHeader {
            title: "UI Components";
            description: "Interactive playground and visual contract for application-owned GitHub UI components.";
            leading-icon: @image-url("../../assets/icons/octicon-stack-16.svg");
            large-title: true;
        }

        GitHubShowcaseSection {
            title: "Buttons";
            description: "GitHubButton properties: default, primary, danger, selected, disabled, and busy.";
            content-height: 144px;

            GitHubShowcaseLabel { x: 0px; y: 0px; width: 120px; height: 20px; label: "Intent"; }
            HorizontalLayout {
                x: 0px;
                y: 28px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for button-state in [
                    { label: "Default", primary: false, danger: false, selected: false },
                    { label: "Primary", primary: true, danger: false, selected: false },
                    { label: "Danger", primary: false, danger: true, selected: false },
                    { label: "Selected", primary: false, danger: false, selected: true }
                ]: GitHubButton {
                    text: button-state.label;
                    primary: button-state.primary;
                    danger: button-state.danger;
                    selected: button-state.selected;
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 76px; width: 120px; height: 20px; label: "Availability"; }
            HorizontalLayout {
                x: 0px;
                y: 104px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for button-state in [
                    { label: "Disabled", disabled: true, busy: false, primary: false },
                    { label: "Loading", disabled: false, busy: true, primary: true }
                ]: GitHubButton {
                    text: button-state.label;
                    disabled: button-state.disabled;
                    busy: button-state.busy;
                    primary: button-state.primary;
                }
                GitHubButton {
                    text: "Try action";
                    clicked => {
                        ToastManager.success({
                            message: "Button activation received.",
                            position: "bottom"
                        });
                    }
                }
                GitHubButton {
                    text: "Load more";
                    leading-icon: @image-url("../../assets/icons/octicon-arrow-up-16.svg");
                    label-font-size: GitHubMetrics.text-small;
                    height: GitHubMetrics.control-small-size;
                }
            }
        }

        GitHubShowcaseSection {
            title: "Icon buttons, links, and copy";
            description: "Visible/invisible icon surfaces, Copilot review states, semantic danger, disabled state, links, and copy confirmation.";
            content-height: 142px;

            GitHubShowcaseLabel { x: 0px; y: 0px; width: 150px; height: 20px; label: "IconButton"; }
            HorizontalLayout {
                x: 0px;
                y: 28px;
                width: parent.width;
                height: 36px;
                spacing: GitHubMetrics.size-12;
                alignment: start;

                for button-state in [
                    { icon: @image-url("../../assets/icons/octicon-plus-16.svg"), label: "Invisible icon button", invisible: true, danger: false, loading: false, enabled: true, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-sync-16.svg"), label: "Bordered icon button", invisible: false, danger: false, loading: false, enabled: true, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-trash-16.svg"), label: "Danger icon button", invisible: false, danger: true, loading: false, enabled: true, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-sync-16.svg"), label: "Loading", invisible: false, danger: false, loading: true, enabled: true, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-plus-16.svg"), label: "Disabled", invisible: false, danger: false, loading: false, enabled: false, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-copilot-16.svg"), label: "Review this pull request with AI", invisible: true, danger: false, loading: false, enabled: true, selected: false },
                    { icon: @image-url("../../assets/icons/octicon-copilot-16.svg"), label: "Close AI code review", invisible: true, danger: false, loading: false, enabled: true, selected: true },
                    { icon: @image-url("../../assets/icons/octicon-copilot-16.svg"), label: "AI code review is running", invisible: true, danger: false, loading: true, enabled: true, selected: false }
                ]: GitHubIconButton {
                    icon: button-state.icon;
                    tooltip-text: button-state.label;
                    invisible: button-state.invisible;
                    danger: button-state.danger;
                    loading: button-state.loading;
                    button-enabled: button-state.enabled;
                    selected: button-state.selected;
                }
                GitHubCopyButton {
                    tooltip-above: false;
                    copy-requested => { true }
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 82px; width: 150px; height: 20px; label: "Link"; }
            HorizontalLayout {
                x: 0px;
                y: 110px;
                width: parent.width;
                height: 24px;
                spacing: GitHubMetrics.size-20;
                alignment: start;

                for link-state in [
                    { label: "Standalone link", inline: false, muted: false, enabled: true },
                    { label: "Inline link", inline: true, muted: false, enabled: true },
                    { label: "Muted link", inline: false, muted: true, enabled: true },
                    { label: "Disabled link", inline: false, muted: false, enabled: false }
                ]: GitHubLink {
                    text: link-state.label;
                    inline: link-state.inline;
                    muted: link-state.muted;
                    link-enabled: link-state.enabled;
                }
            }
        }

        GitHubShowcaseSection {
            title: "Labels and counters";
            description: "Metadata labels and Primer CounterLabel schemes, limits, and zero-count behavior.";
            content-height: 252px;

            GitHubShowcaseLabel { x: 0px; y: 0px; width: 180px; height: 20px; label: "Neutral metadata"; }
            HorizontalLayout {
                x: 0px;
                y: 28px;
                width: parent.width;
                height: 24px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for label-text in ["GitHub", "ID 1130209340", "production"]: GitHubMetadataLabel {
                    text: label-text;
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 68px; width: 180px; height: 20px; label: "Bounded metadata"; }
            GitHubMetadataLabel {
                x: 0px;
                y: 96px;
                max-label-width: 168px;
                text: "Repository identifier 1130209340";
            }

            GitHubShowcaseLabel { x: 0px; y: 132px; width: 180px; height: 20px; label: "Counter schemes"; }
            HorizontalLayout {
                x: 0px;
                y: 160px;
                width: parent.width;
                height: 20px;
                spacing: GitHubMetrics.size-20;
                alignment: start;

                HorizontalLayout {
                    spacing: GitHubMetrics.size-6;
                    Text { text: "Issues"; color: GitHubTheme.fg-default; vertical-alignment: center; }
                    GitHubCounterLabel { count: 12; }
                }
                HorizontalLayout {
                    spacing: GitHubMetrics.size-6;
                    Text { text: "Pull requests"; color: GitHubTheme.fg-default; vertical-alignment: center; }
                    GitHubCounterLabel { count: 7; scheme: GitHubCounterScheme.Primary; }
                }
                HorizontalLayout {
                    spacing: GitHubMetrics.size-6;
                    Text { text: "Checks"; color: GitHubTheme.fg-default; vertical-alignment: center; }
                    GitHubCounterLabel { count: 3; scheme: GitHubCounterScheme.Secondary; }
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 196px; width: 180px; height: 20px; label: "Limit and zero"; }
            HorizontalLayout {
                x: 0px;
                y: 224px;
                width: parent.width;
                height: 20px;
                spacing: GitHubMetrics.size-20;
                alignment: start;

                HorizontalLayout {
                    spacing: GitHubMetrics.size-6;
                    Text { text: "Notifications"; color: GitHubTheme.fg-default; vertical-alignment: center; }
                    GitHubCounterLabel { count: 128; limit: 99; scheme: GitHubCounterScheme.Primary; }
                }
                HorizontalLayout {
                    spacing: GitHubMetrics.size-6;
                    Text { text: "Zero hidden"; color: GitHubTheme.fg-muted; vertical-alignment: center; }
                    GitHubCounterLabel { count: 0; hide-if-zero: true; }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Form controls";
            description: "Text input, compact input, secret/loading/error states, and Toggle interaction.";
            content-height: 268px;

            GitHubShowcaseSampleSurface {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 260px;

                GitHubTextField {
                    x: GitHubMetrics.size-16;
                    y: GitHubMetrics.size-16;
                    width: max(180px, (parent.width - GitHubMetrics.size-48) / 2);
                    label: "Repository";
                    placeholder: "owner/repository";
                    caption: "Editable default state";
                    text <=> root.field-text;
                }

                GitHubTextField {
                    x: parent.width / 2 + GitHubMetrics.size-8;
                    y: GitHubMetrics.size-16;
                    width: max(180px, parent.width - self.x - GitHubMetrics.size-16);
                    label: "Token";
                    placeholder: "Required value";
                    secret: true;
                    required: true;
                    validation-error: true;
                    validation-message: "A token is required.";
                }

                GitHubTextField {
                    x: GitHubMetrics.size-16;
                    y: 112px;
                    width: max(180px, (parent.width - GitHubMetrics.size-48) / 2);
                    label: "Loading field";
                    text: "Checking repository";
                    loading: true;
                }

                GitHubCompactTextField {
                    x: parent.width / 2 + GitHubMetrics.size-8;
                    y: 138px;
                    width: max(120px, parent.width - self.x - GitHubMetrics.size-80);
                    placeholder: "Compact field";
                    text <=> root.compact-field-text;
                }

                GitHubToggle {
                    x: parent.width - GitHubMetrics.size-64;
                    y: 142px;
                    checked: root.toggle-checked;
                    toggled(value) => { root.toggle-checked = value; }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Select";
            description: "";
            content-height: 120px;

            select-trigger := GitHubSettingsSectionMenuButton {
                x: 0px;
                y: 0px;
                width: min(320px, parent.width / 2 - GitHubMetrics.size-8);
                text: root.select-value == 0 ? "System default"
                    : (root.select-value == 1 ? "English" : "Chinese (Simplified)");
                open: GitHubSelectState.open && GitHubSelectState.owner == "showcase";
                restore-focus-on-close: GitHubSelectState.restore-focus;
                changed absolute-position => {
                    if self.open { GitHubSelectState.close(false); }
                }
                changed width => {
                    if self.open { GitHubSelectState.close(false); }
                }
                clicked => {
                  if self.open { GitHubSelectState.close(true); } else {
                    GitHubSelectState.show("showcase", "" + root.select-value, root.select-value,
                        select-trigger.absolute-position.x, select-trigger.absolute-position.y,
                        select-trigger.width, select-trigger.height);
                  }
                }
            }
            select-disabled := GitHubSettingsSectionMenuButton {
                x: parent.width / 2 + GitHubMetrics.size-8;
                y: 0px;
                width: min(320px, parent.width / 2 - GitHubMetrics.size-8);
                text: "Disabled";
                enabled: false;
            }
            select-name := GitHubTextField {
                x: 0px;
                y: 56px;
                width: min(320px, parent.width);
                label: "Name";
                placeholder: "Project name";
            }
        }

        GitHubShowcaseSection {
            title: "Selection and navigation";
            description: "SegmentedControl, UnderlineNav, SettingsNavItem, and ActionList selected/disabled/danger states.";
            content-height: 384px;

            GitHubShowcaseLabel { x: 0px; y: 0px; width: 200px; height: 20px; label: "SegmentedControl - clone method"; }
            GitHubSegmentedControl {
                x: 0px;
                y: 28px;
                group-label: "Clone method";
                items: [
                    { label: "HTTPS", count: -1, count-suffix-offset: 0, enabled: true },
                    { label: "SSH", count: -1, count-suffix-offset: 0, enabled: true },
                    { label: "GitHub CLI", count: -1, count-suffix-offset: 0, enabled: true },
                ];
                selected-index: root.selected-segment;
                selection-changed(index) => { root.selected-segment = index; }
            }

            GitHubShowcaseLabel { x: 0px; y: 76px; width: 160px; height: 20px; label: "Disabled state"; }
            GitHubSegmentedControl {
                x: 0px;
                y: 100px;
                group-label: "Disabled segmented control state";
                items: [
                    { label: "Available", count: -1, count-suffix-offset: 0, enabled: true },
                    { label: "Disabled", count: -1, count-suffix-offset: 0, enabled: false },
                ];
                selected-index: 0;
            }

            GitHubShowcaseLabel { x: 0px; y: 144px; width: 200px; height: 20px; label: "Icon-only with motion"; }
            GitHubSegmentedControlIconOnly {
                x: 0px;
                y: 168px;
                items: [
                    {
                        icon: @image-url("../../assets/icons/octicon-list-unordered-16.svg"),
                        label: "List view",
                        enabled: true,
                    },
                    {
                        icon: @image-url("../../assets/icons/octicon-table-16.svg"),
                        label: "Grid view",
                        enabled: true,
                    },
                ];
                selected-index: root.selected-icon-segment;
                group-label: "Project view";
                selection-changed(index) => { root.selected-icon-segment = index; }
            }

            GitHubShowcaseLabel { x: 0px; y: 212px; width: 160px; height: 20px; label: "UnderlineNav"; }
            GitHubUnderlineNav {
                x: 0px;
                y: 240px;
                width: parent.width;
                height: 48px;
                group-label: "Underline navigation examples";

                GitHubUnderlineNavItem {
                    label: "Overview";
                    selected: root.selected-tab == 0;
                    clicked => { root.selected-tab = 0; }
                }
                GitHubUnderlineNavItem {
                    label: "Activity";
                    icon: @image-url("../../assets/icons/octicon-comment-discussion-16.svg");
                    selected: root.selected-tab == 1;
                    clicked => { root.selected-tab = 1; }
                }
                GitHubUnderlineNavItem { label: "Disabled"; item-enabled: false; }
            }

            GitHubShowcaseSampleSurface {
                x: 0px;
                y: 304px;
                width: parent.width;
                height: 72px;

                GitHubSettingsNavItem {
                    x: GitHubMetrics.size-8;
                    y: GitHubMetrics.size-8;
                    width: parent.width / 3 - GitHubMetrics.size-12;
                    text: "Selected navigation";
                    selected: true;
                }
                GitHubActionListItem {
                    x: parent.width / 3 + GitHubMetrics.size-4;
                    y: GitHubMetrics.size-8;
                    width: parent.width / 3 - GitHubMetrics.size-8;
                    text: "Action list item";
                    description: "With supporting text";
                    selected: root.selected-action == 0;
                    activated => { root.selected-action = 0; }
                }
                GitHubActionListItem {
                    x: parent.width * 2 / 3;
                    y: GitHubMetrics.size-8;
                    width: parent.width / 3 - GitHubMetrics.size-8;
                    text: "Delete item";
                    icon: @image-url("../../assets/icons/octicon-trash-16.svg");
                    danger: true;
                }
            }
        }

        GitHubShowcaseSection {
            title: "ActionMenu - borderless ActionList";
            description: "Borderless action rows, AnchoredOverlay placement, alignment, side selection, Escape, and caller-owned outside-click dismiss.";
            content-height: root.action-menu-open ? 204px : 48px;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                z: 2;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for menu-action in [
                    { label: "Start / below", align: "start", side: "bottom", close: false },
                    { label: "End / below", align: "end", side: "bottom", close: false },
                    { label: "Start / above", align: "start", side: "top", close: false },
                    { label: "Close", align: "start", side: "bottom", close: true }
                ]: GitHubButton {
                    text: menu-action.label;
                    selected: !menu-action.close
                        && root.action-menu-open
                        && root.action-menu-align == menu-action.align
                        && root.action-menu-side == menu-action.side;
                    disabled: menu-action.close && !root.action-menu-open;
                    clicked => {
                        if menu-action.close {
                            root.action-menu-open = false;
                        } else {
                            root.action-menu-align = menu-action.align;
                            root.action-menu-side = menu-action.side;
                            root.action-menu-open = true;
                        }
                    }
                }
            }

            // Demonstrate the caller-owned outside-click layer ActionMenu
            // expects under the menu surface.
            if root.action-menu-open: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                z: 0;
                background: transparent;
                TouchArea {
                    mouse-cursor: default;
                    clicked => { root.action-menu-open = false; }
                }
            }

            GitHubActionMenu {
                z: 1;
                open: root.action-menu-open;
                viewport-x: 0px;
                viewport-y: 0px;
                viewport-width: parent.width;
                viewport-height: parent.height;
                anchor-x: root.action-menu-align == "end"
                    ? min(420px, parent.width - 120px)
                    : 0px;
                anchor-y: root.action-menu-side == "top" ? 190px : 32px;
                anchor-width: 120px;
                anchor-height: 32px;
                menu-width: 280px;
                content-height: 128px;
                align: root.action-menu-align;
                side: root.action-menu-side;
                dismiss-requested => { root.action-menu-open = false; }

                VerticalLayout {
                    x: GitHubMetrics.size-8;
                    y: GitHubMetrics.size-8;
                    width: parent.width - GitHubMetrics.size-16;
                    spacing: 0px;
                    alignment: start;

                    for menu-item in [
                        { label: "Selected option", description: "Current ActionList state", selected: true, enabled: true, danger: false, icon: @image-url("") },
                        { label: "Disabled option", description: "", selected: false, enabled: false, danger: false, icon: @image-url("") },
                        { label: "Danger option", description: "", selected: false, enabled: true, danger: true, icon: @image-url("../../assets/icons/octicon-trash-16.svg") }
                    ]: GitHubActionListItem {
                        text: menu-item.label;
                        description: menu-item.description;
                        selected: menu-item.selected;
                        item-enabled: menu-item.enabled;
                        danger: menu-item.danger;
                        icon: menu-item.icon;
                        activated => { root.action-menu-open = false; }
                    }
                }
            }
        }

        GitHubShowcaseSection {
            title: "SelectMenu - bordered single select";
            description: "GitHub filter rows with dividers, a default-foreground Check, semibold selection, title, close control, and dismissal behavior.";
            content-height: root.filter-menu == "" ? 48px : 216px;

            status-filter-button := GitHubFilterMenuButton {
                x: 0px;
                y: 0px;
                z: 2;
                label: "Status";
                menu-open: root.filter-menu == "status";
                selected: root.filter-menu == "status"
                    || root.filter-status != "all";
                clicked => {
                    root.filter-menu = root.filter-menu == "status"
                        ? ""
                        : "status";
                }
            }
            owner-filter-button := GitHubFilterMenuButton {
                x: status-filter-button.width;
                y: 0px;
                z: 2;
                label: "Owner";
                menu-open: root.filter-menu == "owner";
                selected: root.filter-menu == "owner"
                    || root.filter-owner != "any";
                clicked => {
                    root.filter-menu = root.filter-menu == "owner"
                        ? ""
                        : "owner";
                }
            }
            sort-filter-button := GitHubFilterMenuButton {
                x: owner-filter-button.x + owner-filter-button.width;
                y: 0px;
                z: 2;
                label: "Sort";
                menu-open: root.filter-menu == "sort";
                selected: root.filter-menu == "sort"
                    || root.filter-sort != "newest";
                clicked => {
                    root.filter-menu = root.filter-menu == "sort"
                        ? ""
                        : "sort";
                }
            }

            // Under-chrome dismiss so the first click on another filter switches
            // menus instead of only closing (same stacking as Workflow PR list).
            if root.filter-menu != "": Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                z: 0;
                background: transparent;
                TouchArea {
                    mouse-cursor: default;
                    clicked => { root.filter-menu = ""; }
                }
            }

            if root.filter-menu != "": GitHubActionMenu {
                z: 1;
                open: true;
                viewport-x: 0px;
                viewport-y: 0px;
                viewport-width: parent.width;
                viewport-height: parent.height;
                anchor-x: root.filter-menu == "status"
                    ? status-filter-button.x
                    : (root.filter-menu == "owner"
                        ? owner-filter-button.x
                        : sort-filter-button.x);
                anchor-y: 0px;
                anchor-width: root.filter-menu == "status"
                    ? status-filter-button.width
                    : (root.filter-menu == "owner"
                        ? owner-filter-button.width
                        : sort-filter-button.width);
                anchor-height: GitHubMetrics.size-32;
                menu-width: 200px;
                content-height: root.filter-menu == "owner" ? 128px : 160px;
                align: "start";
                dismiss-requested => { root.filter-menu = ""; }

                GitHubFilterMenuFrame {
                    width: parent.width;
                    title: root.filter-menu == "status"
                        ? "Filter by status"
                        : (root.filter-menu == "owner" ? "Filter by owner" : "Sort by");
                    content-height: root.filter-menu == "owner" ? 96px : 128px;
                    close => { root.filter-menu = ""; }

                    if root.filter-menu == "status": VerticalLayout {
                        for option in [
                            { label: "All statuses", value: "all" },
                            { label: "Active", value: "active" },
                            { label: "Paused", value: "paused" },
                            { label: "Archived", value: "archived" }
                        ]: GitHubFilterMenuItem {
                            text: option.label;
                            value: option.value;
                            selected-value: root.filter-status;
                            chosen(value) => { root.filter-status = value; root.filter-menu = ""; }
                        }
                    }
                    if root.filter-menu == "owner": VerticalLayout {
                        for option in [
                            { label: "Anyone", value: "any" },
                            { label: "Owned by me", value: "me" },
                            { label: "Unassigned", value: "none" }
                        ]: GitHubFilterMenuItem {
                            text: option.label;
                            value: option.value;
                            selected-value: root.filter-owner;
                            chosen(value) => { root.filter-owner = value; root.filter-menu = ""; }
                        }
                    }
                    if root.filter-menu == "sort": VerticalLayout {
                        for option in [
                            { label: "Newest", value: "newest" },
                            { label: "Oldest", value: "oldest" },
                            { label: "Recently updated", value: "updated-desc" },
                            { label: "Least recently updated", value: "updated-asc" }
                        ]: GitHubFilterMenuItem {
                            text: option.label;
                            value: option.value;
                            selected-value: root.filter-sort;
                            chosen(value) => { root.filter-sort = value; root.filter-menu = ""; }
                        }
                    }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Toast";
            description: "Type, position, duration, overlay, close-on-click, and explicit show() variants.";
            content-height: 196px;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Info", id: 0, primary: false, danger: false },
                    { label: "Success", id: 1, primary: true, danger: false },
                    { label: "Error", id: 2, primary: false, danger: true },
                    { label: "Loading", id: 3, primary: false, danger: false }
                ]: GitHubButton {
                    text: action.label;
                    primary: action.primary;
                    danger: action.danger;
                    clicked => { root.show-toast-example(action.id); }
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 56px; width: 160px; height: 20px; label: "Position"; }
            HorizontalLayout {
                x: 0px;
                y: 84px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Top", id: 4 },
                    { label: "Middle", id: 5 },
                    { label: "Bottom", id: 6 }
                ]: GitHubButton {
                    text: action.label;
                    clicked => { root.show-toast-example(action.id); }
                }
            }

            GitHubShowcaseLabel { x: 0px; y: 140px; width: 160px; height: 20px; label: "Behavior"; }
            HorizontalLayout {
                x: 0px;
                y: 164px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "5 seconds", id: 7 },
                    { label: "Overlay + dismiss", id: 8 }
                ]: GitHubButton {
                    text: action.label;
                    clicked => { root.show-toast-example(action.id); }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Notification";
            description: "Action Banner plus an honest capped-queue footer whose batch actions stay in an overflow menu.";
            content-height: 320px;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Info", id: 0, primary: false, danger: false },
                    { label: "Success", id: 1, primary: true, danger: false },
                    { label: "Warning", id: 2, primary: false, danger: false },
                    { label: "Error", id: 3, primary: false, danger: true }
                ]: GitHubButton {
                    text: action.label;
                    primary: action.primary;
                    danger: action.danger;
                    clicked => { root.show-notification-example(action.id); }
                }
            }

            HorizontalLayout {
                x: 0px;
                y: 48px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Action Banner", id: 4, danger: false },
                    { label: "Queue stack + footer", id: 7, danger: false },
                    { label: "Remove all", id: 5, danger: false },
                    { label: "Clear queue", id: 6, danger: true }
                ]: GitHubButton {
                    text: action.label;
                    danger: action.danger;
                    clicked => { root.show-notification-example(action.id); }
                }
            }

            GitHubShowcaseLabel {
                x: 0px;
                y: 96px;
                width: parent.width;
                height: 20px;
                label: "Action Banner + overflow footer (3 shown · 9 more)";
            }

            GitHubShowcaseSampleSurface {
                x: 0px;
                y: 124px;
                width: min(400px, parent.width);
                height: 196px;

                GitHubNotificationBanner {
                    x: GitHubMetrics.size-12;
                    y: GitHubMetrics.size-12;
                    width: parent.width - GitHubMetrics.size-24;
                    title: "Attention";
                    message: "A follow-up action is required.";
                    icon: NotificationIcons.warning;
                    notification-type: NotificationType.Warning;
                    actions: ["Later", "Install"];
                    queue-count: 3;
                    total-count: 12;
                    // Sample surface is not the window; leave overlay viewport at
                    // the Banner default so the overflow menu clamps locally.
                    view-all-clicked => { }
                    dismiss-all-clicked => { }
                    close-clicked => { }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Message center";
            description: "Exercise the real Banner, durable Inbox, unread count, category, and native-delivery pipeline.";
            content-height: 96px;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "General", id: 0, primary: false },
                    { label: "Webhook", id: 1, primary: false },
                    { label: "Software update", id: 2, primary: false },
                    { label: "CD success", id: 3, primary: true }
                ]: GitHubButton {
                    text: action.label;
                    primary: action.primary;
                    clicked => { root.send-message-example(action.id); }
                }
            }

            HorizontalLayout {
                x: 0px;
                y: 56px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Warning", id: 4, danger: false },
                    { label: "Critical + OS", id: 5, danger: true },
                    { label: "In-app only", id: 6, danger: false }
                ]: GitHubButton {
                    text: action.label;
                    danger: action.danger;
                    clicked => { root.send-message-example(action.id); }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Dialog";
            description: "Fixed/percentage sizing, modal/non-modal behavior, backdrop, and action combinations.";
            content-height: 40px;

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                spacing: GitHubMetrics.size-8;
                alignment: start;

                for action in [
                    { label: "Confirmation", id: 0, primary: true },
                    { label: "Non-modal", id: 1, primary: false },
                    { label: "No backdrop", id: 2, primary: false }
                ]: GitHubButton {
                    text: action.label;
                    primary: action.primary;
                    clicked => { root.show-dialog-example(action.id); }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Loading and empty states";
            description: "Spinner sizes, determinate/indeterminate progress, and bordered/loading/error Blankslate variants.";
            content-height: loading-empty-sample.y + loading-empty-sample.height + GitHubMetrics.size-16;

            GitHubShowcaseLabel { x: 0px; y: 0px; width: 160px; height: 20px; label: "Spinner"; }
            HorizontalLayout {
                x: 0px;
                y: 28px;
                width: 180px;
                height: 32px;
                spacing: GitHubMetrics.size-16;
                alignment: start;
                for spinner-state in [
                    { size: 16px, foreground: GitHubTheme.fg-muted, spinning: true },
                    { size: 24px, foreground: GitHubTheme.fg-muted, spinning: true },
                    { size: 32px, foreground: GitHubTheme.accent-fg, spinning: true },
                    { size: 24px, foreground: GitHubTheme.fg-muted, spinning: false }
                ]: GitHubSpinner {
                    spinner-size: spinner-state.size;
                    foreground: spinner-state.foreground;
                    spinning: spinner-state.spinning;
                }
            }

            GitHubButton {
                x: min(224px, parent.width - self.width);
                y: 28px;
                text: root.blankslate-loading ? "Show error state" : "Show loading state";
                clicked => { root.blankslate-loading = !root.blankslate-loading; }
            }

            GitHubShowcaseLabel { x: 0px; y: 76px; width: 160px; height: 20px; label: "Progress"; }
            GitHubProgressBar {
                x: 0px;
                y: 104px;
                width: min(360px, parent.width / 2 - GitHubMetrics.size-8);
                progress: root.progress-value;
                status-label: "62 percent complete";
            }
            GitHubProgressBar {
                x: min(384px, parent.width / 2 + GitHubMetrics.size-8);
                y: 104px;
                width: max(160px, parent.width - self.x);
                indeterminate: true;
                status-label: "Loading progress";
            }

            loading-empty-sample := GitHubShowcaseSampleSurface {
                x: 0px;
                y: 144px;
                width: parent.width;
                height: max(
                    228px,
                    max(no-results-blankslate.preferred-height, load-error-blankslate.preferred-height)
                        + GitHubMetrics.size-16
                );

                no-results-blankslate := GitHubBlankslate {
                    x: GitHubMetrics.size-8;
                    y: GitHubMetrics.size-8;
                    width: max(240px, parent.width / 2 - GitHubMetrics.size-12);
                    heading: "No results";
                    description: "Default bordered empty state with primary and secondary actions.";
                    icon: @image-url("../../assets/icons/octicon-search-16.svg");
                    primary-label: "Create item";
                    secondary-label: "Reset filters";
                    bordered: true;
                    narrow: true;
                }

                load-error-blankslate := GitHubBlankslate {
                    x: parent.width / 2 + GitHubMetrics.size-4;
                    y: GitHubMetrics.size-8;
                    width: max(240px, parent.width / 2 - GitHubMetrics.size-12);
                    heading: "Unable to load";
                    description: root.blankslate-loading
                        ? "Loading preserves the empty-state geometry."
                        : "Error and loading properties share the same stable layout.";
                    icon: @image-url("../../assets/icons/octicon-alert-16.svg");
                    primary-label: root.blankslate-loading ? "" : "Retry";
                    bordered: true;
                    narrow: true;
                    loading: root.blankslate-loading;
                    error: !root.blankslate-loading;
                }
            }
        }

        GitHubShowcaseSection {
            title: "Notification inbox rows";
            description: "GitHub Inbox unread hierarchy: canvas-subtle fill, accent unread disc, bold vs muted title.";
            content-height: 224px;

            GitHubShowcaseSampleSurface {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 168px;
                clip: true;

                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;

                    GitHubMessageListItem {
                        framed: true;
                        first-row: true;
                        item: {
                            id: "gallery-unread",
                            title: "Pull request checks completed",
                            body: "All required checks passed for the release branch.",
                            source: "Pull requests",
                            category: "cd_workflow",
                            category-label: "CD workflow",
                            created-at: "Just now",
                            level: MessageLevel.Success,
                            read: false,
                            target: ""
                        };
                    }
                    GitHubMessageListItem {
                        framed: true;
                        last-row: true;
                        item: {
                            id: "gallery-read",
                            title: "Network connection restored",
                            body: "Remote repository operations are available again.",
                            source: "Network",
                            category: "general",
                            category-label: "General",
                            created-at: "10 minutes ago",
                            level: MessageLevel.Info,
                            read: true,
                            target: ""
                        };
                    }
                }
            }

            GitHubPagination {
                y: 184px;
                width: parent.width;
                current-page: 1;
                page-count: 4;
                pages: [1, 2, 3, 4];
                page-selected(number) => { self.current-page = number; }
            }
        }

        GitHubShowcaseSection {
            title: "AI review findings";
            description: "Copilot-style severity labels and flat actionable rows that navigate to a changed line.";
            content-height: 328px;

            GitHubShowcaseSampleSurface {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 320px;
                clip: true;

                VerticalLayout {
