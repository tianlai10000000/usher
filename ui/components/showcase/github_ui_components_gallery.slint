                        spacing: GitHubMetrics.size-8;
                        alignment: start;
                        GitHubAiReviewSeverityLabel { severity: "high"; }
                        GitHubAiReviewSeverityLabel { severity: "medium"; }
                        GitHubAiReviewSeverityLabel { severity: "low"; }
                    }
                }
            }
        }

        GitHubShowcaseSection {
            title: "Agent response";
            description: "Native compact Markdown blocks with in-place Preview and opaque link callback feedback.";
            content-height: agent-response-showcase.height + GitHubMetrics.size-8;

            agent-response-showcase := GitHubAgentResponseShowcase {
                x: 0px;
                y: 0px;
                width: parent.width;
                open-preview => { root.open-artifact-preview-fixture("markdown"); }
            }
