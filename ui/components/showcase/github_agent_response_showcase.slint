import { I18n } from "@i18n";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";
import { AgentResponseBlockKind, GitHubAgentResponse } from "../agent_response/github_agent_response.slint";

export component GitHubAgentResponseShowcase inherits Rectangle {
    callback open-preview();

    private property <int> action-kind: 0;
    private property <string> action-url;
    private property <string> action-feedback: root.action-kind == 0
        ? I18n.ui-components-agent-response-idle
        : root.action-kind == 1 ? I18n.ui-components-agent-response-preview-feedback
        : I18n.ui-components-agent-response-link-feedback + root.action-url;
    private property <length> content-inset: GitHubMetrics.size-16;

    height: response.y + response.height + feedback-row.height + GitHubMetrics.size-12;
    border-radius: GitHubMetrics.radius-medium;
    border-width: GitHubMetrics.border-thin;
    border-color: GitHubTheme.border-default;
    background: GitHubTheme.canvas-subtle;

    response := GitHubAgentResponse {
        x: root.content-inset;
        y: GitHubMetrics.size-8;
        width: max(0px, parent.width - 2 * root.content-inset);
        blocks: [
            {
                kind: AgentResponseBlockKind.Heading2,
                styled: @markdown("\{I18n.ui-components-agent-response-heading}"),
                plain-text: I18n.ui-components-agent-response-heading,
                list-marker: "",
                list-depth: 0,
                code-language: "",
                span-count: 1,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.Paragraph,
                styled: @markdown("**\{I18n.ui-components-agent-response-context}**, *\{I18n.ui-components-agent-response-emphasis}*, [\{I18n.ui-components-agent-response-guidance}](usher-repo-file:showcase-agent-response)"),
                plain-text: I18n.ui-components-agent-response-context + ", "
                    + I18n.ui-components-agent-response-emphasis + ", "
                    + I18n.ui-components-agent-response-guidance,
                list-marker: "",
                list-depth: 0,
                code-language: "",
                span-count: 5,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.ListItem,
                styled: @markdown("\{I18n.ui-components-agent-response-worker}"),
                plain-text: I18n.ui-components-agent-response-worker,
                list-marker: "1.",
                list-depth: 0,
                code-language: "",
                span-count: 1,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.Quote,
                styled: @markdown("\{I18n.ui-components-agent-response-preview}"),
                plain-text: I18n.ui-components-agent-response-preview,
                list-marker: "",
                list-depth: 0,
                code-language: "",
                span-count: 1,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.CodeBlock,
                styled: @markdown("cargo test --test ai_review_response_ui"),
                plain-text: "cargo test --test ai_review_response_ui",
                list-marker: "",
                list-depth: 0,
                code-language: "sh",
                span-count: 0,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.TableRow,
                styled: @markdown("\{I18n.ui-components-agent-response-table}"),
                plain-text: I18n.ui-components-agent-response-table,
                list-marker: "",
                list-depth: 0,
                code-language: "",
                span-count: 1,
                line-count: 1
            },
            {
                kind: AgentResponseBlockKind.Rule,
                styled: @markdown("Rule"),
                plain-text: "",
                list-marker: "",
                list-depth: 0,
                code-language: "",
                span-count: 0,
                line-count: 1
            }
        ];
        preview-title: I18n.ui-components-agent-response-heading;
        preview-available: true;
        open-full-response => {
            root.action-kind = 1;
            root.open-preview();
        }
        open-link(url) => {
            root.action-url = url;
            root.action-kind = 2;
        }
    }

    feedback-row := Rectangle {
        x: root.content-inset;
        y: response.y + response.height + GitHubMetrics.size-8;
        width: max(0px, parent.width - 2 * root.content-inset);
        height: GitHubMetrics.size-28;
        border-width: GitHubMetrics.border-thin;
        border-color: GitHubTheme.border-muted;
        border-radius: GitHubMetrics.radius-small;
        background: GitHubTheme.canvas-default;

        Text {
            x: GitHubMetrics.size-8;
            width: max(0px, parent.width - GitHubMetrics.size-16);
            height: parent.height;
            text: root.action-feedback;
            font-size: GitHubMetrics.text-small;
            color: root.action-kind == 0
                ? GitHubTheme.fg-muted
                : GitHubTheme.success-fg;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
