import { GitHubIconButton } from "./button/github_icon_button.slint";
import { Route } from "../route/routeMap.slint";
import { GitHubTheme } from "../theme/github_theme.slint";

export component GitHubTitleBar {
    in property <string> title: "Usher";
    in property <Route> current-route: Route.Home;
    callback navigate(Route);
    
    // macOS 交通灯按钮区域预留宽度
    property <length> traffic_light_width: 78px;
    
    height: 38px;
    
    Rectangle {
        width: 100%;
        height: 100%;
        background: GitHubTheme.canvas-default;
        
        // 三列布局：左侧占位 | 中间标题 | 右侧按钮
        HorizontalLayout {
            width: 100%;
            height: 100%;
            
            // 左侧：交通灯占位区域
            Rectangle {
                width: traffic_light_width;
            }
            
            // 中间：标题区域（水平居中）
            Rectangle {
                horizontal-stretch: 1;
                
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 8px;
                    
                    // App Logo - 绝对定位确保垂直居中
                    Rectangle {
                        width: 18px;
                        height: 38px;
                        
                        Image {
                            width: 18px;
                            height: 18px;
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../logo.png");
                        }
                    }
                    
                    // 文字容器
                    Rectangle {
                        height: 38px;
                        
                        Text {
                            text: title;
                            font-size: 13px;
                            font-weight: 600;
                            color: GitHubTheme.fg-default;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            
            // 右侧：操作按钮区域
            Rectangle {
                width: traffic_light_width;
                
                // 使用绝对定位实现垂直居中
                HorizontalLayout {
                    x: 0;
                    y: (parent.height - 28px) / 2;
                    width: 100%;
                    height: 28px;
                    padding-right: 12px;
                    spacing: 4px;
                    alignment: end;
                    
                    GitHubIconButton {
                        control-size: 28px;
                        icon: @image-url("../assets/icons/settings.svg");
                        tooltip-text: "Settings";
                        tooltip-above: false;
                        selected: current-route == Route.Settings;
                        foreground: current-route == Route.Settings
                            ? GitHubTheme.accent-fg
                            : GitHubTheme.fg-muted;
                        clicked => {
                            root.navigate(Route.Settings);
                        }
                    }

                    GitHubIconButton {
                        control-size: 28px;
                        icon: @image-url("../assets/icons/about.svg");
                        tooltip-text: "About";
                        tooltip-above: false;
                        selected: current-route == Route.About;
                        foreground: current-route == Route.About
                            ? GitHubTheme.accent-fg
                            : GitHubTheme.fg-muted;
                        clicked => {
                            root.navigate(Route.About);
                        }
                    }
                }
            }
        }
        
        // 底部分隔线
        Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: GitHubTheme.border-default;
        }
    }
}
