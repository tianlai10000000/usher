import { GitHubTheme, GitHubMetrics } from "../theme/github_theme.slint";
import {
    GitHubTooltipAlignment,
    GitHubTooltipPlacement,
    TooltipOverlayState,
} from "../state/tooltip_overlay_state.slint";

// Primer tooltip surface. Root-layer hosts provide the available viewport size
// so long labels wrap instead of overflowing a narrow desktop window.
export component GitHubTooltipSurface inherits Rectangle {
    in property <string> text;
    in property <length> viewport-max-width: 320px;
    in property <length> viewport-max-height: 320px;

    // Keep the painted box and its 8px text inset on the logical-pixel grid.
    // Fractional preferred widths otherwise make centered tips land at x.5;
    // FemtoVG visibly softens 12px white glyphs there on 1x displays.
    // Leave a small overhang allowance because fallback CJK glyphs can paint
    // beyond the preferred width reported for the measuring Text node.
    private property <length> glyph-overhang-allowance: GitHubMetrics.size-4;
    private property <length> natural-width:
        Math.ceil(
            (
                tip-measure.preferred-width
                + GitHubMetrics.size-16
                + root.glyph-overhang-allowance
            ) / 1px
        ) * 1px;
    private property <length> label-height: max(
        tip-label.preferred-height,
        GitHubMetrics.size-16 + GitHubMetrics.size-2
    );
    private property <length> natural-height:
        root.label-height + GitHubMetrics.size-8;

    width: min(root.natural-width, max(0px, root.viewport-max-width));
    height: min(root.natural-height, max(0px, root.viewport-max-height));
    border-radius: GitHubMetrics.radius-medium;
    border-width: 0px;
    background: GitHubTheme.tooltip-bg;
    clip: true;

    tip-measure := Text {
        visible: false;
        text: root.text;
        font-size: GitHubMetrics.text-small;
        wrap: no-wrap;
    }

    tip-label := Text {
        x: GitHubMetrics.size-8;
        y: GitHubMetrics.size-4;
        width: max(0px, parent.width - GitHubMetrics.size-16);
        height: max(0px, parent.height - GitHubMetrics.size-8);
        text: root.text;
        color: GitHubTheme.tooltip-fg;
        font-size: GitHubMetrics.text-small;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

// A transparent reference locator. It always covers its host and publishes the
// host rectangle, never a precomputed tooltip coordinate. Placement belongs to
// the root overlay host so every call site shares the same collision handling.
export component GitHubTooltip inherits Rectangle {
    in property <string> text;
    in property <string> debug-node: "GitHubTooltip";
    in property <GitHubTooltipPlacement> preferred-placement:
        GitHubTooltipPlacement.Top;
    in property <GitHubTooltipAlignment> alignment:
        GitHubTooltipAlignment.Center;

    private property <int> tip-token: 0;
    private property <bool> has-published-non-origin-position: false;
    private property <bool> detached:
        root.has-published-non-origin-position
        && root.absolute-position.x == 0px
        && root.absolute-position.y == 0px;

    width: 100%;
    height: 100%;
    border-width: 0px;
    background: transparent;

    init => { root.publish-tip(); }
    changed text => { root.publish-tip(); }
    changed absolute-position => { root.publish-tip(); }
    changed width => { root.publish-tip(); }
    changed height => { root.publish-tip(); }
    changed preferred-placement => { root.publish-tip(); }
    changed alignment => { root.publish-tip(); }

    lease-timer := Timer {
        interval: 32ms;
        running: root.text != "";
        triggered => {
            if root.detached || root.width <= 0px || root.height <= 0px {
                TooltipOverlayState.hide(root.tip-token);
            } else {
                TooltipOverlayState.renew(
                    root.tip-token,
                    root.text,
                    root.absolute-position.x,
                    root.absolute-position.y,
                    root.width,
                    root.height,
                    root.preferred-placement,
                    root.alignment,
                );
            }
        }
    }

    function publish-tip() {
        if root.text == "" || root.detached || root.width <= 0px || root.height <= 0px {
            TooltipOverlayState.hide(root.tip-token);
        } else {
            TooltipOverlayState.show(
                root.debug-node,
                root.text,
                root.absolute-position.x,
                root.absolute-position.y,
                root.width,
                root.height,
                root.preferred-placement,
                root.alignment,
            );
            root.tip-token = TooltipOverlayState.token;
            if root.absolute-position.x != 0px || root.absolute-position.y != 0px {
                root.has-published-non-origin-position = true;
            }
        }
    }
}
