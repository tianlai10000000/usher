import { MaterialText } from "@material";
import { AppState } from "../../state/app_state.slint";

export struct StepItem {
    name: string,
    status: string,
    detail: string,
    log: string,
}

export component StepCard inherits Rectangle {
    in property <StepItem> step;
    in property <int> step-index: 0;
    in property <bool> expanded: false;
    in property <bool> animations-enabled: true;
    private property <bool> pulse-on: false;
    callback toggle();

    pulse-timer := Timer {
        interval: 220ms;
        running: step.status == "running" && root.animations-enabled;
        triggered => {
            root.pulse-on = !root.pulse-on;
        }
    }

    width: 100%;
    height: content.preferred-height + 16px;
    clip: true;
    border-radius: 6px;
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    border-width: 1px;
    border-color: step.status == "error"
        ? (AppState.effective-dark-mode ? #f85149 : #cf222e)
        : (AppState.effective-dark-mode ? #3d444d : #d1d9e0);

    content := VerticalLayout {
        x: 12px;
        y: 8px;
        width: root.width - 24px;
        spacing: 8px;

        header := Rectangle {
            width: parent.width;
            height: max(52px, body-column.preferred-height);
            background: transparent;

            if step.status == "running": Rectangle {
                width: 30px;
                height: 30px;
                x: -3px;
                y: (header.height - self.height) / 2;
                border-radius: 15px;
                border-width: 2px;
                border-color: AppState.effective-dark-mode ? #58a6ff : #0969da;
                background: transparent;
                opacity: root.animations-enabled ? (root.pulse-on ? 0.5 : 0.2) : 0.2;
            }

            Rectangle {
                width: 24px;
                height: 24px;
                x: 0px;
                y: (header.height - self.height) / 2;
                border-radius: 12px;
                background: step.status == "success" ? (AppState.effective-dark-mode ? #238636 : #1f883d) :
                            step.status == "error" ? (AppState.effective-dark-mode ? #da3633 : #cf222e) :
                            step.status == "paused" ? (AppState.effective-dark-mode ? #9e6a03 : #bf8700) :
                            step.status == "running" ? (AppState.effective-dark-mode ? #1f6feb : #0969da) :
                            (AppState.effective-dark-mode ? #21262d : #eaeef2);
                border-width: step.status == "pending" ? 1px : 0px;
                border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;

                MaterialText {
                    text: root.step-index + 1;
                    color: step.status == "pending"
                        ? (AppState.effective-dark-mode ? #9198a1 : #59636e)
                        : #ffffff;
                    font_size: 12px;
                    font_weight: 700;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            body := Rectangle {
                x: 34px;
                width: max(120px, header.width - 34px - 52px);
                height: header.height;
                background: transparent;

                body-column := VerticalLayout {
                    width: parent.width;
                    y: (parent.height - self.preferred-height) / 2;
                    spacing: 2px;
                    alignment: start;

                    MaterialText {
                        text: step.name;
                        font_size: 14px;
                        font_weight: 600;
                        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                    }

                    if step.status == "running": MaterialText {
                        text: "Running...";
                        font_size: 11px;
                        font_weight: 600;
                        color: AppState.effective-dark-mode ? #58a6ff : #0969da;
                    }

                    if step.status == "paused": MaterialText {
                        text: "Paused";
                        font_size: 11px;
                        font_weight: 600;
                        color: AppState.effective-dark-mode ? #d29922 : #9a6700;
                    }

                    Text {
                        width: parent.width;
                        text: step.detail;
                        wrap: word-wrap;
                        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
                        font-size: 12px;
                    }
                }
            }

            Rectangle {
                width: 44px;
                height: 20px;
                x: header.width - self.width - 8px;
                y: (header.height - self.height) / 2;
                background: transparent;

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.toggle(); }
                }

                MaterialText {
                    text: root.expanded ? "Hide" : "Logs";
                    color: AppState.effective-dark-mode ? #58a6ff : #0969da;
                    font_size: 12px;
                    vertical_alignment: center;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        if root.expanded: Rectangle {
            width: parent.width;
            border-radius: 6px;
            background: AppState.effective-dark-mode ? #151b23 : #f6f8fa;
            border-width: 1px;
            border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
            height: max(60px, log-text.preferred-height + 20px);

            log-text := Text {
                width: parent.width - 20px;
                x: 10px;
                y: 10px;
                text: step.log == "" ? "No logs yet." : step.log;
                wrap: word-wrap;
                color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
                font-size: 12px;
            }
        }
    }
}

export component Steps inherits Rectangle {
    in property <string> title: "Workflow steps";
    in property <string> empty-text: "No workflow steps yet.";
    in property <[StepItem]> steps: [];
    in property <bool> animations-enabled: true;
    in property <int> current-step-index: -1;
    in-out property <int> expanded-step-index: -1;
    callback step-toggled(int);

    width: 100%;
    height: max(140px, steps-content.preferred-height + 28px);
    border-radius: 6px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    clip: true;

    steps-content := VerticalLayout {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        spacing: 0px;

        Rectangle {
            width: parent.width;
            height: 40px;
            background: AppState.effective-dark-mode ? #151b23 : #f6f8fa;

            MaterialText {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: root.title;
                vertical_alignment: center;
                font_size: 13px;
                font-weight: 600;
                color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
            }
        }

        Rectangle {
            width: parent.width;
            height: 1px;
            background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
        }

        if root.steps.length == 0: Text {
            width: parent.width - 24px;
            x: 12px;
            height: 44px;
            text: root.empty-text;
            vertical-alignment: center;
            color: AppState.effective-dark-mode ? #9198a1 : #59636e;
            font-size: 12px;
        }

        if root.steps.length > 0: VerticalLayout {
            width: parent.width;
            spacing: 0px;

            for step[index] in root.steps: VerticalLayout {
                width: parent.width;
                spacing: 0px;

                StepCard {
                    width: parent.width;
                    step: step;
                    step-index: index;
                    expanded: root.expanded-step-index == index;
                    animations-enabled: root.animations-enabled;
                    toggle => {
                        root.expanded-step-index = root.expanded-step-index == index ? -1 : index;
                        root.step-toggled(index);
                    }
                }

                if index < root.steps.length - 1: Rectangle {
                    width: parent.width;
                    height: 1px;
                    background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
                }
            }
        }
    }
}
