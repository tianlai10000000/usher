import { GitHubCompactTextField } from "../input/compact_text_field.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";

export component GitHubTagField {
    in property <string> label;
    in-out property <string> value;
    callback edited(string);
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <length> min-field-width: 220px;
    private property <length> label-height: 16px;
    private property <length> input-height: 42px;
    height: root.label-height + 8px + root.input-height;

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 8px;

        Text {
            text: root.label;
            height: root.label-height;
            vertical-alignment: center;
            font-size: GitHubMetrics.text-small;
            font-weight: 600;
            color: GitHubTheme.fg-default;
        }

        GitHubCompactTextField {
            width: root.width - 2px;
            text <=> root.value;
            accessible-name: root.label;
            edited(value) => { root.edited(value); }
            placeholder: root.placeholder;
            enabled: root.enabled;
            field-height: root.input-height;
            border-radius-size: 6px;
            input-font-size: 14px;
            field-background: GitHubTheme.canvas-default;
        }
    }
}

export component GitHubTagReadonlyField {
    in property <string> label;
    in property <string> value;
    private property <length> label-height: 16px;
    private property <length> input-height: 42px;
    height: root.label-height + 8px + root.input-height;

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 8px;

        Text {
            text: root.label;
            height: root.label-height;
            vertical-alignment: center;
            font-size: GitHubMetrics.text-small;
            font-weight: 600;
            color: GitHubTheme.fg-default;
        }

        Rectangle {
            width: root.width - 2px;
            height: root.input-height;
            border-radius: 6px;
            border-width: 1px;
            border-color: GitHubTheme.border-default;
            background: GitHubTheme.canvas-subtle;

            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: root.value;
                font-size: 14px;
                color: GitHubTheme.fg-default;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
