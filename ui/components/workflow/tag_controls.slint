import { GitHubButton } from "../settings/github_settings_controls.slint";

export component GitHubTagActionButton inherits GitHubButton {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    in property <bool> action-primary: true;

    text: root.label;
    primary: root.action-primary && !root.danger;
    disabled: !root.enabled;
    busy: root.loading;
}
