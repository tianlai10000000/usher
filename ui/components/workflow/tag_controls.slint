import { AppState } from "../../state/app_state.slint";

export component TagActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    // When true, show an in-button GitHub spinner and block clicks.
    in property <bool> loading: false;
    callback clicked();

    private property <bool> interactive: root.enabled && !root.loading;
    // Keep animation-tick on the button (not an Image root) so the spinner redraws.
    private property <float> rotation-progress:
        root.loading ? mod(animation-tick(), 1s) / 1s : 0;
    private property <length> spinner-size: 14px;
    private property <length> content-left: 10px;

    label-measure := Text {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
    }

    width: max(92px, label-measure.preferred-width + (root.loading ? 42px : 28px));
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.interactive
        ? (AppState.effective-dark-mode ? #3d444d : #d1d9e0)
        : (root.danger
            ? (AppState.effective-dark-mode ? #f85149 : #cf222e)
            : (AppState.effective-dark-mode ? #2ea043 : #1a7f37));
    background: !root.interactive
        ? (AppState.effective-dark-mode ? #21262d : #f6f8fa)
        : (root.danger
            ? (action-touch.has-hover
                ? (AppState.effective-dark-mode ? #da3633 : #a40e26)
                : (AppState.effective-dark-mode ? #21262d : #ffffff))
            : (action-touch.has-hover
                ? (AppState.effective-dark-mode ? #2ea043 : #1a7f37)
                : (AppState.effective-dark-mode ? #238636 : #1f883d)));
    opacity: root.interactive || root.loading ? 1 : 0.55;

    // Absolute mid-line placement: layout cross-axis centering drifts when the
    // Text preferred-height (ascent/descent) differs from the spinner box.
    if root.loading: Image {
        x: root.content-left;
        y: (root.height - root.spinner-size) / 2;
        width: root.spinner-size;
        height: root.spinner-size;
        source: @image-url("../../assets/icons/github-spinner-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #58a6ff : #0969da;
        transform-rotation: root.rotation-progress * 360deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    Text {
        x: root.loading ? root.content-left + root.spinner-size + 6px : root.content-left;
        y: 0px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        color: !root.interactive
            ? (AppState.effective-dark-mode ? #9198a1 : #59636e)
            : (root.danger && !action-touch.has-hover
                ? (AppState.effective-dark-mode ? #f85149 : #cf222e)
                : #ffffff);
    }

    action-touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TagStatusBanner inherits Rectangle {
    in property <string> message;
    in property <bool> initializing: false;
    private property <float> rotation-progress:
        root.initializing ? mod(animation-tick(), 1s) / 1s : 0;
    private property <length> icon-size: 16px;
    private property <length> pad-y: 10px;
    private property <length> pad-x: 12px;
    private property <length> gap: 8px;
    private property <string> display-text:
        root.initializing ? "Loading repository tags…" : root.message;
    private property <length> text-width:
        max(1px, root.width - root.pad-x * 2 - root.icon-size - root.gap);
    // One-line glyph box for the inherited 12px application font; a taller
    // measure means the message wrapped onto multiple lines.
    private property <length> single-line-height: max(16px, line-measure.preferred-height);
    private property <bool> multi-line:
        message-measure.preferred-height > root.single-line-height + 1px;

    // Floor 40px; otherwise hug wrapped text + vertical padding.
    height: max(40px, root.pad-y * 2 + message-measure.preferred-height);
    border-radius: 6px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #388bfd66 : #54aeff;
    background: AppState.effective-dark-mode ? #0c2d6b : #ddf4ff;

    line-measure := Text {
        visible: false;
        text: "Ag";
        font-size: 12px;
        wrap: no-wrap;
    }

    message-measure := Text {
        visible: false;
        width: root.text-width;
        text: root.display-text;
        wrap: word-wrap;
        font-size: 12px;
    }

    // Single line: share the banner mid-line with the icon.
    // Multi-line: pin icon to the first-line mid-line (GitHub Alert layout).
    Image {
        x: root.pad-x;
        y: root.multi-line
            ? root.pad-y + (root.single-line-height - root.icon-size) / 2
            : (root.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.initializing
            ? @image-url("../../assets/icons/github-spinner-16.svg")
            : @image-url("../../assets/icons/octicon-info-16.svg");
        image-fit: contain;
        colorize: AppState.effective-dark-mode ? #58a6ff : #0969da;
        transform-rotation: root.initializing ? root.rotation-progress * 360deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    Text {
        x: root.pad-x + root.icon-size + root.gap;
        y: root.multi-line ? root.pad-y : 0px;
        width: root.text-width;
        height: root.multi-line ? root.height - root.pad-y * 2 : root.height;
        text: root.display-text;
        wrap: word-wrap;
        vertical-alignment: root.multi-line ? top : center;
        font-size: 12px;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    }
}

export component TagStepsPlaceholder inherits Rectangle {
    in property <string> message: "Workflow steps will appear after the tag process starts.";

    height: 90px;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 44px;
        background: AppState.effective-dark-mode ? #151b23 : #f6f8fa;

        Image {
            x: 12px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/icons/flow_chart.svg");
            colorize: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }

        Text {
            x: 38px;
            y: 0px;
            width: parent.width - 140px;
            height: parent.height;
            text: "Workflow steps";
            vertical-alignment: center;
            font-size: 13px;
            font-weight: 600;
            color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        }

        Text {
            x: parent.width - 104px;
            y: 0px;
            width: 92px;
            height: parent.height;
            text: "Not started";
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 12px;
            color: AppState.effective-dark-mode ? #9198a1 : #59636e;
        }
    }

    Rectangle {
        x: 0px;
        y: 44px;
        width: parent.width;
        height: 1px;
        background: AppState.effective-dark-mode ? #3d444d : #d1d9e0;
    }

    Text {
        x: 12px;
        y: 45px;
        width: parent.width - 24px;
        height: 45px;
        text: root.message;
        vertical-alignment: center;
        overflow: elide;
        font-size: 12px;
        color: AppState.effective-dark-mode ? #9198a1 : #59636e;
    }
}

// Primer SegmentedControl segment — sit inside TagSegmentedControl.
export component TagSegmentItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    private property <length> segment-width: max(56px, label-measure.preferred-width + 24px);

    width: root.segment-width;
    // Fixed height — never rely on percent height inside an unsized parent.
    height: 28px;
    vertical-stretch: 0;
    background: !root.enabled
        ? transparent
        : (root.selected
            ? (AppState.effective-dark-mode ? #21262d : #eaeef2)
            : (segment-touch.has-hover
                ? (AppState.effective-dark-mode ? #21262d : #f6f8fa)
                : transparent));
    opacity: root.enabled ? 1 : 0.55;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: 12px;
        font-weight: root.selected ? 600 : 400;
        wrap: no-wrap;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 12px;
        font-weight: root.selected ? 600 : 400;
        color: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    segment-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Primer SegmentedControl shell (medium, 28px). Width hugs segments.
export component TagSegmentedControl inherits Rectangle {
    height: 28px;
    // preferred-width comes from the inner layout's children.
    width: segments.preferred-width;
    border-radius: 6px;
    border-width: 1px;
    border-color: AppState.effective-dark-mode ? #3d444d : #d0d7de;
    background: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    clip: true;
    vertical-stretch: 0;

    segments := HorizontalLayout {
        height: 28px;
        spacing: 0px;
        alignment: start;
        @children
    }
}

export component TagSegmentDivider inherits Rectangle {
    width: 1px;
    height: 28px;
    background: AppState.effective-dark-mode ? #3d444d : #d0d7de;
    vertical-stretch: 0;
}
