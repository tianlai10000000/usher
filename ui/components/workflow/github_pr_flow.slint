import { GitHubTooltip } from "../github_tooltip.slint";
import { GitHubTooltipAlignment, GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubPrMenuState, GitHubPrMenuProjection, GitHubPrMenuAnchor } from "./github_pr_menu_overlay.slint";
import { GitHubCenteredLoadingState } from "../github_spinner.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubPagination } from "../navigation/github_pagination.slint";
import { GitHubFilterMenuButton } from "../github_filter_menu.slint";
import { GitHubMetrics, GitHubTheme } from "../../theme/github_theme.slint";
import { AiReviewRuleChoice } from "@ai-review";
import { I18n } from "@i18n";
import { GitHubConflictStatus } from "../pr_review/conflict_status.slint";

















import { GitHubPullRequestSearchField, GitHubPullRequestClearQueryButton, GitHubPullRequestStateButton, GitHubPullRequestFilterMoreButton, GitHubPullRequestListStatePanel, WorkflowPullRequestItem } from "./github_pr_list_components.slint";
export { WorkflowPullRequestItem } from "./github_pr_list_components.slint";

export component GitHubPullRequestFlow {
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    in property <string> code-font-family: "Menlo";
    in property <int> compact-text-offset-y: 0;
    in property <string> repo-project-id;
    in property <string> repo-type;
    in property <[WorkflowPullRequestItem]> pr-items: [];
    in property <int> pr-total: 0;
    in property <bool> pr-total-exact: false;
    in property <int> pr-open-total: -1;
    in property <int> pr-closed-total: -1;
    in property <int> pr-page: 1;
    in property <int> pr-page-count: 1;
    in property <[int]> pr-page-links: [];
    in property <string> pr-state: "open";
    in property <string> pr-query: "is:pr is:open";
    in property <string> pr-review-filter: "all";
    in property <string> pr-assignee-filter: "any";
    in property <string> pr-sort-filter: "newest";
    in property <bool> pr-loading: false;
    in property <string> pr-error: "";
    in property <string> pr-error-kind: "";
    in property <[AiReviewRuleChoice]> ai-review-rule-options: [];
    in property <string> ai-review-project-rule-id: "";
    in property <string> ai-review-project-rule-name: I18n.common-no-preset;
    callback change-state(string);
    callback change-query(string);
    callback change-page(int);
    callback change-review-filter(string);
    callback change-assignee-filter(string);
    callback change-sort-filter(string);
    callback open-detail(string, string, string, string, string, string, int);
    callback start-ai-review(string, string, string, string);
    callback open-ai-review(string);
    callback cancel-ai-review(string);
    callback set-ai-review-rule(string);
    callback open-settings();

    private property <string> active-menu: "";
    private property <int> menu-owner: 0;
    init => {
        GitHubPrMenuState.next-owner += 1;
        root.menu-owner = GitHubPrMenuState.next-owner;
    }
    private property <GitHubPrMenuProjection> menu-projection: {
        owner: root.menu-owner, menu: root.active-menu, anchor: root.menu-anchor,
        rules: root.ai-review-rule-options, review: root.pr-review-filter,
        assignee: root.pr-assignee-filter, sort: root.pr-sort-filter,
    };
    changed menu-projection => {
        if root.active-menu != "" {
            GitHubPrMenuState.current = root.menu-projection;
        } else if GitHubPrMenuState.current.owner == root.menu-owner {
            GitHubPrMenuState.close();
        }
    }
    private property <bool> portal-open:
        GitHubPrMenuState.current.owner == root.menu-owner && GitHubPrMenuState.current.menu != "";
    changed portal-open => {
        if !root.portal-open { root.active-menu = ""; }
    }
    private property <int> menu-action-revision: GitHubPrMenuState.action-revision;
    changed menu-action-revision => {
        if GitHubPrMenuState.action-owner == root.menu-owner {
            if GitHubPrMenuState.action-kind == "ai-rule" {
                root.set-ai-review-rule(GitHubPrMenuState.action-value);
            } else if GitHubPrMenuState.action-kind == "reviews" {
                root.change-review-filter(GitHubPrMenuState.action-value);
            } else if GitHubPrMenuState.action-kind == "assignee" {
                root.change-assignee-filter(GitHubPrMenuState.action-value);
            } else {
                root.change-sort-filter(GitHubPrMenuState.action-value);
            }
            root.active-menu = "";
        }
    }
    changed visible => {
        if !root.visible { root.active-menu = ""; }
    }
    private property <string> hovered-inline-tooltip: "";
    private property <length> hovered-inline-tooltip-x: 42px;
    private property <length> hovered-inline-tooltip-y: 0px;
    private property <length> hovered-inline-tooltip-width: 1px;
    private property <length> hovered-inline-tooltip-height: 1px;
    private property <bool> compact-filters: root.width < 620px;
    private property <bool> wrap-row-branches: root.width < 760px;
    private property <bool> canonical-state-query:
        (root.pr-state == "open" && root.pr-query == "is:pr is:open")
        || (root.pr-state == "closed" && root.pr-query == "is:pr is:closed");
    private property <length> query-area-height: root.canonical-state-query ? 48px : 80px;
    private property <bool> supports-review-filter: root.repo-type == "github";
    private property <bool> supports-assignee-filter: root.repo-type == "github"
        || root.repo-type == "gitlab";
    // GitHub keeps state and filter actions on one compact toolbar row.
    private property <length> header-height: 48px;
    private property <string> empty-title: root.pr-state == "open"
        ? I18n.pr-list-empty-open
        : (root.pr-state == "merged"
            ? I18n.pr-list-empty-merged
            : I18n.pr-list-empty-closed);
    private property <color> canvas-default: GitHubTheme.canvas-default;
    private property <color> canvas-subtle: GitHubTheme.canvas-subtle;
    private property <color> border-default: GitHubTheme.border-default;
    private property <color> fg-default: GitHubTheme.fg-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    private property <length> list-height: root.pr-loading || root.pr-error != "" || root.pr-items.length == 0
        ? root.header-height + 320px
        : root.header-height + visible-rows.preferred-height;
    private property <bool> show-pagination: !root.pr-loading
        && root.pr-error == ""
        && root.pr-items.length > 0
        && root.pr-page-count > 1;
    // Footer is 16px gap + 32px controls + 8px trailing inset below the card.
    private property <length> pagination-block-height: root.show-pagination ? 56px : 0px;
    // Keep the complete window-space trigger bounds current while open.
    private property <GitHubPrMenuAnchor> menu-anchor;
    changed compact-filters => { root.active-menu = ""; }
    function track-anchor(kind: string, bounds: GitHubPrMenuAnchor) {
        if root.active-menu == kind { root.menu-anchor = bounds; }
    }
    // Lock geometry so a taller Workflow panel cannot stretch the list card
    // and pull the pagination footer inside its border.
    height: root.query-area-height + root.list-height + root.pagination-block-height;
    vertical-stretch: 0;

    // Same stacking contract as the review-workspace Diff view / file-filter /
    // readiness popovers: dismiss is mounted under the interactive chrome so
    // the first click on another filter switches menus instead of only closing.
    // Slint rectangles alone do not capture pointer input; the TouchArea must
    // own the hit target. Full-window absolute positioning matches the
    // status-bar outside-click pattern for clicks outside the list card.
    if root.active-menu != "": Rectangle {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: 9999px;
        height: 9999px;
        z: 0;
        background: transparent;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
            clicked => { root.active-menu = ""; }
        }
    }

    search-field := GitHubPullRequestSearchField {
        x: 0px;
        y: 0px;
        width: root.width;
        text: root.pr-query;
        accepted(query) => { root.change-query(query); }
    }

    if !root.canonical-state-query: GitHubPullRequestClearQueryButton {
        x: 0px;
        y: 40px;
        clicked => { root.change-query("is:pr is:open"); }
    }

    // Keep the card and pager in one explicit layout. Absolute y coordinates
    // can still be compressed by an ancestor's layout constraints; a real
    // sibling layout preserves the 16px gap even on a tall Closed page.
    content-layout := VerticalLayout {
        y: root.query-area-height;
        width: root.width;
        height: root.height - root.query-area-height;
        spacing: root.show-pagination ? 16px : 0px;
        alignment: start;

        pr-list := Rectangle {
            width: parent.width;
            height: root.list-height;
            vertical-stretch: 0;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.border-default;
            background: root.canvas-default;
            clip: true;

            header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.header-height;
                z: 10;
                background: root.canvas-subtle;

            if root.canonical-state-query: HorizontalLayout {
                x: 4px;
                width: open-state-btn.width + closed-state-btn.width;
                height: parent.height;
                spacing: 0px;
                open-state-btn := GitHubPullRequestStateButton {
                    label: I18n.pr-list-open;
                    value: "open";
                    selected-value: root.pr-state;
                    count: root.pr-open-total;
                    selected(value) => { root.change-state(value); }
                }
                closed-state-btn := GitHubPullRequestStateButton {
                    label: I18n.pr-list-closed;
                    value: "closed";
                    selected-value: root.pr-state;
                    count: root.pr-closed-total;
                    selected(value) => { root.change-state(value); }
                }
            }

            if !root.canonical-state-query: total-state-btn := GitHubPullRequestStateButton {
                x: 4px;
                label: I18n.pr-list-total;
                value: "total";
                selected-value: "total";
                count: root.pr-total-exact ? root.pr-total : -1;
                selected(value) => { }
            }

            // Keep status and filters on one GitHub-style toolbar row.
            // Same stacking contract as Diff view / file-filter / readiness
            // on the review workspace: triggers stay above the dismiss layer
            // so the first click switches menus.
            filter-bar-host := Rectangle {
                x: 4px;
                y: 8px;
                width: parent.width - 8px;
                height: 32px;
                z: 95;
                background: transparent;

                filter-bar := HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    alignment: end;

                    if root.ai-review-rule-options.length > 0: rule-btn := GitHubFilterMenuButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor("ai-rule", self.bounds); }
                        label: root.width < GitHubMetrics.breakpoint-medium ? I18n.pr-list-ai-rule
                            : I18n.pr-list-ai-rule + ": " + root.ai-review-project-rule-name;
                        maximum-label-width: 220px;
                        menu-open: root.active-menu == "ai-rule";
                        selected: root.active-menu == "ai-rule" || root.ai-review-project-rule-id != "";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu == "ai-rule" ? "" : "ai-rule";
                        }
                    }

                    if !root.compact-filters && root.supports-review-filter: reviews-btn := GitHubFilterMenuButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor("reviews", self.bounds); }
                        label: I18n.pr-list-reviews;
                        menu-open: root.active-menu == "reviews";
                        selected: root.active-menu == "reviews" || root.pr-review-filter != "all";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu == "reviews" ? "" : "reviews";
                        }
                    }
                    if !root.compact-filters && root.supports-assignee-filter: assignee-btn := GitHubFilterMenuButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor("assignee", self.bounds); }
                        label: I18n.pr-list-assignee;
                        menu-open: root.active-menu == "assignee";
                        selected: root.active-menu == "assignee" || root.pr-assignee-filter != "any";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu == "assignee" ? "" : "assignee";
                        }
                    }
                    if !root.compact-filters: sort-btn := GitHubFilterMenuButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor("sort", self.bounds); }
                        label: I18n.pr-list-sort;
                        menu-open: root.active-menu == "sort";
                        selected: root.active-menu == "sort" || root.pr-sort-filter != "newest";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu == "sort" ? "" : "sort";
                        }
                    }
                    if root.compact-filters && root.supports-assignee-filter: compact-assignee-btn := GitHubFilterMenuButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor("assignee", self.bounds); }
                        label: I18n.pr-list-assignee;
                        menu-open: root.active-menu == "assignee";
                        selected: root.active-menu == "assignee" || root.pr-assignee-filter != "any";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu == "assignee" ? "" : "assignee";
                        }
                    }
                    if root.compact-filters: more-btn := GitHubPullRequestFilterMoreButton {
                        private property <GitHubPrMenuAnchor> bounds: {
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        };
                        changed bounds => { root.track-anchor(root.supports-review-filter ? "more" : "sort", self.bounds); }
                        selected: root.active-menu == (root.supports-review-filter ? "more" : "sort")
                            || (root.supports-review-filter && root.pr-review-filter != "all")
                            || root.pr-sort-filter != "newest";
                        clicked => {
                            root.menu-anchor = self.bounds;
                            root.active-menu = root.active-menu
                                == (root.supports-review-filter ? "more" : "sort")
                                ? ""
                                : (root.supports-review-filter ? "more" : "sort");
                        }
                    }
                }
            }
        }

        if root.pr-loading: GitHubCenteredLoadingState {
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height;
            label: I18n.pr-list-loading;
            foreground: root.fg-muted;
        }

        if !root.pr-loading && root.pr-error != "": GitHubPullRequestListStatePanel {
            y: root.header-height;
            width: parent.width;
            error-state: true;
            title: I18n.pr-list-unable-to-load;
            description: I18n.pr-list-load-error-description;
            show-action: true;
            action-label: root.pr-error-kind == "authentication" || root.pr-error-kind == "configuration"
                ? I18n.common-open-settings
                : I18n.pr-list-retry-request;
            action => {
                if root.pr-error-kind == "authentication" || root.pr-error-kind == "configuration" {
                    root.open-settings();
                } else {
                    root.change-page(root.pr-page);
                }
            }
        }

        if !root.pr-loading && root.pr-error == "" && root.pr-items.length == 0: GitHubPullRequestListStatePanel {
            y: root.header-height;
            width: parent.width;
            title: root.empty-title;
            description: I18n.pr-list-empty-filter-description;
        }

        visible-rows := VerticalLayout {
            y: root.header-height;
            width: parent.width;
            height: self.preferred-height;
            visible: !root.pr-loading && root.pr-error == "" && root.pr-items.length > 0;
            spacing: 0px;
            alignment: start;

            for item[index] in root.pr-items: pr-row := Rectangle {
                width: parent.width;
                // GitHub PR list rows stay on the default canvas. The title is an
                // accent link; hover underlines the title instead of painting
                // Box-row--hover-gray across the row.
                background: transparent;
                private property <string> display-title: item.title == ""
                    ? I18n.pr-list-untitled-pull-request
                    : item.title;
                private property <string> display-author: item.author == ""
                    ? I18n.common-unknown-author
                    : item.author;
                private property <length> conversation-action-width: item.conversation-count > 0
                    ? max(40px, conversation-count-measure.preferred-width + 32px) : 32px;
                private property <length> ai-action-width: 32px;
                private property <bool> ai-review-active:
                    item.ai-review-status == "queued" || item.ai-review-status == "running";
                private property <length> stop-action-width:
                    self.ai-review-active ? GitHubMetrics.control-xsmall-size : 0px;
                private property <length> stop-action-gap: self.ai-review-active ? 4px : 0px;
                private property <length> action-width:
                    self.conversation-action-width + self.ai-action-width
                    + self.stop-action-gap + self.stop-action-width;
                private property <length> content-x: 38px;
                // Keep title painting and measurement on the same native Text
                // contract so wrapped CJK/Latin rows share the 1.18 line height.
                private property <float> title-line-height-factor: 1.12;
                private property <length> title-max-width: max(
                    80px,
                    parent.width - self.content-x - self.action-width - 32px,
                );
                private property <bool> title-wraps: title-measure.preferred-width > self.title-max-width;
                private property <length> title-block-height: max(
                    root.wrap-row-branches ? 18px : 26px,
                    title-wrapped-measure.preferred-height,
                );
                private property <length> first-line-center-y:
                    self.title-wraps || root.wrap-row-branches ? 17px : 21px;
                private property <length> title-draw-width: self.title-wraps
                    ? self.title-max-width
                    : min(title-measure.preferred-width, self.title-max-width);
                private property <bool> keyboard-focus-visible: false;
                private property <length> metadata-y: 8px + self.title-block-height
                    + (self.title-wraps ? 4px : (root.wrap-row-branches ? 2px : 0px));
                private property <length> metadata-line-height: 24px;
                private property <length> metadata-font-size: 12px;
                private property <length> branch-chip-height: 20px;
                private property <length> branch-font-size: 11px;
                private property <length> natural-row-height: max(
                    self.metadata-y + self.metadata-line-height,
                    self.review-status-width > 0px ? self.review-y + self.metadata-line-height : 0px,
                    self.conflict-status-width > 0px ? self.conflict-y + self.metadata-line-height : 0px,
                    self.has-branches ? self.branch-chip-y + self.branch-chip-height : 0px
                ) + 10px;
                height: self.natural-row-height;

                row-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: button;
                    accessible-enabled: true;
                    accessible-label: pr-row.display-title + ". " + I18n.pr-list-pull-request + " " + item.number;
                    key-pressed(event) => {
                        pr-row.keyboard-focus-visible = true;
                        if event.text == Key.Return || event.text == " " {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                            return accept;
                        }
                        return reject;
                    }
                    focus-gained(reason) => {
                        pr-row.keyboard-focus-visible = reason == FocusReason.tab-navigation;
                    }
                    focus-lost => { pr-row.keyboard-focus-visible = false; }
                }

                if index > 0: Rectangle {
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: root.border-default;
                }

                Image {
                    x: 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: 16px;
                    height: 16px;
                    source: item.state == "merged"
                        ? @image-url("../../assets/icons/octicon-git-merge-16.svg")
                        : @image-url("../../assets/icons/octicon-git-pull-request-16.svg");
                    colorize: item.state == "merged"
                        ? (GitHubTheme.done-fg)
                        : (item.state == "closed"
                            ? (GitHubTheme.danger-fg)
                            : (GitHubTheme.success-fg));
                }

                title-measure := Text {
                    visible: false;
                    text: pr-row.display-title;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                }

                title-wrapped-measure := Text {
                    visible: false;
                    width: parent.title-max-width;
                    text: pr-row.display-title;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                    line-height-factor: pr-row.title-line-height-factor;
                }

                title-clip := Rectangle {
                    x: parent.content-x;
                    y: 8px;
                    width: parent.title-max-width;
                    height: parent.title-block-height;
                    background: transparent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: pr-row.display-title;
                        font-size: 14px;
                        font-weight: 600;
                        color: title-touch.has-hover ? GitHubTheme.accent-fg : root.fg-default;
                        horizontal-alignment: left;
                        vertical-alignment: pr-row.title-wraps || root.wrap-row-branches
                            ? top
                            : center;
                        wrap: word-wrap;
                        overflow: clip;
                        line-height-factor: pr-row.title-line-height-factor;
                    }
                }

                title-touch := TouchArea {
                    x: parent.content-x;
                    y: 8px;
                    width: parent.title-draw-width;
                    height: parent.title-block-height;
                    z: 2;
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                private property <string> meta-prefix: "#" + item.number + " " + I18n.pr-list-by + " " + pr-row.display-author
                    + (item.state == "merged"
                        ? " " + I18n.pr-list-was-merged + " "
                        : (item.state == "closed"
                            ? " " + I18n.pr-list-was-closed + " "
                            : " " + I18n.pr-list-was-opened + " "));
                private property <bool> has-branches: item.target-branch != ""
                    && item.source-branch != "";
                private property <string> review-status-label: item.review-status == "approved"
                    ? I18n.pr-review-approved
                    : (item.review-status == "review_required"
                        ? I18n.pr-list-review-required
                        : (item.review-status == "changes_requested" ? I18n.pr-list-changes-requested : ""));
                private property <string> review-status-tooltip: item.review-status == "approved"
                    ? I18n.pr-list-approving-review-tooltip
                    : (item.review-status == "review_required"
                        ? I18n.pr-list-awaiting-review-tooltip
                        : (item.review-status == "changes_requested"
                            ? I18n.pr-list-changes-requested-tooltip
                            : ""));
                private property <length> meta-max-width: max(
                    0px,
                    parent.width - self.content-x - 16px,
                );
                private property <length> review-status-width: self.review-status-label == "" ? 0px : review-status-measure.preferred-width;
                private property <length> conflict-status-width: item.state == "closed" || item.state == "merged" ? 0px : conflict-badge.preferred-width;
                private property <length> meta-prefix-width: min(
                    meta-prefix-measure.preferred-width,
                    max(
                        0px,
                        self.meta-max-width - time-measure.preferred-width - 6px,
                    ),
                );
                private property <length> time-width: min(
                    time-measure.preferred-width,
                    max(
                        0px,
                        self.meta-max-width - self.meta-prefix-width - 6px,
                    ),
                );
                // Follow GitHub's inline metadata flow. Each complete segment
                // wraps only when it no longer fits, without reserved columns.
                private property <length> metadata-end: self.content-x + self.meta-prefix-width + 6px + self.time-width;
                private property <length> content-right: self.content-x + self.meta-max-width;
                private property <bool> review-wraps: self.metadata-end + 16px + self.review-status-width > self.content-right;
                private property <length> review-x: self.review-wraps ? self.content-x : self.metadata-end + 16px;
                private property <length> review-y: self.metadata-y + (self.review-wraps ? self.metadata-line-height : 0px);
                private property <length> before-conflict-end: self.review-status-width > 0px ? self.review-x + self.review-status-width : self.metadata-end;
                private property <length> before-conflict-y: self.review-status-width > 0px ? self.review-y : self.metadata-y;
                private property <bool> conflict-wraps: self.before-conflict-end + 16px + self.conflict-status-width > self.content-right;
                private property <length> conflict-x: self.conflict-wraps ? self.content-x : self.before-conflict-end + 16px;
                private property <length> conflict-y: self.before-conflict-y + (self.conflict-wraps ? self.metadata-line-height : 0px);
                private property <length> before-branches-end: self.conflict-status-width > 0px ? self.conflict-x + self.conflict-status-width : self.before-conflict-end;
                private property <length> before-branches-y: self.conflict-status-width > 0px ? self.conflict-y : self.before-conflict-y;
                private property <length> branch-ideal-width: target-branch-measure.preferred-width + source-branch-measure.preferred-width + 48px;
                private property <bool> branches-wrap: self.before-branches-end + 16px + min(self.branch-ideal-width, 260px) > self.content-right;
                private property <length> branch-pair-x: self.branches-wrap ? self.content-x : self.before-branches-end + 16px;
                private property <length> branch-line-y: self.before-branches-y
                    + (self.branches-wrap ? self.metadata-line-height : 0px);
                private property <length> branch-chip-y: self.branch-line-y
                    + (self.metadata-line-height - self.branch-chip-height) / 2;
                private property <length> branch-pair-width: max(
                    0px,
                    self.meta-max-width - (self.branch-pair-x - self.content-x),
                );
                private property <length> branch-label-space: max(0px, self.branch-pair-width - 24px);
                private property <length> target-branch-width: min(
                    target-branch-measure.preferred-width + 12px,
                    self.branch-label-space / 2,
                );
                private property <length> source-branch-width: min(
                    source-branch-measure.preferred-width + 12px,
                    max(0px, self.branch-label-space - self.target-branch-width),
                );

                meta-prefix-measure := Text {
                    visible: false;
                    text: parent.meta-prefix;
                    font-size: parent.metadata-font-size;
                    wrap: no-wrap;
                }

                review-status-measure := Text {
                    visible: false;
                    text: parent.review-status-label;
                    font-size: parent.metadata-font-size;
                }

                time-measure := Text {
                    visible: false;
                    text: item.updated-at;
                    font-size: parent.metadata-font-size;
                    wrap: no-wrap;
                }

                target-branch-measure := Text {
                    visible: false;
                    text: item.target-branch;
                    font-family: root.code-font-family;
                    font-size: parent.branch-font-size;
                    font-italic: false;
                    wrap: no-wrap;
                }

                source-branch-measure := Text {
                    visible: false;
                    text: item.source-branch;
                    font-family: root.code-font-family;
                    font-size: parent.branch-font-size;
                    font-italic: false;
                    wrap: no-wrap;
                }

                metadata-prefix := Text {
                    x: parent.content-x;
                    y: parent.metadata-y + root.compact-text-offset-y * 1px;
                    width: parent.meta-prefix-width;
                    height: parent.metadata-line-height;
                    text: parent.meta-prefix;
                    font-size: parent.metadata-font-size;
                    color: root.fg-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                metadata-time := Text {
                    x: parent.content-x + parent.meta-prefix-width + 6px;
                    y: parent.metadata-y;
                    width: parent.time-width;
                    height: parent.metadata-line-height;
                    text: item.updated-at;
                    font-size: parent.metadata-font-size;
                    color: root.fg-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                time-touch := TouchArea {
                    x: parent.content-x + parent.meta-prefix-width + 6px;
                    y: parent.metadata-y;
                    width: parent.time-width;
                    height: parent.metadata-line-height;
                    z: 2;
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if self.has-hover && item.updated-at-tooltip != "" {
                            root.hovered-inline-tooltip = item.updated-at-tooltip;
                            root.hovered-inline-tooltip-x = self.absolute-position.x
                                - root.absolute-position.x;
                            root.hovered-inline-tooltip-y = self.absolute-position.y
                                - root.absolute-position.y;
                            root.hovered-inline-tooltip-width = self.width;
                            root.hovered-inline-tooltip-height = self.height;
                        } else if root.hovered-inline-tooltip == item.updated-at-tooltip {
                            root.hovered-inline-tooltip = "";
                        }
                    }
                    clicked => {
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                conflict-badge := GitHubConflictStatus {
                    z: 2;
                    visible: pr-row.conflict-status-width > 0px;
                    x: parent.conflict-x;
                    y: parent.conflict-y;
                    width: parent.conflict-status-width;
                    status: item.conflict-status;
                    clicked => {root.open-detail(item.number,item.title,item.author,item.source-branch,item.target-branch,item.updated-at-raw,3);}
                }

                Text {
                    visible: pr-row.review-status-width > 0px && !pr-row.review-wraps;
                    x: parent.review-x - 12px;
                    y: parent.review-y;
                    width: 8px; height: parent.metadata-line-height;
                    text: "·"; font-size: parent.metadata-font-size;
                    color: root.fg-muted; vertical-alignment: center;
                    horizontal-alignment: center;
                }
                Text {
                    visible: pr-row.conflict-status-width > 0px && !pr-row.conflict-wraps;
                    x: parent.conflict-x - 12px;
                    y: parent.conflict-y;
                    width: 8px; height: parent.metadata-line-height;
                    text: "·"; font-size: parent.metadata-font-size;
                    color: root.fg-muted; vertical-alignment: center;
                    horizontal-alignment: center;
                }

                if pr-row.review-status-label != "": review-status := FocusScope {
                    z: 2;
                    x: parent.review-x;
                    y: parent.review-y;
                    width: parent.review-status-width;
                    height: parent.metadata-line-height;
                    accessible-role: button;
                    accessible-enabled: true;
                    accessible-label: parent.review-status-label + ". " + I18n.pr-list-open-conversation;
                    private property <bool> keyboard-focus-visible: false;

                    key-pressed(event) => {
                        self.keyboard-focus-visible = true;
                        if event.text == Key.Return || event.text == " " {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                            return accept;
                        }
                        return reject;
                    }
                    focus-gained(reason) => {
                        self.keyboard-focus-visible = reason == FocusReason.tab-navigation;
                    }
                    focus-lost => { self.keyboard-focus-visible = false; }

                    Text {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: pr-row.review-status-label;
                        font-size: pr-row.metadata-font-size;
                        color: review-status-touch.has-hover || review-status.has-focus
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if review-status.has-focus && review-status.keyboard-focus-visible: Rectangle {
                        x: -2px;
                        y: 1px;
                        width: parent.width + 4px;
                        height: parent.height - 2px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: GitHubTheme.focus-outline;
                        background: transparent;
                    }
                    review-status-touch := TouchArea {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = pr-row.review-status-tooltip;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == pr-row.review-status-tooltip {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            parent.keyboard-focus-visible = false;
                            parent.focus();
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                        }
                    }
                }

                if pr-row.has-branches: target-branch-chip := Rectangle {
                    x: parent.branch-pair-x;
                    y: parent.branch-chip-y;
                    width: parent.target-branch-width;
                    height: parent.branch-chip-height;
                    border-radius: 6px;
                    background: GitHubTheme.accent-subtle;
                    clip: true;

                    target-branch-label := Text {
                        x: 6px;
                        y: root.compact-text-offset-y * 1px;
                        width: max(0px, parent.width - 12px);
                        height: parent.height;
                        text: item.target-branch;
                        font-family: root.code-font-family;
                        font-size: pr-row.branch-font-size;
                        font-italic: false;
                        color: root.fg-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    target-branch-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        z: 2;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover && item.target-branch != "" {
                                root.hovered-inline-tooltip = item.target-branch;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == item.target-branch {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                        }
                    }
                }

                if pr-row.has-branches: Text {
                    x: parent.branch-pair-x + parent.target-branch-width + 4px;
                    y: parent.branch-chip-y;
                    width: 16px;
                    height: parent.branch-chip-height;
                    text: "←";
                    font-size: 14px;
                    color: root.fg-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if pr-row.has-branches: source-branch-chip := Rectangle {
                    x: parent.branch-pair-x + parent.target-branch-width + 24px;
                    y: parent.branch-chip-y;
                    width: parent.source-branch-width;
                    height: parent.branch-chip-height;
                    border-radius: 6px;
                    background: GitHubTheme.accent-subtle;
                    clip: true;

                    source-branch-label := Text {
                        x: 6px;
                        y: root.compact-text-offset-y * 1px;
                        width: max(0px, parent.width - 12px);
                        height: parent.height;
                        text: item.source-branch;
                        font-family: root.code-font-family;
                        font-size: pr-row.branch-font-size;
                        font-italic: false;
                        color: root.fg-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    source-branch-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        z: 2;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover && item.source-branch != "" {
                                root.hovered-inline-tooltip = item.source-branch;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == item.source-branch {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                        }
                    }
                }

                conversation-count-measure := Text {
                    visible: false;
                    text: item.conversation-count;
                    font-size: 12px;
                }

                conversation-action := Rectangle {
                    x: parent.width - parent.action-width - 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: parent.conversation-action-width;
                    height: 32px;
                    border-radius: 6px;
                    background: transparent;
                    z: 3;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-comment-discussion-16.svg");
                        colorize: conversation-touch.has-hover
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                    }
                    if item.conversation-count > 0: conversation-count := Text {
                        x: 28px;
                        width: max(0px, parent.width - 32px);
                        height: parent.height;
                        text: item.conversation-count;
                        font-size: 12px;
                        color: conversation-touch.has-hover
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                        vertical-alignment: center;
                    }
                    conversation-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = I18n.pr-list-open-conversation;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == I18n.pr-list-open-conversation {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                        }
                    }
                }

                ai-review-action := Rectangle {
                    x: parent.width - parent.stop-action-width - parent.stop-action-gap
                        - parent.ai-action-width - 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: parent.ai-action-width;
                    height: 32px;
                    background: transparent;
                    z: 3;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                        colorize: item.ai-review-status == "completed"
                            ? GitHubTheme.success-fg
                            : (item.ai-review-status == "failed"
                                ? GitHubTheme.danger-fg
                                : (ai-review-touch.has-hover
                                    ? GitHubTheme.accent-fg
                                    : root.fg-muted));
                    }
                    if item.ai-review-status == "queued" || item.ai-review-status == "running": Rectangle {
                        x: 22px;
                        y: 4px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: GitHubTheme.accent-fg;
                    }
                    ai-review-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = item.ai-review-status == "queued"
                                    ? I18n.pr-list-ai-review-queued
                                    : (item.ai-review-status == "running"
                                        ? I18n.pr-list-ai-review-in-progress
                                        : (item.ai-review-status == "completed"
                                            ? I18n.pr-list-open-ai-review + " (" + item.ai-review-finding-count + ")"
                                            : (item.ai-review-status == "failed"
                                                ? I18n.pr-list-ai-review-failed
                                                : I18n.pr-list-review-with-ai)));
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.hovered-inline-tooltip = "";
                            if item.ai-review-status == "completed"
                                || item.ai-review-status == "queued"
                                || item.ai-review-status == "running" {
                                root.open-ai-review(item.ai-review-task-id);
                            } else {
                                root.start-ai-review(
                                item.number,
                                item.title,
                                item.source-branch,
                                item.target-branch,
                                );
                            }
                        }
                    }
                }

                cancel-ai-review-action := GitHubIconButton {
                    x: parent.width - GitHubMetrics.control-xsmall-size - 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    z: 3;
                    opacity: parent.ai-review-active ? 1 : 0;
                    control-size: GitHubMetrics.control-xsmall-size;
                    visual-size: GitHubMetrics.size-16;
                    glyph-size: GitHubMetrics.icon-medium;
                    icon: @image-url("../../assets/icons/github-stop-square-fill-16.svg");
                    tooltip-text: I18n.pr-list-cancel-review;
                    tooltip-align-right: true;
                    inverse: true;
                    circular: true;
                    button-enabled: parent.ai-review-active;
                    clicked => { root.cancel-ai-review(item.ai-review-task-id); }
                }

                row-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    z: 1;
                    mouse-cursor: pointer;
                    clicked => {
                        pr-row.keyboard-focus-visible = false;
                        row-focus.focus();
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                if row-focus.has-focus && pr-row.keyboard-focus-visible: Rectangle {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: GitHubTheme.focus-outline;
                    background: transparent;
                    z: 3;
                }
            }
        }
        }

        // Shared Primer links stay centered below, outside the bordered list.
        if root.show-pagination: GitHubPagination {
            width: parent.width;
            vertical-stretch: 0;
            current-page: root.pr-page;
            page-count: root.pr-page-count;
            pages: root.pr-page-links;
            page-selected(page) => { root.change-page(page); }
        }
    }

    GitHubTooltip {
        x: root.hovered-inline-tooltip-x;
        y: root.hovered-inline-tooltip-y;
        width: root.hovered-inline-tooltip-width;
        height: root.hovered-inline-tooltip-height;
        z: 200;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.Center;
        text: root.hovered-inline-tooltip;
    }

}
