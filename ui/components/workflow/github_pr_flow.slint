import { GitHubTooltip } from "../github_tooltip.slint";
import { GitHubTooltipAlignment, GitHubTooltipPlacement } from "../../state/tooltip_overlay_state.slint";
import { GitHubActionMenu } from "../github_action_menu.slint";
import { GitHubCenteredLoadingState } from "../github_spinner.slint";
import { GitHubButton } from "../settings/github_settings_controls.slint";
import { GitHubFilterMenuButton } from "../github_filter_menu.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";

















import { GitHubPullRequestSearchField, GitHubPullRequestClearQueryButton, GitHubPullRequestStateButton, GitHubPullRequestFilterMoreButton, GitHubPullRequestFilterMenu, GitHubPullRequestListStatePanel, WorkflowPullRequestItem } from "./github_pr_list_components.slint";
export { WorkflowPullRequestItem } from "./github_pr_list_components.slint";
export component GitHubPullRequestFlow {
    in property <length> viewport-global-x: 0px;
    in property <length> viewport-global-y: 0px;
    in property <length> viewport-width: 0px;
    in property <length> viewport-height: 0px;
    in property <string> code-font-family: "Menlo";
    in property <string> repo-project-id;
    in property <string> repo-type;
    in property <[WorkflowPullRequestItem]> pr-items: [];
    in property <int> pr-total: 0;
    in property <bool> pr-total-exact: false;
    in property <int> pr-open-total: -1;
    in property <int> pr-closed-total: -1;
    in property <int> pr-page: 1;
    in property <int> pr-page-count: 1;
    in property <string> pr-state: "open";
    in property <string> pr-query: "is:pr is:open";
    in property <string> pr-review-filter: "all";
    in property <string> pr-assignee-filter: "any";
    in property <string> pr-sort-filter: "newest";
    in property <bool> pr-loading: false;
    in property <string> pr-error: "";
    callback change-state(string);
    callback change-query(string);
    callback change-page(int);
    callback change-review-filter(string);
    callback change-assignee-filter(string);
    callback change-sort-filter(string);
    callback open-detail(string, string, string, string, string, string, int);

    private property <string> active-menu: "";
    private property <string> hovered-inline-tooltip: "";
    private property <length> hovered-inline-tooltip-x: 42px;
    private property <length> hovered-inline-tooltip-y: 0px;
    private property <length> hovered-inline-tooltip-width: 1px;
    private property <length> hovered-inline-tooltip-height: 1px;
    private property <bool> compact-filters: root.width < 620px;
    private property <bool> wrap-row-branches: root.width < 760px;
    private property <bool> canonical-state-query:
        (root.pr-state == "open" && root.pr-query == "is:pr is:open")
        || (root.pr-state == "closed" && root.pr-query == "is:pr is:closed");
    private property <length> query-area-height: root.canonical-state-query ? 48px : 80px;
    private property <bool> supports-review-filter: root.repo-type == "github";
    private property <bool> supports-assignee-filter: root.repo-type == "github"
        || root.repo-type == "gitlab";
    // GitHub keeps state and filter actions on one compact toolbar row.
    private property <length> header-height: 48px;
    private property <string> empty-title: root.pr-state == "open"
        ? "There aren’t any open pull requests."
        : (root.pr-state == "merged"
            ? "There aren’t any merged pull requests."
            : "There aren’t any closed pull requests.");
    private property <color> canvas-default: GitHubTheme.canvas-default;
    private property <color> canvas-subtle: GitHubTheme.canvas-subtle;
    private property <color> border-default: GitHubTheme.border-default;
    private property <color> fg-default: GitHubTheme.fg-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    private property <length> list-height: root.pr-loading || root.pr-error != "" || root.pr-items.length == 0
        ? root.header-height + 320px
        : root.header-height + visible-rows.preferred-height;
    private property <bool> show-pagination: !root.pr-loading
        && root.pr-error == ""
        && root.pr-items.length > 0
        && root.pr-page-count > 1;
    // Footer is 16px gap + 32px controls + 8px trailing inset below the card.
    private property <length> pagination-block-height: root.show-pagination ? 56px : 0px;
    // Capture the real trigger edge when opening. Label typography can then
    // change without drifting the end-aligned overlay away from its button.
    private property <length> menu-anchor-right: 0px;
    // Lock geometry so a taller Workflow panel cannot stretch the list card
    // and pull the pagination footer inside its border.
    height: root.query-area-height + root.list-height + root.pagination-block-height;
    vertical-stretch: 0;

    // Same stacking contract as the review-workspace Diff view / file-filter /
    // readiness popovers: dismiss is mounted under the interactive chrome so
    // the first click on another filter switches menus instead of only closing.
    // Slint rectangles alone do not capture pointer input; the TouchArea must
    // own the hit target. Full-window absolute positioning matches the
    // status-bar outside-click pattern for clicks outside the list card.
    if root.active-menu != "": Rectangle {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: 9999px;
        height: 9999px;
        z: 0;
        background: transparent;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: default;
            clicked => { root.active-menu = ""; }
        }
    }

    search-field := GitHubPullRequestSearchField {
        x: 0px;
        y: 0px;
        width: root.width;
        text: root.pr-query;
        accepted(query) => { root.change-query(query); }
    }

    if !root.canonical-state-query: GitHubPullRequestClearQueryButton {
        x: 0px;
        y: 40px;
        clicked => { root.change-query("is:pr is:open"); }
    }

    // Keep the card and pager in one explicit layout. Absolute y coordinates
    // can still be compressed by an ancestor's layout constraints; a real
    // sibling layout preserves the 16px gap even on a tall Closed page.
    content-layout := VerticalLayout {
        y: root.query-area-height;
        width: root.width;
        height: root.height - root.query-area-height;
        spacing: root.show-pagination ? 16px : 0px;
        alignment: start;

        pr-list := Rectangle {
            width: parent.width;
            height: root.list-height;
            vertical-stretch: 0;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.border-default;
            background: root.canvas-default;
            clip: true;

            header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.header-height;
                z: 10;
                background: root.canvas-subtle;

            if root.canonical-state-query: HorizontalLayout {
                x: 4px;
                width: open-state-btn.width + closed-state-btn.width;
                height: parent.height;
                spacing: 0px;
                open-state-btn := GitHubPullRequestStateButton {
                    label: "Open";
                    value: "open";
                    selected-value: root.pr-state;
                    count: root.pr-open-total;
                    selected(value) => { root.change-state(value); }
                }
                closed-state-btn := GitHubPullRequestStateButton {
                    label: "Closed";
                    value: "closed";
                    selected-value: root.pr-state;
                    count: root.pr-closed-total;
                    selected(value) => { root.change-state(value); }
                }
            }

            if !root.canonical-state-query: GitHubPullRequestStateButton {
                x: 4px;
                label: "Total";
                value: "total";
                selected-value: "total";
                count: root.pr-total-exact ? root.pr-total : -1;
                selected(value) => { }
            }

            // Keep status and filters on one GitHub-style toolbar row.
            // Same stacking contract as Diff view / file-filter / readiness
            // on the review workspace: triggers stay above the dismiss layer
            // so the first click switches menus.
            filter-bar-host := Rectangle {
                x: 4px;
                y: 8px;
                width: parent.width - 8px;
                height: 32px;
                z: 95;
                background: transparent;

                filter-bar := HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    alignment: end;

                    if !root.compact-filters && root.supports-review-filter: reviews-btn := GitHubFilterMenuButton {
                        label: "Reviews";
                        menu-open: root.active-menu == "reviews";
                        selected: root.active-menu == "reviews" || root.pr-review-filter != "all";
                        clicked => {
                            root.menu-anchor-right = self.absolute-position.x
                                - root.absolute-position.x + self.width;
                            root.active-menu = root.active-menu == "reviews" ? "" : "reviews";
                        }
                    }
                    if !root.compact-filters && root.supports-assignee-filter: assignee-btn := GitHubFilterMenuButton {
                        label: "Assignee";
                        menu-open: root.active-menu == "assignee";
                        selected: root.active-menu == "assignee" || root.pr-assignee-filter != "any";
                        clicked => {
                            root.menu-anchor-right = self.absolute-position.x
                                - root.absolute-position.x + self.width;
                            root.active-menu = root.active-menu == "assignee" ? "" : "assignee";
                        }
                    }
                    if !root.compact-filters: sort-btn := GitHubFilterMenuButton {
                        label: "Sort";
                        menu-open: root.active-menu == "sort";
                        selected: root.active-menu == "sort" || root.pr-sort-filter != "newest";
                        clicked => {
                            root.menu-anchor-right = self.absolute-position.x
                                - root.absolute-position.x + self.width;
                            root.active-menu = root.active-menu == "sort" ? "" : "sort";
                        }
                    }
                    if root.compact-filters && root.supports-assignee-filter: GitHubFilterMenuButton {
                        label: "Assignee";
                        menu-open: root.active-menu == "assignee";
                        selected: root.active-menu == "assignee" || root.pr-assignee-filter != "any";
                        clicked => {
                            root.menu-anchor-right = self.absolute-position.x
                                - root.absolute-position.x + self.width;
                            root.active-menu = root.active-menu == "assignee" ? "" : "assignee";
                        }
                    }
                    if root.compact-filters: GitHubPullRequestFilterMoreButton {
                        selected: root.active-menu == (root.supports-review-filter ? "more" : "sort")
                            || (root.supports-review-filter && root.pr-review-filter != "all")
                            || root.pr-sort-filter != "newest";
                        clicked => {
                            root.menu-anchor-right = self.absolute-position.x
                                - root.absolute-position.x + self.width;
                            root.active-menu = root.active-menu
                                == (root.supports-review-filter ? "more" : "sort")
                                ? ""
                                : (root.supports-review-filter ? "more" : "sort");
                        }
                    }
                }
            }
        }

        if root.pr-loading: GitHubCenteredLoadingState {
            y: root.header-height;
            width: parent.width;
            height: parent.height - root.header-height;
            label: "Loading pull requests…";
            foreground: root.fg-muted;
        }

        if !root.pr-loading && root.pr-error != "": GitHubPullRequestListStatePanel {
            y: root.header-height;
            width: parent.width;
            error-state: true;
            title: "Unable to load pull requests";
            description: "Check your code hosting configuration or connection, then try again.";
            show-action: true;
            action => { root.change-page(root.pr-page); }
        }

        if !root.pr-loading && root.pr-error == "" && root.pr-items.length == 0: GitHubPullRequestListStatePanel {
            y: root.header-height;
            width: parent.width;
            title: root.empty-title;
            description: "Try another status filter.";
        }

        visible-rows := VerticalLayout {
            y: root.header-height;
            width: parent.width;
            height: self.preferred-height;
            visible: !root.pr-loading && root.pr-error == "" && root.pr-items.length > 0;
            spacing: 0px;
            alignment: start;

            for item[index] in root.pr-items: pr-row := Rectangle {
                width: parent.width;
                // GitHub PR list rows stay on the default canvas. The title is an
                // accent link; hover underlines the title instead of painting
                // Box-row--hover-gray across the row.
                background: transparent;
                private property <length> conversation-action-width: item.conversation-count > 0 ? 48px : 32px;
                private property <length> ai-action-width: 32px;
                private property <length> action-width: self.conversation-action-width + self.ai-action-width + 4px;
                private property <length> content-x: 38px;
                // StyledText provides stable paragraph line spacing for mixed
                // CJK/Latin titles where Text's glyph rows otherwise crowd.
                private property <length> title-max-width: max(
                    80px,
                    parent.width - self.content-x - self.action-width - 32px,
                );
                private property <bool> title-wraps: title-measure.preferred-width > self.title-max-width;
                private property <length> title-block-height: max(
                    root.wrap-row-branches ? 18px : 26px,
                    title-wrapped-measure.preferred-height,
                );
                private property <length> first-line-center-y:
                    self.title-wraps || root.wrap-row-branches ? 17px : 21px;
                private property <length> title-draw-width: self.title-wraps
                    ? self.title-max-width
                    : min(title-measure.preferred-width, self.title-max-width);
                private property <bool> keyboard-focus-visible: false;
                private property <length> metadata-y: 8px + self.title-block-height
                    + (self.title-wraps ? 4px : (root.wrap-row-branches ? 2px : 0px));
                private property <length> branch-chip-height: 22px;
                private property <length> branch-chip-y: root.wrap-row-branches
                    ? self.metadata-y + 26px
                    : self.metadata-y;
                private property <length> natural-row-height: root.wrap-row-branches && self.has-branches
                    ? self.branch-chip-y + self.branch-chip-height + 6px
                    : max(
                        root.wrap-row-branches ? 64px : 72px,
                        self.metadata-y + 22px + 8px,
                    );
                height: self.natural-row-height;

                row-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: button;
                    accessible-enabled: true;
                    accessible-label: item.title + ". Pull request " + item.number;
                    key-pressed(event) => {
                        pr-row.keyboard-focus-visible = true;
                        if event.text == Key.Return || event.text == " " {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                            return accept;
                        }
                        return reject;
                    }
                    focus-gained(reason) => {
                        pr-row.keyboard-focus-visible = reason == FocusReason.tab-navigation;
                    }
                    focus-lost => { pr-row.keyboard-focus-visible = false; }
                }

                if index > 0: Rectangle {
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: root.border-default;
                }

                Image {
                    x: 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: 16px;
                    height: 16px;
                    source: item.state == "merged"
                        ? @image-url("../../assets/icons/octicon-git-merge-16.svg")
                        : @image-url("../../assets/icons/octicon-git-pull-request-16.svg");
                    colorize: item.state == "merged"
                        ? (GitHubTheme.done-fg)
                        : (item.state == "closed"
                            ? (GitHubTheme.danger-fg)
                            : (GitHubTheme.success-fg));
                }

                title-measure := Text {
                    visible: false;
                    text: item.title;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                }

                title-wrapped-measure := StyledText {
                    visible: false;
                    width: parent.title-max-width;
                    text: @markdown("**\{item.title}**");
                    default-font-size: 14px;
                }

                title-clip := Rectangle {
                    x: parent.content-x;
                    y: 8px;
                    width: parent.title-max-width;
                    height: parent.title-block-height;
                    background: transparent;

                    if !title-touch.has-hover: StyledText {
                        width: parent.width;
                        height: parent.height;
                        text: @markdown("**\{item.title}**");
                        default-font-size: 14px;
                        default-color: root.fg-default;
                        horizontal-alignment: left;
                        vertical-alignment: pr-row.title-wraps || root.wrap-row-branches
                            ? top
                            : center;
                    }

                    // StyledText underlines each glyph run and each wrapped line.
                    // The measured host grows for every wrapped line.
                    if title-touch.has-hover: StyledText {
                        width: parent.width;
                        height: parent.height;
                        text: @markdown("<u>**\{item.title}**</u>");
                        default-font-size: 14px;
                        default-color: GitHubTheme.accent-fg;
                        horizontal-alignment: left;
                        vertical-alignment: pr-row.title-wraps || root.wrap-row-branches
                            ? top
                            : center;
                    }
                }

                title-touch := TouchArea {
                    x: parent.content-x;
                    y: 8px;
                    width: parent.title-draw-width;
                    height: parent.title-block-height;
                    z: 2;
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                private property <string> meta-prefix: "#" + item.number + " by " + item.author
                    + (item.state == "merged"
                        ? " was merged "
                        : (item.state == "closed" ? " was closed " : " was opened "));
                private property <bool> has-branches: item.target-branch != ""
                    && item.source-branch != "";
                // Gitee's mixed CJK/Latin metadata needs a small optical
                // correction; Latin-only GitHub/GitLab metadata does not.
                private property <length> time-visual-offset-y: root.repo-type == "gitee" ? 1px : 0px;
                private property <string> review-status-label: item.review-status == "approved"
                    ? "Approved"
                    : (item.review-status == "review_required"
                        ? "Review required"
                        : (item.review-status == "changes_requested" ? "Changes requested" : ""));
                private property <string> review-status-tooltip: item.review-status == "approved"
                    ? "This pull request has an approving review"
                    : (item.review-status == "review_required"
                        ? "This pull request is awaiting a required review"
                        : (item.review-status == "changes_requested"
                            ? "A reviewer requested changes"
                            : ""));
                private property <length> meta-max-width: max(
                    0px,
                    parent.width - self.content-x - 16px
                        - (root.wrap-row-branches ? self.action-width + 8px : 0px),
                );
                private property <length> inline-meta-budget: root.wrap-row-branches || !self.has-branches
                    ? self.meta-max-width
                    : max(0px, self.meta-max-width * 0.58);
                private property <length> review-status-width: self.review-status-label == ""
                    ? 0px
                    : min(review-status-measure.preferred-width + 14px, self.inline-meta-budget);
                private property <length> meta-prefix-width: min(
                    meta-prefix-measure.preferred-width,
                    max(
                        0px,
                        self.inline-meta-budget
                            - self.review-status-width
                            - time-measure.preferred-width,
                    ),
                );
                private property <length> time-width: min(
                    time-measure.preferred-width,
                    max(
                        0px,
                        self.inline-meta-budget
                            - self.meta-prefix-width
                            - self.review-status-width,
                    ),
                );
                private property <length> branch-pair-x: root.wrap-row-branches
                    ? self.content-x
                    : self.content-x
                        + self.meta-prefix-width
                        + self.time-width
                        + self.review-status-width
                        + 12px;
                private property <length> branch-pair-width: max(
                    0px,
                    self.meta-max-width - (self.branch-pair-x - self.content-x),
                );
                private property <length> branch-label-space: max(0px, self.branch-pair-width - 28px);
                private property <length> target-branch-width: min(
                    target-branch-measure.preferred-width + 16px,
                    self.branch-label-space / 2,
                );
                private property <length> source-branch-width: min(
                    source-branch-measure.preferred-width + 16px,
                    max(0px, self.branch-label-space - self.target-branch-width),
                );

                meta-prefix-measure := Text {
                    visible: false;
                    text: parent.meta-prefix;
                    font-size: 12px;
                    wrap: no-wrap;
                }

                time-measure := Text {
                    visible: false;
                    text: item.updated-at;
                    font-size: 12px;
                    wrap: no-wrap;
                }

                review-status-measure := Text {
                    visible: false;
                    text: parent.review-status-label;
                    font-size: 12px;
                    wrap: no-wrap;
                }

                target-branch-measure := Text {
                    visible: false;
                    text: item.target-branch;
                    font-family: root.code-font-family;
                    font-size: 13px;
                    wrap: no-wrap;
                }

                source-branch-measure := Text {
                    visible: false;
                    text: item.source-branch;
                    font-family: root.code-font-family;
                    font-size: 13px;
                    wrap: no-wrap;
                }

                Text {
                    x: parent.content-x;
                    y: parent.metadata-y;
                    width: parent.meta-prefix-width;
                    height: 22px;
                    text: parent.meta-prefix;
                    font-size: 12px;
                    color: root.fg-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    x: parent.content-x + parent.meta-prefix-width;
                    y: parent.metadata-y + parent.time-visual-offset-y;
                    width: parent.time-width;
                    height: 22px;
                    text: item.updated-at;
                    font-size: 12px;
                    color: root.fg-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                time-touch := TouchArea {
                    x: parent.content-x + parent.meta-prefix-width;
                    y: parent.metadata-y + parent.time-visual-offset-y;
                    width: parent.time-width;
                    height: 22px;
                    z: 2;
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if self.has-hover && item.updated-at-tooltip != "" {
                            root.hovered-inline-tooltip = item.updated-at-tooltip;
                            root.hovered-inline-tooltip-x = self.absolute-position.x
                                - root.absolute-position.x;
                            root.hovered-inline-tooltip-y = self.absolute-position.y
                                - root.absolute-position.y;
                            root.hovered-inline-tooltip-width = self.width;
                            root.hovered-inline-tooltip-height = self.height;
                        } else if root.hovered-inline-tooltip == item.updated-at-tooltip {
                            root.hovered-inline-tooltip = "";
                        }
                    }
                    clicked => {
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                if pr-row.review-status-label != "": review-status := FocusScope {
                    x: parent.content-x + parent.meta-prefix-width + parent.time-width;
                    y: parent.metadata-y;
                    width: parent.review-status-width;
                    height: 22px;
                    accessible-role: button;
                    accessible-enabled: true;
                    accessible-label: parent.review-status-label + ". Open pull request conversation";
                    private property <bool> keyboard-focus-visible: false;

                    key-pressed(event) => {
                        self.keyboard-focus-visible = true;
                        if event.text == Key.Return || event.text == " " {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                            return accept;
                        }
                        return reject;
                    }
                    focus-gained(reason) => {
                        self.keyboard-focus-visible = reason == FocusReason.tab-navigation;
                    }
                    focus-lost => { self.keyboard-focus-visible = false; }

                    Text {
                        x: 2px;
                        width: 10px;
                        height: parent.height;
                        text: "•";
                        font-size: 12px;
                        color: root.fg-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 14px;
                        width: max(0px, parent.width - 14px);
                        height: parent.height;
                        text: pr-row.review-status-label;
                        font-size: 12px;
                        color: review-status-touch.has-hover || review-status.has-focus
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                        vertical-alignment: center;
                        overflow: clip;
                    }
                    if review-status.has-focus && review-status.keyboard-focus-visible: Rectangle {
                        x: 11px;
                        y: 1px;
                        width: max(0px, parent.width - 9px);
                        height: parent.height - 2px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: GitHubTheme.focus-outline;
                        background: transparent;
                    }
                    review-status-touch := TouchArea {
                        x: 12px;
                        width: max(0px, parent.width - 12px);
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = pr-row.review-status-tooltip;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == pr-row.review-status-tooltip {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            parent.keyboard-focus-visible = false;
                            parent.focus();
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                        }
                    }
                }

                if pr-row.has-branches: target-branch-chip := Rectangle {
                    x: parent.branch-pair-x;
                    y: parent.branch-chip-y;
                    width: parent.target-branch-width;
                    height: parent.branch-chip-height;
                    border-radius: 6px;
                    background: GitHubTheme.accent-subtle;
                    clip: true;

                    Text {
                        x: 8px;
                        width: max(0px, parent.width - 16px);
                        height: parent.height;
                        text: item.target-branch;
                        font-family: root.code-font-family;
                        font-size: 13px;
                        color: root.fg-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    target-branch-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        z: 2;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover && item.target-branch != "" {
                                root.hovered-inline-tooltip = item.target-branch;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == item.target-branch {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                        }
                    }
                }

                if pr-row.has-branches: Text {
                    x: parent.branch-pair-x + parent.target-branch-width + 6px;
                    y: parent.branch-chip-y;
                    width: 16px;
                    height: parent.branch-chip-height;
                    text: "←";
                    font-size: 16px;
                    color: root.fg-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if pr-row.has-branches: source-branch-chip := Rectangle {
                    x: parent.branch-pair-x + parent.target-branch-width + 28px;
                    y: parent.branch-chip-y;
                    width: parent.source-branch-width;
                    height: parent.branch-chip-height;
                    border-radius: 6px;
                    background: GitHubTheme.accent-subtle;
                    clip: true;

                    Text {
                        x: 8px;
                        width: max(0px, parent.width - 16px);
                        height: parent.height;
                        text: item.source-branch;
                        font-family: root.code-font-family;
                        font-size: 13px;
                        color: root.fg-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    source-branch-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        z: 2;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover && item.source-branch != "" {
                                root.hovered-inline-tooltip = item.source-branch;
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == item.source-branch {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                        }
                    }
                }

                conversation-action := Rectangle {
                    x: parent.width - parent.action-width - 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: parent.conversation-action-width;
                    height: 32px;
                    border-radius: 6px;
                    background: transparent;
                    z: 3;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-comment-discussion-16.svg");
                        colorize: conversation-touch.has-hover
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                    }
                    if item.conversation-count > 0: Text {
                        x: 28px;
                        width: max(0px, parent.width - 32px);
                        height: parent.height;
                        text: item.conversation-count;
                        font-size: 12px;
                        color: conversation-touch.has-hover
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                        vertical-alignment: center;
                    }
                    conversation-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = "Open Conversation";
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == "Open Conversation" {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                0,
                            );
                        }
                    }
                }

                ai-review-action := Rectangle {
                    x: parent.width - parent.ai-action-width - 16px;
                    y: parent.first-line-center-y - self.height / 2;
                    width: parent.ai-action-width;
                    height: 32px;
                    background: transparent;
                    z: 3;

                    Image {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/octicon-copilot-16.svg");
                        colorize: ai-review-touch.has-hover
                            ? GitHubTheme.accent-fg
                            : root.fg-muted;
                    }
                    ai-review-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered-inline-tooltip = "Review pull request with AI";
                                root.hovered-inline-tooltip-x = self.absolute-position.x
                                    - root.absolute-position.x;
                                root.hovered-inline-tooltip-y = self.absolute-position.y
                                    - root.absolute-position.y;
                                root.hovered-inline-tooltip-width = self.width;
                                root.hovered-inline-tooltip-height = self.height;
                            } else if root.hovered-inline-tooltip == "Review pull request with AI" {
                                root.hovered-inline-tooltip = "";
                            }
                        }
                        clicked => {
                            root.open-detail(
                                item.number,
                                item.title,
                                item.author,
                                item.source-branch,
                                item.target-branch,
                                item.updated-at-raw,
                                2,
                            );
                        }
                    }
                }

                row-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    z: 1;
                    mouse-cursor: pointer;
                    clicked => {
                        pr-row.keyboard-focus-visible = false;
                        row-focus.focus();
                        root.open-detail(
                            item.number,
                            item.title,
                            item.author,
                            item.source-branch,
                            item.target-branch,
                            item.updated-at-raw,
                            2,
                        );
                    }
                }

                if row-focus.has-focus && pr-row.keyboard-focus-visible: Rectangle {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: GitHubTheme.focus-outline;
                    background: transparent;
                    z: 3;
                }
            }
        }
        }

        // Pagination is a full-width footer sibling. The compact control group
        // is centered inside it instead of positioning the footer itself.
        if root.show-pagination: Rectangle {
            width: parent.width;
            height: 32px;
            vertical-stretch: 0;

            pager-controls := Rectangle {
                x: max(0px, (parent.width - self.width) / 2);
                width: min(parent.width, 284px);
                height: parent.height;

                GitHubButton {
                    x: 0px;
                    width: 84px;
                    text: "Previous";
                    disabled: !(root.pr-page > 1 && !root.pr-loading);
                    clicked => { root.change-page(root.pr-page - 1); }
                }
                Text {
                    x: 96px;
                    width: max(0px, parent.width - 192px);
                    height: parent.height;
                    text: "Page " + root.pr-page + " / " + root.pr-page-count;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: root.fg-muted;
                }
                GitHubButton {
                    x: parent.width - self.width;
                    width: 84px;
                    text: "Next";
                    disabled: !(root.pr-page < root.pr-page-count && !root.pr-loading);
                    clicked => { root.change-page(root.pr-page + 1); }
                }
            }
        }
    }

    GitHubTooltip {
        x: root.hovered-inline-tooltip-x;
        y: root.hovered-inline-tooltip-y;
        width: root.hovered-inline-tooltip-width;
        height: root.hovered-inline-tooltip-height;
        z: 200;
        preferred-placement: GitHubTooltipPlacement.Bottom;
        alignment: GitHubTooltipAlignment.Center;
        text: root.hovered-inline-tooltip;
    }

    if root.active-menu != "": GitHubActionMenu {
        z: 100;
        open: root.active-menu != "";
        viewport-x: root.viewport-global-x - root.absolute-position.x;
        viewport-y: root.viewport-global-y - root.absolute-position.y;
        viewport-width: root.viewport-width;
        viewport-height: root.viewport-height;
        anchor-x: root.menu-anchor-right;
        anchor-y: 0px;
        anchor-width: 0px;
        anchor-height: root.header-height;
        menu-width: 200px;
        content-height: root.active-menu == "assignee"
            ? 128px
            : (root.active-menu == "more" ? 313px : 160px);
        menu-max-height: 432px;
        align: "end";
        dismiss-requested => { root.active-menu = ""; }

        GitHubPullRequestFilterMenu {
            width: parent.width;
            menu-type: root.active-menu;
            review-selected-value: root.pr-review-filter;
            assignee-selected-value: root.pr-assignee-filter;
            sort-selected-value: root.pr-sort-filter;
            selected(kind, value) => {
                if kind == "reviews" {
                    root.change-review-filter(value);
                } else if kind == "assignee" {
                    root.change-assignee-filter(value);
                } else {
                    root.change-sort-filter(value);
                }
                root.active-menu = "";
            }
            close => { root.active-menu = ""; }
        }
    }
}
