import { GitHubTagAddPanel } from "./github_tag_add_panel.slint";
import { GitHubTagRemovePanel } from "./github_tag_remove_panel.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";
import { GitHubSegmentedControl } from "../github_segmented_control.slint";
import { GitHubUnderlineNav, GitHubUnderlineNavItem } from "../navigation/github_underline_nav.slint";
// GitHub Primer UnderlineNav item. Durable contract:
// docs/specs/ui-design.md “UnderlineNav tabs”.


export component GitHubTagFlow {
    in property <bool> active: false;
    in property <string> mode: "local";
    in property <string> version-mode: "patch";
    in property <string> current-version: "v0.0.0";
    in-out property <string> next-version: "v0.0.1";
    in-out property <string> remove-target: "";
    in-out property <string> description: "";
    in property <bool> add-initializing: false;
    in property <bool> remove-initializing: false;
    in property <bool> running: false;
    in property <bool> has-run: false;
    in property <string> result: I18n.workflow-ready-tags;
    callback change-mode(string);
    callback select-version-mode(string);
    callback run(string, string);
    callback draft-edited(string,string,string);
    callback remove-tag(string);
    callback open-add-tab();
    callback open-remove-tab();
    callback view-run();

    in-out property <int> selected-tab: 0; // 0: Add, 1: Remove
    private property <color> canvas-default: GitHubTheme.canvas-default;
    private property <color> border-default: GitHubTheme.border-default;
    private property <color> fg-muted: GitHubTheme.fg-muted;
    width: 100%;
    content := VerticalLayout {
        width: root.width;
        spacing: 0px;
        alignment: start;

        // Scope is repository context, not an Add/Remove tab. Keep it on its
        // own compact toolbar above the UnderlineNav, aligned to the left.
        scope-row := Rectangle {
            width: parent.width;
            height: 36px;
            background: root.canvas-default;

            scope-group := HorizontalLayout {
                x: 0px;
                y: 4px;
                height: 28px;
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Text {
                    height: 28px;
                    text: I18n.tag-scope;
                    font-size: 12px;
                    font-weight: 600;
                    color: root.fg-muted;
                    vertical-alignment: center;
                }

                GitHubSegmentedControl {
                    group-label: I18n.tag-repository-scope;
                    control-size: 28px;
                    items: [
                        { label: I18n.workflow-local, count: -1, count-suffix-offset: 0, enabled: !root.running },
                        { label: I18n.workflow-remote, count: -1, count-suffix-offset: 0, enabled: !root.running },
                    ];
                    selected-index: root.mode == "remote" ? 1 : 0;
                    selection-changed(index) => { root.change-mode(index == 0 ? "local" : "remote"); }
                }
            }
        }

        // GitHub UnderlineNav for the actual tag operations.
        tabs-row := GitHubUnderlineNav {
            width: parent.width;
            height: 48px;
            group-label: I18n.tag-operations;
            owner: "tag-operations";
            selected-index: root.selected-tab;
            items: [{ label: I18n.tag-add }, { label: I18n.tag-remove }];
            selected(index) => {
                root.selected-tab = index;
                if index == 0 { root.open-add-tab(); } else { root.open-remove-tab(); }
            }
        }

        Rectangle { width: parent.width; height: 12px; background: transparent; }

        if root.selected-tab == 0: Rectangle {
            border-width: 1px;
            border-color: root.border-default;
            border-radius: 6px;
            background: root.canvas-default;

            GitHubTagAddPanel {
                width: parent.width;
                initializing: root.add-initializing;
                scope-mode: root.mode;
                version-mode: root.version-mode;
                current-version: root.current-version;
                next-version <=> root.next-version;
                description <=> root.description;
                running: root.running;
                has-run: root.has-run;
                select-version-mode(mode) => {
                    root.select-version-mode(mode);
                }
                draft-edited(next,description) => { root.draft-edited(next,root.remove-target,description); }
                run(version, description) => {
                    root.run(version, description);
                }
                view-run => {
                    root.view-run();
                }
            }
        }

        if root.selected-tab == 1: Rectangle {
            border-width: 1px;
            border-color: root.border-default;
            border-radius: 6px;
            background: root.canvas-default;

            GitHubTagRemovePanel {
                width: parent.width;
                tag-to-remove <=> root.remove-target;
                initializing: root.remove-initializing;
                running: root.running;
                has-run: root.has-run;
                target-edited(target) => { root.draft-edited(root.next-version,target,root.description); }
                remove-tag(tag) => {
                    root.remove-tag(tag);
                }
                view-run => {
                    root.view-run();
                }
            }
        }
    }

    height: content.preferred-height;
}
