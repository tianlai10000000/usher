import { GitHubTagField, GitHubTagReadonlyField } from "./fields.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";
import { GitHubTagActionButton } from "./tag_controls.slint";
import { GitHubSegmentedControl } from "../github_segmented_control.slint";

export component GitHubTagAddPanel {
    in property <string> version-mode: "patch";
    in property <string> scope-mode: "local";
    in property <string> current-version: "v0.0.0";
    in-out property <string> next-version: "v0.0.1";
    in property <bool> initializing: false;
    in property <bool> running: false;
    in property <bool> has-run: false;
    callback select-version-mode(string);
    callback run(string, string);
    callback draft-edited(string,string);
    callback view-run();

    in-out property <string> description: "";
    private property <bool> stacked-fields: root.width < 1020px;
    width: 100%;
    height: panel-content.preferred-height;
    vertical-stretch: 0;

    panel-content := VerticalLayout {
        width: 100%;
        spacing: 16px;
        alignment: start;
        padding: 8px;

        // Primer SegmentedControl for bump size (replaces separate chips).
        HorizontalLayout {
            width: parent.width;
            height: 28px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            Text {
                height: 28px;
                text: I18n.tag-bump;
                font-size: 12px;
                font-weight: 600;
                color: GitHubTheme.fg-muted;
                vertical-alignment: center;
                vertical-stretch: 0;
            }

            GitHubSegmentedControl {
                group-label: I18n.tag-semantic-bump;
                control-size: 28px;
                items: [
                    { label: I18n.tag-patch, count: -1, count-suffix-offset: 0, enabled: !root.running && !root.initializing },
                    { label: I18n.tag-minor, count: -1, count-suffix-offset: 0, enabled: !root.running && !root.initializing },
                    { label: I18n.tag-major, count: -1, count-suffix-offset: 0, enabled: !root.running && !root.initializing },
                ];
                selected-index: root.version-mode == "patch" ? 0 : root.version-mode == "minor" ? 1 : 2;
                selection-changed(index) => {
                    root.select-version-mode(index == 0 ? "patch" : index == 1 ? "minor" : "major");
                }
            }
        }

        if !root.stacked-fields: HorizontalLayout {
            width: parent.width - 16px - 12px;
            spacing: 12px;

            GitHubTagReadonlyField {
                width: parent.width / 2;
                label: I18n.tag-current-version;
                value: root.current-version;
            }

            GitHubTagField {
                width: parent.width / 2;
                label: I18n.tag-new-version;
                value <=> root.next-version;
                edited(value) => { root.draft-edited(value,root.description); }
                placeholder: "v1.2.3";
                enabled: !root.running && !root.initializing;
                min-field-width: 160px;
            }
        }

        if root.stacked-fields: VerticalLayout {
            width: parent.width - 16px;
            spacing: 12px;

            GitHubTagReadonlyField {
                width: parent.width;
                label: I18n.tag-current-version;
                value: root.current-version;
            }

            GitHubTagField {
                width: parent.width;
                label: I18n.tag-new-version;
                value <=> root.next-version;
                edited(value) => { root.draft-edited(value,root.description); }
                placeholder: "v1.2.3";
                enabled: !root.running && !root.initializing;
                min-field-width: 160px;
            }
        }

        GitHubTagField {
            width: 100%;
            label: I18n.tag-description;
            value <=> root.description;
            edited(value) => { root.draft-edited(root.next-version,value); }
            placeholder: "";
            enabled: !root.running && !root.initializing;
        }

        // alignment=start keeps Create on the left; Stop sits beside it while
        // the run is latched so it does not jump to the trailing edge.
        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            alignment: start;
            cross-axis-alignment: center;
            height: 32px;

            GitHubTagActionButton {
                enabled: !root.running && !root.initializing;
                loading: root.initializing;
                label: root.initializing ? I18n.tag-loading : I18n.tag-create;
                clicked => {
                    root.run(root.next-version, root.description);
                }
            }

            if root.has-run: GitHubTagActionButton {
                label: root.running ? I18n.tag-view-running-job : I18n.tag-view-latest-job;
                action-primary: false;
                clicked => {
                    root.view-run();
                }
            }
        }
    }
}
