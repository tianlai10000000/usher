import { GitHubTagField } from "./fields.slint";
import { GitHubTagActionButton } from "./tag_controls.slint";
import { I18n } from "@i18n";

export component GitHubTagRemovePanel {
    in property <bool> running: false;
    in property <bool> initializing: false;
    in property <bool> has-run: false;
    in-out property <string> tag-to-remove: "";
    callback remove-tag(string);
    callback target-edited(string);
    callback view-run();

    width: 100%;
    height: panel-content.preferred-height;
    vertical-stretch: 0;

    panel-content := VerticalLayout {
        width: 100%;
        spacing: 16px;
        alignment: start;
        padding: 8px;
        padding-top: 16px;

        GitHubTagField {
            width: 100%;
            label: I18n.tag-to-remove;
            value <=> root.tag-to-remove;
            edited(value) => { root.target-edited(value); }
            placeholder: "v1.2.3";
            enabled: !root.running && !root.initializing;
        }

        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            alignment: start;
            cross-axis-alignment: center;
            height: 32px;

            GitHubTagActionButton {
                enabled: !root.running && !root.initializing;
                loading: root.initializing;
                label: root.initializing ? I18n.tag-loading : I18n.tag-remove;
                danger: true;
                clicked => {
                    root.remove-tag(root.tag-to-remove);
                }
            }

            if root.has-run: GitHubTagActionButton {
                label: root.running ? I18n.tag-view-running-job : I18n.tag-view-latest-job;
                action-primary: false;
                clicked => {
                    root.view-run();
                }
            }
        }
    }
}
