import { FactoryTooltipKind, FactoryTooltipState } from "../../state/factory_tooltip_state.slint";
import { GitHubFixedTooltipAnchor } from "../github_fixed_tooltip_anchor.slint";

export component ShowcaseMoreFiltersTooltipAnchor inherits GitHubFixedTooltipAnchor {
    bounded: FactoryTooltipState.enabled;
    viewport: FactoryTooltipState.viewport;
    publish(x, y, w, h) => { FactoryTooltipState.show(FactoryTooltipKind.MoreFilters, x, y, w, h); }
    release(x, y) => { FactoryTooltipState.hide(FactoryTooltipKind.MoreFilters, x, y); }
    renew(x, y, w, h) => { FactoryTooltipState.renew(FactoryTooltipKind.MoreFilters, x, y, w, h); }
}

