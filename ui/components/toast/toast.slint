import { GitHubIconButton } from "../button/github_icon_button.slint";
import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";

// Compact floating feedback surface built from the current Primer Banner
// anatomy: semantic leading visual, concise text, optional dismiss action, and
// responsive stacking. It intentionally avoids legacy Toast's solid icon rail.
export component GitHubToast inherits Rectangle {
    in property <string> message;
    in property <string> type;               // text, success, error, loading
    in property <string> position: "middle"; // top | middle | bottom
    in property <bool> overlay: false;
    in property <bool> close-on-click: false;
    in property <bool> toast-visible: false;
    in property <length> toast-width-value: 0px;
    in property <float> toast-width-percent: 0.0;
    in property <bool> toast-width-is-auto: false;
    callback dismiss();

    private property <length> viewport-margin:
        root.width < GitHubMetrics.breakpoint-small
            ? GitHubMetrics.size-8
            : GitHubMetrics.size-16;
    private property <length> available-width:
        max(1px, root.width - root.viewport-margin * 2);
    private property <length> natural-width:
        message-measure.preferred-width + GitHubMetrics.size-80;
    private property <length> automatic-width:
        min(root.available-width, max(240px, min(450px, root.natural-width)));
    private property <length> resolved-width: root.toast-width-is-auto
        ? root.automatic-width
        : (root.toast-width-value > 0px
            ? min(root.available-width, root.toast-width-value)
            : (root.toast-width-percent > 0
                ? min(
                    root.available-width,
                    root.width * root.toast-width-percent * 0.01
                )
                : root.automatic-width));
    private property <color> semantic-foreground:
        root.type == "success" ? GitHubTheme.success-fg
        : root.type == "error" ? GitHubTheme.danger-fg
        : GitHubTheme.accent-fg;
    private property <color> semantic-background:
        root.type == "success" ? GitHubTheme.success-muted
        : root.type == "error" ? GitHubTheme.danger-muted
        : GitHubTheme.accent-subtle;
    private property <color> semantic-border:
        root.type == "success" ? GitHubTheme.success-fg
        : root.type == "error" ? GitHubTheme.danger-border-muted
        : GitHubTheme.accent-muted;

    width: 100%;
    height: 100%;
    background: transparent;
    visible: root.toast-visible;

    if root.overlay && root.toast-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: GitHubTheme.backdrop-subtle;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                if root.close-on-click {
                    root.dismiss();
                }
            }
        }
    }

    message-measure := Text {
        visible: false;
        text: root.message;
        font-size: GitHubMetrics.text-medium;
        wrap: no-wrap;
    }

    if root.toast-visible: toast-card := Rectangle {
        z: 1;
        width: root.resolved-width;
        min-height: GitHubMetrics.size-48;
        height: max(
            GitHubMetrics.size-48,
            message-label.preferred-height + GitHubMetrics.size-24
        );
        x: (parent.width - self.width) / 2;
        y: root.position == "top" ? root.viewport-margin
            : root.position == "bottom"
                ? parent.height - self.height - root.viewport-margin
                : (parent.height - self.height) / 2;
        background: root.semantic-background;
        border-width: GitHubMetrics.border-thin;
        border-color: root.semantic-border;
        border-radius: GitHubMetrics.radius-medium;
        drop-shadow-blur: GitHubMetrics.size-12;
        drop-shadow-color: GitHubTheme.shadow-floating-medium;
        drop-shadow-offset-y: GitHubMetrics.size-2;

        if root.type == "loading": GitHubSpinner {
            x: GitHubMetrics.size-16;
            y: (parent.height - self.height) / 2;
            spinner-size: GitHubMetrics.icon-medium;
            foreground: root.semantic-foreground;
        }

        if root.type != "loading": Image {
            x: GitHubMetrics.size-16;
            y: (parent.height - self.height) / 2;
            width: GitHubMetrics.icon-medium;
            height: GitHubMetrics.icon-medium;
            source: root.type == "success"
                ? @image-url("../../assets/icons/octicon-check-16.svg")
                : root.type == "error"
                    ? @image-url("../../assets/icons/octicon-alert-16.svg")
                    : @image-url("../../assets/icons/octicon-info-16.svg");
            colorize: root.semantic-foreground;
        }

        message-label := Text {
            x: GitHubMetrics.size-44;
            y: GitHubMetrics.size-12;
            width: parent.width - self.x
                - (root.type == "loading"
                    ? GitHubMetrics.size-16
                    : GitHubMetrics.size-48);
            text: root.message;
            font-size: GitHubMetrics.text-medium;
            color: GitHubTheme.fg-default;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        if root.type != "loading": GitHubIconButton {
            x: parent.width - GitHubMetrics.size-40;
            y: GitHubMetrics.size-8;
            icon: @image-url("../../assets/icons/octicon-x-16.svg");
            tooltip-text: "Dismiss";
            tooltip-align-right: true;
            tooltip-above: root.position != "top";
            foreground: GitHubTheme.fg-muted;
            clicked => { root.dismiss(); }
        }

        TouchArea {
            width: parent.width - (root.type == "loading"
                ? 0px
                : GitHubMetrics.size-40);
            height: 100%;
            enabled: root.close-on-click;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => {
                if root.close-on-click {
                    root.dismiss();
                }
            }
        }
    }
}
