import { MaterialText } from "@material";
import { AppState } from "../../state/app_state.slint";

export component Toast inherits Rectangle {
    in property <string> message;
    in property <string> type;               // text, success, error, loading
    in property <string> position: "middle"; // top | middle | bottom
    in property <bool> overlay: false;
    in property <bool> close-on-click: false;
    in property <bool> toast-visible: false;
    in property <length> toast-width-value: 0px;
    in property <float> toast-width-percent: 0.0;
    in property <bool> toast-width-is-auto: false;
    callback dismiss();

    private property <length> viewport-margin: root.width < 544px ? 8px : 16px;
    private property <length> available-width: max(1px, root.width - root.viewport-margin * 2);
    private property <length> natural-width: message-measure.preferred-width + 80px;
    private property <length> automatic-width: min(root.available-width, max(200px, min(450px, root.natural-width)));
    private property <length> resolved-width: root.toast-width-is-auto
        ? root.automatic-width
        : (root.toast-width-value > 0px
            ? min(root.available-width, root.toast-width-value)
            : (root.toast-width-percent > 0
                ? min(root.available-width, root.width * root.toast-width-percent * 0.01)
                : root.automatic-width));
    private property <color> github-canvas-default: AppState.effective-dark-mode ? #0d1117 : #ffffff;
    private property <color> github-border-default: AppState.effective-dark-mode ? #3d444d : #d0d7de;
    private property <color> github-fg-default: AppState.effective-dark-mode ? #f0f6fc : #1f2328;
    private property <color> github-accent-emphasis: AppState.effective-dark-mode ? #1f6feb : #0969da;
    private property <color> github-success-emphasis: AppState.effective-dark-mode ? #238636 : #1f883d;
    private property <color> github-danger-emphasis: AppState.effective-dark-mode ? #da3633 : #cf222e;
    private property <color> github-neutral-emphasis: AppState.effective-dark-mode ? #6e7681 : #57606a;

    width: 100%;
    height: 100%;
    background: transparent;
    visible: toast-visible;

    if overlay && toast-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;
        z: 0;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { if root.close-on-click { root.dismiss(); } }
        }
    }

    // GitHub Primer Toast: content-sized neutral card with a fixed 48px
    // semantic icon rail. This intentionally reproduces Primer's canonical
    // retired Toast rather than Material's full-color snackbar treatment.
    message-measure := MaterialText {
        visible: false;
        text: root.message;
        font-size: 14px;
    }

    if toast-visible: toast-card := Rectangle {
        z: 1;
        width: root.resolved-width;
        min-height: 48px;
        height: max(48px, message-label.preferred-height + 32px);
        // Toasts are horizontally centered for every vertical position.
        x: parent.width / 2 - self.width / 2;
        y: position == "top" ? root.viewport-margin :
           position == "bottom" ? parent.height - self.height - root.viewport-margin :
           parent.height / 2 - self.height / 2;
        background: root.github-canvas-default;
        border-width: 1px;
        border-color: root.github-border-default;
        border-radius: 6px;
        drop-shadow-blur: 10px;
        drop-shadow-color: AppState.effective-dark-mode ? #00000066 : #1f232826;
        drop-shadow-offset-y: 1px;
        clip: true;

        icon-rail := Rectangle {
            x: 0px;
            y: 0px;
            width: 48px;
            height: parent.height;
            background: root.type == "success" ? root.github-success-emphasis :
                        root.type == "error" ? root.github-danger-emphasis :
                        root.type == "loading" ? root.github-neutral-emphasis :
                        root.github-accent-emphasis;

            if root.type != "loading": Image {
                x: 16px;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: root.type == "success"
                    ? @image-url("../../assets/icons/octicon-check-16.svg")
                    : root.type == "error"
                        ? @image-url("../../assets/icons/octicon-alert-16.svg")
                        : @image-url("../../assets/icons/octicon-info-16.svg");
                colorize: #ffffff;
            }

            if root.type == "loading": Rectangle {
                x: 14px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                background: transparent;
                private property <float> rotation-progress: mod(animation-tick(), 1000ms) / 1000ms;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("../../assets/icons/github-spinner-16.svg");
                    image-fit: contain;
                    colorize: #ffffff;
                    transform-rotation: parent.rotation-progress * 360deg;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                }
            }
        }

        message-label := MaterialText {
            x: 64px;
            y: 16px;
            width: parent.width - 80px;
            text: root.message;
            font-size: 14px;
            font-weight: 400;
            color: root.github-fg-default;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { if root.close-on-click { root.dismiss(); } }
        }
    }
}
