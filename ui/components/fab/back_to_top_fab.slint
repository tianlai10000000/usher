import { FloatingCircleButton } from "./floating_circle_button.slint";

export component BackToTopFab inherits Rectangle {
    in property <length> container-width: 0px;
    in property <length> container-height: 0px;
    in property <length> bottom-offset: 16px;
    in property <length> right-offset: 24px;
    in property <length> scroll-offset: 0px;
    in property <length> show-threshold: 220px;
    callback request-scroll-to-top();

    private property <bool> visible-state: root.scroll-offset > root.show-threshold;

    x: 0px;
    y: 0px;
    width: root.container-width;
    height: root.container-height;
    background: transparent;

    FloatingCircleButton {
        x: parent.width - self.width - root.right-offset;
        y: root.visible-state
            ? parent.height - self.height - root.bottom-offset
            : parent.height - self.height - root.bottom-offset + 28px;
        icon: @image-url("../../assets/icons/arrow_upward.svg");
        opacity: root.visible-state ? 1 : 0;
        interactive: root.visible-state;
        clicked => {
            root.request-scroll-to-top();
        }
    }
}
