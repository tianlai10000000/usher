import { FloatingIconButton } from "./floating_icon_button.slint";

export component TerminalFab inherits Rectangle {
    in property <length> container-width: 0px;
    in property <length> container-height: 0px;
    in property <length> bottom-offset: 16px;
    in property <length> right-offset: 12px;
    in property <bool> active: false;
    in property <bool> interactive: true;
    in property <string> tooltip-text: "Open terminal";
    callback request-open-terminal();

    x: 0px;
    y: 0px;
    width: root.container-width;
    height: root.container-height;
    background: transparent;

    FloatingIconButton {
        x: parent.width - self.width - root.right-offset;
        y: parent.height - self.height - root.bottom-offset;
        icon: @image-url("../../assets/icons/octicon-terminal-16.svg");
        primary: true;
        selected: root.active;
        tooltip: root.active ? "Close terminal" : root.tooltip-text;
        interactive: root.interactive;
        clicked => {
            root.request-open-terminal();
        }
    }
}
