import { LayoutConstants } from "../../layout_constants.slint";
import { GitHubIconButton } from "../button/github_icon_button.slint";
import { I18n } from "@i18n";

export component GitHubPageScrollActions inherits Rectangle {
    in property <length> container-width: 0px;
    in property <length> container-height: 0px;
    in property <bool> enable-to-top: true;
    in property <bool> enable-terminal: false;
    in property <length> scroll-offset: 0px;
    in property <length> show-threshold: LayoutConstants.to-top-show-threshold;
    in property <length> right-offset: LayoutConstants.page-fab-right-offset;
    in property <length> to-top-bottom-offset: LayoutConstants.page-fab-bottom-offset;
    in property <length> terminal-bottom-offset: LayoutConstants.page-fab-bottom-offset;
    in property <bool> terminal-active: false;
    in property <bool> terminal-interactive: true;
    in property <string> terminal-tooltip-text: I18n.tooltip-open-terminal;
    in property <string> terminal-active-tooltip-text: I18n.tooltip-close-terminal;
    callback request-scroll-to-top();
    callback request-open-terminal();

    private property <bool> to-top-visible:
        root.scroll-offset > root.show-threshold;

    x: 0px;
    y: 0px;
    width: root.container-width;
    height: root.container-height;
    background: transparent;

    if root.enable-to-top: GitHubIconButton {
        x: parent.width - self.width - root.right-offset;
        y: root.to-top-visible
            ? parent.height - self.height - root.to-top-bottom-offset
            : parent.height - self.height - root.to-top-bottom-offset + 28px;
        icon: @image-url("../../assets/icons/octicon-arrow-up-16.svg");
        tooltip-text: I18n.tooltip-back-to-top;
        // Same right-edge pin as the terminal FAB so the label is not clipped.
        tooltip-align-right: true;
        invisible: false;
        floating: true;
        opacity: root.to-top-visible ? 1 : 0;
        button-enabled: root.to-top-visible;
        animate opacity { duration: 220ms; }
        animate y { duration: 240ms; }
        clicked => { root.request-scroll-to-top(); }
    }

    // Paint the terminal action last so its upward tooltip can cross the
    // back-to-top sibling without being covered by that button.
    if root.enable-terminal: GitHubIconButton {
        x: parent.width - self.width - root.right-offset;
        y: parent.height - self.height - root.terminal-bottom-offset;
        icon: @image-url("../../assets/icons/octicon-terminal-16.svg");
        primary: true;
        selected: root.terminal-active;
        tooltip-text: root.terminal-active
            ? root.terminal-active-tooltip-text
            : root.terminal-tooltip-text;
        tooltip-align-right: true;
        button-enabled: root.terminal-interactive;
        invisible: false;
        floating: true;
        clicked => { root.request-open-terminal(); }
    }
}
