import { GitHubSpinner } from "../github_spinner.slint";
import { GitHubTooltip } from "../github_tooltip.slint";
import {
    GitHubTooltipAlignment,
    GitHubTooltipPlacement,
    TooltipOverlayState,
} from "../../state/tooltip_overlay_state.slint";
import { GitHubTheme, GitHubMetrics } from "../../theme/github_theme.slint";

// Primer IconButton foundation for application-owned icon-only actions.
// Every instance requires an action label through tooltip-text.
// Reference: https://primer.style/product/components/icon-button/
export component GitHubIconButton inherits FocusScope {
    in property <image> icon;
    in property <string> tooltip-text;
    // Some familiar dismiss controls keep their accessible name without
    // showing a redundant visual tooltip.
    in property <bool> show-tooltip: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> inverse: false;
    in property <bool> invisible: true;
    in property <bool> selected: false;
    in property <bool> button-enabled: true;
    in property <bool> loading: false;
    in property <bool> activation-enabled:
        root.button-enabled && !root.loading;
    in property <bool> floating: false;
    in property <bool> circular: false;
    in property <bool> force-tooltip: false;
    in property <bool> tooltip-above: true;
    in property <bool> tooltip-align-right: false;
    // Edge controls can keep their tooltip inside the content surface instead
    // of centering it across an adjacent sidebar or window boundary.
    in property <bool> tooltip-align-left: false;
    in property <length> control-size: GitHubMetrics.control-medium-size;
    // Keep the interactive target at Primer's minimum size while allowing a
    // visually lighter surface for dense inline actions.
    in property <length> visual-size: root.control-size;
    in property <length> glyph-size: GitHubMetrics.icon-medium;
    in property <color> foreground:
        root.inverse
            ? GitHubTheme.control-inverse-fg
            : root.primary
            ? GitHubTheme.fg-on-emphasis
            : (root.danger ? GitHubTheme.danger-fg : GitHubTheme.fg-muted);
    // Callers that mirror native shell chrome can provide distinct hover and
    // selected colors while ordinary Primer IconButtons retain their defaults.
    in property <color> hover-foreground: root.foreground;
    in property <color> selected-foreground: root.foreground;
    in property <color> selected-hover-foreground: root.selected-foreground;
    in property <color> hover-background: root.invisible
        ? GitHubTheme.control-transparent-hover
        : GitHubTheme.control-default-hover;
    in property <color> selected-background: root.invisible
        ? GitHubTheme.control-transparent-selected
        : GitHubTheme.control-default-active;
    in property <color> selected-hover-background: root.selected-background;
    out property <bool> has-hover: button-touch.has-hover;
    out property <bool> tooltip-active: root.force-tooltip
        || ((button-touch.has-hover || root.keyboard-focus-visible) && !root.tooltip-dismissed);
    private property <bool> keyboard-focus-visible: false;
    private property <bool> tooltip-dismissed: false;
    private property <color> resolved-foreground: root.selected
        ? (button-touch.has-hover
            ? root.selected-hover-foreground
            : root.selected-foreground)
        : (button-touch.has-hover ? root.hover-foreground : root.foreground);
    callback clicked();

    // Let TouchArea own the press. Default focus-on-click consumes the first
    // press that grants focus, so unfocused icon buttons (e.g. terminal FAB
    // after the drawer stole focus) need a second click to activate.
    focus-on-click: false;
    width: root.control-size;
    height: root.control-size;
    accessible-role: button;
    accessible-enabled: root.activation-enabled;
    accessible-label: root.tooltip-text;
    accessible-checkable: root.selected;
    accessible-checked: root.selected;

    key-pressed(event) => {
        root.keyboard-focus-visible = true;
        if (root.activation-enabled
                && (event.text == Key.Return || event.text == " ")) {
            root.activate();
            return accept;
        }
        return reject;
    }
    focus-gained(reason) => {
        // A fresh Tab visit may show the tip again. Mouse focus is acquired by
        // activate() after dismissal and must not immediately republish it.
        if reason == FocusReason.tab-navigation {
            root.tooltip-dismissed = false;
        }
        root.keyboard-focus-visible = reason == FocusReason.tab-navigation;
    }
    focus-lost => {
        root.keyboard-focus-visible = false;
    }

    function activate() {
        root.keyboard-focus-visible = false;
        root.tooltip-dismissed = true;
        TooltipOverlayState.dismiss-all();
        // Manual focus replaces focus-on-click so the same press both focuses
        // (for Enter/Space) and activates.
        root.focus();
        root.clicked();
    }

    if root.has-focus && root.keyboard-focus-visible: focus-ring := Rectangle {
        x: -GitHubMetrics.size-2;
        y: -GitHubMetrics.size-2;
        width: parent.width + GitHubMetrics.size-4;
        height: parent.height + GitHubMetrics.size-4;
        border-radius: root.circular
            ? (parent.width + GitHubMetrics.size-4) / 2
            : GitHubMetrics.radius-medium + GitHubMetrics.size-2;
        border-width: GitHubMetrics.focus-outline-width;
        border-color: GitHubTheme.focus-outline;
        background: transparent;
    }

    surface := Rectangle {
        x: (parent.width - root.visual-size) / 2;
        y: (parent.height - root.visual-size) / 2;
        width: root.visual-size;
        height: root.visual-size;
        border-radius: root.circular
            ? root.visual-size / 2
            : GitHubMetrics.radius-medium;
        border-width: root.invisible && !root.inverse ? 0px : GitHubMetrics.border-thin;
        border-color: root.inverse
            ? GitHubTheme.control-inverse-bg
            : root.primary
            ? GitHubTheme.control-primary-rest
            : (root.danger && button-touch.has-hover
                ? GitHubTheme.danger-emphasis
                : GitHubTheme.border-default);
        background: root.inverse
            ? (button-touch.pressed
                ? GitHubTheme.control-inverse-active
                : (button-touch.has-hover
                    ? GitHubTheme.control-inverse-hover
                    : GitHubTheme.control-inverse-bg))
            : root.primary
            ? (button-touch.pressed
                ? GitHubTheme.control-primary-active
                : (button-touch.has-hover
                    ? GitHubTheme.control-primary-hover
                    : GitHubTheme.control-primary-rest))
            : root.danger
                ? (button-touch.pressed
                    ? GitHubTheme.control-danger-active
                    : (button-touch.has-hover
                        ? GitHubTheme.danger-muted
                        : (root.invisible ? transparent : GitHubTheme.control-default-rest)))
                : root.selected
                    ? (button-touch.has-hover
                        ? root.selected-hover-background
                        : root.selected-background)
                    : (button-touch.pressed
                        ? (root.invisible
                            ? GitHubTheme.control-transparent-active
                            : GitHubTheme.control-default-active)
                        : (button-touch.has-hover
                            ? root.hover-background
                            : (root.invisible ? transparent : GitHubTheme.control-default-rest)));
        animate background { duration: 100ms; easing: ease-out; }
        opacity: root.button-enabled ? 1 : 0.5;
        drop-shadow-blur: root.floating ? GitHubMetrics.size-12 : 0px;
        drop-shadow-color: root.floating
            ? GitHubTheme.shadow-floating-small
            : transparent;
        drop-shadow-offset-y: root.floating ? GitHubMetrics.size-6 : 0px;

        if root.loading: GitHubSpinner {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            spinner-size: root.glyph-size;
            foreground: root.resolved-foreground;
        }

        if !root.loading: Image {
            // Snap glyph origins to whole logical pixels. Odd control/glyph
            // pairs (and fractional parents) otherwise land on *.5 and FemtoVG
            // bilinear-blurs the pre-rasterized SVG.
            x: Math.floor(((parent.width - self.width) / 2) / 1px) * 1px;
            y: Math.floor(((parent.height - self.height) / 2) / 1px) * 1px;
            width: root.glyph-size;
            height: root.glyph-size;
            source: root.icon;
            image-fit: contain;
            colorize: root.resolved-foreground;
        }
    }

    button-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.activation-enabled;
        mouse-cursor: self.enabled ? pointer : default;
        changed has-hover => {
            if !self.has-hover {
                root.tooltip-dismissed = false;
            }
        }
        clicked => {
            // Dismiss before invoking a callback that may unmount this anchor.
            root.activate();
        }
    }

    // Keep the locator mounted and publish the complete button rectangle. The
    // root host owns flip/shift/size and therefore needs no edge-specific x/y.
    if root.show-tooltip && root.tooltip-text != "": GitHubTooltip {
        z: 10001;
        debug-node: "GitHubIconButton";
        preferred-placement: root.tooltip-above
            ? GitHubTooltipPlacement.Top
            : GitHubTooltipPlacement.Bottom;
        alignment: root.tooltip-align-right
            ? GitHubTooltipAlignment.End
            : (root.tooltip-align-left
                ? GitHubTooltipAlignment.Start
                : GitHubTooltipAlignment.Center);
        text: root.tooltip-active ? root.tooltip-text
            : "";
    }
}
