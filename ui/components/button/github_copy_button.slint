import { GitHubIconButton } from "github_icon_button.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";
import { I18n } from "@i18n";

// GitHub's current repository Clone popover CopyToClipboardButton:
// 32px invisible IconButton, 16px Copy/Check Octicons, 6px radius,
// fgColor-muted -> fgColor-success, and a TooltipV2 confirmation.
// Values were verified against github.com and Primer functional tokens on
// 2026-07-30. The callback returns true only after the clipboard write succeeds.
export component GitHubCopyButton inherits Rectangle {
    in property <bool> button-enabled: true;
    in property <string> tooltip-text: I18n.common-copy-to-clipboard;
    in property <bool> tooltip-above: true;
    in property <bool> tooltip-align-right: false;
    out property <bool> has-hover: copy-button.has-hover;
    out property <bool> copied: false;
    callback copy-requested() -> bool;

    // Async clipboard writers call this only after a successful write.
    public function confirm-copy() { root.copied = true; }
    public function reset-feedback() { root.copied = false; }

    width: 32px;
    height: 32px;
    // Keep the hover confirmation above sibling controls in dense toolbars.
    z: 10000;
    background: transparent;
    clip: false;

    copy-button := GitHubIconButton {
        icon: root.copied
            ? @image-url("../../assets/icons/octicon-check-16.svg")
            : @image-url("../../assets/icons/octicon-copy-16.svg");
        tooltip-text: root.copied ? I18n.common-copied : root.tooltip-text;
        tooltip-above: root.tooltip-above;
        tooltip-align-right: root.tooltip-align-right;
        force-tooltip: root.copied;
        button-enabled: root.button-enabled;
        activation-enabled: root.button-enabled && !root.copied;
        foreground: root.copied ? GitHubTheme.success-fg : GitHubTheme.fg-muted;
        clicked => {
            if root.copy-requested() {
                root.copied = true;
            }
        }
    }

    copied-reset := Timer {
        interval: 2s;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }
}
