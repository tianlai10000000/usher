import { GitHubIconButton } from "./github_icon_button.slint";
import { I18n } from "@i18n";

export component GitHubProjectCardActions inherits Rectangle {
    out property <bool> has-hover: terminal-btn.has-hover || settings-btn.has-hover || delete-btn.has-hover;
    callback request-open-terminal();
    callback request-open-settings();
    callback request-delete();

    width: 96px;
    height: 28px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 2px;
        alignment: center;

        terminal-btn := GitHubIconButton {
            icon: @image-url("../../assets/icons/octicon-terminal-16.svg");
            tooltip-text: I18n.tooltip-open-terminal;
            control-size: 28px;
            glyph-size: 16px;
            clicked => {
                root.request-open-terminal();
            }
        }

        settings-btn := GitHubIconButton {
            icon: @image-url("../../assets/icons/octicon-pencil-16.svg");
            tooltip-text: I18n.common-settings;
            control-size: 28px;
            glyph-size: 16px;
            clicked => {
                root.request-open-settings();
            }
        }

        delete-btn := GitHubIconButton {
            icon: @image-url("../../assets/icons/octicon-trash-16.svg");
            tooltip-text: I18n.common-delete;
            danger: true;
            control-size: 28px;
            glyph-size: 16px;
            clicked => {
                root.request-delete();
            }
        }
    }
}
