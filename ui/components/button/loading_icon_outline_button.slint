import { MaterialPalette, MaterialTypography, MaterialStyleMetrics, MaterialText } from "@material";

component RotatingIcon {
    in property <bool> rotating: false;
    in property <image> source;
    
    width: 18px;
    height: 18px;
    
    // 计算旋转角度：使用 mod 来创建循环，每秒旋转360度
    property <float> rotation-progress: root.rotating ? mod(animation-tick(), 1s) / 1s : 0;
    
    Rectangle {
        width: parent.width;
        height: parent.height;
        
        Image {
            source: root.source;
            width: parent.width;
            height: parent.height;
            // 将进度转换为角度：0-1 映射到 0-360度
            transform-rotation: root.rotation-progress * 360deg;
            // 使用结构体语法设置 transform-origin
            transform-origin: { x: self.width / 2, y: self.height / 2 };
        }
    }
}

export component LoadingIconOutlineButton {
    in property <bool> loading: false;
    in property <string> text: "Button";
    in property <image> loading-icon: @image-url("../../assets/icons/loading.svg");
    callback clicked();
    
    min-width: 120px;
    min-height: 40px;
    
    border := Rectangle {
        border_radius: root.height / 2;
        border_width: 1px;
        border_color: MaterialPalette.outline;
        width: 100%;
        height: 100%;
    }
    
    touch-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.loading;
        clicked => {
            root.clicked();
        }
    }
    
    state-layer := Rectangle {
        width: 100%;
        height: 100%;
        border_radius: border.border_radius;
        background: MaterialPalette.primary;
        opacity: touch-area.pressed ? MaterialPalette.state_layer_opacity_press :
                 touch-area.has-hover ? MaterialPalette.state_layer_opacity_hover : 0%;
    }
    
    content := HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_24;
        padding-right: MaterialStyleMetrics.padding_24;
        padding-top: MaterialStyleMetrics.padding_10;
        padding-bottom: MaterialStyleMetrics.padding_10;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;
        
        if root.loading : RotatingIcon {
            rotating: true;
            source: root.loading-icon;
        }
        
        MaterialText {
            text: root.text;
            style: MaterialTypography.label_large;
            color: MaterialPalette.primary;
            opacity: root.loading ? 38% : 100%;
            vertical_alignment: center;
        }
    }
    
    states [
        disabled when root.loading : {
            border.border_color: MaterialPalette.on_surface;
            border.opacity: MaterialPalette.state_layer_opacity_hover;
        }
    ]
}
