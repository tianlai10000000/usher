import { FilledButton, TextButton, LinearProgressIndicator, MaterialText, Modal, MaterialPalette, MaterialStyleMetrics } from "@material";

export global UpdateLogic {
    in-out property <bool> update-available: false;
    in-out property <string> new-version: "";
    in-out property <float> progress: 0.0;
    in-out property <string> error: "";
    in-out property <bool> checking-update: false;
    
    // 下载状态
    in-out property <bool> is-downloading: false;
    in-out property <float> download-progress: 0.0;
    in-out property <string> download-status: "";
    in-out property <int> downloaded-bytes: 0;
    in-out property <int> total-bytes: 0;

    callback show-update-dialog();
    callback install();
    callback update-progress();
    callback show-error();
    callback cancel-download();
    callback start-download();
}

// 下载进度模态框组件
export component DownloadProgressModal inherits Rectangle {
    in-out property <bool> show-modal: UpdateLogic.is-downloading;
    in-out property <float> progress: UpdateLogic.download-progress;
    in-out property <string> status: UpdateLogic.download-status;
    in-out property <string> version: UpdateLogic.new-version;
    
    callback cancel-clicked();
    
    // 只有在下载时才显示
    if show-modal: Rectangle {
        width: 100%;
        height: 100%;
        
        Modal {
            width: 100%;
            height: 100%;
            
            clicked => {
                // 点击模态框背景不关闭，只能通过取消按钮关闭
            }
            
            // 对话框内容
            dialog-container := Rectangle {
                width: min(450px, parent.width * 0.9);
                height: 220px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: MaterialPalette.surface_container_high;
                border-radius: MaterialStyleMetrics.border_radius_28;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000040;
                
                VerticalLayout {
                    spacing: 16px;
                    padding: 24px;
                    
                    // 标题
                    MaterialText {
                        text: "Downloading Update";
                        font-size: 22px;
                        font-weight: 500;
                        color: MaterialPalette.on_surface;
                    }
                    
                    // 版本信息
                    MaterialText {
                        text: "Downloading version " + root.version + "...";
                        font-size: 14px;
                        color: MaterialPalette.on_surface_variant;
                    }
                    
                    // 进度条区域
                    VerticalLayout {
                        spacing: 8px;
                        
                        // 进度条
                        LinearProgressIndicator {
                            width: 100%;
                            height: 8px;
                            progress: root.progress;
                            indeterminate: root.progress <= 0;
                        }
                        
                        // 进度文字
                        HorizontalLayout {
                            alignment: space-between;
                            
                            MaterialText {
                                text: root.status;
                                font-size: 12px;
                                color: MaterialPalette.on_surface_variant;
                            }
                            
                            MaterialText {
                                text: root.progress > 0 ? Math.round(root.progress * 100) + "%" : "";
                                font-size: 12px;
                                color: MaterialPalette.on_surface_variant;
                            }
                        }
                    }
                    
                    // 底部按钮区域
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        
                        TextButton {
                            text: "Cancel";
                            clicked => {
                                root.cancel-clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component UpdateDialog inherits PopupWindow {
    in-out property <string> version;
    in-out property <float> progress;

    close-on-click: false;
    width: 600px;
    height: 400px;

    Modal {
        width: parent.width;
        height: parent.height;
    }
}
