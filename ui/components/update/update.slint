import { GitHubDialog } from "../dialog/github_dialog.slint";
import { GitHubProgressBar } from "../github_progress_bar.slint";
import { GitHubTheme } from "../../theme/github_theme.slint";

export global UpdateLogic {
    in-out property <bool> update-available: false;
    in-out property <string> new-version: "";
    in-out property <float> progress: 0.0;
    in-out property <string> error: "";
    in-out property <bool> checking-update: false;
    
    // 下载状态
    in-out property <bool> is-downloading: false;
    in-out property <float> download-progress: 0.0;
    in-out property <string> download-status: "";
    in-out property <int> downloaded-bytes: 0;
    in-out property <int> total-bytes: 0;

    callback show-update-dialog();
    callback install();
    callback update-progress();
    callback show-error();
    callback cancel-download();
    callback start-download();
}

// Download progress uses the same Primer Dialog shell as every other modal.
export component GitHubDownloadProgressDialog inherits Rectangle {
    in-out property <bool> show-modal: UpdateLogic.is-downloading;
    in-out property <float> progress: UpdateLogic.download-progress;
    in-out property <string> status: UpdateLogic.download-status;
    in-out property <string> version: UpdateLogic.new-version;
    
    callback cancel-clicked();
    
    dialog-frame := GitHubDialog {
        dialog-visible: root.show-modal;
        // Keep Esc available so Cancel download matches the footer action.
        modal: false;
        title: "Downloading update";
        subtitle: "Downloading version " + root.version + "…";
        dialog-width: 480px;
        dialog-height: 296px;
        body-padding: 16px;
        show-close: false;
        primary-label: "";
        cancel-label: "Cancel download";
        close-requested => { root.cancel-clicked(); }
        cancel-clicked => { root.cancel-clicked(); }

        if root.show-modal: Rectangle {
            x: dialog-frame.content-x;
            y: dialog-frame.content-y;
            width: dialog-frame.content-width;
            height: dialog-frame.content-height;
            z: 3100;
            clip: true;

            Text {
                x: 0px;
                y: 8px;
                width: parent.width;
                height: 20px;
                text: root.status == "" ? "Preparing download…" : root.status;
                font-size: 14px;
                color: GitHubTheme.fg-default;
                vertical-alignment: center;
                overflow: elide;
            }

            GitHubProgressBar {
                x: 0px;
                y: 44px;
                width: parent.width;
                height: 8px;
                progress: root.progress;
                indeterminate: root.progress <= 0;
                foreground: GitHubTheme.accent-emphasis;
            }

            Text {
                x: 0px;
                y: 64px;
                width: parent.width;
                height: 20px;
                text: root.progress > 0 ? Math.round(root.progress * 100) + "%" : "";
                font-size: 12px;
                color: GitHubTheme.fg-muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
