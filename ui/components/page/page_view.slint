import { Route } from "../../route/routeMap.slint";
import { LayoutConstants } from "../../layout_constants.slint";
import { GitHubMetrics } from "../../theme/github_theme.slint";
import { GitHubPageHeader } from "github_page_header.slint";
import { TransientOverlayState } from "../../state/transient_overlay_state.slint";

export component GitHubPageView {
    callback navigate(Route);
    in property <length> viewport-height;
    in property <string> page-title: "";
    in property <string> page-description: "";
    in property <image> page-icon;
    in property <bool> page-header-border: true;
    // Pages with a full-bleed header can opt out of the generic top inset.
    in property <length> content-top-padding: GitHubMetrics.size-16;

    property <length> page_viewport_height: viewport-height > 0px ? viewport-height : LayoutConstants.default-page-viewport-height;

    Rectangle {
        width: parent.width;
        min-height: page_viewport_height;

        // Under-chrome blank dismiss for root-mounted ActionMenus (notification
        // overflow, readiness peers, etc.). Must stay under page content so the
        // first click on page/status controls can open another popup via
        // exclusive-claim instead of only closing. Same contract as the PR
        // workspace blank layer — not a Notify-z root scrim above the page.
        TouchArea {
            z: 0;
            width: 100%;
            height: 100%;
            mouse-cursor: default;
            clicked => { TransientOverlayState.dismiss-all(); }
        }

        VerticalLayout {
            z: 1;
            padding-left: GitHubMetrics.size-16;
            padding-right: GitHubMetrics.size-16;
            padding-bottom: GitHubMetrics.size-16;
            padding-top: root.content-top-padding;
            spacing: GitHubMetrics.size-16;
            alignment: start;

            if root.page-title != "": GitHubPageHeader {
                title: root.page-title;
                description: root.page-description;
                leading-icon: root.page-icon;
                show-border: root.page-header-border;
            }

            @children
        }
    }
}
